Функция ПолучитьВесОбъем(п_Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ВложенныйЗапрос.Вес) КАК Вес,
		|	СУММА(ВложенныйЗапрос.Объем) КАК Объем
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ДР.Значение КАК ЧИСЛО) КАК Вес,
		|		0 КАК Объем
		|	ИЗ
		|		Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДР
		|	ГДЕ
		|		ДР.Ссылка = &Ссылка
		|		И ДР.Свойство = &Свойство1
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		0,
		|		ВЫРАЗИТЬ(ДР.Значение КАК ЧИСЛО)
		|	ИЗ
		|		Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДР
		|	ГДЕ
		|		ДР.Ссылка = &Ссылка
		|		И ДР.Свойство = &Свойство2) КАК ВложенныйЗапрос";
	
	Запрос.УстановитьПараметр("Свойство1", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Вес Брутто", Истина));
	Запрос.УстановитьПараметр("Свойство2", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Объем", Истина));
	Запрос.УстановитьПараметр("Ссылка", п_Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Рез = Новый Структура();
	
	ТекВес = 0;
	ТекОбъем = 0;
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Вес) Тогда
			ТекВес = Выборка.Вес;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Объем) Тогда
			ТекОбъем = Выборка.Объем
		КонецЕсли;
	КонецЕсли;

	Рез.Вставить("Вес",		ТекВес);
	Рез.Вставить("Объем",	ТекОбъем);
	
	Возврат Рез;

КонецФункции // ()

Функция ПолучитьВесОбъемДляСтроки(п_СтрокаТЧ) Экспорт
	
	ТекВес = 0;
	ТекОбъем = 0;
	ТекВесЕдиницы = 0;
	ТекОбъемЕдиницы = 0;

	ВесОбъемСтроки = ПолучитьВесОбъем(п_СтрокаТЧ.Номенклатура);
	
	Если ЗначениеЗаполнено(п_СтрокаТЧ.Количество) Тогда
		ТекВес 				= ВесОбъемСтроки.Вес * п_СтрокаТЧ.Количество;
		ТекВесЕдиницы		= ВесОбъемСтроки.Вес;
		ТекОбъем			= ВесОбъемСтроки.Объем * п_СтрокаТЧ.Количество;
		ТекОбъемЕдиницы		= ВесОбъемСтроки.Объем;
	КонецЕсли;

	Рез = Новый Структура();
	
	Рез.Вставить("Вес",				ТекВес);
	Рез.Вставить("Объем",			ТекОбъем);
	Рез.Вставить("ВесЕдиницы",		ТекВесЕдиницы);
	Рез.Вставить("ОбъемЕдиницы",	ТекОбъемЕдиницы);
	
	Возврат Рез;

КонецФункции // ()

Функция ПолучитьВесОбъемДляДокумента(п_Документ) Экспорт

	Если ТипЗнч(п_Документ) = Тип("ДокументСсылка.ЗаявкаНаВозвратТоваровОтКлиента") Тогда
		ТЧ = п_Документ.ВозвращаемыеТовары;
	Иначе
		ТЧ = п_Документ.Товары;
	КонецЕсли;	

	Рез = Новый Структура("Вес, Объем", 0, 0);
	Для каждого Т Из ТЧ Цикл
		ВесОбъем = ПолучитьВесОбъемДляСтроки(Т);
		Рез.Вес		= Рез.Вес + ВесОбъем.Вес;
		Рез.Объем	= Рез.Объем + ВесОбъем.Объем;
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции // ПолучитьВесОбъемДляДокумента()

Функция ОстатокТовараПоОрганизации(п_Номенклатура, п_ДатаОстатков, п_Организация = Неопределено) Экспорт

	Запрос = Новый Запрос;
	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ТоварыОрганизацийОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыОрганизаций.Остатки(
		|			&ДатаОстатков,
		|			АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
		|				И Организация = &Организация) КАК ТоварыОрганизацийОстатки";
	
	Запрос.УстановитьПараметр("ДатаОстатков", п_ДатаОстатков);
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	
	Если п_Организация = Неопределено Тогда
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "И Организация = &Организация", ""); 	
	Иначе	
		Запрос.УстановитьПараметр("Организация", п_Организация);
	КонецЕсли;
	
	Запрос.Текст = ЗапросТекст;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции // ПолучитьВесОбъемДляДокумента()

Функция ОстатокКОформлению(п_Номенклатура, п_ДатаОстатков, п_ДокументОтгрузки) Экспорт

	Запрос = Новый Запрос;
	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ТоварыКОтгрузкеОстатки.КОформлениюОстаток + ТоварыКОтгрузкеОстатки.ВРезервеОстаток КАК КОформлению
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке.Остатки(
		|			,
		|			ДокументОтгрузки = &ДокументОтгрузки
		|				И Номенклатура = &Номенклатура) КАК ТоварыКОтгрузкеОстатки";
	
	//Запрос.УстановитьПараметр("ДатаОстатков", п_ДатаОстатков);
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	Запрос.УстановитьПараметр("ДокументОтгрузки", п_ДокументОтгрузки);
	
	Запрос.Текст = ЗапросТекст;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КОформлению;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции // ПолучитьВесОбъемДляДокумента()

