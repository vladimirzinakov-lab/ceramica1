Функция УстановленЗапретОтгрузкиПоСегменту(п_Партнер, п_Соглашение) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПартнерыСегмента.Сегмент КАК Сегмент,
	               |	ПартнерыСегмента.Сегмент.ДатаСоздания КАК СегментДатаСоздания
	               |ИЗ
	               |	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
	               |ГДЕ
	               |	ПартнерыСегмента.Сегмент.ЗапретОтгрузки
	               |	И НЕ ПартнерыСегмента.Сегмент.ЭтоГруппа
	               |	И НЕ ПартнерыСегмента.Сегмент.ПометкаУдаления
	               |	И ПартнерыСегмента.Партнер = &Партнер";
	
	Запрос.УстановитьПараметр("Партнер", п_Партнер);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

#Область УправлениеАссортиментом

Функция АссортиментВыделитьЦветом(п_Номенклатура, п_Дата) Экспорт

	РольЭтап = РольЭтап(п_Номенклатура, п_Дата);
	
	Если ПустаяСтрока(РольЭтап.Этап) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВводВАссортимент Тогда
		Если РольЭтап.Роль = Перечисления.РолиАссортимента.ДополнительныйАссортимент Тогда
			Возврат Истина;
		КонецЕсли;
	ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ИзменениеСостоянияАссортимента Тогда
		Если РольЭтап.Роль = Перечисления.РолиАссортимента.ДополнительныйАссортимент Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции // ()

Функция РольЭтап(п_Номенклатура, п_Дата)

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АссортиментСрезПоследних.Регистратор.Этап КАК Этап,
		|	АссортиментСрезПоследних.РольАссортимента КАК Роль
		|ИЗ
		|	РегистрСведений.Ассортимент.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК АссортиментСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", п_Дата);
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	
	Рез = Новый Структура();
	Рез.Вставить("Роль", "");
	Рез.Вставить("Этап", "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Рез, Выборка);
	КонецЕсли;
	
	Возврат Рез;

КонецФункции // ()

Функция ОстатокТовара(п_МассивНоменклатуры, п_Дата)

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
		|	СвободныеОстаткиОстатки.ВНаличииОстаток - СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток - СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(&Дата, Номенклатура В (&Номенклатура)) КАК СвободныеОстаткиОстатки";
	
	Запрос.УстановитьПараметр("Дата", п_Дата);
	Запрос.УстановитьПараметр("Номенклатура", п_МассивНоменклатуры);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ()

// родной алгоритм
Процедура УправлениеАссортиментомРС(Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АссортиментСрезПоследних.Регистратор.Этап КАК Этап,
		|	АссортиментСрезПоследних.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.Ассортимент.СрезПоследних(&Дата, Номенклатура В (&Номенклатура)) КАК АссортиментСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", ТекущийОбъект.Дата);
	Запрос.УстановитьПараметр("Номенклатура", ТекущийОбъект.Товары.ВыгрузитьКолонку("Номенклатура"));
	
	РезультатЗапроса = Запрос.Выполнить();

	ТЗ = РезультатЗапроса.Выгрузить();
	
	Строки = ТЗ.НайтиСтроки(Новый Структура("Этап", Перечисления.ЭтапыИзмененияАссортимента.ПереносВАрхивОтзыв));
	Если Строки.Количество() > 0 Тогда
		Сообщить("Управление ассортиментом. Перенос в архив / отзыв (запрещены закупки и продажи)");
		Для каждого Т Из Строки Цикл
			Сообщить(Т.Номенклатура);
		КонецЦикла;
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Строки = ТЗ.НайтиСтроки(Новый Структура("Этап", Перечисления.ЭтапыИзмененияАссортимента.ВводВАссортиментСОтсрочкойНачалаПродаж));
	Если Строки.Количество() > 0 Тогда
		Сообщить("Управление ассортиментом. Ввод в ассортимент с отсрочкой начала продаж (разрешены только закупки)");
		Для каждого Т Из Строки Цикл
			Сообщить(Т.Номенклатура);
		КонецЦикла;
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Строки = ТЗ.НайтиСтроки(Новый Структура("Этап", Перечисления.ЭтапыИзмененияАссортимента.ВыводИзАссортимента));
	Если Строки.Количество() > 0 Тогда
		
		ТЗ_Остатки = ОстатокТовара(ТекущийОбъект.Товары.ВыгрузитьКолонку("Номенклатура"), ТекущийОбъект.Дата);
		
		Для каждого Т Из Строки Цикл
			КоличествоДокумента = 0;
			СтрокиДокумента = ТекущийОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура", Т.Номенклатура));
			Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
				КоличествоДокумента = КоличествоДокумента + СтрокаДокумента.КоличествоУпаковок;
			КонецЦикла;
			
			СтрокиОстатка = ТЗ_Остатки.НайтиСтроки(Новый Структура("Номенклатура", Т.Номенклатура));
			Если СтрокиОстатка.Количество() = 0 Тогда
				Сообщить("Управление ассортиментом. Вывод ассортимента");
				Сообщить("" + Т.Номенклатура + " требуется: " + КоличествоДокумента + " остаток: -");
				Отказ = Истина;
			Иначе
				Остаток = СтрокиОстатка[0].Остаток;
				Если Остаток < КоличествоДокумента Тогда
					Сообщить("Управление ассортиментом. Вывод ассортимента");
					Сообщить("" + Т.Номенклатура + " требуется: " + КоличествоДокумента + " остаток: " + Остаток);
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;


КонецПроцедуры

// новый алгоритм
Процедура УправлениеАссортиментом(Отказ, ТекущийОбъект, ПараметрыЗаписи) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЗаказКлиента") Тогда

		Для каждого Т Из ТекущийОбъект.Товары Цикл
			
			РольЭтап = РольЭтап(Т.Номенклатура, ТекущийОбъект.Дата);
			Если ПустаяСтрока(РольЭтап.Этап) Тогда
				Продолжить;
			КонецЕсли;
			
			Если РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ПереносВАрхивОтзыв Тогда
				Сообщить("Строка: " + Т.НомерСтроки + ", " + Т.Номенклатура + " - ассортимент: перенос в архив/отзыв");
				Отказ = Истина;
				Прервать;
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВводВАссортимент Тогда
				// все разрешено
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВводВАссортиментСОтсрочкойНачалаПродаж Тогда
				Сообщить("Строка: " + Т.НомерСтроки + ", " + Т.Номенклатура + " - ассортимент: ввод с отсрочкой начала продаж");
				Отказ = Истина;
				Прервать;
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ИзменениеСостоянияАссортимента Тогда
				// все разрешено
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВыводИзАссортимента Тогда
				// все разрешено
			КонецЕсли;
			
		КонецЦикла;
	
	ИначеЕсли ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		
		Для каждого Т Из ТекущийОбъект.Товары Цикл

			РольЭтап = РольЭтап(Т.Номенклатура, ТекущийОбъект.Дата);
			Если ПустаяСтрока(РольЭтап.Этап) Тогда
				Продолжить;
			КонецЕсли;
			
			Если РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ПереносВАрхивОтзыв Тогда
				Сообщить("Строка: " + Т.НомерСтроки + ", " + Т.Номенклатура + " - ассортимент: перенос в архив/отзыв");
				Отказ = Истина;
				Прервать;
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВводВАссортимент Тогда
				// все разрешено
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВводВАссортиментСОтсрочкойНачалаПродаж Тогда
				// все разрешено
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ИзменениеСостоянияАссортимента Тогда
				// все разрешено
			ИначеЕсли РольЭтап.Этап = Перечисления.ЭтапыИзмененияАссортимента.ВыводИзАссортимента Тогда
