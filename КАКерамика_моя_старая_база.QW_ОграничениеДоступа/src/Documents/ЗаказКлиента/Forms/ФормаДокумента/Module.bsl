&НаСервере
Процедура ЗаписатьАдресДоставки(п_Владелец, п_Адрес)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РодительКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Контактная информация справочника ""Контрагенты""", Истина);
	ВидКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Фактический адрес", Истина, РодительКИ);
	ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(п_Адрес, ВидКИ);
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(п_Владелец, ЗначенияПолей, ВидКИ,,Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтроки(Результат, Параметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.ИмяРеквизитаАдресаДоставки = "АдресДоставки" Тогда
		Объект.АдресДоставки = Результат.Представление;
	ИначеЕсли Параметры.ИмяРеквизитаАдресаДоставки = "ДанныеПолучателя" Тогда
		Объект.ДанныеПолучателя = Результат.Представление;
		Элементы.ДанныеПолучателя.СписокВыбора.Добавить(Результат.Представление);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
		ЗаписатьАдресДоставки(Объект.Грузополучатель, Результат.Представление);
	Иначе
		ЗаписатьАдресДоставки(Объект.Контрагент, Результат.Представление);
	КонецЕсли; 
	
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОД_ДобавитьАдресПосле(Команда)

	СтандартнаяОбработка = Ложь;

	Если ТекущийЭлемент.Имя = "ДобавитьАдрес" Тогда
		ИмяРеквизитаАдресаДоставки = "АдресДоставки";
	ИначеЕсли ТекущийЭлемент.Имя = "ДобавитьАдрес1" Тогда
		ИмяРеквизитаАдресаДоставки = "ДанныеПолучателя";
	Иначе
		Возврат;
	КонецЕсли;
	
	АдресПредставление = Объект[ИмяРеквизитаАдресаДоставки];
	АдресЗначенияПолей = Объект[ИмяРеквизитаАдресаДоставки + "ЗначенияПолей"];
	АдресЗначение = Объект[ИмяРеквизитаАдресаДоставки + "Значение"];
	
	ДоставкаТоваровКлиент.ПриИзмененииПредставленияАдреса(Элементы.ДанныеПолучателя, АдресПредставление, АдресЗначенияПолей, Ложь);
	
	// Откроем диалог редактирования КИ
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВидКонтактнойИнформации", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресПартнера"));
	ПараметрыОткрытия.Вставить("ЗначенияПолей",           ДоставкаТоваровКлиентСервер.ПреобразоватьСтрокуВСписокПолей(АдресЗначенияПолей));
	ПараметрыОткрытия.Вставить("Значение",                АдресЗначение);
	ПараметрыОткрытия.Вставить("Представление",           АдресПредставление);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект",						Объект);
	ДополнительныеПараметры.Вставить("ИмяРеквизитаАдресаДоставки", 	ИмяРеквизитаАдресаДоставки);
	ДополнительныеПараметры.Вставить("Элемент", 					Элементы.ДанныеПолучателя);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытия,,Оповещение);

КонецПроцедуры

#КонецОбласти

Функция КонтактнаяИнформацияПоПредставлению(АдресПредставление)

	Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(АдресПредставление,
			Перечисления.ТипыКонтактнойИнформации.Адрес);

КонецФункции // ()

Процедура УстановитьПеревозчикПартнер()
	
	Если ЗначениеЗаполнено(Объект.ПеревозчикПартнер) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиента.Ссылка КАК Ссылка,
		|	ЗаказКлиента.ПеревозчикПартнер КАК ПеревозчикПартнер
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.ПеревозчикПартнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиента.Дата УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Объект.ПеревозчикПартнер = Выборка.ПеревозчикПартнер;
	КонецЕсли;
	
КонецПроцедуры



#КонецОбласти

#Область НаборыКомплекты

&НаСервере
&Вместо("ПолучитьЗагруженныеТоварыИзХранилища")
Процедура ОД_ПолучитьЗагруженныеТоварыИзХранилища(АдресТоваровВХранилище)

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Объект, СкладГруппа));
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ЗаполнитьПризнакОтмененоБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ЗаполнитьСодержание", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСодержанияУслугиВСтрокеТЧ(Объект, Ложь));
	СтруктураДействий.Вставить("ЗаполнитьПризнакВариантОформленияПродажи", Новый Структура("Номенклатура", "ВариантОформленияПродажи"));
	СтруктураДействий.Вставить("ПоместитьОбработанныеСтрокиВКэшированныеЗначения");
	СтруктураДействий.Вставить("ПриИзмененииТипаНоменклатурыИлиВариантаОбеспечения",
		Новый Структура("ЕстьРаботы, ЕстьОтменено", Истина, Истина));
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий,Объект);
	
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТоварыИзХранилища = ПолучитьИзВременногоХранилища(АдресТоваровВХранилище);
	
	// 18.03.2026, Т-6, получить загр. товары из хранилища
	// Зинаков 09.03.2026/1
	// Зинаков 05.12.2024/5
	Для Каждого СтрокаТоваров Из ТоварыИзХранилища Цикл
		СтрокаТЧТовары = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧТовары, СтрокаТоваров,,"КодСтроки");
		Если ЗначениеЗаполнено(Объект.Соглашение) Тогда
			Если ЗначениеЗаполнено(Объект.Соглашение.ВидЦен) Тогда
				ВидЦены = Объект.Соглашение.ВидЦен;
				Цена = ПолучитьЦену(СтрокаТоваров.Номенклатура, ВидЦены);
				СтрокаТЧТовары.ВидЦены = ВидЦены;
				СтрокаТЧТовары.Цена = Цена;
				
				Сообщить("Т-6, ЗаказКлиента.МодульФормы, ОД_ПолучитьЗагруженныеТоварыИзХранилища");
				
				// 01.04.2026
				СтруктураПараметровОтбора = Новый Структура("Дата, ВидЦеныДокумента, ВидЦеныАкционная, Номенклатура, НоменклатураНабора");
				СтруктураПараметровОтбора.Номенклатура			= СтрокаТоваров.Номенклатура;
				СтруктураПараметровОтбора.Дата					= ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
				СтруктураПараметровОтбора.ВидЦеныАкционная		= QWERTY_Сервер.ВидЦеныАкционная();
				СтруктураПараметровОтбора.ВидЦеныДокумента		= ВидЦены;
				СтруктураПараметровОтбора.НоменклатураНабора	= Справочники.Номенклатура.ПустаяСсылка();
				
				ЦенаАкционная = QWERTY_Сервер.ПолучитьЦенуПоОтбору(СтруктураПараметровОтбора);
					
				Если ЦенаАкционная > 0 Тогда
					СтрокаТЧТовары.ВидЦены = СтруктураПараметровОтбора.ВидЦеныАкционная;
					СтрокаТЧТовары.Цена = ЦенаАкционная;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		

		Если ЗначениеЗаполнено(СтрокаТоваров.НоменклатураНабора) Тогда
			
			Набор = СтрокаТоваров.НоменклатураНабора;

			ВариантРасчетаЦены = QWERTY_Сервер.ПолучитьВариантРасчетаЦены(Набор);
			
			Если  ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.РассчитываетсяИзЦенКомплектующих Тогда
				// распределение не нужно, будет выполнено в процедуре обработки строки
			Иначе // цена задается на набор, нужно распределение
				
				ЦенаНабора			= QWERTY_Сервер.ПолучитьЦену(Набор, ВидЦены, ТекущаяДатаСеанса());
				ЦенаНабораАкционная	= QWERTY_Сервер.ПолучитьЦену(Набор, QWERTY_Сервер.ВидЦеныАкционная(), ТекущаяДатаСеанса());
				Если ВидЦены.СпособЗаданияЦены = Перечисления.СпособыЗаданияЦен.Вручную Тогда
					ЦенаНабораАкционная = 0;
				КонецЕсли;
				Если ЦенаНабораАкционная > 0 Тогда
					ЦенаНабора = ЦенаНабораАкционная;
					СтрокаТЧТовары.ВидЦены = QWERTY_Сервер.ВидЦеныАкционная();
				КонецЕсли;
				
				ТЗ_Комплектующие = Комплектующие(Набор, ВидЦены);
				
				ОбщаяСтоимость = ТЗ_Комплектующие.Итог("Цена");
				
				Если  ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоЦенам Тогда
					Если ОбщаяСтоимость = 0 Тогда // 01.04.2026
						Продолжить;
					КонецЕсли;
					Для каждого Т Из ТЗ_Комплектующие Цикл
						ЦенаКомлектующейИсходная = Т.Цена;
						Если Т.Количество > 0 Тогда
							НоваяЦена = (ЦенаКомлектующейИсходная/Т.Количество / ОбщаяСтоимость) * ЦенаНабора;
						Иначе
							НоваяЦена = 0;
						КонецЕсли;
						НоваяЦена = Окр(НоваяЦена, 2);
						Т.ЦенаРасчетная = НоваяЦена;
						Т.СуммаРасчетная = НоваяЦена * Т.Количество;
					КонецЦикла;
				ИначеЕсли  ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоДолям Тогда
					Для каждого Т Из ТЗ_Комплектующие Цикл
						НоваяЦена = (Т.ДоляСтоимости/100) * ЦенаНабора;
						НоваяЦена = Окр(НоваяЦена, 2);
						Т.ЦенаРасчетная = НоваяЦена;
						Т.СуммаРасчетная = НоваяЦена * Т.Количество;
					КонецЦикла;
				КонецЕсли;

				Погрешность = ЦенаНабора - ТЗ_Комплектующие.Итог("СуммаРасчетная");
				Если Погрешность > 0 Тогда
					ТЗ_Комплектующие.Сортировать("Количество");
					Если ТЗ_Комплектующие.Количество() > 0 Тогда
						ТЗ_Комплектующие[0].ЦенаРасчетная = ТЗ_Комплектующие[0].ЦенаРасчетная + Погрешность; 
					КонецЕсли;
				КонецЕсли;
				СтрНайдено = ТЗ_Комплектующие.НайтиСтроки(Новый Структура("Номенклатура", СтрокаТЧТовары.Номенклатура));
				Если СтрНайдено.Количество() > 0 Тогда
					СтрокаТЧТовары.Цена = СтрНайдено[0].ЦенаРасчетная;
				КонецЕсли;				

			КонецЕсли; // вариант расчета цены
		КонецЕсли; // это элемент набора
		
		Если Объект.НеОтгружатьЧастями Тогда
			СтрокаТЧТовары.ДатаОтгрузки = Объект.ДатаОтгрузки;
		КонецЕсли;
		
		ПараметрыДействия = ОбеспечениеКлиентСервер.ПараметрыДействияПроверитьЗаполнитьОбеспечение(ВариантыОбеспечения);
		СтруктураДействий.Вставить("ПроверитьЗаполнитьОбеспечениеВДокументеПродажи", ПараметрыДействия);

		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТЧТовары, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	ОбеспечениеСервер.РассчитатьДатуОтгрузкиВСтрокахТабличнойЧасти(КэшированныеЗначения.ОбработанныеСтроки, Объект, Объект.Товары);
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	
	ПриИзмененииДатыОтгрузкиВТабЧасти();
	СкладыСервер.ПриИзмененииСкладаВТабличнойЧасти(Объект.Товары, ТаблицаСкладов, СкладГруппа);
	ВсегоСкладов = ТаблицаСкладов.Количество();
	СкладыКлиентСервер.ОбновитьКартинкуГруппыСкладов(НадписьНесколькоСкладов, Элементы.КартинкаНесколькоСкладов, ВсегоСкладов);
	
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	МногооборотнаяТараСервер.ОбновитьСостояниеЗаполненияМногооборотнойТары(Объект.СостояниеЗаполненияМногооборотнойТары);

КонецПроцедуры

Процедура ЗаполнитьНаборыКомплекты()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЗ_Товары.Номенклатура КАК Номенклатура,
		|	ТЗ_Товары.НоменклатураНабора КАК НоменклатураНабора,
		|	ТЗ_Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ТЗ_Товары.СуммаСНДС КАК СуммаСНДС
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	&ТЗ_Товары КАК ТЗ_Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СУММА(ВТ_Товары.КоличествоУпаковок) КАК Количество,
		|	СУММА(ВТ_Товары.СуммаСНДС) КАК Сумма,
		|	ВариантыКомплектацииНоменклатуры.Владелец КАК Набор,
		|	ВариантыКомплектацииНоменклатуры.Ссылка КАК ВариантКомплектации
		|ПОМЕСТИТЬ ВТ_Наборы
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
		|		ПО ВТ_Товары.НоменклатураНабора = ВариантыКомплектацииНоменклатуры.Владелец
		|
		|СГРУППИРОВАТЬ ПО
		|	ВариантыКомплектацииНоменклатуры.Владелец,
		|	ВариантыКомплектацииНоменклатуры.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок) КАК КоличествоВНаборе,
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка КАК ВариантКомплектации
		|ПОМЕСТИТЬ ВТ_ВариантыКомплектации
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|
		|СГРУППИРОВАТЬ ПО
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Наборы.Набор КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ВТ_ВариантыКомплектации.КоличествоВНаборе <> 0
		|			ТОГДА ВТ_Наборы.Количество / ВТ_ВариантыКомплектации.КоличествоВНаборе
		|	КОНЕЦ КАК Количество,
		|	ВЫБОР
		|		КОГДА ВТ_ВариантыКомплектации.КоличествоВНаборе <> 0
		|			ТОГДА ВТ_Наборы.Сумма / (ВТ_Наборы.Количество / ВТ_ВариантыКомплектации.КоличествоВНаборе)
		|	КОНЕЦ КАК Цена
		|ИЗ
		|	ВТ_Наборы КАК ВТ_Наборы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВариантыКомплектации КАК ВТ_ВариантыКомплектации
		|		ПО ВТ_Наборы.ВариантКомплектации = ВТ_ВариантыКомплектации.ВариантКомплектации";
	
	Запрос.УстановитьПараметр("ТЗ_Товары", Объект.Товары.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();

	Наборы.Очистить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Наборы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	НаборыКомплектыКоличество = Наборы.Количество();

КонецПроцедуры

