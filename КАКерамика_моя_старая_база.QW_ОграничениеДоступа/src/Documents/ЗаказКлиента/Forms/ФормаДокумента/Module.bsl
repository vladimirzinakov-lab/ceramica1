
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ОД_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокДанныеПолучателя();
	ЗаполнитьНаборыКомплекты();
	АссортиментВыделитьЦветом();
	
КонецПроцедуры

&НаКлиенте
Процедура ОД_ПриОткрытииПосле(Отказ)

	Если QWERTY_Сервер.Получить_РольДоступна("Операционист")
		ИЛИ QWERTY_Сервер.Получить_РольДоступна("МенеджерПоПродажамУправлениеРазделом")
		ИЛИ QWERTY_Сервер.Получить_РольДоступна("РуководительОтделаПродажДополнительно") Тогда
		
		ДанныеЗаказа = ПолучитьДанныеЗаказа(Объект.Ссылка);
		
		Если ДанныеЗаказа.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияЗаказовКлиентов.ВПроцессеОтгрузки")
			ИЛИ ДанныеЗаказа.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияЗаказовКлиентов.ОжидаетсяОплатаПослеОтгрузки")
			ИЛИ ДанныеЗаказа.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияЗаказовКлиентов.ГотовКЗакрытию") Тогда
			
			Если ДанныеЗаказа.СуммаОтгрузки > 0 Тогда
				Сообщить("Запрещено редактирование документа! Проведена реализация");
			КонецЕсли;
			Если ДанныеЗаказа.СуммаОплаты > 0 Тогда
				Сообщить("Запрещено редактирование документа! Проведена оплата");
			КонецЕсли;
			Если ЕстьЗаданиеНаПеревозку(Объект.Ссылка) Тогда
				Сообщить("Запрещено редактирование документа! Проведено задание на перевозку");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОД_ПослеЗаписиПосле(ПараметрыЗаписи)
	ЗаполнитьНаборыКомплекты();
КонецПроцедуры

&НаКлиенте
Процедура ОД_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Закрытие_РедактированиеКомплекта" Тогда
		ЗаполнитьНаборыКомплекты();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("ОбработкаВыбораПодборНаКлиентеПослеВопроса")
Процедура ОД_ОбработкаВыбораПодборНаКлиентеПослеВопроса(Ответ, ДополнительныеПараметры)
	ЗаполнитьНаборыКомплекты();
КонецПроцедуры

&НаСервере
&После("ПриУдаленииКомплектующихНаСервере")
Процедура ОД_ПриУдаленииКомплектующихНаСервере(ИмяТЧ, ДополнительныйПараметр)
	ЗаполнитьНаборыКомплекты();
КонецПроцедуры

&НаКлиенте
Процедура ОД_ОбработкаВыбораПосле(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма" Тогда
		ЗаполнитьНаборыКомплекты();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОД_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОД_ОбщиеФункции.УправлениеАссортиментом(Отказ, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	
	// 24.04.2024
	Орг = Справочники.Организации.НайтиПоРеквизиту("ИНН", "7706469887"); // ООО Керамика
	ОргРезерва = Справочники.Организации.НайтиПоНаименованию("Сергиенко 1", Истина); // ООО Керамика

	Если Объект.Организация = Орг Тогда
		Для каждого Т Из Объект.Товары Цикл

			Если Т.ВариантОбеспечения <> Перечисления.ВариантыОбеспечения.Отгрузить
				И Т.ВариантОбеспечения <> Перечисления.ВариантыОбеспечения.СоСклада Тогда
				Продолжить;
			КонецЕсли;

			Если Т.Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
				ОстатокКОформлению = ОД_ОбщиеФункции.ОстатокКОформлению(Т.Номенклатура, Объект.ДатаОтгрузки, Объект.Ссылка);
				Если ОстатокКОформлению = 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ОстатокОбщий = ОД_ОбщиеФункции.ОстатокТовараПоОрганизации(Т.Номенклатура, Объект.ДатаОтгрузки);
			ОстатокРезерв = ОД_ОбщиеФункции.ОстатокТовараПоОрганизации(Т.Номенклатура, Объект.ДатаОтгрузки, ОргРезерва);
			
			ОстатокРасчетный = ОстатокОбщий - ОстатокРезерв;
			
			Если Т.Количество > ОстатокРасчетный Тогда
				Отказ = Истина;
				Сообщить("Недостаточно товара по организации. Товар: " + Т.Номенклатура);
				Сообщить("   Остаток всего: " + ОстатокОбщий);
				Сообщить("   Остаток по организации, зарезервировано: " + ОстатокРезерв);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 11.07.2026 контроль номенклатуры сегмента
	Если ЗначениеЗаполнено(Объект.Соглашение)
		И ЗначениеЗаполнено(Объект.Соглашение.СегментНоменклатуры) Тогда
		
		Для каждого Т Из Объект.Товары Цикл
			ЕстьВСегменте = ЕстьВСегменте(Объект.Соглашение.СегментНоменклатуры, Т.Номенклатура);
			Если НЕ ЕстьВСегменте Тогда
				Сообщить("Строка: " + Т.НомерСтроки + ", " + Т.Номенклатура + " - нет в сегменте");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;

	// 20.07.2026 контроль сегмента запрета отгрузки
	Если ЗначениеЗаполнено(Объект.Соглашение) Тогда
		Если Объект.Статус <> Перечисления.СтатусыЗаказовКлиентов.НеСогласован Тогда
			Если ОД_ОбщиеФункции.УстановленЗапретОтгрузкиПоСегменту(ТекущийОбъект.Партнер, ТекущийОбъект.Соглашение) Тогда
				Сообщить("Отгрузка клиенту запрещена (установлен сегмент запрета отгрузки)");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;

		// 20.07.2026 контроль запрета отгрузки по превышению кредита
		Если Элементы.КартинкаОтгрузкаЗапрещена.Видимость Тогда
			ОтгрузкаСверхЛимита = УправлениеСвойствами.ЗначениеСвойства(Объект.Соглашение, "ОтгрузкаСверхЛимита");
			Если НЕ ОтгрузкаСверхЛимита <> Неопределено 
				ИЛИ НЕ ОтгрузкаСверхЛимита Тогда
				Сообщить("Отгрузка клиенту запрещена (превышение кредита)");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// 13.07.2026 Менеджерам запрещенио устанавливать произвольные цены
	Если РольДоступна("Операционист")
		ИЛИ РольДоступна("МенеджерПоПродажамУправлениеРазделом")
		ИЛИ РольДоступна("РуководительОтделаПродажДополнительно") Тогда
		Для каждого Т Из Объект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(Т.ВидЦены) Тогда
				Сообщить("Строка: " + Т.НомерСтроки + ", " + Т.Номенклатура + " - не установлен вид цены");
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
&Вместо("ПолучитьСтрокиИзБуфераОбмена")
Процедура ОД_ПолучитьСтрокиИзБуфераОбмена()
	
	ОперацииПередачи = ПродажиСервер.ОперацииПередачиТоваров();
	
	Если ОперацииПередачи.Найти(Объект.ХозяйственнаяОперация) <> Неопределено Тогда
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("ОтборПоТипуНоменклатуры",НоменклатураКлиентСервер.ОтборПоТоваруМногооборотнойТаре());
		ТаблицаТоваров = КопированиеСтрокСервер.ПолучитьСтрокиИзБуфераОбмена(ПараметрыОтбора);
	Иначе
		ТаблицаТоваров = КопированиеСтрокСервер.ПолучитьСтрокиИзБуфераОбмена();
	КонецЕсли;
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ТекущаяСтрока.ИндексНабора = ?(ЗначениеЗаполнено(ТекущаяСтрока.НоменклатураНабора), 1, 0);
		Если НЕ ИспользоватьРучныеСкидкиВПродажах Тогда
			ТекущаяСтрока.ПроцентРучнойСкидки = 0;
			ТекущаяСтрока.СуммаРучнойСкидки = 0;
		КонецЕсли;
		
		Если Объект.НеОтгружатьЧастями Тогда
			ТекущаяСтрока.ДатаОтгрузки = Объект.ДатаОтгрузки;
		КонецЕсли;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
		СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Объект, СкладГруппа));
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата, ПоДатеОтгрузки", Объект.НалогообложениеНДС, Объект.Дата, Истина));
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьПризнакОтмененоБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьСодержание", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСодержанияУслугиВСтрокеТЧ(Объект, Ложь));
		ПараметрыДействия = ОбеспечениеКлиентСервер.ПараметрыДействияПроверитьЗаполнитьОбеспечение(ВариантыОбеспечения);
		СтруктураДействий.Вставить("ПроверитьЗаполнитьОбеспечениеВДокументеПродажи", ПараметрыДействия);
		СтруктураДействий.Вставить("ПоместитьОбработанныеСтрокиВКэшированныеЗначения");
		СтруктураДействий.Вставить("ПриИзмененииТипаНоменклатурыИлиВариантаОбеспечения",
			Новый Структура("ЕстьРаботы, ЕстьОтменено", Истина, Истина));
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий,Объект);

		// 03.07.2026
		СтруктураДействий.Вставить("ЗаполнитьУсловияПродаж", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияУсловийПродажВСтрокеТЧ(Объект));
		
		КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		Если ЗначениеЗаполнено(СтрокаТовара.НоменклатураНабора) Тогда
			
			ВидЦены = Объект.Соглашение.ВидЦен;

			Набор = СтрокаТовара.НоменклатураНабора;

			ВариантРасчетаЦены = QWERTY_Сервер.ПолучитьВариантРасчетаЦены(Набор);
			
			Если  ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.РассчитываетсяИзЦенКомплектующих Тогда
				// распределение не нужно, будет выполнено в процедуре обработки строки
			Иначе // цена задается на набор, нужно распределение
				
				ЦенаНабора			= QWERTY_Сервер.ПолучитьЦену(Набор, ВидЦены, ТекущаяДатаСеанса());
				ЦенаНабораАкционная	= QWERTY_Сервер.ПолучитьЦену(Набор, QWERTY_Сервер.ВидЦеныАкционная(), ТекущаяДатаСеанса());
				Если ВидЦены.СпособЗаданияЦены = Перечисления.СпособыЗаданияЦен.Вручную Тогда
					ЦенаНабораАкционная = 0;
				КонецЕсли;
				Если ЦенаНабораАкционная > 0 Тогда
					ЦенаНабора = ЦенаНабораАкционная;
					ТекущаяСтрока.ВидЦены = QWERTY_Сервер.ВидЦеныАкционная();
				КонецЕсли;
				
				ТЗ_Комплектующие = Комплектующие(Набор, ВидЦены);
				
				ОбщаяСтоимость = ТЗ_Комплектующие.Итог("Цена");
				
				Если  ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоЦенам Тогда
					Если ОбщаяСтоимость = 0 Тогда // 01.04.2026
						Продолжить;
					КонецЕсли;
					Для каждого Т Из ТЗ_Комплектующие Цикл
						ЦенаКомлектующейИсходная = Т.Цена;
						Если Т.Количество > 0 Тогда
							НоваяЦена = (ЦенаКомлектующейИсходная/Т.Количество / ОбщаяСтоимость) * ЦенаНабора;
						Иначе
							НоваяЦена = 0;
						КонецЕсли;
						НоваяЦена = Окр(НоваяЦена, 2);
						Т.ЦенаРасчетная = НоваяЦена;
						Т.СуммаРасчетная = НоваяЦена * Т.Количество;
					КонецЦикла;
				ИначеЕсли  ВариантРасчетаЦены = Перечисления.ВариантыРасчетаЦенНаборов.ЦенаЗадаетсяЗаНаборРаспределяетсяПоДолям Тогда
					Для каждого Т Из ТЗ_Комплектующие Цикл
						НоваяЦена = (Т.ДоляСтоимости/100) * ЦенаНабора;
						НоваяЦена = Окр(НоваяЦена, 2);
						Т.ЦенаРасчетная = НоваяЦена;
						Т.СуммаРасчетная = НоваяЦена * Т.Количество;
					КонецЦикла;
				КонецЕсли;

				Погрешность = ЦенаНабора - ТЗ_Комплектующие.Итог("СуммаРасчетная");
				Если Погрешность > 0 Тогда
					ТЗ_Комплектующие.Сортировать("Количество");
					Если ТЗ_Комплектующие.Количество() > 0 Тогда
						ТЗ_Комплектующие[0].ЦенаРасчетная = ТЗ_Комплектующие[0].ЦенаРасчетная + Погрешность; 
					КонецЕсли;
				КонецЕсли;
				СтрНайдено = ТЗ_Комплектующие.НайтиСтроки(Новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура));
				Если СтрНайдено.Количество() > 0 Тогда
					ТекущаяСтрока.Цена = СтрНайдено[0].ЦенаРасчетная;
				КонецЕсли;				

			КонецЕсли; // вариант расчета цены
		КонецЕсли; // это элемент набора

	КонецЦикла;
	ОбеспечениеСервер.РассчитатьДатуОтгрузкиВСтрокахТабличнойЧасти(КэшированныеЗначения.ОбработанныеСтроки, Объект, Объект.Товары);
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	
	ПриИзмененииДатыОтгрузкиВТабЧасти();
	СкладыСервер.ПриИзмененииСкладаВТабличнойЧасти(Объект.Товары, ТаблицаСкладов, СкладГруппа);
	ВсегоСкладов = ТаблицаСкладов.Количество();
	СкладыКлиентСервер.ОбновитьКартинкуГруппыСкладов(НадписьНесколькоСкладов, Элементы.КартинкаНесколькоСкладов, ВсегоСкладов);
	
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	МногооборотнаяТараСервер.ОбновитьСостояниеЗаполненияМногооборотнойТары(Объект.СостояниеЗаполненияМногооборотнойТары);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
&После("ПартнерПриИзменении")
Процедура ОД_ПартнерПриИзменении(Элемент)

	ЗаполнитьСписокДанныеПолучателя();
	
	Объект.Проект = "";
	УправлениеДоступностьюПоляПроект();

КонецПроцедуры

&НаКлиенте
Процедура ОД_СпособДоставкиНачалоВыбораПосле(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СписокВыбора = Элементы.СпособДоставки.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СпособыДоставки.СиламиПеревозчика"), "Перевозчик (с нашего склада)");
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СпособыДоставки.КПолучателюОпределяетСлужбаДоставки"), "На усмотрение транспортной службы");

КонецПроцедуры

&НаКлиенте
Процедура ОД_ТоварыПриИзмененииПосле(Элемент)

	АссортиментВыделитьЦветом();

КонецПроцедуры

&НаКлиенте
Процедура ОД_ДанныеПолучателяНачалоВыбораПосле(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ИмяРеквизитаАдресаДоставки = "ДанныеПолучателя";
	
	АдресПредставление = Объект[ИмяРеквизитаАдресаДоставки];
	АдресЗначенияПолей = Объект[ИмяРеквизитаАдресаДоставки + "ЗначенияПолей"];
	АдресЗначение = Объект[ИмяРеквизитаАдресаДоставки + "Значение"];
	
	ЗначенияПолей = ДоставкаТоваровКлиентСервер.ПреобразоватьСтрокуВСписокПолей(АдресЗначенияПолей);
	
	Если ПустаяСтрока(ЗначенияПолей) И ЗначениеЗаполнено(АдресПредставление) Тогда
		ЗначенияПолей = КонтактнаяИнформацияПоПредставлению(АдресПредставление);
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВидКонтактнойИнформации", 	ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресПартнера"));
	ПараметрыОткрытия.Вставить("ЗначенияПолей",				ЗначенияПолей );
	ПараметрыОткрытия.Вставить("Значение",					АдресЗначение);
	ПараметрыОткрытия.Вставить("Представление",				АдресПредставление);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект",						Объект);
	ДополнительныеПараметры.Вставить("ИмяРеквизитаАдресаДоставки", 	ИмяРеквизитаАдресаДоставки);
	ДополнительныеПараметры.Вставить("Элемент", 					Элементы.ДанныеПолучателя);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытия,,Оповещение);

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
&Вместо("Подключаемый_ВыполнитьКоманду")
Процедура ОД_Подключаемый_ВыполнитьКоманду(Команда)

	ИмяПФ = "ЗаявкаАвтотранспортаВер2";
	
	Если Команда.Имя = "ПодменюПечатьОбычное_" + ИмяПФ Тогда
		
		ДанныеЗаданиеНаПеревозку = ЗаданиеНаПеревозку(Объект.Ссылка);
		
		Если ПустаяСтрока(ДанныеЗаданиеНаПеревозку.КлючСвязи) Тогда
			Сообщить("! не определен документ Задание на перевозку");
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура();
		
		ТекущийОбъектПечати = Новый Массив;
		ТекущийОбъектПечати.Добавить(ДанныеЗаданиеНаПеревозку.ЗаданиеНаПеревозку);
		ТекущийОбъектПечати.Добавить(ДанныеЗаданиеНаПеревозку.КлючСвязи);
		
		ТекМенеджерПечати = "Обработка." + ИмяПФ;
		ИД_ПечатнойФормы = "ВнешняяПечатнаяФорма." + ИмяПФ; 
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(ТекМенеджерПечати, ИД_ПечатнойФормы, ТекущийОбъектПечати, ЭтотОбъект, ДополнительныеПараметры);
	Иначе	
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	КонецЕсли;

КонецПроцедуры
	
#КонецОбласти

