						ПЭ.Видимость = Истина;
					Иначе
						ПЭ.Видимость = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// убрать все отчеты, кроме
			СтрокаТабКоманд = ТабКоманд.Найти("Состояние выполнения", "Представление");
			Если СтрокаТабКоманд <> Неопределено Тогда
				ИД = СтрокаТабКоманд.Идентификатор;
				Для каждого ПЭ Из Элементы.ПодменюОтчетыВажное.ПодчиненныеЭлементы Цикл
					Если СтрНайти(ПЭ.Имя, ИД) > 0 Тогда
						ПЭ.Видимость = Истина;
					Иначе
						ПЭ.Видимость = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

	Если РольДоступна("РабочееМестоМенеджераПоЗакупкамПоставщикиРФ")
		ИЛИ РольДоступна("РабочееМестоМенеджераПоЗакупкам") Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Элементы.ЗабратьВозврат.Видимость = Ложь;
	// 14.07.2026
	Элементы.ОсобыеУсловияПеревозкиДоставкаПеревозчиком.Видимость = Ложь;
	Элементы.ОсобыеУсловияПеревозкиОписаниеДоставкаПеревозчиком.Видимость = Ложь;
	
	УправлениеДоступностьюПоляПроект();
	
КонецПроцедуры

Функция ПолучитьДанныеЗаказа(п_Ссылка)

	Рез = Новый Структура();
	Рез.Вставить("Состояние", "");
	Рез.Вставить("СуммаОплаты", 0);
	Рез.Вставить("ПроцентОплаты", 0);
	Рез.Вставить("СуммаОтгрузки", 0);
	Рез.Вставить("ПроцентОтгрузки", 0);
	Рез.Вставить("СуммаДолга", 0);
	Рез.Вставить("СуммаОплаты", 0);
	Рез.Вставить("ПроцентДолга", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияЗаказовКлиентов.Состояние КАК Состояние,
		|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты,
		|	СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты,
		|	СостоянияЗаказовКлиентов.СуммаОтгрузки КАК СуммаОтгрузки,
		|	СостоянияЗаказовКлиентов.ПроцентОтгрузки КАК ПроцентОтгрузки,
		|	СостоянияЗаказовКлиентов.СуммаДолга КАК СуммаДолга,
		|	СостоянияЗаказовКлиентов.ПроцентДолга КАК ПроцентДолга
		|ИЗ
		|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		|ГДЕ
		|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", п_Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Рез, Выборка);
		Возврат Рез;
	КонецЕсли;
	
	Возврат Рез;

КонецФункции // ()

Функция ЕстьЗаданиеНаПеревозку(п_Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозку.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаданиеНаПеревозку КАК ЗаданиеНаПеревозку
		|ГДЕ
		|	ЗаданиеНаПеревозку.Распоряжения.Распоряжение = &Распоряжение
		|	И ЗаданиеНаПеревозку.Проведен";
	
	Запрос.УстановитьПараметр("Распоряжение", п_Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции // ()

Функция УправлениеДоступностьюПоляПроект()

	Если ЗначениеЗаполнено(Объект.Партнер) 
		И ЗначениеЗаполнено(Объект.Партнер.Проект) Тогда
		
		Элементы.Проект.Доступность = Истина;
		Элементы.Проект.КнопкаОткрытия = Ложь;
		Элементы.Проект.КнопкаСоздания = Ложь;
		Элементы.Проект.РежимВыбораИзСписка = Истина;
		Элементы.Проект.СписокВыбора.Очистить();
		Элементы.Проект.СписокВыбора.Добавить(Объект.Партнер.Проект);
		
	Иначе
		Элементы.Проект.Доступность = Ложь;
	КонецЕсли;

КонецФункции // ()

