
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоПросмотр = Истина;
	Заголовок = "Подписки и оплата";
	
	Элементы.ОрганизацияДиадок.ТолькоПросмотр = Истина;
	Элементы.Дата.ТолькоПросмотр = Истина;
	Элементы.ТекстОшибки.ТолькоПросмотр = Истина;
	Элементы.ДанныеТекст.ТолькоПросмотр = Истина;
	
	ЗаполнитьДанныеТекст();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеТекст()
	
	ДанныеХранилище = ПолучитьДанныеХранилищеЗаписи();
	
	Если ДанныеХранилище = Неопределено Тогда
		ДанныеТекст = "";
		Возврат;
	КонецЕсли;
	
	Данные = ДанныеХранилище.Получить();
	
	Если Данные = Неопределено Тогда
		ДанныеТекст = "";
		Возврат;
	КонецЕсли;
	
	ДанныеТекст = КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(Данные);
	ДанныеТекст = ФорматироватьJSON(ДанныеТекст);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеХранилищеЗаписи()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияДиадок", Запись.ОрганизацияДиадок);
	Запрос.УстановитьПараметр("ТипДанных", Запись.ТипДанных);
	Запрос.УстановитьПараметр("Разрез1", Запись.Разрез1);
	Запрос.УстановитьПараметр("Разрез2", Запись.Разрез2);
	Запрос.УстановитьПараметр("Разрез3", Запись.Разрез3);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ДанныеХранилище КАК ДанныеХранилище
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок = &ОрганизацияДиадок
	|	И КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез1 = &Разрез1
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &Разрез2
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез3 = &Разрез3";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ДанныеХранилище;
	
КонецФункции

&НаСервере
Функция ФорматироватьJSON(СтрокаJSON)
	
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ЗначениеJSON = ПрочитатьJSON(ЧтениеJSON);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ПереносСтрок = ПереносСтрокJSON.Авто;
		
		НастройкиСериализации = Новый НастройкиСериализацииJSON;
		НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
		
		ЗаписатьJSON(ЗаписьJSON, ЗначениеJSON, НастройкиСериализации);
		
		Возврат ЗаписьJSON.Закрыть();
		
	Исключение
		
		Возврат СтрокаJSON;
		
	КонецПопытки;
	
КонецФункции

#КонецОбласти
