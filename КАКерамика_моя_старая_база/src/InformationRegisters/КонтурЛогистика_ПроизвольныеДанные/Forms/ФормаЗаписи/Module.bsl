#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьСохраненныеДанные(Команда)
	
	ТабличныйДокумент = СформироватьТабличныйДокументСохраненныхДанныхИННПартнеровEDI();
	
	Если ТабличныйДокумент = Неопределено Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Сохраненные данные ИНН партнеров EDI отсутствуют или имеют неверный формат.");
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент.Показать("ИНН партнеров EDI");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзEDI(Команда)
	
	ПараметрыФЗ = Новый Структура;
	ПараметрыФЗ.Вставить("ТихийРежим", Истина);
	
	ПараметрыЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ПараметрыЗапускаФоновогоЗаданияВФормеФоновогоЗадания();
	ПараметрыЗапуска.ЗапуститьМетод = "КонтурЛогистика_ДлительныеОперацииСервер.ОбновитьВсеИННПартнеровEDI";
	ПараметрыЗапуска.КлючФоновогоЗадания = "КлючФЗ_ОбновитьВсеИННПартнеровEDI_Ручное";
	ПараметрыЗапуска.ПараметрыЗапускаемогоМетода = ПараметрыФЗ;
	ПараметрыЗапуска.ПредставлениеЗадачи = "Обновление кэша ИНН+КПП партнеров EDI";
	ПараметрыЗапуска.ЗакрытьПриУспешномВыполнении = Истина;
	ПараметрыЗапуска.ОтображатьПрогресс = Ложь;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ФоновоеЗадание",
		ПараметрыЗапуска,
		ЭтаФорма,
		ЭтаФорма,
		"ОбновитьИзEDIЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзEDIЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// EDI_КэшИННПартнеров() в модуле ПовтИсп — сбрасываем, чтобы следующий поиск взял свежие данные из РС.
	ОбновитьПовторноИспользуемыеЗначения();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТребованияПартнеров(Команда)
	
	ПараметрыФЗ = Новый Структура;
	ПараметрыФЗ.Вставить("ТихийРежим", Истина);
	
	ПараметрыЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ПараметрыЗапускаФоновогоЗаданияВФормеФоновогоЗадания();
	ПараметрыЗапуска.ЗапуститьМетод = "КонтурЛогистика_ДлительныеОперацииСервер.ОбновитьТребованияПартнеров";
	ПараметрыЗапуска.КлючФоновогоЗадания = "КлючФЗ_ОбновитьТребованияПартнеров_Ручное";
	ПараметрыЗапуска.ПараметрыЗапускаемогоМетода = ПараметрыФЗ;
	ПараметрыЗапуска.ПредставлениеЗадачи = "Обновление требований торговых сетей";
	ПараметрыЗапуска.ЗакрытьПриУспешномВыполнении = Истина;
	ПараметрыЗапуска.ОтображатьПрогресс = Ложь;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ФоновоеЗадание",
		ПараметрыЗапуска,
		ЭтаФорма,
		ЭтаФорма,
		"ОбновитьТребованияПартнеровЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТребованияПартнеровЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьПовторноИспользуемыеЗначения();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьJSON(Команда)
	
	ТекстТребований = СформироватьТекстТребованийПартнеров();
	
	Если Не ЗначениеЗаполнено(ТекстТребований) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Сохраненные требования партнеров отсутствуют или имеют неверный формат.");
		Возврат;
	КонецЕсли;
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстТребований);
	ТекстовыйДокумент.Показать("Требования партнеров (JSON)");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция КлючЗаписиДляПеренаправления()
	
	Возврат РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.КлючЗаписи(
		Запись.ОрганизацияДиадок,
		Запись.ТипДанных,
		Запись.Разрез1,
		Запись.Разрез2,
		Запись.Разрез3);
	
КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументСохраненныхДанныхИННПартнеровEDI()
	
	ДанныеХранилище = ПолучитьДанныеХранилищеЗаписи();
	
	Если ДанныеХранилище = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ДанныеХранилище.Получить();
	
	Если ТипЗнч(Данные) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТабличныйДокументРезультат = Новый ТабличныйДокумент;
	ТабличныйДокументРезультат.ТолькоПросмотр = Истина;
	ТабличныйДокументРезультат.ОтображатьЗаголовки = Ложь;
	ТабличныйДокументРезультат.ОтображатьСетку = Истина;
	
	НомерКолонки = 1;
	Для Каждого Колонка Из Данные.Колонки Цикл
		
		ТабличныйДокументРезультат.Область(1, НомерКолонки).Текст = Колонка.Имя;
		НомерКолонки = НомерКолонки + 1;
		
	КонецЦикла;
	
	НомерСтроки = 2;
	Для Каждого СтрокаДанных Из Данные Цикл
		
		НомерКолонки = 1;
		Для Каждого Колонка Из Данные.Колонки Цикл
			
			ТабличныйДокументРезультат.Область(НомерСтроки, НомерКолонки).Текст = Строка(СтрокаДанных[Колонка.Имя]);
			НомерКолонки = НомерКолонки + 1;
			
		КонецЦикла;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Возврат ТабличныйДокументРезультат;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеХранилищеЗаписи()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияДиадок", Запись.ОрганизацияДиадок);
	Запрос.УстановитьПараметр("ТипДанных", Запись.ТипДанных);
	Запрос.УстановитьПараметр("Разрез1", Запись.Разрез1);
	Запрос.УстановитьПараметр("Разрез2", Запись.Разрез2);
	Запрос.УстановитьПараметр("Разрез3", Запись.Разрез3);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ДанныеХранилище КАК ДанныеХранилище
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок = &ОрганизацияДиадок
	|	И КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез1 = &Разрез1
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &Разрез2
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез3 = &Разрез3";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ДанныеХранилище;
	
КонецФункции

&НаСервере
Функция СформироватьТекстТребованийПартнеров()
	
	ДанныеХранилище = ПолучитьДанныеХранилищеЗаписи();
	
	Если ДанныеХранилище = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Данные = ДанныеХранилище.Получить();
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(Данные);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти
