
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПеренаправитьНаФорму = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ПолноеИмяФормыЗаписиПоТипуДанных(
		Запись.ТипДанных);
	
	Если ЗначениеЗаполнено(ПеренаправитьНаФорму) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запись.ТипДанных) Тогда
		
		ПараметрыПолей = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ПараметрыПолейПоТипуДанных(Запись.ТипДанных);
		
		Для Счет = 1 По 3 Цикл
			ТекущийЭлемент = Элементы["Разрез" + Строка(Счет)];
			ДанныеПоля = ПараметрыПолей
			["Разрез" + Строка(Счет)];
			
			ТекущийЭлемент.Заголовок = ДанныеПоля.Заголовок;
		КонецЦикла;
		
		Элементы.Количество.Заголовок = ПараметрыПолей.Количество.Заголовок;
		Элементы.Дата.Заголовок = ПараметрыПолей.Дата.Заголовок;
		Элементы.Ответственный.Заголовок = ПараметрыПолей.Ответственный.Заголовок;
		Элементы.Реквизит1.Заголовок = ПараметрыПолей.Реквизит1.Заголовок;
		
		Если Запись.ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ГСМ Тогда
			ПЛТитул1 = Документы.КонтурЛогистика_ПЛ_Титул1.НайтиПоРеквизиту("kl_id", Запись.Разрез1);
		КонецЕсли;
		
		Элементы.ПЛТитул1.Видимость = ЗначениеЗаполнено(ПЛТитул1);
		
	КонецЕсли;
	
	ЭтоИННПартнеровEDI = Запись.ТипДанных
		= РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ИННПартнеровEDI;
	ЭтоТребованияПартнеров = Запись.ТипДанных
		= РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ТребованияПартнеров;
	Элементы.ПоказатьСохраненныеДанные.Видимость = ЭтоИННПартнеровEDI;
	Элементы.ОбновитьИзEDI.Видимость = ЭтоИННПартнеровEDI;
	Элементы.ОбновитьТребованияПартнеров.Видимость = ЭтоТребованияПартнеров;
	Элементы.ПоказатьJSON.Видимость = ЭтоТребованияПартнеров;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(ПеренаправитьНаФорму) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", КлючЗаписиДляПеренаправления());
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ПеренаправитьНаФорму,
		ПараметрыФормы,
		,
		ЭтаФорма);
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

