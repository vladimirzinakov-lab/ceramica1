        <checkBoxType>Tumbler</checkBoxType>
        <editFormat>
          <key>ru</key>
          <value>БЛ='Не учитывать, выбрасывать из грузов'; БИ='Да, это груз'</value>
        </editFormat>
        <equalElementsWidth>false</equalElementsWidth>
      </extInfo>
