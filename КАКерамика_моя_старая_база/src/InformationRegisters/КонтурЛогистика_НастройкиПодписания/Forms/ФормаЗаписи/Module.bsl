&НаСервере
Процедура ПроверитьМЧДНаСервере()
	
	PowerOfAttorneyPrevalidateResult = КонтурЛогистика_API_Диадок.Диадок_АПИ_PrevalidatePowerOfAttorney(Запись.ОрганизацияДиадок.ID, Запись.МЧД, Запись.Сертификат);
		
	ЗаписатьПротоколВалидации(PowerOfAttorneyPrevalidateResult);
	
	Если PowerOfAttorneyPrevalidateResult.Свойство("Статус404") Или ЕстьОшибкаВОтвете(PowerOfAttorneyPrevalidateResult, "PowerOfAttorneyNotFound", "PoaNotFound") Тогда
		
		Если ЗначениеЗаполнено(Запись.taskIdRegisterPOA) Тогда
			
			PowerOfAttorneyRegisterResult = КонтурЛогистика_API_Диадок.Диадок_АПИ_RegisterPowerOfAttorneyResult(Запись.ОрганизацияДиадок.ID, Запись.taskIdRegisterPOA);
			
			Если PowerOfAttorneyRegisterResult.OperationStatus = "Done" Тогда
				
				ОшибкаРегистрации = Ложь;
				
				PowerOfAttorneyPrevalidateResult = КонтурЛогистика_API_Диадок.Диадок_АПИ_PrevalidatePowerOfAttorney(Запись.ОрганизацияДиадок.ID, Запись.МЧД, Запись.Сертификат);
				Если PowerOfAttorneyPrevalidateResult.Свойство("PrevalidateStatus") Тогда
					ОбработатьОтветПроверкиМЧД(PowerOfAttorneyPrevalidateResult);
				КонецЕсли;
				
			Иначе
				
				ОшибкаРегистрации = Истина;
				ЗаполнитьОшибкиРегистрацииМЧД(PowerOfAttorneyRegisterResult);
				
			КонецЕсли;
			
		Иначе
		
			AsyncMethodResult = КонтурЛогистика_API_Диадок.Диадок_АПИ_RegisterPowerOfAttorney(Запись.ОрганизацияДиадок, Запись.МЧД);
			
			Если AsyncMethodResult.Свойство("taskId") Тогда
				
				Запись.taskIdRegisterPOA = AsyncMethodResult.taskId;				
				Записать();
				
				PowerOfAttorneyRegisterResult = КонтурЛогистика_API_Диадок.Диадок_АПИ_RegisterPowerOfAttorneyResult(Запись.ОрганизацияДиадок.ID, AsyncMethodResult.taskId);
				
				Если PowerOfAttorneyRegisterResult.OperationStatus = "Done" Тогда
					
					ОшибкаРегистрации = Ложь;
					
					PowerOfAttorneyPrevalidateResult = КонтурЛогистика_API_Диадок.Диадок_АПИ_PrevalidatePowerOfAttorney(Запись.ОрганизацияДиадок.ID, Запись.МЧД, Запись.Сертификат);
					Если PowerOfAttorneyPrevalidateResult.Свойство("PrevalidateStatus") Тогда
						ОбработатьОтветПроверкиМЧД(PowerOfAttorneyPrevalidateResult);
					КонецЕсли;
					
				Иначе
					
					ОшибкаРегистрации = Истина;
					ЗаполнитьОшибкиРегистрацииМЧД(PowerOfAttorneyRegisterResult);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	
	ИначеЕсли PowerOfAttorneyPrevalidateResult.Свойство("PrevalidateStatus") Тогда
		
		ОбработатьОтветПроверкиМЧД(PowerOfAttorneyPrevalidateResult);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПротоколВалидации(Ответ)
	
	Попытка
	    
		Если Ответ.Свойство("PrevalidateStatus")
			И Ответ.PrevalidateStatus.Свойство("ValidationProtocol")
			И Ответ.PrevalidateStatus.ValidationProtocol.Свойство("CheckResults") Тогда	    		
			Запись.ПротоколВалидации = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПротоколВалидацииВСтроку(Ответ.PrevalidateStatus.ValidationProtocol.CheckResults);		
		Иначе		
			Запись.ПротоколВалидации = "";		
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить("Ошибка чтения протокола валидации. " + ИнформацияОбОшибке);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ЕстьОшибкаВОтвете(Ответ, КодОшибки, КодОшибки2 = "")
	
	Если Ответ.Свойство("PrevalidateStatus") Тогда
	
		Если Ответ.PrevalidateStatus.Свойство("ValidationProtocol") Тогда   
			
			Ошибки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибкиИзПротоколаВалидации(Ответ.PrevalidateStatus.ValidationProtocol);
			
			Для каждого Error Из Ошибки Цикл
				
				Если ЕстьОшибкаВСтруктуре(Error, КодОшибки, КодОшибки2) Тогда
					Возврат Истина;
				КонецЕсли;
				
			КонецЦикла;
					
		ИначеЕсли Ответ.PrevalidateStatus.Свойство("OperationError") Тогда
			
			OperationError = Ответ.PrevalidateStatus.OperationError;
			
			Если ЕстьОшибкаВСтруктуре(OperationError, КодОшибки, КодОшибки2) Тогда
				Возврат Истина;
			КонецЕсли;
			 					
		ИначеЕсли Ответ.PrevalidateStatus.Свойство("Errors") Тогда
			
			Для каждого Error Из Ответ.PrevalidateStatus.Errors Цикл
				
				Если ЕстьОшибкаВСтруктуре(Error, КодОшибки, КодОшибки2) Тогда
					Возврат Истина;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЕстьОшибкаВСтруктуре(СтруктураОшибки, КодОшибки, КодОшибки2 = "")
	
	Если СтруктураОшибки.Свойство("Code") И СтруктураОшибки.Code = КодОшибки Тогда
		Возврат Истина;
	ИначеЕсли СтруктураОшибки.Свойство("Text") И ЗначениеЗаполнено(КодОшибки2) И Найти(СтруктураОшибки.Text, КодОшибки2) > 0 Тогда
		Возврат Истина;		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОшибкиРегистрацииМЧД(PowerOfAttorneyRegisterResult)
	
	Запись.ТекстСтатусаПроверки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ОписаниеСтатусаВыполненияРегистрации(PowerOfAttorneyRegisterResult.OperationStatus);
	
	Если ЗначениеЗаполнено(Запись.taskIdRegisterPOA) Тогда
		Запись.ТекстСтатусаПроверки = Запись.ТекстСтатусаПроверки + ". Идентификатор регистрации taskId: " + Запись.taskIdRegisterPOA;	
	КонецЕсли;
	
	Запись.СтатусПроверки = "IsNotValid";
	
	Если PowerOfAttorneyRegisterResult.Свойство("Errors") Тогда 
		Запись.ОшибкиПроверки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МассивОшибокВСтроку(PowerOfAttorneyRegisterResult.Errors);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьОтветПроверкиМЧД(PowerOfAttorneyPrevalidateResult)
	
	Если PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Свойство("StatusText") Тогда
		Запись.ТекстСтатусаПроверки = PowerOfAttorneyPrevalidateResult.PrevalidateStatus.StatusText;	
	КонецЕсли;
	Если PowerOfAttorneyPrevalidateResult.PrevalidateStatus.Свойство("StatusNamedId") Тогда
		Запись.СтатусПроверки = PowerOfAttorneyPrevalidateResult.PrevalidateStatus.StatusNamedId;			
	КонецЕсли;
	
	Запись.ДатаПроверки = ТекущаяДатаСеанса();
	
	Запись.ОшибкиПроверки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ОшибкиПроверкиМЧД(PowerOfAttorneyPrevalidateResult);
			
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМЧД(Команда)
	
	Если Не ЗначениеЗаполнено(Запись.Сертификат) Тогда
		Сообщить("Сертификат не выбран!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.МЧД) Тогда
		Сообщить("МЧД не выбрана!");
		Возврат;
	КонецЕсли;
	
	
	Если АвторизацияПоOIDC И Не АвторизацияВыполнена Тогда
		// Перед проверкой нужно авторизоваться.
		Оповещение = Новый ОписаниеОповещения("ПослеАутентификации", ЭтаФорма);
		КонтурЛогистика_ОбщегоНазначенияКлиент.ВыполнитьАвторизациюНаПортале(
			ЭтаФорма, Запись.ОрганизацияДиадок, Оповещение);
			
	Иначе
			
		ВыполнитьПроверкуМЧД();		
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуМЧД()
	
	Попытка
		ПроверитьМЧДНаСервере();
	Исключение
		ИдентификаторДоверенности = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Запись.МЧД, "ИдентификаторДоверенности");
		ДопИнформация = Новый Структура;
		Если ЗначениеЗаполнено(ИдентификаторДоверенности) Тогда
			ДопИнформация.Вставить("IdМЧД", ИдентификаторДоверенности);
		КонецЕсли;
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ПроверитьМЧДНаСервере",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Запись.МЧД, ДопИнформация);
	КонецПопытки;
	
	ОтобразитьГруппуПроверкиМЧД();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьГруппуПроверкиМЧД()

	Если Запись.ОбщийСпособПодтвержденияПолномочий = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.МЧД") Тогда		
				
		Элементы.ГруппаПроверкаМЧД.Видимость = Не Запись.МЧД.Пустая();
		
		КолвоДнейПроверкиМЧД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КоличествоДнейДляПредупрежденияПроверкиМЧД();
		МЧДВалидна = КонтурЛогистика_МашиночитаемыеДовернностиСервер.МЧДВалидна(Запись.СтатусПроверки);
		Если ЗначениеЗаполнено(Запись.МЧД) И МЧДВалидна И РазницаВДнях() > КолвоДнейПроверкиМЧД Тогда
			ОписаниеСтатусаПроверки = "Проверка МЧД не выполнялась более "
													+ Строка(КолвоДнейПроверкиМЧД) + " дней"
													+ Формат(Запись.ДатаПроверки, "ДФ=' (на дд.ММ.гггг ЧЧ:мм:сс)'");
			Элементы.КартинкаПроверкаМЧДУспешно.Видимость = Ложь;
			Элементы.КартинкаПроверкаМЧДНеУспешно.Видимость = Истина;
			Элементы.ПроверитьМЧД.Заголовок = "Перепроверить";
			Элементы.ГруппаПроверкаМЧД.ЦветФона = Новый Цвет(249, 237, 167);
			Элементы.ОписаниеСтатусаПроверки.ЦветРамки = Новый Цвет(249, 237, 167);
			Элементы.ОписаниеСтатусаПроверки.ЦветФона = Новый Цвет(249, 237, 167);			
		ИначеЕсли Не ЗначениеЗаполнено(Запись.СтатусПроверки) Тогда
			ОписаниеСтатусаПроверки = "Проверка не выполнялась";
			Элементы.КартинкаПроверкаМЧДУспешно.Видимость = Ложь;
			Элементы.КартинкаПроверкаМЧДНеУспешно.Видимость = Истина;
			Элементы.ПроверитьМЧД.Заголовок = "Проверить";
			Элементы.ГруппаПроверкаМЧД.ЦветФона = Новый Цвет(249, 237, 167);
			Элементы.ОписаниеСтатусаПроверки.ЦветРамки = Новый Цвет(249, 237, 167);
			Элементы.ОписаниеСтатусаПроверки.ЦветФона = Новый Цвет(249, 237, 167);			
		ИначеЕсли МЧДВалидна Тогда
			ОписаниеСтатусаПроверки = СокрЛП(Запись.ТекстСтатусаПроверки) + Формат(Запись.ДатаПроверки, "ДФ=' (на дд.ММ.гггг ЧЧ:мм:сс)'");
			Элементы.КартинкаПроверкаМЧДУспешно.Видимость = Истина;
			Элементы.КартинкаПроверкаМЧДНеУспешно.Видимость = Ложь;
			Элементы.ПроверитьМЧД.Заголовок = "Перепроверить";
			Элементы.ГруппаПроверкаМЧД.ЦветФона = Новый Цвет(173, 223, 173);  // было 144, 238, 144
			Элементы.ОписаниеСтатусаПроверки.ЦветРамки = Новый Цвет(173, 223, 173);
			Элементы.ОписаниеСтатусаПроверки.ЦветФона = Новый Цвет(173, 223, 173);			
		Иначе
			ОписаниеСтатусаПроверки = СокрЛП(Запись.ТекстСтатусаПроверки) + Формат(Запись.ДатаПроверки, "ДФ=' (на дд.ММ.гггг ЧЧ:мм:сс)'");
			Элементы.КартинкаПроверкаМЧДУспешно.Видимость = Ложь;
			Элементы.КартинкаПроверкаМЧДНеУспешно.Видимость = Истина;
			Элементы.ПроверитьМЧД.Заголовок = "Перепроверить";
			Элементы.ГруппаПроверкаМЧД.ЦветФона = Новый Цвет(249, 237, 167);
			Элементы.ОписаниеСтатусаПроверки.ЦветРамки = Новый Цвет(249, 237, 167);
			Элементы.ОписаниеСтатусаПроверки.ЦветФона = Новый Цвет(249, 237, 167);			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.ОшибкиПроверки) Тогда
			Элементы.ГруппаОшибкиПроверкиМЧД.Видимость = Истина;
			ОшибкиПроверки = КонтурЛогистика_МашиночитаемыеДовернностиСервер.ПредставлениеОшибокПроверкиМЧД(Запись.ОшибкиПроверки);
			Элементы.РешениеОшибки.Видимость = ОшибкаРегистрации;
		Иначе
			Элементы.ГруппаОшибкиПроверкиМЧД.Видимость = Ложь;
			Элементы.ОписаниеСтатусаПроверки.МногострочныйРежим = Ложь;
		КонецЕсли;
		
	Иначе
		
		Элементы.ГруппаПроверкаМЧД.Видимость = Ложь;
				
	КонецЕсли;
	
	 Элементы.ФормаОткрытьПротоколВалидации.Видимость = ЗначениеЗаполнено(Запись.ПротоколВалидации) И Не Запись.МЧД.Пустая();
	 
КонецПроцедуры

&НаСервере
Функция РазницаВДнях()
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазницаВДнях(ТекущаяДатаСеанса(), Запись.ДатаПроверки);
	
КонецФункции

&НаКлиенте
Процедура МЧД1ПриИзменении(Элемент)
	
	ОчиститьРеквизитыПроверкиМЧД();
	
	ОтобразитьГруппуПроверкиМЧД();
	
	ВалидацияМЧД();
	УправлениеОтображениемВалидацииМЧД();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыПроверкиМЧД()

	Запись.ДатаПроверки = "";
	Запись.СтатусПроверки = "";
	Запись.ТекстСтатусаПроверки = "";
	Запись.ОшибкиПроверки = "";	

КонецПроцедуры

&НаКлиенте
Процедура МЧД1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
			
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Запись.ОрганизацияДиадок) Тогда
		Сообщить("Не выбрана Организация (Диадок)");
		Возврат;
	КонецЕсли;
	
	НастройкиКД = Новый НастройкиКомпоновкиДанных;
	
	СписокОрганизацийДД = СписокОрганизацийДляОтбора(Запись.ОрганизацияДиадок);
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИсходныйДоверитель");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
    ОтборСписка.ПравоеЗначение = СписокОрганизацийДД;
    ОтборСписка.Использование = Истина;
	
    ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаОкончания");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
    ОтборСписка.ПравоеЗначение = ТекущаяДата();
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ОтборСписка.ПравоеЗначение = Ложь;
    ОтборСписка.Использование = Истина;
	
	ОтборСписка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ОтборСписка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наша");
    ОтборСписка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ОтборСписка.ПравоеЗначение = Истина;
    ОтборСписка.Использование = Истина;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ФиксированныеНастройки", НастройкиКД);

	ОткрытьФорму("Справочник.КонтурЛогистика_МЧД.ФормаВыбора", ПараметрыВыбора, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция СписокОрганизацийДляОтбора(ОрганизацияДиадок)
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.СписокОрганизацийПоИНН(ОрганизацияДиадок.ИНН);	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КонтурЛогистика_МЧД") Тогда
	
		Запись.МЧД = ВыбранноеЗначение;
		
		ОчиститьРеквизитыПроверкиМЧД(); 	
		ОтобразитьГруппуПроверкиМЧД();
		ВалидацияМЧД();
		УправлениеОтображениемВалидацииМЧД();
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КонтурЛогистика_СертификатыЭлектроннойПодписи") Тогда
		
		Запись.Сертификат = ВыбранноеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияДиадокПриИзменении(Элемент)
	
	Запись.МЧД = "";
	Запись.ПротоколВалидации = "";
	
	ОчиститьРеквизитыПроверкиМЧД();	
	ОтобразитьГруппуПроверкиМЧД();
	
	ВалидацияМЧД();	
	УправлениеЭлементамиФормы(ЭтаФорма);
	
	ПроверитьАвторизациюПоOIDC();
	
КонецПроцедуры

&НаКлиенте
Процедура СпосПодтПолном1ПриИзменении(Элемент)
	УправлениеЭлементамиФормы(ЭтаФорма)
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкиВалидации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Текст", ОшибкиВалидации);
			
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ФормаТекстовогоСообщения",
		ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПротоколВалидации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОрганизацияДиадок", Запись.ОрганизацияДиадок);
	ПараметрыФормы.Вставить("Сертификат", Запись.Сертификат);
	ПараметрыФормы.Вставить("МЧД", Запись.МЧД);
	ПараметрыФормы.Вставить("ПротоколВалидации", Запись.ПротоколВалидации);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_НастройкиПодписания.Форма.ФормаПротоколаВалидации", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область АвторизацияПоOIDC

&НаКлиенте
Процедура ПроверитьАвторизациюПоOIDC()

	АвторизацияВыполнена = Ложь;
	Если ЗначениеЗаполнено(Запись.ОрганизацияДиадок) И АвторизацияПоOIDC Тогда
		ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(Запись.ОрганизацияДиадок);
		Если ЗначениеЗаполнено(ДанныеАутентификации.ТокенДоступа) Тогда	
			АвторизацияВыполнена = Истина;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеАутентификации(Результат, ДополнительныеПараметры) Экспорт
	
	ПроверитьАвторизациюПоOIDC();
	
	Если АвторизацияВыполнена Тогда
		ВыполнитьПроверкуМЧД();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
