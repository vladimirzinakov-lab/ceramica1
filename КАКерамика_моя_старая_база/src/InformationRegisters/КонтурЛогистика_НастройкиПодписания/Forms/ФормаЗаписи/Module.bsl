
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьКриптографию1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьКриптографию1С");
	ЭтоНовый = Не ЗначениеЗаполнено(Запись.ИсходныйКлючЗаписи.Период);
	
	Если Параметры.Свойство("Сертификат") Тогда
		
		Запись.Сертификат = Параметры.Сертификат;
		
	КонецЕсли;
	
	Если Параметры.Свойство("ОрганизацияДиадок") Тогда
		
		Запись.ОрганизацияДиадок = Параметры.ОрганизацияДиадок;
		
	КонецЕсли;
	
	Параметры.Свойство("УказатьДатуБумажнойДоверенности", УказатьДатуБумажнойДоверенности);
	
	ИспользоватьСертификат = ЗначениеЗаполнено(Запись.Сертификат) Или ЭтоНовый;
	
	Если ЭтоНовый Тогда
		
		Запись.Период = НачалоДня(Запись.Период);
		
		Если Не ЗначениеЗаполнено(Запись.ОрганизацияДиадок) Тогда
			Запись.ОрганизацияДиадок = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОднаНашаОрганизация();
		КонецЕсли;
		
		Запись.ИдентификаторНастройки = Строка(Новый УникальныйИдентификатор());
		
	КонецЕсли;
	
	Элементы.ГруппаИспользоватьСертификат.Видимость = Не ИспользоватьСертификат;
	Элементы.ГруппаДопСведения.Видимость = Не Запись.ДопСведенияОПодписанте = "";
	
	Если Не ЗначениеЗаполнено(Запись.ОбщийСпособПодтвержденияПолномочий) Тогда
		Запись.ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.МЧД;
	КонецЕсли;
	
	ТекПользовательАдминистратор 	= КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор();
	ТекПользовательМожетВНастройки  = РольДоступна("КонтурЛогистика_НастройкаПодписания");
	
	Если Не ТекПользовательАдминистратор И Не ТекПользовательМожетВНастройки Тогда
		
		Элементы.Пользователь1С.Доступность 		= Ложь;
		Элементы.ГруппаПараметрПодписания.Видимость = Ложь;
		Элементы.ФормаСкопировать.Видимость 		= Ложь;
		Элементы.ФормаУдалить.Видимость 			= Ложь;
		
		Элементы.ФормаОтобразитьГруппуИспользоватьСертификат.Видимость 	= Ложь;
		Элементы.ФормаОтобразитьГруппуДопСведения.Видимость 			= Ложь;
		
		ТекущийПользователь1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
				
		Если ЭтоНовый Тогда
			
			Запись.Пользователь1С = ТекущийПользователь1С;
			
		ИначеЕсли Не Запись.Пользователь1С = ТекущийПользователь1С
			Или Не ЗначениеЗаполнено(Запись.Пользователь1С) Тогда
			
			ЭтаФорма.ТолькоПросмотр 					= Истина;
			КоманднаяПанель.Видимость 					= Ложь;
			Элементы.ГруппаДоступЗапрещен.Видимость 	= Истина;
			
		КонецЕсли;
				
	КонецЕсли;
	
	Если Не ТекПользовательАдминистратор И ТекПользовательМожетВНастройки Тогда
			
		Элементы.ФормаУдалить.Видимость = Ложь;
		
	КонецЕсли;
	
	РежимАвторизации  = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	АвторизацияПоOIDC = (РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow);
		
	ВалидацияМЧД();
				
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// чтобы снять фокус с баннера
	Элементы.КартинкаЗаглушка.Видимость = Ложь;
	ТекущийЭлемент = Элементы.КартинкаЗаглушка;
	
	Если УказатьДатуБумажнойДоверенности Тогда		
		ТекущийЭлемент = Элементы.СвДоверБум_ДатаДовер;		
	КонецЕсли;
	
	ПроверитьАвторизациюПоOIDC();
		
	УправлениеЭлементамиФормы(ЭтаФорма); 
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("КонтурЛогистика_ПерепроверитьДокумент");
	Оповестить("КонтурЛогистика_ОбновитьФормуПроверкиСертификатов");
	Оповестить("КонтурЛогистика_ОбновитьНастройкиПодписанияВСтартовомПомощнике");
	
	Переменные = ПеременныеМетрикаНастройкиПодписания(Запись);	
	КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(Переменные, "Настройки подписания", "Записать настройку подписания",
		"РегистрСведений.КонтурЛогистика_НастройкиПодписания.Форма.ФормаЗаписи");
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПеременныеМетрикаНастройкиПодписания(Знач Запись)
	
	Возврат РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ПеременныеМетрикаНастройкиПодписания(Запись);
	
КонецФункции

&НаКлиенте
Процедура ВыбратьСертификат(Команда)
	
	 КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		 "ОбщаяФорма.КонтурЛогистика_ВыборСертификата",
		 ,
		 ЭтаФорма,
		 ЭтаФорма,
		 "ОбработчикВыборСертификата");
	 
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыборСертификата(ДанныеСертификата, ДопПараметры = Неопределено) Экспорт

	Если ДанныеСертификата <> Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗаполнитьСертификатДанными(Запись, ДанныеСертификата);
		
		// определяем тип модуля криптографии
		#Если ВебКлиент Тогда
		
			ЗаполнитьТипПрограммыЭППоУмолчанию();
			
			Элементы.ПредупреждениеГруппа.Видимость = Истина;
			Элементы.Предупреждение.Заголовок = "После выбора сертификата рекомендуется выполнить проверку сертификата";
			
		#КонецЕсли
		
	КонецЕсли;
	
	УправлениеЭлементамиФормы(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура УбратьАвторизацию() Экспорт	
			
	Элементы.ПроверитьАвторизацию.Видимость = Ложь;	
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УсловноеОформлениеПредставленияПЗК(Форма)
	
	Если Форма.Запись.ВводитьПарольВПрограммеЭлектроннойПодписи Тогда		
		Форма.Запись.ПЗК = "";
		Форма.Элементы.ПредставлениеПЗК.Доступность = Ложь;				
	Иначе		
		Форма.Элементы.ПредставлениеПЗК.Доступность = Истина;		
	КонецЕсли;
	
	Форма.ПредставлениеПЗК = ?(ЗначениеЗаполнено(Форма.Запись.ПЗК), "Изменить", "Ввести");
	
	#Если ВебКлиент Тогда
		Форма.Элементы.ПредставлениеПЗК.Видимость = ЗначениеЗаполнено(Форма.Запись.ОтпечатокСертификата);	
	#Иначе
		Форма.Элементы.ПредставлениеПЗК.Видимость = Форма.ИспользоватьКриптографию1С И ЗначениеЗаполнено(Форма.Запись.ОтпечатокСертификата);
	#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПЗКНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ДанныеСертификата", КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОписаниеДанныхСертификата());
	ЗаполнитьЗначенияСвойств(ПараметрыФормы.ДанныеСертификата, Запись);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		 "ОбщаяФорма.КонтурЛогистика_ВводПЗК",
		 ПараметрыФормы,
		 ЭтаФорма,
		 ЭтаФорма,
		 "ОбработчикВводаПЗК");
	
КонецПроцедуры

&НаКлиенте
Процедура ПопытатьсяАвторизоваться()
	
	Если Не ИспользоватьКриптографию1С Тогда 
					
		ПЗК = ?(ЗначениеЗаполнено(Запись.ПЗК), Запись.ПЗК, Неопределено);
		
		Попытка
			
			Если Не Запись.СертификатНаСервере Тогда 	
				Авторизация_ПоСертификату(Запись.ОтпечатокСертификата, ПЗК);			
			Иначе				
				Авторизация_ПоСертификатуНаСервере(Запись.ОтпечатокСертификата, ПЗК);		
			КонецЕсли;
			
		Исключение
			
			ДобавитьОшибкуАвторизации(Запись.ОтпечатокСертификата, ИнформацияОбОшибке()); 
			
			ОбработкаОшибокАвторизацииПоСертификатам();
			
		КонецПопытки;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВводаПЗК(Результат, ДопПараметры = Неопределено) Экспорт 
	
	Если Результат = Неопределено Тогда
		Сообщить("Пароль закрытого ключа сертификата не изменен");
		Возврат
	КонецЕсли;
	
	Запись.ПЗК = Результат;
	
	#Если Не Вебклиент Тогда
		ПопытатьсяАвторизоваться();
	#КонецЕсли	
	
	УсловноеОформлениеПредставленияПЗК(ЭтаФорма);
	
	Модифицированность = Истина;
	
КонецПроцедуры	

&НаКлиенте
Функция ДанныеСертификата(ДанныеТекущейСтроки)

	ДанныеСертификата = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ОписаниеДанныхСертификата();
	ЗаполнитьЗначенияСвойств(ДанныеСертификата, ДанныеТекущейСтроки);
	
	Возврат ДанныеСертификата;

КонецФункции

&НаКлиенте
Функция Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК)
	
	Возврат Модуль_ЯдроНаКлиенте().Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК);
		
КонецФункции

&НаСервереБезКонтекста
Функция Авторизация_ПоСертификатуНаСервере(ОтпечатокСертификата, ПЗК)
		
	Возврат Модуль_ЯдроНаСервере().Авторизация_ПоСертификату(ОтпечатокСертификата, ПЗК);
	
КонецФункции

&НаКлиенте
Функция Модуль_ЯдроНаКлиенте()

	Возврат КонтурЛогистика_ИнтеграцияДиадокКлиентПовтИсп.ЯдроНаКлиенте();	

КонецФункции

&НаСервереБезКонтекста
Функция Модуль_ЯдроНаСервере()

	Возврат КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро();	

КонецФункции 

&НаКлиенте
Процедура ДобавитьОшибкуАвторизации(ОтпечатокСертификата ,ИнформацияОбОшибке)
	
	ОшибкаАвторизации = Новый Структура;
		
	ОшибкаАвторизации.Вставить("ОтпечатокСертификата", "ОтпечатокСертификата");
	ОшибкаАвторизации.Вставить("ИнформацияОбОшибке", ИнформацияОбОшибке);

КонецПроцедуры

//Обрабатывает ошибки возникающие при авторизации по сертификату, выводит сообщение пользователю что авторизация не прошла
//
// Параметры:
//  ОшибкиАвторизации - Массив структур описывающих ошибки подключения
//   *ОтпечатокСертификата			 - Строка				 - отпечаток сертификата
//   *ИнформацияОбОшибке			 - ИнформацияОбОшибке	 - ИнформацияОбОшибке()
//
&НаКлиенте
Процедура ОбработкаОшибокАвторизацииПоСертификатам()
	
	Если ТипЗнч(ОшибкаАвторизации) = Тип("Структура") И ОшибкаАвторизации.Количество() > 0 Тогда
			
		ИдентификаторОшибки = "";
		
		Если ТипЗнч(ОшибкаАвторизации.ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда 
		
			ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ОшибкаАвторизации.ИнформацияОбОшибке);
			
			Если Найти(ПодробноеПредставлениеОшибки, "401") И Найти(ПодробноеПредставлениеОшибки, "is not authorized") Тогда
				ИдентификаторОшибки = "Сертификат не имеет доступа в Диадок";
			ИначеЕсли Найти(ПодробноеПредставлениеОшибки, "0x80090022") Тогда 	
				ИдентификаторОшибки = "Provider could not perform the action since the context was acquired as silent.";
			Иначе
				
				Если ОшибкаАвторизации.ИнформацияОбОшибке.Причина = Неопределено Тогда
					ОписаниеОшибки = ОшибкаАвторизации.ИнформацияОбОшибке.Описание;
				Иначе
					ОписаниеОшибки = ОшибкаАвторизации.ИнформацияОбОшибке.Причина.Описание;
				КонецЕсли;
				
				ИдентификаторОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
					"Не удалось авторизоваться по сертификату:
					|%1" + Символы.ПС,
					ОписаниеОшибки);
				
			КонецЕсли;
		
		Иначе
			
			ИдентификаторОшибки = ОшибкаАвторизации.ИнформацияОбОшибке;
			
		КонецЕсли;
				
		ШаблонОшибки = "%1
						|Попробуйте авторизироватьсся в веб-версии
						|или обратитесь в техподдержку";
	
		ТекстОшибки = КонтурЛогистика_ИнтеграцияДиадокКлиентПовтИсп.ЯдроНаКлиенте().Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки, ИдентификаторОшибки);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстОшибки);
		
	КонецЕсли;
	
	ОшибкаАвторизации = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЗначениеЗаполнено(Запись.Сертификат) И ИспользоватьСертификат Тогда 
		Сообщить("Укажите Сертификат");
		Отказ = Истина;
	ИначеЕсли Не ИспользоватьСертификат Тогда
		
		Если Не ЗначениеЗаполнено(Запись.Фамилия) Тогда
			Сообщить("Укажите Фамилия");
			Отказ = Истина;	
		КонецЕсли;		
		Если Не ЗначениеЗаполнено(Запись.Имя) Тогда
			Сообщить("Укажите Имя");
			Отказ = Истина;	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Запись.Должность) Тогда
			Сообщить("Укажите Должность");
			Отказ = Истина;	
		КонецЕсли;
				
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ОбщийСпособПодтвержденияПолномочий) Тогда 
		Сообщить("Укажите способ подтверждения полномочий");
		Отказ = Истина;
	КонецЕсли;	
		
	Если Не ЗначениеЗаполнено(Запись.МЧД) Тогда
		Запись.ПротоколВалидации = "";
	КонецЕсли;
	
	Если ИспользоватьСертификат 
		И ЗначениеЗаполнено(Запись.Сертификат)
		И Не Запись.ИсключениеДляОтдельныхДокументов
		И Запись.ОбщийСпособПодтвержденияПолномочий = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.МЧД")
		И Не ЗначениеЗаполнено(Запись.МЧД) Тогда
		Сообщить("Укажите МЧД");
		Отказ = Истина;	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиФормы(Форма)
	
	Элементы.ГруппаНетСертификата.Видимость = Не ИспользоватьСертификат;
	Элементы.ГруппаСертификат.Видимость = ИспользоватьСертификат;
	
	Элементы.ГруппаМЧД.Видимость = ИспользоватьСертификат
		И Запись.ОбщийСпособПодтвержденияПолномочий = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.МЧД");	
	
	Элементы.ГруппаБумажнаяДоверенность.Видимость = Запись.ОбщийСпособПодтвержденияПолномочий = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.БумажнаяДоверенность");
	
	УправлениеПодсказкойПериода();
	
	ОтобразитьГруппуПроверкиМЧД();
	
	УправлениеОтображениемВалидацииМЧД();
			
КонецПроцедуры

&НаКлиенте
Процедура УправлениеПодсказкойПериода()
	
	Если Запись.Период <> НачалоДня(Запись.Период) И Запись.Период > НачалоДня(ТекущаяДата()) Тогда
		Элементы.ПериодВремя.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСправа;
		Элементы.ПериодВремя.Подсказка = "Настройка начнет действовать с " + Формат(Запись.Период + 60 * 60 * 24, "ДФ='dd.MM.yyyy'");
	Иначе
		Элементы.ПериодВремя.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
		Элементы.ПериодВремя.Подсказка = "Можно настроить настроить начало использования сертификатов в будущем";
	КонецЕсли;

КонецПроцедуры

