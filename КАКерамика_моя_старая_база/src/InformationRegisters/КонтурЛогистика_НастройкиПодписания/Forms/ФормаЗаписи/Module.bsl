#КонецОбласти

&НаСервере
Процедура ВалидацияМЧД()

	ТекстВалидации = "";
	ОшибкиВалидации = "";
	Запись.СертификатБезМЧД = Ложь;
	
	Если ЗначениеЗаполнено(Запись.Сертификат)
		И ЗначениеЗаполнено(Запись.ОрганизацияДиадок)
		И Не ЗначениеЗаполнено(Запись.МЧД)
		И Не Запись.ИсключениеДляОтдельныхДокументов
		И Не Запись.ОбщийСпособПодтвержденияПолномочий = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.БумажнаяДоверенность") Тогда		
				
		ТекстВалидации = "Без МЧД подпись юридически не значима. Выберите МЧД";
		ОшибкиВалидации = "";
		
		СертификатВыдан = Справочники.КонтурЛогистика_СертификатыЭлектроннойПодписи.ТипВладельцаСертификата(Запись.Сертификат);
		
		Если Запись.ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо И СертификатВыдан = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо Тогда
			
			ОшибкиВалидации = "Для организации с типом юридическое лицо выбран сертификат физического лица";
						
		ИначеЕсли Запись.ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо Тогда
			
			Если ЗначениеЗаполнено(Запись.ОрганизацияДиадок.ИНН) И ЗначениеЗаполнено(Запись.Сертификат.ИННЮЛ) 
				И Запись.ОрганизацияДиадок.ИНН <> Запись.Сертификат.ИННЮЛ Тогда
				
				ОшибкиВалидации = "ИНН организации не совпадает с ИНН сертификата";				
				
			КонецЕсли;
			
		ИначеЕсли Запись.ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП Тогда
			
			Если ЗначениеЗаполнено(Запись.ОрганизацияДиадок.ОГРН) И ЗначениеЗаполнено(Запись.Сертификат.ОГРНИП) 
				И Запись.ОрганизацияДиадок.ОГРН <> Запись.Сертификат.ОГРНИП Тогда
				
				ОшибкиВалидации = "ОГРНИП организации не совпадает с ОГРНИП сертификата";
				
			ИначеЕсли ЗначениеЗаполнено(Запись.ОрганизацияДиадок.СНИЛС) И ЗначениеЗаполнено(Запись.Сертификат.СНИЛС) 
				И Не СНИЛССовпадает(Запись.ОрганизацияДиадок.СНИЛС, Запись.Сертификат.СНИЛС) Тогда
				
				ОшибкиВалидации = "СНИЛС организации не совпадает с СНИЛС сертификата";
				
			ИначеЕсли Запись.ОрганизацияДиадок.Фамилия <> Запись.Сертификат.Фамилия 
				И Запись.ОрганизацияДиадок.Имя <> Запись.Сертификат.Фамилия
				И Запись.ОрганизацияДиадок.Отчество <> Запись.Сертификат.Фамилия Тогда
				
				ОшибкиВалидации = "ФИО физического лица не совпадает с ФИО сертификата";
				
			КонецЕсли;
		
		ИначеЕсли Запись.ОрганизацияДиадок.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ФизЛицо Тогда
			
			Если ЗначениеЗаполнено(Запись.ОрганизацияДиадок.СНИЛС) И ЗначениеЗаполнено(Запись.Сертификат.СНИЛС) 
				И Не СНИЛССовпадает(Запись.ОрганизацияДиадок.СНИЛС, Запись.Сертификат.СНИЛС) Тогда
				
				ОшибкиВалидации = "СНИЛС организации не совпадает с СНИЛС сертификата";
				
			ИначеЕсли Запись.ОрганизацияДиадок.Фамилия <> Запись.Сертификат.Фамилия 
				И Запись.ОрганизацияДиадок.Имя <> Запись.Сертификат.Фамилия
				И Запись.ОрганизацияДиадок.Отчество <> Запись.Сертификат.Фамилия Тогда
				
				ОшибкиВалидации = "ФИО физического лица не совпадает с ФИО сертификата";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОшибкиВалидации) Тогда
		Запись.СертификатБезМЧД = Истина;
	КонецЕсли;
					
КонецПроцедуры

&НаСервере
Функция СНИЛССовпадает(СНИЛС1, СНИЛС2)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаИзЧисел(СНИЛС1)
		= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаИзЧисел(СНИЛС2);
	
КонецФункции

&НаКлиенте
Процедура УправлениеОтображениемВалидацииМЧД()
	
	Элементы.ГруппаВалидацияМЧД.Видимость = ЗначениеЗаполнено(ОшибкиВалидации); 
	Элементы.ПоказатьОшибкиВалидации.Видимость = ЗначениеЗаполнено(ОшибкиВалидации);
	
	Элементы.ТекстВалидация.Заголовок = ТекстВалидации;
					
КонецПроцедуры

#Область ПроверкаСертификата

&НаКлиенте
Процедура ЗаполнитьСписокТиповМодуляКриптографииДляВыбора()
	
	ТипыМодуляКриптографииДляВыбора = Новый Массив;
	ТипыМодуляКриптографии = КонтурЛогистика_КриптографияКлиентПовтИсп.ПолучитьТипыМодуляКриптографии();
	Для каждого ТипМодуля Из ТипыМодуляКриптографии Цикл
		Элементы.ТипПрограммыЭП.СписокВыбора.Добавить(ТипМодуля.ИмяМодуляКриптографии, );	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТипПрограммыЭППриОткрытии()
	
	ТипыМодуляКриптографии = КонтурЛогистика_КриптографияКлиентПовтИсп.ПолучитьТипыМодуляКриптографии();
	Для каждого ТипМодуля Из ТипыМодуляКриптографии Цикл
		
		Если ТипМодуля.ТипМодуляКриптографии = Запись.ТипМодуляКриптографии 
			И ТипМодуля.ИмяМодуляКриптографии = Запись.ИмяМодуляКриптографии Тогда
			
			ТипПрограммыЭП = ТипМодуля.ИмяМодуляКриптографии;			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПрограммыЭПОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТипыМодуляКриптографии = КонтурЛогистика_КриптографияКлиентПовтИсп.ПолучитьТипыМодуляКриптографии();
	Для каждого ТипМодуля Из ТипыМодуляКриптографии Цикл
		
		Если ТипМодуля.ИмяМодуляКриптографии = ВыбранноеЗначение Тогда
			
			Запись.ТипМодуляКриптографии = ТипМодуля.ТипМодуляКриптографии;
			Запись.ИмяМодуляКриптографии = ТипМодуля.ИмяМодуляКриптографии;
			
			Элементы.ПредупреждениеГруппа.Видимость = Истина;
			Элементы.Предупреждение.Заголовок = "После выбора сертификата рекомендуется выполнить проверку сертификата";
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТипПрограммыЭППоУмолчанию()
	
	Если Запись.ТипМодуляКриптографии = 0 И ПустаяСтрока(Запись.ИмяМодуляКриптографии) Тогда
		
		ТипПрограммыЭППоУмолчанию = КонтурЛогистика_КриптографияКлиентПовтИсп.ПолучитьТипыМодуляКриптографии()[0];
		ТипПрограммыЭП = ТипПрограммыЭППоУмолчанию.ИмяМодуляКриптографии;
		Запись.ТипМодуляКриптографии = ТипПрограммыЭППоУмолчанию.ТипМодуляКриптографии;
		Запись.ИмяМодуляКриптографии = ТипПрограммыЭППоУмолчанию.ИмяМодуляКриптографии;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСертификат(Команда)
	
	Если ПустаяСтрока(ТипПрограммыЭП) Тогда
		Сообщить("Тип программы ЭП не выбран!");
		Возврат;
	КонецЕсли;
	
	Если Запись.СертификатНаСервере Тогда
		
		Попытка
			
			ПроверитьСертификатНаСервере();
			
			Оповещение = Новый ОписаниеОповещения("ПоказатьПредупреждениеЗавершение", ЭтаФорма);
			ПоказатьПредупреждение(Оповещение, "Проверка пройдена успешно!");
			
			ПроверкаПройдена = Истина;
			ТекстПредупреждения = "Проверка пройдена";
			
			УправлениеЭлементамиФормы(ЭтаФорма);
			
		Исключение
			
			Оповещение = Новый ОписаниеОповещения("ПоказатьПредупреждениеЗавершение", ЭтаФорма);	
			ВывестиОшибку(Оповещение, ИнформацияОбОшибке());
			
		КонецПопытки
		
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСКриптографиейПодключено", ЭтаФорма);	
		НачатьПодключениеРасширенияРаботыСКриптографией(Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры

&Насервере
Процедура ПроверитьСертификатНаСервере()
		
	МенеджерКриптографии = КонтурЛогистика_КриптографияСервер.ИнициализироватьМенеджерКриптографии(, Запись.ТипМодуляКриптографии);
			
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ИмяФайла = Строка(Новый УникальныйИдентификатор) + ".txt";
	ИмяПромежуточногоФайла = КаталогВременныхФайлов() + "\" + ИмяФайла;
	ТекстовыйДокумент.Записать(ИмяПромежуточногоФайла);
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяПромежуточногоФайла);
				
	КонтурЛогистика_КриптографияСервер.ПодписатьДанные(ДвоичныеДанные, 
															Запись.ОтпечатокСертификата, 
															Запись.ПЗК, 
															Запись.ТипМодуляКриптографии);		
	
КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСКриптографиейПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСКриптографией(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("РасширениеРаботыСФайламиПодключено", ЭтаФорма);	
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура РасширениеРаботыСФайламиПодключено(Подключено, ДополнительныеПараметры) Экспорт
 
	Если НЕ Подключено Тогда
	 
		НачатьУстановкуРасширенияРаботыСФайлами(Неопределено);
		Возврат;
		  
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипМодуля", Запись.ТипМодуляКриптографии);
	ДополнительныеПараметры.Вставить("ИмяМодуля", Запись.ИмяМодуляКриптографии);
	
	Оповещение = Новый ОписаниеОповещения("НачатьИнициализациюМенеджераКриптографииЗавершение", ЭтаФорма, ДополнительныеПараметры,
											"НачатьИнициализациюМенеджераКриптографииОшибка", ЭтаФорма);	
	КонтурЛогистика_КриптографияКлиент.НачатьИнициализациюМенеджераКриптографии(Оповещение, 
																				Запись.ТипМодуляКриптографии, 
																				Запись.ИмяМодуляКриптографии, 
																				Запись.ВводитьПарольВПрограммеЭлектроннойПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьИнициализациюМенеджераКриптографииЗавершение(МенеджерКриптографии, ДополнительныеПараметры) Экспорт
	
	ПолучениеКаталогаВременныхФайлов(ДополнительныеПараметры);	
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьИнициализациюМенеджераКриптографииОшибка(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ПоказатьПредупреждениеЗавершение", ЭтаФорма);
