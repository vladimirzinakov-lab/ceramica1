Процедура ОбработчикОбновитьПереинициализироватьФорму(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	ОбработатьНовыйТипДокументаЛогистикаСервер();
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда 
		ОбновитьКонтент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОбновитьДинамическийСписок(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	ОбновитьКонтент();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗадачиДинамическийСписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ЛогистическийТип = Неопределено;
	
	Для Каждого СтрокаСписка Из Строки Цикл
		
		Если ЛогистическийТип = Неопределено И ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ДокументЛогистика) Тогда
			ТипДокументаСтрокой = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(
				СтрокаСписка.Значение.Данные.ДокументЛогистика);
			ЛогистическийТип = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЛогистическийТипПоТипуДокумента(ТипДокументаСтрокой);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.Документ1С) Тогда 
			ПредставлениеДокумента1С = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(СтрокаСписка.Значение.Данные.Номер) + " от " + Формат(СтрокаСписка.Значение.Данные.Дата,"ДФ=dd.MM");
			ОфДок1С = СтрокаСписка.Значение.Оформление.Получить("Документ1С");
			Если ЗначениеЗаполнено(ОфДок1С) Тогда
				ОфДок1С.УстановитьЗначениеПараметра("Текст", ПредставлениеДокумента1С);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ДокументЛогистика)
			И НЕ ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ПредыдущийТитул) Тогда
			
			ПредставлениеДокументаЛогистика = ""; 
			ПредставлениеПредыдущегоТитула = ""; 
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаСписка.Значение.Данные.ДокументЛогистика) Тогда
			
			ПредставлениеДокументаЛогистика = "" // может быть ТрН или ЗН или СВ
			+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(СтрокаСписка.Значение.Данные.НомерТрН) 
			+ " от " 
			+ Формат(СтрокаСписка.Значение.Данные.ДатаТрН, "ДФ=dd.MM");
			ПредставлениеПредыдущегоТитула = "";
			
		Иначе
			ПредставлениеПредыдущегоТитула = ""  // может быть ТрН или ЗН или СВ
			+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(СтрокаСписка.Значение.Данные.НомерТрН) 
			+ " от " 
			+ Формат(СтрокаСписка.Значение.Данные.ДатаТрН, "ДФ=dd.MM");
			ПредставлениеДокументаЛогистика = "";
		КонецЕсли;
		
		ОфДокЛогистика = СтрокаСписка.Значение.Оформление.Получить("ДокументЛогистика");
		Если ЗначениеЗаполнено(ОфДокЛогистика) Тогда 
			ОфДокЛогистика.УстановитьЗначениеПараметра("Текст", ПредставлениеДокументаЛогистика);
		КонецЕсли;
		ОфПредыдущийТитул = СтрокаСписка.Значение.Оформление.Получить("ПредыдущийТитул");
		Если ЗначениеЗаполнено(ОфПредыдущийТитул) Тогда 
			ОфПредыдущийТитул.УстановитьЗначениеПараметра("Текст", ПредставлениеПредыдущегоТитула);
		КонецЕсли;
		
		Если ЛогистическийТип = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			Или ЛогистическийТип = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			
			СтрокаСписка.Значение.Данные.ТребуемоеДействие =
				КонтурЛогистика_ОбработкаДокументовСервер.ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(
					СтрокаСписка.Значение.Данные.ТребуемоеДействие, СтрокаСписка.Значение.Данные.ДокументЛогистика);
		КонецЕсли;
						
	КонецЦикла;
	
	// Получим водителей
	ДокументыОбработки = Новый Массив;
	ИмяПоляСДокументом = "";
	ИмяПоляСВодителем = "";
	Для Каждого СтрокаСписка Из Строки Цикл
		
		Если ИмяПоляСДокументом = "" Тогда
			ТипДокумента = ТипЗнч(СтрокаСписка.Значение.Данные.ДокументЛогистика);
			Если (ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
				Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
				Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
				Или ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5"))
				И СтрокаСписка.Значение.Данные.Свойство("ВодительЛогистика") Тогда
				
				ИмяПоляСДокументом = "ДокументЭТРН";
				ИмяПоляСВодителем = "ВодительЛогистика";
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2")
				И СтрокаСписка.Значение.Данные.Свойство("Водитель") Тогда
				
				ИмяПоляСДокументом = "ДокументЛогистика";
				ИмяПоляСВодителем = "Водитель";
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбработки = СтрокаСписка.Значение.Данные[ИмяПоляСДокументом];
		Если ЗначениеЗаполнено(ДокументОбработки) Тогда
			ДокументыОбработки.Добавить(ДокументОбработки);
		КонецЕсли;
		
	КонецЦикла;
	Если ДокументыОбработки.Количество() <> 0 Тогда
		Водители = ВодителиИзДокументовЛогистики(ДокументыОбработки);
		Для Каждого СтрокаСписка Из Строки Цикл
			СтрокаСписка.Значение.Данные[ИмяПоляСВодителем] = Водители.Получить(СтрокаСписка.Значение.Данные[ИмяПоляСДокументом]);
		КонецЦикла;
	КонецЕсли;
	
	#Если Не ТолстыйКлиентОбычноеПриложение И Не ТолстыйКлиентУправляемоеПриложение Тогда
		КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
			"СписокЗадач_ЗадачиДинамическийСписокПриПолученииДанныхНаСервере", Ложь, Строки);
	#Иначе
		ПодключаемыйМодуль = КонтурЛогистика_ПодключаемыйМодульПовтИсп.ПодключаемыйМодуль();
		Если ПодключаемыйМодуль <> Неопределено Тогда
			ПодключаемыйМодуль.ОбработатьСобытиеКонтурЛогистика(
				"СписокЗадач_ЗадачиДинамическийСписокПриПолученииДанныхНаСервере", Ложь, Строки);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВодителиИзДокументовЛогистики(ДокументыОбработки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыОбработки", ДокументыОбработки);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ДокументОбработки,
	|	КонтурЛогистика_ТрН_Титул1.Водитель КАК Водитель
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН В(&ДокументыОбработки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул2Водители.Ссылка,
	|	МАКСИМУМ(КонтурЛогистика_ЗЗ_Титул2Водители.СвВодит)
	|ИЗ
	|	Документ.КонтурЛогистика_ЗЗ_Титул2.Водители КАК КонтурЛогистика_ЗЗ_Титул2Водители
	|ГДЕ
	|	КонтурЛогистика_ЗЗ_Титул2Водители.Ссылка В(&ДокументыОбработки)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ЗЗ_Титул2Водители.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ДокументОбработки, Выборка.Водитель);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗадачиДинамическийСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекКолонка = Поле;
		ИмяКолонки = ТекКолонка.Имя;
		
		Если ИмяКолонки = "ЗадачиДинамическийСписокДокумент1С" Тогда 
			
			Если ЗначениеЗаполнено(ТекущиеДанные.Документ1С) Тогда 
				КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
				ТекущиеДанные.Документ1С,
				ЭтаФорма,
				"ОбработчикОбновитьДинамическийСписок");
			КонецЕсли;
			
		ИначеЕсли ИмяКолонки = "ЗадачиДинамическийСписокСтатус" И ТекущиеДанные.КомментарииВодителя = Истина Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
					ТекущиеДанные.ДокументЭТРН,
					ЭтаФорма,
					"ОбработчикОбновитьДинамическийСписок");
					
		ИначеЕсли ИмяКолонки = "ЗадачиДинамическийСписокСтатус" И ТекущиеДанные.КартинкаПереадресовокЗамен > 0 Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
					ТекущиеДанные.ДокументЭТРН,
					ЭтаФорма,
					"ОбработчикОбновитьДинамическийСписок");			
					
		ИначеЕсли ИмяКолонки = "ЗадачиДинамическийСписокСтатус" 
			И ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена") Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ОтборГлавныйДокумент", ТекущиеДанные.ДокументЭТРН);
			ПараметрыФормы.Вставить("ОтборСостояние", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Все"));
	
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_ФайлыОбмена.ФормаСписка",
						ПараметрыФормы, ЭтаФорма, ЭтаФорма);
					
		ИначеЕсли ИмяКолонки = "ЗадачиДинамическийСписокДокументЛогистика" Тогда 
			
			ПоказываемТитул = Неопределено;
			
			Если ЗначениеЗаполнено(ТекущиеДанные.ДокументЛогистика) Тогда 
				ПоказываемТитул = ТекущиеДанные.ДокументЛогистика;
			ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ПредыдущийТитул) Тогда
				ПоказываемТитул = ТекущиеДанные.ПредыдущийТитул;
			ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДокументЭТРН) Тогда
				ПоказываемТитул = ТекущиеДанные.ДокументЭТРН;
			КонецЕсли;
		
			Если ЗначениеЗаполнено(ПоказываемТитул) Тогда
				КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
					ПоказываемТитул,
					ЭтаФорма,
					"ОбработчикОбновитьДинамическийСписок");
			КонецЕсли;
			
		ИначеЕсли ИмяКолонки = "ЗадачиДинамическийСписокТребуемоеДействие"
			И ТекущиеДанные.Свойство("ОсобенностиДокументооборота")
			И ЗначениеЗаполнено(ТекущиеДанные.ОсобенностиДокументооборота)
			И Не ТекущиеДанные.ОсобенностиДокументооборота = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыОсобенностейДокументооборота.Шаблон") Тогда
			
			ВыполнитьОбработкуОсобенностиДокументооборота(ТекущиеДанные);
			
		ИначеЕсли ИмяКолонки = "ЗадачиДинамическийСписокДокументЭТРН" Тогда 
			
			Если ЗначениеЗаполнено(ТекущиеДанные.ДокументЭТРН) Тогда
				ПоказываемТитул = ТекущиеДанные.ДокументЭТРН;
			КонецЕсли;
		
			Если ЗначениеЗаполнено(ПоказываемТитул) Тогда
				КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
					ПоказываемТитул,
					ЭтаФорма,
					"ОбработчикОбновитьДинамическийСписок");
			КонецЕсли;	
			
		Иначе
			
			ВыполнитьТребуемоеДействие(ТекущиеДанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиДинамическийСписокПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ИсторияСостоянийДокумента.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Попытка
		ВидимостьИстории = (ЗначениеЗаполнено(Элемент.ТекущиеДанные.ГлавныйДокумент));
	Исключение
		ВидимостьИстории = Ложь;
	КонецПопытки;
	
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ИсторияСостоянийДокумента.Видимость = ВидимостьИстории;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТребуемоеДействие(ТекущиеДанные)

	Документ 				= ТекущиеДанные.Документ1С;
	ДокументЛогистика 		= ТекущиеДанные.ДокументЛогистика;
	ПредыдущийТитул 		= ТекущиеДанные.ПредыдущийТитул;
	ТребуемоеДействие 		= ТекущиеДанные.ТребуемоеДействие;
	
	ДопПараметрыДействия = Новый Структура;
	
	// Требуемое действие может смениться в любую миллисекунду
	Если ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Оформить") Тогда
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02") Тогда 
			ДопПараметрыДействия.Вставить("Водитель", ТекущиеДанные.Водитель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Документ) Тогда 
			КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаПоДокументу1С(
				ТипЛогистика, Документ, ЭтаФорма);
		Иначе
			
			Если ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен") Тогда
				КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
					ТекущиеДанные.ДокументЛогистика, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок");
			Иначе
				КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаИзПредыдущегоТитула(
					ТипЛогистика, ПредыдущийТитул, ЭтаФорма, ДопПараметрыДействия);
			КонецЕсли;	
		КонецЕсли;
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВОчередиОтправки")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Переотправить") Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			ТекущиеДанные.ДокументЛогистика, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок");
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Отправляется")
		ИЛИ ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОбрабатываетсяСервером") Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОтборСвязанныйДокумент", ТекущиеДанные.ДокументЛогистика);
		ПараметрыФормы.Вставить("ОтборСостояние", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Все"));
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ФайлыОбмена.ФормаСписка", ПараметрыФормы, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок");
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПровестиДокумент") Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			Документ, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок");
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Распечатать") Тогда
		
		МассивДокументовЛогистика = Новый Массив;
		МассивДокументовЛогистика.Добавить(ТекущиеДанные.ДокументЛогистика);
		
		КонтурЛогистика_ПечатьКлиент.РаспечататьТрН(МассивДокументовЛогистика);
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен") Тогда
		
		ВыполнитьОбменФормаЗадач();
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника")
		ИЛИ ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ДождатьсяПрибытия")
		ИЛИ ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВОчередиОтправки")
		ИЛИ ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОбработанСПредупреждением") Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
			ТекущиеДанные.ДокументЛогистика, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок");
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника") Тогда
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1") Тогда
			
			ПараметрыФормы = Новый Структура("Ключ, ПроверкаОтвета", НайтиТитул(ДокументЛогистика, ТипЛогистика), Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ЗЗ_Титул2.Форма.ФормаДокумента",
				ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда
			
			ПараметрыФормы = Новый Структура("Ключ, ПроверкаОтвета", ДокументЛогистика, Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.Форма.ФормаДокумента",
				ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка") Тогда
			
			ПараметрыФормы = Новый Структура("Ключ, ПроверкаОтвета", ДокументЛогистика, Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_СкладскаяРасписка.Форма.ФормаДокумента",
				ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2") Тогда
			
			ПараметрыФормы = Новый Структура("Ключ, ПроверкаОтвета", ДокументЛогистика, Истина);
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ПЭ_Титул2.Форма.ФормаДокумента",
				ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВвестиНаОсновании") Тогда 
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1") Тогда 
			
			ПараметрыФормы = Новый Структура("Основание", ДокументЛогистика);
			
			СуществующаяЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрНпоЗаказЗаявке(ДокументЛогистика);
			Если ЗначениеЗаполнено(СуществующаяЭТРН) Тогда 
				КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(СуществующаяЭТРН, ЭтаФорма);
			Иначе
				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
					"Документ.КонтурЛогистика_ТрН_Титул1.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2") Тогда
			
			// нет потребности, вводится из списка ЗЗт1
			
		КонецЕсли;
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Обработать")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание")
		Или ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю") Тогда
		
		ПараметрыФормы = Новый Структура("Ключ", ДокументЛогистика);
		
		ИмяОткрываемойФормы = "Документ." + КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика)
			+ ".ФормаОбъекта";
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			ИмяОткрываемойФормы, ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьДинамическийСписок");
		
	ИначеЕсли ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоСотрудника") Тогда
		
		Сообщить("У вас нет прав на выполнение требуемого действия. Ожидаем другого сотрудника.");
		
	Иначе
		
		// ОжиданиеДругогоУчастника - TODO решить что с ним делать
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не реализована обработка требуемого действия такого типа (" + ТребуемоеДействие + ") ";
		Сообщение.Поле = "ЗадачиДинамическийСписокТребуемоеДействие";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработкуОсобенностиДокументооборота(ТекущиеДанные)
	
	Если ТекущиеДанные.ОсобенностиДокументооборота = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_ТипыОсобенностейДокументооборота.ОбработатьИсправлениеТитула1") Тогда
		
		ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2");
		ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1"),
			ТекущиеДанные.ДокументЭТРН);
		ДопПараметрыДействия = Новый Структура;
		
		КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиДокументЛогистикаИзПредыдущегоТитула(
			ТипЛогистика, ПредыдущийТитул, ЭтаФорма, ДопПараметрыДействия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВыполнениеОбменаВФоне()
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МенеджерФоновыхЗаданийДоступен() Тогда
		
		КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеВыполнениеСотслеживаниемВНовойФорме(
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьОбмен",
			"Выполнение обмена",
			Новый Структура,
			"Выполнение обмена",
			Истина);
		
	Иначе
		КонтурЛогистика_API_Диадок.ОбработатьВсеЛентыСобытий()
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОповеститьОВыполненииКоманды(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт 

	Элементы.ЗадачиДинамическийСписок.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ОбновитьКонтент();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ВвестиДокумент" 
		ИЛИ ИмяСобытия = "КонтурЛогистика_ЗакрытиеФормыСлеженияЗаФайлами" 
		ИЛИ ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		ИЛИ ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи" Тогда
		
		Если Не МассоваяОбработка Тогда
			ОбновитьКонтент();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ЗавершениеФоновогоЗадания"
		
		И Параметр.Свойство("КлючФЗ")
		И (Лев(Параметр.КлючФЗ, 17) = "Выполнение обмена" ИЛИ (Параметр.КлючФЗ = "Удаление ошибок МЧД")) Тогда
		
		ОбновитьКонтент();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуСпискаЗадач" Тогда
		
		ОбновитьФорму();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйТитул(Команда)
	
	Если ЗначениеЗаполнено(ТипЛогистика) Тогда 
		ПараметрыФормы  = Новый Структура("СозданВручную", Истина); 
		ПолноеИмяФормы = "Документ." + КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика) + ".ФормаОбъекта";
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ПолноеИмяФормы, ПараметрыФормы); 
		
		Label = ОпределитьНазваниеДокументаДляМетрики(ТипЛогистика);
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя("Ручное создание документов", "Создать", 
			"ОбщиеФормы.КонтурЛогистика_Задачи.Форма.Форма", Label);
		
	Иначе
	    КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не указан Тип логистического документа");
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Функция ОпределитьНазваниеДокументаДляМетрики(ТипЛогистика)
	
	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1") Тогда 
		Результат = "ПЭ";
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда	
		Результат = "ЭР";
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка") Тогда
		Результат = "СР";
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда 
		Результат = "ЭТрН";
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2") Тогда 
		Результат = "ЗЗ";
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2") 
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5") Тогда 
		Результат = "ПЛ_01";
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02")
		ИЛИ ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02")	 Тогда 
		Результат = "ПЛ_02";
	Иначе 
		Результат = "НовыйТип";	
	КонецЕсли;		
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
 	ОбновитьФорму();
	
КонецПроцедуры

// Управление обменом
&НаКлиенте
Процедура ВыполнитьОбменФормаЗадач(Команда = Неопределено)
	
	АдресРезультатаВыполнитьОбмен = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьОбмен",
			,
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьОбмен",
			"Фоновое задание Выполнение обмена",
			АдресРезультатаВыполнитьОбмен);
	
	Если РезультатЗапуска.Статус = "Выполняется" Тогда
		
		ИдентификаторФЗ_ВыполнитьОбмен = РезультатЗапуска.ИдентификаторЗадания;
		Элементы.ФормаВыполнитьОбменФормаЗадач.Заголовок = "Обмен выполняется";
		Элементы.ФормаВыполнитьОбменФормаЗадач.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПесочныеЧасы;
		Элементы.ФормаВыполнитьОбменФормаЗадач.ЦветТекста = WebЦвета.Серый;
		//Элементы.ЛоадерВыполнитьОбмен.Видимость = Истина;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыполнитьОбмен", 0.1, Истина);
		
	ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
		
		ПроверитьФоновоеЗаданиеВыполнитьОбмен();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеВыполнитьОбмен() Экспорт
	
	ИнтервалОбработчикаОжидания = 2;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ВыполнитьОбмен,
		Элементы.ЛоадерВыполнитьОбмен);
	
	Если ЗаданиеЕщеВыполняется Тогда 
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыполнитьОбмен", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		// Проверим результат выполнения фонового задания
		Результат = ПолучитьИзВременногоХранилища(АдресРезультатаВыполнитьОбмен);
		Если Результат <> Неопределено И Не Результат.Успешно Тогда
			ПротоколВыполненияОбмена = "";
			Для Каждого ТекущееСообщение Из Результат.МассивОшибок Цикл
				ПротоколВыполненияОбмена = ПротоколВыполненияОбмена + ТекущееСообщение + Символы.ПС;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ПротоколВыполненияОбмена) Тогда
				ПодключитьОбработчикОжидания("ПоказатьПротоколВыполненияОбмена", 1, Истина);
			КонецЕсли;
		КонецЕсли;
		
		//Элементы.ЛоадерВыполнитьОбмен.Видимость = Ложь;
		Элементы.ФормаВыполнитьОбменФормаЗадач.Заголовок = "Обмен с сервером";
		Элементы.ФормаВыполнитьОбменФормаЗадач.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВыполнитьОбмен;
		Элементы.ФормаВыполнитьОбменФормаЗадач.ЦветТекста = Новый Цвет(77,77,77);
		
		ОбновитьКонтент();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПротоколВыполненияОбмена()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Протокол выполнения обмена");
	ПараметрыФормы.Вставить("Текст", ПротоколВыполненияОбмена);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФормаТекстовогоСообщения", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛоадерВыполнитьОбменНажатие(Элемент)
	
	Если ЗначениеЗаполнено(ИдентификаторФЗ_ВыполнитьОбмен) Тогда 
		КонтурЛогистика_ДлительныеОперацииКлиент.СледитьЗаФоновымЗаданиемВФорме(ИдентификаторФЗ_ВыполнитьОбмен, "Фоновое задание Выполнение обмена", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СледующийТитул(Команда)
	
	СледующийТипТитула = ОпределитьСледующийТипЛогистика(ТипЛогистика, СпецСценарий);
	Если ЗначениеЗаполнено(СледующийТипТитула) И СледующийТипТитула <> ТипЛогистика Тогда
		
		Если ТитулДоступенПользователю(СледующийТипТитула) Тогда
			ТипЛогистика = СледующийТипТитула;
			ТипЛогистикаДоИзменения = ТипЛогистика;
			
			Если СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4")
				И СледующийТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3") Тогда
				
				СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7");
				
			ИначеЕсли СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7")
				И СледующийТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
				
				СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату");
				
			Иначе
				СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
			КонецЕсли;
		Иначе
			ТекстСообщения = "Вам не доступны документы: " + Строка(СледующийТипТитула) + ". Обратитесь к администратору.";
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	ТипЛогистикаПриИзменении(Неопределено);
	
	УправлениеОтображениемКомандыПропуститьОбработкуВходящегоДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущийТитул(Команда)
	
	ПредыдущийТипТитула = ОпределитьПредыдущийТипЛогистика(ТипЛогистика, СпецСценарий);
	Если ЗначениеЗаполнено(ПредыдущийТипТитула) И ПредыдущийТипТитула <> ТипЛогистика Тогда
		
		Если ТитулДоступенПользователю(ПредыдущийТипТитула) Тогда
			ТипЛогистика = ПредыдущийТипТитула;
			ТипЛогистикаДоИзменения = ТипЛогистика;
			
			Если СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7")
				И ПредыдущийТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7") Тогда
				
				СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4");
				
			ИначеЕсли СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату")
				И ПредыдущийТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3") Тогда
				
				СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7");
				
			Иначе
				СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
			КонецЕсли;
		Иначе
			ТекстСообщения = "Вам не доступны документы: " + Строка(ПредыдущийТипТитула) + ". Обратитесь к администратору.";
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	ТипЛогистикаПриИзменении(Неопределено);
	
	УправлениеОтображениемКомандыПропуститьОбработкуВходящегоДокумента();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьСледующийТипЛогистика(ТипЛогистика, СпецСценарий = Неопределено)

	Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СледующийТипДокумента(ТипЛогистика, СпецСценарий);

КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьПредыдущийТипЛогистика(ТипЛогистика, СпецСценарий = Неопределено)

	Возврат Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПредыдущийТипДокумента(ТипЛогистика, СпецСценарий);

КонецФункции

&НаСервереБезКонтекста
Функция НайтиТитул(ДокументЛогистика, ТипЛогистика)
	
	НайденныйТитул = Неопределено;
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда 
		
		СледующийТипЛогистика = ОпределитьСледующийТипЛогистика(ТипЛогистика);
		
		НайденныйТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(СледующийТипЛогистика, ДокументЛогистика);
		
	КонецЕсли;
	
	Возврат НайденныйТитул;

КонецФункции	

