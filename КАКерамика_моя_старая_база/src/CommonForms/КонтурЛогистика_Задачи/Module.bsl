&НаКлиенте
Процедура ДекорацияБаннерЭкспедиторскиеДокументыСсылкаНажатие(Элемент)
	
	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1") Тогда
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Просмотр баннера по ЭЭД", "Переход по гиперссылке", "ОбщаяФорма.КонтурЛогистика_Задачи", "ПЭ1");
				
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2") Тогда
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Просмотр баннера по ЭЭД", "Переход по гиперссылке", "ОбщаяФорма.КонтурЛогистика_Задачи", "ПЭ2");
		
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка") Тогда
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Просмотр баннера по ЭЭД", "Переход по гиперссылке", "ОбщаяФорма.КонтурЛогистика_Задачи", "ЭР");
		
	ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка") Тогда
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Просмотр баннера по ЭЭД", "Переход по гиперссылке", "ОбщаяФорма.КонтурЛогистика_Задачи", "СР");
		
	КонецЕсли;
	
	ТекстСсылка = "https://support.kontur.ru/logistika-1s/ekspeditorskie_dokumenty";
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПерейтиПоСсылке(ТекстСсылка);
	
КонецПроцедуры

#Область ПоказатьТекстЗапроса

&НаСервере
Функция ДанныеЗапроса()
	
	СписокПараметров = Новый СписокЗначений;
	Для каждого Параметр Из ЗадачиДинамическийСписок.Параметры.Элементы Цикл
		
		Если Не Параметр.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		СписокПараметров.Добавить(Параметр.Значение, Строка(Параметр.Параметр));
		
	КонецЦикла;
	
	Отборы = Новый СписокЗначений;
	ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, ЗадачиДинамическийСписок.Отбор.Элементы);
	Для каждого ПользовательскаяНастройка Из  ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ПользовательскаяНастройка) = Тип("ОтборКомпоновкиДанных") Тогда
			ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, ПользовательскаяНастройка.Элементы);	
		КонецЕсли;
	КонецЦикла;
	 		
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ТекстЗапроса", ЗадачиДинамическийСписок.ТекстЗапроса);
	ДанныеЗапроса.Вставить("ПараметрыЗапроса", СписокПараметров);
	ДанныеЗапроса.Вставить("Отборы", Отборы);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

&НаСервере
Процедура ДобавитьЭлементыОтбораКомпоновкиДанных(Отборы, Элементы)
	
	Для каждого Отбор Из Элементы Цикл
		
		Если Не Отбор.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДанныеОтбора = Новый Структура;
			ДанныеОтбора.Вставить("Имя", Строка(Отбор.ТипГруппы));
			ДанныеОтбора.Вставить("ЭтоГруппа", Истина);
			ДанныеОтбора.Вставить("Элементы", Новый СписокЗначений);
						
			Отборы.Добавить(ДанныеОтбора, Строка(Отбор.ТипГруппы));
			
			ДобавитьЭлементыОтбораКомпоновкиДанных(ДанныеОтбора.Элементы, Отбор.Элементы);
		Иначе
			ДанныеОтбора = Новый Структура;
			ДанныеОтбора.Вставить("Имя", Строка(Отбор.ЛевоеЗначение));
			ДанныеОтбора.Вставить("ВидСравнения", Отбор.ВидСравнения);
			ДанныеОтбора.Вставить("Значение", Отбор.ПравоеЗначение);
			ДанныеОтбора.Вставить("ЭтоГруппа", Ложь);
			
			Отборы.Добавить(ДанныеОтбора, Строка(Отбор.ЛевоеЗначение));	
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекстЗапроса(Команда)
			
	ПараметрыФормы = ДанныеЗапроса();	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ФормаТекстаЗапроса", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиТРНизЗЗ(Команда)
	
	МассивЗЗ = Новый Массив;
	
	ВыделенныеСтрокиЗадач = ЭтаФорма.Элементы.ЗадачиДинамическийСписок.ВыделенныеСтроки;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтрокиЗадач Цикл 
		
		ДанныеСтроки = ЭтаФорма.Элементы.ЗадачиДинамическийСписок.ДанныеСтроки(ВыделеннаяСтрока);
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ДокументЛогистика) Тогда 
			Если (ТипЗнч(ДанныеСтроки.ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				Или ТипЗнч(ДанныеСтроки.ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2"))
			Тогда 
				МассивЗЗ.Добавить(ДанныеСтроки.ДокументЛогистика);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ПредыдущийТитул) Тогда	
			
			Если (ТипЗнч(ДанныеСтроки.ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				Или ТипЗнч(ДанныеСтроки.ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2"))
			Тогда 
				МассивЗЗ.Добавить(ДанныеСтроки.ПредыдущийТитул);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивЗЗ.Количество() > 0 Тогда 
		
		ПараметрыВыполненияКоманды = Новый Структура("Источник", ЭтаФорма);
		КонтурЛогистика_ОбработкаДокументовКлиент.ВвестиТРНизЗЗ(МассивЗЗ, ПараметрыВыполненияКоманды);
	
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПереименоватьЗаголовкиКолонокДинСписка()
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокПеревозчик", "Экспедитор");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокНомерТрН", "Номер поручения");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокумент1С", "Учетный документ");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЭТРН", "Маршрут");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЛогистика", "Документ Логистика");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2 Тогда
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокПеревозчик", "Экспедитор");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокНомерТрН", "Номер поручения");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЛогистика", "Поручение Титул2");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЭТРН", "Поручение Титул1");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокПеревозчик", "Экспедитор");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокНомерТрН", "Номер");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЭТРН", "Учетный документ");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЛогистика", "Документ Логистика");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокПеревозчик", "Экспедитор");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокНомерТрН", "Номер");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЭТРН", "Маршрут/партия груза");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокМестоПогрузки", "Склад");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЛогистика", "Документ Логистика");
		УстановитьЗаголовокЭлемента("ОтборСкладОтправитель", "Склад");
	Иначе
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокПеревозчик", "Перевозчик");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокНомерТрН", "Номер");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокумент1С", "Учетный документ");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЛогистика", "Документ Логистика");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокДокументЭТРН", "Учетный документ");
		УстановитьЗаголовокЭлемента("ЗадачиДинамическийСписокМестоПогрузки", "Место погрузки");
		УстановитьЗаголовокЭлемента("ОтборСкладОтправитель", "Место погрузки");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовок()
	
КонецПроцедуры
 

#Область ВариантыФильтров

&НаКлиенте
Процедура ОбработатьПриминениеФильтров()
	
	МожноАвтоприменитьВариант = (ОтборДокументыЛогистики.Количество() = 0);
	ИдентификаторВарианта = ЗаполнитьСписокВыбораВариантовФильтровНаСервере(МожноАвтоприменитьВариант);
	ЕстьВыбранныйВариант = ЗначениеЗаполнено(ИдентификаторВарианта);
	Если ЕстьВыбранныйВариант Тогда
		ПрименитьВариантФильтраПоИдентификатору(ИдентификаторВарианта);
	КонецЕсли;
	
	Элементы.СброситьОтборыНастройки.Доступность = ЕстьВыбранныйВариант;
	
	// При открытии приходится устанавливать два раза иначе не появляются быстрые отборы (не понятно почему)
	Если ЕстьВыбранныйВариант Тогда
		ПрименитьВариантФильтраПоИдентификатору(ИдентификаторВарианта);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьВариантФильтраПоИдентификатору(ИдентификаторВарианта)
	
	Если Не ЗначениеЗаполнено(ИдентификаторВарианта) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСнимка = ДанныеВариантаФильтраНаСервере(ИдентификаторВарианта);
	Если ДанныеСнимка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьРеквизитыСнимкаФильтровНаСервере(ДанныеСнимка);
	ОбновитьКонтент();
	ОбновитьОтображениеКнопокОтбораСостояния();
	УстановитьОтборДинСписка();
	ЗапомнитьПоследнийВариантФильтраНаСервере(ИдентификаторВарианта);
	ТекущийВариантФильтра = ИдентификаторВарианта;
	
	ВосстановитьИсполняемыеНастройки(ДанныеСнимка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийВариантФильтраПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ТекущийВариантФильтра) Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьВариантФильтраПоИдентификатору(ТекущийВариантФильтра);
	
	СброситьСписокНастроекБылОткрыт();
	
	Элементы.СброситьОтборыНастройки.Доступность = Истина;
	
	ОтправитьМетрикуПоведения(ТипЛогистика, "Применить");
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийВариантФильтраНачалоВыбора(Элемент, ДанныеВыбора, СтандажртнаяОбработка)
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		// Особенности 8.2
		СтандажртнаяОбработка = Ложь;
		ПодключитьОбработчикОжидания("ОткрытьФормуФильтровЗадач", 0.1, Истина);
		Возврат;
	КонецЕсли;
	
	СписокНастроекБылОткрыт = Не СписокНастроекБылОткрыт;
	
	Если СписокНастроекБылОткрыт = Ложь Тогда
		
		ПодключитьОбработчикОжидания("ОткрытьФормуФильтровЗадач", 0.1, Истина);
		
	Иначе
		
		// Сброс признака произойдет через три секунды. Это нужно для следующего сценария:
		// если пользователь не нажмет кнопку «Показать все» в течение этого времени,
		// то при повторном выборе должен снова открыться выпадающий список, а не весь перечень элементов.
		ПодключитьОбработчикОжидания("СброситьСписокНастроекБылОткрыт", 3, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуФильтровЗадач()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючНастроекВариантовФильтров", КлючНастроекВариантовФильтров());
	ПараметрыФормы.Вставить("КлючОбъектаВариантовФильтров", КлючОбъектаВариантовФильтров());
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ВсеФильтрыСпискаЗадач", ПараметрыФормы,
		ЭтаФорма, ЭтаФорма, "ТекущийВариантФильтраРедактированиеФильтровЗавершение",,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьСписокНастроекБылОткрыт()
	
	СписокНастроекБылОткрыт = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийВариантФильтраРедактированиеФильтровЗавершение(Результат, ДополнителныеПараметры) Экспорт
	
	// Заполним список вариантов, вдруго его изменили при редактировании в форме
	ПрименитьПоследний = Ложь;
	ЗаполнитьСписокВыбораВариантовФильтровНаСервере(ПрименитьПоследний);
	
	// Ничего не выбрали
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Установим новый выбранный
	ТекущийВариантФильтра = Результат;
	
	// Применим настройки выбранного
	ПрименитьВариантФильтраПоИдентификатору(ТекущийВариантФильтра);
	
	// Доступна команда сброса
	Элементы.СброситьОтборыНастройки.Доступность = Истина;
	
	СброситьСписокНастроекБылОткрыт();
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийВариантФильтраОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СброситьСписокНастроекБылОткрыт();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантФильтра(Команда)
	
	Если ЗначениеЗаполнено(ТекущийВариантФильтра) Тогда
		
		СписокВариантов = Новый СписокЗначений;
		СписокВариантов.Добавить("Перезаписать", "Перезаписать");
		СписокВариантов.Добавить("Новый", "Новый");
		
		Оповещение = Новый ОписаниеОповещения("СохранитьВариантФильтраЗавершение", ЭтаФорма);
		
		ПоказатьВыборИзСписка(Оповещение, СписокВариантов, Элементы.СохранитьВариантФильтра);
		
	Иначе
		
		СохранитьВариантФильтраКак();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантФильтраЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Значение = "Перезаписать" Тогда
		
		// Перезапишем текущий
		ИдентификаторВарианта = СохранитьВариантФильтровНаСервере(ТекущийВариантФильтра, "", Ложь);
		ТекущийВариантФильтра = ИдентификаторВарианта;
		ЗаполнитьСписокВыбораВариантовФильтровНаСервере(Ложь);
		
	Иначе
		
		// Создадим новый
		СохранитьВариантФильтраКак();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьОтборыНастройки(Команда)
	
	Элементы.ГруппаОтборыНастройкиТело.Видимость = Не Элементы.ГруппаОтборыНастройкиТело.Видимость;
	
	Элементы.СкрытьПоказатьОтборыНастройки.Пометка = Элементы.ГруппаОтборыНастройкиТело.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборыНастройки(Команда)
	
	ТекущийВариантФильтра = "";
	ЗапомнитьПоследнийВариантФильтраНаСервере(ТекущийВариантФильтра);
	
	ТипДокументаКонфигурации = "";
	УстановитьТипДокументаКонфигурации();
	
	Период = ПериодВходящий;
	
	ОтборГрузоотправитель = Неопределено;
	ОтборПеревозчик = Неопределено;
	ОтборГрузополучатель = Неопределено;
	ОтборКонтрагент = Неопределено;
	ОтборПогрузка = Неопределено;
	ОтборВыгрузка = Неопределено;
	ОтборТребуемоеДействие = Неопределено;
	
	Для Каждого ИмяРеквизита Из ИменаДинамическихРеквизитовОтбора() Цикл
		
		Если Не ЕстьРеквизитФормы(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизита]) Тогда
			ЭтаФорма[ИмяРеквизита] = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	// 1. Находим коллекцию пользовательских отборов списка
	КоллекцияОтборов = Неопределено;
	Для Каждого ЭлементНастройки Из ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастройки) = Тип("ОтборКомпоновкиДанных") Тогда
			КоллекцияОтборов = ЭлементНастройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если в пользовательских настройках нет коллекции, берем основную настройки компоновщика
	Если КоллекцияОтборов = Неопределено Тогда
		КоллекцияОтборов = ЗадачиДинамическийСписок.КомпоновщикНастроек.Настройки.Отбор;
	КонецЕсли;
	
	// 2. Очищаем старые отборы (чтобы не дублировать)
	КоллекцияОтборов.Элементы.Очистить();
	
	СформироватьТекстЗапросаСпискаЗадачИнтеграция();
	ОбновитьКонтент();
	ОбновитьОтображениеКнопокОтбораСостояния();
	УстановитьОтборДинСписка();
	ТекущийВариантФильтра = "";
	
	Элементы.СброситьОтборыНастройки.Доступность = Ложь;
	
	ОтправитьМетрикуПоведения(ТипЛогистика, "Сбросить");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариантФильтраКак()
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводСтроки_КонтурЛогистика(
		"Фильтр 1", "Название настройки", Ложь, ЭтаФорма, "НазваниеНастройкиЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура НазваниеНастройкиЗавершение(ИмяВарианта, ДополнительныеПараметры) Экспорт
	
	Если ИмяВарианта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВарианта = СокрЛП(ИмяВарианта);
	Если Не ЗначениеЗаполнено(ИмяВарианта) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Укажите название настройки");
		Возврат;
	КонецЕсли;
	
	Если СтрДлина(ИмяВарианта) > 70 Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Длина названия настройки не должна быть длинее 70 символов");
		Возврат;
	КонецЕсли;
	
	// Проверим что имя уникально
	Для Каждого ТекущаяСтрока Из Элементы.ТекущийВариантФильтра.СписокВыбора Цикл
		
		Если ТекущаяСтрока.Представление <> ИмяВарианта Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОбработчика = Новый Структура;
		ПараметрыОбработчика.Вставить("ИдентификаторВарианта", ТекущаяСтрока.Значение);
		ПараметрыОбработчика.Вставить("ИмяВарианта", ИмяВарианта);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
			"Перезаписать существующий?", РежимДиалогаВопрос.ДаНет,
			"Фильтр с таким названием уже существует",, ЭтаФорма,
			"ПерезаписатьСуществующуюНастройкуЗавершение", ПараметрыОбработчика);
		
		Возврат;
		
	КонецЦикла;
	
	ТекущийВариантФильтра = СохранитьВариантФильтровНаСервере("", ИмяВарианта, Истина);
	ЗаполнитьСписокВыбораВариантовФильтровНаСервере(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаписатьСуществующуюНастройкуЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийВариантФильтра = СохранитьВариантФильтровНаСервере(
		ДополнительныеПараметры.ИдентификаторВарианта, ДополнительныеПараметры.ИмяВарианта, Ложь);
	ЗаполнитьСписокВыбораВариантовФильтровНаСервере(Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючОбъектаВариантовФильтров()
	
	Возврат "КонтурЛогистика_Задачи_ВариантыФильтров";
	
КонецФункции

&НаСервере
Функция КлючНастроекВариантовФильтров()
	
	Возврат Строка(ТипЛогистика);
	
КонецФункции

&НаСервере
Функция ПустойКонтейнерВариантовФильтров()
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияФормата", 1);
	Результат.Вставить("Варианты", Новый Массив);
	Результат.Вставить("ПоследнийИдентификатор", "");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПрочитатьВариантыФильтров()
	
	Сохраненное = ХранилищеОбщихНастроек.Загрузить(
		КлючОбъектаВариантовФильтров(),
		КлючНастроекВариантовФильтров());
	
	Если ТипЗнч(Сохраненное) <> Тип("Структура") Тогда
		Возврат ПустойКонтейнерВариантовФильтров();
	КонецЕсли;
	
	Если Не Сохраненное.Свойство("Варианты") Или ТипЗнч(Сохраненное.Варианты) <> Тип("Массив") Тогда
		Возврат ПустойКонтейнерВариантовФильтров();
	КонецЕсли;
	
	Если Не Сохраненное.Свойство("ПоследнийИдентификатор") Тогда
		Сохраненное.Вставить("ПоследнийИдентификатор", "");
	КонецЕсли;
	
	Если Не Сохраненное.Свойство("ВерсияФормата") Тогда
		Сохраненное.Вставить("ВерсияФормата", 1);
	КонецЕсли;
	
	Возврат Сохраненное;
	
КонецФункции

&НаСервере
Процедура ЗаписатьВариантыФильтров(Контейнер)
	
	ХранилищеОбщихНастроек.Сохранить(
		КлючОбъектаВариантовФильтров(),
		КлючНастроекВариантовФильтров(),
		Контейнер);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораВариантовФильтровНаСервере(ПрименитьПоследний)
	
	Контейнер = ПрочитатьВариантыФильтров();
	СписокВыбора = Элементы.ТекущийВариантФильтра.СписокВыбора;
	СписокВыбора.Очистить();
	
	Для Каждого Вариант Из Контейнер.Варианты Цикл
		
		Если ТипЗнч(Вариант) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Вариант.Свойство("Идентификатор") Или Не Вариант.Свойство("Имя") Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(Вариант.Идентификатор, Вариант.Имя);
		
	КонецЦикла;
	
	ИдентификаторКПрименению = "";
	Если ПрименитьПоследний И ЗначениеЗаполнено(Контейнер.ПоследнийИдентификатор) Тогда
		ИдентификаторКПрименению = Контейнер.ПоследнийИдентификатор;
	ИначеЕсли ЗначениеЗаполнено(ТекущийВариантФильтра) Тогда
		ИдентификаторКПрименению = ТекущийВариантФильтра;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторКПрименению) Тогда
		
		Найден = Ложь;
		Для Каждого ЭлементСписка Из СписокВыбора Цикл
			Если ЭлементСписка.Значение = ИдентификаторКПрименению Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не Найден Тогда
			ИдентификаторКПрименению = "";
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущийВариантФильтра = ИдентификаторКПрименению;
	
	Элементы.СброситьОтборыНастройки.Доступность = ЗначениеЗаполнено(ТекущийВариантФильтра);
	
	Возврат ИдентификаторКПрименению;
	
КонецФункции

&НаСервере
Функция ДанныеВариантаФильтраНаСервере(ИдентификаторВарианта)
	
	Контейнер = ПрочитатьВариантыФильтров();
	
	Для Каждого Вариант Из Контейнер.Варианты Цикл
		
		Если ТипЗнч(Вариант) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Вариант.Свойство("Идентификатор")
			И Вариант.Идентификатор = ИдентификаторВарианта
			И Вариант.Свойство("Данные") Тогда
			
			Возврат Вариант.Данные;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция СобратьСнимокФильтров()
	
	Данные = Новый Структура;
	Данные.Вставить("Период", Период);
	Данные.Вставить("ТипДокументаКонфигурации", ТипДокументаКонфигурации);
	Данные.Вставить("ОтборГрузоотправитель", ОтборГрузоотправитель);
	Данные.Вставить("ОтборПеревозчик", ОтборПеревозчик);
	Данные.Вставить("ОтборГрузополучатель", ОтборГрузополучатель);
	Данные.Вставить("ОтборКонтрагент", ОтборКонтрагент);
	Данные.Вставить("ОтборПогрузка", ОтборПогрузка);
	Данные.Вставить("ОтборВыгрузка", ОтборВыгрузка);
	Данные.Вставить("ОтборТребуемоеДействие", ОтборТребуемоеДействие);
	
	ДинамическиеОтборы = Новый Структура;
	Для Каждого ИмяРеквизита Из ИменаДинамическихРеквизитовОтбора() Цикл
		
		Если Не ЕстьРеквизитФормы(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизита]) Тогда
			ДинамическиеОтборы.Вставить(ИмяРеквизита, ЭтаФорма[ИмяРеквизита]);
		КонецЕсли;
		
	КонецЦикла;
	Данные.Вставить("ДинамическиеОтборы", ДинамическиеОтборы);
	
	Попытка
		Данные.Вставить("ИсполняемыеНастройки", ТекущиеИсполняемыеНастройкиПользователя());
	Исключение
		Данные.Вставить("ИсполняемыеНастройки", Неопределено);
	КонецПопытки;
	
	Возврат Данные;
	
КонецФункции

&НаСервере
Функция ТекущиеИсполняемыеНастройкиПользователя()
	
	// Получаем всё, что сейчас видит пользователь на экране (включая Alt+F)
	ИсполняемыеНастройки = Элементы.ЗадачиДинамическийСписок.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	МассивОтборов = Новый Массив;
	
	Для Каждого Элемент Из ИсполняемыеНастройки.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.Использование Тогда
			
			// Не берем, то что в фиксированных настройках
			ЕстьСовпадения = Ложь;
			Для Каждого ТенкущийФиксированныйОтбор Из ЗадачиДинамическийСписок.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы Цикл
				Если ТенкущийФиксированныйОтбор.ЛевоеЗначение = Элемент.ЛевоеЗначение Тогда
					ЕстьСовпадения = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьСовпадения Тогда
				Продолжить;
			КонецЕсли;
			
			// Сохраняем свойства отбора в простую структуру
			СвойстваОтбора = Новый Структура;
			СвойстваОтбора.Вставить("ЛевоеЗначение", Элемент.ЛевоеЗначение);
			СвойстваОтбора.Вставить("ВидСравнения", Элемент.ВидСравнения);
			СвойстваОтбора.Вставить("ПравоеЗначение", Элемент.ПравоеЗначение);
			
			МассивОтборов.Добавить(СвойстваОтбора);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивОтборов;
	
КонецФункции

&НаСервере
Функция ИменаДинамическихРеквизитовОтбора()
	
	Результат = Новый Массив;
	Результат.Добавить("ОтборВодитель");
	Результат.Добавить("ОтборТранспортноеСредство");
	Результат.Добавить("ОтборМедРаботник");
	Результат.Добавить("ОтборОтветственныйЗаОформление");
	
	инд = 1;
	Пока ЕстьРеквизитФормы("ОтборДопКолонкаДоп" + Строка(инд)) Цикл
		Результат.Добавить("ОтборДопКолонкаДоп" + Строка(инд));
		инд = инд + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьЗначениеОтбораИзСнимка(Данные, ИмяРеквизита)
	
	Если Не Данные.Свойство(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭтаФорма[ИмяРеквизита] = Данные[ИмяРеквизита];
	Исключение
		// Ссылка могла стать недействительной — пропускаем значение.
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьРеквизитыСнимкаФильтровНаСервере(Данные)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтарыйТипДокументаКонфигурации = ТипДокументаКонфигурации;
	
	ОтборГрузоотправитель = Неопределено;
	ОтборПеревозчик = Неопределено;
	ОтборГрузополучатель = Неопределено;
	ОтборКонтрагент = Неопределено;
	ОтборПогрузка = Неопределено;
	ОтборВыгрузка = Неопределено;
	ОтборТребуемоеДействие = Неопределено;
	
	Для Каждого ИмяРеквизита Из ИменаДинамическихРеквизитовОтбора() Цикл
		Если ЕстьРеквизитФормы(ИмяРеквизита) Тогда
			ЭтаФорма[ИмяРеквизита] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Если Данные.Свойство("Период") Тогда
		Период = Данные.Период;
		КонтурЛогистика_ОбщегоНазначенияСервер.ПреобразоватьПериод(Период);
	КонецЕсли;
	
	Если Данные.Свойство("ТипДокументаКонфигурации") Тогда
		ТипДокументаКонфигурации = Данные.ТипДокументаКонфигурации;
	КонецЕсли;
	
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборГрузоотправитель");
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборПеревозчик");
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборГрузополучатель");
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборКонтрагент");
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборПогрузка");
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборВыгрузка");
	УстановитьЗначениеОтбораИзСнимка(Данные, "ОтборТребуемоеДействие");
	
	Если Данные.Свойство("ДинамическиеОтборы") И ТипЗнч(Данные.ДинамическиеОтборы) = Тип("Структура") Тогда
		
		Для Каждого КлючИЗначение Из Данные.ДинамическиеОтборы Цикл
			
			Если Не ЕстьРеквизитФормы(КлючИЗначение.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				ЭтаФорма[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			Исключение
				// Ссылка или тип значения устарели — пропускаем.
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СтарыйТипДокументаКонфигурации <> ТипДокументаКонфигурации Тогда
		СформироватьТекстЗапросаСпискаЗадачИнтеграция();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьИсполняемыеНастройки(Данные)
	
	// 1. Находим коллекцию пользовательских отборов списка
	КоллекцияОтборов = Неопределено;
	Для Каждого ЭлементНастройки Из ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастройки) = Тип("ОтборКомпоновкиДанных") Тогда
			КоллекцияОтборов = ЭлементНастройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если в пользовательских настройках нет коллекции, берем основную настройки компоновщика
	Если КоллекцияОтборов = Неопределено Тогда
		КоллекцияОтборов = ЗадачиДинамическийСписок.КомпоновщикНастроек.Настройки.Отбор;
	КонецЕсли;
	
	// 2. Очищаем старые отборы (чтобы не дублировать)
	КоллекцияОтборов.Элементы.Очистить();
	
	Если Данные.Свойство("ИсполняемыеНастройки") И Данные.ИсполняемыеНастройки <> Неопределено Тогда
		ИсполняемыеНастройки = Данные.ИсполняемыеНастройки;
	Иначе
		Возврат;
	КонецЕсли;
	
	// 3. Переносим сохраненные отборы обратно в список
	Для Каждого СтрОтбора Из ИсполняемыеНастройки Цикл
		
		НовыйЭлемент = КоллекцияОтборов.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ЛевоеЗначение = СтрОтбора.ЛевоеЗначение;
		НовыйЭлемент.ВидСравнения = СтрОтбора.ВидСравнения;
		НовыйЭлемент.ПравоеЗначение = СтрОтбора.ПравоеЗначение;
		НовыйЭлемент.Использование = Истина;
		
		// !!! ГЛАВНОЕ ИСПРАВЛЕНИЕ: Даем отбору уникальный строковый ключ
		// Без этого ключа платформа применит фильтр, но не выведет его на форму!
		УникальныйХеш = СокрЛП(СтрОтбора.ЛевоеЗначение) + "_" + Строка(Новый УникальныйИдентификатор);
		НовыйЭлемент.ИдентификаторПользовательскойНастройки = УникальныйХеш;
		
		// Делаем отбор видимым для пользователя на панели быстрых отборов (по желанию)
		НовыйЭлемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИсполняемыеНастройки()
	
	// 1. Находим коллекцию пользовательских отборов списка
	КоллекцияОтборов = Неопределено;
	Для Каждого ЭлементНастройки Из ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастройки) = Тип("ОтборКомпоновкиДанных") Тогда
			КоллекцияОтборов = ЭлементНастройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если в пользовательских настройках нет коллекции, берем основную настройки компоновщика
	Если КоллекцияОтборов = Неопределено Тогда
		КоллекцияОтборов = ЗадачиДинамическийСписок.КомпоновщикНастроек.Настройки.Отбор;
	КонецЕсли;
	
	// 2. Очищаем старые отборы (чтобы не дублировать)
	КоллекцияОтборов.Элементы.Очистить();
	
КонецПроцедуры

&НаСервере
Функция СохранитьВариантФильтровНаСервере(ИдентификаторВарианта, ИмяВарианта, ЭтоНовый)
	
	Контейнер = ПрочитатьВариантыФильтров();
	Данные = СобратьСнимокФильтров();
	
	Если ЭтоНовый Или Не ЗначениеЗаполнено(ИдентификаторВарианта) Тогда
		
		ИдентификаторВарианта = Строка(Новый УникальныйИдентификатор);
		Вариант = Новый Структура;
		Вариант.Вставить("Идентификатор", ИдентификаторВарианта);
		Вариант.Вставить("Имя", ИмяВарианта);
		Вариант.Вставить("Данные", Данные);
		Контейнер.Варианты.Добавить(Вариант);
		
	Иначе
		
		Найден = Ложь;
		Для Каждого Вариант Из Контейнер.Варианты Цикл
			
			Если ТипЗнч(Вариант) = Тип("Структура")
				И Вариант.Свойство("Идентификатор")
				И Вариант.Идентификатор = ИдентификаторВарианта Тогда
				
				Вариант.Данные = Данные;
				Если ЗначениеЗаполнено(ИмяВарианта) Тогда
					Вариант.Имя = ИмяВарианта;
				КонецЕсли;
				Найден = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не Найден Тогда
			
			ИдентификаторВарианта = Строка(Новый УникальныйИдентификатор);
			Вариант = Новый Структура;
			Вариант.Вставить("Идентификатор", ИдентификаторВарианта);
			Вариант.Вставить("Имя", ?(ЗначениеЗаполнено(ИмяВарианта), ИмяВарианта, "Вариант"));
			Вариант.Вставить("Данные", Данные);
			Контейнер.Варианты.Добавить(Вариант);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Контейнер.ПоследнийИдентификатор = ИдентификаторВарианта;
	
	ЗаписатьВариантыФильтров(Контейнер);
	
	ОтправитьМетрикуСохранения(Контейнер, ЭтоНовый);
	
	Возврат ИдентификаторВарианта;
	
КонецФункции

&НаСервере
Процедура ОтправитьМетрикуСохранения(Контейнер, ЭтоНовый)
	
	// Соберем заполненные отборы
	ПараметрыФильтра = Новый Массив;
	Для Каждого ТекущаяСтрока Из Контейнер.Варианты Цикл
		
		Если ТекущаяСтрока.Идентификатор <> Контейнер.ПоследнийИдентификатор Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = ТекущаяСтрока.Данные;
		
		ПроверяемыеРеквизиты = Новый Массив;
		ПроверяемыеРеквизиты.Добавить("ОтборГрузоотправитель");
		ПроверяемыеРеквизиты.Добавить("ОтборПеревозчик");
		ПроверяемыеРеквизиты.Добавить("ОтборГрузополучатель");
		ПроверяемыеРеквизиты.Добавить("ОтборКонтрагент");
		ПроверяемыеРеквизиты.Добавить("ОтборПогрузка");
		ПроверяемыеРеквизиты.Добавить("ОтборВыгрузка");
		ПроверяемыеРеквизиты.Добавить("ОтборТребуемоеДействие");
		
		Для Каждого ТекущийРеквизит Из ПроверяемыеРеквизиты Цикл
			Если ЗначениеЗаполнено(Данные[ТекущийРеквизит]) Тогда
				ПараметрыФильтра.Добавить(ТекущийРеквизит);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекущийОтбор Из Данные.ДинамическиеОтборы Цикл
			ПараметрыФильтра.Добавить(Строка(ТекущийОтбор.Ключ));
		КонецЦикла;
		
		Если Данные.ИсполняемыеНастройки <> Неопределено Тогда
			Для Каждого ТекущийОтбор Из Данные.ИсполняемыеНастройки Цикл
				ПараметрыФильтра.Добавить(Строка(ТекущийОтбор.ЛевоеЗначение));
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	// Метрика поведения
	ДопИнформация = Новый Структура;
	ДопИнформация.Вставить("ПараметрыФильтра", ПараметрыФильтра);
	
	Бирка = ?(ЭтоНовый, "Новый", "Перезапись");
	
	ОтправитьМетрикуПоведения(ТипЛогистика, "Сохранить", Бирка, ДопИнформация);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтправитьМетрикуПоведения(ТипЛогистика, ИмяДействия, Бирка = Неопределено, ДопИнформация = Неопределено)
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	
	Если ДопИнформация = Неопределено Тогда
		ДопИнформация = Новый Структура;
	КонецЕсли;
	
	ДопИнформация.Вставить("Титул", ИмяТитула);
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Фильтры в списке задач", ИмяДействия,
		"ОбщаяФорма.КонтурЛогистика_Задачи", Бирка,, ДопИнформация);
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПоследнийВариантФильтраНаСервере(ИдентификаторВарианта)
	
	Контейнер = ПрочитатьВариантыФильтров();
	Контейнер.ПоследнийИдентификатор = ИдентификаторВарианта;
	ЗаписатьВариантыФильтров(Контейнер);
	
КонецПроцедуры

