&НаКлиенте
Процедура ОтказатьсяВПодписи(Команда)
	
	ТекДанные = Элементы.ЗадачиДинамическийСписок.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Статус) 
		Или ТекДанные.Статус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик") Тогда 
		
		ТитулСсылка = ТекДанные.ДокументЛогистика;
		
		Если Не ЗначениеЗаполнено(ТитулСсылка) Тогда 
			МассивДокументов = СоздатьДокументЛогистикиПоПредыдущемуТитулу(ТекДанные.ПредыдущийТитул, ТипЛогистика);
			Если ЗначениеЗаполнено(МассивДокументов) Тогда 
				ТитулСсылка = МассивДокументов[0];
			КонецЕсли;	
		КонецЕсли;	
		
		КонтурЛогистика_ОбработкаДокументовКлиент.ОтказатьсяВПодписи(ТитулСсылка, Новый Структура("Источник", ЭтаФорма));
		
	Иначе	
		
		ВызватьИсключение "Отказываться от Титула можно в статусах ""Новый"" и ""Черновик""";
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьДокументЛогистикиПоПредыдущемуТитулу(ПредыдущийТитул, ТипЛогистика)
	
	МассивДокументов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПредыдущийТитул);
	
	РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(МассивДокументов, ТипЛогистика, Ложь);
	
	Возврат РезультатВвода.ВведенныеДокументы;
	
КонецФункции	

