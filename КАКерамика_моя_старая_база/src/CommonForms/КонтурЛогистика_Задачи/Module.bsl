&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Элементы.ЛоадерВыполнитьОбмен.Видимость = Ложь;
	Элементы.ФормаВыполнитьОбменФормаЗадач.Картинка = БиблиотекаКартинок.КонтурЛогистика_ВыполнитьОбмен;
	
	ТипЛогистика = Параметры.ТипЛогистика;
	ТипЛогистикаДоИзменения = ТипЛогистика;
	СпецСценарий = Параметры.СпецСценарий;
	
	БазовыйТекстЗапроса = ЗадачиДинамическийСписок.ТекстЗапроса;
	БазовыйТекстЗапросаТитул2 = ЗадачиДинамическийСписокПоПредыдущемуТитулу.ТекстЗапроса;
	БазовыйТекстЗапросаТитул3 = ЗадачиДинамическийСписокПоПредыдущемуТитулу.ТекстЗапроса;
	БазовыйТекстЗапросаТрнТитул3ПослеТитула7 = ЗадачиДинамическийСписокТрнТитул3ПослеТитула7.ТекстЗапроса;
	БазовыйТекстЗапросаТрнТитул7ПослеТитула4 = ЗадачиДинамическийСписокТрнТитул7ПослеТитула4.ТекстЗапроса;
	
	Период = Параметры.Период;
	ПериодВходящий = Период;
	КонтурЛогистика_ОбщегоНазначенияСервер.ПреобразоватьПериод(Период);
	
	Если ЗначениеЗаполнено(Параметры.ОтборСостояние) Тогда 
		ОтборСостояние = Параметры.ОтборСостояние;
	Иначе
		ОтборСостояние = Перечисления.КонтурЛогистика_ОтборыПоСостояниюЗадач.МоиЗадачи;
	КонецЕсли;
	
	Элементы.СостояниеОбмена.Видимость = Ложь; // будет показан после открытия если требуется
	Элементы.ГруппаОтборыНастройкиТело.Видимость = Ложь;
	
	// TODO реализовать
	// ЗадачиДинамическийСписок.ТекстЗапроса = КонтурЛогистика_КонвертацияСервер.ТекстЗапросаДинамическогоСпискаЗадач();
	
	ОбработатьНовыйТипДокументаЛогистикаСервер();
	УсловноеОформлениеТребуемогоДействияЗЗ();
	
	УправлениеОтображениемКомандыПропуститьОбработкуВходящегоДокумента();
	
	ЕстьНашиПВ = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиПВВОрганизациях();
	Элементы.ФормаГруппаПеревозчик.Видимость = ЕстьНашиПВ;	
	Элементы.ФормаГруппаПеревозчик1.Видимость = ЕстьНашиПВ;	
	Элементы.ЗадачиДинамическийСписокКонтекстноеМенюГруппаПеревозчик.Видимость = ЕстьНашиПВ;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПоручениеЭкспедитору")
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЭкспедиторскаяРасписка")
		Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяСкладскаяРасписка") Тогда
		
		ДействуютЭкспедиторскиеДокументы = КонтурЛогистика_ОбщегоНазначенияСервер.ДействуютЭкспедиторскиеДокументы();
	КонецЕсли;
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ДокументЛогистика") Тогда
		ОтборДокументыЛогистики = Параметры.Отбор.ДокументЛогистика;
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоРежимСовместимости_8_2() Тогда
		Элементы.ТекущийВариантФильтра.КнопкаСпискаВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда 
		
		ОбновитьКонтент();
		
		УстановитьОтборДинСписка();
		
		ПодключитьОбработчикОжидания("ВыполнитьПроверкуАктуальностиГраницы", 5*60, Ложь);
		ПодключитьОбработчикОжидания("ОбработатьПриминениеФильтров", 0.1, Истина);
		
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ВыполнитьПроверкуСертификатов", 60*60, Ложь);
	ПодключитьОбработчикОжидания("ПроверитьНаличиеУведомлений", 3, Истина);
	
	ОбновитьБаннерЭкспедиторскихДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуСертификатов()
	
	Оповестить("ВыполнитьПроверкуСертификатов");	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуАктуальностиГраницы()
	
	ДанныеГраницы = ПолучитьМинимальнуюДатуГраницыСинхронизации();
	
	ПредставлениеДанных = КонтурЛогистика_ОбщегоНазначенияКлиент.ПредставлениеДанныхГраницыСинхронизации(ДанныеГраницы);
	ЗаполнитьЗначенияСвойств(Элементы.СостояниеОбмена, ПредставлениеДанных);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьНовыйТипДокументаЛогистикаСервер()
	
	МассивДоступныхТитулов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьМассивТитуловОформляемыхТекущимПользователем();
	
	Элементы.ТипЛогистика.СписокВыбора.Очистить();
	Элементы.ТипЛогистика.СписокВыбора.ЗагрузитьЗначения(МассивДоступныхТитулов);
	Элементы.ФормаНовыйТитул.Видимость = (Не (Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипЛогистика)
				Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2")) 
			Или	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1"));
	
	УстановитьТипДокументаКонфигурации();
	
	СформироватьТекстЗапросаСпискаЗадачИнтеграция();
	
	ПодготовитьДанныеФормы();
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда 
		УстановитьПараметрыДинамическогоСписка();
		УстановитьВидимостьДоступностьЭлементов();
		ПереименоватьЗаголовкиКолонокДинСписка();
	КонецЕсли;

	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3") Тогда
		
		ДоступностьЧерновикаТрН = Истина;
	Иначе
		ДоступностьЧерновикаТрН = Ложь;
	КонецЕсли;
	
	Если ДоступностьЧерновикаТрН
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1") Тогда
		
		ДоступностьОтправкиЧерновика = Истина;
	Иначе
		ДоступностьОтправкиЧерновика = Ложь;
	КонецЕсли;
	
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СоздатьЧерновик", ДоступностьЧерновикаТрН);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный", ДоступностьОтправкиЧерновика);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке", ДоступностьОтправкиЧерновика);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный1", ДоступностьОтправкиЧерновика);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке1", ДоступностьОтправкиЧерновика);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание", ДоступностьЧерновикаТрН);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителю", ДоступностьЧерновикаТрН);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаПодписание1", ДоступностьЧерновикаТрН);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ПередатьНаСогласованиеВодителю1", ДоступностьЧерновикаТрН);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СоздатьЧерновик", ДоступностьЧерновикаТрН);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ПодготовитьНеподписанныйКОтправке", ДоступностьОтправкиЧерновика);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ОтправитьНеподписанный", ДоступностьОтправкиЧерновика);
	
	ДоступностьКоманд = НЕ Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипЛогистика);
	
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_УдалитьДокументыЛогистика", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_УдалитьДокументыДиадок", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыДиадок1", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ПоказатьЭТРН", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюВводДокументовИзПредыдущего", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ВвестиСледующийТитул", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_УдалитьДокументыЛогистика", ДоступностьКоманд);
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ВвестиСледующийТитул", ДоступностьКоманд);
	
	// до появления в вебе логистики
	ИзменитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ОткрытьВВебЛогиситка", ДоступностьКоманд);
	
	ОбновитьОтображениеПоГруппамДоступа();
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьВидимостьЭлемента(ИмяЭлемента, ЗначениеДоступности)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент <> Неопределено Тогда
		НайденныйЭлемент.Видимость = ЗначениеДоступности;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипДокументаКонфигурации()
	
	// Работа с разными типами документов
	// Требуется выбрать новый ТипДокументаКонфигурации (док. учетной системы)
	// в связи с изменившимися ключевыми реквизитами.
	
	ВыбранныйТипДокументаКонфигурации = ТипДокументаКонфигурации;
	
	Если ЗначениеЗаполнено(СпецСценарий) Тогда
		ТипДокументаКонфигурации = "Предыдущий титул";
		Элементы.ТипДокументаКонфигурации.СписокВыбора.Очистить();
		Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить("Предыдущий титул", "Предыдущий титул"); 
		Элементы.СпецСценарий.Видимость = Истина;
		Возврат;
	Иначе
		Элементы.СпецСценарий.Видимость = Ложь;
	КонецЕсли;
	
	ТипыДокументов1СМассив = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(ТипЛогистика, СпецСценарий, Истина);
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗадачи;
	Элементы.ТипДокументаКонфигурации.СписокВыбора.Очистить();
	
	ЭтоПервыйТитул = (Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипЛогистика) = "1");
	Если ЭтоПервыйТитул Тогда
		
		Элементы.ТипДокументаКонфигурации.ТолькоПросмотр = Ложь;
		Элементы.ТипДокументаКонфигурации.КнопкаСпискаВыбора = Истина;
		Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить("Все типы", "Все типы");
		ТипДокументаКонфигурации = "Все типы";
		
	Иначе
		
		Если ТипыДокументов1СМассив.Количество() = 1 Тогда
			Элементы.ТипДокументаКонфигурации.ТолькоПросмотр = Истина;
			ТипДокументаКонфигурации = ТипыДокументов1СМассив[0];
			Если Не ЗначениеЗаполнено(ТипДокументаКонфигурации) Тогда
				ТипДокументаКонфигурации = "Предыдущий титул";
			КонецЕсли;
		Иначе
			Элементы.ТипДокументаКонфигурации.ТолькоПросмотр = Ложь;
			Элементы.ТипДокументаКонфигурации.КнопкаСпискаВыбора = Истина;
			Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить("Все типы", "Все типы");
			ТипДокументаКонфигурации = "Все типы";
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого текТипЗначенияОбъекта Из ТипыДокументов1СМассив Цикл
		
		Если ЗначениеЗаполнено(текТипЗначенияОбъекта) Тогда
			
			ТипДокументаКонфигурацииОб = Метаданные.Документы.Найти(текТипЗначенияОбъекта);
			
			Если ТипДокументаКонфигурацииОб <> Неопределено Тогда
				Если ПравоДоступа("Чтение", ТипДокументаКонфигурацииОб) И ПравоДоступа("Просмотр", ТипДокументаКонфигурацииОб) Тогда
					Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить(
						текТипЗначенияОбъекта, ТипДокументаКонфигурацииОб.Синоним);
				Иначе
					Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить(
						текТипЗначенияОбъекта, ТипДокументаКонфигурацииОб.Синоним + " (нет доступа)");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтоПервыйТитул Тогда
		Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить("Другие", "Другие");
	Иначе
		Элементы.ТипДокументаКонфигурации.СписокВыбора.Добавить("Предыдущий титул", "Предыдущий титул");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбранныйТипДокументаКонфигурации) Тогда
		ТипДокументаКонфигурации = ВыбранныйТипДокументаКонфигурации;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьТекстЗапросаСпискаЗадачИнтеграция()
	
	Если ЗначениеЗаполнено(ТипДокументаКонфигурации) И ТипДокументаКонфигурации <> "Предыдущий титул" Тогда
		
		ТипДокументаКонфигурацииОб = Метаданные.Документы.Найти(ТипДокументаКонфигурации);
		
		Если ТипДокументаКонфигурацииОб <> Неопределено
			И (Не ПравоДоступа("Чтение", ТипДокументаКонфигурацииОб) Или Не ПравоДоступа("Просмотр", ТипДокументаКонфигурацииОб)) Тогда
			
			УстановитьБаннерПроблемы("Нет прав для работы с документом " + ТипДокументаКонфигурации);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипДокументаКонфигурации = "Предыдущий титул" Тогда
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика,, СпецСценарий);
		
	Иначе
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий);
		
	КонецЕсли;
	
	РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
		ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий, КонтекстНастройкиКонвертации);
	
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"СписокЗадач_ЗаменитьТекстЗапросаСпискаЗадачИнтеграция", Ложь,
		Новый Структура("РезультатаФормированияЗапроса, ТипЛогистика", РезультатаФормированияЗапроса, ТипЛогистика));
	
	ЗадачиДинамическийСписок.ТекстЗапроса = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
	
	ИмяДокументаЛогистика = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	
	Если Не ЗначениеЗаполнено(ТипДокументаКонфигурации) Тогда
		УстановитьБаннерПроблемы("Настройте конвертацию документов");
		Возврат;
	КонецЕсли;
	
	Попытка
		
		// Проверим, успешно ли соберется запрос - если запрос плохой - то тут будет падение
		//@skip-warning
		ПараметрыДинСписка = ЗадачиДинамическийСписок.Параметры;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗадачи;
		Элементы.ПояснениеОшибки.Заголовок = "";
		ОшибкаНастройкиТекущегоТипа = Ложь;
		Элементы.ЗадачиДинамическийСписок.Видимость = Истина;
		
		Для Каждого ПараметрЗапроса Из РезультатаФормированияЗапроса.СтруктураПараметровЗапроса Цикл
			ТекущийПараметрКомапановки = Новый ПараметрКомпоновкиДанных(ПараметрЗапроса.Ключ);
			Если ЗадачиДинамическийСписок.Параметры.НайтиЗначениеПараметра(ТекущийПараметрКомапановки) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
		КонецЦикла;
		
		ДобавитьОтборыДополнительныхКолонокНаФорму();
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		УстановитьБаннерПроблемы(ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьБаннерПроблемы(Знач ТекстОшибки)
	
	ИмяДокументаЛогистика = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.БаннерНеНастроено;
		Элементы.ПояснениеОшибки.Заголовок = ТекстОшибки;
		ОшибкаНастройкиТекущегоТипа = Истина;
		Элементы.ЗадачиДинамическийСписок.Видимость = Ложь;
		ЗадачиДинамическийСписок.ТекстЗапроса = "Выбрать * Из Документ." + ИмяДокументаЛогистика;
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьДанныеФормы()
	
	УстановитьТипыРеквизитовФормы();
	
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий);
	
	// Установить упорядочивание по Требуемому действию 
	// для исключения того что в новом запросе будет отсутствовать поле, по которому было упорядочивание
	УпорядочитьПоТребуемомуДействию();
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
		Период.ДатаНачала = НачалоДня(ТекущаяДата() - 5 * 24 * 3600);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда 
		Период.ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипыРеквизитовФормы()

	// дополнительно ограничить типы у реквизитов формы
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	// органичить доступ до элементов в зависимость от типа титула
	
	// Эти титулы вводятся по исходному документу учетной системы и для них не нужен предыдущий титул
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул3
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул5
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул7
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул9
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
		ИЛИ ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка
		
		Тогда
		
		// Покажем команды ввода из док 1С учетной системы
		ВводИз1С = Истина;
		
	Иначе // титулы вводятся из предыдущего титула
		
		// Покажем команды ввода из предыдущего титула
		ВводИз1С = Ложь;
		
	КонецЕсли;
	
	ЭтоТРН = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипЛогистика);
	ЭтоПЛ = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика);
	ЭтоЗЗ = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика);
	ЭтоПЭ = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипЛогистика);
	ЭтоЭР = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипЛогистика);
	ЭтоСР = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипЛогистика);
	
	Элементы.УправлениеПодменюВводИзДокумента1С.Видимость = ВводИз1С;
	Элементы.УправлениеПодменюВводИзПредыдущего.Видимость = Не ВводИз1С;
	
	Если КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
		
		КартинкаДействияПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.КартинкаЗначения(Неопределено);
		ЗаголовокКнопкиПоУмолчанию = "Обработать";
		
	ИначеЕсли КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее Тогда
		
		КартинкаДействияПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.КартинкаЗначения(Неопределено);
		ЗаголовокКнопкиПоУмолчанию = "Выполнить";
	
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ЕстьМаппингОтправителяШаблонаВТ1() Тогда
		
		КартинкаДействияПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.КартинкаЗначения(Неопределено);
		ЗаголовокКнопкиПоУмолчанию = "Выполнить";
		
	ИначеЕсли (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
		И (КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного
			Или КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного
			Или КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного
			Или КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного
			Или КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного) Тогда
		
		КартинкаДействияПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.КартинкаЗначения(Неопределено);
		ЗаголовокКнопкиПоУмолчанию = "Выполнить";
		
	ИначеЕсли (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1)
		И КонтекстНастройкиКонвертации.Сценарий
			= Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного Тогда
		
		КартинкаДействияПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.КартинкаЗначения(Неопределено);
		ЗаголовокКнопкиПоУмолчанию = "Выполнить";
		
	Иначе
		
		КартинкаДействияПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.КартинкаЗначения(
			КонтекстНастройкиКонвертации.СценарийПоУмолчанию);
		ЗаголовокКнопкиПоУмолчанию = Строка(КонтекстНастройкиКонвертации.СценарийПоУмолчанию);
		
	КонецЕсли;
	
	Элементы.ФормаВыполнитьДействиеПоУмолчанию.Картинка = КартинкаДействияПоУмолчанию;
	Элементы.ФормаВыполнитьДействиеПоУмолчанию.Заголовок = ЗаголовокКнопкиПоУмолчанию;
	
	Элементы.ФормаВыполнитьДействиеПоУмолчанию.КнопкаПоУмолчанию = Истина;
	
	СколькоАвтоотправок = Справочники.КонтурЛогистика_СценарииАвтоматическойРаботы.СколькоВключеноАвтоотправокПоТипу(ТипЛогистика);
	Если СколькоАвтоотправок = 0 Тогда 
		Элементы.СправочникКонтурЛогистика_СценарииАвтоматическойРаботыОткрытьСписок.Заголовок = "нет автоотправки";
		Элементы.СправочникКонтурЛогистика_СценарииАвтоматическойРаботыОткрытьСписок.Картинка = Новый Картинка;
		Элементы.ГруппаСценарииАвтоматическойРаботы.Видимость = Ложь;
	Иначе
		Элементы.СправочникКонтурЛогистика_СценарииАвтоматическойРаботыОткрытьСписок.Заголовок = "автоотправка " + СколькоАвтоотправок;
		Элементы.СправочникКонтурЛогистика_СценарииАвтоматическойРаботыОткрытьСписок.Картинка = БиблиотекаКартинок.КонтурЛогистика_Робот;
		Элементы.ГруппаСценарииАвтоматическойРаботы.Видимость = Истина;
		
		ОшибкиСценариеАвтоматическойРаботы = РегистрыСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.
			ПредставлениеКоличестваОшибок(ТипЛогистика);
	КонецЕсли;
	
	ОшибкиГСМ = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ПредставлениеКоличестваОшибок(Период, ТипЛогистика);
	
	// Проблемы со строкой поиска из-за программной модификации запроса и невозможности определить поля
	// Ошибка при выполнении запроса. по причине: Невозможно применить элемент отбора в наборе данных...
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
		ЭтоТ1 = Истина;
	Иначе
		ЭтоТ1 = Ложь;
	КонецЕсли;
	
	Элементы.СтрокаПоискаСписка.Видимость = Не ЭтоТ1;
	
	Если ЭтоТ1
		И КонтекстНастройкиКонвертации.ТипДокумента1С <> "Все типы"
		И КонтекстНастройкиКонвертации.ТипДокумента1С <> Неопределено Тогда
		
		ЭтоТ1ПоДокументу1С = Истина;
	Иначе
		ЭтоТ1ПоДокументу1С = Ложь;
	КонецЕсли;
	
	Элементы.ОткрытьСписокИсходныхДокументов.Видимость = ЗначениеЗаполнено(ТипДокументаКонфигурации) 
		И ТипДокументаКонфигурации <> "Предыдущий титул";
	
	МожноДелатьОтказВПодписи = ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02
								Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02;
	
	Если МожноДелатьОтказВПодписи
		И (КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
			Или РольДоступна("КонтурЛогистика_ОтказДокументов")) Тогда
		ФормаОтказатьсяВПодписи = Истина;
	Иначе
		ФормаОтказатьсяВПодписи = Ложь;
	КонецЕсли;
	УстановитьВидимостьЭлемента("ФормаОтказатьсяВПодписи", ФормаОтказатьсяВПодписи);
	
	// команды доступные только для трн
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СоздатьПереадресацию", ЭтоТРН);
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СоздатьПереадресацию1", ЭтоТРН);
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СоздатьЭстафету", ЭтоТРН);
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_СоздатьЭстафету1", ЭтоТРН);
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ВнестиИсправлениеТитула", ЭтоТРН);
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_Создать1ТрнПоВыделенным", ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_Создать1ПлПоВыделенным", ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
	
	// команды доступные только для ЗЗ
	УстановитьВидимостьЭлемента("ФормаВвестиТРНизЗЗ", ЭтоЗЗ);
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.ЕстьНастройкаКонвертации) Тогда
		УстановитьВидимостьДоступностьДополнительныхКолонок(КонтекстНастройкиКонвертации);
	Иначе
		НастроенныеТипыДокументов1СМассив = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(
			ТипЛогистика, СпецСценарий);
		Для Каждого ТипДокумента Из НастроенныеТипыДокументов1СМассив Цикл
			Если Не ЗначениеЗаполнено(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;
			
			КонтекстНастройкиКонвертацииЛок = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				ТипЛогистика, ТипДокумента, СпецСценарий);
			
			// Берем настройки колонок только из первой настройки. Подразумеваем, что они настроены одинаково.
			УстановитьВидимостьДоступностьДополнительныхКолонок(КонтекстНастройкиКонвертацииЛок);
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка") Тогда
		УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СкопироватьТитул", Истина);
	Иначе
		УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СкопироватьТитул", Ложь);
	КонецЕсли;
	
	УстановитьВидимостьДоступностьЭлементовДинамисечкогоСписка(ВводИз1С, ЭтоТ1ПоДокументу1С, ЭтоТРН, ЭтоПЛ, ЭтоЗЗ, ЭтоПЭ, ЭтоЭР, ЭтоСР);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементовДинамисечкогоСписка(ВводИз1С, ЭтоТ1ПоДокументу1С, ЭтоТРН, ЭтоПЛ, ЭтоЗЗ, ЭтоПЭ, ЭтоЭР, ЭтоСР)
	
	Элементы.ЗадачиДинамическийСписокКонтекстноеМенюВводДокументовИзДокумента1С.Видимость = ВводИз1С;
	Элементы.ЗадачиДинамическийСписокКонтекстноеМенюВводДокументовИзПредыдущего.Видимость = Не ВводИз1С;
	ПутиРеквизитовУчетногоДокумента = КонтекстНастройкиКонвертации.ПутиРеквизитовУчетногоДокумента;
	
	// Совместимость с 8.2
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокНомерТрН", Истина);
	КонецЕсли;
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокДокументЭТРН", ЭтоПЭ Или ЭтоСР);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокОрганизация", ЭтоПЭ);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокГруппа2", 
			Не ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2"));
	
	Если ЭтоПЛ Или ЭтоЗЗ Или ЭтоЭР Или ЭтоСР Тогда
		
		УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокПолучатель", Ложь);
		УстановитьВидимостьЭлемента("ОтборГрузополучатель", Ложь);
		
	Иначе
		
		Если (Не ЭтоТ1ПоДокументу1С
			Или ЗначениеЗаполнено(ПутиРеквизитовУчетногоДокумента.ПутьГрузополучатель))
			И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
			И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
			
			ВидимостьПолучатель = Истина;
		Иначе
			ВидимостьПолучатель = Ложь;
		КонецЕсли;
		
		УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокПолучатель", ВидимостьПолучатель);
		УстановитьВидимостьЭлемента("ОтборГрузополучатель", ВидимостьПолучатель);
		
	КонецЕсли;
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтрагент", ЭтоЭР Или ЭтоСР);
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		
		ВидимостьВодителяЛогистика = Истина;
	Иначе
		ВидимостьВодителяЛогистика = Ложь;
	КонецЕсли;
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокВодительЛогистика", ВидимостьВодителяЛогистика);
	
	Если (Не ЭтоТ1ПоДокументу1С Или ЗначениеЗаполнено(ПутиРеквизитовУчетногоДокумента.ПутьВодитель))
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		И Не ЭтоПЭ
		И Не ЭтоЭР
		И Не ЭтоСР Тогда
		
		ВидимостьВодитель = Истина;
	Иначе
		ВидимостьВодитель = Ложь;
	КонецЕсли;
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокВодитель", ВидимостьВодитель);
	
	Если (Не ЭтоТ1ПоДокументу1С Или ЗначениеЗаполнено(ПутиРеквизитовУчетногоДокумента.ПутьТранспортноеСредство))
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
		И Не ЭтоПЭ
		И Не ЭтоЭР
		И Не ЭтоСР Тогда
		
		ВидимостьТС = Истина;
	Иначе
		ВидимостьТС = Ложь;
	КонецЕсли;
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокТранспортноеСредство", ВидимостьТС);
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокСтоимостьБезНДС",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6);
	
	Если (Не ЭтоТ1ПоДокументу1С Или ЗначениеЗаполнено(ПутиРеквизитовУчетногоДокумента.ПутьМестоПогрузки))
		И Не ЭтоПЛ
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2 Тогда
		
		ВидимостьМестоПогрузки = Истина;
		ВидимостьМестоДоставки = Не ЭтоЭР И Не ЭтоСР;
	Иначе
		ВидимостьМестоПогрузки = Ложь;
		ВидимостьМестоДоставки = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокМестоПогрузки", ВидимостьМестоПогрузки);
	УстановитьВидимостьЭлемента("ОтборСкладОтправитель", ВидимостьМестоПогрузки);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокМестоДоставки", ВидимостьМестоДоставки);
	УстановитьВидимостьЭлемента("ОтборСкладПолучатель", ВидимостьМестоДоставки);
	
	Если (Не ЭтоТ1ПоДокументу1С Или ЗначениеЗаполнено(ПутиРеквизитовУчетногоДокумента.ПутьГрузоотправитель)) И Не ЭтоПЛ И Не ЭтоСР Тогда
		ВидимостьОтправитель = Истина;
	Иначе
		ВидимостьОтправитель = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокОтправитель", ВидимостьОтправитель);
	УстановитьВидимостьЭлемента("ОтборГрузоотправитель", ВидимостьОтправитель);
	
	Если (Не ЭтоТ1ПоДокументу1С Или ЗначениеЗаполнено(ПутиРеквизитовУчетногоДокумента.ПутьПеревозчик))
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
		И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5  Тогда
		
		ВидимостьПеревозчик = Истина;
	Иначе
		ВидимостьПеревозчик = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокПеревозчик", ВидимостьПеревозчик);
	УстановитьВидимостьЭлемента("ОтборПеревозчик", ВидимостьПеревозчик);

	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
		
		ВидимостьУчетныйДокумент = Ложь;
	Иначе
		ВидимостьУчетныйДокумент = Истина;
	КонецЕсли;
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокГруппа2", ВидимостьУчетныйДокумент);
	
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокВидПеревозки",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокМедРаботник",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокДатВрПрМО",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокДатаИВремяОформления",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокОтветственныйЗаОформление",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокОдометрРаботник",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокПоказанияОдометра",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02);
	
	Если ЭтоТРН Тогда
		// Документ логистика
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			МестоРасположения = Элементы.ЗадачиДинамическийСписокНомер;
		Иначе
			МестоРасположения = Элементы.ЗадачиДинамическийСписокГруппа3;
		КонецЕсли;
		Элементы.Переместить(Элементы.ЗадачиДинамическийСписокГруппа1, Элементы.ЗадачиДинамическийСписок, МестоРасположения);
	ИначеЕсли ЭтоПЛ Тогда
		// Документ логистика
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			МестоРасположения = Элементы.ЗадачиДинамическийСписокГруппа3;
		Иначе
			МестоРасположения = Элементы.ЗадачиДинамическийСписокНомер;
		КонецЕсли;
		Элементы.Переместить(Элементы.ЗадачиДинамическийСписокГруппа1, Элементы.ЗадачиДинамическийСписок, МестоРасположения);
	КонецЕсли;
	
	// Сортировка колонок
	ЭлементДоп1 = Элементы.Найти("ЗадачиДинамическийСписокДоп1");	// Если есть доп колонки, то перед ними
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодитель", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокТранспортноеСредство", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВидПеревозки", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда		
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодитель", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокМедРаботник", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокДатВрПрМО", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокТранспортноеСредство", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокДатаИВремяОформления", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокОтветственныйЗаОформление", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодитель", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокТранспортноеСредство", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокДатаИВремяОформления", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокОтветственныйЗаОформление", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодитель", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокПоказанияОдометра", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда		
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодитель", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокТранспортноеСредство", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокОдометрРаботник", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокПоказанияОдометра", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда		
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодитель", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокТранспортноеСредство", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокПоказанияОдометра", Элементы.ЗадачиДинамическийСписок, ЭлементДоп1);
	ИначеЕсли ЭтоТРН Тогда
		МестоНазначения = Элементы.Найти("ЗадачиДинамическийСписокМестоПогрузки");
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
			
			ПереместитьЭлементСписка("ЗадачиДинамическийСписокСтоимостьБезНДС", Элементы.ЗадачиДинамическийСписок, МестоНазначения);
		КонецЕсли;
		
		ПереместитьЭлементСписка("ЗадачиДинамическийСписокВодительЛогистика", Элементы.ЗадачиДинамическийСписок, МестоНазначения);
	КонецЕсли;
	
	// Контекстное меню
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ВнестиИсправлениеТитула", ЭтоТРН);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СоздатьПереадресацию", ЭтоТРН);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_СоздатьЭстафету", ЭтоТРН);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ПечатьТранспортнойНакладной",
		ЭтоТРН Или ЭтоПЛ Или ЭтоЭР Или ЭтоПЭ Или ЭтоСР);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ПоказатьПечатнуюФормуТранспортнойНакладной",
		ЭтоТРН Или ЭтоПЛ Или ЭтоЭР Или ЭтоПЭ Или ЭтоСР);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_Создать1ТрнПоВыделенным",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_Создать1ПлПоВыделенным",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_Создать1ЗзПоВыделенным",
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1);
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");
	УстановитьВидимостьЭлемента("ФормаОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы",
		СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы);
	УстановитьВидимостьЭлемента("ЗадачиДинамическийСписокКонтекстноеМенюОбщаяКомандаКонтурЛогистика_ДобавитьПечатнуюФормуЭПДВПрикрепленныеФайлы",
		СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы);
	
	// Отборы ПЛ по реквизитам учетного документа
	УстановитьВидимостьЭлемента("ОтборВодитель", Ложь);
	УстановитьВидимостьЭлемента("ОтборТранспортноеСредство", Ложь);
	УстановитьВидимостьЭлемента("ОтборМедРаботник", Ложь);
	УстановитьВидимостьЭлемента("ОтборОтветственныйЗаОформление", Ложь);
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		СоздатьРеквизитыОтбораСписка("Водитель");
		СоздатьРеквизитыОтбораСписка("ТранспортноеСредство");
		
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборВодитель", "Водитель");
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборТранспортноеСредство", "Транспортное средство");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
		
		СоздатьРеквизитыОтбораСписка("Водитель");
		СоздатьРеквизитыОтбораСписка("МедРаботник");
		
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборВодитель", "Водитель");
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборМедРаботник", "Мед. работник");
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		СоздатьРеквизитыОтбораСписка("ОтветственныйЗаОформление");
		СоздатьРеквизитыОтбораСписка("ТранспортноеСредство");
		
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборОтветственныйЗаОформление", "Тех. работник");
		СоздатьЭлементФормыРеквизитаОтбораСписка("ОтборТранспортноеСредство", "Транспортное средство");
	КонецЕсли;
	
	Если ЭтоЭР Или ЭтоПЭ Или ЭтоСР Тогда
		ЗаголовокОтборПеревозчик = "Экспедитор";
	Иначе
		ЗаголовокОтборПеревозчик = "Перевозчик";
	КонецЕсли;
	УстановитьЗаголовокЭлемента("ОтборПеревозчик", ЗаголовокОтборПеревозчик);
	УстановитьВидимостьЭлемента("ОтборКонтрагент", ЭтоЭР);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыОтбораСписка(ИмяРеквизита)
	
	ИмяРеквизитаФормы = "Отбор" + ИмяРеквизита;
	Для Каждого Реквизит Из ЭтаФорма.ПолучитьРеквизиты() Цикл
		Если Реквизит.Имя = ИмяРеквизитаФормы Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	РезультатПоиска = ЗадачиДинамическийСписок.Отбор.ДоступныеПоляОтбора.Элементы.Найти(ИмяРеквизита);
	Если РезультатПоиска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизит(ЭтаФорма, ИмяРеквизитаФормы, РезультатПоиска.Тип);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементФормыРеквизитаОтбораСписка(ИмяЭлемента, Заголовок)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	Если НайденныйЭлемент <> Неопределено Тогда
		НайденныйЭлемент.Видимость = Истина;
		Возврат;
	КонецЕсли;
	
	СобытияЭФ = Новый Структура;
	СобытияЭФ.Вставить("ПриИзменении", "УстановитьОтборДинСписка");
	
	СвойстваЭФ = Новый Структура;
	СвойстваЭФ.Вставить("КнопкаОчистки", Истина);
	СвойстваЭФ.Вставить("ПодсказкаВвода", "<все>");
	СвойстваЭФ.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Лево);
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздПоле(ЭтаФорма, ИмяЭлемента, Элементы.Группа2,
		Заголовок, 1, ИмяЭлемента, СвойстваЭФ, СобытияЭФ);
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЭлементСписка(ИмяЭлемента, Родитель, Назначение = Неопределено)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	
	Если НайденныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Переместить(НайденныйЭлемент, Родитель, Назначение);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлемента(ИмяЭлемента, ЗначениеВидимости)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	
	Если НайденныйЭлемент = Неопределено Тогда
		Если Не ЗначениеВидимости Тогда
			Возврат;
		КонецЕсли;
		
		// ЭТрН
		Если ИмяЭлемента = "ЗадачиДинамическийСписокСтоимостьБезНДС" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Стоимость перевозки");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокВодительЛогистика" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Водитель");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокВодитель" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Водитель");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокМестоПогрузки" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Место погрузки");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокМестоДоставки" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Место доставки");
		// ЭПЛ
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокВидПеревозки" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Вид перевозки");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокТранспортноеСредство" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Транспортное средство");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокДатаИВремяОформления" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Дата и время техосмотра");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокОтветственныйЗаОформление" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Тех. работник");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокОдометрРаботник" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Ответственный");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокПоказанияОдометра" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Показания одометра");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокМедРаботник" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Мед. работник");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокДатВрПрМО" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Дата и время медосмотра");
		ИначеЕсли ИмяЭлемента = "ЗадачиДинамическийСписокДокументЭТРН" Тогда
			СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, "Маршрут");
		КонецЕсли;
	Иначе
		НайденныйЭлемент.Видимость = ЗначениеВидимости;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокЭлемента(ИмяЭлемента, НовыйЗаголовок)
	
	НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
	
	Если НайденныйЭлемент <> Неопределено Тогда
		
		НайденныйЭлемент.Заголовок = НовыйЗаголовок;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьКолонкуДинамическогоСписка(ИмяЭлемента, ЗаголовокЭлемента)
	
	НовыйЭлемент = Неопределено;
	Префикс = "ЗадачиДинамическийСписок";
	ТипКолонки = 0;
	
	Попытка
		НовыйЭлемент = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(ЭтаФорма, ИмяЭлемента,
			Элементы.ЗадачиДинамическийСписок, ТипКолонки, ЗаголовокЭлемента, СтрЗаменить(ИмяЭлемента, Префикс, Префикс + "."));
	Исключение
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьДоступностьДополнительныхКолонок(КонтекстНастройкиКонвертации)
	
	Если КонтекстНастройкиКонвертации.ДополнительныеКолонки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СпецСценарий <> Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя
		И ТипДокументаКонфигурации <> "Все типы"
		И ТипДокументаКонфигурации <> "Другие" Тогда
		
		НомерСтроки = 0;
		Для Каждого ТекущаяКолонка Из КонтекстНастройкиКонвертации.ДополнительныеКолонки Цикл
			
			НомерСтроки = НомерСтроки + 1;
			НомерКолонки = Формат(НомерСтроки, "ЧГ=0");
			ИмяДопКолонки = "ЗадачиДинамическийСписокДоп" + НомерКолонки;
			ПутьКДанным = "ЗадачиДинамическийСписок.Доп" + НомерКолонки;
			
			НайденныйЭлемент = Элементы.Найти(ИмяДопКолонки);
			Если НайденныйЭлемент <> Неопределено Тогда
				НайденныйЭлемент.Видимость = Истина;
				НайденныйЭлемент.Заголовок = ТекущаяКолонка.Заголовок;
				Продолжить;
			КонецЕсли;
			
			КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКолонкаТаблицыФормы(
				ЭтаФорма, ИмяДопКолонки, Элементы.ЗадачиДинамическийСписок,
				0, ТекущаяКолонка.Заголовок, ПутьКДанным);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Удалим лишние
	Для Счет = (КонтекстНастройкиКонвертации.ДополнительныеКолонки.Количество() + 1) По 99 Цикл
		НомерКолонки = Формат(Счет, "ЧГ=0");
		ИмяДопКолонки = "ЗадачиДинамическийСписокДоп" + НомерКолонки;
		
		НайденныйЭлемент = Элементы.Найти(ИмяДопКолонки);
		Если НайденныйЭлемент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НайденныйЭлемент.Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УпорядочитьПоТребуемомуДействию()
	
	Перем УсловиеСортировки, Элемент, ЭлементыПользовательскихНастроек;
	
	Если ОшибкаНастройкиТекущегоТипа Тогда 
		Возврат;
	КонецЕсли;
	
	ЭлементыПользовательскихНастроек = ЗадачиДинамическийСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Для Каждого Элемент Из ЭлементыПользовательскихНастроек Цикл
		Если ТипЗнч(Элемент) = ТипЗнч(ЗадачиДинамическийСписок.КомпоновщикНастроек.Настройки.Порядок) Тогда
			Элемент.Элементы.Очистить();
			УсловиеСортировки = Элемент.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			УсловиеСортировки.Поле = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
			УсловиеСортировки.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
			УсловиеСортировки.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДинамическогоСписка()
	
	ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
	// Введенные титулы могут по дате отличаться от предыдущих - расширим диапазон анализа текущего документа
	Если ЗадачиДинамическийСписок.Параметры.Элементы.Найти("НачалоПериодаПоследующийТитул") <> Неопределено Тогда 	
		Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
			ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПоследующийТитул", Период.ДатаНачала);
		Иначе
			ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("НачалоПериодаПоследующийТитул", Период.ДатаНачала - 5 * 86400);
		КонецЕсли;
	КонецЕсли;
	
	// Определяем дополнительные параметры запроса в зависимости от типа титула и специального сценария
	ПараметрыСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПараметрыСпискаПоТипуЛогистики(ТипЛогистика, СпецСценарий);
	Для Каждого ТекущийПараметр Из ПараметрыСписка Цикл
		
		УстанавливаемыйПараметр = Новый ПараметрКомпоновкиДанных(ТекущийПараметр.Ключ);
		НайденныйПараметр = ЗадачиДинамическийСписок.Параметры.НайтиЗначениеПараметра(УстанавливаемыйПараметр);
		
		Если НайденныйПараметр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
		
	КонецЦикла;
	
	// Введенные титулы могут по дате отличаться от предыдущих - расширим диапазон анализа текущего документа
	СекундВЧасе = 60 * 60;
	СмещениеОкончанияПериода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СмещениеОкончанияПериодаСпискаЗадач") * СекундВЧасе;
	ОкончаниеПериода = Период.ДатаОкончания + СмещениеОкончанияПериода;
	ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ОкончаниеПериода", ОкончаниеПериода);
	Если ЗадачиДинамическийСписок.Параметры.Элементы.Найти("ОкончаниеПериодаПоследующийТитул") <> Неопределено Тогда
		ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ОкончаниеПериодаПоследующийТитул", ОкончаниеПериода + 5 * 86400);
	КонецЕсли;
	
	Если ЗадачиДинамическийСписок.Параметры.Элементы.Найти("ТекущийПользователь") <> Неопределено Тогда
		ЗадачиДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
 	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКонтент()
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда
		
		УстановитьПараметрыДинамическогоСписка();
		текСинонимДокумента = "";
		Если ТипДокументаКонфигурации <> "Все типы"
			И ТипДокументаКонфигурации <> "Другие" Тогда
			
			текСинонимДокумента = СинонимДокумента1СПоИмени(ТипДокументаКонфигурации);
		Иначе
			текСинонимДокумента = ТипДокументаКонфигурации;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СпецСценарий) Тогда 
			
			Заголовок = "Задачи: " 
					+ ТипЛогистика
					+ " "
					+ СпецСценарий;
		Иначе
			
			Заголовок = "Задачи: " 
					+ ТипЛогистика 
					+ " по " 
					+ текСинонимДокумента;
			
		КонецЕсли;
		
		Элементы.ЗадачиДинамическийСписок.Обновить();
		
		УстановитьВидимостьДоступностьЭлементов();
		ВыполнитьПроверкуАктуальностиГраницы();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокИсходныхДокументов(Команда)
	
	Если ТипДокументаКонфигурации = "Все типы"
		Или ТипДокументаКонфигурации = "Другие" Тогда
		
		ТипыДокументов1СМассив = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(ТипЛогистика);
		
		Для Каждого ВозможныйТипДокументаКонфигурации Из ТипыДокументов1СМассив Цикл
			Если ЗначениеЗаполнено(ВозможныйТипДокументаКонфигурации) Тогда 
				ОткрытьФорму("Документ." + ВозможныйТипДокументаКонфигурации + ".ФормаСписка");
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ОткрытьФорму("Документ." + ТипДокументаКонфигурации + ".ФормаСписка");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНастройкамКонвертации(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_МастерНастройкиСпискаЗадач", Новый Структура("ТипДокументаЛогистика, СпецСценарий", ТипЛогистика, СпецСценарий),
		ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьПереинициализироватьФорму");
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКонфигурацийНачалоВыбораЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(
		ВыбранныйЭлемент.Значение, ЭтаФорма, "ОбработчикОбновитьПереинициализироватьФорму");
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЛогистикаПриИзменении(Элемент = Неопределено)
	
	Если Элемент <> Неопределено И Не ТитулДоступенПользователю(ТипЛогистика) Тогда
		ТекстСообщения = "Вам не доступны документы: " + Строка(ТипЛогистика) + ". Обратитесь к администратору.";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстСообщения);
		
		ТипЛогистика = ТипЛогистикаДоИзменения;
		
		Возврат;
	КонецЕсли;
	
	Если Элемент <> Неопределено Тогда
		// Отключим спец сценарий
		СпецСценарий = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка");
	КонецЕсли;
	
	ОтборДокументыЛогистики.Очистить();
	
	УдалитьИсполняемыеНастройки();
	
	ОбновитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()
	
	ОбработатьНовыйТипДокументаЛогистикаСервер();
	
	Если Не ОшибкаНастройкиТекущегоТипа Тогда 
		ОбновитьКонтент();
		
		ИдентификаторВарианта = ЗаполнитьСписокВыбораВариантовФильтровНаСервере(Истина);
		Если ЗначениеЗаполнено(ИдентификаторВарианта) Тогда
			ПрименитьВариантФильтраПоИдентификатору(ИдентификаторВарианта);
		Иначе
			ТекущийВариантФильтра = "";
			УстановитьОтборДинСписка();
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьБаннерЭкспедиторскихДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьБаннерЭкспедиторскихДокументов()
	
	Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка")
		Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка") Тогда
		
		Элементы.ГруппаБаннерЭкспедиторскиеДокументы.Видимость = Не ДействуютЭкспедиторскиеДокументы;
	Иначе
		Элементы.ГруппаБаннерЭкспедиторскиеДокументы.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборДинСписка()
	
	ЗадачиДинамическийСписок.Отбор.Элементы.Очистить();
	
	Если ОтборДокументыЛогистики.Количество() <> 0 Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ЗадачиДинамическийСписок, "ДокументЛогистика", ОтборДокументыЛогистики,
			ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СпецСценарий) Тогда
		
		КоличествоДопКолонок = КонтекстНастройкиКонвертации.ДополнительныеКолонки.Количество();
		
		Для инд = 1 По КоличествоДопКолонок Цикл
			
			ДопКолонкаИмя = "Доп" + Строка(инд);
			
			Если ЕстьРеквизитФормы("ОтборДопКолонка" + ДопКолонкаИмя) И ЗначениеЗаполнено(ЭтаФорма["ОтборДопКолонка" + ДопКолонкаИмя]) Тогда
				
				ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ДопКолонкаИмя);
				ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборДопКолонка" + ДопКолонкаИмя];
				
				Если ТипЗнч(ЭтаФорма["ОтборДопКолонка" + ДопКолонкаИмя]) = Тип("Строка") Тогда
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
				Иначе
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				КонецЕсли;
				
				ЭлементОтбора.Использование = Истина;
				
			КонецЕсли;
			
		КонецЦикла; 
	
	КонецЕсли;
	
	УстановитьЭлементОтбораСКонвертацией("Отправитель", ОтборГрузоотправитель);
	УстановитьЭлементОтбораСКонвертацией("Перевозчик", ОтборПеревозчик);
	УстановитьЭлементОтбораСКонвертацией("Получатель", ОтборГрузополучатель);
	
	Если ЗначениеЗаполнено(ОтборКонтрагент) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент");
		ЭлементОтбора.ПравоеЗначение = ОтборКонтрагент;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
	УстановитьЭлементОтбораСКонвертацией("МестоПогрузки", ОтборПогрузка);
	УстановитьЭлементОтбораСКонвертацией("МестоДоставки", ОтборВыгрузка);
	
	Если Элементы.Найти("ОтборВодитель") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборВодитель"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Водитель");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборВодитель"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборТранспортноеСредство") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборТранспортноеСредство"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТранспортноеСредство");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборТранспортноеСредство"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборМедРаботник") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборМедРаботник"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МедРаботник");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборМедРаботник"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если Элементы.Найти("ОтборОтветственныйЗаОформление") <> Неопределено И ЗначениеЗаполнено(ЭтаФорма["ОтборОтветственныйЗаОформление"]) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтветственныйЗаОформление");
		ЭлементОтбора.ПравоеЗначение = ЭтаФорма["ОтборОтветственныйЗаОформление"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборТребуемоеДействие) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
		ЭлементОтбора.ПравоеЗначение = ОтборТребуемоеДействие;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	Иначе
		
		Если ОтборСостояние <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Все") Тогда
			
			Если ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.МоиЗадачи") Тогда
				
				Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2")
					Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
					
					ГруппаОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
					ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
					
					ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОсобенностиДокументооборота");
					ЭлементОтбора.Использование = Истина;
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
				Иначе
					ГруппаОтбора = ЗадачиДинамическийСписок.Отбор;
				КонецЕсли;
				
				ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				ЭлементОтбора.ПравоеЗначение = МассивТребуемыхДействийМои();
				
			Иначе
				
				ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуемоеДействие");
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена");
				
				Если ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Активные") Тогда
					
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
					ЭлементОтбора.ПравоеЗначение = МассивТребуемыхДействийАктивные();
					
				ИначеЕсли ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.НаКонтроле") Тогда
					
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
					ЭлементОтбора.ПравоеЗначение = МассивТребуемыхДействийНаКонтроле();
					
				ИначеЕсли ОтборСостояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ОтборыПоСостояниюЗадач.Ошибки") Тогда
					
					ЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки");
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					
				Иначе
					
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе			
		
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ЗадачиДинамическийСписок.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЭлементОтбораСКонвертацией(ПолеЗапроса, ЗначениеОтбора)
	
	Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		
		ЭлементОтбора = ЗадачиДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеЗапроса);
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02")
			Или ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1") Тогда
			
			ЭлементОтбора.ПравоеЗначение = КонтурЛогистика_КонвертацияСервер.ПолучитьСвязанныеОбъекты(ЗначениеОтбора);
			ЭлементОтбора.ПравоеЗначение.Добавить(ЗначениеОтбора);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

