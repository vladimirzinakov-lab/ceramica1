
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Организация", Организация);
	АвтоЗаголовок = Ложь;
	Заголовок = "Подписки и оплата";
	
	УстановитьВидимостьЭлементовФормы();
	
	Если КонтурЛогистика_ПодпискиИОплатаСервер.ПодпискиИОплатаДоступны() Тогда
		
		Элементы.Организация.ПодсказкаВвода = "Все организации";
		ОбновитьТабличныйДокументНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокОрганизаций = АвторизованныеОрганизацииНаСервере();
	
	Если СписокОрганизаций.Количество() = 0 Тогда
		КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок("Нет авторизованных организаций.");
		Возврат;
	КонецЕсли;
	
	Обработчик = Новый ОписаниеОповещения("ОрганизацияНачалоВыбораЗавершение", ЭтаФорма);
	СписокОрганизаций.ПоказатьВыборЭлемента(Обработчик, "Выберите организацию");
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбораЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ВыбранныйЭлемент.Значение;
	ОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОбработатьРасшифровкуТабличногоДокумента(Расшифровка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	СинхронизироватьИОбновитьТабличныйДокументНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьРасшифровкуТабличногоДокумента(Расшифровка)
	
	Если Расшифровка = "ЦентрПоддержки" Тогда
		ЗарегистрироватьМетрикуПомощиНаСервере();
		КонтурЛогистика_ЦентрПоддержкиКлиент.ОткрытьЦентрПоддержки();
		Возврат;
	КонецЕсли;
	
	URLПерехода = URLГиперссылкиОплатыИзРасшифровки(Расшифровка);
	
	Если ЗначениеЗаполнено(URLПерехода) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПерейтиПоСсылке(URLПерехода);
		ЗарегистрироватьМетрикуГиперссылкиОплатыНаСервере(Расшифровка);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Расшифровка) = Тип("Строка")
		И ЗначениеЗаполнено(Расшифровка) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПерейтиПоСсылке(Расшифровка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция URLГиперссылкиОплатыИзРасшифровки(Расшифровка)
	
	Префикс = "ПодпискиИОплата|";
	
	Если ТипЗнч(Расшифровка) <> Тип("Строка")
		Или Не КонтурЛогистика_СтдСтрКлиентСервер.СтрНачинаетсяСЛок(Расшифровка, Префикс) Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(Расшифровка, СтрДлина(Префикс) + 1);
	
	ПозицияТекста = КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(Остаток, "|");
	
	Если ПозицияТекста = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(Остаток, ПозицияТекста + 1);
	
	ПозицияBoxId = КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(Остаток, "|");
	
	Если ПозицияBoxId = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(Остаток, ПозицияBoxId + 1);
	
КонецФункции

&НаСервере
Процедура СинхронизироватьИОбновитьТабличныйДокументНаСервере()
	
	Если Не КонтурЛогистика_ПодпискиИОплатаСервер.ПодпискиИОплатаДоступны() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСинхронизации = Неопределено;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ПараметрыСинхронизации = Новый Структура;
		ПараметрыСинхронизации.Вставить("МассивОрганизаций",
			КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЗначениеВМассивеЛок(Организация));
		
	КонецЕсли;
	
	КонтурЛогистика_ДлительныеОперацииСервер.СинхронизироватьДанныеПодписокИОплатыСОтчетом(
		ПараметрыСинхронизации, Истина);
	ОбновитьТабличныйДокументНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ЗарегистрироватьМетрикуОтбораОрганизацииНаСервере();
	ОбновитьТабличныйДокументНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТабличныйДокументНаСервере()
	
	ТабличныйДокумент = КонтурЛогистика_ПодпискиИОплатаСервер.СформироватьТабличныйДокументПодписокИОплаты(Организация);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АвторизованныеОрганизацииНаСервере()
	
	СписокОрганизаций = Новый СписокЗначений;
	
	Для Каждого Организация Из КонтурЛогистика_ПодпискиИОплатаСервер.АвторизованныеОрганизации() Цикл
		СписокОрганизаций.Добавить(Организация, Строка(Организация));
	КонецЦикла;
	
	Возврат СписокОрганизаций;
	
КонецФункции

&НаСервере
Процедура ЗарегистрироватьМетрикуОтбораОрганизацииНаСервере()
	
	КонтурЛогистика_ПодпискиИОплатаСервер.ЗарегистрироватьМетрикуОтбораОрганизацииНаФорме(Организация);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗарегистрироватьМетрикуГиперссылкиОплатыНаСервере(Расшифровка)
	
	КонтурЛогистика_ПодпискиИОплатаСервер.ЗарегистрироватьМетрикуПереходаПоГиперссылкеОплаты(Расшифровка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗарегистрироватьМетрикуПомощиНаСервере()
	
	КонтурЛогистика_ПодпискиИОплатаСервер.ЗарегистрироватьМетрикуПомощиНаФормеПодписокИОплаты();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	ТестовыйРежим = Не КонтурЛогистика_ПодпискиИОплатаСервер.ПодпискиИОплатаДоступны();
	
	Элементы.ГруппаБаннерТестовыйРежим.Видимость = ТестовыйРежим;
	Элементы.ГруппаОрганизация.Видимость = Не ТестовыйРежим;
	Элементы.ГруппаТабличныйДокумент.Видимость = Не ТестовыйРежим;
	
КонецПроцедуры

#КонецОбласти
