
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивДокументовУчетнойСистемы.ЗагрузитьЗначения(Параметры.МассивДокументовУчетнойСистемы);
	
	ПереформироватьДерево();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ВвестиДокумент"
		Или ИмяСобытия = "КонтурЛогистика_ОбновитьФормуСпискаЗадач"
		Или ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
		Или ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" Тогда
		
		ОбработчикОбновить();
		
	ИначеЕсли ИмяСобытия = "ЗавершениеФоновогоЗадания"
		И Параметр.Свойство("КлючФЗ")
		И Параметр.КлючФЗ = "Выполнение обмена" Тогда
		
		ОбработчикОбновить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоСвязейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекСтрока = ДеревоСвязей.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ДеревоСвязейТребуемоеДействие" Тогда 
		
		Если ТекСтрока.ТребуемоеДействие = "Ввести док. основание для ЭПД" Тогда
			
			ВвестиДокументУчетнойСистемыОснование(ТекСтрока.ДокументОснование, ТекСтрока.ТипУчетногоДляВводаЭПД);
			
		ИначеЕсли ТекСтрока.ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление") Тогда 
			
			ОткрытьЭПДПродолжитьОформление(ТекСтрока);
			
		ИначеЕсли ТекСтрока.ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.Оформить") Тогда
			
			ВвестиЭПДпоТекСтроке(ТекСтрока);
			
		ИначеЕсли ТекСтрока.ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен") Тогда
			
			ВыполнитьОбмен();
			ТекСтрока.ТребуемоеДействие = "Обмен запущен";
			
		Иначе
			Если ЗначениеЗаполнено(ТекСтрока.ДокументЭПД) Тогда 
				ОткрытьЭПДТекСтроки(ТекСтрока);
			Иначе
				// ничего не делаем
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ДеревоСвязейДокументОснование" Тогда
		
		// открыть док
		Если ЗначениеЗаполнено(ТекСтрока.ДокументЭПД) Тогда
			
			ОткрытьЭПДТекСтроки(ТекСтрока);
			
		ИначеЕсли ЗначениеЗаполнено(ТекСтрока.ДокументОснованиеЭПД) Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекСтрока.ДокументОснованиеЭПД);
			
		ИначеЕсли ЗначениеЗаполнено(ТекСтрока.ДокументОснование) Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекСтрока.ДокументОснование);
			
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ДеревоСвязейСтатус" Тогда
		
		Если ТекСтрока.Статус = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НайтиСостояниеДОПоКоду("on-the-way") Тогда 
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ДокументСсылка", ТекСтрока.ДокументЭПД);
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ОтправкаQRКода", ПараметрыОткрытия);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбработчикОбновить();
	
КонецПроцедуры

#КонецОбласти

