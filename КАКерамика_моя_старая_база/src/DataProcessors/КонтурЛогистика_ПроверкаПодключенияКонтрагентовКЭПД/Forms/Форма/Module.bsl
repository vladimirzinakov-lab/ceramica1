
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьЗаголовкиКолонок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокКонтрагентов

&НаКлиенте
Процедура СписокКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.СписокКонтрагентовКонтрагент
		И ЗначениеЗаполнено(ТекущиеДанные.Контрагент) Тогда
		
		СтандартнаяОбработка = Ложь;
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.Контрагент);
		
	ИначеЕсли Поле = Элементы.СписокКонтрагентовОрганизацияДиадок
		И ЗначениеЗаполнено(ТекущиеДанные.ОрганизацияДиадок) Тогда
		
		СтандартнаяОбработка = Ложь;
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.ОрганизацияДиадок);
		
	ИначеЕсли Поле = Элементы.СписокКонтрагентовТекстПровайдера Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ТекущиеДанные.ТекстПровайдера = ТекстГиперссылкиВыбрать() Тогда
			
			ОткрытьФормуВыбораОрганизацииПоИННКПП(ТекущиеДанные);
			
		ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ОрганизацияДиадок) Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ТекущиеДанные.ОрганизацияДиадок);
			
		КонецЕсли;
		
	ИначеЕсли Поле = Элементы.СписокКонтрагентовТекстСтатуса Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ТекущиеДанные.ТекстСтатуса = ТекстГиперссылкиВыбратьЯщикДляОбмена()
			Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекущиеДанные.ТекстСтатуса, ТекстГиперссылкиЗаменитьЯщик()) > 0 Тогда
			
			ОткрытьФормуВыбораОрганизацииПоИННКПП(ТекущиеДанные);
			
		ИначеЕсли КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекущиеДанные.ТекстСтатуса, ТекстГиперссылкиПригласить()) > 0 Тогда
			
			ОткрытьФормуПриглашения(ТекущиеДанные);
			
		КонецЕсли;
		
	Иначе
		// Другие колонки обрабатываются штатно.
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВручную(Команда)
	
	Варианты = ПолучитьВариантыСправочниковДляРучногоДобавленияНаСервере();
	
	Если Варианты.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(, "Не найдены настройки конвертации справочников для перевозчика и грузополучателя.");
		Возврат;
		
	ИначеЕсли Варианты.Количество() = 1 Тогда
		
		ОткрытьФормуВыбораКонтрагентов(Варианты[0]);
		
	Иначе
		
		СписокВыбора = Новый СписокЗначений;
		
		Для Каждого СтрокаВарианта Из Варианты Цикл
			СписокВыбора.Добавить(СтрокаВарианта, СтрокаВарианта.Представление);
		КонецЦикла;
		
		Оповещение = Новый ОписаниеОповещения("ДобавитьВручнуюВыборВариантаЗавершение", ЭтаФорма);
		СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите справочник учётной системы");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьДанныеИЗапуститьСинхронизациюСтатусов();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУчетнымДокументам(Команда)
	
	ЗаполнитьПоУчетнымДокументамНаСервере();
	ОбновитьДанныеИЗапуститьСинхронизациюСтатусов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьЗаголовкиКолонок()
	
	Элементы.СписокКонтрагентовОрганизацияДиадок.Видимость = Ложь;
	Элементы.СписокКонтрагентовТекстПровайдера.Заголовок = "Провайдер для обмена";
	Элементы.СписокКонтрагентовТекстСтатуса.Заголовок = "Статус готовности к ЭПД";
	
КонецПроцедуры

&НаКлиенте
Функция ТекстГиперссылкиВыбрать()
	
	Возврат "Выбрать";
	
КонецФункции

&НаКлиенте
Функция ТекстГиперссылкиПригласить()
	
	Возврат "пригласить";
	
КонецФункции

&НаКлиенте
Функция ТекстГиперссылкиЗаменитьЯщик()
	
	Возврат "заменить ящик";
	
КонецФункции

&НаКлиенте
Функция ТекстГиперссылкиВыбратьЯщикДляОбмена()
	
	Возврат "Выбрать ящик для обмена";
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВручнуюВыборВариантаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуВыбораКонтрагентов(ВыбранныйЭлемент.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораКонтрагентов(Вариант)
	
	ИспользоватьФормуПодбора = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.РежимЗапускаКлиентскогоПриложенияОбычноеПриложение()
		Или КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ОпределитьКонфигурацию() = "КЛ";
	
	Если ИспользоватьФормуПодбора Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИмяСправочника", Вариант.ИмяСправочника);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Обработка.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.Форма.ФормаПодбораКонтрагентов",
			ПараметрыФормы,
			ЭтаФорма,
			ЭтаФорма,
			"ДобавитьВручнуюВыборКонтрагентовЗавершение",
			Вариант,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца,
			Истина);
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
		ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
		
		ПолноеИмяФормыВыбора = "Справочник." + Вариант.ИмяСправочника + ".ФормаВыбора";
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы(
			ПолноеИмяФормыВыбора,
			ПараметрыФормы,
			ЭтаФорма,
			ЭтаФорма,
			"ДобавитьВручнуюВыборКонтрагентовЗавершение",
			Вариант);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВручнуюВыборКонтрагентовЗавершение(Результат, Вариант) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивВыбранных = Новый Массив;
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		МассивВыбранных = Результат;
	Иначе
		МассивВыбранных.Добавить(Результат);
	КонецЕсли;
	
	ДобавитьКонтрагентовВручнуюНаСервере(Вариант.ИмяСправочника, МассивВыбранных, Вариант.Роль);
	ОбновитьДанныеИЗапуститьСинхронизациюСтатусов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораОрганизацииПоИННКПП(ТекущиеДанные)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НеИзменятьИННКПП", Истина);
	ПараметрыФормы.Вставить("ИНН", ТекущиеДанные.ИНН);
	ПараметрыФормы.Вставить("КПП", ТекущиеДанные.КПП);
	
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВыбораПоИННКПП",
		ПараметрыФормы,
		ЭтаФорма,
		ЭтаФорма,
		"ВыборОрганизацииПоИННКППЗавершение",
		ДополнительныеПараметры,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс,
		Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборОрганизацииПоИННКППЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьВыборОрганизацииНаСервере(ДополнительныеПараметры.ИдентификаторСтроки, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПриглашения(ТекущиеДанные)
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ОрганизацияДиадок) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Инициатор", ИнициаторПриглашенияНаСервере());
	ПараметрыФормы.Вставить("Контрагент", ТекущиеДанные.ОрганизацияДиадок);
	ПараметрыФормы.Вставить("ОтправитьУведомлениеПоставитьГотовКЭПД", Истина);
	ПараметрыФормы.Вставить("ОбновитьСтатусГотовКЭПД", Истина);
	
	ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ПриглашениеКОбменуЭПД",
		ПараметрыФормы,
		ЭтаФорма,
		ЭтаФорма,
		"ПриглашениеЗавершение",
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриглашениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьСтрокуПослеПриглашенияНаСервере(ДополнительныеПараметры.ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеИЗапуститьСинхронизациюСтатусов()
	
	МассивОрганизаций = ОбновитьДанныеСтрокНаСервере();
	
	Если МассивОрганизаций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьСинхронизациюСтатусовИзДиадока(МассивОрганизаций);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСинхронизациюСтатусовИзДиадока(МассивОрганизаций)
	
	ПараметрыМетода = Новый Структура("МассивОрганизаций", МассивОрганизаций);
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		"КонтурЛогистика_ДлительныеОперацииСервер.СинхронизироватьРеквизитыОрганизацийИзДиадока",
		ПараметрыМетода,
		"КлючФЗ_ПроверкаКонтрагентовСинхронизацияОрганизаций",
		"Синхронизация реквизитов организаций из Диадока");
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполняется" Тогда
		
		ИдентификаторФЗ_ОбновлениеСтатусов = РезультатЗапуска.ИдентификаторЗадания;
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеОбновленияСтатусов", 0.1, Истина);
		
	ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
		
		ОбновитьДанныеСтрокНаСервере();
		
	Иначе
		// Ошибка или отмена фонового задания — локальные данные уже обновлены.
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеОбновленияСтатусов() Экспорт
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(ИдентификаторФЗ_ОбновлениеСтатусов);
	
	Если ЗаданиеЕщеВыполняется Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеОбновленияСтатусов", 1, Истина);
		
	Иначе
		
		ОбновитьДанныеСтрокНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВариантыСправочниковДляРучногоДобавленияНаСервере()
	
	Возврат Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ПолучитьВариантыСправочниковДляРучногоДобавления();
	
КонецФункции

&НаСервере
Процедура ДобавитьКонтрагентовВручнуюНаСервере(ИмяСправочника, МассивВыбранных, Роль)
	
	Контрагенты = Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.РазвернутьВыборСправочника(
		ИмяСправочника, МассивВыбранных);
	
	ДобавляемыеКонтрагенты = Новый Массив;
	
	Для Каждого Контрагент Из Контрагенты Цикл
		
		Элемент = Новый Структура("Контрагент, Роль", Контрагент, Роль);
		ДобавляемыеКонтрагенты.Добавить(Элемент);
		
	КонецЦикла;
	
	Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ДобавитьКонтрагентов(
		Объект.СписокКонтрагентов, ДобавляемыеКонтрагенты);
	
КонецПроцедуры

&НаСервере
Функция ОбновитьДанныеСтрокНаСервере()
	
	Возврат Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ОбновитьДанныеСтрок(
		Объект.СписокКонтрагентов);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоУчетнымДокументамНаСервере()
	
	Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ЗаполнитьПоУчетнымДокументам(
		Объект.СписокКонтрагентов);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборОрганизацииНаСервере(ИдентификаторСтроки, РезультатВыбора)
	
	СтрокаТаблицы = Объект.СписокКонтрагентов.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы.ОрганизацияДиадок =
		Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ОрганизацияДиадокПоРезультатуВыбора(
			РезультатВыбора);
	
	Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ОбновитьДанныеСтроки(СтрокаТаблицы);
	
КонецПроцедуры

&НаСервере
Функция ИнициаторПриглашенияНаСервере()
	
	Возврат Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ИнициаторПриглашенияПоУмолчанию();
	
КонецФункции

&НаСервере
Процедура ОбновитьСтрокуПослеПриглашенияНаСервере(ИдентификаторСтроки)
	
	СтрокаТаблицы = Объект.СписокКонтрагентов.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Обработки.КонтурЛогистика_ПроверкаПодключенияКонтрагентовКЭПД.ОбновитьДанныеСтроки(СтрокаТаблицы);
	
КонецПроцедуры

#КонецОбласти
