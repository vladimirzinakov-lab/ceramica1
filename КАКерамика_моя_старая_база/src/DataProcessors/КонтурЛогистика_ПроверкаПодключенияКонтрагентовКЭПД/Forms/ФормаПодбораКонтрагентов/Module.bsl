
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("ИмяСправочника")
		Или Не ЗначениеЗаполнено(Параметры.ИмяСправочника) Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	ИмяСправочника = Параметры.ИмяСправочника;
	
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Заголовок = МетаданныеСправочника.Синоним;
	ЗаполнитьСписокКонтрагентов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДоступностьОтметитьВыделенные();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокКонтрагентов

&НаКлиенте
Процедура СписокКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.СписокКонтрагентовПометка Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные.Пометка = Не ТекущиеДанные.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентовПриАктивизацииСтроки(Элемент)
	
	ОбновитьДоступностьОтметитьВыделенные();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	МассивВыбранных = Новый Массив;
	
	Для Каждого СтрокаСписка Из СписокКонтрагентов Цикл
		
		Если СтрокаСписка.Пометка Тогда
			МассивВыбранных.Добавить(СтрокаСписка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивВыбранных.Количество() = 0 Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Отметьте хотя бы одного контрагента.");
		Возврат;
	КонецЕсли;
	
	Закрыть(МассивВыбранных);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенные(Команда)
	
	ВыделенныеСтроки = Элементы.СписокКонтрагентов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		
		СтрокаСписка = СписокКонтрагентов.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаСписка <> Неопределено Тогда
			СтрокаСписка.Пометка = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	УстановитьПометкиСтрок(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсе(Команда)
	
	УстановитьПометкиСтрок(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьДоступностьОтметитьВыделенные()
	
	Элементы.ОтметитьВыделенные.Доступность =
		Элементы.СписокКонтрагентов.ВыделенныеСтроки.Количество() > 0;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиСтрок(ЗначениеПометки)
	
	Для Каждого СтрокаСписка Из СписокКонтрагентов Цикл
		СтрокаСписка.Пометка = ЗначениеПометки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКонтрагентов()
	
	СписокКонтрагентов.Очистить();
	
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьИНН = МетаданныеСправочника.Реквизиты.Найти("ИНН") <> Неопределено;
	
	ИсключатьГруппы = МетаданныеСправочника.Иерархический;
	Если ИсключатьГруппы
		И Строка(МетаданныеСправочника.ВидИерархии) = "ИерархияЭлементов" Тогда
		
		ИсключатьГруппы = Ложь;
		
	КонецЕсли;
	
	ТекстПоляИНН = """""";
	Если ЕстьИНН Тогда
		ТекстПоляИНН = "СправочникКонтрагентов.ИНН";
	КонецЕсли;
	
	ТекстОтбораГрупп = "";
	Если ИсключатьГруппы Тогда
		ТекстОтбораГрупп = "
		|	И НЕ СправочникКонтрагентов.ЭтоГруппа";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникКонтрагентов.Ссылка КАК Ссылка,
	|	СправочникКонтрагентов.Наименование КАК Наименование,
	|	" + ТекстПоляИНН + " КАК ИНН
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК СправочникКонтрагентов
	|ГДЕ
	|	НЕ СправочникКонтрагентов.ПометкаУдаления" + ТекстОтбораГрупп + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = СписокКонтрагентов.Добавить();
		НоваяСтрока.Ссылка = Выборка.Ссылка;
		НоваяСтрока.Наименование = Выборка.Наименование;
		НоваяСтрока.ИНН = Выборка.ИНН;
		
	КонецЦикла;
	
	Элементы.СписокКонтрагентовИНН.Видимость = ЕстьИНН;
	
КонецПроцедуры

#КонецОбласти
