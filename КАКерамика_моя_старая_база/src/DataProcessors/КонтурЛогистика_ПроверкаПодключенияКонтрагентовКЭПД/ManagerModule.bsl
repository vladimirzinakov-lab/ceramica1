Функция ЭтоСтатусНеПодтвердил(СтатусГотовностиКЭПД)
	
	Возврат СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UnknownEpdStatus
		Или СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UndefinedEpdStatus;
	
КонецФункции

Функция РольПоРеквизитуТитулаНКС(РеквизитТитула)
	
	Если РеквизитТитула = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.Перевозчик") Тогда
		Возврат "Перевозчик";
	ИначеЕсли РеквизитТитула = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_РеквизитыТитуловДляНастроекКонвертацииСправочников.Грузополучатель") Тогда
		Возврат "Грузополучатель";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция НайтиВариантСправочника(Варианты, ИмяСправочника, Роль)
	
	Для Каждого Вариант Из Варианты Цикл
		Если Вариант.ИмяСправочника = ИмяСправочника И Вариант.Роль = Роль Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьВариантСправочникаПоИмени(Варианты, ИмяСправочника)
	
	Для Каждого Вариант Из Варианты Цикл
		Если Вариант.ИмяСправочника = ИмяСправочника Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьВариантСправочникаЕслиВозможно(Варианты, ИмяСправочника, Роль, ТолькоЕслиИмениЕщеНет = Ложь)
	
	Если Не ЗначениеЗаполнено(ИмяСправочника) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТолькоЕслиИмениЕщеНет Тогда
		Если ЕстьВариантСправочникаПоИмени(Варианты, ИмяСправочника) Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли НайтиВариантСправочника(Варианты, ИмяСправочника, Роль) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вариант = Новый Структура;
	Вариант.Вставить("ИмяСправочника", ИмяСправочника);
	Вариант.Вставить("Роль", Роль);
	
	Если ЗначениеЗаполнено(Роль) Тогда
		Вариант.Вставить("Представление", КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			"%1 (%2)", МетаданныеСправочника.Синоним, Роль));
	Иначе
		Вариант.Вставить("Представление", Строка(МетаданныеСправочника.Синоним));
	КонецЕсли;
	
	Варианты.Добавить(Вариант);
	
КонецПроцедуры

Функция НайтиСтрокуПоКонтрагенту(ТаблицаКонтрагентов, Контрагент)
	
	Для Каждого СтрокаТаблицы Из ТаблицаКонтрагентов Цикл
		Если СтрокаТаблицы.Контрагент = Контрагент Тогда
			Возврат СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОбъединитьРоли(ТекущаяРоль, НоваяРоль)
	
	НоваяРоль = СокрЛП(НоваяРоль);
	
	Если Не ЗначениеЗаполнено(НоваяРоль) Тогда
		Возврат ТекущаяРоль;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяРоль) Тогда
		Возврат НоваяРоль;
	КонецЕсли;
	
	Роли = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ТекущаяРоль, ",");
	
	Для Каждого ТекущаяРольСтрока Из Роли Цикл
		Если СокрЛП(ТекущаяРольСтрока) = НоваяРоль Тогда
			Возврат ТекущаяРоль;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекущаяРоль + ", " + НоваяРоль;
	
КонецФункции

Процедура ЗаполнитьПровайдерИСтатусСтроки(СтрокаТаблицы)
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ОрганизацияДиадок) Тогда
		
		РеквизитыОрганизации = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			СтрокаТаблицы.ОрганизацияДиадок, "Провайдер, СтатусГотовностиКЭПД");
		
		СтрокаТаблицы.Провайдер = РеквизитыОрганизации.Провайдер;
		СтрокаТаблицы.СтатусГотовностиКЭПД = РеквизитыОрганизации.СтатусГотовностиКЭПД;
		СтрокаТаблицы.ТекстПровайдера = РеквизитыОрганизации.Провайдер;
		
		Если РеквизитыОрганизации.Провайдер = ТекстПровайдераНеУчастникОбмена() Тогда
			СтрокаТаблицы.ТекстСтатуса = ТекстГиперссылкиВыбратьЯщикДляОбмена();
		ИначеЕсли РеквизитыОрганизации.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.Ready Тогда
			СтрокаТаблицы.ТекстСтатуса = Строка(РеквизитыОрганизации.СтатусГотовностиКЭПД);
		ИначеЕсли РеквизитыОрганизации.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.NotReady Тогда
			СтрокаТаблицы.ТекстСтатуса = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1, %2",
				Строка(РеквизитыОрганизации.СтатусГотовностиКЭПД),
				ТекстГиперссылкиЗаменитьЯщик());
		ИначеЕсли ЭтоСтатусНеПодтвердил(РеквизитыОрганизации.СтатусГотовностиКЭПД)
			И РеквизитыОрганизации.Провайдер <> "Контур" Тогда
			СтрокаТаблицы.ТекстСтатуса = ТекстСтатусаНеизвестноРоуминг();
		Иначе
			СтрокаТаблицы.ТекстСтатуса = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1, %2",
				Строка(РеквизитыОрганизации.СтатусГотовностиКЭПД),
				ТекстГиперссылкиПригласить());
		КонецЕсли;
		
	Иначе
		
		СтрокаТаблицы.Провайдер = "";
		СтрокаТаблицы.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UnknownEpdStatus;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИНН) Тогда
			СтрокаТаблицы.ТекстПровайдера = ТекстГиперссылкиВыбрать();
		Иначе
			СтрокаТаблицы.ТекстПровайдера = "";
		КонецЕсли;
		
		СтрокаТаблицы.ТекстСтатуса = "";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОрганизациюВМассив(МассивОрганизаций, ОрганизацияДиадок)
	
	Если Не ЗначениеЗаполнено(ОрганизацияДиадок) Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивОрганизаций.Найти(ОрганизацияДиадок) = Неопределено Тогда
		МассивОрганизаций.Добавить(ОрганизацияДиадок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСсылкуВРезультат(Результат, УникальныеСсылки, Ссылка)
	
	Если УникальныеСсылки[Ссылка] = Неопределено Тогда
		УникальныеСсылки.Вставить(Ссылка, Истина);
		Результат.Добавить(Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоКонтрагентУчетнойСистемы(Контрагент)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СсылкаЯвляетсяГруппой(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипКонтрагента = ТипЗнч(Контрагент);
	
	ОпределяемыйТипОрганизацияКонтрагент = Метаданные.ОпределяемыеТипы.Найти("КонтурЛогистика_ОрганизацияКонтрагент");
	
	Если ОпределяемыйТипОрганизацияКонтрагент <> Неопределено Тогда
		
		ОписаниеТиповКонтрагента = Новый ОписаниеТипов(ОпределяемыйТипОрганизацияКонтрагент.Тип);
		Возврат ОписаниеТиповКонтрагента.СодержитТип(ТипКонтрагента);
		
	КонецЕсли;
	
	ПоддерживаемыеТипы = КонтурЛогистика_КонвертацияСерверПовтИсп.ПоддерживаемыеТипыСправочниковКонфигурации1С(
		"КонтурЛогистика_ОрганизацииДиадок");
	
	Для Каждого ИмяСправочника Из ПоддерживаемыеТипы Цикл
		
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипКонтрагента = Тип("СправочникСсылка." + ИмяСправочника) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьКонтрагентовИзУчетныхДокументов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Роль");
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Счетчик = Новый Соответствие;
	ДатаНачала = НачалоДня(ТекущаяДатаСеанса()) - 5184000;
	
	ПравилаКонвертации = ПолучитьПравилаКонвертацииТрНТитул1();
	СообщитьИспользованныеПравилаЗаполнения(ПравилаКонвертации);
	
	Для Каждого СтрокаПравила Из ПравилаКонвертации Цикл
		
		Роль = СтрокаПравила.РеквизитТитула;
		
		Если ЭтоПростойПутьКРеквизиту(СтрокаПравила) Тогда
			ДобавитьКонтрагентовИзЗапроса(
				Счетчик, СтрокаПравила.ТипДокумента1С, СокрЛП(Строка(СтрокаПравила.ВыражениеВычисления)), Роль, ДатаНачала);
		Иначе
			ДобавитьКонтрагентовИтерацией(Счетчик, СтрокаПравила, Роль, ДатаНачала);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементСчетчика Из Счетчик Цикл
		
		ДанныеКонтрагента = ЭлементСчетчика.Значение;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Контрагент = ДанныеКонтрагента.Контрагент;
		НоваяСтрока.Роль = ДанныеКонтрагента.Роль;
		НоваяСтрока.Количество = ДанныеКонтрагента.Количество;
		
	КонецЦикла;
	
	Результат.Сортировать("Количество Убыв");
	
	Возврат Результат;
	
КонецФункции

Процедура СообщитьИспользованныеПравилаЗаполнения(ПравилаКонвертации)
	
	Если ПравилаКонвертации.Количество() = 0 Тогда
		Сообщить("Заполнение по учётным документам: не найдены настройки конвертации ТрН_Титул1 для ролей Перевозчик и Грузополучатель.");
		Возврат;
	КонецЕсли;
	
	РеквизитыПоТипам = Новый Соответствие;
	ПорядокТипов = Новый Массив;
	
	Для Каждого СтрокаПравила Из ПравилаКонвертации Цикл
		
		ТипДокумента = СтрокаПравила.ТипДокумента1С;
		
		Если Не ЗначениеЗаполнено(ТипДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыТипа = РеквизитыПоТипам[ТипДокумента];
		
		Если РеквизитыТипа = Неопределено Тогда
			РеквизитыТипа = Новый Массив;
			РеквизитыПоТипам.Вставить(ТипДокумента, РеквизитыТипа);
			ПорядокТипов.Добавить(ТипДокумента);
		КонецЕсли;
		
		ИмяРеквизитаУС = СокрЛП(Строка(СтрокаПравила.ВыражениеВычисления));
		Если Не ЗначениеЗаполнено(ИмяРеквизитаУС) Тогда
			ИмяРеквизитаУС = Строка(СтрокаПравила.СпособМаппинга);
		КонецЕсли;
		
		РеквизитыТипа.Добавить(КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1 ← %2", СтрокаПравила.РеквизитТитула, ИмяРеквизитаУС));
		
	КонецЦикла;
	
	СтрокиСообщения = Новый Массив;
	СтрокиСообщения.Добавить("Заполнение по учётным документам. Используются типы документов и реквизиты:");
	
	Для Каждого ТипДокумента Из ПорядокТипов Цикл
		
		ПредставлениеТипа = ПредставлениеТипаДокументаУС(ТипДокумента);
		РеквизитыСтрокой = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(
			РеквизитыПоТипам[ТипДокумента], "; ");
		СтрокиСообщения.Добавить(КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("• %1: %2", ПредставлениеТипа, РеквизитыСтрокой));
		
	КонецЦикла;
	
	Сообщить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(СтрокиСообщения, Символы.ПС));
	
КонецПроцедуры

Функция ПредставлениеТипаДокументаУС(ТипДокумента1С)
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента1С);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат Строка(ТипДокумента1С);
	КонецЕсли;
	
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1 (%2)", МетаданныеДокумента.Синоним, ТипДокумента1С);
	
КонецФункции

Функция ПолучитьПравилаКонвертацииТрНТитул1()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Ссылка КАК НастройкаКонвертации,
	|	Настройки.ТипДокумента1С КАК ТипДокумента1С,
	|	Правила.РеквизитТитула КАК РеквизитТитула,
	|	Правила.СпособМаппинга КАК СпособМаппинга,
	|	Правила.ВыражениеВычисления КАК ВыражениеВычисления
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК Настройки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПравилаКонвертацииГлавногоДокумента КАК Правила
	|		ПО Настройки.Ссылка = Правила.Ссылка
	|ГДЕ
	|	НЕ Настройки.ПометкаУдаления
	|	И Настройки.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И Правила.РеквизитТитула В (&РеквизитыТитула)
	|	И Правила.СпособМаппинга <> &СпособНеЗаполнять";
	
	Запрос.УстановитьПараметр("ТипДокументаЛогистика",
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
	
	РеквизитыТитула = Новый Массив;
	РеквизитыТитула.Добавить("Перевозчик");
	РеквизитыТитула.Добавить("Грузополучатель");
	Запрос.УстановитьПараметр("РеквизитыТитула", РеквизитыТитула);
	Запрос.УстановитьПараметр("СпособНеЗаполнять",
		Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять);
	
	ПравилаКонвертации = Запрос.Выполнить().Выгрузить();
	
	Если ПравилаКонвертации.Количество() = 0 Тогда
		ДополнитьПравилаТиповымиПутямиДокументов(ПравилаКонвертации);
	КонецЕсли;
	
	Возврат ПравилаКонвертации;
	
КонецФункции

Процедура ДополнитьПравилаТиповымиПутямиДокументов(ПравилаКонвертации)
	
	ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
	
	ТипыДокументов = КонтурЛогистика_КонвертацияСерверПовтИсп.ПоддерживаемыеТипыДокументовКонфигурации1С(
		ТипДокументаЛогистика, Неопределено);
	
	СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования;
	
	Для Каждого ТипДокумента1С Из ТипыДокументов Цикл
		
		Если Метаданные.Документы.Найти(ТипДокумента1С) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Контекст = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипДокументаЛогистика, ТипДокумента1С);
		
		Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
		
		ДобавитьТиповоеПравилоВТаблицу(
			ПравилаКонвертации, ТипДокумента1С, "Перевозчик", Пути.ПутьПеревозчик, СпособМаппинга);
		ДобавитьТиповоеПравилоВТаблицу(
			ПравилаКонвертации, ТипДокумента1С, "Грузополучатель", Пути.ПутьГрузополучатель, СпособМаппинга);
		
		Если Не ЗначениеЗаполнено(Пути.ПутьПеревозчик) Тогда
			ДобавитьТиповоеПравилоПоИмениРеквизита(
				ПравилаКонвертации, ТипДокумента1С, "Перевозчик", "Перевозчик", СпособМаппинга);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Пути.ПутьГрузополучатель) Тогда
			Если Не ДобавитьТиповоеПравилоПоИмениРеквизита(
				ПравилаКонвертации, ТипДокумента1С, "Грузополучатель", "Грузополучатель", СпособМаппинга) Тогда
				
				ДобавитьТиповоеПравилоПоИмениРеквизита(
					ПравилаКонвертации, ТипДокумента1С, "Грузополучатель", "Контрагент", СпособМаппинга);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТиповоеПравилоВТаблицу(ПравилаКонвертации, ТипДокумента1С, РеквизитТитула, Путь, СпособМаппинга)
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ПравилаКонвертации.Добавить();
	НоваяСтрока.НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка();
	НоваяСтрока.ТипДокумента1С = ТипДокумента1С;
	НоваяСтрока.РеквизитТитула = РеквизитТитула;
	НоваяСтрока.СпособМаппинга = СпособМаппинга;
	НоваяСтрока.ВыражениеВычисления = Путь;
	
КонецПроцедуры

Функция ДобавитьТиповоеПравилоПоИмениРеквизита(ПравилаКонвертации, ТипДокумента1С, РеквизитТитула, ИмяРеквизита, СпособМаппинга)
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента1С);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДобавитьТиповоеПравилоВТаблицу(ПравилаКонвертации, ТипДокумента1С, РеквизитТитула, ИмяРеквизита, СпособМаппинга);
	Возврат Истина;
	
КонецФункции

Функция ЭтоПростойПутьКРеквизиту(СтрокаПравила)
	
	Если СтрокаПравила.СпособМаппинга <> Перечисления.КонтурЛогистика_СпособыМаппингаПоля.РеквизитДокументаОснования Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Путь = СокрЛП(Строка(СтрокаПравила.ВыражениеВычисления));
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ВРег(Путь), "ВЫБОР") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(Путь, ".") > 0
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(Путь, "[") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеДокумента = Метаданные.Документы.Найти(СтрокаПравила.ТипДокумента1С);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат МетаданныеДокумента.Реквизиты.Найти(Путь) <> Неопределено;
	
КонецФункции

Процедура ДобавитьКонтрагентовИзЗапроса(Счетчик, ТипДокумента1С, ИмяРеквизита, Роль, ДатаНачала)
	
	Если Не ЗначениеЗаполнено(ТипДокумента1С) Или Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКонтрагентовПоВыражениюЗапросом(Счетчик, ТипДокумента1С, "Документ." + ИмяРеквизита, Роль, ДатаНачала);
	
КонецПроцедуры

Процедура ДобавитьКонтрагентовПоВыражениюЗапросом(Счетчик, ТипДокумента1С, ВыражениеКонтрагента, Роль, ДатаНачала)
	
	Если Не ЗначениеЗаполнено(ТипДокумента1С) Или Не ЗначениеЗаполнено(ВыражениеКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
		"ВЫБРАТЬ
		|	%2 КАК Контрагент,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Документ.Ссылка) КАК Количество
		|ИЗ
		|	Документ.%1 КАК Документ
		|ГДЕ
		|	Документ.Дата >= &ДатаНачала
		|	И НЕ Документ.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	%2",
		ТипДокумента1С,
		ВыражениеКонтрагента);
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		УчестьКонтрагента(Счетчик, Выборка.Контрагент, Роль, Выборка.Количество);
	КонецЦикла;
	
КонецПроцедуры

Функция ВыражениеКонтрагентаДляЗапроса(ТипДокумента1С, Путь)
	
	Путь = СокрЛП(Строка(Путь));
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;
	
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ВРег(Путь), "ВЫБОР") > 0 Тогда
		Возврат СтрЗаменить(Путь, ТипДокумента1С + ".", "Документ.");
	КонецЕсли;
	
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(Путь, "Документ.") = 1 Тогда
		Возврат Путь;
	КонецЕсли;
	
	Возврат "Документ." + Путь;
	
КонецФункции

Процедура ДобавитьКонтрагентовИтерацией(Счетчик, СтрокаПравила, Роль, ДатаНачала)
	
	Если Не ЗначениеЗаполнено(СтрокаПравила.ТипДокумента1С) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаПравила.НастройкаКонвертации) Тогда
		
		ВыражениеКонтрагента = ВыражениеКонтрагентаДляЗапроса(
			СтрокаПравила.ТипДокумента1С, СтрокаПравила.ВыражениеВычисления);
		ДобавитьКонтрагентовПоВыражениюЗапросом(
			Счетчик, СтрокаПравила.ТипДокумента1С, ВыражениеКонтрагента, Роль, ДатаНачала);
		Возврат;
		
	КонецЕсли;
	
	НастройкаКонвертации = СтрокаПравила.НастройкаКонвертации.ПолучитьОбъект();
	ПравилоКонвертации = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти(
		СтрокаПравила.РеквизитТитула, "РеквизитТитула");
	
	Если ПравилоКонвертации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
		"ВЫБРАТЬ
		|	Документ.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.%1 КАК Документ
		|ГДЕ
		|	Документ.Дата >= &ДатаНачала
		|	И НЕ Документ.ПометкаУдаления",
		СтрокаПравила.ТипДокумента1С);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат;
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		
		РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			Выборка.Ссылка, ПравилоКонвертации, НастройкаКонвертации);
		
		Если РезультатВычисления.Успешно Тогда
			УчестьКонтрагента(Счетчик, РезультатВычисления.Значение, Роль, 1);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УчестьКонтрагента(Счетчик, Контрагент, Роль, Количество)
	
	Если Не ЭтоКонтрагентУчетнойСистемы(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Ключ = Строка(Контрагент.УникальныйИдентификатор()) + "|" + Роль;
	ДанныеКонтрагента = Счетчик[Ключ];
	
	Если ДанныеКонтрагента = Неопределено Тогда
		
		ДанныеКонтрагента = Новый Структура("Контрагент, Роль, Количество", Контрагент, Роль, 0);
		Счетчик.Вставить(Ключ, ДанныеКонтрагента);
		
	КонецЕсли;
	
	ДанныеКонтрагента.Количество = ДанныеКонтрагента.Количество + Количество;
	
КонецПроцедуры

Функция СсылкаЯвляетсяГруппой(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	
	Если Не Метаданные.Справочники.Содержит(МетаданныеОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не МетаданныеОбъекта.Иерархический Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(Ссылка, "ЭтоГруппа") = Истина;
	
КонецФункции

#КонецОбласти

#КонецЕсли
