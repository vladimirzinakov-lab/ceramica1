#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Добавляет контрагентов в таблицу формы с объединением ролей и без дублей по ссылке.
//
Процедура ДобавитьКонтрагентов(ТаблицаКонтрагентов, ДобавляемыеКонтрагенты) Экспорт
	
	Для Каждого Элемент Из ДобавляемыеКонтрагенты Цикл
		
		Если Не ЗначениеЗаполнено(Элемент.Контрагент) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЭтоКонтрагентУчетнойСистемы(Элемент.Контрагент) Тогда
			Продолжить;
		КонецЕсли;
		
		НайденнаяСтрока = НайтиСтрокуПоКонтрагенту(ТаблицаКонтрагентов, Элемент.Контрагент);
		
		Если НайденнаяСтрока = Неопределено Тогда
			
			НоваяСтрока = ТаблицаКонтрагентов.Добавить();
			НоваяСтрока.Контрагент = Элемент.Контрагент;
			НоваяСтрока.Роль = СокрЛП(Элемент.Роль);
			ОбновитьДанныеСтроки(НоваяСтрока, Истина);
			
		Иначе
			
			НайденнаяСтрока.Роль = ОбъединитьРоли(НайденнаяСтрока.Роль, Элемент.Роль);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Пересчитывает ИНН, КПП, организацию Диадок, провайдера и статус для всех строк таблицы.
//
Функция ОбновитьДанныеСтрок(ТаблицаКонтрагентов) Экспорт
	
	МассивОрганизаций = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ТаблицаКонтрагентов Цикл
		ОбновитьДанныеСтроки(СтрокаТаблицы);
		ДобавитьОрганизациюВМассив(МассивОрганизаций, СтрокаТаблицы.ОрганизацияДиадок);
	КонецЦикла;
	
	Возврат МассивОрганизаций;
	
КонецФункции

// Пересчитывает данные одной строки таблицы.
//
// Параметры:
//  СтрокаТаблицы - СтрокаТаблицыЗначений
//  ПытатьсяПодставитьОрганизациюИзДиадока - Булево - при отсутствии организации в справочнике
//    запросить ящики в Диадоке и подставить единственный с ReadyForEpdStatus = Ready
//
Процедура ОбновитьДанныеСтроки(СтрокаТаблицы, ПытатьсяПодставитьОрганизациюИзДиадока = Ложь) Экспорт
	
	ИННКПП = ПолучитьИННКППКонтрагента(СтрокаТаблицы.Контрагент);
	СтрокаТаблицы.ИНН = ИННКПП.ИНН;
	СтрокаТаблицы.КПП = ИННКПП.КПП;
	
	СтрокаТаблицы.ОрганизацияДиадок = НайтиОрганизациюДиадок(СтрокаТаблицы.ИНН, СтрокаТаблицы.КПП);
	
	Если ПытатьсяПодставитьОрганизациюИзДиадока
		И Не ЗначениеЗаполнено(СтрокаТаблицы.ОрганизацияДиадок) Тогда
		
		СтрокаТаблицы.ОрганизацияДиадок = ПодставитьОрганизациюДиадокИзДиадока(
			СтрокаТаблицы.ИНН, СтрокаТаблицы.КПП);
		
	КонецЕсли;
	
	ЗаполнитьПровайдерИСтатусСтроки(СтрокаТаблицы);
	
КонецПроцедуры

// Возвращает ИНН и КПП контрагента учётной системы из реквизитов справочника.
//
Функция ПолучитьИННКППКонтрагента(Контрагент) Экспорт
	
	Результат = Новый Структура("ИНН, КПП", "", "");
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИменаРеквизитов = "ИНН, КПП";
	ЗначенияРеквизитов = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		Контрагент, ИменаРеквизитов, Истина);
	
	Если ЗначенияРеквизитов.Свойство("ИНН") Тогда
		Результат.ИНН = СокрЛП(Строка(ЗначенияРеквизитов.ИНН));
	КонецЕсли;
	
	Если ЗначенияРеквизитов.Свойство("КПП") Тогда
		Результат.КПП = СокрЛП(Строка(ЗначенияРеквизитов.КПП));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет организацию Диадок по ИНН и КПП (первая из найденных).
//
Функция НайтиОрганизациюДиадок(ИНН, КПП) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(ИНН, КПП);
	
КонецФункции

// Запрашивает ящики контрагента в Диадоке и подставляет единственный с ReadyForEpdStatus = Ready.
//
Функция ПодставитьОрганизациюДиадокИзДиадока(ИНН, КПП)
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Данные = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganizationsByInnKpp(ИНН, КПП);
	Исключение
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Organizations") Тогда
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	КонецЕсли;
	
	ОрганизацииReady = Новый Массив;
	
	Для Каждого ДанныеОрганизации Из Данные.Organizations Цикл
		
		Если ДанныеОрганизации.ReadyForEpdStatus = "Ready" Тогда
			ОрганизацииReady.Добавить(ДанныеОрганизации);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОрганизацииReady.Количество() <> 1 Тогда
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(ОрганизацииReady[0]);
	
КонецФункции

// Заполняет таблицу контрагентами из учётных документов за последние 60 дней.
//
Процедура ЗаполнитьПоУчетнымДокументам(ТаблицаКонтрагентов) Экспорт
	
	КонтрагентыСЧастотой = ПолучитьКонтрагентовИзУчетныхДокументов();
	
	ДобавляемыеКонтрагенты = Новый Массив;
	
	Для Каждого СтрокаКонтрагента Из КонтрагентыСЧастотой Цикл
		
		Элемент = Новый Структура("Контрагент, Роль");
		Элемент.Контрагент = СтрокаКонтрагента.Контрагент;
		Элемент.Роль = СтрокаКонтрагента.Роль;
		ДобавляемыеКонтрагенты.Добавить(Элемент);
		
	КонецЦикла;
	
	ДобавитьКонтрагентов(ТаблицаКонтрагентов, ДобавляемыеКонтрагенты);
	
КонецПроцедуры

// Возвращает варианты справочников УС для ручного добавления (массив структур для передачи на клиент).
// Источники (по порядку, без дублей по имени справочника):
//  1) НКС для КонтурЛогистика_ОрганизацииДиадок;
//  2) поддерживаемые типы текущей конфигурации;
//  3) типы из определяемого типа КонтурЛогистика_ОрганизацияКонтрагент.
//
Функция ПолучитьВариантыСправочниковДляРучногоДобавления() Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Настройки.ТипСправочникаИлиДокументаУС КАК ИмяСправочника,
	|	Настройки.РеквизитТитула КАК РеквизитТитула
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников КАК Настройки
	|ГДЕ
	|	НЕ Настройки.ПометкаУдаления
	|	И Настройки.ТипСправочникаЛогистика = &ТипСправочникаЛогистика
	|	И Настройки.ТипСправочникаИлиДокументаУС <> """"";
	
	Запрос.УстановитьПараметр("ТипСправочникаЛогистика", "КонтурЛогистика_ОрганизацииДиадок");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Роль = РольПоРеквизитуТитулаНКС(Выборка.РеквизитТитула);
		ДобавитьВариантСправочникаЕслиВозможно(Результат, Выборка.ИмяСправочника, Роль);
		
	КонецЦикла;
	
	ПоддерживаемыеТипы = КонтурЛогистика_КонвертацияСерверПовтИсп.ПоддерживаемыеТипыСправочниковКонфигурации1С(
		"КонтурЛогистика_ОрганизацииДиадок");
	
	Для Каждого ИмяСправочника Из ПоддерживаемыеТипы Цикл
		ДобавитьВариантСправочникаЕслиВозможно(Результат, ИмяСправочника, "", Истина);
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		
		ОпределяемыйТипОрганизацияКонтрагент = Метаданные.ОпределяемыеТипы.Найти("КонтурЛогистика_ОрганизацияКонтрагент");
		
		Если ОпределяемыйТипОрганизацияКонтрагент <> Неопределено Тогда
			
			Для Каждого ТипСсылки Из ОпределяемыйТипОрганизацияКонтрагент.Тип.Типы() Цикл
				
				ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипСсылки);
				
				Если ОбъектМетаданных = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ДобавитьВариантСправочникаЕслиВозможно(Результат, ОбъектМетаданных.Имя, "", Истина);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разворачивает выбор справочника: группы заменяются элементами.
//
Функция РазвернутьВыборСправочника(ИмяСправочника, МассивВыбранных) Экспорт
	
	Результат = Новый Массив;
	Группы = Новый Массив;
	УникальныеСсылки = Новый Соответствие;
	
	Для Каждого ВыбранныйЭлемент Из МассивВыбранных Цикл
		
		Если Не ЗначениеЗаполнено(ВыбранныйЭлемент) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СсылкаЯвляетсяГруппой(ВыбранныйЭлемент) Тогда
			Группы.Добавить(ВыбранныйЭлемент);
		Иначе
			ДобавитьСсылкуВРезультат(Результат, УникальныеСсылки, ВыбранныйЭлемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Группы.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			"ВЫБРАТЬ
			|	Справочник.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.%1 КАК Справочник
			|ГДЕ
			|	Справочник.Ссылка В ИЕРАРХИИ(&Группы)
			|	И НЕ Справочник.ЭтоГруппа
			|	И НЕ Справочник.ПометкаУдаления",
			ИмяСправочника);
		Запрос.УстановитьПараметр("Группы", Группы);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДобавитьСсылкуВРезультат(Результат, УникальныеСсылки, Выборка.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создаёт или находит организацию Диадок по результату выбора без записи соответствия в НКС.
//
Функция ОрганизацияДиадокПоРезультатуВыбора(ДанныеОрганизации) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеОрганизации) Тогда
		Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(ДанныеОрганизации) = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда
		Возврат ДанныеОрганизации;
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеОрганизации);
	
КонецФункции

// Возвращает инициатора приглашения к обмену ЭПД по умолчанию (единственная наша организация).
//
Функция ИнициаторПриглашенияПоУмолчанию() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И Организации.Наш";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 1 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	
КонецФункции

