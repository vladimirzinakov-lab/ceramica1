#Область ОписаниеПеременных

&НаКлиенте
Перем ИдетВыборИзСписка;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Локация = "https://api.kontur.ru/fias";
	КлючАПИ = "";
	АдресСтрока = "";
	ИдентификаторФИАС = "";
	УровеньФИАС = "";
	ВыбраннаяПодсказка = Неопределено;
	РежимВыбора = Ложь;
	
	Если Параметры.Свойство("КлючАПИ") И ЗначениеЗаполнено(Параметры.КлючАПИ) Тогда
		КлючАПИ = Параметры.КлючАПИ;
	Иначе
		КлючАПИ = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ApiKeyЛогистика();
	КонецЕсли;
	
	Если Параметры.Свойство("РежимВыбора") Тогда
		РежимВыбора = Параметры.РежимВыбора;
	КонецЕсли;
	
	Если Параметры.Свойство("АдресСтрока") И ЗначениеЗаполнено(Параметры.АдресСтрока) Тогда
		АдресСтрока = Параметры.АдресСтрока;
	КонецЕсли;
	
	Если Параметры.Свойство("ИдентификаторФИАС") И ЗначениеЗаполнено(Параметры.ИдентификаторФИАС) Тогда
		ИдентификаторФИАС = Параметры.ИдентификаторФИАС;
	КонецЕсли;
	
	Элементы.ГруппаПодключение.Видимость = Не РежимВыбора;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АдресСтрокаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	ТекстПоиска = СокрЛП(Текст);
	Если СтрДлина(ТекстПоиска) < МинимальнаяДлинаПоиска() Тогда
		Возврат;
	КонецЕсли;
	
	Подсказки = ПодсказкиАдресаНаСервере(ТекстПоиска, КлючАПИ, Локация);
	
	ВыборСвободнойФормы = Новый Структура;
	ВыборСвободнойФормы.Вставить("Подсказка", ТекстПоиска);
	ВыборСвободнойФормы.Вставить("ИдентификаторФИАС", "");
	ВыборСвободнойФормы.Вставить("УровеньФИАС", "");
	ВыборСвободнойФормы.Вставить("ЭтоСвободнаяФорма", Истина);
	ДанныеВыбора.Добавить(ВыборСвободнойФормы, "<добавить в свободной форме>");
	
	Для Каждого Подсказка Из Подсказки Цикл
		
		Представление = Подсказка.Подсказка;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыбора.Добавить(Подсказка, Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Подсказка = ВыбранноеЗначение;
	
	ИдетВыборИзСписка = Истина;
	АдресСтрока = Подсказка.Подсказка;
	Если Подсказка.Свойство("ЭтоСвободнаяФорма")
		И Подсказка.ЭтоСвободнаяФорма Тогда
		ОчиститьВыбранныйАдрес();
	Иначе
		ПрименитьВыбраннуюПодсказку(Подсказка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаПриИзменении(Элемент)
	
	Если ИдетВыборИзСписка = Истина Тогда
		ИдетВыборИзСписка = Ложь;
		Возврат;
	КонецЕсли;
	
	ОчиститьВыбранныйАдрес();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьВыбраннуюПодсказку(Подсказка)
	
	ВыбраннаяПодсказка = Подсказка;
	ИдентификаторФИАС = Подсказка.ИдентификаторФИАС;
	УровеньФИАС = Подсказка.УровеньФИАС;
	
	Если РежимВыбора И ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
		ЗакрытьФормуСРезультатом();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьАдрес(Команда)
	ЗакрытьФормуСРезультатом();
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуСРезультатом()
	
	Если Не ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
		ПоказатьПредупреждение(, "Выберите адрес из списка подсказок.");
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторФИАС", ИдентификаторФИАС);
	Результат.Вставить("АдресПредставление", АдресСтрока);
	Результат.Вставить("УровеньФИАС", УровеньФИАС);
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВыбранныйАдрес()
	
	ИдентификаторФИАС = "";
	УровеньФИАС = "";
	ВыбраннаяПодсказка = Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодсказкиАдресаНаСервере(Знач Текст, Знач КлючАПИ, Знач Локация)
	
	Попытка
		Возврат ПодсказкиАдресаВызовAPI(Текст, КлючАПИ, Локация);
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодсказкиАдресаВызовAPI(Знач Текст, Знач КлючАПИ, Знач Локация)
	
	Клиент = Обработки.КонтурЛогистика_ФиасКлиент.Создать();
	Параметры = Клиент.ФиасПараметры();
	Если ЗначениеЗаполнено(Локация) Тогда
		Параметры.Локация = Локация;
	Иначе
		Параметры.Локация = "https://api.kontur.ru/fias";
	КонецЕсли;
	Параметры.КлючАПИ = СокрЛП(КлючАПИ);
	Клиент = Клиент.Фиас(Параметры);
	
	Запрос = Клиент.ЗапросНайтиАдресаСПодсказками();
	Запрос.Адрес = Текст;
	Запрос.Лимит = ЛимитПодсказок();
	Запрос.ТолькоПодсказки = Истина;
	Запрос.Уровень = "House";
	
	Ответ = Клиент.НайтиАдресаСПодсказками(Запрос);
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Ответ Цикл
		Результат.Добавить(ПодсказкаДляФормы(Элемент));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодсказкаДляФормы(Элемент)
	
	ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	
	Возврат Новый Структура("Подсказка, ИдентификаторФИАС, УровеньФИАС",
		ТекстПодсказкиИзЭлемента(Элемент, ПодсказкаСырая),
		ИдентификаторФИАСИзЭлемента(Элемент, ПодсказкаСырая),
		УровеньФИАСИзЭлемента(Элемент, ПодсказкаСырая));
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстПодсказкиИзЭлемента(Элемент, ПодсказкаСырая = Неопределено)
	
	Если ПодсказкаСырая = Неопределено Тогда
		ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	КонецЕсли;
	
	Текст = ТекстИзОбъектаПодсказки(ПодсказкаСырая);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат ТекстИзОбъектаПодсказки(Элемент);
	
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторФИАСИзЭлемента(Элемент, ПодсказкаСырая = Неопределено)
	
	Идентификатор = ЗначениеСвойстваЭлемента(Элемент, "ИдентификаторФИАС", "fiasId");
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;
	
	Если ПодсказкаСырая = Неопределено Тогда
		ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	КонецЕсли;
	
	Возврат ЗначениеСвойстваЭлемента(ПодсказкаСырая, "", "fiasId");
	
КонецФункции

&НаСервереБезКонтекста
Функция УровеньФИАСИзЭлемента(Элемент, ПодсказкаСырая = Неопределено)
	
	Уровень = ЗначениеСвойстваЭлемента(Элемент, "УровеньФИАС", "fiasLevel");
	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Уровень = ЗначениеСвойстваЭлемента(Элемент, "", "level");
	КонецЕсли;
	Если ЗначениеЗаполнено(Уровень) Тогда
		Возврат Уровень;
	КонецЕсли;
	
	Если ПодсказкаСырая = Неопределено Тогда
		ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	КонецЕсли;
	
	Уровень = ЗначениеСвойстваЭлемента(ПодсказкаСырая, "", "fiasLevel");
	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Уровень = ЗначениеСвойстваЭлемента(ПодсказкаСырая, "", "level");
	КонецЕсли;
	
	Возврат Уровень;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстИзОбъектаПодсказки(Данные)
	
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТипДанных = ТипЗнч(Данные);
	Если ТипДанных = Тип("Строка") Тогда
		Возврат Данные;
	КонецЕсли;
	
	Если ТипДанных = Тип("Структура")
		ИЛИ ТипДанных = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипДанных = Тип("Соответствие")
		ИЛИ ТипДанных = Тип("ФиксированноеСоответствие") Тогда
		
		Текст = ЗначениеСвойстваЭлемента(Данные, "", "value");
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ЗначениеСвойстваЭлемента(Данные, "", "label");
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) И ТипЗнч(Текст) <> Тип("Строка") Тогда
			Текст = ТекстИзОбъектаПодсказки(Текст);
		КонецЕсли;
		
		Если Текст = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Возврат Текст;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеСвойстваЭлемента(Элемент, ИмяРус, ИмяАнгл)
	
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЭлемента = ТипЗнч(Элемент);
	
	Если ТипЭлемента = Тип("Структура")
		ИЛИ ТипЭлемента = Тип("ФиксированнаяСтруктура") Тогда
		
		Если ЗначениеЗаполнено(ИмяРус) И Элемент.Свойство(ИмяРус) Тогда
			Возврат Элемент[ИмяРус];
		КонецЕсли;
		
	ИначеЕсли ТипЭлемента = Тип("Соответствие")
		ИЛИ ТипЭлемента = Тип("ФиксированноеСоответствие") Тогда
		
		Если ЗначениеЗаполнено(ИмяАнгл) Тогда
			Возврат Элемент.Получить(ИмяАнгл);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЛимитПодсказок()
	Возврат 7;
КонецФункции

&НаСервереБезКонтекста
Функция МинимальнаяДлинаПоиска()
	Возврат 2;
КонецФункции

#КонецОбласти
