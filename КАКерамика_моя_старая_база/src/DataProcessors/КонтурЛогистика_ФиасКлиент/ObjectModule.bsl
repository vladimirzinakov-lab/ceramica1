	Результат.Вставить("settlement", "НаселенныйПункт");
	Результат.Вставить("planningStructure", "ПланировочнаяСтруктура");
	Результат.Вставить("street", "Улица");
	Результат.Вставить("stead", "ЗемельныйУчасток");
