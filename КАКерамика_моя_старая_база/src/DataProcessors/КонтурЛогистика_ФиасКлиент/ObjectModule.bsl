Функция Фиас(Знач Параметры = Неопределено) Экспорт
	
	ИсполняемыеПараметры = ФиасПараметры();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ИсполняемыеПараметры, Параметры);
	КонецЕсли;
	
	АдресСервисаЛок = СокрЛП(ИсполняемыеПараметры.Локация);
	КлючАПИЛок = СокрЛП(ИсполняемыеПараметры.КлючАПИ);
	
	Если Прав(АдресСервисаЛок, 1) = "/" Тогда
		АдресСервисаЛок = Лев(АдресСервисаЛок, СтрДлина(АдресСервисаЛок) - 1);
	КонецЕсли;
	
	УстановитьКлючАПИ(КлючАПИЛок);
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ФиасПараметры() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Локация", "https://api.kontur.ru/fias");
	Модель.Вставить("КлючАПИ", "");
	
	Возврат Модель;
	
КонецФункции

Процедура УстановитьКлючАПИ(Знач КлючАПИ = "") Экспорт
	
	СессияЛок = Сессия();
	
	Если ЗначениеЗаполнено(КлючАПИ) Тогда
		СессияЛок.Заголовки.Вставить("Authorization", СтрЛок.СтрШаблонЛок("Bearer %1", КлючАПИ));
	Иначе
		СессияЛок.Заголовки.Удалить("Authorization");
	КонецЕсли;
	
КонецПроцедуры

Функция Сессия() Экспорт
	
	Если СессияЛок = Неопределено Тогда
		СессияЛок = КоннекторЛок.СоздатьСессию();
		СессияЛок.Заголовки.Вставить("Accept", "application/json");
	КонецЕсли;
	
	Возврат СессияЛок;
	
КонецФункции
