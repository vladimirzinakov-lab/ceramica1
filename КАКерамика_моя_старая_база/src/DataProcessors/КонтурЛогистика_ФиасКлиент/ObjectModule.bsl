//#Область Коннектор

Функция _ВыполнитьGetJson(Ресурс, ПараметрыЗапроса = Неопределено, Код404 = Неопределено, КодОшибки404 = "")
	Ответ = _Get(Ресурс, ПараметрыЗапроса);
	_ПроверитьОтвет(Ответ, Код404, КодОшибки404);
	Возврат КоннекторЛок.КакJson(Ответ);
КонецФункции

Функция _ВыполнитьPostJson(Ресурс, Тело, ПараметрыЗапроса = Неопределено)
	Ответ = _PostJson(Ресурс, Тело, ПараметрыЗапроса);
	_ПроверитьОтвет(Ответ);
	Возврат КоннекторЛок.КакJson(Ответ);
КонецФункции

Процедура _ПроверитьОтвет(Ответ, Код404 = Неопределено, КодОшибки404 = "")
	Если Код404 <> Неопределено И Ответ.КодСостояния = Код404 Тогда
		ВызватьИсключение _ТелоОписаниеОшибкиНеНайден(КодОшибки404, Ответ, "Объект не найден");
	ИначеЕсли Ответ.КодСостояния <> _КодОтвета200() Тогда
		ВызватьИсключение _ТелоОписаниеОшибкиСостояния(Ответ);
	КонецЕсли;
КонецПроцедуры

Функция _Get(Ресурс, ПараметрыЗапроса = Неопределено, ДопЗаголовки = Неопределено)
	ДопПараметры = Новый Структура;
	Если ЗначениеЗаполнено(ДопЗаголовки) Тогда
		ДопПараметры.Вставить("Заголовки", ДопЗаголовки);
	КонецЕсли;
	Возврат КоннекторЛок.Get(_URL(Ресурс), ПараметрыЗапроса, ДопПараметры, Сессия());
КонецФункции

Функция _PostJson(Ресурс, Json, ПараметрыЗапроса = Неопределено, ДопЗаголовки = Неопределено)
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Json", Json);
	Если ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		ДопПараметры.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопЗаголовки) Тогда
		ДопПараметры.Вставить("Заголовки", ДопЗаголовки);
	КонецЕсли;
	Возврат КоннекторЛок.Post(_URL(Ресурс), Неопределено, ДопПараметры, Сессия());
КонецФункции

Функция _URL(Ресурс)
	Если СтрЛок.СтрНайтиЛок(Ресурс, "http") ИЛИ СтрЛок.СтрНайтиЛок(Ресурс, "https") Тогда
		Возврат Ресурс;
	Иначе
		Возврат АдресСервисаЛок + Ресурс;
	КонецЕсли;
КонецФункции

Функция _КодОтвета200()
	Возврат 200;
КонецФункции

Функция _КодОтвета404()
	Возврат 404;
КонецФункции

