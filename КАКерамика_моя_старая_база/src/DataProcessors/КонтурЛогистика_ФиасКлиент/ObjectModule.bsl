Функция _ParseРезультатПоискаАдресов(Данные)
	Результат = Новый Структура("Адреса, Всего", Новый Массив, 0);
	Если Данные = Неопределено Тогда Возврат Результат; КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Результат.Адреса = _ParseМассивАдресов(Данные);
	Иначе
		Список = Данные.Получить("addresses");
		Если Список <> Неопределено Тогда Результат.Адреса = _ParseМассивАдресов(Список); КонецЕсли;
		Всего = Данные.Получить("total");
		Если Всего <> Неопределено Тогда Результат.Всего = Всего; КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

