	_ДобавитьПараметрЛимита(Параметры, Запрос.Лимит);
	_ДобавитьПараметрВерсии(Параметры, Запрос.Версия);
	_ДобавитьБулевПараметрНеопределено(Параметры, "actual", Запрос.ТолькоАктуальные);
	_ДобавитьБулевПараметр(Параметры, "fullAddress", Запрос.ПолныйАдрес);
