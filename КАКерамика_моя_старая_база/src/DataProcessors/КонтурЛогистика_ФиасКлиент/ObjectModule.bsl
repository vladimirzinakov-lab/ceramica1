Функция _ParseAddressObject(Данные)
	Если Данные = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Модель = Контракт_АдресныйОбъект();
	Модель.Наименование = Данные.Получить("name");
	Модель.Сокращение = Данные.Получить("abbreviation");
	Модель.ИдентификаторФИАС = Данные.Получить("fiasId");
	Модель.Актуальность = Данные.Получить("actuality");
	Модель.Идентификатор = Данные.Получить("id");
	Модель.ИдентификаторРодителяФИАС = Данные.Получить("parentFiasId");
	Модель.ИдентификаторыРодителейФИАС = Данные.Получить("parentFiasIds");
