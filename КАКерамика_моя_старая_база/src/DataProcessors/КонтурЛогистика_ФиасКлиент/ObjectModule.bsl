Функция _ParseЭлементПоиска(Данные)
	Элемент = Новый Структура("Подсказка, Адрес, УровеньФИАС, ИдентификаторФИАС");
	ПодсказкаСырая = _ЗначениеИзКоллекции(Данные, "suggest");
	Элемент.Подсказка = _ТекстПодсказки(ПодсказкаСырая);
	Если Не ЗначениеЗаполнено(Элемент.Подсказка) Тогда
		Элемент.Подсказка = _ТекстПодсказки(Данные);
	КонецЕсли;
	Адр = _ЗначениеИзКоллекции(Данные, "address");
	Если Адр <> Неопределено Тогда Элемент.Адрес = _ParseAddress(Адр); КонецЕсли;
	Элемент.УровеньФИАС = _УровеньФИАСИзЭлементаПоиска(Данные, ПодсказкаСырая);
	Элемент.ИдентификаторФИАС = _ИдентификаторФИАСИзЭлементаПоиска(Данные, ПодсказкаСырая);
	Возврат Элемент;
КонецФункции

Функция _ЗначениеИзКоллекции(Коллекция, Имя)
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипКоллекции = ТипЗнч(Коллекция);
	Если ТипКоллекции = Тип("Структура") ИЛИ ТипКоллекции = Тип("ФиксированнаяСтруктура") Тогда
		Если Коллекция.Свойство(Имя) Тогда
			Возврат Коллекция[Имя];
		КонецЕсли;
	ИначеЕсли ТипКоллекции = Тип("Соответствие") ИЛИ ТипКоллекции = Тип("ФиксированноеСоответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция _ТекстПодсказки(Данные)
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипДанных = ТипЗнч(Данные);
	Если ТипДанных = Тип("Строка") Тогда
		Возврат Данные;
	КонецЕсли;
	Если ТипДанных = Тип("Структура")
		ИЛИ ТипДанных = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипДанных = Тип("Соответствие")
		ИЛИ ТипДанных = Тип("ФиксированноеСоответствие") Тогда
		Текст = _ЗначениеИзКоллекции(Данные, "value");
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = _ЗначениеИзКоллекции(Данные, "label");
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) И ТипЗнч(Текст) <> Тип("Строка") Тогда
			Текст = _ТекстПодсказки(Текст);
		КонецЕсли;
		Возврат ?(Текст = Неопределено, "", Текст);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция _ИдентификаторФИАСИзЭлементаПоиска(Данные, ПодсказкаСырая)
	Идентификатор = _ЗначениеИзКоллекции(Данные, "fiasId");
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
