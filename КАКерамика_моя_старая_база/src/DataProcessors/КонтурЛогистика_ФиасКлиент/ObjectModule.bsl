Функция _ПараметрыЗапроса()
	Возврат Новый Соответствие;
КонецФункции

Процедура _ДобавитьПараметр(Параметры, Имя, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Параметры.Вставить(Имя, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура _ДобавитьПараметрВерсии(Параметры, Версия)
	_ДобавитьПараметр(Параметры, "version", Версия);
КонецПроцедуры

Процедура _ДобавитьПараметрЛимита(Параметры, Лимит)
	Если Лимит > 0 Тогда
		Параметры.Вставить("limit", Формат(Лимит, "ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

Процедура _ДобавитьБулевПараметр(Параметры, Имя, Значение)
	Если Значение = Истина Тогда
		Параметры.Вставить(Имя, "true");
	ИначеЕсли Значение = Ложь Тогда
		Параметры.Вставить(Имя, "false");
	КонецЕсли;
КонецПроцедуры

Процедура _ДобавитьБулевПараметрНеопределено(Параметры, Имя, Значение)
	Если Значение <> Неопределено Тогда
		_ДобавитьБулевПараметр(Параметры, Имя, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура _ДобавитьМассивПараметров(Параметры, Имя, Массив)
	Если Массив <> Неопределено И Массив.Количество() > 0 Тогда
		Параметры.Вставить(Имя, Массив);
	КонецЕсли;
КонецПроцедуры

Функция _ПараметрыПоискаАдресов(Запрос)
	Параметры = _ПараметрыЗапроса();
	_ДобавитьПараметр(Параметры, "prefix", Запрос.Префикс);
