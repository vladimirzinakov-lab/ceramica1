Функция _ParseМассивЭлементов(Данные, ИмяПарсера)
	Результат = Новый Массив;
	Если Данные = Неопределено Или ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Данные Цикл
		Если ИмяПарсера = "Address" Тогда
			Результат.Добавить(_ParseAddress(Элемент));
		ИначеЕсли ИмяПарсера = "House" Тогда
			Результат.Добавить(_ParseHouse(Элемент));
		ИначеЕсли ИмяПарсера = "Room" Тогда
			Результат.Добавить(_ParseRoom(Элемент));
		ИначеЕсли ИмяПарсера = "Stead" Тогда
			Результат.Добавить(_ParseStead(Элемент));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

