	Результат = Новый Массив;
	Если Данные = Неопределено Тогда Возврат Результат; КонецЕсли;
	Для Каждого Элемент Из Данные Цикл
		Строка = Новый Структура("Кандидаты", Новый Массив);
		Кандидаты = Элемент.Получить("candidates");
		Если Кандидаты <> Неопределено Тогда
			Для Каждого К Из Кандидаты Цикл
				Канд = Новый Структура("Описание, Адрес, ОписанияУзлов");
				Канд.Описание = _ParseОписаниеКандидата(К.Получить("description"));
				Адр = К.Получить("address");
				Если Адр <> Неопределено Тогда Канд.Адрес = _ParseAddress(Адр); КонецЕсли;
				Канд.ОписанияУзлов = К.Получить("nodeDescriptions");
				Строка.Кандидаты.Добавить(Канд);
			КонецЦикла;
		КонецЕсли;
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция _ParseОписаниеКандидата(Данные)
	Если Данные = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Описание = Новый Структура("Подсказка, ИдентификаторФИАС, Уровень");
	Описание.Подсказка = Данные.Получить("suggest");
	Описание.ИдентификаторФИАС = Данные.Получить("fiasId");
	Описание.Уровень = Данные.Получить("level");
	Возврат Описание;
КонецФункции

Функция _ParseМестоРождения(Данные)
	Результат = Новый Структура("Адрес, Описание, АдресФИАС");
	Если Данные = Неопределено Тогда Возврат Результат; КонецЕсли;
	Адр = Данные.Получить("address");
	Если Адр <> Неопределено Тогда Результат.Адрес = _ParseAddress(Адр); КонецЕсли;
	Результат.Описание = _ParseОписаниеМестаРождения(Данные.Получить("description"));
	АдрФ = Данные.Получить("fiasAddress");
	Если АдрФ <> Неопределено Тогда Результат.АдресФИАС = _ParseAddress(АдрФ); КонецЕсли;
	Возврат Результат;
КонецФункции

Функция _ParseОписаниеМестаРождения(Данные)
	Если Данные = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Описание = Новый Структура;
	Описание.Вставить("ВсеРазрешено", Данные.Получить("allResolved"));
	Описание.Вставить("ПодсказкаФИАС", Данные.Получить("fiasSuggest"));
	Описание.Вставить("ИдентификаторФИАС", Данные.Получить("fiasId"));
	Описание.Вставить("УровеньФИАС", Данные.Получить("fiasLevel"));
	Описание.Вставить("КодОКСМ", Данные.Получить("oksmCode"));
	Возврат Описание;
КонецФункции

