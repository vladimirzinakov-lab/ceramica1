Функция _СоответствиеКлючейАдресаОбратное()
	Результат = Новый Соответствие;
	Для Каждого Элемент Из _СоответствиеКлючейАдреса() Цикл
		Результат.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	Результат.Вставить("Дом", "house");
	Результат.Вставить("ДомГАР", "garhouse");
	Результат.Вставить("Помещение", "room");
	Возврат Результат;
КонецФункции

Функция _BuildVerifyAddresses(Адреса)
	Результат = Новый Массив;
	Для Каждого Адрес Из Адреса Цикл
		Результат.Добавить(_BuildVerifyAddress(Адрес));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция _BuildVerifyAddress(Адрес)
	Если ТипЗнч(Адрес) = Тип("Соответствие") Тогда
		Возврат Адрес;
	КонецЕсли;
	Результат = Новый Соответствие;
	Ключи = _СоответствиеКлючейАдресаОбратное();
	Для Каждого Элемент Из Ключи Цикл
		Если Адрес.Свойство(Элемент.Ключ) Тогда
			Значение = Адрес[Элемент.Ключ];
			Если Значение <> Неопределено Тогда
				Результат.Вставить(Элемент.Значение, _BuildVerifyLevel(Значение));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Адрес.Свойство("Дом") И Адрес.Дом <> Неопределено Тогда
		Результат.Вставить("house", _BuildHouseBody(Адрес.Дом));
	КонецЕсли;
	Если Адрес.Свойство("ДомГАР") И Адрес.ДомГАР <> Неопределено Тогда
		Результат.Вставить("garhouse", _BuildHouseBody(Адрес.ДомГАР));
	КонецЕсли;
	Если Адрес.Свойство("Помещение") И Адрес.Помещение <> Неопределено Тогда
		Результат.Вставить("room", _BuildRoomBody(Адрес.Помещение));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция _BuildVerifyLevel(Уровень)
	Если ТипЗнч(Уровень) = Тип("Соответствие") Тогда
		Возврат Уровень;
	КонецЕсли;
	Результат = Новый Соответствие;
	Если Уровень.Свойство("Наименование") Тогда Результат.Вставить("name", Уровень.Наименование); КонецЕсли;
	Если Уровень.Свойство("Сокращение") Тогда Результат.Вставить("abbreviation", Уровень.Сокращение); КонецЕсли;
	Если Уровень.Свойство("ИдентификаторФИАС") Тогда Результат.Вставить("fiasId", Уровень.ИдентификаторФИАС); КонецЕсли;
	Возврат Результат;
КонецФункции

Функция _BuildHouseBody(Дом)
	Если ТипЗнч(Дом) = Тип("Соответствие") Тогда Возврат Дом; КонецЕсли;
	Результат = Новый Соответствие;
	_ВставитьЕслиЗаполнено(Результат, "number", Дом, "Номер");
	_ВставитьЕслиЗаполнено(Результат, "fiasId", Дом, "ИдентификаторФИАС");
	_ВставитьЕслиЗаполнено(Результат, "houseNum", Дом, "НомерДома");
	_ВставитьЕслиЗаполнено(Результат, "houseType", Дом, "ТипДома");
	_ВставитьЕслиЗаполнено(Результат, "houseAbbreviation", Дом, "СокращениеДома");
	_ВставитьЕслиЗаполнено(Результат, "structureNumber", Дом, "НомерСтроения");
	_ВставитьЕслиЗаполнено(Результат, "buildingNumber", Дом, "НомерКорпуса");
	_ВставитьЕслиЗаполнено(Результат, "structureStatus", Дом, "СтатусСтроения");
	_ВставитьЕслиЗаполнено(Результат, "estateStatus", Дом, "СтатусВладения");
	_ВставитьЕслиЗаполнено(Результат, "addNum1", Дом, "ДопНомер1");
	_ВставитьЕслиЗаполнено(Результат, "addType1", Дом, "ДопТип1");
	_ВставитьЕслиЗаполнено(Результат, "addNum2", Дом, "ДопНомер2");
	_ВставитьЕслиЗаполнено(Результат, "addType2", Дом, "ДопТип2");
	Возврат Результат;
КонецФункции

Функция _BuildRoomBody(Помещение)
	Если ТипЗнч(Помещение) = Тип("Соответствие") Тогда Возврат Помещение; КонецЕсли;
	Результат = Новый Соответствие;
	_ВставитьЕслиЗаполнено(Результат, "flatNumber", Помещение, "НомерКвартиры");
	_ВставитьЕслиЗаполнено(Результат, "flatType", Помещение, "ТипПомещения");
	_ВставитьЕслиЗаполнено(Результат, "flatAbbreviation", Помещение, "СокращениеТипа");
	_ВставитьЕслиЗаполнено(Результат, "roomNumber", Помещение, "НомерКомнаты");
	_ВставитьЕслиЗаполнено(Результат, "roomType", Помещение, "ТипКомнаты");
	_ВставитьЕслиЗаполнено(Результат, "roomAbbreviation", Помещение, "СокращениеКомнаты");
	_ВставитьЕслиЗаполнено(Результат, "fiasId", Помещение, "ИдентификаторФИАС");
	Возврат Результат;
КонецФункции

Процедура _ВставитьЕслиЗаполнено(Приемник, ИмяEn, Источник, ИмяRu)
	Если Источник.Свойство(ИмяRu) И ЗначениеЗаполнено(Источник[ИмяRu]) Тогда
		Приемник.Вставить(ИмяEn, Источник[ИмяRu]);
	КонецЕсли;
КонецПроцедуры

Функция _BuildBatchItems(Элементы)
	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Элемент = Новый Соответствие;
		Если ТипЗнч(Элемент) = Тип("Структура") Тогда
			Идентификатор = "";
			Если Элемент.Свойство("Идентификатор") Тогда Идентификатор = Элемент.Идентификатор; КонецЕсли;
			Элемент.Вставить("id", Идентификатор);
			Если Элемент.Свойство("Уровень") И ЗначениеЗаполнено(Элемент.Уровень) Тогда
				Элемент.Вставить("level", Элемент.Уровень);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Элемент.Вставить("id", Элемент.Получить("id"));
			Уровень = Элемент.Получить("level");
			Если ЗначениеЗаполнено(Уровень) Тогда Элемент.Вставить("level", Уровень); КонецЕсли;
		Иначе
			Элемент.Вставить("id", Элемент);
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

