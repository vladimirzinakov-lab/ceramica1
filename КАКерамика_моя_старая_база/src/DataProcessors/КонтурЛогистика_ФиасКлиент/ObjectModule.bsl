Функция _ТелоОписаниеОшибкиСостояния(Ответ)
	Части = Новый Массив;
	Части.Добавить(СтрЛок.СтрШаблонЛок("%1: %2", _ОшибкаСостоянияHTTP(), XMLСтрока(Ответ.КодСостояния)));
	Части.Добавить(СтрЛок.СтрШаблонЛок("URL: %1", Ответ.URL));
	ТипКонтента = Ответ.Заголовки.Получить("Content-Type");
	Если СтрЛок.СтрНайтиЛок(ТипКонтента, "text/plain") ИЛИ СтрЛок.СтрНайтиЛок(ТипКонтента, "application/json") Тогда
		Части.Добавить(КоннекторЛок.КакТекст(Ответ));
	КонецЕсли;
	Возврат СтрЛок.СтрСоединитьЛок(Части, Символы.ПС);
КонецФункции

Функция _ТелоОписаниеОшибкиНеНайден(КодОшибки, Ответ, Текст)
	Возврат СтрЛок.СтрШаблонЛок("%1: %2%3URL: %4", КодОшибки, Текст, Символы.ПС, Ответ.URL);
КонецФункции

Процедура _ПроверитьЗаполнено(Значение, ИмяПараметра)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение _ТелоОписаниеОшибкиНедопустимоеЗначениеПараметра(ИмяПараметра, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура _ПроверитьИдентификатор(Значение, ИмяПараметра)
	_ПроверитьЗаполнено(Значение, ИмяПараметра);
КонецПроцедуры

Процедура _ПроверитьМассивНеПустой(Массив, ИмяПараметра)
	Если Массив = Неопределено ИЛИ Массив.Количество() = 0 Тогда
		ВызватьИсключение _ТелоОписаниеОшибкиНедопустимоеЗначениеПараметра(ИмяПараметра, Массив);
	КонецЕсли;
КонецПроцедуры

