&НаКлиенте
Процедура ОрганизацииДиадокИРолиНашаПриИзменении(Элемент)
	
	ИмяРеквизита = "Наш";
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элементы.ОрганизацииДиадокИРоли.ТекущиеДанные;
	ОрганизацияСсылка =  ТекСтрока.ОрганизацияДиадок;
	
	УстановитьРеквизитОрганизацииДиадок(ИмяРеквизита, ОрганизацияСсылка);
	
	Если ТекСтрока.Наша Тогда
		
		УстановитьНастройкуОрганизации(ОрганизацияСсылка,
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок"),
			Истина);
			
		ApiKey = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиОрганизацииДиадок(ОрганизацияСсылка, 
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"));
		Если ЗначениеЗаполнено(ApiKey) Тогда
			УстановитьНастройкуОрганизации(ОрганизацияСсылка,
				ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики"),
				Истина);
		КонецЕсли;
			
	КонецЕсли;
	
	ОповеститьОбИзменении(ОрганизацияСсылка);
	
	Если ТекСтрока.Наша И Не КонтрагентыОрганизацииСинхронизированы(ОрганизацияСсылка) Тогда
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ОрганизацияСсылка", ОрганизацияСсылка);
		
		РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.СинхронизироватьКонтрагентовОрганизации",
			ПараметрыМетода,, "Синхронизировать контрагентов организации");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтрагентыОрганизацииСинхронизированы(ОрганизацияСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияСсылка", ОрганизацияСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок.Контрагенты КАК КонтурЛогистика_ОрганизацииДиадокКонтрагенты
	|ГДЕ
	|	КонтурЛогистика_ОрганизацииДиадокКонтрагенты.Ссылка = &ОрганизацияСсылка";
	
	Результат = Запрос.Выполнить();
	
	Возврат Не Результат.Пустой();
	
КонецФункции

