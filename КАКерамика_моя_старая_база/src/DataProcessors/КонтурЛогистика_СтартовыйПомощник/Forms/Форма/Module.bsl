
&НаКлиенте
Процедура ПереключитьНовыйПользователь(Команда)
	НетПользователяДД = Не НетПользователяДД;
	УправлениеВидимостьюДоступностью(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// установка роли админа КЛ для админа учетной системы
	УстановитьРольАдминистратора();
	
	ТекущийПользовательСБазовымиПравамиМожетРедактироватьСП = 
		КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийПользовательСБазовымиПравамиМожетРедактироватьСтартовыйПомощник();
	
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	Если Не ЗначениеЗаполнено(РежимАвторизации) Тогда
		РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow;
		УстановитьНастройку("РежимАвторизации", РежимАвторизации);
	КонецЕсли;
	
	API_Логин = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЛогинАвторизацииДиадокАПИ");
	API_Пароль = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПарольАвторизацииДиадокАПИ");
	
	Если Не РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ApiKey
		И Не РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow
		И ЗначениеЗаполнено(API_Логин)
		И ЗначениеЗаполнено(API_Пароль) Тогда
		
		ПроверитьСоединениеAPI();
	КонецЕсли;
	
	ИспользуетсяТестовыйСервер 			= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок");
	ИспользуютсяЗаказЗаявки 			= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
	ИспользуютсяЗаказНаряды 			= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказНаряд");
	ИспользуютсяПутевыеЛисты 			= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
	ИспользуютсяПутевыеЛисты_5_02 		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист_5_02");
	ИспользуютсяТРН 					= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
	ИспользуетсяПоручениеЭкспедитору	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПоручениеЭкспедитору");
	ИспользуетсяЭкспедиторскаяРасписка	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЭкспедиторскаяРасписка");
	ИспользуетсяСкладскаяРасписка		= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяСкладскаяРасписка");
	ИспользуютсяЭкспедиторскиеДокумент	= (ИспользуетсяПоручениеЭкспедитору И ИспользуетсяЭкспедиторскаяРасписка И ИспользуетсяСкладскаяРасписка);
	
	Если Не ИспользуютсяЗаказНаряды Тогда
		Элементы.ИспользуютсяЗаказНаряды.Видимость = Ложь;
	КонецЕсли;
	
	ИмяКонфигурации1С = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИмяКонфигурации1С");
	
	УстановитьТиповуюКонфигурацию();
	
	Если Параметры.НачальнаяСтраница = "ВводЛогинаПароля" Или API_АвторизацияЛогинПарольУспешна <> Истина Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.ВводЛогинаПароля;
	ИначеЕсли Параметры.НачальнаяСтраница = "МоиОрганизации" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации;
		ПеречитатьМоиОрганизацииНаСервере();
	ИначеЕсли Параметры.НачальнаяСтраница = "Функциональность" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
		ПеречитатьМоиОрганизацииНаСервере();
	ИначеЕсли Параметры.НачальнаяСтраница = "Настройки" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
		ПеречитатьНастройкиНаСервере();
	ИначеЕсли Параметры.НачальнаяСтраница = "Права" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПрав;	
	КонецЕсли;
	
	ОбновитьДанныеТестовыхОрганизаций();
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение() Тогда
		ОтображениеРасширенияСДополнительнымиРеквизитами();
		ОбновитьВидимостьДоступностьГруппДоступа();
	Иначе
		Элементы.ГруппаДополнительныеРеквизитыРасширение.Видимость = Ложь;
		Элементы.ГруппаГруппыДоступа.Видимость = Ложь;
	КонецЕсли;
		
	ПолучимНастройкиПрокси();
	
	ПеречитатьОшибки(Истина);
	
	УправлениеВидимостьюДоступностью(ЭтаФорма);
	
	ОтображениеРасширенияСДополнительнымиРеквизитами();
	
	ОтображениеРасширенияQR();
	
	ОбновитьВидимостьНастроекГруппДоступа();
	
	Если РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow
		И Параметры.НачальнаяСтраница = "ВводЛогинаПароля" Тогда
		
		ЕстьАвторизации = КонтурЛогистика_ОбщегоНазначенияСервер.ЕстьПортальныеАвторизации();
		Если Не ЕстьОрганизации() Или Не ЕстьАвторизации Тогда
			// При первом запуске заполняем в режиме
			ПереносПараметровАвторизацииИПроксиИзМодулейКонтура();
			
			ОткрытьАвторизациюOIDC = Истина;
		КонецЕсли;
		
	ИначеЕсли Не ЗначениеЗаполнено(API_Логин) Тогда
		// При первом запуске заполняем в режиме
		ПереносПараметровАвторизацииИПроксиИзМодулейКонтура();
	КонецЕсли;
	
	Если РежимАвторизации <> Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПароль Тогда
		НайденныйЭлемент = Элементы.РежимАвторизации.СписокВыбора.НайтиПоЗначению(Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПароль);
		Если НайденныйЭлемент <> Неопределено Тогда
			Элементы.РежимАвторизации.СписокВыбора.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущийПользовательСБазовымиПравамиМожетРедактироватьСП Тогда
		Элементы.ВводЛогинаПароля.Доступность = Ложь;
		Элементы.СтраницаНастройки.Доступность = Ложь;
		Элементы.СтраницаНастройкиПрав.Доступность = Ложь;
		Если Элементы.Страницы.ТекущаяСтраница = Элементы.ВводЛогинаПароля Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
		КонецЕсли;
	ИначеЕсли Не (КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор() Или РольДоступна("КонтурЛогистика_НастройкаПодсистемы")) Тогда
		Элементы.Страницы.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ЗаполнитьНачальныеДанныеДляМетрик();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ГруппаПредупреждение.Видимость = Ложь;
	Элементы.ГруппаПредупреждениеQR.Видимость = Ложь;
	
	УстановитьДоступностьКнопкиДалее();
	
	ОбновитьВидимостьТестовыхОрганизаций();
	
	ОбновитьВидимостьДоступностьПрокси(Истина);
	
	// Скроем все панели
	ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь);
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Ложь);
	ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь, "ДополнительныеРеквизиты");
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Ложь, "ДополнительныеРеквизиты");
	ОбновитьФорму_ЗапущенаПроверкаОбновления(Ложь, "QR_МП_УАТ");
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Ложь, "QR_МП_УАТ");
	
	// Откроем авторизацию по OIDC
	Если ОткрытьАвторизациюOIDC Тогда
		ПодключитьОбработчикОжидания("ОткрытьАвторизациюOIDC", 0.1, Истина);
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПриОткрытииЗавершение", 0.1, Истина);
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоИнтерфейс82() Тогда
		Элементы.ЗаголовокСертификаты.ВысотаЗаголовка = 2;
		Элементы.ЗаголовокМЧД.ВысотаЗаголовка = 2;
		Элементы.ЗаголовокНастройкиПодписания.ВысотаЗаголовка = 2;
	КонецЕсли;
	
	// Метрики
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Источник", "СтартовыйПомощник");
	КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание("КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьЗапускМодуля",
		ПараметрыМетода,, "Отправка метрики запуска модуля", Неопределено);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииЗавершение()
	
	// Выполним первоначальное заполнение справочников
	АдресРезультатаВыполнитьОбмен = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
		"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьПервичноеЗаполнениеСправочников",,
		"КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьПервичноеЗаполнениеСправочников",
		"Фоновое задание первичного заполнения справочников",
		АдресРезультатаВыполнитьОбмен);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАвторизациюOIDC()
	
	ПараметрыФормы = Новый Структура;
	Если Не ЕстьОрганизации() Тогда
		ПараметрыФормы.Вставить("АвторизацияПриОткрытии");
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"РегистрСведений.КонтурЛогистика_Аутентификация.Форма.ФормаАвторизацииОрганизаций", ПараметрыФормы,
		ЭтаФорма, ЭтаФорма, "АвторизацияОрганизацийЗавершение");
		
	ОткрытьАвторизациюOIDC = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьОрганизации()
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьОрганизации();
	
КонецФункции

&НаКлиенте
Процедура АвторизацияОрганизацийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
		СтраницыПриСменеСтраницы(, Элементы.Страницы.ТекущаяСтраница);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСтартовыйПомошник" 
		И Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации Тогда
	
		ОбновитьСтрокуПоОрганизации(Параметр);
		
	ИначеЕсли ИмяСобытия = "ОбновитьСтартовыйПомошник" 
		И Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки Тогда	
		
		ПеречитатьНастройкиНаСервере();
		
	ИначеЕсли ИмяСобытия = "ПеречитатьОшибкиСтартовыйПомошник" Тогда
		
		ПеречитатьОшибки();
		
	ИначеЕсли ИмяСобытия = "ПеречитатьМоиОрганизацииСтартовыйПомошник" Тогда
		
		ПеречитатьОшибки();
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок"));
		
	ИначеЕсли ИмяСобытия = "Запись_ГруппыДоступа" Тогда
		
		Если Элементы.ГруппаГруппыДоступа.Видимость Тогда
			ОбновитьВидимостьДоступностьГруппДоступа();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ИзмениласьРольОрганизации" Тогда
		
		ОрганизацияСсылка = Параметр;
		ОбновитьРолиПоОрганизации(ОрганизацияСсылка);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьНастройкиПодписанияВСтартовомПомощнике" Тогда
		
		УправлениеВидимостьюДоступностью(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюДоступностью(Форма)

	Элементы = Форма.Элементы;
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ВводЛогинаПароля Тогда 
		
		Если Форма.РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.ЛогинИПарольИApiKey") Тогда 
			
			Элементы.ГруппаЛогинИПарольДД.Видимость = Истина;
			Элементы.ГруппаЧерезПортал.Видимость = Ложь;
			
		ИначеЕсли Форма.РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.ЛогинИПароль") Тогда
			
			Элементы.ГруппаЛогинИПарольДД.Видимость = Истина;
			Элементы.ГруппаЧерезПортал.Видимость = Ложь;
			
		ИначеЕсли Форма.РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.ApiKey") Тогда
			
			Элементы.ГруппаЛогинИПарольДД.Видимость = Ложь;
			Элементы.ГруппаЧерезПортал.Видимость = Ложь;
			
		ИначеЕсли Форма.РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow") Тогда
			
			Элементы.ГруппаЛогинИПарольДД.Видимость = Ложь;
			Элементы.ГруппаЧерезПортал.Видимость = Истина;
			
		КонецЕсли;
		
		Элементы.ГруппаЕстьПользователь.Видимость = Не Форма.НетПользователяДД;
		Элементы.ГруппаНетПользователя.Видимость = Форма.НетПользователяДД;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность Тогда
		
		Элементы.ГруппаИспользуютсяЭкспедиторскиеДокумент.Видимость = Форма.ИспользуютсяЭкспедиторскиеДокумент;
		Элементы.ГруппаЭкспедиторсикеДокументы.Видимость = Не Форма.ИспользуютсяЭкспедиторскиеДокумент;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.МоиОрганизации Тогда
		
		Если Форма.РежимАвторизации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow") Тогда
			Элементы.ОрганизацииДиадокИРолиНаша.Видимость = Ложь;
			Элементы.ОрганизацииДиадокИРолиApiKey.Видимость = Ложь;
		Иначе
			Элементы.ОрганизацииДиадокИРолиНаша.Видимость = Истина;
			Элементы.ОрганизацииДиадокИРолиApiKey.Видимость = Истина;
		КонецЕсли;
		
		Элементы.ГруппаТестовыеОрганизации.Видимость = Не Форма.ИспользуетсяТестовыйСервер;
		
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройкиПодписания Тогда
		
		КоличествоДействующихСертификатов = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихСертификатов();
		Элементы.ТекстДобавленоСертификатов.Заголовок = "Добавлено: " + Строка(КоличествоДействующихСертификатов);
		
		КоличествоДействующихМЧД = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихМЧД();
		Элементы.ТекстЗагруженоМЧД.Заголовок = "Загружено: " + Строка(КоличествоДействующихМЧД);
		
		КоличествоДействующихНастроекПодписания = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихНастроекПодписания();
		Элементы.ТекстДобавленоНастроекПодписания.Заголовок = "Добавлено: " + Строка(КоличествоДействующихНастроекПодписания);
		
		НашиОрганизацииБезНастроекПодписания = КонтурЛогистика_ОбщегоНазначенияСервер.НашиОрганизацииБезНастроекПодписания() ;
		Форма.СписокНашихОрганизацийБезНастроекПодписания.ЗагрузитьЗначения(НашиОрганизацииБезНастроекПодписания);
		Элементы.ТекстОрганизацийБезНастроекПодписания.Видимость = (НашиОрганизацииБезНастроекПодписания.Количество() > 0);
		Элементы.ТекстОрганизацийБезНастроекПодписания.Заголовок = "Организаций без настроек: " + Строка(НашиОрганизацииБезНастроекПодписания.Количество());
		
	КонецЕсли;
	
	РежимOIDCDeviceFlow = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow");
	АвторизацияНаПортале = (Форма.РежимАвторизации = РежимOIDCDeviceFlow);
	Форма.Элементы.ДекорацияРежимАвторизации.Видимость = Не АвторизацияНаПортале;
	Форма.Элементы.ДекорацияЧтоТакоеApiKey.Видимость = Не АвторизацияНаПортале;
	Форма.Элементы.ГруппаДиадокЗаголовок.Видимость = Не АвторизацияНаПортале;
	
КонецПроцедуры

// СтраницаВводЛогинаПароля

&НаКлиенте
Процедура ВводЛогинаПароля_ПроверитьПодключение(Команда)
	
	Если Не ЗначениеЗаполнено(API_Логин) Или Не ЗначениеЗаполнено(API_Пароль) Тогда 
		Сообщить("Укажите Логин и Пароль");
	Иначе
		ПроверитьСоединениеAPI();
	КонецЕсли;
	
	УстановитьДоступностьКнопкиДалее(); 
	
	Если Элементы.ВводЛогинаПароля_ПроверитьПодключение.Видимость = Ложь Тогда 
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаФункциональность;
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Стартовый помощник", "Проверить логин и пароль", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Подключение");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоединениеAPI()

	Попытка
	
		API_СоединениеПроверено = КонтурЛогистика_API_Диадок.Диадок_АПИ_ПроверитьСоединениеDiadocAPI()	
	
	Исключение
		
	    Сообщить(ОписаниеОшибки());
		API_СоединениеПроверено = Ложь;
		
	КонецПопытки;

	Попытка
	
		ПолученныйТокен = КонтурЛогистика_API_Диадок.Диадок_АПИ_Authenticate_ЛогинПароль(API_Логин, API_Пароль);
	    API_АвторизацияЛогинПарольУспешна = ЗначениеЗаполнено(ПолученныйТокен);
		
		Если API_АвторизацияЛогинПарольУспешна Тогда
		
			Элементы.ВводЛогинаПароля_ПроверитьПодключение.Видимость = Ложь;
			ОбновитьПовторноИспользуемыеЗначения();
			
		КонецЕсли;
		
	Исключение
		
	    Сообщить(ОписаниеОшибки());
	    API_АвторизацияЛогинПарольУспешна = Ложь;
		
	КонецПопытки;
	
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаКлиенте
Процедура API_ЛогинПриИзменении(Элемент)
	
	API_АвторизацияЛогинПарольУспешна = Ложь;
	УстановитьДоступностьКнопкиДалее();
	УстановитьНастройку("ЛогинАвторизацииДиадокАПИ", API_Логин);
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаКлиенте
Процедура API_ПарольПриИзменении(Элемент)
	
	API_АвторизацияЛогинПарольУспешна = Ложь;
	УстановитьДоступностьКнопкиДалее();
	УстановитьНастройку("ПарольАвторизацииДиадокАПИ", API_Пароль);
	ПеречитатьОшибки();
	
КонецПроцедуры

// Конец СтраницаВводЛогинаПароля

// СтраницаМоиОрганизации

&НаСервере
Процедура ПеречитатьМоиОрганизацииНаСервере()
	
	Если РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow Тогда
		МассивОрганизацийДД = ПеречитатьМоиОрганизацииНаСервере_OIDC();
	Иначе
		МассивОрганизацийДД = ПеречитатьМоиОрганизацииНаСервере_КлючАПИ();
		
		// Отправить метрику успешной авторизации
		КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьАвторизацию(МассивОрганизацийДД, "Пароль");
	КонецЕсли;
	
	ОрганизацииДиадокИРоли.Сортировать("Наша Убыв, РольГрузоотправитель Убыв, РольПеревозчик Убыв, РольГрузополучатель Убыв");
	
	// Поиск связных организаций
	НайтиИЗаполнитьСвязныеОрганизацииДляОрганизацииДиадок(МассивОрганизацийДД);
	
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаСервере
Функция ПеречитатьМоиОрганизацииНаСервере_OIDC()
	
	МассивОрганизацийДД = Новый Массив;
	ОрганизацииДиадокИРоли.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК ОрганизацияДиадок,
	|	КонтурЛогистика_ОрганизацииДиадок.Наш КАК Наша,
	|	КонтурЛогистика_ОрганизацииДиадок.Грузоотправитель КАК РольГрузоотправитель,
	|	КонтурЛогистика_ОрганизацииДиадок.Перевозчик КАК РольПеревозчик,
	|	КонтурЛогистика_ОрганизацииДиадок.Грузополучатель КАК РольГрузополучатель,
	|	КонтурЛогистика_ОрганизацииДиадок.Оформитель КАК РольОформитель,
	|	КонтурЛогистика_ОрганизацииДиадок.Медик КАК РольМедик,
	|	КонтурЛогистика_ОрганизацииДиадок.ТехОсмотр КАК РольТехОсмотр,
	|	КонтурЛогистика_ОрганизацииДиадок.Одометр КАК РольОдометр,
	|	КонтурЛогистика_ОрганизацииДиадок.Экспедитор КАК РольЭкспедитор,
	|	КонтурЛогистика_ОрганизацииДиадок.Sociability КАК Sociability,
	|	КонтурЛогистика_ОрганизацииДиадок.ID КАК ID,
	|	КонтурЛогистика_ОрганизацииДиадок.СтатусГотовностиКЭПД КАК СтатусГотовностиКЭПД
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш";
	
	ОрганизацииДиадокИРоли.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для Каждого ТекущаяСтрока Из ОрганизацииДиадокИРоли Цикл
		
		ТекущаяСтрока.ПредставлениеРолей = ПредставлениеРолей(ТекущаяСтрока);
		
		// Заполнение ApiKey
		Если РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ApiKey
			Или РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПарольИApiKey Тогда
			
			ТекущаяСтрока.ApiKey = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
				ТекущаяСтрока.ОрганизацияДиадок, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey);
		КонецЕсли;
		
		
		МассивОрганизацийДД.Добавить(ТекущаяСтрока.ОрганизацияДиадок);
		
	КонецЦикла;
	
	Возврат МассивОрганизацийДД;
	
КонецФункции

&НаСервере
Функция ПеречитатьМоиОрганизацииНаСервере_КлючАПИ()
	
	ЕстьОрганизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьОрганизации();
	
	МассивОрганизацийДД = Новый Массив;
	Диадок_МоиОрганизации = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetMyOrganizations();
	
	ОрганизацииДиадокИРоли.Очистить();
	
	Для Каждого ДанныеОднойОрганизации Из Диадок_МоиОрганизации.Organizations Цикл 
		
		ОрганизацияСсылка = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеОднойОрганизации);
		
		НоваяСтрокОрги = ОрганизацииДиадокИРоли.Добавить();
		НоваяСтрокОрги.ОрганизацияДиадок 	= ОрганизацияСсылка;
		НоваяСтрокОрги.Наша 				= ОрганизацияСсылка.Наш;
		НоваяСтрокОрги.РольГрузоотправитель = ОрганизацияСсылка.Грузоотправитель;
		НоваяСтрокОрги.РольПеревозчик 		= ОрганизацияСсылка.Перевозчик;
		НоваяСтрокОрги.РольГрузополучатель 	= ОрганизацияСсылка.Грузополучатель;
		НоваяСтрокОрги.РольОформитель 		= ОрганизацияСсылка.Оформитель;
		НоваяСтрокОрги.РольМедик 			= ОрганизацияСсылка.Медик;
		НоваяСтрокОрги.РольТехОсмотр 		= ОрганизацияСсылка.ТехОсмотр;
		НоваяСтрокОрги.РольОдометр 			= ОрганизацияСсылка.Одометр;
		НоваяСтрокОрги.Sociability			= ОрганизацияСсылка.Sociability;
		НоваяСтрокОрги.ID					= ОрганизацияСсылка.ID;
		НоваяСтрокОрги.ПредставлениеРолей	= ПредставлениеРолей(НоваяСтрокОрги);
		НоваяСтрокОрги.СтатусГотовностиКЭПД	= ОрганизацияСсылка.СтатусГотовностиКЭПД;
		
		// Заполнение ApiKey
		Если Не РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.ЛогинИПароль Тогда
			НоваяСтрокОрги.ApiKey = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
				ОрганизацияСсылка, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey);
		КонецЕсли;
		
		МассивОрганизацийДД.Добавить(ОрганизацияСсылка);
		
	КонецЦикла;
	
	Возврат МассивОрганизацийДД;
	
КонецФункции

&НаСервере
Функция ПредставлениеРолей(СтрокаОрганизации)
	
	Если СтрокаОрганизации.РольГрузоотправитель
		Или СтрокаОрганизации.РольПеревозчик
		Или СтрокаОрганизации.РольГрузополучатель
		Или СтрокаОрганизации.РольЭкспедитор Тогда
		
		РолиЭТрН = Новый Массив;
		Если СтрокаОрганизации.РольГрузоотправитель Тогда
			РолиЭТрН.Добавить("грузоотправитель");
		КонецЕсли;
		Если СтрокаОрганизации.РольПеревозчик Тогда
			РолиЭТрН.Добавить("перевозчик");
		КонецЕсли;
		Если СтрокаОрганизации.РольГрузополучатель Тогда
			РолиЭТрН.Добавить("грузополучатель");
		КонецЕсли;
		Если СтрокаОрганизации.РольЭкспедитор Тогда
			РолиЭТрН.Добавить("экспедитор");
		КонецЕсли;
		
		ПредставлениеРолейЭТрН = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(РолиЭТрН, ", ");
		ПредставлениеРолейЭТрН = ВРег(Лев(ПредставлениеРолейЭТрН, 1)) + Прав(ПредставлениеРолейЭТрН, СтрДлина(ПредставлениеРолейЭТрН) - 1);
		
	Иначе
		
		ПредставлениеРолейЭТрН = "";
		
	КонецЕсли;
	
	Если СтрокаОрганизации.РольОформитель
		Или СтрокаОрганизации.РольМедик
		Или СтрокаОрганизации.РольТехОсмотр
		Или СтрокаОрганизации.РольОдометр Тогда
		
		РолиЭПЛ = Новый Массив;
		Если СтрокаОрганизации.РольОформитель Тогда
			РолиЭПЛ.Добавить("оформитель");
		КонецЕсли;
		Если СтрокаОрганизации.РольМедик Тогда
			РолиЭПЛ.Добавить("медик");
		КонецЕсли;
		Если СтрокаОрганизации.РольТехОсмотр Тогда
			РолиЭПЛ.Добавить("тех. осмотр");
		КонецЕсли;
		Если СтрокаОрганизации.РольОдометр Тогда
			РолиЭПЛ.Добавить("одометр");
		КонецЕсли;
		
		ПредставлениеРолейЭПЛ = "ЭПЛ: " + КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(РолиЭПЛ, ", ");
		
	Иначе
		
		ПредставлениеРолейЭПЛ = "";
		
	КонецЕсли;
	
	ПредставлениеРолей = ПредставлениеРолейЭТрН
		+ ?(ЗначениеЗаполнено(ПредставлениеРолейЭТрН) И ЗначениеЗаполнено(ПредставлениеРолейЭПЛ), ", ", "")
		+ ПредставлениеРолейЭПЛ;
	
	Если ПредставлениеРолей = "" Тогда
		ПредставлениеРолей = "Заполнить";
	КонецЕсли;
	
	Возврат ПредставлениеРолей;
	
КонецФункции

&НаСервере
Процедура НайтиИЗаполнитьСвязныеОрганизацииДляОрганизацииДиадок(МассивОрганизацийДД) // дублирование с КонтурЛогистика_ОрганизацииДиадок НайтиИЗаполнитьСвязныеОрганизацииДляОрганизацииДиадок

	СвязныеОбъекты.Очистить();
	ТаблицаСоответствий = КонтурЛогистика_ОбщегоНазначенияСервер.СоответствиеОрганизацииУСОрганизациямДД(МассивОрганизацийДД);
	
	Если Не ТаблицаСоответствий = Неопределено Тогда 
		
		СвязныеОбъекты.Загрузить(ТаблицаСоответствий);
		
		Для Каждого СтрокаОрганизаций Из ОрганизацииДиадокИРоли Цикл 
			
			СтрокаОрганизаций.ОрганизацииВБазе.Очистить();
			Справочники.КонтурЛогистика_ОрганизацииДиадок.ОбновитьСвязныеОбъектыПоОрганизации(СтрокаОрганизаций.ОрганизацияДиадок, ТаблицаСоответствий);
			
			СтрокаОрганизаций.ОрганизацииВБазе.ЗагрузитьЗначения(СтрокаОрганизаций.ОрганизацияДиадок.СвязанныеОбъекты.ВыгрузитьКолонку("СвязанныйОбъект"));
			
			Если Не СтрокаОрганизаций.ОрганизацииВБазе.Количество() Тогда 
				СтрокаОрганизаций.ТребуемоеДействие = "Сопоставить";
				СтрокаОрганизаций.СопоставленКартинка = 1;
			КонецЕсли;	
				
		КонецЦикла;	
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьМоиОрганизации(Команда)
	
	ПеречитатьМоиОрганизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацииДиадокИРолиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элемент.ТекущиеДанные;
	ОрганизацияСсылка =  ТекСтрока.ОрганизацияДиадок;
	
	Если Поле.Имя = "ОрганизацииДиадокИРолиОрганизацияДиадок" 
		Или Поле.Имя = "ОрганизацииДиадокИРолиОрганизацииВБазе" Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ОрганизацияСсылка);
		
	ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиТребуемоеДействие" И ТекСтрока.ТребуемоеДействие = "" Тогда
		
		Если ТекущийПользовательСБазовымиПравамиМожетРедактироватьСП Тогда
		
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Организация", ОрганизацияСсылка);
			ПараметрыОткрытия.Вставить("СвязанныеОбъекты", ТекСтрока.ОрганизацииВБазе);
			ПараметрыОткрытия.Вставить("ОткрытаИзТЧОрганизацииДиадокИРоли", Истина);
			
			ИмяФормыСправочника = "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаПодбораСвязанныхОбъектов";
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
				"ОбработчикСопоставленияОрганизации",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
							
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(ОрганизацияСсылка);
				
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиТребуемоеДействие" И ТекСтрока.ТребуемоеДействие = "Сопоставить" Тогда 
		
		Если ТекущийПользовательСБазовымиПравамиМожетРедактироватьСП Тогда
		
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Организация", ОрганизацияСсылка);
			ПараметрыОткрытия.Вставить("СвязанныеОбъекты", ТекСтрока.ОрганизацииВБазе);
			ПараметрыОткрытия.Вставить("ОткрытаИзТЧОрганизацииДиадокИРоли", Истина);
			
			ИмяФормыСправочника = "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаПодбораСвязанныхОбъектов";
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
				"ОбработчикСопоставленияОрганизации",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе
							
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента", 
				Новый Структура("Ключ, ПоказатьИнфоОСопоставлении", ОрганизацияСсылка, Истина), 
				ЭтаФорма);
				
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиApiKey" Тогда
		
		СтандартнаяОбработка = Истина;
		
	ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиПредставлениеРолей" Тогда
		
		РолиОрганизации = Новый Структура;
		Для Каждого ИмяРоли Из ВсеРоли() Цикл
			РолиОрганизации.Вставить(ИмяРоли, ТекСтрока["Роль" + ИмяРоли]);
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация", ТекСтрока.ОрганизацияДиадок);
		ПараметрыФормы.Вставить("РолиОрганизации", РолиОрганизации);
		ПараметрыФормы.Вставить("Метрики_Категоря", "Стартовый помощник");
		ПараметрыФормы.Вставить("Метрики_МестоВызова", ЭтаФорма.ИмяФормы);
		ПараметрыФормы.Вставить("Метрики_Действие", "Выбор роли");
		
		ПараметрыОбработчика = Новый Структура;
		ПараметрыОбработчика.Вставить("ИдентификаторСтроки", ТекСтрока.ПолучитьИдентификатор());
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаРедактированияРолей", ПараметрыФормы, ЭтаФорма,
			ЭтаФорма, "РедактированияРолейЗавершение", ПараметрыОбработчика, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		Если Поле.Имя = "ОрганизацииДиадокИРолиНаша" Тогда
			ИмяРеквизита = "Наш";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольГрузоотправитель" Тогда 
			ИмяРеквизита = "Грузоотправитель";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольПеревозчик" Тогда 
			ИмяРеквизита = "Перевозчик";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольГрузополучатель" Тогда
			ИмяРеквизита = "Грузополучатель";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольОформитель" Тогда
			ИмяРеквизита = "Оформитель";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольМедик" Тогда
			ИмяРеквизита = "Медик";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольТехОсмотр" Тогда
			ИмяРеквизита = "ТехОсмотр";
		ИначеЕсли Поле.Имя = "ОрганизацииДиадокИРолиРольОдометр" Тогда
			ИмяРеквизита = "Одометр";
		КонецЕсли;
		
		УстановитьРеквизитОрганизацииДиадок(ИмяРеквизита, ОрганизацияСсылка);
		ОповеститьОбИзменении(ОрганизацияСсылка);
		
		ОрганизацииДиадокИРоли.Сортировать("Наша Убыв, РольГрузоотправитель Убыв, РольПеревозчик Убыв, РольГрузополучатель Убыв");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикСопоставленияОрганизации(Результат, ДополнительныеПараметры) Экспорт

	ТекущаяСтрока = Элементы.ОрганизацииДиадокИРоли.ТекущиеДанные;
	
	МассивОрганизацийДД = Новый Массив;
	МассивОрганизацийДД.Добавить(ТекущаяСтрока.ОрганизацияДиадок);
	НайтиИЗаполнитьСвязныеОрганизацииДляОрганизацииДиадок(МассивОрганизацийДД)
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВсеРоли()
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеРоли();
	
КонецФункции

&НаКлиенте
Процедура РедактированияРолейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ОрганизацииДиадокИРоли.ТекущиеДанные;
	
	ЗапишемРолиВОрганизацию(ТекущиеДанные.ОрганизацияДиадок, Результат);
	
	ОбновитьРолиПоОрганизации(ТекущиеДанные.ОрганизацияДиадок);
	
	// Проверяем наличие приглашения и отправляем если требуется
	ПроверкаОтправкаПриглашенийСТестовымиОрганизациями(ТекущиеДанные.ОрганизацияДиадок);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗапишемРолиВОрганизацию(ОрганизацияДиадок, ДанныеРолей)
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗапишемРолиВОрганизацию(ОрганизацияДиадок, ДанныеРолей);
	
	ЕстьВыбранныеРоли = Ложь;
	Для Каждого ИмяРоли Из ВсеРоли() Цикл
		Если ДанныеРолей[ИмяРоли] Тогда
			ЕстьВыбранныеРоли = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Общепродуктовая метрика настройки организации
	// (сейчас считаем что настройка = выбрана роль у нашей организации и есть соответствие)
	Если ОрганизацияДиадок.Наш
		И ОрганизацияДиадок.СвязанныеОбъекты.Количество() > 0
		И ЕстьВыбранныеРоли Тогда
		
		КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьВыполнениеНастройки(ОрганизацияДиадок, "СтартовыйПомощник");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРолиПоОрганизации(Организация)
	
	ПараметрыОтбора = Новый Структура("ОрганизацияДиадок", Организация);
	НайденныеСтроки = ОрганизацииДиадокИРоли.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = НайденныеСтроки[0];
	
	РолиОрганизации = КонтурЛогистика_ОбщегоНазначенияСервер.РолиОрганизации(ТекущаяСтрока.ОрганизацияДиадок);
	
	ТекущаяСтрока.РольГрузоотправитель  = РолиОрганизации.Грузоотправитель;
	ТекущаяСтрока.РольПеревозчик 		= РолиОрганизации.Перевозчик;
	ТекущаяСтрока.РольГрузополучатель 	= РолиОрганизации.Грузополучатель;
	ТекущаяСтрока.РольОформитель 		= РолиОрганизации.Оформитель;
	ТекущаяСтрока.РольМедик 			= РолиОрганизации.Медик;
	ТекущаяСтрока.РольТехОсмотр 		= РолиОрганизации.ТехОсмотр;
	ТекущаяСтрока.РольОдометр 			= РолиОрганизации.Одометр;
	ТекущаяСтрока.РольЭкспедитор		= РолиОрганизации.Экспедитор;
	
	ДанныеРолей = Новый Структура("РольГрузоотправитель, РольПеревозчик, РольГрузополучатель,
		|РольОформитель, РольМедик, РольТехОсмотр, РольОдометр, РольЭкспедитор");
	ЗаполнитьЗначенияСвойств(ДанныеРолей, ТекущаяСтрока);
	
	ТекущаяСтрока.ПредставлениеРолей = ПредставлениеРолей(ДанныеРолей);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитОрганизацииДиадок(Знач ИмяРеквизита, Знач ОрганизацияСсылка)
	
	Если Не ИмяРеквизита = Неопределено Тогда 
		
		ИзменитьЗначениеРеквизитаОрганизацииДиадок(ОрганизацияСсылка, ИмяРеквизита);
		
		ПеречитатьОшибки();
		
		Если ИмяРеквизита = "Наш"
			Или ИмяРеквизита = "Грузоотправитель"
			Или ИмяРеквизита = "Перевозчик"
			Или ИмяРеквизита = "Грузополучатель" Тогда
			
			// Проверяем наличие приглашения и отправляем если требуется
			ПроверкаОтправкаПриглашенийСТестовымиОрганизациями(ОрганизацияСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
	// общепродуктовая метрика настройки организации (сейчас считаем что настройка = выбрана роль у нашей организации и есть соответствие)
	Если ОрганизацияСсылка.Наш 
		И ОрганизацияСсылка.СвязанныеОбъекты.Количество() > 0
		И (ОрганизацияСсылка.Грузоотправитель
		ИЛИ ОрганизацияСсылка.Перевозчик
		ИЛИ ОрганизацияСсылка.Грузополучатель
		ИЛИ ОрганизацияСсылка.Оформитель
		ИЛИ ОрганизацияСсылка.Медик
		ИЛИ ОрганизацияСсылка.ТехОсмотр
		ИЛИ ОрганизацияСсылка.Одометр) Тогда
		
		КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьВыполнениеНастройки(ОрганизацияСсылка, "СтартовыйПомощник");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗначениеРеквизитаОрганизацииДиадок(ОрганизацииДиадок, ИмяРеквизита)
	
	Для Счет = 1 По 10 Цикл
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			ЗаблокироватьДанныеДляРедактирования(ОрганизацииДиадок);
			
			ОрганизацияОбъект = ОрганизацииДиадок.ПолучитьОбъект();
			ОрганизацияОбъект[ИмяРеквизита] = Не ОрганизацияОбъект[ИмяРеквизита];
			ОрганизацияОбъект.Записать();
			
			РазблокироватьДанныеДляРедактирования(ОрганизацииДиадок);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			КонтурЛогистика_ОбщегоНазначенияСервер.Пауза_(1);
			
			Продолжить;
			
		КонецПопытки;
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокуПоОрганизации(ОрганизацияСсылка)
	
	нСтроки = ОрганизацииДиадокИРоли.НайтиСтроки(Новый Структура("ОрганизацияДиадок", ОрганизацияСсылка));
	
	Если нСтроки.Количество() Тогда 
		
		СтрокаОрганизаций = нСтроки[0];
		
		СтрокаОрганизаций.ОрганизацииВБазе.ЗагрузитьЗначения(ОрганизацияСсылка.СвязанныеОбъекты.ВыгрузитьКолонку("СвязанныйОбъект"));
		
		Если Не СтрокаОрганизаций.ОрганизацииВБазе.Количество() Тогда 
			СтрокаОрганизаций.ТребуемоеДействие = "Сопоставить";
			СтрокаОрганизаций.СопоставленКартинка = 1;
		Иначе	
			СтрокаОрганизаций.ТребуемоеДействие = "";
			СтрокаОрганизаций.СопоставленКартинка = 0;
		КонецЕсли;
		
	КонецЕсли;

	ПеречитатьОшибки();
	
КонецПроцедуры

// Конец СтраницаМоиОрганизации

// СтраницаНастройки

&НаКлиенте
Процедура ПодтвердитьКонфигурацию(Команда)
	
	УстановитьПервичныеНастройкиДляКонфигурации();
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПервичныеНастройкиДляКонфигурации()
	
	ПодтвердитьКонфигурациюНаСервере();
	
	ОтображениеРасширенияСДополнительнымиРеквизитами();
	ОбновитьФорму_ЗапущенаЗагрузкаОбновления(Ложь, "ДополнительныеРеквизиты");
	
	ОтображениеРасширенияQR();
	
	Если ИмяКонфигурации1С = "УАТ_ПРОФ"
		Или ИмяКонфигурации1С = "ERP_УАТ"
		Или ИмяКонфигурации1С = "ТЛЭ" Тогда
		
		Если ПередаватьQRВМПВодительУАТ Тогда
			ПроверитьОбновленияНаКлиенте("QR_МП_УАТ");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьКонфигурациюНаСервере()
	
	ЗаписатьИмяКонфигурацииВОбщиеНастройки();
	СоздатьТиповыеНастройкиНаСервере();
	ПеречитатьНастройкиНаСервере();
	
	УправлениеВидимостьюДоступностьюЭлементовНастроек();
	
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьТиповыеНастройкиНаСервере()
	
	Справочники.КонтурЛогистика_Настройки.ЗаполнитьВсеНастройкиЗначениямиПоУмолчанию(, Истина, Истина);
	УстановитьОбязательныеОбщиеНастройки();
	Справочники.КонтурЛогистика_НастройкиКонвертацииРегистровСведений.ЗаполнитьАвтоматическиДляТекущейКонфигурации();
	
	Для Каждого ТипСправочника Из ТипыСправочников() Цикл
		
		ПоддерживаемыеТипы = КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочника);
		
		Если ПоддерживаемыеТипы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПредопределенного = "Автоконвертация_" + ТипСправочника;
		Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяПредопределенного, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКонфигурацию(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика("Настройки будут удалены. Продолжить?", 
		РежимДиалогаВопрос.ДаНет,,, 
		ЭтаФорма, 
		"ОбработчикУдаленияНастроек");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикУдаленияНастроек(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Сообщить("Действие отменено пользователем.");
		Возврат;
	КонецЕсли;
	
	УдалитьНастройкиКонвертации();
	
	УдалитьНастройкиДополнительногоРасширения();
	Элементы.ГруппаДополнительныеРеквизитыРасширение.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНастройкиКонвертации()

	УдалитьОбязательныеОбщиеНастройки();
	
	Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.УдалитьВсеНастройки();
	Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.УдалитьВсеНастройки();
	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ИмяКонфигурации1С", "");
	
	ПеречитатьНастройкиНаСервере();
	
	ПеречитатьОшибки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИмяКонфигурацииВОбщиеНастройки()
	
	ИмяПеречисления = ТиповаяКонфигурация.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ТиповаяКонфигурация);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;	
	Справочники.КонтурЛогистика_Настройки.УстановитьНастройку("ИмяКонфигурации1С", ИмяЗначенияПеречисления);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНастройкиНаСервере()
	
	ИмяКонфигурации1С = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИмяКонфигурации1С");
	
	ПеречитатьОбщиеНастройки();
	ПеречитатьНастройкиКонвертацииДокументов();
	ПеречитатьНастройкиКонвертацииСправочников();
	
	УправлениеВидимостьюДоступностьюЭлементовНастроек();
	
	// проверка, для орнанизаций проставлена хотя бы одна роль роли, 
	// иначе не создадутся настройки конвертации документов

	Если Не Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиОрганизацииСРолью() Тогда
		
		Элементы.ГруппаНастройки.Доступность = Ложь;
		ВызватьИсключение "Не настроены роли для организаций на вкладке ""Мои организации.""";
		
	КонецЕсли;
	
	Элементы.ГруппаНастройки.Доступность = Истина;
	Элементы.ГруппаСозданныеНастройки.Видимость = Не ЗначениеЗаполнено(ИмяКонфигурации1С);
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьОбщиеНастройки()
	
	УстановитьКартинкуЭлементуФормы(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НастройкиЗаполнены(), Элементы.СостоянияДокументооборотаКартинка);
	УстановитьКартинкуЭлементуФормы(Справочники.КонтурЛогистика_КлассификаторУпаковок.НастройкиЗаполнены(), Элементы.КлассификаторУпаковокКартинка);
	УстановитьКартинкуЭлементуФормы(Справочники.КонтурЛогистика_СтраныМира.НастройкиЗаполнены(), Элементы.СтраныМираКартинка);
	УстановитьКартинкуЭлементуФормы(Справочники.КонтурЛогистика_Настройки.НастройкиВыполнены(), Элементы.ОбщиеНастройкиКартинка);
	
	// настройки хранения данных
	
	СоответствиеНастроек = Справочники.КонтурЛогистика_Настройки.ПолучитьПроверкуНастроекОсобенностейХраненияДанных();
	
	Для Каждого Настройка Из СоответствиеНастроек Цикл 
				
		Если Настройка.Ключ = "ИмяСправочникаХарактеристика" И Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() Тогда 
			Продолжить;
		КонецЕсли;
		
		УстановитьКартинкуЭлементуФормы(Настройка.Значение, Элементы["Картинка" + Настройка.Ключ]);
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНастройкиКонвертацииДокументов()
		
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 1), "Т1");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 2), "Т2");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 3), "Т3");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 4), "Т4");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 5), "Т5");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 6), "Т6");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 7), "Т7");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ТрН_Титул", 8), "Т8");
	
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", 1), "Т1_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", 2), "Т2_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", 3), "Т3_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", 4), "Т4_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", 5), "Т5_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", 6), "Т6_ПЛ");
	
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ЗЗ_Титул", 1), "Т1_ЗЗ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ЗЗ_Титул", 2), "Т2_ЗЗ");
	
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", "1_5_02"), "Т1_5_02_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", "2_5_02"), "Т2_5_02_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", "3_5_02"), "Т3_5_02_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", "4_5_02"), "Т4_5_02_ПЛ");
	УстановитьКартинкуИЗаголовокЭлементамФормы(ЕстьТитул("ПЛ_Титул", "5_5_02"), "Т5_5_02_ПЛ");
			
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНастройкиКонвертацииСправочников()
	
	Для Каждого ТипСправочника Из ТипыСправочников() Цикл
		
		ИмяСправочникаБезПрефикса =  СтрЗаменить(ТипСправочника, "КонтурЛогистика_", "");
		
		ИмяПредопределенного = "Автоконвертация_" + ТипСправочника;
		НастройкаАвтоконвертации = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииСправочника(
			ТипСправочника);
		
		ОформлениеКартинкиКонвертацииСправочника(ИмяСправочникаБезПрефикса,
			НастройкаАвтоконвертации.Значение, Не КонтекстНастройкиКонвертации.ЕстьКонвертация);
		ОформлениеСсылкиКонвертацииСправочника(ИмяСправочникаБезПрефикса, КонтекстНастройкиКонвертации.ЕстьКонвертация);
		ОформлениеТумблераКонвертацииСправочника(ИмяСправочникаБезПрефикса, Не КонтекстНастройкиКонвертации.ЕстьКонвертация);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипыСправочников()
	
	ТипыСправочников = Новый Массив;
	ТипыСправочников.Добавить("КонтурЛогистика_ГорючеСмазочныеМатериалы");
	ТипыСправочников.Добавить("КонтурЛогистика_Договоры");
	ТипыСправочников.Добавить("КонтурЛогистика_Лицензии");
	ТипыСправочников.Добавить("КонтурЛогистика_ОрганизацииДиадок");
	ТипыСправочников.Добавить("КонтурЛогистика_ПодразделенияДиадок");
	ТипыСправочников.Добавить("КонтурЛогистика_ПунктыМаршрута");
	ТипыСправочников.Добавить("КонтурЛогистика_Сотрудники");
	ТипыСправочников.Добавить("КонтурЛогистика_ТранспортныеСредства");
	
	Возврат ТипыСправочников;
	
КонецФункции

&НаСервере
Процедура УстановитьКартинкуИЗаголовокЭлементамФормы(ПоказатьГалочку, Постфикс)
	
	УстановитьКартинкуЭлементуФормы(ПоказатьГалочку, Элементы["КартинкаКонвертация" + Постфикс]);
	
	Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда 
		
		Если ПоказатьГалочку Тогда 
			Элементы["ТекстКонвертация" + Постфикс].Заголовок = СтрЗаменить(Элементы["ТекстКонвертация" + Постфикс].Заголовок, "Создать ", "");
		Иначе
			Элементы["ТекстКонвертация" + Постфикс].Заголовок = "Создать " + СтрЗаменить(Элементы["ТекстКонвертация" + Постфикс].Заголовок, "Создать ", "");
		КонецЕсли;	
		
	Иначе
		
		Элементы["ТекстКонвертация" + Постфикс].Заголовок = СтрЗаменить(Элементы["ТекстКонвертация" + Постфикс].Заголовок, "Создать ", "");
		
	КонецЕсли;

КонецПроцедуры	

&НаСервере
Процедура УстановитьКартинкуЭлементуФормы(ПоказатьГалочку, ЭлементФормы)
		
	Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда 
		
		Если ПоказатьГалочку Тогда 
			ЭлементФормы.Картинка = БиблиотекаКартинок.КонтурЛогистика_Галочка;
		Иначе
			ЭлементФормы.Картинка = БиблиотекаКартинок.КонтурЛогистика_Восклицание;
		КонецЕсли;	
		
	Иначе
		
		ЭлементФормы.Картинка = Новый Картинка;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьТиповуюКонфигурацию()

	ТиповаяКонфигурацияСтрока = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	Попытка
		ТиповаяКонфигурация = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТиповыеКонфигурации1С." + ТиповаяКонфигурацияСтрока);
	Исключение
		ТиповаяКонфигурация = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТиповыеКонфигурации1С.ПустаяСсылка");
	КонецПопытки;	

КонецПроцедуры

&НаСервере
Процедура ОформлениеКартинкиКонвертацииСправочника(ИмяТипаСправочника, ЗначениеНастройки, КонвертацийНет)
		
	Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда 
		
		Если КонвертацийНет И ЗначениеНастройки = Истина Тогда
			
			Элементы["КартинкаКонвертация" + ИмяТипаСправочника].Картинка = БиблиотекаКартинок.КонтурЛогистика_Восклицание;
			
		Иначе
			
			Элементы["КартинкаКонвертация" + ИмяТипаСправочника].Картинка = БиблиотекаКартинок.КонтурЛогистика_Галочка;	
			
		КонецЕсли;
		
	Иначе
		
		Элементы["КартинкаКонвертация" + ИмяТипаСправочника].Картинка = Новый Картинка;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОформлениеСсылкиКонвертацииСправочника(ИмяТипаСправочника, ЕстьКонвертация)
	
	Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда 
		
		Если ЕстьКонвертация Тогда
			
			Элементы["СсылкаКонвертация" + ИмяТипаСправочника].Заголовок = "конвертация";
			
		Иначе
			
			Элементы["СсылкаКонвертация" + ИмяТипаСправочника].Заголовок = "Создать";
			
		КонецЕсли;
		
	Иначе
		
		Элементы["СсылкаКонвертация" + ИмяТипаСправочника].Заголовок = "Создать";
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОформлениеТумблераКонвертацииСправочника(ИмяТипаСправочника, ЕстьКонвертация)
	
	Элементы["Вкл" + ИмяТипаСправочника].Видимость = Не ЕстьКонвертация;
	Элементы["Выкл" + ИмяТипаСправочника].Видимость = ЕстьКонвертация;
	
КонецПроцедуры

&НаКлиенте
Процедура ВклНажатие(Элемент)
	
	ИмяСправочникаБезПрефикса = СтрЗаменить(Элемент.Имя, "Вкл", "");
	
	ВклВыклНастройкуАвтоконвертацииНаСервере(ИмяСправочникаБезПрефикса, Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыклНажатие(Элемент)
	
	ИмяСправочникаБезПрефикса = СтрЗаменить(Элемент.Имя, "Выкл", "");
	
	ВклВыклНастройкуАвтоконвертацииНаСервере(ИмяСправочникаБезПрефикса);
	
КонецПроцедуры

&НаСервере
Процедура ВклВыклНастройкуАвтоконвертацииНаСервере(ИмяСправочника, Включить = Истина)
	
	ИмяПредопределенного = "Автоконвертация_КонтурЛогистика_" + ИмяСправочника;
	НастройкаАвтоконвертации = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
	
	Если ЗначениеЗаполнено(НастройкаАвтоконвертации) Тогда 
	
		ОбъектНастройки = НастройкаАвтоконвертации.ПолучитьОбъект();
		ОбъектНастройки.Значение = Включить;
		ОбъектНастройки.Записать();
	
	КонецЕсли;
	
	КонвертацийНет = Элементы["СсылкаКонвертация" + ИмяСправочника].Заголовок = "Создать";
	
	ОформлениеКартинкиКонвертацииСправочника(ИмяСправочника, Включить, КонвертацийНет);  
	ОформлениеТумблераКонвертацииСправочника(ИмяСправочника, Включить);
	
	ПеречитатьОшибки();
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура УдалитьОбязательныеОбщиеНастройки()

	Для Каждого ИмяНастройки Из МассивИменОбязательныхОбщихНастроек() Цикл 
	
		Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(ИмяНастройки, "");
	
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьОбязательныеОбщиеНастройки()

	ТаблицаНастроек = Справочники.КонтурЛогистика_Настройки.ПолучитьГруппу_ОсобенностиХраненияДанных(Истина);

	Для Каждого Настройка Из ТаблицаНастроек Цикл 
		
		// Пропускаем группы
		Если Настройка.Ссылка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;

		Справочники.КонтурЛогистика_Настройки.УстановитьНастройку(Настройка.ИмяНастройки, Настройка.Значение);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МассивИменОбязательныхОбщихНастроек()

	Массив = Новый Массив;
	
	Массив.Добавить("ИмяПВХДопСвойства");
	Массив.Добавить("ИмяРегистраДопСвойства");
	Массив.Добавить("ИмяСправочникаЕдиницаИзмерения");
	Массив.Добавить("ИмяСправочникаНоменклатура");
	Массив.Добавить("ИмяСправочникаПользователи");
	Массив.Добавить("ИмяСправочникаВалюты");
	Массив.Добавить("ИмяСправочникаУпаковка");
	Массив.Добавить("ИмяСправочникаХарактеристика");

	Возврат Массив;
	
КонецФункции

&НаСервере
Процедура УправлениеВидимостьюДоступностьюЭлементовНастроек()
	
	// Типовая конфигурация
	
	Если ЗначениеЗаполнено(ИмяКонфигурации1С) Тогда 
		
		Элементы.ТиповаяКонфигурация.Доступность = Ложь;
		Элементы.ТиповаяКонфигурация.Заголовок = "Конфигурация, записанная в общих настройках";
		
		Элементы.ПодтвердитьКонфигурацию.Видимость 	= Ложь;
		Элементы.ИзменитьКонфигурацию.Видимость 	= Истина;
		
		Элементы.ГруппаСозданныеНастройки.Видимость = Ложь;
		
		Элементы.ГруппаИмяСправочникаХарактеристика.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() 
																	И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики"); 
		
	Иначе	
		
		Элементы.ТиповаяКонфигурация.Доступность = Истина;
		Элементы.ТиповаяКонфигурация.Заголовок = "Ваша типовая конфигурация";
		
		Элементы.ПодтвердитьКонфигурацию.Видимость 	= Истина;
		Элементы.ИзменитьКонфигурацию.Видимость 	= Ложь;
		
		Элементы.ГруппаСозданныеНастройки.Видимость = Истина;
		
	КонецЕсли;	
	
	// Общие настройки
	
	// Нвстройки конвертации документов
	
	ЕстьГО = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГОВОрганизациях();
	ЕстьГП = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиГПВОрганизациях();
	ЕстьПВ = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашиПВВОрганизациях();

	Элементы.ГруппаКонвертацияТ1.Видимость = ЕстьГО;
	Элементы.ГруппаКонвертацияТ2.Видимость = ЕстьПВ;
	Элементы.ГруппаКонвертацияТ3.Видимость = ЕстьГП Или ЕстьГО;
	Элементы.ГруппаКонвертацияТ4.Видимость = ЕстьПВ;
	Элементы.ГруппаКонвертацияТ5.Видимость = ЕстьПВ;
	Элементы.ГруппаКонвертацияТ6.Видимость = ЕстьГО;
	Элементы.ГруппаКонвертацияТ7.Видимость = ЕстьПВ;
	Элементы.ГруппаКонвертацияТ8.Видимость = ЕстьПВ;
	
	Элементы.ГруппаКонвертацияТ1_ЗЗ.Видимость = ИспользуютсяЗаказЗаявки И ЕстьГО;
	Элементы.ГруппаКонвертацияТ2_ЗЗ.Видимость = ИспользуютсяЗаказЗаявки И ЕстьПВ;

	ЕстьОформитель 	= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Оформитель");
	ЕстьМедик 		= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Медик");
	ЕстьТехОсмотр 	= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("ТехОсмотр");
	ЕстьОдометр 	= Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьНашаРольВОрганизациях("Одометр");
	
	Элементы.ГруппаКонвертацияТ1_ПЛ.Видимость = ИспользуютсяПутевыеЛисты И ЕстьОформитель;
	Элементы.ГруппаКонвертацияТ2_ПЛ.Видимость = ИспользуютсяПутевыеЛисты И ЕстьМедик;
	Элементы.ГруппаКонвертацияТ3_ПЛ.Видимость = ИспользуютсяПутевыеЛисты И ЕстьТехОсмотр;
	Элементы.ГруппаКонвертацияТ4_ПЛ.Видимость = ИспользуютсяПутевыеЛисты И ЕстьОдометр;
	Элементы.ГруппаКонвертацияТ5_ПЛ.Видимость = ИспользуютсяПутевыеЛисты И ЕстьОдометр;
	Элементы.ГруппаКонвертацияТ6_ПЛ.Видимость = ИспользуютсяПутевыеЛисты И ЕстьМедик;
		
	Элементы.ГруппаКонвертацияТ1_5_02_ПЛ.Видимость = (ИспользуютсяПутевыеЛисты_5_02 Или ИспользуютсяПутевыеЛисты) И ЕстьОформитель;
	Элементы.ГруппаКонвертацияТ2_5_02_ПЛ.Видимость = (ИспользуютсяПутевыеЛисты_5_02 Или ИспользуютсяПутевыеЛисты) И ЕстьМедик;
	Элементы.ГруппаКонвертацияТ3_5_02_ПЛ.Видимость = (ИспользуютсяПутевыеЛисты_5_02 Или ИспользуютсяПутевыеЛисты) И ЕстьОформитель;
	Элементы.ГруппаКонвертацияТ4_5_02_ПЛ.Видимость = (ИспользуютсяПутевыеЛисты_5_02 Или ИспользуютсяПутевыеЛисты) И ЕстьОформитель;
	Элементы.ГруппаКонвертацияТ5_5_02_ПЛ.Видимость = (ИспользуютсяПутевыеЛисты_5_02 Или ИспользуютсяПутевыеЛисты) И ЕстьМедик;
	
	Если ИспользуютсяПутевыеЛисты И Не ЕстьОформитель И Не ЕстьМедик И Не ЕстьТехОсмотр И Не ЕстьОдометр Тогда
		Сообщить("Не указаны роли путевого листа ни для одной организации");
	КонецЕсли;
	
	Элементы.ГруппаКонвертацияТ1.Видимость = ИспользуютсяТРН И ЕстьГО;
	Элементы.ГруппаКонвертацияТ2.Видимость = ИспользуютсяТРН И ЕстьПВ;
	Элементы.ГруппаКонвертацияТ3.Видимость = ИспользуютсяТРН И ЕстьГП;
	Элементы.ГруппаКонвертацияТ4.Видимость = ИспользуютсяТРН И ЕстьПВ;
	Элементы.ГруппаКонвертацияТ5.Видимость = ИспользуютсяТРН И ЕстьПВ;
	Элементы.ГруппаКонвертацияТ6.Видимость = ИспользуютсяТРН И ЕстьГО;
	Элементы.ГруппаКонвертацияТ7.Видимость = ИспользуютсяТРН И ЕстьПВ;
	Элементы.ГруппаКонвертацияТ8.Видимость = ИспользуютсяТРН И ЕстьПВ;
	
