	УстановитьНастройку("ИспользуетсяСкладскаяРасписка", ИспользуетсяСкладскаяРасписка,
		ТекущийПользовательСБазовымиПравамиМожетРедактироватьСП);
	
	Оповестить("ОбновитьРабочийСтол");
	
	УправлениеВидимостьюДоступностью(ЭтаФорма);
	
	ДокументыИзменены = Истина;
	
