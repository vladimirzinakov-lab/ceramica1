#Область Метрики

&НаСервере
Процедура ОтправитьМетрики()
	
	Если ТипЗнч(НачальныеДанныеДляМетрик) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьПоведенческиеМетрики();	
	ОтправитьСтатистическиеМетрики();
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьПоведенческиеМетрики()
	
	// отправляем метрики только если пользователь открывал соответствующие закладки
	
	Если НачальныеДанныеДляМетрик.Свойство(Элементы.ВводЛогинаПароля.Имя) Тогда
	
		Если НачальныеДанныеДляМетрик.ТипПрокси <> Прокси_РежимПрокси Тогда 
			ДопИнформация = Новый Структура("ТипПрокси", Строка(Прокси_РежимПрокси));
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Стартовый помощник", "Изменить параметры прокси", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Подключение",, ДопИнформация);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НачальныеДанныеДляМетрик.Свойство(Элементы.СтраницаФункциональность.Имя) И ДокументыИзменены Тогда
	
		ДопИнформация = Новый Структура("ЭТрН", Формат(ИспользуютсяТРН, "БЛ=true; БИ=false"));
		ДопИнформация = Новый Структура("ЗЗ", 	Формат(ИспользуютсяЗаказЗаявки, "БЛ=true; БИ=false"));
		ДопИнформация = Новый Структура("ПЛ",	Формат(ИспользуютсяПутевыеЛисты Или ИспользуютсяПутевыеЛисты_5_02, "БЛ=true; БИ=false"));
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Стартовый помощник", "Выбрать документы", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Документы",, ДопИнформация);
		
	КонецЕсли;
	
	Если НачальныеДанныеДляМетрик.Свойство(Элементы.МоиОрганизации.Имя) Тогда
	
		Для каждого Строка Из ОрганизацииДиадокИРоли Цикл
			
			Если Не Строка.ОрганизацияДиадок.Наш Или Не НачальныеДанныеДляМетрик.Свойство("СвязанныеОрганизации") Тогда
				Продолжить;
			КонецЕсли;
			
			Ключ = "_" + СтрЗаменить(Строка.ОрганизацияДиадок.ID, "-", "");
			
			Если Не НачальныеДанныеДляМетрик.СвязанныеОрганизации.Свойство(Ключ) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Строка.ОрганизацияДиадок.СвязанныеОбъекты.Количество() > НачальныеДанныеДляМетрик.СвязанныеОрганизации[Ключ].КоличествоСвязанныхОбъектов Тогда
					
				КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
					"Стартовый помощник", "Сопоставить с организацией 1С", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Организации");
		        			
			КонецЕсли;
			
			Если РолиИзменены(НачальныеДанныеДляМетрик.СвязанныеОрганизации[Ключ], Строка.ОрганизацияДиадок) Тогда
				
				ДопИнформация = Новый Структура("ГО", 			Формат(Строка.ОрганизацияДиадок.Грузоотправитель, 	"БЛ=true; БИ=false"));
				ДопИнформация = Новый Структура("ПРВ", 			Формат(Строка.ОрганизацияДиадок.Перевозчик, 		"БЛ=true; БИ=false"));
				ДопИнформация = Новый Структура("ГП", 			Формат(Строка.ОрганизацияДиадок.Грузополучатель, 	"БЛ=true; БИ=false"));
				ДопИнформация = Новый Структура("Оформитель",	Формат(Строка.ОрганизацияДиадок.Оформитель, 		"БЛ=true; БИ=false"));
				ДопИнформация = Новый Структура("Медик", 		Формат(Строка.ОрганизацияДиадок.Медик, 				"БЛ=true; БИ=false"));
				ДопИнформация = Новый Структура("ТехОсмотр", 	Формат(Строка.ОрганизацияДиадок.ТехОсмотр, 			"БЛ=true; БИ=false"));
				ДопИнформация = Новый Структура("Одометр", 		Формат(Строка.ОрганизацияДиадок.Одометр, 			"БЛ=true; БИ=false"));
				КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
					"Стартовый помощник", "Выбрать роли", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Организации",, ДопИнформация);
				
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЕсли;
	
	Если НачальныеДанныеДляМетрик.Свойство(Элементы.СтраницаНастройкиПрав.Имя) Тогда
	
		ИмяСправочникаГруппыДоступа = "Справочники.ГруппыДоступа";
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные(ИмяСправочникаГруппыДоступа) Тогда
			
			ДанныеПоГруппамДоступа = ДанныеПоГруппамДоступа();
			
			Если ДанныеПоГруппамДоступа.Администратор.КоличествоПользователей <> Неопределено
				И НачальныеДанныеДляМетрик.Свойство("КоличествоАдминистраторов") Тогда
				КоличествоАдминистраторов = ДанныеПоГруппамДоступа.Администратор.КоличествоПользователей - НачальныеДанныеДляМетрик.КоличествоАдминистраторов;
				Если КоличествоАдминистраторов > 0 Тогда
					КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
						"Стартовый помощник", "Добавить администратора", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Права");	
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеПоГруппамДоступа.ПродвинутыйПользователь.КоличествоПользователей <> Неопределено
				И НачальныеДанныеДляМетрик.Свойство("КоличествоПродвинутыхПользователей") Тогда
				КоличествоПродвинутыхПользователей = ДанныеПоГруппамДоступа.ПродвинутыйПользователь.КоличествоПользователей - НачальныеДанныеДляМетрик.КоличествоПродвинутыхПользователей;
				Если КоличествоПродвинутыхПользователей > 0 Тогда
					КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
						"Стартовый помощник", "Добавить продвинутого пользователя", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Права");	
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеПоГруппамДоступа.Пользователь.КоличествоПользователей <> Неопределено
				И НачальныеДанныеДляМетрик.Свойство("КоличествоПользователей") Тогда
				КоличествоПользователей = ДанныеПоГруппамДоступа.Пользователь.КоличествоПользователей - НачальныеДанныеДляМетрик.КоличествоПользователей;
				Если КоличествоПользователей > 0 Тогда
					КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
						"Стартовый помощник", "Добавить пользователя", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Права");	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НачальныеДанныеДляМетрик.Свойство(Элементы.СтраницаНастройки.Имя)
		И НачальныеДанныеДляМетрик.Свойство("ТиповаяКонфигурация") Тогда
	
		Если ТиповаяКонфигурация <> НачальныеДанныеДляМетрик.ТиповаяКонфигурация Тогда
			
			Если ТиповаяКонфигурация = Перечисления.КонтурЛогистика_ТиповыеКонфигурации1С.ПустаяСсылка() Тогда
				Action = "Выбрать конфигурацию";	
			Иначе
				Action = "Изменить конфигурацию";
			КонецЕсли;
			
			ДопИнформация = Новый Структура("ИмяКонфигурации", Строка(ТиповаяКонфигурация));
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Стартовый помощник", Action, "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Настройки конфигурации",, ДопИнформация);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НачальныеДанныеДляМетрик.Свойство(Элементы.СтраницаНастройкиПодписания.Имя) Тогда
	
		КоличествоСертификатов = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихСертификатов();
		Если НачальныеДанныеДляМетрик.Свойство("КоличествоСертификатов")
			И КоличествоСертификатов > НачальныеДанныеДляМетрик.КоличествоСертификатов Тогда
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Стартовый помощник", "Добавить сертификат", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Настройки подписания");	
		КонецЕсли;
		
		КоличествоМЧД = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихМЧД();
		Если НачальныеДанныеДляМетрик.Свойство("КоличествоМЧД")
			И КоличествоМЧД > НачальныеДанныеДляМетрик.КоличествоМЧД Тогда
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Стартовый помощник", "Добавить МЧД", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Настройки подписания");	
		КонецЕсли;
		
		КоличествоНастроекПодписания = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихНастроекПодписания();
		Если НачальныеДанныеДляМетрик.Свойство("КоличествоНастроекПодписания")
			И КоличествоНастроекПодписания > НачальныеДанныеДляМетрик.КоличествоНастроекПодписания Тогда
			КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
				"Стартовый помощник", "Добавить настройки подписания", "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", "Настройки подписания");	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьСтатистическиеМетрики()
	
	Переменные = Новый Структура;
	
	Если НачальныеДанныеДляМетрик.Свойство("ДатаНачалаРаботыСП") Тогда 
		Переменные.Вставить("ВремяПрохожденияСП", ТекущаяДата() - НачальныеДанныеДляМетрик.ДатаНачалаРаботыСП);
	КонецЕсли;
	
	Если Метрика_ВыполнитьАвторизацию Тогда
		Переменные.Вставить("ВыполнитьАвторизацию", "true");	
	Иначе
		Переменные.Вставить("ВыполнитьАвторизацию", "false");
	КонецЕсли;
	
	Если ДокументыИзменены И
		(ИспользуютсяТРН Или ИспользуютсяЗаказЗаявки Или ИспользуютсяПутевыеЛисты Или ИспользуютсяПутевыеЛисты_5_02) Тогда
		Переменные.Вставить("ВыбратьДокумент", "true");		
	Иначе
		Переменные.Вставить("ВыбратьДокумент", "false");		
	КонецЕсли;
	
	Для каждого Строка Из ОрганизацииДиадокИРоли Цикл
		
		Если Не Строка.ОрганизацияДиадок.Наш Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = "_" + СтрЗаменить(Строка.ОрганизацияДиадок.ID, "-", "");
		
		Если НачальныеДанныеДляМетрик.Свойство("СвязанныеОрганизации")
			И НачальныеДанныеДляМетрик.СвязанныеОрганизации.Свойство(Ключ)
			И РолиИзменены(НачальныеДанныеДляМетрик.СвязанныеОрганизации[Ключ], Строка.ОрганизацияДиадок) Тогда
			Переменные.Вставить("ВыбратьРоли", "true");	
		Иначе
			Переменные.Вставить("ВыбратьРоли", "false");	
		КонецЕсли;
		
	КонецЦикла;	
	
	КоличествоСертификатов = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихСертификатов();
	Если НачальныеДанныеДляМетрик.Свойство("КоличествоСертификатов")
		И КоличествоСертификатов > НачальныеДанныеДляМетрик.КоличествоСертификатов Тогда
		Переменные.Вставить("ДобавитьСертификат", "true");
	Иначе
		Переменные.Вставить("ДобавитьСертификат", "false");
	КонецЕсли;
	
	КоличествоМЧД = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихМЧД();
	Если НачальныеДанныеДляМетрик.Свойство("КоличествоМЧД")
		И КоличествоМЧД > НачальныеДанныеДляМетрик.КоличествоМЧД Тогда
		Переменные.Вставить("ДобавитьМЧД", "true");
	Иначе
		Переменные.Вставить("ДобавитьМЧД", "false");
	КонецЕсли;
	
	КоличествоНастроекПодписания = КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихНастроекПодписания();
	Если НачальныеДанныеДляМетрик.Свойство("КоличествоНастроекПодписания")
		И КоличествоНастроекПодписания > НачальныеДанныеДляМетрик.КоличествоНастроекПодписания Тогда
		Переменные.Вставить("ДобавитьНастройкуПодписания", "true");
	Иначе
		Переменные.Вставить("ДобавитьНастройкуПодписания", "false");
	КонецЕсли;
	
	Если НачальныеДанныеДляМетрик.Свойство("ТиповаяКонфигурация")
		И ТиповаяКонфигурация <> НачальныеДанныеДляМетрик.ТиповаяКонфигурация Тогда 			
		Переменные.Вставить("ВыбратьКонфигурацию", "true");			
	Иначе			
		Переменные.Вставить("ВыбратьКонфигурацию", "false");			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Справочники.КонтурЛогистика_ОрганизацииДиадок.ЛюбаяНашаОрганизация()) Тогда
		Label = "Повторный запуск";
	Иначе
		Label = "Первый запуск";
	КонецЕсли;
	
	Если Метрика_ПриступитьКРаботе Тогда
		Action = "Приступить к работе"; 		
	Иначе
		Action = "Закрытие стартового помощника";		
	КонецЕсли;
		
	КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(
		Переменные, "Стартовый помощник", Action, "Обработка.КонтурЛогистика_СтартовыйПомощник.Форма.Форма", Label);		
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальныеДанныеДляМетрик()
	
	НачальныеДанныеДляМетрик = Новый Структура;
	НачальныеДанныеДляМетрик.Вставить("ТипПрокси", Прокси_РежимПрокси);
	
	ИмяСправочникаГруппыДоступа = "Справочники.ГруппыДоступа";
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные(ИмяСправочникаГруппыДоступа) Тогда
		
		ДанныеПоГруппамДоступа = ДанныеПоГруппамДоступа();
		
		Если ДанныеПоГруппамДоступа.Администратор.КоличествоПользователей = Неопределено Тогда
			КоличествоАдминистраторов = 0;
		Иначе
			КоличествоАдминистраторов = ДанныеПоГруппамДоступа.Администратор.КоличествоПользователей;
		КонецЕсли;		
		НачальныеДанныеДляМетрик.Вставить("КоличествоАдминистраторов", КоличествоАдминистраторов);
		
		Если ДанныеПоГруппамДоступа.ПродвинутыйПользователь.КоличествоПользователей = Неопределено Тогда
			КоличествоПродвинутыхПользователей = 0;
		Иначе
			КоличествоПродвинутыхПользователей = ДанныеПоГруппамДоступа.ПродвинутыйПользователь.КоличествоПользователей;
		КонецЕсли;		
		НачальныеДанныеДляМетрик.Вставить("КоличествоПродвинутыхПользователей", КоличествоПродвинутыхПользователей);
		
		Если ДанныеПоГруппамДоступа.Пользователь.КоличествоПользователей = Неопределено Тогда
			КоличествоПользователей = 0;
		Иначе
			КоличествоПользователей = ДанныеПоГруппамДоступа.Пользователь.КоличествоПользователей;
		КонецЕсли;		
		НачальныеДанныеДляМетрик.Вставить("КоличествоПользователей", КоличествоПользователей);
		
	КонецЕсли;
	
	НачальныеДанныеДляМетрик.Вставить("КоличествоСертификатов", КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихСертификатов());
	НачальныеДанныеДляМетрик.Вставить("КоличествоМЧД", КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихМЧД());
	НачальныеДанныеДляМетрик.Вставить("КоличествоНастроекПодписания", КонтурЛогистика_ОбщегоНазначенияСервер.КоличествоДействующихНастроекПодписания());
	
	НачальныеДанныеДляМетрик.Вставить("ТиповаяКонфигурация", ТиповаяКонфигурация);
	
	НачальныеДанныеДляМетрик.Вставить(Элементы.Страницы.ТекущаяСтраница.Имя);
	
	НачальныеДанныеДляМетрик.Вставить("ДатаНачалаРаботыСП", ТекущаяДата());
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОрганизацииИРолиВНачальныеДанныеДляМетрик()
	
	Если ТипЗнч(НачальныеДанныеДляМетрик) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СвязанныеОрганизации = Новый Структура;
		
	Для каждого Строка Из ОрганизацииДиадокИРоли Цикл
		
		Если Не Строка.ОрганизацияДиадок.Наш Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеОрганизации = Новый Структура;
		ДанныеОрганизации.Вставить("КоличествоСвязанныхОбъектов", Строка.ОрганизацияДиадок.СвязанныеОбъекты.Количество());
		
		Роли = РолиОрганизации();	
		Для каждого Роль Из Роли Цикл
			ДанныеОрганизации.Вставить(Роль, Строка.ОрганизацияДиадок[Роль]);	
		КонецЦикла;
		
		Ключ = "_" + СтрЗаменить(Строка.ОрганизацияДиадок.ID, "-", "");
		СвязанныеОрганизации.Вставить(Ключ, ДанныеОрганизации);
		
	КонецЦикла;
	
	НачальныеДанныеДляМетрик.Вставить("СвязанныеОрганизации", СвязанныеОрганизации); 
	
КонецПроцедуры

&НаСервере
Функция РолиИзменены(НачальныеРоли, ОрганизацияДиадок)
	
	Роли = РолиОрганизации();
	
	Для каждого Роль Из Роли Цикл
		Если НачальныеРоли[Роль] <>	ОрганизацияДиадок[Роль] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции
	
&НаСервере
Функция РолиОрганизации()
	
	Результат = Новый Массив;
	
	Результат.Добавить("Грузоотправитель");
	Результат.Добавить("Перевозчик");
	Результат.Добавить("Грузополучатель");
	Результат.Добавить("Оформитель");
	Результат.Добавить("Медик");
	Результат.Добавить("ТехОсмотр");
	Результат.Добавить("Одометр");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти