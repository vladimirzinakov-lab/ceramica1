
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("УправляемаяФорма") Тогда
		ПараметрыВыполненияКоманды.Источник.РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ДокументыЭТРН = ДокументыКоманды(ПараметрКоманды);
	Если ДокументыЭТРН.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСостоянияНаСервере(ДокументыЭТРН);
	
	Для Каждого ДокументСсылка Из ДокументыЭТРН Цикл
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОповеститьОбИзмененииДокумента(ДокументСсылка);
	КонецЦикла;
	
	Оповестить("КонтурЛогистика_ОбновитьЗадачи");
	
КонецПроцедуры

&НаКлиенте
Функция ДокументыКоманды(ПараметрКоманды)
	
	ДокументыЭТРН = Новый Массив;
	
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Для Каждого ДокументСсылка Из ПараметрКоманды Цикл
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				ДокументыЭТРН.Добавить(ДокументСсылка);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ПараметрКоманды) Тогда
		ДокументыЭТРН.Добавить(ПараметрКоманды);
	КонецЕсли;
	
	Возврат ДокументыЭТРН;
	
КонецФункции

&НаСервере
Процедура ОбновитьСостоянияНаСервере(ДокументыЭТРН)
	
	Для Каждого ДокументЭТРН Из ДокументыЭТРН Цикл
		Если ТипЗнч(ДокументЭТРН) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
			ОбновитьСостояниеДокумента(ДокументЭТРН);
		Иначе
			РеквизитыДокумента = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(ДокументЭТРН, "ДокументЭТРН");
			ОбновитьСостояниеДокумента(РеквизитыДокумента.ДокументЭТРН);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеДокумента(ДокументЭТРН)
	
	// Запрашивает статус перевозки в API Логистики и пишет срез регистра ДО только при изменении.
	
	РеквизитыДокумента = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(ДокументЭТРН, "kl_id");
	ИдентификаторПеревозки = СокрЛП(РеквизитыДокумента.kl_id);
	
	Если Не ЗначениеЗаполнено(ИдентификаторПеревозки) Тогда
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("У документа %1 не заполнен идентификатор перевозки.", ДокументЭТРН),
			ДокументЭТРН);
		Возврат;
	КонецЕсли;
	
	ОрганизацияДиадок = РегистрыСведений.КонтурЛогистика_ОчередьОтправкиQRКодов.АвторизованнаяОрганизацияПоДокументу(
		ДокументЭТРН);
	Если Не ЗначениеЗаполнено(ОрганизацияДиадок) Тогда
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Не удалось определить авторизованную организацию для документа %1.", ДокументЭТРН),
			ДокументЭТРН);
		Возврат;
	КонецЕсли;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияДиадок);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Не выполнена авторизация в сервисе Логистика для документа %1.", ДокументЭТРН),
			ДокументЭТРН);
		Возврат;
	КонецЕсли;
	
	Попытка
		СведенияОПеревозке = КонтурЛогистика_API_Логистика.ПолучитьСведенияОПеревозке(
			ПараметрыСервиса, ИдентификаторПеревозки);
	Исключение
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Не удалось получить сведения о перевозке по документу %1. %2",
				ДокументЭТРН,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())),
			ДокументЭТРН);
		Возврат;
	КонецПопытки;
	
	СтатусСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ЗначениеПоПутиИзДанныхСоответствий(
		СведенияОПеревозке, "transportationInfo.status");
	Если Не ЗначениеЗаполнено(СтатусСервиса) Тогда
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Сервис Логистика не вернул статус перевозки для документа %1.", ДокументЭТРН),
			ДокументЭТРН);
		Возврат;
	КонецЕсли;
	
	СостояниеСервиса = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоАнглНаименованиюСостояниюСервиса(
		СтатусСервиса);
	Если Не ЗначениеЗаполнено(СостояниеСервиса) Тогда
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Не удалось сопоставить статус «%1» для документа %2.", СтатусСервиса, ДокументЭТРН),
			ДокументЭТРН);
		Возврат;
	КонецЕсли;
	
	НовоеСостояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НовоеСостоянийПоУсловиям(
		СостояниеСервиса, ДокументЭТРН);
	Если НовоеСостояние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееСостояние = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ДокументЭТРН);
	Если ТекущееСостояние = НовоеСостояние Тогда
		Возврат;
	КонецЕсли;
	
	ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(
		Неопределено, Неопределено, Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика);
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
		ДокументЭТРН, НовоеСостояние,,,, ДопДанные);
	
КонецПроцедуры