<?xml version="1.0" encoding="UTF-8"?>
<mdclass:CommonCommand xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="838b9c56-51f6-43a2-a262-d431e00dd307">
  <name>КонтурЛогистика_ПропуститьДокумент</name>
  <synonym>
    <key>ru</key>
    <value>Пропустить задачу (документ)</value>
  </synonym>
  <group>CommandGroup.КонтурЛогистика_КомандыВводаДокументов</group>
  <commandParameterType>
    <types>DefinedType.КонтурЛогистика_ОбщаяКомандаДокументыУчетнойСистемыИДокументыКонтурЛогистика</types>
  </commandParameterType>
  <parameterUseMode>Multiple</parameterUseMode>
  <representation>PictureAndText</representation>
  <toolTip>
    <key>ru</key>
    <value>Пропустить документ(ы). Требуется для отражения в системе факта оформления операции в веб-интерфейсе, в другой системе или в иных случаях, когда принято решение не выполнять задачу, поставленную системой. Введет документы  и установит их пропущенными.</value>
  </toolTip>
  <picture xsi:type="core:PictureRef">
    <picture>CommonPicture.КонтурЛогистика_Пропустить</picture>
  </picture>
  <shortcut>Ctrl+BackSpace</shortcut>
</mdclass:CommonCommand>
