#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьОписаниеКлючейПоиска() Экспорт
	
	// Поиск договора осуществляется по:
	// 1. Организация + Контрагент + Номер договора + Дата договора
	// 2. Организация + Номер договора + Дата договора
	// 3. Организация + Идентификатор файла документа
	
	ШаблонСтрокиПоиска = " И КонтурЛогистика_Справочник.%1 = &%1";
	
	КлючиПоиска = Новый Массив;
	
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска,
		"Организация,Контрагент,НомерДокумента,ДатаДокумента", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска,
		"Организация,НомерДокумента,ДатаДокумента", ШаблонСтрокиПоиска);
	КонтурЛогистика_КонвертацияСервер.ДобавитьНовоеУсловиеПоискаПоКлючам(КлючиПоиска,
		"Организация,ИдДок", ШаблонСтрокиПоиска);
	
	Возврат КлючиПоиска;
	
КонецФункции

Функция ТекстОшибкиНеЗаполненыКлючевыеРеквизиты() Экспорт
	
	ТекстОшибки = "Ошибка при поиске Договора. Не заполнен один из ключевых реквизитов:
		|1. Организация + Контрагент + Номер договора + Дата договора
		|2. Организация + Номер договора + Дата договора
		|3. Организация + Идентификатор файла документа";
	
	Возврат ТекстОшибки;
	
КонецФункции

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Найти(Данные.Наименование, Данные.НомерДокумента) > 0 Тогда
		Представление = СокрЛП(Данные.Наименование);
	Иначе
		Представление = СокрЛП(Данные.Наименование) + " №" + Данные.НомерДокумента + " от " + Формат(Данные.ДатаДокумента, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Определяем состав необходмых полей
	Поля.Добавить("НомерДокумента");
	Поля.Добавить("ДатаДокумента");
	Поля.Добавить("Наименование");
	
КонецПроцедуры

Функция НайтиДоговорПоНомерДатаКонтрагентИНН(НомерДокумента, ДатаДокумента, КонтрагентИНН = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	Запрос.УстановитьПараметр("КонтрагентИНН", КонтрагентИНН);
	Запрос.УстановитьПараметр("ЗаполненКонтрагентИНН", ЗначениеЗаполнено(КонтрагентИНН));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Договоры КАК КонтурЛогистика_Договоры
	|ГДЕ
	|	НЕ КонтурЛогистика_Договоры.ПометкаУдаления
	|	И КонтурЛогистика_Договоры.НомерДокумента = &НомерДокумента
	|	И КонтурЛогистика_Договоры.ДатаДокумента = &ДатаДокумента
	|	И ВЫБОР
	|			КОГДА &ЗаполненКонтрагентИНН
	|				ТОГДА КонтурЛогистика_Договоры.КонтрагентИНН = &КонтрагентИНН
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

Функция ОбязательныеРеквизиты() Экспорт
	
	МассивОбязательных = Новый Массив();
	МассивОбязательных.Добавить("ДатаДокумента");
	МассивОбязательных.Добавить("НомерДокумента");
	
	Возврат МассивОбязательных;
	
КонецФункции

Функция УсловноОбязательныеРеквизиты() Экспорт
	
	МассивОбязательных = Новый Массив();
	МассивОбязательных.Добавить("Контрагент");
	МассивОбязательных.Добавить("КонтрагентИНН");
	МассивОбязательных.Добавить("Наименование");
	МассивОбязательных.Добавить("Организация");
	МассивОбязательных.Добавить("ОрганизацияИНН");
	
	Возврат МассивОбязательных;
	
КонецФункции

Функция ИННЗаполненКорректно(Знач ИНН) Экспорт
	
	ИНН = СокрЛП(ИНН);
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДлинаИНН = СтрДлина(ИНН);
	
	Если ДлинаИНН <> 10 И ДлинаИНН <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.СтрокаСодержитТолькоЦифры(ИНН);
	
КонецФункции

Функция ИННСтороныДоговора(Организация, Знач ИНН) Экспорт
	
	ИННСтороны = СокрЛП(ИНН);
	
	Если Не ЗначениеЗаполнено(ИННСтороны) И ЗначениеЗаполнено(Организация) Тогда
		ИННСтороны = СокрЛП(КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Организация, "ИНН"));
	КонецЕсли;
	
	Возврат ИННСтороны;
	
КонецФункции

Функция СторонаДоговораЗаполнена(Организация, Знач ИНН) Экспорт
	
	Возврат ЗначениеЗаполнено(Организация) Или ИННЗаполненКорректно(ИНН);
	
КонецФункции

Функция СторонаДоговораСовпадаетСОрганизациейДиадок(Организация, Знач ИНН, ОрганизацияДокумента) Экспорт
	
	Если Не ЗначениеЗаполнено(ОрганизацияДокумента) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И Организация = ОрганизацияДокумента Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИННСтороныДоговора = ИННСтороныДоговора(Организация, ИНН);
	ИННОрганизацииДокумента = СокрЛП(КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ОрганизацияДокумента, "ИНН"));
	
	Возврат ЗначениеЗаполнено(ИННСтороныДоговора)
		И ЗначениеЗаполнено(ИННОрганизацииДокумента)
		И ИННСтороныДоговора = ИННОрганизацииДокумента;
	
КонецФункции

Процедура ПроверитьСтороныДоговора(ДоговорСсылка, ТаблицаОшибок, КатегорияОшибка, ПутьПрефикс) Экспорт
	
	Если Не ЗначениеЗаполнено(ДоговорСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПОС = КонтурЛогистика_ПанельОшибокСервер;
	
	Если Не СторонаДоговораЗаполнена(ДоговорСсылка.Организация, ДоговорСсылка.ОрганизацияИНН) Тогда
		
		ТекстОшибки = "Укажите организацию или ИНН, к которой относится договор";
		ПОС.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			ПутьПрефикс + ".ОрганизацияИНН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Если Не СторонаДоговораЗаполнена(ДоговорСсылка.Контрагент, ДоговорСсылка.КонтрагентИНН) Тогда
		
		ТекстОшибки = "Укажите контрагента или ИНН, с которым у организации заключен договор";
		ПОС.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			ПутьПрефикс + ".КонтрагентИНН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
