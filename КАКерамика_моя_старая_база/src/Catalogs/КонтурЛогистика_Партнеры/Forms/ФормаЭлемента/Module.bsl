
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПереформироватьДинСпискокТД();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПереформироватьДинСпискокТД();
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура ПереформироватьДинСпискокТД()
	
	Если ЗначениеЗаполнено(Объект.КодПартнераКонтур) Тогда 
		СопоставленияПунктовМаршрута.Параметры.УстановитьЗначениеПараметра("ПартнерСсылка", Объект.Ссылка); 
		Элементы.СопоставленияПунктовМаршрута.Видимость = ЗначениеЗаполнено(Объект.Ссылка);
		Элементы.ПунктыМаршрута.Видимость = Не ЗначениеЗаполнено(Объект.Ссылка);
		Элементы.ГруппаНеЗаписан.Видимость = Не ЗначениеЗаполнено(Объект.Ссылка);
		Элементы.СопоставленияПунктовМаршрута.Обновить();
		Элементы.ГруппаПунктыМаршрута.Видимость = Истина;
	Иначе
		Элементы.ГруппаПунктыМаршрута.Видимость = Ложь;
		Элементы.ГруппаНеЗаписан.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОбновитьДинСписок(Параметр1, параметр2) Экспорт

	ПереформироватьДинСпискокТД();

КонецПроцедуры

&НаКлиенте
Процедура СопоставленияПунктовМаршрутаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда 
		
		ПараметрыФормы = Новый Структура;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
			
			ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Ссылка);
			
		Иначе
			
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("Наименование", ТекущиеДанные.Название);
			ДанныеЗаполнения.Вставить("Адрес", ТекущиеДанные.АдресСтрока);
			ДанныеЗаполнения.Вставить("GLN", ТекущиеДанные.GLN);
			ДанныеЗаполнения.Вставить("КПП", ТекущиеДанные.КПП);
			ДанныеЗаполнения.Вставить("АдресИндекс", ТекущиеДанные.АдресИндекс);
			ДанныеЗаполнения.Вставить("Партнер", Объект.Ссылка);
			ДанныеЗаполнения.Вставить("Прибытие", Истина);
			ДанныеЗаполнения.Вставить("АдресКодРегион", ТекущиеДанные.АдресКодРегион);
			ПараметрыФормы.Вставить("Основание", ДанныеЗаполнения); 
			
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОбновитьДинСписок", ПараметрыФормы); 
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПунктыМаршрутаСервер(МассивСтруктурДанныеСтроки)
	
	Для Каждого СтруктураТочкиДоставки Из МассивСтруктурДанныеСтроки Цикл 
		
		НовыйПунктМаршрута = Справочники.КонтурЛогистика_ПунктыМаршрута.СоздатьЭлемент();
		НовыйПунктМаршрута.Заполнить(СтруктураТочкиДоставки);
		НовыйПунктМаршрута.Записать();
		
	КонецЦикла;
	
	ПереформироватьДинСпискокТД();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыделенныеПунктыМаршрута(Команда)
	
	текВыделенныеСтроки = Элементы.СопоставленияПунктовМаршрута.ВыделенныеСтроки;

	МассивСтруктур = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из текВыделенныеСтроки Цикл
		
		ТекущиеДанные = Элементы.СопоставленияПунктовМаршрута.ДанныеСтроки(ВыделеннаяСтрока);
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда 
			
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("Наименование", ТекущиеДанные.Название);
			ДанныеЗаполнения.Вставить("Адрес", ТекущиеДанные.АдресСтрока);
			ДанныеЗаполнения.Вставить("GLN", ТекущиеДанные.GLN);
			ДанныеЗаполнения.Вставить("КПП", ТекущиеДанные.КПП);
			ДанныеЗаполнения.Вставить("АдресИндекс", ТекущиеДанные.АдресИндекс);
			ДанныеЗаполнения.Вставить("Партнер", Объект.Ссылка);
			ДанныеЗаполнения.Вставить("Прибытие", Истина);
			ДанныеЗаполнения.Вставить("АдресКодРегион", ТекущиеДанные.АдресКодРегион);
			МассивСтруктур.Добавить(ДанныеЗаполнения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьПунктыМаршрутаСервер(МассивСтруктур);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиНастройкаПриИзменении(Элемент)
	
	// установить в значение дефолтное значение
	Если ЗначениеЗаполнено(Элементы.Настройки.ТекущиеДанные.Настройка) Тогда 
		Элементы.Настройки.ТекущиеДанные.Значение = 
			КонтурЛогистика_ОбщегоНазначенияКлиент.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
				Элементы.Настройки.ТекущиеДанные.Настройка, "Значение");
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Или Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Условие) Тогда
		Элемент.ТекущиеДанные.Условие = "РезультатВычисления = Истина;";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикиТекстОбработкиПослеЗаполненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьРедактированиеТекстаОбработчика("ТекстОбработкиПослеЗаполнения");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикиУсловиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьРедактированиеТекстаОбработчика("Условие");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедактированиеТекстаОбработчика(ИмяРеквизита)
	
	ТекущиеДанные = Элементы.Обработчики.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Событие) Тогда
		КонтурЛогистика_СтдОбщегоНазначенияКлиент.СообщитьПользователюЛок(
			"Сначала выберите событие обработчика.");
		Возврат;
	КонецЕсли;
	
	ВыполнениеКода = ПараметрыВыполненияКодаПоСобытиюОбработчика(ТекущиеДанные.Событие);
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		ТекущиеДанные[ИмяРеквизита],
		Объект,
		ИмяРеквизита,
		Истина,
		Элементы.Обработчики,
		ВыполнениеКода,
		ТекстШаблоновПодсказокОбработчиковПартнера(ТекущиеДанные.Событие, ИмяРеквизита));
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыВыполненияКодаПоСобытиюОбработчика(Событие)
	
	ВыполнениеКода = Новый Структура;
	
	Если Событие = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_СобытияОбработчиковПартнеров.ПослеЗаполненияТРНт1") Тогда
		
		ВыполнениеКода.Вставить("Переменные", "Объект");
		ВыполнениеКода.Вставить("ДоступныРеквизитыТ1ЭТРН", Истина);
		
	Иначе
		
		ВыполнениеКода.Вставить("Переменные", "Объект");
		
	КонецЕсли;
	
	Возврат ВыполнениеКода;
	
КонецФункции

// Формирует текст подсказок и шаблонов для редактора кода обработчиков партнера.
//
// Параметры:
//  Событие - ПеречислениеСсылка.КонтурЛогистика_СобытияОбработчиковПартнеров
//  ИмяРеквизита - Строка - "Условие" или "ТекстОбработкиПослеЗаполнения"
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция ТекстШаблоновПодсказокОбработчиковПартнера(Событие, ИмяРеквизита)
	
	Возврат ТекстШаблоновПодсказокОбработчиковПартнераНаСервере(Событие, ИмяРеквизита);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстШаблоновПодсказокОбработчиковПартнераНаСервере(Знач Событие, Знач ИмяРеквизита)
	
	Возврат Перечисления.КонтурЛогистика_СобытияОбработчиковПартнеров.ТекстШаблоновПодсказок(Событие, ИмяРеквизита);
	
КонецФункции
