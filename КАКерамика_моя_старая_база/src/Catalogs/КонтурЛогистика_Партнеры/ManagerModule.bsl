Функция ОпределитьПартнераОрганизацииДиадок(ОрганизацияДиадок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ПартнерыОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Партнеры.ОрганизацииДиадок КАК КонтурЛогистика_ПартнерыОрганизацииДиадок
	|ГДЕ
	|	КонтурЛогистика_ПартнерыОрганизацииДиадок.Организация = &Организация
	|	И НЕ КонтурЛогистика_ПартнерыОрганизацииДиадок.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Организация",ОрганизацияДиадок);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

Функция ЗначениеНастройки(ПартнерСсылка, Знач НастройкаПартнераИлиОбщая) Экспорт 
	
	Если ТипЗнч(НастройкаПартнераИлиОбщая) = Тип("Строка") Тогда
		
		// по имени настройки поищем сначала в партнере а потом общую
		
		НастройкаПартнераИлиОбщая = Справочники.КонтурЛогистика_НастройкиПартнеров.ПолучитьСсылкуПоИмениПредопределенного(НастройкаПартнераИлиОбщая);
		Если Не ЗначениеЗаполнено(НастройкаПартнераИлиОбщая) Тогда 
			НастройкаПартнераИлиОбщая = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(НастройкаПартнераИлиОбщая);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НастройкаПартнераИлиОбщая) Тогда 
			ВызватьИсключение "Не существует настройки с именем " + НастройкаПартнераИлиОбщая + " ни в справочнике настроек партнера, ни в справочнике общих настроек";
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_Партнеры.Значение КАК ЗначениеНастройки
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Партнеры.Настройки КАК КонтурЛогистика_Партнеры
	               |ГДЕ
	               |	КонтурЛогистика_Партнеры.Ссылка = &Ссылка
	               |	И КонтурЛогистика_Партнеры.Настройка = &Настройка
	               |	И НЕ КонтурЛогистика_Партнеры.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", ПартнерСсылка);
	Запрос.УстановитьПараметр("Настройка", НастройкаПартнераИлиОбщая);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ЗначениеНастройки;
	Иначе
		Возврат НастройкаПартнераИлиОбщая.Значение;
	КонецЕсли;
	
КонецФункции

// тех у которых есть КодПартнераКонтур
Функция МассивСинхронизируемыхПартнеров() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_Партнеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Партнеры КАК КонтурЛогистика_Партнеры
	|ГДЕ
	|	НЕ КонтурЛогистика_Партнеры.ПометкаУдаления
	|	И КонтурЛогистика_Партнеры.КодПартнераКонтур <> """"";
	
	Результат = Запрос.Выполнить();
	МассивПартнеров = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");	
	
	Возврат МассивПартнеров;
	
КонецФункции

Функция ДобавленныеПартнеры() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КонтурЛогистика_Партнеры.КодПартнераКонтур КАК КодПартнераКонтур
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Партнеры КАК КонтурЛогистика_Партнеры
	               |ГДЕ
	               |	НЕ КонтурЛогистика_Партнеры.ПометкаУдаления
	               |	И КонтурЛогистика_Партнеры.КодПартнераКонтур <> """"";
	
	Результат = Запрос.Выполнить();
	МассивКодовПартнеров = Результат.Выгрузить().ВыгрузитьКолонку("КодПартнераКонтур");	
	
	Возврат МассивКодовПартнеров;

КонецФункции

// Возвращает правила торговой сети из кэша требований партнеров по коду PARTIN.
//
// Параметры:
//  КодПартнераКонтур - Строка - код сети (net_code)
//
// Возвращаемое значение:
//  Структура, Неопределено - элемент networks_settings (net_code, requirements)
//                            или Неопределено, если код пустой / кэш пуст / сеть не найдена
//
Функция ПравилаПартнера(КодПартнераКонтур) Экспорт
	
	КодСети = СокрЛП(КодПартнераКонтур);
	
	Если Не ЗначениеЗаполнено(КодСети) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеТребований = ДанныеТребованийПартнеровИзРегистра();
	
	Если ДанныеТребований = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ДанныеТребований.Свойство("networks_settings")
		Или ТипЗнч(ДанныеТребований.networks_settings) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого УзелСети Из ДанныеТребований.networks_settings Цикл
		
		Если ТипЗнч(УзелСети) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		КодУзла = "";
		Если Не УзелСети.Свойство("net_code", КодУзла) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СокрЛП(КодУзла) = КодСети Тогда
			Возврат УзелСети;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДанныеТребованийПартнеровИзРегистра()
	
	ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ТребованияПартнеров;
	ПустаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	ПустойРазрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияДиадок", ПустаяОрганизация);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.УстановитьПараметр("Разрез1", "");
	Запрос.УстановитьПараметр("Разрез2", ПустойРазрез2);
	Запрос.УстановитьПараметр("Разрез3", "");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ДанныеХранилище КАК ДанныеХранилище
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок = &ОрганизацияДиадок
	|	И КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез1 = &Разрез1
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &Разрез2
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез3 = &Разрез3";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если Не ЗначениеЗаполнено(Выборка.ДанныеХранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = Выборка.ДанныеХранилище.Получить();
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

