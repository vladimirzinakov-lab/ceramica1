<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <title>
    <key>ru</key>
    <value>Выберите машиночитаемую доверенность</value>
  </title>
  <items xsi:type="form:Decoration">
    <name>ДекорацияВопрос</name>
    <id>6</id>
    <title>
      <key>ru</key>
      <value>Заполнить заявление на отзыв на основании доверенности?</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ДекорацияВопросРасширеннаяПодсказка</name>
      <id>8</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ДекорацияВопросКонтекстноеМеню</name>
      <id>7</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <items xsi:type="form:FormField">
    <name>Доверенность</name>
    <id>3</id>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <dataPath xsi:type="form:DataPath">
      <segments>Доверенность</segments>
    </dataPath>
    <extendedTooltip>
      <name>ДоверенностьРасширеннаяПодсказка</name>
      <id>5</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ДоверенностьКонтекстноеМеню</name>
      <id>4</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <type>InputField</type>
    <editMode>Enter</editMode>
    <showInHeader>true</showInHeader>
    <headerHorizontalAlign>Left</headerHorizontalAlign>
    <showInFooter>true</showInFooter>
    <extInfo xsi:type="form:InputFieldExtInfo">
      <handlers>
        <event>StartChoice</event>
        <name>ДоверенностьНачалоВыбора</name>
      </handlers>
      <width>30</width>
      <autoMaxHeight>true</autoMaxHeight>
      <wrap>true</wrap>
      <chooseType>true</chooseType>
      <typeDomainEnabled>true</typeDomainEnabled>
      <textEdit>true</textEdit>
      <textSize>Normal</textSize>
    </extInfo>
  </items>
  <items xsi:type="form:FormGroup">
    <name>ГруппаКнопок</name>
    <id>9</id>
    <items xsi:type="form:Button">
      <name>СоздатьИЗаполнитьЗаявлениеОбОтзывеМЧДФНС</name>
      <id>1</id>
      <title>
        <key>ru</key>
        <value>Да</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>СоздатьИЗаполнитьЗаявлениеОбОтзывеМЧДФНСРасширеннаяПодсказка</name>
        <id>2</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <type>UsualButton</type>
      <commandName>Form.Command.СоздатьИЗаполнитьЗаявлениеОбОтзывеМЧДФНС</commandName>
      <representation>Auto</representation>
      <defaultButton>true</defaultButton>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <placementArea>UserCmds</placementArea>
      <representationInContextMenu>Auto</representationInContextMenu>
    </items>
    <items xsi:type="form:Button">
      <name>СоздатьПустоеЗаявление</name>
      <id>11</id>
      <title>
        <key>ru</key>
        <value>Нет</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>СоздатьПустоеЗаявлениеРасширеннаяПодсказка</name>
        <id>12</id>
        <type>Label</type>
        <autoMaxWidth>true</autoMaxWidth>
        <autoMaxHeight>true</autoMaxHeight>
        <extInfo xsi:type="form:LabelDecorationExtInfo">
          <horizontalAlign>Left</horizontalAlign>
        </extInfo>
      </extendedTooltip>
      <type>UsualButton</type>
      <commandName>Form.Command.СоздатьПустоеЗаявление</commandName>
      <buttonImportance>Normal</buttonImportance>
      <representation>Auto</representation>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <placementArea>UserCmds</placementArea>
      <representationInContextMenu>Auto</representationInContextMenu>
    </items>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <groupHorizontalAlign>Right</groupHorizontalAlign>
    <extendedTooltip>
      <name>ГруппаКнопокРасширеннаяПодсказка</name>
      <id>10</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <type>UsualGroup</type>
    <extInfo xsi:type="form:UsualGroupExtInfo">
      <group>AlwaysHorizontal</group>
      <behavior>Auto</behavior>
      <showLeftMargin>true</showLeftMargin>
      <united>true</united>
      <showTitle>auto</showTitle>
      <throughAlign>Auto</throughAlign>
      <currentRowUse>Auto</currentRowUse>
    </extInfo>
  </items>
  <autoCommandBar>
    <name>ФормаКоманднаяПанель</name>
    <id>-1</id>
    <horizontalAlign>Left</horizontalAlign>
  </autoCommandBar>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>ПриСозданииНаСервере</name>
  </handlers>
  <saveWindowSettings>true</saveWindowSettings>
  <autoUrl>true</autoUrl>
  <group>Auto</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>auto</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Доверенность</name>
    <title>
      <key>ru</key>
      <value>Доверенность</value>
    </title>
    <id>1</id>
    <valueType>
      <types>CatalogRef.МашиночитаемыеДоверенностиФНС</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>Организация</name>
    <title>
      <key>ru</key>
      <value>Организация</value>
    </title>
    <id>2</id>
    <valueType>
      <types>CatalogRef.Организации</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <formCommands>
    <name>СоздатьИЗаполнитьЗаявлениеОбОтзывеМЧДФНС</name>
    <title>
      <key>ru</key>
      <value>Создать и заполнить заявление об отзыве МЧД (ФНС)</value>
    </title>
    <id>1</id>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>СоздатьИЗаполнитьЗаявлениеОбОтзывеМЧДФНС</name>
      </handler>
    </action>
    <currentRowUse>Auto</currentRowUse>
    <selectedRowsUse>Auto</selectedRowsUse>
  </formCommands>
  <formCommands>
    <name>СоздатьПустоеЗаявление</name>
    <title>
      <key>ru</key>
      <value>Создать пустое заявление об отзыве МЧД</value>
    </title>
    <id>2</id>
    <toolTip>
      <key>ru</key>
      <value>Создать пустое заявление</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>СоздатьПустоеЗаявление</name>
      </handler>
    </action>
    <currentRowUse>Auto</currentRowUse>
    <selectedRowsUse>Auto</selectedRowsUse>
  </formCommands>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
