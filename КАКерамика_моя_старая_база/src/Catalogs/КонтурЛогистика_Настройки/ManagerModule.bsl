#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ЗаполнитьВсеНастройкиЗначениямиПоУмолчанию(ИнициализацияРасширения = Ложь, ТолькоНеинициализированные = Ложь, ИнициализацияИзСтартовогоПомощника = Ложь, ОбновлятьОписание = Ложь) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если ИнициализацияИзСтартовогоПомощника Тогда
		ТаблицаНастроекПоУмолчанию = ТаблицаНастроекПоУмолчанию(ИнициализацияИзСтартовогоПомощника);
	Иначе
		ТаблицаНастроекПоУмолчанию = ПолучитьТаблицуНастроекПоУмолчанию();
	КонецЕсли;
	
	КопияТаблицы = ТаблицаНастроекПоУмолчанию.Скопировать(, "РодительИмяНастройки");
	КопияТаблицы.Свернуть("РодительИмяНастройки");
	МассивРодителей = КопияТаблицы.ВыгрузитьКолонку("РодительИмяНастройки");
	
	Если Не ЗначениеЗаполнено(ТаблицаНастроекПоУмолчанию) Тогда
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Общие настройки не найдены";
		
		Возврат Результат;
		
	КонецЕсли;
	
	Для Каждого СтрокаНастройки Из ТаблицаНастроекПоУмолчанию Цикл
		
		Если ЗначениеЗаполнено(СтрокаНастройки.Ссылка) Тогда
			
			// Пропускаем группы
			Если СтрокаНастройки.Ссылка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			
			// Если требуется, то установим значение по умолчанию
			Если Не ТолькоНеинициализированные Тогда
				УстановитьНастройкеЗначениеПоУмолчанию(СтрокаНастройки.Ссылка, ТаблицаНастроекПоУмолчанию);
			КонецЕсли;
			
			Если ОбновлятьОписание Тогда
				
				ОписаниеДляЗаписи = ОписаниеНастройкиДляЗаписи(СтрокаНастройки);
				
				Если ОписаниеДляЗаписи <> СтрокаНастройки.Ссылка.Описание
					Или СтрокаНастройки.Наименование <> СтрокаНастройки.Ссылка.Наименование Тогда
					
					НастройкаОбъект = СтрокаНастройки.Ссылка.ПолучитьОбъект();
					НастройкаОбъект.Описание = ОписаниеДляЗаписи;
					НастройкаОбъект.Наименование = СтрокаНастройки.Наименование;
					НастройкаОбъект.Записать();
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если МассивРодителей.Найти(СтрокаНастройки.ИмяНастройки) <> Неопределено
				Или СтрокаНастройки.ТипЗначения = "" Тогда
				
				НастройкаОбъект = Справочники.КонтурЛогистика_Настройки.СоздатьГруппу();
				Если ЗначениеЗаполнено(СтрокаНастройки.РодительИмяНастройки) Тогда
					НастройкаОбъект.Родитель = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
						"ИмяПредопределенногоДляРасширения", СтрокаНастройки.РодительИмяНастройки);
				КонецЕсли;
				НастройкаОбъект.ИмяПредопределенногоДляРасширения = СтрокаНастройки.ИмяНастройки;
				НастройкаОбъект.Наименование = СтрокаНастройки.Наименование;
				НастройкаОбъект.Записать();
				
			Иначе
				
				// Еще раз проверить что настройка не была создана (могла быть создана в другом сеансе)
				ПроверкаНастройка = НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", СтрокаНастройки.ИмяНастройки);
				Если Не ПроверкаНастройка.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				
				// Создадим новую настройку
				НастройкаОбъект = Справочники.КонтурЛогистика_Настройки.СоздатьЭлемент();
				НастройкаОбъект.Родитель = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
					"ИмяПредопределенногоДляРасширения", СтрокаНастройки.РодительИмяНастройки);
				
				Если НастройкаОбъект.Родитель.Пустая() И ЗначениеЗаполнено(СтрокаНастройки.РодительИмяНастройки) Тогда
					Сообщить("Для настройки " + СтрокаНастройки.Наименование
						+ " не удалось определить родителя (в какую группу добавить)");
				КонецЕсли;
				
				НастройкаОбъект.ИмяПредопределенногоДляРасширения = СтрокаНастройки.ИмяНастройки;
				НастройкаОбъект.Наименование = СтрокаНастройки.Наименование;
				НастройкаОбъект.Записать();
				
				СтрокаНастройки.Ссылка = НастройкаОбъект.Ссылка;
				
				УстановитьНастройкеЗначениеПоУмолчанию(СтрокаНастройки.Ссылка, ТаблицаНастроекПоУмолчанию);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Обновим состав отображаемых в панели документов
	НастройкаОтображатьПанельВУчетныхДокументах = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "ОтображатьПанельВУчетныхДокументах");
	Если Не НастройкаОтображатьПанельВУчетныхДокументах.Пустая()
		И НастройкаОтображатьПанельВУчетныхДокументах.Значение = Истина Тогда
		// Группа настроек
		ГруппаНастроек = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
			"ИмяПредопределенногоДляРасширения", "НастройкиОтображенияПанелиВУчетныхДокументах");
		Если Не ГруппаНастроек.Пустая() Тогда
			// Добавим настройки по документам
			КонтурЛогистика_ИнтеграцияТиповыеСервер.СоздатьНастройкиОтображенияУчетныхДокументовВРасширении();
		КонецЕсли;
	КонецЕсли;
	
	Результат.Успешно = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеНастройки(ИмяПредопределенного, Партнер = Неопределено) Экспорт
	
	НастройкаСсылка = ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
	
	текЗначение = НастройкаСсылка.Значение;
	
	Если текЗначение <> Неопределено 
		И ТипЗнч(текЗначение) <> Тип(НастройкаСсылка.ТипЗначения)
		И ИмяПредопределенного <> "EDI_ПутьКМодулю" 
		И ИмяПредопределенного <> "ПодключаемыйМодульПуть" Тогда 
		Сообщить("Значение настройки " + ИмяПредопределенного + " не соответсвует по типу значения! Ожидаем: " + Тип(НастройкаСсылка.ТипЗначения) );
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(текЗначение) Тогда
		
		Если ИмяПредопределенного = "КлючРазработчика" Тогда 
			
			текЗначение = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КлючРазработчикаДиадок();
			ДвоичныеДанные = Base64Значение(текЗначение);
			текЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтрокуИзДвоичныхДанныхЛок(ДвоичныеДанные);
			
		ИначеЕсли ИмяПредопределенного = "ПарольAPIТелеграм" Тогда
			
			текЗначение = КонтурЛогистика_РаботаСТелеграм.КлючAPI();
			
		КонецЕсли;
		
	Иначе
		
		Если ИмяПредопределенного = "КлючРазработчикаДиадокTestkontur"
			Или ИмяПредопределенного = "КлючРазработчика" Тогда			
			ДвоичныеДанные = Base64Значение(текЗначение);
			текЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтрокуИзДвоичныхДанныхЛок(ДвоичныеДанные);						
		КонецЕсли;
		
	КонецЕсли;
	
	// Если заполнен партнер  - пробуем найти эту настройку у него
	Если ЗначениеЗаполнено(Партнер) Тогда
		
		ЗначениеНастройкиВПартнере = Справочники.КонтурЛогистика_Партнеры.ЗначениеНастройки(Партнер, НастройкаСсылка);
		Если ЗначениеЗаполнено(ЗначениеНастройкиВПартнере) Тогда 
			текЗначение = ЗначениеНастройкиВПартнере;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат текЗначение;
	
КонецФункции

// Возвращает список значений настройки
//
// Параметры:
//  Настройка	 - СправочникСсылка.КонтурЛогистика_Настройки	 - настрйока.
// 
// Возвращаемое значение:
//  Массив - значения из саписка значений
//
Функция СписокЗначенийНастройки(Настройка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Настройка", Настройка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСписокЗначений.Значение КАК Значение
	|ИЗ
	|	Справочник.КонтурЛогистика_Настройки.СписокЗначений КАК КонтурЛогистика_НастройкиСписокЗначений
	|ГДЕ
	|	КонтурЛогистика_НастройкиСписокЗначений.Ссылка = &Настройка";
	
	МассивЗначений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");
	
	Возврат МассивЗначений;
	
КонецФункции

Функция ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного, ПробоватьСоздаватьПриОтсутствии = Истина) Экспорт
	
	Если ТипЗнч(ИмяПредопределенного) <> Тип("Строка") Тогда
		Если ТипЗнч(ИмяПредопределенного) = Тип("СправочникСсылка.КонтурЛогистика_Настройки")
				И НЕ КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПодсистемаКакРасширение() Тогда
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Устаревший тип наименования настройки (ожидается строка): " + ИмяПредопределенного;
			Сообщение.Сообщить();
			Возврат ИмяПредопределенного;
			
		Иначе
			
			ВызватьИсключение "Неверный тип наименования настройки (ожидается строка): " + ИмяПредопределенного;					
			
		КонецЕсли;
		
	КонецЕсли;
	
	НастройкаСсылка = НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", ИмяПредопределенного);
	
	Если НастройкаСсылка.Пустая() И ПробоватьСоздаватьПриОтсутствии = Истина Тогда // возможно её просто не в справочнике
		
		ОбновитьПовторноИспользуемыеЗначения();
		ЗаполнитьВсеНастройкиЗначениямиПоУмолчанию(, Истина); // истина - только неинициализированные
		ОбновитьПовторноИспользуемыеЗначения();

		НастройкаСсылка = НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", ИмяПредопределенного);
		
	КонецЕсли;
	
	Если НастройкаСсылка.Пустая() Тогда
		
		Если ПробоватьСоздаватьПриОтсутствии = Истина Тогда 
			ВызватьИсключение "Попытка получить значение неизвестной настройки " + ИмяПредопределенного;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НастройкаСсылка;
	
КонецФункции

Процедура УстановитьНастройкеЗначениеПоУмолчанию(НастройкаСсылка, ТаблицаНастроекПоУмолчанию = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// не возвращаем к дефолту эти настройки:
	Если НастройкаСсылка = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту("ИмяПредопределенногоДляРасширения", "СлужебныйИдентификаторБазыДанных") Тогда 
		
		Если ЗначениеЗаполнено(НастройкаСсылка.Значение) Тогда
		
			Возврат;	
		
		КонецЕсли;
		
	КонецЕсли;
	
	// настройки можно скинуть в дефолт
	
	Если ТаблицаНастроекПоУмолчанию = Неопределено Тогда 
		ТаблицаНастроекПоУмолчанию = ПолучитьТаблицуНастроекПоУмолчанию();
	КонецЕсли;
	
	Попытка  // на 8.2 нет Имя_Предопределенных_Данных
		
		НайденноеУмолчание = ТаблицаНастроекПоУмолчанию.Найти(НастройкаСсылка, "Ссылка");
		
	Исключение
		
	    НайденноеУмолчание = Неопределено;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Настройка: " + НастройкаСсылка + " >>> Очень старая версия платформы, заполнение значения по умолчанию не реализовано";
		Сообщение.Сообщить();
		
	КонецПопытки;	
	
	Если ЗначениеЗаполнено(НайденноеУмолчание) Тогда 
		
		Если НастройкаСсылка.ТипЗначения <> НайденноеУмолчание.ТипЗначения 
			ИЛИ НастройкаСсылка.Описание <> НайденноеУмолчание.Описание
			ИЛИ (ЗначениеЗаполнено(НайденноеУмолчание.Значение) И НастройкаСсылка.Значение <> НайденноеУмолчание.Значение) Тогда 
			
			Попытка
				
				НастройкаОбъект = НастройкаСсылка.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(НастройкаОбъект, НайденноеУмолчание, "ТипЗначения, Описание");
				Если ЗначениеЗаполнено(НайденноеУмолчание.Значение) ИЛИ 
					(НайденноеУмолчание.ТипЗначения = "Число" И НайденноеУмолчание.Значение = 0) Тогда 
					ЗаполнитьЗначенияСвойств(НастройкаОбъект, НайденноеУмолчание, "Значение");
				КонецЕсли;
				
				УстановитьОписаниеТипаШаблонаДляОтправкиКонтрагенту(НастройкаОбъект);
				
				НастройкаОбъект.Записать();
				
			Исключение
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось записать значение по умолчанию для настройки: " + НастройкаСсылка.Наименование;
				Сообщение.УстановитьДанные(НастройкаСсылка);
				Сообщение.Сообщить();
				
			КонецПопытки;
		
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура УстановитьНастройку(ИмяПредопределенного, УстанавливаемоеЗначение) Экспорт
	
	НастройкаСсылка = ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
	НастройкаОбъект = НастройкаСсылка.ПолучитьОбъект();
	НастройкаОбъект.Прочитать();
	
	Если НастройкаОбъект.Значение <> УстанавливаемоеЗначение Тогда
		
		НастройкаОбъект.Значение = УстанавливаемоеЗначение;
		НастройкаОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьНастройку(ИмяПредопределенного) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкаСсылка = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(ИмяПредопределенного);
	
	// Не возвращаем к дефолту эти настройки:
	Если НастройкаСсылка = Справочники.КонтурЛогистика_Настройки.НайтиПоРеквизиту(
		"ИмяПредопределенногоДляРасширения", "СлужебныйИдентификаторБазыДанных") Тогда
		
		Если ЗначениеЗаполнено(НастройкаСсылка.Значение) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	// Настройки можно скинуть в дефолт
	ТаблицаНастроекПоУмолчанию = ПолучитьТаблицуНастроекПоУмолчанию();
	
	// На 8.2 нет Имя_Предопределенных_Данных
	Попытка
		НайденноеУмолчание = ТаблицаНастроекПоУмолчанию.Найти(НастройкаСсылка, "Ссылка");
	Исключение
		НайденноеУмолчание = Неопределено;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Настройка: " + НастройкаСсылка
			+ " >>> Очень старая версия платформы, заполнение значения по умолчанию не реализовано";
		Сообщение.Сообщить();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(НайденноеУмолчание) Тогда 
		Возврат;
	КонецЕсли;
	
	Попытка
		
		НастройкаОбъект = НастройкаСсылка.ПолучитьОбъект();
		
		ЗаполнитьЗначенияСвойств(НастройкаОбъект, НайденноеУмолчание, "Наименование, ТипЗначения, Описание");
		
		НастройкаОбъект.Записать();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось записать значение по умолчанию для настройки: " + НастройкаСсылка.Наименование;
		Сообщение.УстановитьДанные(НастройкаСсылка);
		Сообщение.Сообщить();
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьТаблицуНастроекПоУмолчанию() Экспорт
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуНастроекПоУмолчанию();
	
КонецФункции

Функция ТаблицаНастроекПоУмолчанию(ИнициализацияИзСтартовогоПомощника = Ложь) Экспорт
	
	ТаблицаНастроек = ИнициализироватьТаблицуНастроек();
	
	Если ИнициализацияИзСтартовогоПомощника Тогда
		ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСервер.ОпределитьКонфигурацию();
	Иначе
		ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	КонецЕсли;
	
	ДобавитьГруппу_ОбщиеНастройки(ТаблицаНастроек);
	ДобавитьГруппу_НастройкиКонвертации(ТаблицаНастроек, ИмяКонфигурации);
	ДобавитьГруппу_НастройкиДокументов(ТаблицаНастроек);
	ДобавитьГруппу_НастройкиПодключения(ТаблицаНастроек);
	ДобавитьГруппу_НастройкиАрхива(ТаблицаНастроек);
	ДобавитьГруппу_СлужебныеНастройки(ТаблицаНастроек, ИмяКонфигурации);
	ДобавитьГруппу_НастройкиКриптографии(ТаблицаНастроек);
	ДобавитьГруппу_НастройкиПечати(ТаблицаНастроек);
	ДобавитьГруппу_ПЛ_РМ(ТаблицаНастроек);
	ДобавитьГруппу_СвоиНастройки(ТаблицаНастроек);
	ДобавитьГруппу_КонтактыАдминистратора(ТаблицаНастроек);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ПолучитьГруппу_ОсобенностиХраненияДанных(ИнициализацияИзСтартовогоПомощника) Экспорт
	
	ТаблицаНастроек = ИнициализироватьТаблицуНастроек();
	
	Если ИнициализацияИзСтартовогоПомощника Тогда
		ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСервер.ОпределитьКонфигурацию();
	Иначе
		ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	КонецЕсли;
	
	ДобавитьГруппу_ОсобенностиХраненияДанных(ТаблицаНастроек, "СлужебныеНастройки", ИмяКонфигурации);
	
	Возврат ТаблицаНастроек;
	
КонецФункции	

Функция ИнициализироватьТаблицуНастроек()
	
	// Инициализируем таблицу хранения
	ТаблицаНастроек = Новый ТаблицаЗначений;
	
	ОписаниеСтроки100 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная));
	ОписаниеСтроки150 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная));
	ОписаниеСтроки200 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная));
	ОписаниеСтроки0 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));
	
	ТаблицаНастроек.Колонки.Добавить("Наименование", ОписаниеСтроки150);
	ТаблицаНастроек.Колонки.Добавить("ИмяНастройки", ОписаниеСтроки100);
	ТаблицаНастроек.Колонки.Добавить("РодительИмяНастройки", ОписаниеСтроки100);
	ТаблицаНастроек.Колонки.Добавить("Значение");
	ТаблицаНастроек.Колонки.Добавить("ТипЗначения", ОписаниеСтроки200);
	ТаблицаНастроек.Колонки.Добавить("Описание", ОписаниеСтроки0);
	ТаблицаНастроек.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.КонтурЛогистика_Настройки"));
	
	Возврат ТаблицаНастроек; 
	
КонецФункции	

// Добавить строку настроек
//
// Параметры:
//  ТаблицаНастроек	 - ТаблицаЗначений	 - Таблица с данными
//  ИмяРодителя		 - Строка	 - Имя родителя
//  Наименование	 - Строка	 - Наименование (синоним)
//  ИмяНастройки	 - Строка	 - Имя предопределенного
//  ТипЗначения		 - Строка	 - Тип (для групп не указывается)
//  Значение		 - Строка	 - Значение по умолчанию (для групп не указывается)
//  Описание		 - Строка	 - Описание
//
Процедура ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя, Наименование, ИмяНастройки, ТипЗначения, Значение, Описание)
	
	НоваяСтрокаТаблицы = ТаблицаНастроек.Добавить();
	НоваяСтрокаТаблицы.Наименование = Наименование;
	НоваяСтрокаТаблицы.ИмяНастройки = ИмяНастройки;
	НоваяСтрокаТаблицы.РодительИмяНастройки = ИмяРодителя;
	НоваяСтрокаТаблицы.ТипЗначения = ТипЗначения;
	НоваяСтрокаТаблицы.Описание = Описание;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		НоваяСтрокаТаблицы.Значение = КонтурЛогистика_ОбщегоНазначенияСервер.ПреобразоватьЗначениеКТипу(Значение, НоваяСтрокаТаблицы.ТипЗначения);
	Иначе
		НоваяСтрокаТаблицы.Значение = КонтурЛогистика_ОбщегоНазначенияСервер.ПреобразоватьЗначениеКТипу(Неопределено, НоваяСтрокаТаблицы.ТипЗначения);
	КонецЕсли;
	
	Попытка
		// Важно здесь не пробовать её создать, иначе зациклимся
		НоваяСтрокаТаблицы.Ссылка = Справочники.КонтурЛогистика_Настройки.ПолучитьСсылкуПоИмениПредопределенного(НоваяСтрокаТаблицы.ИмяНастройки, Ложь);
	Исключение
		Сообщить("Не могу найти предопределенную настройку в справочнике настроек: " + НоваяСтрокаТаблицы.ИмяНастройки);
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьИмяСправочникаСущности(ИмяСущностиЛогистика) Экспорт
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяСправочника" + ИмяСущностиЛогистика);
	
КонецФункции

Функция ПолучитьОписаниеТиповЕдиницИзмерения() Экспорт

	ТипЕдиницыИзмерения = "СправочникСсылка." + ЗначениеНастройки("ИмяСправочникаЕдиницаИзмерения");	
	ТипУпаковки = "СправочникСсылка." + ЗначениеНастройки("ИмяСправочникаУпаковка");
	
	Если Не ЗначениеЗаполнено(ТипЕдиницыИзмерения) Тогда 
		ВызватьИсключение "В настройках не указано Имя справочника Единицы измерения";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипУпаковки) Тогда
		ВызватьИсключение "В настройках не указано Имя справочника Упаковок";
	КонецЕсли;
	
	ОписаниеТиповЕдиницИзмерения = Новый ОписаниеТипов(ТипЕдиницыИзмерения + ", " + ТипУпаковки);
	
	Возврат ОписаниеТиповЕдиницИзмерения;
	
КонецФункции

Функция ПолучитьОписаниеТипаСущности(ИмяСущностиЛогистика) Экспорт

	Если ИмяСущностиЛогистика = "Характеристика" 
		И Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() Тогда
		
		Возврат Неопределено;

	Иначе
		
		Возврат Новый ОписаниеТипов("СправочникСсылка." + ПолучитьИмяСправочникаСущности(ИмяСущностиЛогистика));
	 	
	КонецЕсли;
	
КонецФункции

Функция НастройкиВыполнены() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонтурЛогистика_Настройки.Ссылка) КАК Количество
	               |ИЗ
	               |	Справочник.КонтурЛогистика_Настройки КАК КонтурЛогистика_Настройки
	               |ГДЕ
	               |	НЕ КонтурЛогистика_Настройки.ЭтоГруппа
	               |	И НЕ КонтурЛогистика_Настройки.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Количество > 10;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьПроверкуНастроекОсобенностейХраненияДанных(ИмяНастройки = Неопределено) Экспорт
	
	Соответствие = Новый Соответствие;
	
	МассивПредопределенных = Новый Массив;
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяКонфигурации1С");
	
	Если ИмяНастройки = Неопределено Тогда 
		
		МассивПредопределенных.Добавить("ИмяСправочникаЕдиницаИзмерения");
		МассивПредопределенных.Добавить("ИмяСправочникаУпаковка");
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()   
			И Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользуютсяХарактеристики") Тогда 
			МассивПредопределенных.Добавить("ИмяСправочникаХарактеристика");
		КонецЕсли;
		МассивПредопределенных.Добавить("ИмяСправочникаНоменклатура");
		МассивПредопределенных.Добавить("ИмяСправочникаПользователи");
		МассивПредопределенных.Добавить("ИмяСправочникаВалюты");
		МассивПредопределенных.Добавить("ИмяПВХДопСвойства");
		МассивПредопределенных.Добавить("ИмяРегистраДопСвойства");
		
	Иначе
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики() Тогда 
			МассивПредопределенных.Добавить(ИмяНастройки);
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого ИмяПредопределенного Из МассивПредопределенных Цикл 
		
		ОбъектМД = Неопределено;
		
		Значение = ЗначениеНастройки(ИмяПредопределенного);
		
		Если Значение = "Неопределено" Тогда 
			Соответствие.Вставить(ИмяПредопределенного, Истина);
			Продолжить;
		КонецЕсли;
		
		Если ИмяПредопределенного = "ИмяПВХДопСвойства" Тогда 
			
			ОбъектМД = Метаданные.НайтиПоПолномуИмени("ПланВидовХарактеристик." + Значение);
			
		ИначеЕсли ИмяПредопределенного = "ИмяРегистраДопСвойства" Тогда 
			
			ОбъектМД = Метаданные.НайтиПоПолномуИмени("РегистрСведений." + Значение);	
							
		Иначе
			
			
			ОбъектМД = Метаданные.НайтиПоПолномуИмени("Справочник." + Значение);
						
		КонецЕсли;	
				
		Соответствие.Вставить(ИмяПредопределенного, Не ОбъектМД = Неопределено);
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции	

// Вызывается как при создании формы по её данным
// так и при сохранении нового/существующего объекта
//
Функция ЭтоПользовательскаяНастройка(ДанныеФормыОбъекта) Экспорт
	
	ИдСвоихНастроек = "СвоиНастройки";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдСвоихНастроек", ИдСвоихНастроек);
	Запрос.УстановитьПараметр("Родитель", ДанныеФормыОбъекта.Родитель);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_Настройки1.ИмяПредопределенногоДляРасширения = &ИдСвоихНастроек
	|			ТОГДА ИСТИНА
	|		КОГДА КонтурЛогистика_Настройки2.ИмяПредопределенногоДляРасширения = &ИдСвоихНастроек
	|			ТОГДА ИСТИНА
	|		КОГДА КонтурЛогистика_Настройки3.ИмяПредопределенногоДляРасширения = &ИдСвоихНастроек
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоПользовательскаяНастройка
	|ИЗ
	|	Справочник.КонтурЛогистика_Настройки КАК КонтурЛогистика_Настройки1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_Настройки КАК КонтурЛогистика_Настройки2
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_Настройки КАК КонтурЛогистика_Настройки3
	|			ПО КонтурЛогистика_Настройки2.Родитель = КонтурЛогистика_Настройки3.Ссылка
	|		ПО КонтурЛогистика_Настройки1.Родитель = КонтурЛогистика_Настройки2.Ссылка
	|ГДЕ
	|	КонтурЛогистика_Настройки1.Родитель = &Родитель";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЭтоСвоиНастройки = Выборка.ЭтоПользовательскаяНастройка;
	Иначе
		ЭтоСвоиНастройки = Ложь;
	КонецЕсли;
		
	Возврат ЭтоСвоиНастройки;
	
КонецФункции

Функция ЭтоНастройкаТипаШаблонаДляОтправкиКонтрагенту(ИмяНастройки)
	
	Возврат ИмяНастройки = "ПЭ_ТипШаблонаДляОтправкиКонтрагенту"
		Или ИмяНастройки = "ЗЗ_ТипШаблонаДляОтправкиКонтрагенту";
	
КонецФункции

Процедура УстановитьОписаниеТипаШаблонаДляОтправкиКонтрагенту(НастройкаОбъект) Экспорт
	
	Если Не ЭтоНастройкаТипаШаблонаДляОтправкиКонтрагенту(НастройкаОбъект.ИмяПредопределенногоДляРасширения) Тогда
		Возврат;
	КонецЕсли;
	
	Описание = Перечисления.КонтурЛогистика_СценарииРедактированияШаблона.ОписаниеДляНастройки(НастройкаОбъект.Значение);
	Если ЗначениеЗаполнено(Описание) Тогда
		НастройкаОбъект.Описание = Описание;
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеНастройкиДляЗаписи(СтрокаНастройки)
	
	Если ЭтоНастройкаТипаШаблонаДляОтправкиКонтрагенту(СтрокаНастройки.ИмяНастройки) Тогда
		Возврат Перечисления.КонтурЛогистика_СценарииРедактированияШаблона.ОписаниеДляНастройки(
			СтрокаНастройки.Ссылка.Значение);
	КонецЕсли;
	
	Возврат СтрокаНастройки.Описание;
	
КонецФункции

#Область ЗаполнениеЗначениямиПоУмолчанию

Процедура ДобавитьГруппу_ОбщиеНастройки(ТаблицаНастроек)
	
	ДобавитьСтрокуНастроек(ТаблицаНастроек, "",
		"Общие настройки", "ОбщиеНастройки",
		"", "",
		"");
	
	ИмяРодителя = "ОбщиеНастройки";
	
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Авто получение и отправка QR-кодов", "АвтоматическоеПолучениеИОтправкаQRКодов",
		"Булево", "Ложь",
		"Регламентное задание получает QR-коды после подписания нужных титулов и отправляет водителям у которых заполнен адрес "
			+ "электронной почты и в Телеграм по номеру телефона (если включена отправка в Телеграм)");
	
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Использовать отправку в Телеграм", "ИспользоватьОтправкуВТелеграм",
		"Булево", "Ложь",
		"Если настройка включена, то сообщения будут отправляться водителям в Telegram по номеру телефона, указанному в карточке "
			+ "водителя. Замечания перевозчиков и водителей будут отправляться по номерам телефонов, указанным в контактах получателей (организаций и пунктов маршрута).");
	
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Отправлять уведомления водителям о необходимости согласовать погрузку/выгрузку", "ОтправлятьУведомленияВодителюПоставитьПодпись",
		"Булево", "Ложь",
		"Если настройка включена, то будут отправляться уведомления водителям о необходимости подписать документ в личном кабинете. "
			+ "В карточке водителя, если заполнен телефон, то по Телеграм, если заполнен адрес электронной почты, то по почте.");
	
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Использовать группы доступа", "ИспользоватьГруппыДоступа",
		"Булево", "Ложь",
		"Если настройка включена, то будет возможно ограничить доступ определенных пользователей до справочников, титулов и механизмов.");
	
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Использовать ограничения доступа по организации на уровне записей (БСП)", "ИспользоватьОграниченияДоступаПоОрганизацииНаУровнеЗаписей",
		"Булево", "Ложь",
		"Если настройка включена, то будет возможно ограничить доступ на уровне записей определенных пользователей в разрезе организаций. "
