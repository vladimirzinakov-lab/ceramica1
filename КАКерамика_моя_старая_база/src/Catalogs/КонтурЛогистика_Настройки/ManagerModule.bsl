	// Используются характеристики
	Если ИмяКонфигурации = "КЛ"
		Или ИмяКонфигурации = "УПП"
		Или ИмяКонфигурации = "УТ"
		Или ИмяКонфигурации = "УФ_УТ"
		Или ИмяКонфигурации = "УФ_УНФ"
		Или ИмяКонфигурации = "ERP"
		Или ИмяКонфигурации = "КА" Тогда
		
		ТекущееЗначение = "Истина";
	Иначе
		ТекущееЗначение = "Ложь";
	КонецЕсли;
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Используются характеристики", "ИспользуютсяХарактеристики",
		"Булево", ТекущееЗначение,
		"Объясняет программе, следует ли обращать внимание на Характеристики. Для конфигураций где нет характеристик - должно быть значение ""Нет""");
	
	ТекущееЗначение = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНеобходимыеМетаданные("Справочники.алкПунктыРазгрузки"); 
	ДобавитьСтрокуНастроек(ТаблицаНастроек, ИмяРодителя,
		"Используется конвертация для КТ-2000", "ИспользуетсяКонвертацияКТ2000",
		"Булево", ТекущееЗначение,
		"При конвертации будут использоваться настройки, специфичные для КТ-2000");
	
КонецПроцедуры

