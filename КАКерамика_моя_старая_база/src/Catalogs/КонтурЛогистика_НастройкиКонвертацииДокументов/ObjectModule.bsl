#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПометкаУдаления
		И (Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная
			Или Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная)
		И НаправлениеКонвертации <> Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
		
		КонтурЛогистика_СтдОбщегоНазначения.СообщитьПользователюЛок(
			"Для типов «Основная» и «Расширенная» направление может быть только «Учетная система → Логистика».",
			ЭтотОбъект,
			"НаправлениеКонвертации",
			"",
			Отказ);
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И Не ЗначениеЗаполнено(ВерсияСоздания) Тогда
		ВерсияСоздания = КонтурЛогистика_ОбновлениеВерсииМодуля.ТекущаяВерсияПодсистемыКонтурЛогистика();
	КонецЕсли;
	
	Если НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Или НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее Тогда		
		ОбратныйМаппинг = Истина;		
	Иначе		
		ОбратныйМаппинг = Ложь;		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СценарийПоУмолчанию) Тогда 
		
		СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
		
	КонецЕсли;

	Если Не Сценарий_ОтправлятьНеподписанный И Не Сценарий_ОтправлятьПодписанный Тогда 
		
		Сценарий_ОтправлятьПодписанный = Истина;
		
	КонецЕсли;
	
	Если Не Сценарий_ОтправлятьВФоне И Не Сценарий_ОтправлятьВСеансе Тогда 
		
		Сценарий_ОтправлятьВФоне = Ложь;
		Сценарий_ОтправлятьВСеансе = Истина;
		
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТипДокумента1С)
		И КонтурЛогистика_КонвертацияСерверПовтИсп.СценарийДопускаетПустойТипДокумента1С(Сценарий) Тогда
		
		ОбязательныйДокументУчетнойСистемыДляОтправки = Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипДополнительногоСвязанногоДокумента) И Не ЗначениеЗаполнено(Родитель) Тогда 
		
		Отказ = Истина;
		Сообщить("Уточнять тип доп. документа можно только в дочерних настройках конвертации");
		Возврат;
		
	КонецЕсли;

	Если ЗначениеЗаполнено(Родитель) И Не ЗначениеЗаполнено(ДопСвязанныйДокументВыражениеВычисления) Тогда 
		
		Отказ = Истина;
		Сообщить("Для дочерних настроек обязательно указывать Вычисление дополнительного документа (реквизит ДопСвязанныйДокументВыражениеВычисления), иначе она никогда не применится");
		Возврат;
		
	КонецЕсли;
	
	Если Не ПометкаУдаления И Не ИерархияВерна() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	// проверка наименования
	Если Не Наименование = Ссылка.Наименование И Не ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
			|ГДЕ
			|	КонтурЛогистика_НастройкиКонвертацииДокументов.Наименование = &Наименование
			|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			Сообщить("Укажите другое наименование. В базе уже есть настройка конвертации документов с наименованием: " + Наименование);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если Типзнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("Родитель") 
		И ЗначениеЗаполнено(ДанныеЗаполнения.Родитель) Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Родитель, , "Владелец, Родитель"); 
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Тип) Тогда
		Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Замещающая;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИерархияВерна()
	
	// При совпадении ключа (Родитель, типы, спецсценарий, доп.документ) нельзя две НКД,
	// кроме пары Входящее + Исходящее. Двунаправленная (ИсходящееВходящее) конфликтует с любой другой.
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	Запрос.УстановитьПараметр("ТипДокумента1С", ТипДокумента1С);
	Запрос.УстановитьПараметр("ТипДополнительногоСвязанногоДокумента", ТипДополнительногоСвязанногоДокумента);
	Запрос.УстановитьПараметр("НаправлениеКонвертации", НаправлениеКонвертации);
	Если СпецСценарий = Неопределено Тогда
		Запрос.УстановитьПараметр("СпецСценарий", Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("СпецСценарий", СпецСценарий);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка <> &Ссылка
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = &Родитель
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С = &ТипДокумента1С
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = &СпецСценарий
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДополнительногоСвязанногоДокумента = &ТипДополнительногоСвязанногоДокумента
	|	И ВЫБОР
	|			КОГДА КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = &НаправлениеКонвертации
	|				ТОГДА ИСТИНА
	|			КОГДА КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее)
	|				ТОГДА ИСТИНА
	|			КОГДА &НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ШаблонСообщения = "Уже есть настройка конвертации по %1 %2 %3";
		ТесктСообщения = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			ШаблонСообщения, ТипДокумента1С, ТипДокументаЛогистика, ТипДополнительногоСвязанногоДокумента);
		Сообщить(ТесктСообщения);
		
		Возврат Ложь;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецЕсли