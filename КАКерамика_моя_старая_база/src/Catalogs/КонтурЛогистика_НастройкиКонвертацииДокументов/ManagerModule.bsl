	|			ПО КонтурЛогистика_ПЛ_Титул1.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
	|		ПО втДокументы.Ссылка = КонтурЛогистика_ПЛ_Титул1.ДокументОснование
	|			И (НЕ КонтурЛогистика_ПЛ_Титул1.Ссылка.ПометкаУдаления)
	|	//ДопСоединениеИЗ
	|ГДЕ
	|	(&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.Отправка)
	|			ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного))
	|	//ДопУсловиеГДЕ";
	
	ИспользуютсяМногиеКОдномуЭПЛ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдномуЭПЛ");
	Если Не ИспользуютсяМногиеКОдномуЭПЛ Тогда
		БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса,
			"Документ.КонтурЛогистика_ПЛ_Титул1.ДокументыОснования",
			"Документ.КонтурЛогистика_ПЛ_Титул1");
	КонецЕсли;
	
	Возврат БазовыйТекстЗапроса;
	
