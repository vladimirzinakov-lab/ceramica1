			"КонтурЛогистика_ПредыдущийТитул.ПометкаУдаления");
			
			БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса,
			"ПредыдущийТитул.Титул1",
			"ПредыдущийТитул.Ссылка");
			
		КонецЕсли;
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2	Тогда 

	Иначе
		
		ВызватьИсключение "Непредполагаемый вызов процедуры СпозиционироватьТекстЗапросаНаУказанныйТитул или требуется её доработка";
		
	КонецЕсли;	

КонецПроцедуры

