	|	втДокументы.Контрагент КАК Контрагент,
	|	втДокументы.Перевозчик КАК Перевозчик,
	|	втДокументы.Отправитель КАК Отправитель,
	|	втДокументы.Получатель КАК Получатель,
	|	КонтурЛогистика_ТрН_Титул1.Номер КАК ЛогистикаДокументНомер,
	|	КонтурЛогистика_ТрН_Титул1.Дата КАК ЛогистикаДокументДата,
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ГлавныйДокумент,
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.ТестовыйДокумент КАК ТестовыйДокумент,
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_ТрН_Титул1.Ссылка ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КартинкаЛогистика,
	|	втДокументы.Ссылка.Проведен КАК Документ1СПроведен,
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН КАК ДокументЭТРН,
	|	КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние КАК СтатусЭТРН,
	|	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.НомерТрН, втДокументы.НомерТРН) КАК НомерТрН,
	|	ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.ДатаТрН, втДокументы.ДатаТРН) КАК ДатаТрН,
	|	ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ТрН_Титул1.ПустаяСсылка) КАК ПредыдущийТитул,
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КомментарииВодителяПриПогрузке <> """"
	|		ИЛИ КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КомментарииВодителяПриВыгрузке <> """" КАК КомментарииВодителя,
	|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.СогласованоВодителемПриПогрузке КАК СогласованоВодителемПриПогрузке,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 0
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 0
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 0
	|			ТОГДА 0
	|		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 0
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 0
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 1
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 0
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 1
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 0
	|			ТОГДА 2
	|		КОГДА ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоПереадресовок, 0) = 1
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменВодителей, 0) = 0
	|				И ЕСТЬNULL(КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КоличествоСменТС, 0) = 0
	|			ТОГДА 3
	|		ИНАЧЕ 4
	|	КОНЕЦ КАК КартинкаПереадресовокЗамен,
	|	КонтурЛогистика_ТрН_Титул1.ОтправительШаблона КАК ОтправительШаблона,
	|	втДокументы.МестоПогрузки КАК МестоПогрузки,
	|	втДокументы.МестоДоставки КАК МестоДоставки,
	|	втДокументы.Водитель КАК Водитель,
	|	втДокументы.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_Сотрудники.ПустаяСсылка) КАК ВодительЛогистика,
	|	0 КАК СтоимостьБезНДС
	|ИЗ
