Процедура ВернутьДопУсловияИСоединенияВТекстЗапроса(ПолныйТекстЗапроса)
	
	ЕстьНесколькоТипов1С = (Найти(ПолныйТекстЗапроса, "ОбъединеннаяТаблица.") <> 0);
	Если ЕстьНесколькоТипов1С Тогда
		
		// Несколько объединенных запросов
		НомерПрохода = 1;
		ИндексПервогоГлавногоГде = Найти(ПолныйТекстЗапроса, Символы.ПС + "	ГДЕ");
		Пока ИндексПервогоГлавногоГде <> 0 Цикл
			
			ПолныйТекстЗапроса = Лев(ПолныйТекстЗапроса, ИндексПервогоГлавногоГде - 1) + "
				|	//ДопСоединениеИЗ" + Прав(ПолныйТекстЗапроса, СтрДлина(ПолныйТекстЗапроса) - ИндексПервогоГлавногоГде + 1);
			
			ДлинаСПраваОбъединитьВсе = СтрДлина(ПолныйТекстЗапроса) - ИндексПервогоГлавногоГде - 26 * НомерПрохода;
			ТекстПоиска = Прав(ПолныйТекстЗапроса, ДлинаСПраваОбъединитьВсе);
			ИндексПервогоГлавногоОбъединитьВсе = Найти(ТекстПоиска, Символы.ПС + "	ОБЪЕДИНИТЬ ВСЕ");
			
			Если ИндексПервогоГлавногоОбъединитьВсе = 0 Тогда
				ТекстОкончания = ") КАК ОбъединеннаяТаблица";
				ПолныйТекстЗапроса = Лев(ПолныйТекстЗапроса, СтрДлина(ПолныйТекстЗапроса) - СтрДлина(ТекстОкончания)) + "
				|	//ДопУсловиеГДЕ
				|" + ТекстОкончания;
			Иначе
				ИндексПервогоГлавногоОбъединитьВсе = ИндексПервогоГлавногоОбъединитьВсе
					+ СтрДлина(ПолныйТекстЗапроса) - ДлинаСПраваОбъединитьВсе;
				ПолныйТекстЗапроса = Лев(ПолныйТекстЗапроса, ИндексПервогоГлавногоОбъединитьВсе - 2) + "
					|	//ДопУсловиеГДЕ" + Прав(ПолныйТекстЗапроса, СтрДлина(ПолныйТекстЗапроса) - ИндексПервогоГлавногоОбъединитьВсе + 2);
			КонецЕсли;
			
			// Найдем следующий
			ДлинаСПрава = СтрДлина(ПолныйТекстЗапроса) - ИндексПервогоГлавногоГде - 26 * НомерПрохода;
			ТекстПоиска = Прав(ПолныйТекстЗапроса, ДлинаСПрава);
			ИндексПервогоГлавногоГде = Найти(ТекстПоиска, Символы.ПС + "	ГДЕ");
			Если ИндексПервогоГлавногоГде = 0 Тогда
				Прервать;
			КонецЕсли;
			ИндексПервогоГлавногоГде = ИндексПервогоГлавногоГде + СтрДлина(ПолныйТекстЗапроса) - ДлинаСПрава;
			
			НомерПрохода = НомерПрохода + 1;
			
		КонецЦикла;
		
	Иначе
		
		// Одинт учетный документ
		ИндексПервогоГлавногоГде = Найти(ПолныйТекстЗапроса, Символы.ПС + "ГДЕ");
		
		Если ИндексПервогоГлавногоГде = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПолныйТекстЗапроса = Лев(ПолныйТекстЗапроса, ИндексПервогоГлавногоГде - 1) + "
			|	//ДопСоединениеИЗ" + Прав(ПолныйТекстЗапроса, СтрДлина(ПолныйТекстЗапроса) - ИндексПервогоГлавногоГде + 1);
		
		ИндексПервогоГлавногоОбъединитьВсе = Найти(ПолныйТекстЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ");
		
		Если ИндексПервогоГлавногоОбъединитьВсе = 0 Тогда
			ПолныйТекстЗапроса = ПолныйТекстЗапроса + "
			|	//ДопУсловиеГДЕ";
		Иначе
			ПолныйТекстЗапроса = Лев(ПолныйТекстЗапроса, ИндексПервогоГлавногоОбъединитьВсе - 2) + "
				|	//ДопУсловиеГДЕ" + Прав(ПолныйТекстЗапроса, СтрДлина(ПолныйТекстЗапроса) - ИндексПервогоГлавногоОбъединитьВсе + 2);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПереходНаЭПЛ502

Процедура ПеренестиНастройкиКонвертацииДокументовДляЭПЛВФормат502(ТихийРежим = Истина) Экспорт
	
	ТипыДокументаЛогистика = Новый Массив;
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5);
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6);
	
	МассивНКД = ПолучитьМассивНКДПоТипуЛогистики(ТипыДокументаЛогистика);
	
	Для каждого НКД Из МассивНКД Цикл		
		
		Попытка
			
			Если НКД.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
				ПеренестиИсходящуюНастройкуКонвертацииДокументовВФормат502(НКД, ТихийРежим);
			ИначеЕсли НКД.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
				ПеренестиВходящуюНастройкуКонвертацииДокументовВФормат502(НКД, ТихийРежим);
			КонецЕсли;
			
		Исключение
			
			ТекстОшибки = "Ошибка при переносе НКД в формат 5.02. Ошибка: " + ОписаниеОшибки();
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
			Если Не ТихийРежим Тогда
				Сообщить(ТекстОшибки);
			КонецЕсли;
			
		КонецПопытки;			
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьМассивНКДПоТипуЛогистики(ТипыДокументаЛогистика)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка)
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика В(&ТипыДокументаЛогистика)
		|УПОРЯДОЧИТЬ ПО
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ТипыДокументаЛогистика", ТипыДокументаЛогистика);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ПеренестиВходящуюНастройкуКонвертацииДокументовВФормат502(НКД, ТихийРежим = Истина)
	
	Если НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02;
	КонецЕсли;
	
	НКД502 = НайтиНастройкуКонвертацииДокументов(ТипЭПЛ502, НКД.ТипДокумента1С, НКД.Родитель, 
		Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее);
	
	Если ЗначениеЗаполнено(НКД502) Тогда
		
		НКД502Объект = НКД502.ПолучитьОбъект();
		НКД502Объект.УстановитьПометкуУдаления(Истина);
		Если Не ТихийРежим Тогда
			Сообщить("Настройка конвертации " + НКД502Объект.Наименование + " помечена на удаление");
		КонецЕсли;
		
	КонецЕсли;	
	
	НКД502Объект = НКД.Скопировать();
	
	НКД502Объект.ТипДокументаЛогистика = ТипЭПЛ502;				
	НКД502Объект.ПутьГрузоотправитель = "";
	
	НКД502Объект.ЗаполнениеДокУчСист.Очистить();
	НКД502Объект.ЗаполнениеДокУчСистТЧПроизвольная.Очистить();
	НКД502Объект.ПеременныеДокУчСист.Очистить();
	
	массивТЧ = Новый Массив;
	массивТЧ.Добавить("ЗаполнениеДокУчСист");
	массивТЧ.Добавить("ЗаполнениеДокУчСистТЧПроизвольная");
	массивТЧ.Добавить("ПеременныеДокУчСист");
	
	Для каждого ТЧ Из массивТЧ Цикл
	
		Для каждого ПравилоКонвертации Из НКД[ТЧ] Цикл
			
			НоваяСтрока = НКД502Объект[ТЧ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПравилоКонвертации);
			
			ОбработатьПравилоВходящейКонвертации(ТипЭПЛ502, НоваяСтрока);
			
		КонецЦикла;
		
	КонецЦикла;
	
	НКД502Объект.Записать();
	
	Если Не ТихийРежим Тогда
		Сообщить("Создана НКД " + НКД502Объект.Наименование);
	КонецЕсли;
				
КонецПроцедуры

Процедура ОбработатьПравилоВходящейКонвертации(ТипЛогистики, НоваяСтрока)
	
	Если ТипЛогистики = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда	
	
		Если Найти(НРег(НоваяСтрока.ВыражениеВычисленияСтрокаНеогр), "грузоотправитель") > 0 Тогда
			НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = СтрЗаменить(НоваяСтрока.ВыражениеВычисленияСтрокаНеогр, "Грузоотправитель", "ЛицоОформившееПЛ");
			НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = СтрЗаменить(НоваяСтрока.ВыражениеВычисленияСтрокаНеогр, "грузоотправитель", "ЛицоОформившееПЛ");
		КонецЕсли;
		Если Найти(НРег(НоваяСтрока.ВыражениеВычисления), "грузоотправитель") > 0 Тогда
			НоваяСтрока.ВыражениеВычисления = СтрЗаменить(НоваяСтрока.ВыражениеВычисления, "Грузоотправитель", "ЛицоОформившееПЛ");
			НоваяСтрока.ВыражениеВычисления = СтрЗаменить(НоваяСтрока.ВыражениеВычисления, "грузоотправитель", "ЛицоОформившееПЛ");
		КонецЕсли;
		
		Если Найти(НРег(НоваяСтрока.ВыражениеВычисленияСтрокаНеогр), "местоотправления") > 0 Тогда
			НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = "";
		КонецЕсли;
		Если Найти(НРег(НоваяСтрока.ВыражениеВычисления), "местоотправления") > 0 Тогда
			НоваяСтрока.ВыражениеВычисления = "";
		КонецЕсли;
		
	ИначеЕсли ТипЛогистики = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02
		Или ТипЛогистики = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда	
	
		Если Найти(НРег(НоваяСтрока.ВыражениеВычисленияСтрокаНеогр), "одометрработник") > 0 Тогда
			НоваяСтрока.ВыражениеВычисленияСтрокаНеогр = "";
		КонецЕсли;
		Если Найти(НРег(НоваяСтрока.ВыражениеВычисления), "одометрработник") > 0 Тогда
			НоваяСтрока.ВыражениеВычисления = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиИсходящуюНастройкуКонвертацииДокументовВФормат502(НКД, ТихийРежим = Истина)
	
	Если НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02;
	ИначеЕсли НКД.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02;
	КонецЕсли;
	
	НКД502 = НайтиНастройкуКонвертацииДокументов(ТипЭПЛ502, НКД.ТипДокумента1С, НКД.Родитель);
	
	Если ЗначениеЗаполнено(НКД502) Тогда
		
		НКД502Объект = НКД502.ПолучитьОбъект();
		НКД502Объект.УстановитьПометкуУдаления(Истина);
		Если Не ТихийРежим Тогда
			Сообщить("Настройка конвертации " + НКД502Объект.Наименование + " помечена на удаление");
		КонецЕсли;
		
	КонецЕсли;	
	
	НКД502Объект = НКД.Скопировать();
	
	НКД502Объект.ТипДокументаЛогистика = ТипЭПЛ502;				
	НКД502Объект.ПутьГрузоотправитель = "";
	
	НКД502Объект.ПравилаКонвертацииТитулаРеквизиты.Очистить();
	НКД502Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.Очистить();
	НКД502Объект.ТаблицаСоответствий.Очистить();
	НКД502Объект.ПравилаКонвертацииМассивовСтруктур.Очистить();
	НКД502Объект.Переменные.Очистить();
	
	Если ЗначениеЗаполнено(НКД502Объект.Родитель) Тогда
		НКД502Объект.Родитель = НайтиНастройкуКонвертацииДокументов(ТипЭПЛ502, НКД.ТипДокумента1С);
		НКД502Объект.Наименование = СокрЛП(НаименованиеНКД(НКД502Объект)) + ", дочерняя " + НКД.Код + " 5.02";
	Иначе
		НКД502Объект.Наименование = СокрЛП(НаименованиеНКД(НКД502Объект)) + " 5.02";
	КонецЕсли;
	
	Для каждого ПравилоКонвертации Из НКД.ПравилаКонвертацииТитулаРеквизиты Цикл
		
		НоваяСтрока = Неопределено;
		
		РеквизитТитула502 = ПолучитьРеквизитДляНКД502(ТипЭПЛ502, ПравилоКонвертации.РеквизитТитула);
		
		НайдСтрока = НайтиСтрокуВТЧ(НКД502Объект, "ПравилаКонвертацииТитулаРеквизиты", РеквизитТитула502);
		Если НайдСтрока = Неопределено Тогда
			
			ПереноситьРеквизит = ПереноситьРеквизит(РеквизитТитула502, ТипЭПЛ502);
						
			Если ПереноситьРеквизит Тогда
				НоваяСтрока = НКД502Объект.ПравилаКонвертацииТитулаРеквизиты.Добавить();	
			КонецЕсли;			
			
		Иначе
			НоваяСтрока = НайдСтрока;
		КонецЕсли;
		
		Если НоваяСтрока <> Неопределено Тогда			
			ПеренестиРеквизитВыражениеВычисления2(НоваяСтрока, ПравилоКонвертации, РеквизитТитула502);			
		КонецЕсли;
		
	КонецЦикла;
	
	ПеренестиПрочиеТЧНастройкиКонвертацииДокументов(НКД, НКД502Объект, ТипЭПЛ502);
	
	Если ТипЭПЛ502 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		ДополнитьДаннымиНастройкиКонвертацииДокументовИзП4(НКД502Объект);	
	КонецЕсли;
	
	НКД502Объект.Записать();
	
	Если Не ТихийРежим Тогда
		Сообщить("Создана НКД " + НКД502Объект.Наименование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиРеквизитВыражениеВычисления2(НоваяСтрока, ПравилоКонвертации, РеквизитТитула502)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПравилоКонвертации);
	НоваяСтрока.РеквизитТитула = РеквизитТитула502; 
	
	Если НоваяСтрока.СпособМаппинга <> Перечисления.КонтурЛогистика_СпособыМаппингаПоля.ИзПредыдущегоТитула Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(НоваяСтрока.ВыражениеВычисления2) = Тип("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1") Тогда
		НоваяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;	
	ИначеЕсли ТипЗнч(НоваяСтрока.ВыражениеВычисления2) = Тип("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2") Тогда
		НоваяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02;
	ИначеЕсли ТипЗнч(НоваяСтрока.ВыражениеВычисления2) = Тип("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3") Тогда
		НоваяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;
	ИначеЕсли ТипЗнч(НоваяСтрока.ВыражениеВычисления2) = Тип("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4") Тогда
		НоваяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;
	ИначеЕсли ТипЗнч(НоваяСтрока.ВыражениеВычисления2) = Тип("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5") Тогда
		НоваяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02;
	ИначеЕсли ТипЗнч(НоваяСтрока.ВыражениеВычисления2) = Тип("ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6") Тогда
		НоваяСтрока.ВыражениеВычисления2 = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02;
	КонецЕсли;	
	
КонецПроцедуры

Функция НайтиНастройкуКонвертацииДокументов(ТипДокументаЛогистика, ТипДокумента1С, Родитель = Неопределено, НаправлениеКонвертации = Неопределено) Экспорт
	
	Если Родитель = Неопределено Тогда
		Родитель = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка();
	КонецЕсли;
	
	Если НаправлениеКонвертации = Неопределено Тогда
		НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		|ГДЕ
		|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка)
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С = &ТипДокумента1С
		|   И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = &Родитель
		|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика";
	
	Запрос.УстановитьПараметр("ТипДокумента1С", ТипДокумента1С);
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("НаправлениеКонвертации", НаправлениеКонвертации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ПеренестиПрочиеТЧНастройкиКонвертацииДокументов(НКД, НКД502Объект, ТипДокументаЛогистика)
	
	Для каждого Переменная Из НКД.Переменные Цикл
		
		НайдСтрока = НКД502Объект.Переменные.Найти(Переменная.Имя, "Имя");
		Если НайдСтрока = Неопределено Тогда
			НоваяСтрока = НКД502Объект.Переменные.Добавить();			
		Иначе
			НоваяСтрока = НайдСтрока;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Переменная);
			
	КонецЦикла;
	
	Для каждого ПравилоКонвертации Из НКД.ПравилаКонвертацииТитулаТабЧастьПроизвольная Цикл

		Если ПравилоКонвертации.ИмяТЧТитула = "ДополнительныеГрузоотправители" Или ПравилоКонвертации.ИмяТЧТитула = "АдресаПунктов" Тогда
			Продолжить;	
		КонецЕсли;		
		
		Отбор = Новый Структура("ИмяТЧТитула, РеквизитТитула", ПравилоКонвертации.ИмяТЧТитула, ПравилоКонвертации.РеквизитТитула);
		НайдСтроки = НКД502Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.НайтиСтроки(Отбор);
		Если НайдСтроки.Количество() = 0 Тогда
			НоваяСтрока = НКД502Объект.ПравилаКонвертацииТитулаТабЧастьПроизвольная.Добавить();			
		Иначе
			НоваяСтрока = НайдСтроки[0];
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПравилоКонвертации);
		
	КонецЦикла;
	
	Для каждого ПравилоКонвертации Из НКД.ПравилаКонвертацииМассивовСтруктур Цикл

		Если ПравилоКонвертации.ИмяТабличнойЧасти = "ДополнительныеГрузоотправители" Или ПравилоКонвертации.ИмяТабличнойЧасти = "АдресаПунктов" Тогда
			Продолжить;	
		КонецЕсли;		
		
		НоваяСтрока = НКД502Объект.ПравилаКонвертацииМассивовСтруктур.Добавить();			
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПравилоКонвертации);
		
	КонецЦикла;
	
	Для каждого Соответствие Из НКД.ТаблицаСоответствий Цикл
		
		НоваяСтрока = Неопределено;
		
		РеквизитТитула502 = ПолучитьРеквизитДляНКД502(ТипДокументаЛогистика, Соответствие.ИмяРеквизитаЗначения);
		
		ПереноситьРеквизит = ПереноситьРеквизит(РеквизитТитула502, ТипДокументаЛогистика);						
		Если ПереноситьРеквизит Тогда
			НоваяСтрока = НКД502Объект.ТаблицаСоответствий.Добавить();	
		КонецЕсли;			
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Соответствие);
		НоваяСтрока.ИмяРеквизитаЗначения = РеквизитТитула502;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьДаннымиНастройкиКонвертацииДокументовИзП4(НКДП3Объект)
	
	ТипыДокументаЛогистика = Новый Массив;
	ТипыДокументаЛогистика.Добавить(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4);
	МассивНКДП4 = ПолучитьМассивНКДПоТипуЛогистики(ТипыДокументаЛогистика);
	
	Если МассивНКДП4.Количество() = 1 Тогда
		
		НКДП4 = МассивНКДП4[0];
		
		ПеренестиРеквизит(НКДП3Объект, НКДП4, "ПравилаКонвертацииТитулаРеквизиты", "ПоказанияОдометра");
		ПеренестиРеквизит(НКДП3Объект, НКДП4, "ПравилаКонвертацииТитулаРеквизиты", "ДатИнфВыпуск");
		ПеренестиРеквизит(НКДП3Объект, НКДП4, "ПравилаКонвертацииТитулаРеквизиты", "ВрИнфВыпуск");
		
		Для каждого Переменная Из НКДП4.Переменные Цикл
			
			НайдСтрокаВП3 = НКДП3Объект.Переменные.Найти(Переменная.Имя, "Имя");
			Если НайдСтрокаВП3 = Неопределено Тогда
				НоваяСтрока = НКДП3Объект.Переменные.Добавить();			
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Переменная);
			Иначе
				
				Если Переменная.СпособМаппинга <> НайдСтрокаВП3.СпособМаппинга
					Или Нрег(СокрЛП(Переменная.ВыражениеВычисления)) <> Нрег(СокрЛП(НайдСтрокаВП3.ВыражениеВычисления))
					Или Нрег(СокрЛП(Переменная.ВыражениеВычисленияСтрокаНеогр)) <> Нрег(СокрЛП(НайдСтрокаВП3.ВыражениеВычисленияСтрокаНеогр)) Тогда
					НоваяСтрока = НКДП3Объект.Переменные.Добавить();			
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Переменная);
					НоваяСтрока.Имя = НоваяСтрока.Имя + "_";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиРеквизит(НКДП3Объект, НКДП4, ИмяТЧ, ИмяРеквизита)

	НайдСтрока = НайтиСтрокуВТЧ(НКДП4, ИмяТЧ, ИмяРеквизита);
	Если НайдСтрока <> Неопределено Тогда
		
		ИмяРеквизитТитула502 = ПолучитьРеквизитДляНКД502(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02, ИмяРеквизита);
		
		НайдСтрока502 = НайтиСтрокуВТЧ(НКДП3Объект, ИмяТЧ, ИмяРеквизитТитула502);
		Если НайдСтрока502 <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НайдСтрока502, НайдСтрока);
			НайдСтрока502.РеквизитТитула = ИмяРеквизитТитула502;
		Иначе
			НоваяСтрока = НКДП3Объект[ИмяТЧ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтрока);
			НоваяСтрока.РеквизитТитула = ИмяРеквизитТитула502;
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьРеквизитДляНКД502(ТипЛогистика, ИмяРеквизита)
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		Если ИмяРеквизита = "ДанныеТ4ПоказанияОдометра" Тогда
			Возврат "ДанныеТ3ПоказанияОдометра";
		КонецЕсли;
			
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		
		Если ИмяРеквизита = "ДатИнфВыезд" Тогда
			Возврат "ДатИнфВыпуск";
		ИначеЕсли ИмяРеквизита = "ВрИнфВыезд" Тогда
			Возврат "ВрИнфВыпуск";			
		КонецЕсли;
			
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
		
		Если ИмяРеквизита = "ДатВрОдометр" Тогда
			Возврат "ДтВрВозвр";	
		ИначеЕсли ИмяРеквизита = "ИдФайлИнфВыезд" Тогда
			Возврат "ИдФайлИнфВыпуск";
		ИначеЕсли ИмяРеквизита = "ВрФайлИнфВыезд" Тогда
			Возврат "ВрФайлИнфВыпуск";			
		ИначеЕсли ИмяРеквизита = "ДатФайлИнфВыезд" Тогда
			Возврат "ДатФайлИнфВыпуск";					
		ИначеЕсли ИмяРеквизита = "ДатИнфЗаезд" Тогда
			Возврат "ДатИнфВозвр";
		ИначеЕсли ИмяРеквизита = "ВрИнфЗаезд" Тогда
			Возврат "ВрИнфВозвр";
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат ИмяРеквизита;
	
КонецФункции

Функция ПереноситьРеквизит(РеквизитТитула, ТипДокументаЛогистика)
	
	ПереноситьРеквизит = Ложь;
		
	ИмяДокумента = "КонтурЛогистика_" + Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипДокументаЛогистика);
	ДокументОбъектМетаданных = Метаданные.Документы[ИмяДокумента];
	
	Если Найти(РеквизитТитула, "МассивСтруктур") > 0 Тогда				
		ИмяТЧ = СтрЗаменить(РеквизитТитула, "МассивСтруктур", "");
		ПереноситьРеквизит = ДокументОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТЧ) <> Неопределено;				
	Иначе				
		ПереноситьРеквизит = ДокументОбъектМетаданных.Реквизиты.Найти(РеквизитТитула) <> Неопределено;
	КонецЕсли;
	
	Возврат ПереноситьРеквизит;
	
КонецФункции

Функция НайтиСтрокуВТЧ(НКД, ИмяТЧ, ИмяРеквизитТитула)
	
	Возврат НКД[ИмяТЧ].Найти(ИмяРеквизитТитула, "РеквизитТитула");	
		
КонецФункции

Функция НаименованиеНКД(НКД)	
	
	Наименование = "";
	
	Если ЗначениеЗаполнено(НКД.ТипДокумента1С) Тогда
		Наименование = "" + НКД.ТипДокументаЛогистика + " по " + НКД.ТипДокумента1С;
	ИначеЕсли НКД.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1")
		Или НКД.ТипДокументаЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02") Тогда 
		Наименование = "" + НКД.ТипДокументаЛогистика + " ввод вручную";
	Иначе
		Наименование = "" + НКД.ТипДокументаЛогистика + " по предыдущему титулу";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НКД.ТипДополнительногоСвязанногоДокумента) И ЗначениеЗаполнено(НКД.Родитель) Тогда
		Наименование = "" + НКД.ТипДополнительногоСвязанногоДокумента + " - " + Наименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НКД.НаправлениеКонвертации) Тогда
		Наименование = Наименование + ", " + НРег(НКД.НаправлениеКонвертации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НКД.СпецСценарий) Тогда
		Наименование = Наименование + ", " + НРег(НКД.СпецСценарий);
	КонецЕсли;
	
	Возврат Наименование;
		
КонецФункции

#Область ШаблоныДокументовПЭЗЗ

Функция ИмяНастройкиИспользоватьШаблоныДокументов(ТипДокументаЛогистика) Экспорт
	
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		Возврат "ПЭ_ИспользоватьШаблоныДокументов";
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		Возврат "ЗЗ_ИспользоватьШаблоныДокументов";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ИспользоватьШаблоныДокументов(ТипДокументаЛогистика) Экспорт
	
	ИмяНастройки = ИмяНастройкиИспользоватьШаблоныДокументов(ТипДокументаЛогистика);
	Если Не ЗначениеЗаполнено(ИмяНастройки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(ИмяНастройки);
	
КонецФункции

Функция ПроверкаПройденаСценарийОтправкиШаблона(ТипДокументаЛогистика, Сценарий) Экспорт 
	
	Возврат НЕ Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаШаблона
			ИЛИ ИспользоватьШаблоныДокументов(ТипДокументаЛогистика);
	
КонецФункции

Процедура ОбработатьОтключениеИспользованияШаблоновДокументов(ИмяНастройки) Экспорт
	
	ТипДокументаЛогистика = Неопределено;
	
	Если ИмяНастройки = "ПЭ_ИспользоватьШаблоныДокументов" Тогда
		ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1;
	ИначеЕсли ИмяНастройки = "ЗЗ_ИспользоватьШаблоныДокументов" Тогда
		ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1;
	Иначе
		Возврат;
	КонецЕсли;
	
	КоличествоОтключенныхНКД = ОтключитьВыводЗадачНКДСоСценариемОтправкиШаблона(ТипДокументаЛогистика);
	
	Если КоличествоОтключенныхНКД > 0 Тогда
		
		ШаблонСообщения = "Настройка ""%1"" отключена. Снята галочка ""Выводить задачи"" у %2 настроек конвертации со сценарием ""Отправка шаблона"".";
		Сообщить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			ШаблонСообщения,
			ПредставлениеНастройкиИспользоватьШаблоныДокументов(ИмяНастройки),
			КоличествоОтключенныхНКД));
	
	КонецЕсли;
	
КонецПроцедуры

Функция ОтключитьВыводЗадачНКДСоСценариемОтправкиШаблона(ТипДокументаЛогистика)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Сценарий = &Сценарий
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ВыводитьЗадачи";
	
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	Запрос.УстановитьПараметр("Сценарий", Перечисления.КонтурЛогистика_Сценарии.ОтправкаШаблона);
	
	КоличествоОтключенныхНКД = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НКДОбъект = Выборка.Ссылка.ПолучитьОбъект();
		НКДОбъект.ВыводитьЗадачи = Ложь;
		НКДОбъект.Записать();
		КоличествоОтключенныхНКД = КоличествоОтключенныхНКД + 1;
		
	КонецЦикла;
	
	Если КоличествоОтключенныхНКД > 0 Тогда
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
	Возврат КоличествоОтключенныхНКД;
	
КонецФункции

Функция ТекстОшибкиСценарияОтправкиШаблона(ИмяНастройки)
	
	ШаблонСообщения = "Сценарий ""Отправка шаблона"" недоступен. Включите настройку ""%1"".";
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
		ШаблонСообщения,
		ПредставлениеНастройкиИспользоватьШаблоныДокументов(ИмяНастройки));
	
КонецФункции

Функция ПредставлениеНастройкиИспользоватьШаблоныДокументов(ИмяНастройки)
	
	Если ИмяНастройки = "ПЭ_ИспользоватьШаблоныДокументов" Тогда
		Возврат "Использовать шаблоны документов для ПЭ";
	ИначеЕсли ИмяНастройки = "ЗЗ_ИспользоватьШаблоныДокументов" Тогда
		Возврат "Использовать шаблоны документов для ЗЗ";
	КонецЕсли;
	
	Возврат ИмяНастройки;
	
КонецФункции

