#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Если ОбратныйМаппинг = Неопределено и есть как входящие так и исходящие, то приоритетно вернем ИСХОДЯЩУЮ
Функция ПолучитьНастройкуКонвертации(ТипДокументаЛогистика, Знач ТипДокумента1С_СтрокаИлиСсылкаНаДокумент = Неопределено, 
	СпецСценарий = Неопределено, ОбратныйМаппинг = Неопределено) Экспорт

	ТипДокумента1С_Строка = КонтурЛогистика_ОбщегоНазначенияСервер.ПредставлениеУчетногоДокументаСтрокой(
		ТипДокумента1С_СтрокаИлиСсылкаНаДокумент);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	Запрос.УстановитьПараметр("ТипДокумента1С", ТипДокумента1С_Строка);
	Если СпецСценарий = Неопределено Тогда
		Запрос.УстановитьПараметр("СпецСценарий", Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("СпецСценарий", СпецСценарий);
	КонецЕсли;
	
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И (КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С = &ТипДокумента1С
	|			ИЛИ &ТипДокумента1С = НЕОПРЕДЕЛЕНО
	|			ИЛИ &ТипДокумента1С = ""Предыдущий титул"")
	|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = &СпецСценарий
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С УБЫВ,
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Тип.Порядок УБЫВ,
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ОбратныйМаппинг";
	
	Если ОбратныйМаппинг <> Неопределено Тогда 
		Запрос.УстановитьПараметр("ОбратныйМаппинг", ОбратныйМаппинг);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления",
												 "И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
												 |	И КонтурЛогистика_НастройкиКонвертацииДокументов.ОбратныйМаппинг = &ОбратныйМаппинг");
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНастройкуКонвертацииПустойТипДокумента1С(ТипДокументаЛогистика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С = """"
	|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Признак сценария НКД «отправлять неподписанный» для карточки титула.
// Читает реквизиты справочника напрямую: в контексте конвертации булевы флаги
// могут не перенестись из-за ЗначениеЗаполнено и кэша ПовтИсп.
//
// Параметры:
//  ТипЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - тип титула.
//  ДокументОснование - ДокументСсылка, Неопределено - учетный документ основания титула.
//
// Возвращаемое значение:
//  Булево - Истина, если сценарий НКД разрешает отправку неподписанного.
//
Функция СценарийРазрешаетОтправкуНеподписанного(ТипЛогистика, ДокументОснование = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Настройка = ПолучитьНастройкуКонвертации(ТипЛогистика, ДокументОснование);
		Если ЗначениеЗаполнено(Настройка) Тогда
			Возврат НастройкаРазрешаетОтправкуНеподписанного(Настройка);
		КонецЕсли;
	КонецЕсли;
	
	НастройкаБезТипа1С = ПолучитьНастройкуКонвертацииПустойТипДокумента1С(ТипЛогистика);
	Если ЗначениеЗаполнено(НастройкаБезТипа1С)
		И НастройкаРазрешаетОтправкуНеподписанного(НастройкаБезТипа1С) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ТекущаяНастройка Из МассивНастроекКонвертацииПоТипуЛогистики(ТипЛогистика) Цикл
		Если НастройкаРазрешаетОтправкуНеподписанного(ТекущаяНастройка) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Признак сценария НКД «отправлять подписанный» для карточки титула.
// Читает реквизит справочника напрямую: в контексте конвертации булево Ложь
// не переносится из-за ЗначениеЗаполнено.
//
// Параметры:
//  ТипЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - тип титула.
//  ДокументОснование - ДокументСсылка, Неопределено - учетный документ основания титула.
//
// Возвращаемое значение:
//  Булево - Истина, если подходящая НКД разрешает отправку подписанного
//           или НКД не найдена (дефолт манифеста).
//
Функция СценарийРазрешаетОтправкуПодписанного(ТипЛогистика, ДокументОснование = Неопределено) Экспорт
	
	Настройка = НайтиНастройкуКонвертацииДляТитула(ТипЛогистика, ДокументОснование);
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Настройка.Сценарий_ОтправлятьПодписанный;
	
КонецФункции

Функция НайтиНастройкуКонвертацииДляТитула(ТипЛогистика, ДокументОснование)
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Настройка = ПолучитьНастройкуКонвертации(ТипЛогистика, ДокументОснование);
		Если ЗначениеЗаполнено(Настройка) Тогда
			Возврат Настройка;
		КонецЕсли;
	КонецЕсли;
	
	НастройкаБезТипа1С = ПолучитьНастройкуКонвертацииПустойТипДокумента1С(ТипЛогистика);
	Если ЗначениеЗаполнено(НастройкаБезТипа1С) Тогда
		Возврат НастройкаБезТипа1С;
	КонецЕсли;
	
	Настройки = МассивНастроекКонвертацииПоТипуЛогистики(ТипЛогистика);
	Если Настройки.Количество() > 0 Тогда
		Возврат Настройки[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НастройкаРазрешаетОтправкуНеподписанного(Настройка)
	
	СценарийЧерновика = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного;
	СценарийЧерновикаПолный =
		Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного;
	
	Возврат Настройка.Сценарий_ОтправлятьНеподписанный
		Или Настройка.Сценарий = СценарийЧерновика
		Или Настройка.Сценарий = СценарийЧерновикаПолный;
	
КонецФункции

Функция СценарийНКДБезТипаДокумента1С(ТипЛогистика, СпецСценарий = Неопределено)
	
	КонтекстНКД = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		ТипЛогистика, "", СпецСценарий);
	
	Если КонтекстНКД.ЕстьНастройкаКонвертации
		И ЗначениеЗаполнено(КонтекстНКД.Сценарий) Тогда
		Возврат КонтекстНКД.Сценарий;
	КонецЕсли;
	
	Возврат Перечисления.КонтурЛогистика_Сценарии.Отправка;
	
КонецФункции

Функция МассивНастроекКонвертацииПоТипуЛогистики(ТипДокументаЛогистика, ВключатьВходящие = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	               |ГДЕ
	               |	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	               |	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
				   |	И (КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее)
				   |		ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее))";
	
	Если ВключатьВходящие Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее))",
			"КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее)
			| ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее))");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьТипыЗначенияДокумента1С(ТипДокументаЛогистика, СпецСценарий = Неопределено, ДляПостроенияСпискаЗадач = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипДокументаЛогистика);
	Запрос.УстановитьПараметр("СпецСценарий", СпецСценарий);
	Запрос.УстановитьПараметр("ОтборСпецСценарий", (СпецСценарий <> Неопределено));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиСвязейДокументов.НастройкиКонвертацииПодчиненного КАК НастройкиКонвертацииПодчиненного
	|ПОМЕСТИТЬ НастройкиСвязей
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиСвязейДокументов КАК КонтурЛогистика_НастройкиСвязейДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиСвязейДокументов.ПометкаУдаления
	|	И (КонтурЛогистика_НастройкиСвязейДокументов.ПоискПодчиненного
	|		ИЛИ КонтурЛогистика_НастройкиСвязейДокументов.ВводитьНаОсновании)
	|	И КонтурЛогистика_НастройкиСвязейДокументов.ТипДокументаПодчиненный = &ТипДокументаЛогистика
	|	И КонтурЛогистика_НастройкиСвязейДокументов.НастройкиКонвертацииПодчиненного <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С КАК ТипДокумента1С,
	|	МАКСИМУМ(КонтурЛогистика_НастройкиКонвертацииДокументов.ВыводитьЗадачи) КАК ВыводитьЗадачи
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И
	|		КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)
	|	И (НЕ &ОтборСпецСценарий
	|	ИЛИ &ОтборСпецСценарий
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = &СпецСценарий)
	|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка В
	|		(ВЫБРАТЬ
	|			НастройкиСвязей.НастройкиКонвертацииПодчиненного
	|		ИЗ
	|			НастройкиСвязей КАК НастройкиСвязей)
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипДокумента1С";
	
	ТЗ_ТипыДокументов1С = Запрос.Выполнить().Выгрузить();
	
	// Поддержка типов из коробки
	ТиповыеТипыДокументов1С = КонтурЛогистика_КонвертацияСерверПовтИсп.ПоддерживаемыеТипыДокументовКонфигурации1С(
		ТипДокументаЛогистика, СпецСценарий);
	
	Если ДляПостроенияСпискаЗадач Тогда 
		
		Для Каждого ТиповойТип Из ТиповыеТипыДокументов1С Цикл
			
			Если ТЗ_ТипыДокументов1С.НайтиСтроки(Новый Структура("ТипДокумента1С", ТиповойТип)).Количество() = 0 Тогда
				НоваяСтрока = ТЗ_ТипыДокументов1С.Добавить();
				НоваяСтрока.ТипДокумента1С = ТиповойТип;
				НоваяСтрока.ВыводитьЗадачи = Истина; 
			КонецЕсли;	  
			
		КонецЦикла;
		
		МассивСтрок = ТЗ_ТипыДокументов1С.НайтиСтроки(Новый Структура("ВыводитьЗадачи", Истина));
		ТипыДокументов1С = Новый Массив;
		Для Каждого СтрокаТипов Из МассивСтрок Цикл
			ТипыДокументов1С.Добавить(СтрокаТипов.ТипДокумента1С);
		КонецЦикла;	
		
	Иначе
		ТипыДокументов1С = ТЗ_ТипыДокументов1С.ВыгрузитьКолонку("ТипДокумента1С");	
		КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ДополнитьМассивЛок(ТипыДокументов1С, ТиповыеТипыДокументов1С, Истина);
	КонецЕсли;
	
	Возврат ТипыДокументов1С;
	
КонецФункции

// из тех что настроены в Этом справочнике (без дочерних)
Функция ПолучитьТипыЛогистикаПоДокументу1С(ДокументСсылка) Экспорт
	
	МассивТиповЛогистики = Новый Массив;
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоДокументПодсистемы(ДокументСсылка) Тогда
		
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументСсылка);
		МассивТиповЛогистики.Добавить(ТипЛогистика);
		
	Иначе
		
		ТипДокУчСистСтрокой = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(ДокументСсылка);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика КАК ТипДокументаЛогистика
		               |ИЗ
		               |	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
		               |ГДЕ
		               |	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С = &ТипДокумента1С
		               |	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)
		               |	И (КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее)
		               |			ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее))
		               |	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ТипДокумента1С", ТипДокУчСистСтрокой);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
		
			МассивТиповЛогистики.Добавить(Выборка.ТипДокументаЛогистика);
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивТиповЛогистики;	

КонецФункции

Функция ПолучитьВсеТипыНастроенныхУчетныхДокументовСтроками() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С КАК ТипДокумента1С
	               |ИЗ
	               |	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	               |ГДЕ
	               |	НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	               |	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)";
				   //|	И (КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.Исходящее)
				   //|		ИЛИ КонтурЛогистика_НастройкиКонвертацииДокументов.НаправлениеКонвертации = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее))";
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("ТипДокумента1С");	
	
КонецФункции

Функция ПолучитьВсеТипыНастроенныхУчетныхДокументовТипами() Экспорт
	
	МассивСтроками = ПолучитьВсеТипыНастроенныхУчетныхДокументовСтроками();
	МассивТипами = Новый Массив;
	
	Для Каждого ТипСтрока Из МассивСтроками Цикл
		
		Если ЗначениеЗаполнено(ТипСтрока) Тогда 
			МассивТипами.Добавить(Тип("ДокументСсылка." + ТипСтрока));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивТипами;
	
КонецФункции

Функция СформироватьТекстЗапросаСпискаЗадач(ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий = Неопределено,
	КонтекстНастройкиКонвертации = Неопределено, ИспользоватьМеханизмКастомизации = Истина, ИспользоватьДопКолонки = Истина) Экспорт
	
	Если КонтекстНастройкиКонвертации = Неопределено Тогда
		
		ПредставлениеДокументаСтрокой = КонтурЛогистика_ОбщегоНазначенияСервер.ПредставлениеУчетногоДокументаСтрокой(
			ТипДокументаКонфигурации);
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика, ПредставлениеДокументаСтрокой, СпецСценарий);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СпецСценарий) Тогда
		
		Если СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТрнТитул3ПослеТитула7();
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоТрнТитул3ПослеТитула7(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса);
			
		ИначеЕсли СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТрнТитул7ПослеТитула4();
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоТрнТитул7ПослеТитула4(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, КонтекстНастройкиКонвертации);
			
		ИначеЕсли СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату Тогда
			
			// Используем обычный запрос для Т4 - при сборке запроса будет учтен признак ЭтоПриемВозврата по Т3
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТитул2();
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий, КонтекстНастройкиКонвертации);
			
		ИначеЕсли СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул1СменыВодителей();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий, КонтекстНастройкиКонвертации);
			
		Иначе
			
			ВызватьИсключение "Не реализован запрос задач для сценария " + СпецСценарий;
			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика) Тогда
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул1();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
			
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул2ПоВодителям();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса,, КонтекстНастройкиКонвертации);
			
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул6ПоВодителям();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса,, КонтекстНастройкиКонвертации);
				
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул1_5_02();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
				
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул2ПоВодителям_5_02();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса,, КонтекстНастройкиКонвертации);
				
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛТитул5ПоВодителям_5_02();
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса,, КонтекстНастройкиКонвертации);
			
		Иначе
			
			Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипЛогистика) Тогда
				ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛПоПредыдущемуТитулу_5_02();	
			Иначе
				ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЛПоПредыдущемуТитулу();
			КонецЕсли;
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса,, КонтекстНастройкиКонвертации);
			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика) Тогда
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаЗЗТитул1();
			
			//Если КонтекстНастройкиКонвертации.ОбратныйМаппинг Тогда
			//	ДобавитьВЗапросВходящиеЗЗ(ИспользуемыйТекстЗапроса);
			//КонецЕсли;
			
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
			
		Иначе
			
			ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаЗЗПоПредыдущемуТитулу();
			РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
				ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, , КонтекстНастройкиКонвертации);
			
		КонецЕсли;
	
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипЛогистика) Тогда
		
		РезультатаФормированияЗапроса = СформироватьЗапросПЭ(ТипЛогистика, ТипДокументаКонфигурации, 
								КонтекстНастройкиКонвертации, СпецСценарий);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТитул1(ТипЛогистика);
		
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
			ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТитул2();
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
			ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, , КонтекстНастройкиКонвертации);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТитул1(ТипЛогистика);
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
			ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4 Тогда
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаТитул2();
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
			ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, , КонтекстНастройкиКонвертации);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаЭкспедиторскаяРасписка();
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
			ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаСкладскаяРасписка();
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(
			ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, СпецСценарий);
		
	Иначе
		
		ШаблонТекстаИсключения = "Не реализован запрос для документов с типом %1";
		ТекстИсключения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			ШаблонТекстаИсключения, ТипЛогистика);
		ВызватьИсключение ТекстИсключения;
		
	КонецЕсли;
	
	// Определяем дополнительные параметры запроса в зависимости от типа титула и специального сценария
	ПараметрыСписка = ПараметрыСпискаПоТипуЛогистики(ТипЛогистика, СпецСценарий, КонтекстНастройкиКонвертации,
		РезультатаФормированияЗапроса.ПолныйТекстЗапроса);
	Для Каждого ТекущийПараметр Из ПараметрыСписка Цикл
		РезультатаФормированияЗапроса.СтруктураПараметровЗапроса.Вставить(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
	КонецЦикла;
	
	// Механизм кастомизации списков
	Если ИспользоватьМеханизмКастомизации Тогда
		МеханизмКастомизацииСписков(ТипЛогистика, СпецСценарий, КонтекстНастройкиКонвертации,
			РезультатаФормированияЗапроса, ТипДокументаКонфигурации, ИспользоватьДопКолонки);
	КонецЕсли;
	
	Возврат РезультатаФормированияЗапроса;
	
КонецФункции

Функция СформироватьЗапросПЭ(ТипЛогистика, ТипДокументаКонфигурации, НастройкаКонвертации, СпецСценарий)
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
			
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЭТитул1();
		
	//	Если НастройкаКонвертации <> Неопределено И НастройкаКонвертации.ОбратныйМаппинг Тогда
	//		ДобавитьВЗапросВходящиеЗЗ(ИспользуемыйТекстЗапроса);		
	//	КонецЕсли;
		
		РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачТитул1(ТипЛогистика, ТипДокументаКонфигурации, 
											ИспользуемыйТекстЗапроса, СпецСценарий);
		
	Иначе
		
		ИспользуемыйТекстЗапроса = БазовыйТекстЗапросаПЭТитул2ПоТитулу1();
		
	    РезультатаФормированияЗапроса = СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(
		 	ТипЛогистика, ТипДокументаКонфигурации, ИспользуемыйТекстЗапроса, , НастройкаКонвертации);
		
	КонецЕсли;
	
	Возврат РезультатаФормированияЗапроса;
	
КонецФункции	

// Базовые тексты запросов

// ТРН

Функция БазовыйТекстЗапросаТитул1(ТипЛогистика)
	
	// новый вариант запроса, учитывающий таблицу докумнетов оснований ТрН Т1
	Возврат БазовыйТекстЗапросаТитул1_НесколькоОснований(ТипЛогистика);
	
КонецФункции

Функция БазовыйТекстЗапросаТитул1_НесколькоОснований(ТипЛогистика)
	
	БазовыйТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_ТрН_Титул1.Ссылка ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.Оформить)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.Обработать)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОбработанСПредупреждением)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
	|			ТОГДА ВЫБОР
	|				КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.СтатусПодписи = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыПодписи.SenderSignatureCheckedAndValid)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника)
	|				КОГДА (&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного)
	|					ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного)
	|					ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного)
	|					ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного)
	|					ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного)
	|					ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного))
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный)
	|				КОГДА &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик)
	|				ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1
	|			КОНЕЦ 
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Подписан)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
	|			И (&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного)
	|				ИЛИ (&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного)
	|					И НЕ &ОбязательноБезЗамечаний))
	|			И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.Код = ""r-wait-storekeeper""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
	|			И (&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного)
	|				ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного))
	|			И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.Код = ""r-wait-storekeeper""
	|			И &ОбязательноБезЗамечаний ТОГДА
	|			ВЫБОР
	|				КОГДА КонтурЛогистика_ТрН_Титул1.ДокументЭТРН.КомментарииВодителяПриПогрузке = """"
	|					ТОГДА ВЫБОР
	|						КОГДА &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного)
	|							ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный)
	|						ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание)
	|					КОНЕЦ
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю)
	|			КОНЕЦ
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
	|			И (&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного)
	|				ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного))
	|			И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.Код = ""r-wait-storekeeper""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
	|			ТОГДА ВЫБОР
	|					КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &Т1НастройкаСостояниеРаспечатать
	|							И &ВыводитьЗадачуРаспечатать
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.Распечатать)
	|					ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1
	|				КОНЕЦ
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
	|			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки)
	|		КОГДА КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Пропущен)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление)
	|	КОНЕЦ КАК ТребуемоеДействие,
	|	ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТипыОсобенностейДокументооборота.ПустаяСсылка) КАК ОсобенностиДокументооборота,
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус КАК Статус,
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.СтатусПодписи КАК СтатусПодписи,
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.ТипОшибки КАК ТипОшибки,
	|	КонтурЛогистика_СтатусыТитуловСрезПоследних.КодОшибки КАК КодОшибки,
	|	втДокументы.Ссылка КАК Документ1С,
	|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК ДокументЛогистика,
	|	втДокументы.Номер КАК Номер,
	|	НАЧАЛОПЕРИОДА(втДокументы.Дата, ДЕНЬ) КАК Дата,
