			БазовыйТекстЗапроса, КонтекстНастройкиКонвертации.НастройкаКонвертации, СтруктураПараметровЗапроса);
	КонецЕсли;
		
	Возврат Новый Структура("ПолныйТекстЗапроса, СтруктураПараметровЗапроса", БазовыйТекстЗапроса, СтруктураПараметровЗапроса);

КонецФункции

Процедура ДобавитьДопУсловиеГДЕЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертации, СтруктураПараметровЗапроса)
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаКонвертации.УсловиеЗапроса)Тогда
		
		ИтоговыйТекстЗапроса1Документа = Стрзаменить(ИтоговыйТекстЗапроса1Документа, "//ДопУсловиеГДЕ",
			" И " + НастройкаКонвертации.УсловиеЗапроса + "//ДопУсловиеГДЕ");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаКонвертации.ВычислениеПараметраУсловияЗапроса) Тогда
		
		ВыражениеВычисления = НастройкаКонвертации.ВычислениеПараметраУсловияЗапроса;
		ВычисленноеЗначение = Неопределено;
		РезультатВычисления = Неопределено;

		Параметры = Новый Структура;
		Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
		Параметры.Вставить("СтруктураПараметровЗапроса", СтруктураПараметровЗапроса);
		
		ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			ВыражениеВычисления, Параметры);
		
		СтруктураПараметровЗапроса.Вставить("Параметр", ВычисленноеЗначение);
		
	КонецЕсли;
		

КонецПроцедуры

