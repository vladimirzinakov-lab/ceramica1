	|		И НЕ КонтурЛогистика_ПредыдущийТитул.ПометкаУдаления
	|		И КонтурЛогистика_ПредыдущийТитул.ДокументОснование = Неопределено) КАК ПодзапросПредыдущийТитул
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыПредыдущихТитулов
	|		ПО ПодзапросПредыдущийТитул.Ссылка = КонтурЛогистика_СтатусыПредыдущихТитулов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
	|		ПО ПодзапросПредыдущийТитул.ДокументЭТРН = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
	|ГДЕ
	|	(КонтурЛогистика_СтатусыПредыдущихТитулов.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
	|			ИЛИ КонтурЛогистика_СтатусыПредыдущихТитулов.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
	|			ИЛИ КонтурЛогистика_СтатусыПредыдущихТитулов.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка)
	|			ИЛИ КонтурЛогистика_СтатусыПредыдущихТитулов.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик))
	|	//ДопУсловиеГДЕ";
	
КонецФункции


Функция СформироватьТекстЗапросаСпискаЗадачТитул1(ТипЛогистика, ТипДокументаКонфигурации1С, Знач БазовыйТекстЗапроса, Знач СпецСценарий) Экспорт
	
	ПолныйТекстЗапроса = "";
	МассивТипов1С = Новый Массив;  // какие типы документа основной конфигурации обрабатываем
	МассивЗапросов = Новый Массив; // итоговые тексты по каждому типу 1С
	СтруктураПараметровЗапроса = Новый Структура; // сюда сложим параметры, потребовавшиеся при кастомизации
	
	НастроенныеТипыДокументов1СМассив = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(
		ТипЛогистика, Неопределено, Истина);
	
	Если ТипДокументаКонфигурации1С = "Все типы"
		Или ТипДокументаКонфигурации1С = Неопределено Тогда
		
		Для Каждого ТипДокумента Из НастроенныеТипыДокументов1СМассив Цикл
			
			Если Не ЗначениеЗаполнено(ТипДокумента) Тогда 
				Продолжить;
			КонецЕсли;
			
			ТипДокументаКонфигурацииОб = Метаданные.Документы.Найти(ТипДокумента);
			
			Если ТипДокументаКонфигурацииОб <> Неопределено Тогда 
				Если Не ПравоДоступа("Чтение", ТипДокументаКонфигурацииОб) Или Не ПравоДоступа("Просмотр", ТипДокументаКонфигурацииОб) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			МассивТипов1С.Добавить(ТипДокумента);
			
		КонецЦикла;
		
	ИначеЕсли ТипДокументаКонфигурации1С = "Другие" Тогда
		
		// будут добавлены ниже
	Иначе
		
		МассивТипов1С.Добавить(ТипДокументаКонфигурации1С);
		
	КонецЕсли;
	
	// таблица документа логистики
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипЛогистика) Тогда
		БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса, "КонтурЛогистика_ТрН_Титул1", 	"КонтурЛогистика_ЗН_Титул1");
		БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса, "ДокументЭТРН", 					"ДокументЗН");
		БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса, ".НомерТрН", 					".НомерЗН");
		БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса, ".ДатаТрН", 						".ДатаЗН");
		БазовыйТекстЗапроса = СтрЗаменить(
			БазовыйТекстЗапроса, "КонтурЛогистика_ЗН_Титул1.ОтправительШаблона КАК ОтправительШаблона,", "");
		БазовыйТекстЗапроса = СтрЗаменить(
			БазовыйТекстЗапроса, "КонтурЛогистика_ЗН_Титул1ДокументыОснования.Ссылка.ОтправительШаблона КАК ОтправительШаблона,", "");
		БазовыйТекстЗапроса = СтрЗаменить(
			БазовыйТекстЗапроса, "КонтурЛогистика_ЗН_Титул1.ДокументЗН.ТестовыйДокумент КАК ТестовыйДокумент,", "");		
	КонецЕсли;
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
		БазовыйТекстЗапроса = СтрЗаменить(БазовыйТекстЗапроса, "КонтурЛогистика_ТрН_Титул1", 	"КонтурЛогистика_ТрН_Титул8");
	КонецЕсли;
	
	ЕстьНесколькоТипов1С = (МассивТипов1С.Количество() > 1);
	
	Для Каждого ТипДокументаКонфигурации Из МассивТипов1С Цикл
		
		Если ТипДокументаКонфигурации1С = "Другие" Тогда
			Продолжить;
		КонецЕсли;
		
		ИтоговыйТекстЗапроса1Документа = БазовыйТекстЗапроса;
		
		КонтекстНКД = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика, ТипДокументаКонфигурации, СпецСценарий);
		
		Если Не КонтекстНКД.ЕстьНастройкаКонвертации
			И Не КонтекстНКД.ЕстьТиповаяКонвертация Тогда
			
			Продолжить;
		КонецЕсли;
		
		ИмяОсновнойТаблици = КонтекстНКД.ТипДокумента1С;
		
		// Замены:
		
		// реквизитов >> колонок списка задач
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "Организация");
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "Контрагент");
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "Перевозчик");
		
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "Грузоотправитель");
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "Грузополучатель");
		
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "МестоПогрузки");
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "МестоДоставки");
		
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "НомерТРН");
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "ДатаТРН");
		
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "Водитель");
		ВыполнитьЗаменуПутейКолонокЗапросаТ1(ИтоговыйТекстЗапроса1Документа, КонтекстНКД, ИмяОсновнойТаблици, "ТранспортноеСредство");
		
		// самого документа учетной системы
		Если ЗначениеЗаполнено(ИмяОсновнойТаблици)
			И ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
			
			ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
				"КонтурЛогистика_Вспомогательный", ИмяОсновнойТаблици);
				
			ЗаменяемаяТаблицаДляНеТолькоПроведенных = ИмяОсновнойТаблици;
			
		Иначе
			
			ЗаменяемаяТаблицаДляНеТолькоПроведенных = "КонтурЛогистика_Вспомогательный";		
				
		КонецЕсли;
		
		// Кастомные условия
		Если КонтекстНКД.ЕстьНастройкаКонвертации Тогда
			ДобавитьДопУсловиеГДЕЗапроса(ИтоговыйТекстЗапроса1Документа, КонтекстНКД.НастройкаКонвертации, СтруктураПараметровЗапроса);
		КонецЕсли;
		
		// Меняем кастомные поля:
		// TODO сделать кастомизацию////////////////////////////////////////////
		КастомизированныйТекстЗапроса = ИтоговыйТекстЗапроса1Документа;
		////////////////////////////////////////////////////////////////////////
		
		Постфикс = ТипДокументаКонфигурации;
		
		// Заменим все параметры в запросе на уникальные
		ПараметрыЗамены = Новый Массив;
		ПараметрыЗамены.Добавить("&БезФильтраОрганизация");
		ПараметрыЗамены.Добавить("&БезФильтраПеревозчик");
		ПараметрыЗамены.Добавить("&БезФильтраКонтрагент");
		ПараметрыЗамены.Добавить("&НашиОрганизацииУчСист");
		ПараметрыЗамены.Добавить("&НастроенныеПеревозчикиУчСист");
		ПараметрыЗамены.Добавить("&НастроенныеГрузополучателиУчСист");
		ПараметрыЗамены.Добавить("&Сценарий");
		ПараметрыЗамены.Добавить("&ВыводитьЗадачи");
		ПараметрыЗамены.Добавить("&ТолькоПроведенные");
		
		Для Каждого ТекущийПараметрЗамены Из ПараметрыЗамены Цикл
			КастомизированныйТекстЗапроса = СтрЗаменить(КастомизированныйТекстЗапроса, ТекущийПараметрЗамены, ТекущийПараметрЗамены + Постфикс);
		КонецЦикла;
		
		ПутьОрганизация = КонтекстНКД.ПутиРеквизитовУчетногоДокумента["ПутьОрганизация"];
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика) Тогда
			
			СтруктураПараметровЗапроса.Вставить("БезФильтраОрганизация" + Постфикс, СокрЛП(ПутьОрганизация) = "");
			СтруктураПараметровЗапроса.Вставить("БезФильтраПеревозчик" + Постфикс, Истина);
			СтруктураПараметровЗапроса.Вставить("НашиОрганизацииУчСист" + Постфикс, Справочники.КонтурЛогистика_ОрганизацииДиадок.НашиОформителиПЛУчСист());
			СтруктураПараметровЗапроса.Вставить("НастроенныеПеревозчикиУчСист" + Постфикс, Новый Массив);
			СтруктураПараметровЗапроса.Вставить("Сценарий" + Постфикс, КонтекстНКД.Сценарий);
			СтруктураПараметровЗапроса.Вставить("ВыводитьЗадачи" + Постфикс, КонтекстНКД.ВыводитьЗадачи);
			
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика) Тогда
			
			СтруктураПараметровЗапроса.Вставить("БезФильтраОрганизация" + Постфикс, СокрЛП(ПутьОрганизация) = "");
			СтруктураПараметровЗапроса.Вставить("БезФильтраПеревозчик" + Постфикс, Истина);
			СтруктураПараметровЗапроса.Вставить("НашиОрганизацииУчСист" + Постфикс, Справочники.КонтурЛогистика_ОрганизацииДиадок.НашиГрузоотправителиУчСист());
			СтруктураПараметровЗапроса.Вставить("НастроенныеПеревозчикиУчСист" + Постфикс, Новый Массив);
			СтруктураПараметровЗапроса.Вставить("Сценарий" + Постфикс, КонтекстНКД.Сценарий);
			СтруктураПараметровЗапроса.Вставить("ВыводитьЗадачи" + Постфикс, КонтекстНКД.ВыводитьЗадачи);
			
		ИначеЕсли (Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипЛогистика)
				Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипЛогистика))
			И Не ЗначениеЗаполнено(КонтекстНКД.ТипДокумента1С) Тогда
			
			// Нет доп отборов
			
		Иначе
			
			ПутьПеревозчик = КонтекстНКД.ПутиРеквизитовУчетногоДокумента["ПутьПеревозчик"];
			ПутьКонтрагент = КонтекстНКД.ПутиРеквизитовУчетногоДокумента["ПутьКонтрагент"];
			
			Если КонтекстНКД.ЕстьНастройкаКонвертации Тогда
				БезФильтраОрганизация = (СокрЛП(ПутьОрганизация) = "");
				БезФильтраПеревозчик = (Не КонтекстНКД.НастройкаКонвертации.ПутьПеревозчикФильтроватьПоУстановленнымСоответствиям
					Или СокрЛП(ПутьПеревозчик) = "");
				БезФильтраКонтрагент = (Не КонтекстНКД.НастройкаКонвертации.ПутьКонтрагентФильтроватьПоУстановленнымСоответствиям
					Или СокрЛП(ПутьКонтрагент) = "");
			Иначе
				БезФильтраОрганизация = (СокрЛП(ПутьОрганизация) = "");
				БезФильтраПеревозчик = Истина;
				БезФильтраКонтрагент = Истина;
			КонецЕсли;
			
			СтруктураПараметровЗапроса.Вставить("БезФильтраОрганизация" + Постфикс, БезФильтраОрганизация);
			СтруктураПараметровЗапроса.Вставить("БезФильтраПеревозчик" + Постфикс, БезФильтраПеревозчик);
			СтруктураПараметровЗапроса.Вставить("БезФильтраКонтрагент" + Постфикс, БезФильтраКонтрагент);
			СтруктураПараметровЗапроса.Вставить("НашиОрганизацииУчСист" + Постфикс, Справочники.КонтурЛогистика_ОрганизацииДиадок.НашиГрузоотправителиУчСист());
			СтруктураПараметровЗапроса.Вставить("НастроенныеПеревозчикиУчСист" + Постфикс, Справочники.КонтурЛогистика_ОрганизацииДиадок.НастроенныеОрганизацииУчСистПоРоли("Перевозчик"));
			СтруктураПараметровЗапроса.Вставить("НастроенныеГрузополучателиУчСист" + Постфикс, Справочники.КонтурЛогистика_ОрганизацииДиадок.НастроенныеОрганизацииУчСистПоРоли("Грузополучатель"));
			СтруктураПараметровЗапроса.Вставить("Сценарий" + Постфикс, КонтекстНКД.Сценарий);
			СтруктураПараметровЗапроса.Вставить("ВыводитьЗадачи" + Постфикс, КонтекстНКД.ВыводитьЗадачи);
			
		КонецЕсли;
		
		Если КонтекстНКД.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаШаблона Тогда
			УчестьОсобенностиПараметрыЗапросовДляОтправкиШаблонов(СтруктураПараметровЗапроса, Постфикс, ТипЛогистика);
		КонецЕсли;	
		
		Если КонтекстНКД.ТолькоПроведенные Тогда
			СтруктураПараметровЗапроса.Вставить("ТолькоПроведенные" + Постфикс, Истина);
		Иначе
			КастомизированныйТекстЗапроса = СтрЗаменить(КастомизированныйТекстЗапроса,
				ЗаменяемаяТаблицаДляНеТолькоПроведенных + ".Проведен = &ТолькоПроведенные" + Постфикс, "ИСТИНА");
		КонецЕсли;
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			
			КастомизированныйТекстЗапроса = СтрЗаменить(КастомизированныйТекстЗапроса,
						"ИЛИ &Сценарий" + Постфикс + " = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного))",
						"ИЛИ &Сценарий" + Постфикс + " = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного))
						| И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&СостоянияДляОтправкиПослеОбработки)");
		
			КастомизированныйТекстЗапроса = СтрЗаменить(КастомизированныйТекстЗапроса,
						"&Сценарий" + Постфикс + " = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)",
						"&Сценарий" + Постфикс + " = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)
						| И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&СостоянияДляОтправкиПослеОбработки)");
			
		КонецЕсли;
		
		МассивЗапросов.Добавить(КастомизированныйТекстЗапроса);
		
	КонецЦикла;
	
		// Добавим введенные вручную
	Если ТипДокументаКонфигурации1С = "Все типы" 
		Или ТипДокументаКонфигурации1С = Неопределено
		Или ТипДокументаКонфигурации1С = "Другие"
	  	Или МассивЗапросов.Количество() = 0 Тогда
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюТрнТ1();
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда				  
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюПЛТ1();
			СтруктураПараметровЗапроса.Вставить("БезФильтраПеревозчик", Истина);
			СтруктураПараметровЗапроса.Вставить("НастроенныеПеревозчикиУчСист", Новый Массив);
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда				  
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюПЛТ1_5_02();
			СтруктураПараметровЗапроса.Вставить("БезФильтраПеревозчик", Истина);
			СтруктураПараметровЗапроса.Вставить("НастроенныеПеревозчикиУчСист", Новый Массив);
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюЗЗТ1();
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюПЭТ1();
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюЭР();
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
			ТекстЗапроса1Документа = ТекстЗапросаВведенныеВручнуюСР();
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстЗапроса1Документа) Тогда 
			МассивЗапросов.Добавить(ТекстЗапроса1Документа);
		КонецЕсли;	
	КонецЕсли;
	
	Для Каждого ТекстЗапроса Из МассивЗапросов Цикл
		
		Если ПолныйТекстЗапроса = "" Тогда 
			
			ПолныйТекстЗапроса = ТекстЗапроса;
			
		Иначе
			
			ПолныйТекстЗапроса = ПолныйТекстЗапроса + "
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|" +
			СтрЗаменить(ТекстЗапроса, " РАЗРЕШЕННЫЕ", "");
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Заполним параметр - НастроенныеТипы1С
	Если Найти(ПолныйТекстЗапроса, "НастроенныеТипы1С") > 0 Тогда
		НастроенныеТипы1С = Новый Массив;
		Для Каждого Элемент Из НастроенныеТипыДокументов1СМассив Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				НастроенныеТипы1С.Добавить(Тип("ДокументСсылка." + Элемент));
			КонецЕсли;
		КонецЦикла;
		
		СтруктураПараметровЗапроса.Вставить("НастроенныеТипы1С", НастроенныеТипы1С);
	КонецЕсли;
	
	Если МассивЗапросов.Количество() > 1 Тогда // 8.2 не работает с объединенным запросом в ДС, нужно обернуть
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
		ПолныйТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ (
		|" + ПолныйТекстЗапроса + "
		|) КАК ОбъединеннаяТаблица";
	КонецЕсли;
	
	Возврат Новый Структура("ПолныйТекстЗапроса, СтруктураПараметровЗапроса", ПолныйТекстЗапроса, СтруктураПараметровЗапроса);

КонецФункции

Процедура УчестьОсобенностиПараметрыЗапросовДляОтправкиШаблонов(СтруктураПараметровЗапроса, Постфикс, ТипЛогистика)
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика) 
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипЛогистика) Тогда

			ДоступныеОрганизацииДиадока = Справочники.КонтурЛогистика_ОрганизацииДиадок.НашиГрузоотправителиИЭкспедиторы();
			СтруктураПараметровЗапроса.Вставить("НашиОрганизацииУчСист" + Постфикс, ДоступныеОрганизацииДиадока);
			
	КонецЕсли;		
	 
КонецПроцедуры 	 

Функция ПараметрыСпискаПоТипуЛогистики(ТипЛогистика, СпецСценарий, КонтекстНастройкиКонвертации = Неопределено, ТекстЗапроса = Неопределено) Экспорт
	
	ПараметрыСписка = Новый Структура;
	
	Если ЗначениеЗаполнено(ТекстЗапроса) И Найти(ТекстЗапроса, "&НаправлениеКонвертации") > 0
		И ЗначениеЗаполнено(КонтекстНастройкиКонвертации) Тогда
		ПараметрыСписка.Вставить("НаправлениеКонвертации", КонтекстНастройкиКонвертации.НаправлениеКонвертации);
	КонецЕсли;
	
	// (документы без основания)
	Если ЗначениеЗаполнено(ТекстЗапроса) И Найти(ТекстЗапроса, "&РучнойВводСценарий") > 0 Тогда
		ПараметрыСписка.Вставить("РучнойВводСценарий",
			СценарийНКДБезТипаДокумента1С(ТипЛогистика, СпецСценарий));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстЗапроса) И Найти(ТекстЗапроса, "&Сценарий") > 0 Тогда
		Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации) Тогда
			ПараметрыСписка.Вставить("Сценарий", КонтекстНастройкиКонвертации.Сценарий);
		Иначе
			ПараметрыСписка.Вставить("Сценарий", Перечисления.КонтурЛогистика_Сценарии.Отправка);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПараметрыСписка.Сценарий) Тогда
			ПараметрыСписка.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		ПараметрыСписка.Вставить("Т1НастройкаСостояниеРаспечатать", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1НастройкаСостояниеРаспечатать"));
		ПараметрыСписка.Вставить("ВыводитьЗадачуРаспечатать", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВыводитьЗадачуРаспечатать"));
		
		СостоянияДляОтправкиПослеОбработки = Новый Массив;
		СостоянияДляОтправкиПослеОбработки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-storekeeper"));
		СостоянияДляОтправкиПослеОбработки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-consignor-sign"));
		ПараметрыСписка.Вставить("СостоянияДляОтправкиПослеОбработки", СостоянияДляОтправкиПослеОбработки);
				
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8 Тогда
		
		ПараметрыСписка.Вставить("Т1НастройкаСостояниеРаспечатать", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1НастройкаСостояниеРаспечатать"));
		ПараметрыСписка.Вставить("ВыводитьЗадачуРаспечатать", Ложь);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда
		
		ПараметрыСписка.Вставить("Т1НастройкаСостояниеРаспечатать", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1НастройкаСостояниеРаспечатать"));
		ПараметрыСписка.Вставить("ВыводитьЗадачуРаспечатать", Ложь);
				
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда 
		
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", НЕ КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьОтправлятьТ2ДоВодителя"));
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-carrier-sign"));
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-driver-approve"));
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		Если СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7 Тогда
			ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
			
			ТребуемоеСостояниеЭТРНДляОтправки = Новый Массив;
			ТребуемоеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pd-on-the-way"));
			ТребуемоеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("on-the-way"));
			ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", ТребуемоеСостояниеЭТРНДляОтправки);
			
			ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
		Иначе
			ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
			ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка()); // все равно не попадем в кейс
			ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
		КонецЕсли;
		
		СостоянияДляОтправкиПослеОбработки = Новый Массив;
		СостоянияДляОтправкиПослеОбработки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("on-the-way"));
		СостоянияДляОтправкиПослеОбработки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-storekeeper"));
		СостоянияДляОтправкиПослеОбработки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-consignee-sign"));
		ПараметрыСписка.Вставить("СостоянияДляОтправкиПослеОбработки", СостоянияДляОтправкиПослеОбработки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда 
		
		ТребуемоеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемоеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-carrier-sign"));
		ТребуемоеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pd-wait-carrier-sign"));
		
		ТребуемоеСостояниеЭТРНОжидания = Новый Массив;
		ТребуемоеСостояниеЭТРНОжидания.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-driver-approve"));
		ТребуемоеСостояниеЭТРНОжидания.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pd-wait-driver-approve"));
		
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", НЕ КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьОтправлятьТ4ДоВодителя"));
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", ТребуемоеСостояниеЭТРНДляОтправки);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", ТребуемоеСостояниеЭТРНОжидания);
		
	ИначеЕсли СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7 Тогда
		
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pd-on-the-way"));
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
				
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 
		И СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4  Тогда
		
		ТребуемоеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемоеСостояниеЭТРНДляОтправки.Добавить(
			Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("completed"));
		ТребуемоеСостояниеЭТРНДляОтправки.Добавить(
			Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pd-wait-carrier-readdress-sign"));
		
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", ТребуемоеСостояниеЭТРНДляОтправки);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("completed")); //TODO изменить на "c-carrier-signed", когда вэб добавит статусы
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("c-wait-consignor-sign"));
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
		
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("c-wait-consignor-sign"));
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика) Тогда
		
		Если (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02)
			И Не СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя Тогда	
			
			ПараметрыСписка.Вставить("Т1НастройкаСостояниеРаспечатать", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1НастройкаСостояниеРаспечатать"));
			ПараметрыСписка.Вставить("ВыводитьЗадачуРаспечатать", Ложь);
			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика) Тогда
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			
			//ПараметрыСписка.Вставить("Т1ТребуемоеСостояниеОформитьЭТрН", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("zz-completed"));
			//ПараметрыСписка.Вставить("ВыводитьЗадачуОформитьЭТрН", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОформитьЭТрНПослеЗЗ"));
						
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипЛогистика) Тогда
		
		// Ничего не требуется
		
	ИначеЕсли ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		// В Т1 запрос без этого параметра, а перед отправкой Т3 нет водителя
		ПараметрыСписка.Вставить("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка()); // все равно не попадем в кейс
		ПараметрыСписка.Вставить("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
	
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипЛогистика) Тогда
		
		Если КонтекстНастройкиКонвертации <> Неопределено И КонтекстНастройкиКонвертации.ЕстьНастройкаКонвертации Тогда
			ОбязательноБезЗамечаний = КонтекстНастройкиКонвертации.НастройкаКонвертации.ОбязательноБезЗамечаний;
		Иначе
			ОбязательноБезЗамечаний = Ложь;
		КонецЕсли;
		
		ПараметрыСписка.Вставить("ОбязательноБезЗамечаний", ОбязательноБезЗамечаний);
		
	КонецЕсли;
	
	Возврат ПараметрыСписка;
	
КонецФункции

Функция СформироватьТекстЗапросаСпискаЗадачТитул3(ТипЛогистика, ТипДокументаКонфигурации1С, Знач БазовыйТекстЗапроса) Экспорт
	
	ПолныйТекстЗапроса = "";
	МассивТипов1С = Новый Массив;  // какие типы документа основной конфигурации обрабатываем
	МассивЗапросов = Новый Массив; // итоговые тексты по каждому типу 1С
	СтруктураПараметровЗапроса = Новый Структура; // сюда сложим параметры, потребовавшиеся при кастомизации
	
	// пока что не поддерживаем N типов в Т3
	//Если ТипДокументаКонфигурации1С = "Все типы" Тогда 
	//	
	//	НастроенныеТипыДокументов1СМассив = Справочники.КонтурЛогистика_НастройкиКонвертации.ПолучитьТипыЗначенияДокумента1С(ТипЛогистика);
	//	Для Каждого ТипДокумента Из НастроенныеТипыДокументов1СМассив Цикл 
	//		МассивТипов1С.Добавить(ТипДокумента);
	//	КонецЦикла;
	//	
	//Иначе
		
		МассивТипов1С.Добавить(ТипДокументаКонфигурации1С);
		
	//КонецЕсли;
	
	Для Каждого ТипДокументаКонфигурации Из МассивТипов1С Цикл
		
		// сформируем заново
		ИтоговыйТекстЗапроса1Документа = БазовыйТекстЗапроса;
		
		// спросить настройки конвертации документа 1с по типу док мерк
		НастройкаКонвертацииСсылка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика, ТипДокументаКонфигурации);
		
		Если НастройкаКонвертацииСсылка = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		// TODO для запроса с отправкой титула на основании другого титула - сделать свои обработчики кастомизации
		//// Замены:
		//
		//// реквизитов >> колонок списка задач
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Организация");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Контрагент");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Перевозчик");
		//
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Грузоотправитель");
		//ВыполнитьЗаменуПутейКолонокЗапроса(ИтоговыйТекстЗапроса1Документа, НастройкаКонвертацииСсылка, "Грузополучатель");
		
		// самого документа учетной системы
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, "КонтурЛогистика_Вспомогательный", НастройкаКонвертацииСсылка.ТипДокумента1С);
		
		// Меняем кастомные поля:
		// TODO сделать кастомизацию////////////////////////////////////////////
		КастомизированныйТекстЗапроса = ИтоговыйТекстЗапроса1Документа;
		////////////////////////////////////////////////////////////////////////
		
		
		МассивЗапросов.Добавить(КастомизированныйТекстЗапроса);
		
	КонецЦикла;	
		
	Для Каждого ТекстЗапроса Из МассивЗапросов Цикл
		
		Если ПолныйТекстЗапроса = "" Тогда 
			
			ПолныйТекстЗапроса = ТекстЗапроса;
			
		Иначе
			
			ПолныйТекстЗапроса = ПолныйТекстЗапроса + "
				|ОБЪЕДИНИТЬ ВСЕ
				|" +
			СтрЗаменить(ТекстЗапроса, " РАЗРЕШЕННЫЕ", "");	
		
		КонецЕсли;
		
	КонецЦикла;
	
	// подменяем источник требуемого действия для состояния документооборотв
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда 
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "Состояние.ТребуемоеДействиеТ1", "Состояние.ТребуемоеДействиеТ3"); 
	КонецЕсли;
	
	Если МассивЗапросов.Количество() > 1 Тогда // 8.2 не работает с объединенным запросом в ДС, нужно обернуть
		ПолныйТекстЗапроса = СтрЗаменить(ПолныйТекстЗапроса, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
		ПолныйТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ (
		|" + ПолныйТекстЗапроса + "
		|) КАК ОбъединеннаяТаблица";
	КонецЕсли;
	
	Возврат Новый Структура("ПолныйТекстЗапроса, СтруктураПараметровЗапроса", ПолныйТекстЗапроса, СтруктураПараметровЗапроса);

КонецФункции

Функция СформироватьТекстЗапросаСпискаЗадачПоПредыдущемуТитулу(ТипЛогистика, ТипДокументаКонфигурации1С, Знач БазовыйТекстЗапроса,
	СпецСценарий = Неопределено, КонтекстНастройкиКонвертации = Неопределено) Экспорт
	
	СпозиционироватьТекстЗапросаНаУказанныйТитул(ТипЛогистика, БазовыйТекстЗапроса);
	
	СтруктураПараметровЗапроса = Новый Структура; // сюда сложим параметры, потребовавшиеся при кастомизации
	
	ИтоговыйТекстЗапроса1Документа = БазовыйТекстЗапроса;
	
	// УсловиеНАШ - на сторону ПВ или ГП
	Если КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее
		Или КонтекстНастройкиКонвертации.НаправлениеКонвертации = Неопределено Тогда
		СформироватьОтборНаш(ИтоговыйТекстЗапроса1Документа, ТипЛогистика);
	КонецЕсли;
	
	ВыполнитьЗаменуВТекстеЗапросаПоДатеПредыдущего(ИтоговыйТекстЗапроса1Документа, ТипЛогистика);
	
	Если СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату 
		И ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		
		// требуется уточнить что в Т3 был прием возврата
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления",
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления 
		|И КонтурЛогистика_ПредыдущийТитул.ЭтоПриемВозврата");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления 
		|И КонтурЛогистика_ТекущийТитул.ЭтоПриемВозврата");
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		
		// требуется уточнить что в Т3 был НЕ прием возврата
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления",
		"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ПредыдущийТитул.ЭтоПриемВозврата");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ТекущийТитул.ЭтоПриемВозврата");
		
		// Чтобы не отображались в списке если был возврат, а отображались в возвратной цепочке
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1",
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА 
		|				ВЫБОР 
		|					КОГДА ПодзапросТекущийТитул.Ссылка.ПринятьЧастично Или ПодзапросТекущийТитул.Ссылка.ОтказВПриемке
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника)
		|					ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ4
		|				КОНЕЦ");
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		// требуется уточнить что в Т3 был НЕ прием возврата
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления",
		"НЕ КонтурЛогистика_ТекущийТитул.ПометкаУдаления 
		|И НЕ КонтурЛогистика_ТекущийТитул.ЭтоПриемВозврата");
		
		// грузополучатель должен быть наш (новый грузополучатель если была переадресовка с 0.11.0 размещается в ДокументЭТРН.Грузополучатель)
		// также у него должен быть флажок роли Грузополучатель
		Если КонтекстНастройкиКонвертации.НаправлениеКонвертации <> Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
			
			ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа, 
			"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления",
			"НЕ КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.ПометкаУдаления 
			|И КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.Грузополучатель.Наш
			|И КонтурЛогистика_ПредыдущийТитул.ДокументЭТРН.Грузополучатель.Грузополучатель");
			
		КонецЕсли;
				
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного))",
		"ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного))
		|И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&СостоянияДляОтправкиПослеОбработки)");
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)",
		"&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика)
		|И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В (&СостоянияДляОтправкиПослеОбработки)");
		
		// Чтобы не отображались в списке если был возврат, а отображались в возвратной цепочке
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ1",
		"КОГДА КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
		|			ТОГДА 
		|				ВЫБОР 
		|					КОГДА ЕСТЬNULL(ПодзапросПредыдущийТитул.ДокументЭТРН.КоличествоПереадресовок, 0) = 1
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника)
		|					ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние.ТребуемоеДействиеТ3
		|				КОНЕЦ");
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		
		ИтоговыйТекстЗапроса1Документа = СтрЗаменить(ИтоговыйТекстЗапроса1Документа,
		"ПодзапросПредыдущийТитул.ДокументЭТРН.ТранспортноеСредство КАК ТранспортноеСредство,",
		"ПодзапросПредыдущийТитул.ДокументЭТРН.ТранспортноеСредство КАК ТранспортноеСредство,
		|ПодзапросТекущийТитул.Ссылка.СтоимостьБезНДС КАК СтоимостьБезНДС,");
		
