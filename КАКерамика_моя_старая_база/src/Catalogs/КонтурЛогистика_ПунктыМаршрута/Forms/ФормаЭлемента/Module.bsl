Процедура СоздатьНастройкуКонвертации(Элемент) Экспорт
	
	КонтурЛогистика_КонвертацияКлиент.СоздатьНастройкуКонвертации(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНастройкеКонвертацииСправочника(Элемент) Экспорт 
	
	КонтурЛогистика_КонвертацияКлиент.ПерейтиКНастройкеКонвертацииСправочника(ЭтаФорма);	
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
  КонтурЛогистика_КонвертацияКлиент.ОбработкаОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

// --- КонтурЛогистика_НастройкиКонвертацииСправочников

&НаКлиенте
Процедура СвязанныеОбъектыПослеУдаления(Элемент)
	Элементы.СинхронизироватьОбъектЛогистикиСОбъектомУС.Видимость = Объект.СвязанныеОбъекты.Количество() = 1;
	ОбновитьПовторноИспользуемыеЗначения();
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)	
	Элементы.СинхронизироватьОбъектЛогистикиСОбъектомУС.Видимость = Объект.СвязанныеОбъекты.Количество() = 1;	
	ОбновитьПовторноИспользуемыеЗначения();
КонецПроцедуры

&НаКлиенте
Процедура ПоискИндекса(Команда)
	КонтурЛогистика_ИнтеграцияДиадокКлиент.ПерейтиПоСсылке("https://www.pochta.ru/indexes");
КонецПроцедуры

&НаКлиенте
Процедура КонтактыПолучателейУведомленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контекст", Объект.Ссылка);
	ПараметрыОткрытия.Вставить("ТипКонтакта", ТекущиеДанные.Тип);
	ПараметрыОткрытия.Вставить("ЗначениеКонтакта", ТекущиеДанные.Контакт);
	ПараметрыОткрытия.Вставить("ТрНЗамечанияОтВодителя", ТекущиеДанные.ТрНЗамечанияОтВодителя);
	ПараметрыОткрытия.Вставить("ТрНЗамечанияОтПеревозчика", ТекущиеДанные.ТрНЗамечанияОтПеревозчика);
	ПараметрыОткрытия.Вставить("ТрНОтказПВ", ТекущиеДанные.ТрНОтказПВ);
	ПараметрыОткрытия.Вставить("ТрНОтказГП", ТекущиеДанные.ТрНОтказГП);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаВыбораКонтакта";
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ИзменениеКонтактнойИнформацииЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонтактыПолучателейУведомлений(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед добавлением необходимо сохранить");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контекст", Объект.Ссылка);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаВыбораКонтакта";
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ДобавлениеКонтактнойИнформацииЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеКонтактнойИнформацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Объект.КонтактыПолучателейУведомлений.Добавить();
	НоваяСтрока.Тип = Результат.ТипКонтакта;
	НоваяСтрока.Контакт = Результат.ЗначениеКонтакта;
	НоваяСтрока.ТрНЗамечанияОтВодителя = Результат.ТрНЗамечанияОтВодителя;
	НоваяСтрока.ТрНЗамечанияОтПеревозчика = Результат.ТрНЗамечанияОтПеревозчика;
	НоваяСтрока.ТрНОтказПВ = Результат.ТрНОтказПВ;
	НоваяСтрока.ТрНОтказГП = Результат.ТрНОтказГП;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеКонтактнойИнформацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.Тип = Результат.ТипКонтакта;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.Контакт = Результат.ЗначениеКонтакта;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНЗамечанияОтВодителя = Результат.ТрНЗамечанияОтВодителя;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНЗамечанияОтПеревозчика = Результат.ТрНЗамечанияОтПеревозчика;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНОтказПВ = Результат.ТрНОтказПВ;
	Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные.ТрНОтказГП = Результат.ТрНОтказГП;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактыПолучателейУведомленийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЭлементУчетнойСистемы(Команда)
	
	Если ЭтаФорма.СписокНастроекКонвертации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ВыборЭлементаУчетнойСистемыДляЗаполнения(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения");
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ВыбратьЭлементУчетнойСистемыЗавершение(ВыбранноеЗначение, ДополнительныеПараметры);
	
	УправлениеВидимостьюЭлементовФормыПослеКонвертации();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюЭлементовФормыПослеКонвертации() Экспорт
	
	УстановитьВидимостьЭлементов();
	
	УправлениеВидимостьюЭлементовФормыСервер();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюЭлементовФормыСервер()
	
	КонтурЛогистика_КонвертацияСервер.УправлениеВидимостьюЭлементовФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыСвязанныйОбъектНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ПоказатьСписокТиповДляСвязанногоОбъекта(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыСвязанныйОбъектОткрытие(Элемент, СтандартнаяОбработка)	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьСвязанныйОбъект(ЭтаФорма, СтандартнаяОбработка);	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОбработкаВыбораСвязанногоОбъекта(ЭтаФорма, ВыбранноеЗначение);
	ОбновитьПовторноИспользуемыеЗначения();
				
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОсновании(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед добавлением необходимо сохранить");
		Возврат;
	КонецЕсли;
			
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	ИмяТипаСправочника = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(Объект.Ссылка);
	
	ЗначениеОтбора = Новый Структура("НаправлениеКонвертации, ТипСправочникаЛогистика", НаправлениеКонвертации, ИмяТипаСправочника); 
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"СоздатьНаОснованииНачалоВыбораЗавершение", Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
&НаКлиенте
Процедура СоздатьНаОснованииНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат = Неопределено Тогда
		Сообщить("Не выбрана настройка конвертации справочника");
		Возврат;
	КонецЕсли;
	
	НастройкаКонвертацииСправочника = Результат;
	КонтурЛогистика_КонвертацияКлиент.КонвертироватьОбъектСправочникаЛогистикиВОбъектУС(ЭтаФорма, НастройкаКонвертацииСправочника);
	
	Элементы.СинхронизироватьОбъектЛогистикиСОбъектомУС.Видимость = Объект.СвязанныеОбъекты.Количество() = 1;

КонецПроцедуры        

&НаКлиенте
Процедура АдресКодРегионПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.АдресКодРегион) Тогда
		Возврат;
	КонецЕсли;
	
	ЧасовойПоясЛок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЧасовойПоясПоКодуРегиона(Объект.АдресКодРегион);
	
	Если ЗначениеЗаполнено(Объект.ЧасовойПояс)
		И Объект.ЧасовойПояс <> ЧасовойПоясЛок Тогда
		
		ТекстВопроса = "Часовой пояс заполнен и не совпадает с значением по умолчанию. Перезаполнить?";
		ДополнительныеПараметры = Новый Структура("ЧасовойПоясЛок", ЧасовойПоясЛок);
		Оповещение = Новый ОписаниеОповещения("АдресКодРегионПриИзмененииЗавершение", ЭтаФорма, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса,РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Да);
	Иначе
		Объект.ЧасовойПояс = ЧасовойПоясЛок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресКодРегионПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет
		Или Ответ = КодВозвратаДиалога.Отмена
		Или Ответ = Неопределено Тогда
		
		Возврат;
	КонецЕсли;
	
	Объект.ЧасовойПояс = ДополнительныеПараметры.ЧасовойПоясЛок;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораЧасовыхПоясов()
	
	Элементы.ЧасовойПояс.СписокВыбора.Очистить();
	Элементы.ЧасовойПояс.СписокВыбора.ЗагрузитьЗначения(ПолучитьДопустимыеЧасовыеПояса());
	
	Для Каждого ТекущаяСтрока Из Элементы.ЧасовойПояс.СписокВыбора Цикл
		ТекущаяСтрока.Представление = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(ТекущаяСтрока.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьСобственникаПунктаМаршрута()
	
	Элементы.АдресСтраницы.ТекущаяСтраница = Элементы.ДанныеСобственника;
	ТекущийЭлемент = Элементы.Собственник;
	
КонецПроцедуры
#Область ВводАдреса

&НаСервере
Процедура ИнициализироватьАдресНаФорме()
	
	КонтурЛогистика_ВводАдреса.ПодготовитьОтображениеАдресаПунктаМаршрута(Объект);
	АдресСтрокаВвод = КонтурЛогистика_ВводАдреса.ТекстАдресаДляОтображенияПунктаМаршрута(Объект);
	АдресКодГАРВвод = Объект.КодГАР;
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоАдресРоссииНаСервере(Знач АдресИнфКодСтраны)
	
	Возврат КонтурЛогистика_ВводАдреса.ЭтоСтранаРоссияДляАдреса(АдресИнфКодСтраны);
	
КонецФункции

&НаКлиенте
Процедура АдресИнфКодСтраныПриИзменении(Элемент)
	
	ПриИзмененииСтраныАдресаНаСервере(АдресСтрокаВвод);
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ИдетВыборАдресаИзСписка = Ложь;
	
	Если Не ЭтоАдресРоссииНаСервере(Объект.АдресИнфКодСтраны) Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьПодсказкиАдреса(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ИдетВыборАдресаИзСписка = Истина;
	Попытка
		АдресСтрокаВвод = ВыбранноеЗначение.Подсказка;
		Если ВыбранноеЗначение.Свойство("ЭтоСвободнаяФорма")
			И ВыбранноеЗначение.ЭтоСвободнаяФорма Тогда
			АдресКодГАРВвод = "";
			ПрименитьТекстАдресаНаСервере(ВыбранноеЗначение.Подсказка);
		Иначе
			ПрименитьПодсказкуАдресаНаСервере(ВыбранноеЗначение.ИдентификаторФИАС, ВыбранноеЗначение.Подсказка);
		КонецЕсли;
	Исключение
		ИдетВыборАдресаИзСписка = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаПриИзменении(Элемент)
	
	Если ИдетВыборАдресаИзСписка = Истина Тогда
		ИдетВыборАдресаИзСписка = Ложь;
		Возврат;
	КонецЕсли;
	
	АдресКодГАРВвод = "";
	Элементы.ДекорацияТипАдреса.Заголовок = "";
	ПрименитьТекстАдресаНаСервере(АдресСтрокаВвод);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьПодсказкиАдреса(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	ТекстПоиска = СокрЛП(Текст);
	Если СтрДлина(ТекстПоиска) < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Подсказки = ПодсказкиАдресаНаСервере(ТекстПоиска);
	Если Подсказки = Неопределено Тогда
		ДобавитьВыборСвободнойФормыАдреса(ДанныеВыбора, ТекстПоиска);
		Возврат;
	КонецЕсли;
	
	Для Каждого Подсказка Из Подсказки Цикл
		
		Если Подсказка.Свойство("ЭтоСвободнаяФорма")
			И Подсказка.ЭтоСвободнаяФорма Тогда
			ДанныеВыбора.Добавить(Подсказка, Подсказка.ПредставлениеВыбора);
			Продолжить;
		КонецЕсли;
		
		Представление = Подсказка.Подсказка;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыбора.Добавить(Подсказка, Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыборСвободнойФормыАдреса(ДанныеВыбора, Знач ТекстПоиска)
	
	ВыборСвободнойФормы = Новый Структура;
	ВыборСвободнойФормы.Вставить("Подсказка", ТекстПоиска);
	ВыборСвободнойФормы.Вставить("ИдентификаторФИАС", "");
	ВыборСвободнойФормы.Вставить("УровеньФИАС", "");
	ВыборСвободнойФормы.Вставить("ЭтоСвободнаяФорма", Истина);
	ДанныеВыбора.Добавить(ВыборСвободнойФормы, "<добавить в свободной форме>");
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСтраныАдресаНаСервере(Знач ТекстАдреса)
	
	АдресКодГАРВвод = "";
	СброситьКодГАРАдресаНаСервере();
	
	Если Не КонтурЛогистика_ВводАдреса.ЭтоСтранаРоссияДляАдреса(Объект.АдресИнфКодСтраны) Тогда
		КонтурЛогистика_ВводАдреса.ПрименитьИностранныйАдресПунктаМаршрута(Объект, ТекстАдреса);
		АдресСтрокаВвод = Объект.АдресИнфАдрес;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СброситьКодГАРАдресаНаСервере()
	
	Объект.КодГАР = "";
	Объект.АдресГАРЗначение = "";
	КонтурЛогистика_ВводАдреса.ОчиститьАдресКЛАДРПунктаМаршрута(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьТекстАдресаНаСервере(Знач ТекстАдреса)
	
	Если ЗначениеЗаполнено(АдресКодГАРВвод) Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ВводАдреса.ПрименитьРучнойТекстАдресаПунктаМаршрута(Объект, ТекстАдреса);
	АдресСтрокаВвод = Объект.АдресИнфАдрес;
	АдресКодГАРВвод = Объект.КодГАР;
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьПодсказкуАдресаНаСервере(Знач ИдентификаторФИАС, Знач Представление)
	
	КонтурЛогистика_ВводАдреса.ПрименитьАдресИзПодсказкиФИАСКПунктуМаршрута(
		Объект, ИдентификаторФИАС, Представление);
	АдресСтрокаВвод = Объект.АдресИнфАдрес;
	АдресКодГАРВвод = Объект.КодГАР;
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодсказкиАдресаНаСервере(Знач Текст)
	
	Попытка
		Клиент = КонтурЛогистика_ВводАдреса.НовыйФиасКлиент("", КонтурЛогистика_ВводАдреса.ЛокацияФиасПоУмолчанию());
		Возврат КонтурЛогистика_ВводАдреса.ПодсказкиАдреса(Клиент, Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ОбновитьИнформативнуюНадписьАдреса()
	
	ТипАдреса = КонтурЛогистика_ВводАдреса.ОпределитьТипАдресаПунктаМаршрута(Объект);
	Элементы.ДекорацияТипАдреса.Заголовок =
		КонтурЛогистика_ВводАдреса.ЗаголовокИнформацииТипаАдресаПунктаМаршрута(ТипАдреса);
	
КонецПроцедуры

#КонецОбласти
