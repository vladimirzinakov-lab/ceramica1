
#Область ОписаниеПеременных

&НаКлиенте
Перем ИдетВыборАдресаИзСписка;

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УказатьСобственника", УказатьСобственника);
	
	// +++ КонтурЛогистика_НастройкиКонвертацииСправочников
	
	КонтурЛогистика_КонвертацияСервер.НастройкиКонвертацииСправочников_ПриСозданииНаСервере(
		ЭтаФорма, "КонтурЛогистика_ПунктыМаршрута", ЭтаФорма, Элементы.Группа11);
		
	// --- КонтурЛогистика_НастройкиКонвертацииСправочников
	
	Элементы.СинхронизироватьОбъектЛогистикиСОбъектомУС.Видимость = Объект.СвязанныеОбъекты.Количество() = 1;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// Определяем использованность каналов отправки
	Элементы.ГруппаИспользоватьОтправкуВТелеграм.Видимость =
		Не Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	Элементы.ГруппаИспользоватьОтправкуНаПочту.Видимость =
		Не КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
	ЗаполнитьСписокВыбораЧасовыхПоясов();
	
	Если Параметры.Свойство("ТекущаяСтраница") Тогда 
		Если Элементы.Найти(Параметры.ТекущаяСтраница) <> Неопределено Тогда
			Элементы.АдресСтраницы.ТекущаяСтраница = Элементы[Параметры.ТекущаяСтраница];
		Иначе
			Элементы.АдресСтраницы.ТекущаяСтраница = Элементы.СтраницаАдрес;
		КонецЕсли;
	КонецЕсли;
	
	ИнициализироватьАдресНаФорме();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	
	Если УказатьСобственника Тогда
		УказатьСобственникаПунктаМаршрута();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("КонтурЛогистика_ПерепроверитьДокумент");
	Оповестить("КонтурЛогистика_ПунктМаршрута", Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправлениеПриИзменении(Элемент)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.Собственник.АвтоОтметкаНезаполненного = Объект.Отправление;
	Элементы.Собственник.ОтметкаНезаполненного = Объект.Отправление;

	Элементы.СобственникНеУказанПричина.Видимость 	= Не ЗначениеЗаполнено(Объект.Собственник);
	Элементы.ДоступКОбъектуТекст.Видимость 			= Не ЗначениеЗаполнено(Объект.ДоступКОбъектуДоговор);
	
	
КонецПроцедуры

&НаКлиенте
Процедура СобственникПриИзменении(Элемент)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ДоступКОбъектуДоговорПриИзменении(Элемент)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаСервере
Процедура ВыбратьРегионНаСервере()
	ДанныеМакета = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
	Элементы.АдресКодРегион.СписокВыбора.Очистить();
	Для Каждого текСтрока Из ДанныеМакета Цикл 
		Элементы.АдресКодРегион.СписокВыбора.Добавить(текСтрока.Код, текСтрока.Наименование + " " + текСтрока.Код);
	КонецЦикла;
	Элементы.АдресКодРегион.РежимВыбораИзСписка = Истина;
	Элементы.АдресКодРегион.КнопкаВыпадающегоСписка = Истина;
	Элементы.ВыбратьРегион.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьРегион(Команда)
	ВыбратьРегионНаСервере();
КонецПроцедуры

// +++ КонтурЛогистика_НастройкиКонвертацииСправочников

