	МенеджерЗаписи.ЗначениеНастройки = УстанавливаемоеЗначение;
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры	

Функция ПолучитьОбщуюМинимальнуюДатуГраницыСинхронизации(Организация = Неопределено) Экспорт
	
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	АвторизацияПоТокену = (РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow);
	
	ДанныеГраницы = Новый Структура;
	ДанныеГраницы.Вставить("ДатаГраницыСинхронизации", Дата(1, 1, 1, 0, 0, 0));
	ДанныеГраницы.Вставить("Организация", ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ИспользуетсяТРН", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН"));
	Запрос.УстановитьПараметр("ИспользуетсяПутевойЛист", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИспользуетсяПутевойЛист());
	Запрос.УстановитьПараметр("АвторизацияПоТокену", АвторизацияПоТокену);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Организация,
	|	КонтурЛогистика_ОрганизацииДиадок.УдалитьДатаГраницыСинхронизации КАК ДатаГраницыСинхронизации,
	|	ЕСТЬNULL(КонтурЛогистика_ОрганизацииДиадокНастройкиЧитатьЛентуДиадок.ЗначениеНастройки, ЛОЖЬ) КАК ЧитатьЛентуДиадок
	|ПОМЕСТИТЬ ДанныеАПИДиадокПредв
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_ОрганизацииДиадокНастройкиЧитатьЛентуДиадок
	|		ПО КонтурЛогистика_ОрганизацииДиадок.Ссылка = КонтурЛогистика_ОрганизацииДиадокНастройкиЧитатьЛентуДиадок.ОрганизацияДиадок
	|			И (КонтурЛогистика_ОрганизацииДиадокНастройкиЧитатьЛентуДиадок.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок))
	|ГДЕ
	|	КонтурЛогистика_ОрганизацииДиадок.Наш
	|	И НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И (НЕ &ОтборПоОрганизации
	|			ИЛИ &ОтборПоОрганизации
	|				И КонтурЛогистика_ОрганизацииДиадок.Ссылка = &Организация)
	|	И ЕСТЬNULL(КонтурЛогистика_ОрганизацииДиадокНастройкиЧитатьЛентуДиадок.ЗначениеНастройки, ЛОЖЬ) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
