	|ИЗ
	|	ДанныеАПИЛогистикиПредв КАК ДанныеАПИЛогистикиПредв
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛенты
	|		ПО ДанныеАПИЛогистикиПредв.Организация = КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛенты.ОрганизацияДиадок
	|			И (КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛенты.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата))
	|ГДЕ
	|	&ИспользуетсяТРН
	|	И ДанныеАПИЛогистикиПредв.ЕстьРольТрН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеАПИЛогистикиПредв.Организация,
	|	ДанныеАПИЛогистикиПредв.КлючАпи,
	|	КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛентыПЛ.ЗначениеНастройки,
	|	ДанныеАПИЛогистикиПредв.ЧитатьЛентуЛогистики
	|ИЗ
	|	ДанныеАПИЛогистикиПредв КАК ДанныеАПИЛогистикиПредв
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛентыПЛ
	|		ПО ДанныеАПИЛогистикиПредв.Организация = КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛентыПЛ.ОрганизацияДиадок
	|			И (КонтурЛогистика_ОрганизацииДиадокНастройкиАктуальностьЛентыПЛ.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДатаПЛ))
	|ГДЕ
	|	&ИспользуетсяПутевойЛист
	|	И ДанныеАПИЛогистикиПредв.ЕстьРольПЛ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеАПИДиадок.Организация КАК Организация,
	|	ДанныеАПИДиадок.ДатаГраницыСинхронизации КАК ДатаГраницыСинхронизации
	|ПОМЕСТИТЬ ИтогоДаты
	|ИЗ
	|	ДанныеАПИДиадок КАК ДанныеАПИДиадок
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеАПИЛогистики.Организация,
	|	ДанныеАПИЛогистики.ДатаГраницыСинхронизации
	|ИЗ
	|	ДанныеАПИЛогистики КАК ДанныеАПИЛогистики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИтогоДаты.Организация КАК Организация,
	|	ИтогоДаты.ДатаГраницыСинхронизации КАК ДатаГраницыСинхронизации
	|ИЗ
	|	ИтогоДаты КАК ИтогоДаты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаГраницыСинхронизации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеГраницы, Выборка);
	КонецЕсли;
	
	Возврат ДанныеГраницы;
	
КонецФункции

Функция ЕстьМаркерОбработаннойЛентыДиадок() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок КАК Организация
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК КонтурЛогистика_НастройкиОрганизаций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_НастройкиОрганизаций КАК НастройкиЧитатьЛенту
		|		ПО КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок = НастройкиЧитатьЛенту.ОрганизацияДиадок
		|			И (НастройкиЧитатьЛенту.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок))
		|			И (НастройкиЧитатьЛенту.ЗначениеНастройки = ИСТИНА)
		|ГДЕ
		|	КонтурЛогистика_НастройкиОрганизаций.Настройка = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок)
		|	И КонтурЛогистика_НастройкиОрганизаций.ЗначениеНастройки <> """"
		|	И НЕ КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок.ПометкаУдаления
		|	И КонтурЛогистика_НастройкиОрганизаций.ОрганизацияДиадок.Наш";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

#Область НастройкиОрганизацийРеквизитыОрганизации

Функция СинхронизироватьНастройкиОрганизации(ОрганизацияСсылка) Экспорт
	
	Результат = Новый Структура;
	
	Попытка
		
		ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
		
		// Заполним свойство Sociability, регулирующее прием документов от контрагентов
		Ответ = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization(ОрганизацияСсылка);
		Если Ответ.Свойство("Sociability") Тогда			
			ОрганизацияОбъект.Sociability = Ответ.Sociability;
			Результат.Вставить("Sociability", Ответ.Sociability);
		КонецЕсли;
		
		ОрганизацияОбъект.Записать();
		
	Исключение
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Ошибки при получение настроек Контрагентов: " + ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат Результат;
	
Конецфункции

#КонецОбласти

#КонецОбласти

Функция ОрганизацииДляОбновленияПоАктуальнойДате(ВходящиеОрганизации)
	
	МинимальныйПериодВЧасах = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"МинимальныйПериодАктуальностиДанныхОрганизации");
	
	Если МинимальныйПериодВЧасах = 0 Тогда
		Возврат ВходящиеОрганизации;
	КонецЕсли;
	
	МинимальныйПериодВСекундах = 60 * 60 * МинимальныйПериодВЧасах;
	ДатаНачалаОбновления = ТекущаяДатаСеанса() - МинимальныйПериодВСекундах;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачалаОбновления", ДатаНачалаОбновления);
	Запрос.УстановитьПараметр("ВходящиеОрганизации", ВходящиеОрганизации);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|ГДЕ
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка В(&ВходящиеОрганизации)
	|	И КонтурЛогистика_ОрганизацииДиадок.ДатаВремяАктуальности < &ДатаНачалаОбновления";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ОбновитьСтатусГотовКЭПДИзДиадока(ОрганизацияСсылка) Экспорт
	
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(ОрганизацияСсылка);
	СинхронизироватьРеквизитыОрганизацийИзДиадока(МассивОрганизаций);
	
КонецПроцедуры

Процедура ОбновитьСтатусГотовКЭПДИзДиадокаУВсехОрганизаций() Экспорт
	
	СинхронизироватьРеквизитыОрганизацийИзДиадока();
	
КонецПроцедуры

Процедура СинхронизироватьРеквизитыОрганизацийИзДиадока(МассивОрганизаций = Неопределено) Экспорт
	
	Если МассивОрганизаций = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
			|ГДЕ
			|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
			|	И (КонтурЛогистика_ОрганизацииДиадок.ID <> """"
			|		ИЛИ КонтурЛогистика_ОрганизацииДиадок.ИдентификаторУчастникаЭДО <> """")";
		
		МассивОрганизаций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		ОрганизацииКОбновлению = ОрганизацииДляОбновленияПоАктуальнойДате(МассивОрганизаций);
		
	Иначе
		
		ОрганизацииКОбновлению = МассивОрганизаций;
		
	КонецЕсли;
	
	Для Каждого ОрганизацияСсылка Из ОрганизацииКОбновлению Цикл
		
		Попытка
			ДанныеДД = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization(ОрганизацияСсылка);
			
			ОрганизацияОбъект = ОрганизацияСсылка.ПолучитьОбъект();
			
			ЗаполнитьПоляОрганизацииПоДаннымСервиса(ОрганизацияОбъект, ДанныеДД);
			
			ОрганизацияОбъект.ДатаВремяАктуальности = ТекущаяДатаСеанса();
			ОрганизацияОбъект.Записать();
			
		Исключение
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при синхронизации реквизитов организации из Диадока. " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДоступныйФункционал(Организация) Экспорт
	
	ИспользуетсяТРН	= КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
		
	ДоступныйФункционал = Новый Структура;
	ДоступныйФункционал.Вставить("ТрН", ИспользуетсяТРН И ЕстьРольТрН(Организация));
	ДоступныйФункционал.Вставить("ПЛ", 	КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ИспользуетсяПутевойЛист() И ЕстьРольПЛ(Организация));
	
	Возврат ДоступныйФункционал;
	
КонецФункции

Функция ЕстьРольТрН(Организация) Экспорт
	
	Возврат Организация.Грузоотправитель Или Организация.Перевозчик Или Организация.Грузополучатель;
	
КонецФункции

Функция ЕстьРольПЛ(Организация) Экспорт
	
	Возврат Организация.Оформитель Или Организация.Медик Или Организация.ТехОсмотр Или Организация.Одометр;
	
КонецФункции

Функция НайтиСоздатьПоИдентификаторуЭДО(ИдентификаторУчастникаЭДО) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторУчастникаЭДО) 
		Или ИдентификаторУчастникаЭДО = "FnsParticipantId" Тогда 
		Возврат ПустаяСсылка();
	КонецЕсли;	 	
	
	НайденныйЭлемент = НайтиОрганизациюПоИдентификаторуУчастникаЭДО(ИдентификаторУчастникаЭДО);
	
	Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда 
		Возврат НайденныйЭлемент;
	Иначе
		
		Попытка
			ДанныеДД = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization_ИдентификаторУчастникаЭДО(ИдентификаторУчастникаЭДО);
		Исключение
		   	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Не удалось синхронизировать организацию Диадок с идентификатором "
		   	 + ИдентификаторУчастникаЭДО + " Требуется опознать организацию");
		   	Возврат ПустаяСсылка(); 
		КонецПопытки;
		
		НоваяОрганизация = ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеДД, Неопределено);
	
		Возврат НоваяОрганизация
		
	КонецЕсли;
	
КонецФункции

// ищем по всем комбинациям ИНН/КПП/ОГРН
Функция НайтиОрганизациюПоКлючевымРеквизитам(ИНН = Неопределено, КПП = Неопределено, ОГРН = Неопределено, ИдентификаторУчастникаЭДО = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ИдентификаторУчастникаЭДО) Тогда
		Возврат НайтиИлиСопоставитьОрганизациюПоИдентификаторуЭДО(ИНН, КПП, ИдентификаторУчастникаЭДО);
	КонецЕсли;
	
	ОрганизацияДиадок = ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ИНН) И Не ЗначениеЗаполнено(ОГРН) Тогда
		Возврат ОрганизацияДиадок;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) Тогда
		НайденнаяОрганизацияИНН_КПП = НайтиОрганизациюПоИННКПП(СокрЛП(ИНН), СокрЛП(КПП));
		Если ЗначениеЗаполнено(НайденнаяОрганизацияИНН_КПП) Тогда
			Возврат НайденнаяОрганизацияИНН_КПП;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		НайденнаяОрганизацияИНН = НайтиПоРеквизиту("ИНН", СокрЛП(ИНН));
		Если ЗначениеЗаполнено(НайденнаяОрганизацияИНН) Тогда
			Возврат НайденнаяОрганизацияИНН;
		КонецЕсли;
	КонецЕсли;
	
	// последняя попытка - по ОГРН // в старом формате ПЛ 2023 может не прийти ИНН
	Если ЗначениеЗаполнено(ОГРН) И Не ЗначениеЗаполнено(ИНН) Тогда
		НайденнаяОрганизацияОГРН = НайтиПоРеквизиту("ОГРН", СокрЛП(ОГРН));
		Если ЗначениеЗаполнено(НайденнаяОрганизацияОГРН) Тогда
			Возврат НайденнаяОрганизацияОГРН;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции 

// Сопоставляет организацию по ИдЭДО с учетом конфликта ИНН+КПП / ИНН.
// Ящик из ИдФайл относится к организации, если ИНН внутри идентификатора (2BM-ИНН-...)
// совпадает с ИНН из XML: тот же юрик, другой ящик - создать новую карточку.
// Если ИНН в идентификаторе другой - слот имени файла не про эту организацию,
// ищем по реквизитам XML и ящик не пишем.
// При пустом ИдЭДО у найденной по реквизитам - дозаполняет.
// При другом непустом ИдЭДО той же организации - пустая ссылка (сигнал создать новую снаружи).
//
Функция НайтиИлиСопоставитьОрганизациюПоИдентификаторуЭДО(ИНН, КПП, ИдентификаторУчастникаЭДО)
	
	ИдЭДО = НормализованныйИдентификаторУчастникаЭДО(ИдентификаторУчастникаЭДО);
	
	Если Не ИдентификаторЭДОСоответствуетИНН(ИдЭДО, ИНН) Тогда
		Возврат НайтиОрганизациюПоИННИлиКПП(ИНН, КПП);
	КонецЕсли;
	
	НайденнаяПоИдЭДО = НайтиОрганизациюПоИдентификаторуУчастникаЭДО(ИдЭДО);
	Если ЗначениеЗаполнено(НайденнаяПоИдЭДО) Тогда
		
		Если Не ЗначениеЗаполнено(ИНН) Тогда
			Возврат НайденнаяПоИдЭДО;
		КонецЕсли;
		
		ИНННайденной = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(НайденнаяПоИдЭДО, "ИНН");
		Если СокрЛП(ИНННайденной) = СокрЛП(ИНН) Тогда
			Возврат НайденнаяПоИдЭДО;
		КонецЕсли;
		
	КонецЕсли;
	
	НайденнаяПоИННИдЭДО = НайтиОрганизациюПоИННИдентификаторуЭДО(ИНН, ИдЭДО);
	Если ЗначениеЗаполнено(НайденнаяПоИННИдЭДО) Тогда
		Возврат НайденнаяПоИННИдЭДО;
	КонецЕсли;
	
	НайденнаяПоРеквизитам = НайтиОрганизациюПоИННИлиКПП(ИНН, КПП);
	
	Если Не ЗначениеЗаполнено(НайденнаяПоРеквизитам) Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	ИдЭДОНайденной = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(
		НайденнаяПоРеквизитам, "ИдентификаторУчастникаЭДО");
	
	Если Не ЗначениеЗаполнено(ИдЭДОНайденной) Тогда
		ОрганизацияОбъект = НайденнаяПоРеквизитам.ПолучитьОбъект();
		ОрганизацияОбъект.ИдентификаторУчастникаЭДО = ИдЭДО;
		ОрганизацияОбъект.Записать();
		Возврат НайденнаяПоРеквизитам;
	КонецЕсли;
	
	Если ИдЭДОНайденной = ИдЭДО Тогда
		Возврат НайденнаяПоРеквизитам;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

