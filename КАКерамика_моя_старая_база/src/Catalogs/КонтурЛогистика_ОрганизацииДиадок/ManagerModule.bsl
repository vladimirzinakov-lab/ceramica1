// Проверяет наличие хотя бы одной авторизованной нашей организации с ролью грузоотправителя.
//
// Возвращаемое значение:
//  Булево - Истина, если такая организация найдена.
//
Функция ЕстьАвторизованнаяНашаОрганизацияГрузоотправитель() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_Аутентификация КАК КонтурЛогистика_Аутентификация
	|		ПО КонтурЛогистика_Аутентификация.Организация = КонтурЛогистика_ОрганизацииДиадок.Ссылка
	|ГДЕ
	|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
	|	И КонтурЛогистика_ОрганизацииДиадок.Наш
	|	И КонтурЛогистика_ОрганизацииДиадок.Грузоотправитель
	|	И КонтурЛогистика_Аутентификация.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

