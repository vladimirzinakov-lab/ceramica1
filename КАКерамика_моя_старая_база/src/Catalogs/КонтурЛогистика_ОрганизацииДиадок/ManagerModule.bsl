// Приводит идентификатор участника ЭДО к длине реквизита справочника (46).
//
Функция НормализованныйИдентификаторУчастникаЭДО(ИдентификаторУчастникаЭДО)
	
	ДлинаИдентификатораУчастникаЭДО = 46;
	Возврат Лев(СокрЛП(ИдентификаторУчастникаЭДО), ДлинаИдентификатораУчастникаЭДО);
	
КонецФункции

// Проверяет, что идентификатор участника ЭДО относится к указанному ИНН.
// В идентификаторе ФНС формат 2BM-ИНН-...: ИНН юрлица 10 цифр, ИП 12.
// Если ИНН пуст или ИНН из идентификатора разобрать нельзя - Истина
// (сопоставление по ящику не отключается).
//
Функция ИдентификаторЭДОСоответствуетИНН(ИдентификаторУчастникаЭДО, ИНН) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИННИзИдЭДО = ИННИзИдентификатораУчастникаЭДО(ИдентификаторУчастникаЭДО);
	Если Не ЗначениеЗаполнено(ИННИзИдЭДО) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СокрЛП(ИННИзИдЭДО) = СокрЛП(ИНН);
	
КонецФункции

Функция ИННИзИдентификатораУчастникаЭДО(ИдентификаторУчастникаЭДО)
	
	Блоки = КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(СокрЛП(ИдентификаторУчастникаЭДО), "-", Истина);
	Если Блоки.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Кандидат = СокрЛП(Блоки[1]);
	ДлинаИНН = СтрДлина(Кандидат);
	Если ДлинаИНН <> 10 И ДлинаИНН <> 12 Тогда
		Возврат "";
	КонецЕсли;
	
	Для ИндексСимвола = 1 По ДлинаИНН Цикл
		Код = КодСимвола(Кандидат, ИндексСимвола);
		Если Код < 48 Или Код > 57 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Кандидат;
	
КонецФункции

// Ищет организацию Диадок только по идентификатору участника ЭДО.
