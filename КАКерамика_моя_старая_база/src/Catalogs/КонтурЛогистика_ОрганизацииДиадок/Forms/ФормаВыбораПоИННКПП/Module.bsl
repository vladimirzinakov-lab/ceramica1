#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ИНН", ИНН);
	Параметры.Свойство("КПП", КПП);
	Параметры.Свойство("НеИзменятьИННКПП", НеИзменятьИННКПП);
	Параметры.Свойство("Активатор", Активатор);
	Параметры.Свойство("Контрагент", Контрагент);
	 	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Заголовок = Заголовок + ": ИНН " + ИНН;
		
		Если ЗначениеЗаполнено(КПП) Тогда
			Заголовок = Заголовок + ", КПП " + КПП;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		ЗапроситьИзДиадокаИЗаполнитьСписок();
	Иначе
		Элементы.Найти.КнопкаПоУмолчанию = Истина;
		Элементы.ФормаВыбрать.КнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	
	Если Параметры.РежимПоиска Тогда 
		Заголовок = "Поиск по ИНН в Диадоке";
	КонецЕсли;
		
	УстановитьВидимостьЭлементовПоискаПоИННКППНаСервере();
	ОбновитьДоступностьКнопкиНайтиВФНСНаСервере();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Организации.Количество() = 0 И ЗначениеЗаполнено(СокрЛП(ИНН)) Тогда
		Если ДоступенПоискВФНС() Тогда
			ПредложитьПоискВФНСПриПустомРезультатеДиадока();
		Иначе
			ОбновитьДоступностьКнопкиНайтиВФНС();
			ПоказатьПриглашениеКОбменуПриНеобходимости();
		КонецЕсли;
	Иначе
		ПоказатьПриглашениеКОбменуПриНеобходимости();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОрганизации

&НаКлиенте
Процедура ОрганизацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыборОрганизации();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыборОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВДД(Команда)
	
	Если ОперацияВФонеВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ИНН)) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Обязательно указать ИНН для поиска");
		Возврат;
	КонецЕсли;
	
	Если Не ИННСоответствуетТребованиям(ИНН) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			"ИНН должен содержать 10 или 12 цифр");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(КПП)) И Не КППСоответствуетТребованиям(КПП) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			ТекстОшибкиПроверкиКПП());
		Возврат;
	КонецЕсли;
	
	УстановитьБлокировкуОперации(Истина);
	
	Попытка
		ЗапроситьИзДиадокаИЗаполнитьСписок();
		ОбновитьДоступностьКнопкиНайтиВФНС();
		
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.Видимость =
			Не НеИзменятьИННКПП И Организации.Количество() = 0;
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.КнопкаПоУмолчанию =
			Не НеИзменятьИННКПП И Организации.Количество() = 0;
		Элементы.Найти.КнопкаПоУмолчанию = Ложь;
		
		Если Организации.Количество() = 0 Тогда
			УстановитьБлокировкуОперации(Ложь);
			Если ДоступенПоискВФНС() Тогда
				ПредложитьПоискВФНСПриПустомРезультатеДиадока();
			Иначе
				ПоказатьПриглашениеКОбменуПриНеобходимости(Истина);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	Исключение
		УстановитьБлокировкуОперации(Ложь);
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	УстановитьБлокировкуОперации(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВФНС(Команда)
	
	ВыполнитьПоискВФНС(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыборОрганизации()
	
	ТекущиеДанные = Элементы.Организации.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ИсточникДиадокФНС = "ФНС" Тогда
		
		Если Не НеИзменятьИННКПП И Не Параметры.РежимПоиска Тогда
			ТекстВопроса = "Организация Диадок будет перезаполнена. Продолжить?";
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
				ТекстВопроса,,,, ЭтаФорма, "СоздатьИВыбратьРоуминговыйЯщикЗавершение");
		Иначе
			СоздатьИВыбратьРоуминговыйЯщик();
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если Параметры.РежимПоиска Тогда
		
		Данные = ДанныеПоОрганизации(ТекущиеДанные.OrgId);
		Если Данные <> Неопределено Тогда 
			НайденнаяОрга = ДобавитьОрганизациюИзДД(Данные);
			Оповестить("КонтурЛогистика_ОбновитьОрганизации", НайденнаяОрга);
			ОповеститьОбИзменении(Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок"));
			ЭтаФорма.Закрыть(НайденнаяОрга);
		КонецЕсли;
		
	Иначе
		
		Если НеИзменятьИННКПП Тогда
			Данные = ДанныеПоОрганизации(Элементы.Организации.ТекущиеДанные.OrgId);	
			Закрыть(Данные);
		Иначе
			ТекстВопроса = "Организация Диадок будет перезаполнена. Продолжить?";
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса,,,, ЭтаФорма, "ВыборЗавершение");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьОрганизациюИзДД(Данные)
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(Данные);
	
КонецФункции

&НаКлиенте
Процедура ВыборЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет
		Или Ответ = КодВозвратаДиалога.Отмена Тогда
		
		Возврат;
	КонецЕсли;
	
	Данные = ДанныеПоОрганизации(Элементы.Организации.ТекущиеДанные.OrgId);
	
	Закрыть(Данные);
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеПоОрганизации(OrgId)
	
	ДанныеОрганизаций = ПолучитьИзВременногоХранилища(АдремХранилищаВходныхДанных);
	
	Если ДанныеОрганизаций = Неопределено Тогда
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Данные могли устареть. Повторите поиск");
		Элементы.Найти.КнопкаПоУмолчанию = Истина;
		
	Иначе
		
		Для Каждого ТекущаяСтрока Из ДанныеОрганизаций Цикл
			Если ТекущаяСтрока.OrgId = OrgId Тогда
				Возврат ТекущаяСтрока;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуОрганизаций(ДанныеОрганизаций)
	
	Для Каждого ТекущаяСтрока Из ДанныеОрганизаций Цикл
		
		НоваяСтрока = Организации.Добавить();
		НоваяСтрока.OrgId = ТекущаяСтрока.OrgId;
		НоваяСтрока.ИсточникДиадокФНС = "Диадок";
		НоваяСтрока.Действие = "Выбрать";
		НоваяСтрока.НаименованиеОрганизацииПолное = ТекущаяСтрока.FullName;
		
		Если ТекущаяСтрока.Свойство("ShortName") Тогда
			НоваяСтрока.Наименование = ТекущаяСтрока.ShortName;
		Иначе
			НоваяСтрока.Наименование = НоваяСтрока.НаименованиеОрганизацииПолное;
		КонецЕсли;
		
		Если СтрДлина(ТекущаяСтрока.Inn) = 12 Тогда
			НоваяСтрока.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИП");
		ИначеЕсли ТекущаяСтрока.IsForeign Тогда
			НоваяСтрока.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо");
		Иначе 
			НоваяСтрока.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ЮрЛицо");
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("Kpp") Тогда
			НоваяСтрока.КПП = ТекущаяСтрока.Kpp;
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("Ogrn") Тогда
			НоваяСтрока.ОГРН = ТекущаяСтрока.Ogrn;
		КонецЕсли;
		
		НоваяСтрока.Тестовая = ТекущаяСтрока.IsTest;
		НоваяСтрока.Роуминг = ТекущаяСтрока.IsRoaming;
		НоваяСтрока.Активная = ТекущаяСтрока.IsActive;
		
		Если ТекущаяСтрока.Свойство("FnsParticipantId") Тогда
			
			НоваяСтрока.ИдентификаторУчастникаЭДО = ТекущаяСтрока.FnsParticipantId;
			
			НоваяСтрока.ЭДОПровайдер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПровайдераПоИдентификатору(ТекущаяСтрока.FnsParticipantId);
			
		КонецЕсли;
		
		ТочноеСовпадение = Ложь;
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
		Если ПараметрыСервиса.АвторизацияВыполнена Тогда
			
			Попытка
				
				ПараметрыСервисаЛогистика = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика();
				СтруктураДанных = КонтурЛогистика_API_Логистика.ПолучитьРеквизитыОрганизации(ПараметрыСервисаЛогистика, ИНН, НоваяСтрока.КПП);
				
				Если СтруктураДанных.Количество() > 0 Тогда
					
					Для Каждого ОрганизацияДД Из СтруктураДанных Цикл 
						
						Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторУчастникаЭДО) 
							И ОрганизацияДД.Получить("fnsParticipantId") = НоваяСтрока.ИдентификаторУчастникаЭДО  Тогда 
							НоваяСтрока.ЕстьВСервисеЛогистика = ОрганизацияДД.Получить("isLogistics");
							Прервать;
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
				
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("ReadyForEpdStatus") Тогда
			
			СтатусГотовностикЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.ЗначениеПоСтроке(ТекущаяСтрока.ReadyForEpdStatus);
			НоваяСтрока.СтатусГотовностиКЭПД = СтатусГотовностикЭПД;
			
			Если СтатусГотовностикЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.Ready Тогда
				НоваяСтрока.КартинкаСтатусГотовностиКЭПД = 0;
			ИначеЕсли СтатусГотовностикЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.NotReady Тогда
				НоваяСтрока.КартинкаСтатусГотовностиКЭПД = 1;				
			Иначе
				НоваяСтрока.КартинкаСтатусГотовностиКЭПД = 2;				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Организации.Сортировать("ИсточникДиадокФНС, Роуминг");
	
КонецПроцедуры

&НаСервере
Процедура ЗапроситьИзДиадокаИЗаполнитьСписок()
	
	Перем Данные, ДанныеОрганизаций;
	
	Данные = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganizationsByInnKpp(СокрЛП(ИНН), "");
	
	Организации.Очистить();
	КоличествоЯщиков = 0;
	
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Organizations") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОрганизаций = Данные.Organizations;
	
	Если ТипЗнч(ДанныеОрганизаций) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуОрганизаций(ДанныеОрганизаций);
	
	АдремХранилищаВходныхДанных = ПоместитьВоВременноеХранилище(ДанныеОрганизаций, Новый УникальныйИдентификатор);
	
	КоличествоЯщиков = ДанныеОрганизаций.Количество();

КонецПроцедуры

&НаКлиенте
Процедура ИННПриИзменении(Элемент)
	
	ИНН = СокрЛП(ИНН);
	
	Если ЗначениеЗаполнено(ИНН) И Не ИННСоответствуетТребованиям(ИНН) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			"ИНН должен содержать 10 или 12 цифр");
	КонецЕсли;
	
	ОбновитьДоступностьКнопкиНайтиВФНС();
	
КонецПроцедуры

&НаКлиенте
Процедура КПППриИзменении(Элемент)
	
	КПП = СокрЛП(КПП);
	
	Если ЗначениеЗаполнено(КПП) И Не КППСоответствуетТребованиям(КПП) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			ТекстОшибкиПроверкиКПП());
	КонецЕсли;
	
	ОбновитьДоступностьКнопкиНайтиВФНС();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПоискВФНСПриПустомРезультатеДиадока()
	
	ТекстВопроса = "В Диадоке не найдено организаций для указанных ИНН/КПП. Найти доступные ящики для обмена в ФНС?";
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(
		ТекстВопроса,,, , ЭтаФорма, "ПредложитьПоискВФНСЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьПоискВФНСЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьПоискВФНС(Истина);
		Возврат;
	КонецЕсли;
	
	Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.Видимость =
		Не НеИзменятьИННКПП И Параметры.РежимПоиска;
	Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.КнопкаПоУмолчанию =
		Не НеИзменятьИННКПП И Параметры.РежимПоиска;
	ОбновитьДоступностьКнопкиНайтиВФНС();
	
	ПоказатьПриглашениеКОбменуПриНеобходимости(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискВФНС(ЭтоПоискПриПустомДиадоке)
	
	Если ОперацияВФонеВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДоступенПоискВФНС() Тогда
		
		Если СтрДлина(СокрЛП(ИНН)) = 10 И Не ЗначениеЗаполнено(СокрЛП(КПП)) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
				"Поиск в ФНС для юр. лица без КПП невозможен. Перейдите в организацию, заполните КПП и повторите поиск.",
				, , ЭтаФорма, "ПослеОшибкиПоискаВФНС", ЭтоПоискПриПустомДиадоке);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	УстановитьБлокировкуОперации(Истина);
	
	МеткаПоиска = ?(ЭтоПоискПриПустомДиадоке, "В Диадоке нет ящиков", "Поиск доп. ящиков");
	
	Попытка
		РезультатПоиска = НайтиВФНСНаСервере(ЭтоПоискПриПустомДиадоке, МеткаПоиска);
	Исключение
		УстановитьБлокировкуОперации(Ложь);
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если ЭтоПоискПриПустомДиадоке Тогда
			ПоказатьПриглашениеКОбменуПриНеобходимости(Истина);
		КонецЕсли;
		Возврат;
	КонецПопытки;
	
	УстановитьБлокировкуОперации(Ложь);
	
	Если РезультатПоиска.ПоказатьПриглашение Тогда
		ПоказатьПриглашениеКОбменуПриНеобходимости(Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатПоиска.ТекстСообщения) Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(РезультатПоиска.ТекстСообщения);
	КонецЕсли;
	
	ОбновитьДоступностьКнопкиНайтиВФНС();
	
	Если Организации.Количество() = 0 И Параметры.РежимПоиска И Не НеИзменятьИННКПП Тогда
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.Видимость = Истина;
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОшибкиПоискаВФНС(ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры = Истина Тогда
		ПоказатьПриглашениеКОбменуПриНеобходимости(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиВФНСНаСервере(ЭтоПоискПриПустомДиадоке, МеткаПоиска)
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстСообщения", "");
	Результат.Вставить("ПоказатьПриглашение", Ложь);
	
	ПеременныеМетрики = Новый Структура;
	ПеременныеМетрики.Вставить("ИНН", СокрЛП(ИНН));
	ПеременныеМетрики.Вставить("КПП", СокрЛП(КПП));
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Ящики ФНС",
		"Поиск",
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВыбораПоИННКПП",
		МеткаПоиска,
		Ложь,
		ПеременныеМетрики);
	
	Попытка
		ОтветФНС = КонтурЛогистика_API_Диадок.Диадок_АПИ_SearchFnsParticipants(СокрЛП(ИНН), СокрЛП(КПП));
	Исключение
		Результат.ТекстСообщения = "Не удалось получить данные из ФНС. Попробуйте позже или обратитесь в поддержку.";
		Результат.ПоказатьПриглашение = ЭтоПоискПриПустомДиадоке;
		ЗарегистрироватьМетрикуЛогаФНС("поиск", "Exception", "");
		Возврат Результат;
	КонецПопытки;
	
	Статус = "";
	Если ТипЗнч(ОтветФНС) = Тип("Структура") И ОтветФНС.Свойство("Status") Тогда
		Статус = Строка(ОтветФНС.Status);
	КонецЕсли;
	
	ЗарегистрироватьМетрикуЛогаФНС("поиск", Статус, "");
	
	Если Статус = "UnknownFnsParticipantSearchStatus" Или Не ЗначениеЗаполнено(Статус) Тогда
		Результат.ТекстСообщения = "Не удалось получить данные из ФНС. Попробуйте позже или обратитесь в поддержку.";
		Результат.ПоказатьПриглашение = ЭтоПоискПриПустомДиадоке;
		Возврат Результат;
	ИначеЕсли Статус = "NotFoundFnsParticipantSearchStatus" Тогда
		Результат.ТекстСообщения = "Сведения о запрашиваемой организации отсутствуют в ФНС";
		Результат.ПоказатьПриглашение = ЭтоПоискПриПустомДиадоке;
		Возврат Результат;
	ИначеЕсли Статус = "NotAllowedFnsParticipantSearchStatus" Тогда
		Результат.ТекстСообщения = "Организация ограничила доступ на получение сведений в ФНС";
		Результат.ПоказатьПриглашение = ЭтоПоискПриПустомДиадоке;
		Возврат Результат;
	ИначеЕсли Статус <> "OkFnsParticipantSearchStatus" Тогда
		Результат.ТекстСообщения = "Не удалось получить данные из ФНС. Попробуйте позже или обратитесь в поддержку.";
		Результат.ПоказатьПриглашение = ЭтоПоискПриПустомДиадоке;
		Возврат Результат;
	КонецЕсли;
	
	УчастникиФНС = Новый Массив;
	Если ОтветФНС.Свойство("Participants") И ТипЗнч(ОтветФНС.Participants) = Тип("Массив") Тогда
		УчастникиФНС = ОтветФНС.Participants;
	КонецЕсли;
	
	УдалитьСтрокиФНСИзТаблицы();
	
	ИзвестныеFnsId = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Организации Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторУчастникаЭДО) Тогда
			ИзвестныеFnsId.Вставить(ВРег(СокрЛП(СтрокаТаблицы.ИдентификаторУчастникаЭДО)), Истина);
		КонецЕсли;
	КонецЦикла;
	
	ДобавленоСтрокФНС = 0;
	
	Для Каждого Участник Из УчастникиФНС Цикл
		
		FnsParticipantId = "";
		Если Участник.Свойство("FnsParticipantId") Тогда
			FnsParticipantId = Участник.FnsParticipantId;
		КонецЕсли;
		
		КлючFnsId = ВРег(СокрЛП(FnsParticipantId));
		Если Не ЗначениеЗаполнено(КлючFnsId) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИзвестныеFnsId.Получить(КлючFnsId) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИзвестныеFnsId.Вставить(КлючFnsId, Истина);
		
		НоваяСтрока = Организации.Добавить();
		НоваяСтрока.ИсточникДиадокФНС = "ФНС";
		НоваяСтрока.Действие = "Создать и выбрать";
		НоваяСтрока.OrgId = FnsParticipantId;
		НоваяСтрока.ИдентификаторУчастникаЭДО = FnsParticipantId;
		НоваяСтрока.Роуминг = Истина;
		НоваяСтрока.Активная = Ложь;
		НоваяСтрока.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UndefinedEpdStatus;
		НоваяСтрока.КартинкаСтатусГотовностиКЭПД = 2;
		НоваяСтрока.ЭДОПровайдер = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПровайдераПоИдентификатору(FnsParticipantId);
		
		Если Участник.Свойство("FullName") Тогда
			НоваяСтрока.НаименованиеОрганизацииПолное = Участник.FullName;
			НоваяСтрока.Наименование = Участник.FullName;
		КонецЕсли;
		
		Если Участник.Свойство("Kpp") Тогда
			НоваяСтрока.КПП = Участник.Kpp;
		КонецЕсли;
		
		Если Участник.Свойство("Inn") Тогда
			Если СтрДлина(Участник.Inn) = 12 Тогда
				НоваяСтрока.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ИП;
			Иначе
				НоваяСтрока.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
			КонецЕсли;
		КонецЕсли;
		
		ДобавленоСтрокФНС = ДобавленоСтрокФНС + 1;
		
	КонецЦикла;
	
	Если ДобавленоСтрокФНС = 0 Тогда
		Если ЭтоПоискПриПустомДиадоке Тогда
			Результат.ТекстСообщения = "Сведения о запрашиваемой организации отсутствуют в ФНС";
			Результат.ПоказатьПриглашение = Истина;
		Иначе
			Результат.ТекстСообщения = "Дополнительных ящиков в ФНС не найдено";
		КонецЕсли;
	Иначе
		Организации.Сортировать("ИсточникДиадокФНС, Роуминг");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УдалитьСтрокиФНСИзТаблицы()
	
	Индекс = Организации.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Организации[Индекс].ИсточникДиадокФНС = "ФНС" Тогда
			Организации.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИВыбратьРоуминговыйЯщикЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет
		Или Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьИВыбратьРоуминговыйЯщик();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИВыбратьРоуминговыйЯщик()
	
	Если ОперацияВФонеВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Организации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьБлокировкуОперации(Истина);
	
	Попытка
		РезультатСоздания = СоздатьРоуминговыйЯщикНаСервере(ТекущиеДанные.ИдентификаторУчастникаЭДО);
	Исключение
		УстановитьБлокировкуОперации(Ложь);
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	УстановитьБлокировкуОперации(Ложь);
	
	Если РезультатСоздания.КодОтвета = 409 Тогда
		
		Если РезультатСоздания.Организация <> Неопределено Тогда
			ЗавершитьВыборСозданнойОрганизации(РезультатСоздания.Организация);
			Возврат;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			"Не удалось создать организацию в Диадок. Обновите список через «Найти в Диадоке» или повторите позже.");
		Возврат;
		
	КонецЕсли;
	
	Если РезультатСоздания.Организация = Неопределено Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(
			"Не удалось создать организацию в Диадок. Попробуйте позже или обратитесь в поддержку.");
		Возврат;
	КонецЕсли;
	
	ЗавершитьВыборСозданнойОрганизации(РезультатСоздания.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборСозданнойОрганизации(Данные)
	
	Если Параметры.РежимПоиска Тогда
		НайденнаяОрга = ДобавитьОрганизациюИзДД(Данные);
		Оповестить("КонтурЛогистика_ОбновитьОрганизации", НайденнаяОрга);
		ОповеститьОбИзменении(Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок"));
		ЭтаФорма.Закрыть(НайденнаяОрга);
	Иначе
		Закрыть(Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьРоуминговыйЯщикНаСервере(FnsParticipantId)
	
	ПеременныеМетрики = Новый Структура;
	ПеременныеМетрики.Вставить("ИНН", СокрЛП(ИНН));
	ПеременныеМетрики.Вставить("КПП", СокрЛП(КПП));
	ПеременныеМетрики.Вставить("FnsParticipantId", FnsParticipantId);
	ПеременныеМетрики.Вставить("Провайдер",
		КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьПровайдераПоИдентификатору(FnsParticipantId));
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Ящики ФНС",
		"Создание",
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВыбораПоИННКПП",
		,
		Ложь,
		ПеременныеМетрики);
	
	Попытка
		Результат = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrCreateRoamingOrganizationByFnsParticipantId(FnsParticipantId);
	Исключение
		ЗарегистрироватьМетрикуЛогаФНС("создание", "Exception", FnsParticipantId);
		ВызватьИсключение;
	КонецПопытки;
	
	КодОтвета = 0;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("КодОтвета") Тогда
		КодОтвета = Результат.КодОтвета;
	КонецЕсли;
	
	ЗарегистрироватьМетрикуЛогаФНС("создание", Строка(КодОтвета), FnsParticipantId);
	
	Если КодОтвета = 409 Тогда
		
		ОрганизацияИзДиадока = Неопределено;
		Попытка
			ОрганизацияИзДиадока = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganization_ИдентификаторУчастникаЭДО(FnsParticipantId);
		Исключение
			ОрганизацияИзДиадока = Неопределено;
		КонецПопытки;
		
		Если ТипЗнч(ОрганизацияИзДиадока) = Тип("Структура")
			И ОрганизацияИзДиадока.Свойство("OrgId") Тогда
			Результат.Организация = ОрганизацияИзДиадока;
			ПоместитьОрганизациюДиадокаВоВременноеХранилище(ОрганизацияИзДиадока);
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Если КодОтвета = 200 И Результат.Организация <> Неопределено Тогда
		ПоместитьОрганизациюДиадокаВоВременноеХранилище(Результат.Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоместитьОрганизациюДиадокаВоВременноеХранилище(ОрганизацияДиадока)
	
	ДанныеОрганизаций = Новый Массив;
	Если ЗначениеЗаполнено(АдремХранилищаВходныхДанных) Тогда
		ДанныеИзХранилища = ПолучитьИзВременногоХранилища(АдремХранилищаВходныхДанных);
		Если ТипЗнч(ДанныеИзХранилища) = Тип("Массив") Тогда
			ДанныеОрганизаций = ДанныеИзХранилища;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеОрганизаций.Добавить(ОрганизацияДиадока);
	АдремХранилищаВходныхДанных = ПоместитьВоВременноеХранилище(ДанныеОрганизаций, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПриглашениеКОбменуПриНеобходимости(ПринудительноПригласитьВЭДО = Ложь)
	
	Если Не ЗначениеЗаполнено(Активатор)
		Или Не ЗначениеЗаполнено(Контрагент)
		Или Активатор = Контрагент
		Или Не КонтурЛогистика_ОбщегоНазначенияСервер.ВключеныУведомленияОГотовностиКЭПД() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Инициатор", Активатор);
	ПараметрыФормы.Вставить("Контрагент", Контрагент);
	
	Если ПринудительноПригласитьВЭДО Тогда
		ПараметрыФормы.Вставить("ПригласитьВЭДО", Истина);
	Иначе
		ПараметрыФормы.Вставить("ОтправитьУведомлениеПригласитьВЭДО", Истина);
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_ПриглашениеКОбменуЭПД", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ДоступенПоискВФНС()
	
	Возврат ДоступенПоискВФНСПоИННКПП(ИНН, КПП);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступенПоискВФНСПоИННКПП(ИНН, КПП)
	
	ИННЛокальный = СокрЛП(ИНН);
	
	Если Не ИННСоответствуетТребованиям(ИННЛокальный) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрДлина(ИННЛокальный) = 12 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат КППСоответствуетТребованиям(КПП);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИННСоответствуетТребованиям(ИНН)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИННСоответствуетТребованиям(ИНН);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КППСоответствуетТребованиям(КПП)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КППСоответствуетТребованиям(КПП);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТребуетсяКППДляПоискаВФНС(ИНН)
	
	Возврат СтрДлина(СокрЛП(ИНН)) = 10;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстОшибкиПроверкиКПП()
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекстОшибкиПроверкиКПП();
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовПоискаПоИННКППНаСервере()
	
	ПоказыватьПоляПоиска = Не НеИзменятьИННКПП;
	
	Элементы.ГруппаИННКПП.Видимость = Истина;
	Элементы.ИНН.Видимость = ПоказыватьПоляПоиска;
	Элементы.КПП.Видимость = ПоказыватьПоляПоиска;
	Элементы.Найти.Видимость = ПоказыватьПоляПоиска;
	Элементы.НайтиВФНС.Видимость = Истина;
	
	Если Не ПоказыватьПоляПоиска Тогда
		Элементы.СправочникКонтурЛогистика_ОрганизацииДиадокСоздать.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьКнопкиНайтиВФНС()
	
	Элементы.НайтиВФНС.Видимость = Истина;
	Элементы.НайтиВФНС.Доступность = ДоступенПоискВФНСПоИННКПП(ИНН, КПП)
		И Не ОперацияВФонеВыполняется;
	ОбновитьОтметкуНезаполненногоКПП();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКнопкиНайтиВФНСНаСервере()
	
	Элементы.НайтиВФНС.Видимость = Истина;
	Элементы.НайтиВФНС.Доступность = ДоступенПоискВФНСПоИННКПП(ИНН, КПП);
	ОбновитьОтметкуНезаполненногоКППНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтметкуНезаполненногоКПП()
	
	ТребуетсяКПП = ТребуетсяКППДляПоискаВФНС(ИНН);
	КППЗаполнен = ЗначениеЗаполнено(СокрЛП(КПП));
	
	Если КППЗаполнен Тогда
		Элементы.КПП.ОтметкаНезаполненного = Не КППСоответствуетТребованиям(КПП);
	Иначе
		Элементы.КПП.ОтметкаНезаполненного = ТребуетсяКПП;
	КонецЕсли;
	
	Элементы.КПП.АвтоОтметкаНезаполненного = ТребуетсяКПП;
	Элементы.КПП.ПодсказкаВвода = ?(ТребуетсяКПП, "обязательно", "необязательно");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметкуНезаполненногоКППНаСервере()
	
	ТребуетсяКПП = ТребуетсяКППДляПоискаВФНС(ИНН);
	КППЗаполнен = ЗначениеЗаполнено(СокрЛП(КПП));
	
	Если КППЗаполнен Тогда
		Элементы.КПП.ОтметкаНезаполненного = Не КППСоответствуетТребованиям(КПП);
	Иначе
		Элементы.КПП.ОтметкаНезаполненного = ТребуетсяКПП;
	КонецЕсли;
	
	Элементы.КПП.АвтоОтметкаНезаполненного = ТребуетсяКПП;
	Элементы.КПП.ПодсказкаВвода = ?(ТребуетсяКПП, "обязательно", "необязательно");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьБлокировкуОперации(Заблокировать)
	
	ОперацияВФонеВыполняется = Заблокировать;
	Элементы.Найти.Доступность = Не Заблокировать;
	Элементы.НайтиВФНС.Доступность = Не Заблокировать И ДоступенПоискВФНСПоИННКПП(ИНН, КПП);
	Элементы.ФормаВыбрать.Доступность = Не Заблокировать;
	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьМетрикуЛогаФНС(ТипЗапроса, Статус, FnsParticipantId)
	
	ПеременныеМетрики = Новый Структура;
	ПеременныеМетрики.Вставить("ИНН", СокрЛП(ИНН));
	ПеременныеМетрики.Вставить("КПП", СокрЛП(КПП));
	ПеременныеМетрики.Вставить("FnsParticipantId", FnsParticipantId);
	ПеременныеМетрики.Вставить("ТипЗапроса", ТипЗапроса);
	ПеременныеМетрики.Вставить("Статус", Статус);
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииЛюбойОрганизации();
	Если ДанныеАутентификации <> Неопределено Тогда
		ПеременныеМетрики.Вставить("boxId", ДанныеАутентификации.DiadocBoxId);
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(
		ПеременныеМетрики,
		"Ящики ФНС",
		ТипЗапроса,
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВыбораПоИННКПП",
		Статус);
	
КонецПроцедуры

#КонецОбласти
