// --- КонтурЛогистика_НастройкиКонвертацииСправочников

&НаКлиенте
Процедура УстановитьГраницуАктуальностиВезде(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Записать();
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыборДатыЗавершение", ЭтаФорма);
	ПоказатьВводДаты(Оповещение, ДатаГраницыСинхронизацииЛогистика, "Границ актуальности лент", ЧастиДаты.ДатаВремя);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДатыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	// Установим дату ленты АПИ Диадок
	АктуальностьЛентыСобытийДиадокДата = Результат;
	АктуальностьЛентыСобытийДиадок = "";
	Элементы.AfterIndexKey.Видимость = Ложь;
	
	Если ЕстьКлючАПИЛогистики() Или АвторизацияПоOIDC Тогда
		
		Если ДоступнаТрН Тогда
			
			// Очистим метку ленты
			УстановитьЗначениеНастройкиСервер(Объект.Ссылка,
				ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий"), "");
			
			// Установим дату ленты АПИ ДД
			УстановитьЗначениеНастройкиСервер(Объект.Ссылка,
				ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"), Результат);
			
		КонецЕсли;
		
		Если ДоступенПЛ Тогда
			
			// Очистим метку ленты
			УстановитьЗначениеНастройкиСервер(Объект.Ссылка,
				ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийПЛ"), "");
			
			// Установим дату ленты АПИ Логистики
			УстановитьЗначениеНастройкиСервер(Объект.Ссылка,
				ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДатаПЛ"), Результат);
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗначениеНастройкиСервер(Объект.Ссылка, 
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата"), Результат);
	
	ДатаГраницыСинхронизацииЛогистика = Результат;
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьКлючАПИЛогистики()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Апикей = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"));
	Если ЗначениеЗаполнено(Апикей) Тогда
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура НастроитьОтправкуВТелеграм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ПолучитьНастройкуПоИмениПредопределенного("ИспользоватьОтправкуВТелеграм"));
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_Настройки.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтправкуНаПочту(Команда)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастройкаУчетнойЗаписиЭлектроннойПочты",, ЭтаФорма, ЭтаФорма,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодключитьТелеграмНажатие(Элемент)
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_QRКодБотаКаналаТелеграм",,
		ЭтаФорма, ЭтаФорма,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьГруппыТелеграм()
	
	Элементы.ДекорацияИдетПроверкаТелеграм.Видимость = Ложь;
	Элементы.ДекорацияРезультатУспехТелеграм.Видимость = Ложь;
	Элементы.ДекорацияПодключитьТелеграм.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
		Элементы.ГруппаПроверкаТелеграм.Видимость = Истина;
		
		Если ИдетПроверкаТелефонаУведомленияОшибокРоботовВТелеграм Тогда
			Элементы.ДекорацияИдетПроверкаТелеграм.Видимость = Истина;
		ИначеЕсли ТелефонУведомленияОшибокРоботовЗарегестрированВТелеграм Тогда
			Элементы.ДекорацияРезультатУспехТелеграм.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПодключитьТелеграм.Видимость = Истина;
		КонецЕсли;
	Иначе
		Элементы.ГруппаПроверкаТелеграм.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграм()
	
	ИдетПроверкаТелефонаУведомленияОшибокРоботовВТелеграм = Истина;
	ПодключитьОбработчикОжидания("ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграмВФоне", 0.1, Истина);
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграмВФоне()
	
	ТелефонУведомленияОшибокРоботовЗарегестрированВТелеграм = ПроверитьРегистрациюТелеграмНаСервере(Объект.ТелефонУведомленияОшибокРоботов);
	ИдетПроверкаТелефонаУведомленияОшибокРоботовВТелеграм = Ложь;
	ОбновитьВидимостьГруппыТелеграм();
	
КонецПроцедуры

