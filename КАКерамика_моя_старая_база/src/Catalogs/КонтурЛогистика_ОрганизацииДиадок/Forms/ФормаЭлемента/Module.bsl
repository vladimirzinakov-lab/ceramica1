Процедура ТелефонУведомленияОшибокРоботовПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
		ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграмВФоне();
	Иначе
		ОбновитьВидимостьГруппыТелеграм();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСсылкуНастроекВебЛогистика(Команда)
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") Тогда
		СсылкаНастройкиВебЛогистики = "https://logist-staging.kontur.ru/" + Объект.ID + "/administrator?mode=counteragent";		
	Иначе
		СсылкаНастройкиВебЛогистики = "https://logist.kontur.ru/" + Объект.ID + "/administrator?mode=counteragent";
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		ЗапуститьПриложение(СсылкаНастройкиВебЛогистики);
	Иначе
		ПерейтиПоНавигационнойСсылке(СсылкаНастройкиВебЛогистики);
	КонецЕсли;
	
КонецПроцедуры

