&НаКлиенте
Процедура ВыбратьBoxID(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Необходимо записать карточку организации");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ИНН) Тогда
		ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
		ПараметрыСообщения.Текст = "Необходимо заполнить ИНН";
		ПараметрыСообщения.ПутьКДанным  = "Объект.ИНН";
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИНН", Объект.ИНН);
	ПараметрыФормы.Вставить("КПП", Объект.КПП);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВыбораПоИННКПП",
		ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ВыбратьBoxIDЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьBoxIDЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОрганизацияСсылка = ЗаполнитьОрганизациюИзДанныхДиадока(Результат, Объект.Ссылка);
	
	Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
		
		Сообщить("Данные организации были обновлены.");
		Прочитать();
		
		ПроверитьСтатусГотовностиКЭПД();
		УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеОднойОрганизации, ОрганизацияКЗаполнению)
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗаполнитьОрганизациюИзДанныхДиадока(ДанныеОднойОрганизации, ОрганизацияКЗаполнению);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСсылкуДДНастройки(Команда)
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") Тогда
		СсылкаДиадок = "https://diadoc-staging.kontur.ru/" + Объект.ID + "/CompanyDetails";		
	Иначе
		СсылкаДиадок = "https://diadoc.kontur.ru/" + Объект.ID + "/CompanyDetails";
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		ЗапуститьПриложение(СсылкаДиадок);
	Иначе
		ПерейтиПоНавигационнойСсылке(СсылкаДиадок);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыДинСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекСтрока = Элемент.ТекущиеДанные;
	КонтрагентСсылка =  ТекСтрока.Контрагент;
	
	Если Поле.Имя = "КонтрагентыДинСписокКонтрагент" 
		Или Поле.Имя = "КонтрагентыДинСписокОрганизацииВБазе"
		Или Поле.Имя = "КонтрагентыДинСписокТребуемоеДействие" Тогда 
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента", 
			Новый Структура("Ключ", КонтрагентСсылка), 
			ЭтаФорма,
			ЭтаФорма,
			"ОбработчикПослеСопоставленияКонтрагентов");
			
	ИначеЕсли Поле.Имя = "КонтрагентыДинСписокСтатус" Тогда
		
		ПараметрыФормы = Новый Структура("Отправитель, Получатель", Объект.Ссылка, ТекСтрока.Контрагент);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
				"ОбщаяФорма.КонтурЛогистика_ФормаДружбыКонтрагентов",
				Параметрыформы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактыПолучателейУведомленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.КонтактыПолучателейУведомлений.ТекущиеДанные;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контекст", Объект.Ссылка);
	ПараметрыОткрытия.Вставить("ТипКонтакта", ТекущиеДанные.Тип);
	ПараметрыОткрытия.Вставить("ЗначениеКонтакта", ТекущиеДанные.Контакт);
	ПараметрыОткрытия.Вставить("ТрНЗамечанияОтВодителя", ТекущиеДанные.ТрНЗамечанияОтВодителя);
	ПараметрыОткрытия.Вставить("ТрНЗамечанияОтПеревозчика", ТекущиеДанные.ТрНЗамечанияОтПеревозчика);
	ПараметрыОткрытия.Вставить("ТрНОтказПВ", ТекущиеДанные.ТрНОтказПВ);
	ПараметрыОткрытия.Вставить("ТрНОтказГП", ТекущиеДанные.ТрНОтказГП);
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПунктыМаршрута.Форма.ФормаВыбораКонтакта";
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ИзменениеКонтактнойИнформацииЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

