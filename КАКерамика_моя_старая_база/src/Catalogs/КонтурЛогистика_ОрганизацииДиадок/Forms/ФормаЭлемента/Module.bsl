Процедура УдалитьНастройку_(Команда)
	
	ТекущиеДанные = Элементы.НастройкиДинСписок.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	текНастройка = ТекущиеДанные.Настройка;
	УдалитьНастройкуОрганизации(текНастройка);
	
	Элементы.НастройкиДинСписок.Обновить();
	
КонецПроцедуры

