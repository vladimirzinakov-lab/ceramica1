&НаКлиенте
Процедура СоздатьНаОсновании(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед добавлением необходимо сохранить");
		Возврат;
	КонецЕсли;
			
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_НастройкиКонвертацииСправочников.Форма.ФормаВыбора";
	НаправлениеКонвертации = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НаправлениеКонвертации.Входящее");
	ИмяТипаСправочника = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоСсылкеНаДокумент(Объект.Ссылка);
	
	ЗначениеОтбора = Новый Структура("НаправлениеКонвертации, ТипСправочникаЛогистика", НаправлениеКонвертации, ИмяТипаСправочника); 
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"СоздатьНаОснованииНачалоВыбораЗавершение", Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОснованииНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат = Неопределено Тогда
		Сообщить("Не выбрана настройка конвертации справочника");
		Возврат;
	КонецЕсли;
	
	НастройкаКонвертацииСправочника = Результат;
	КонтурЛогистика_КонвертацияКлиент.КонвертироватьОбъектСправочникаЛогистикиВОбъектУС(ЭтаФорма, НастройкаКонвертацииСправочника);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКСлужебным(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура;  
	Отбор = Новый Структура;  
	Отбор.Вставить("ОрганизацияДиадок", Объект.Ссылка);  
	ПараметрыОткрытияФормы.Вставить("Отбор", Отбор);  
	ОткрытьФорму("РегистрСведений.КонтурЛогистика_НастройкиОрганизацийСлужебные.ФормаСписка", ПараметрыОткрытияФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыДОТрНИзЛогистики(Команда)
	
	КоличествоОбновленныхДокументов = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОбновитьСтатусыДокументооборотаСпсиком(Объект.Ссылка);
	
	ПараметрыСообщения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПараметрыСообщения();
	ПараметрыСообщения.Текст = "Обновлен статус документов: " + Формат(КоличествоОбновленныхДокументов, "ЧДЦ=0; ЧН=0");
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПоказатьСообщение(ПараметрыСообщения);
	
КонецПроцедуры

#Область Авторизация

&НаСервере
Процедура ОбновитьПризнакАвторизацииНаПортале()
	
	АвторизацияВыполнена = Ложь;
	
	Если Не АвторизацияПоOIDC Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииПоОрганизации(Объект.Ссылка);
	Если ЗначениеЗаполнено(ДанныеАутентификации.ТокенДоступа) Тогда
		АвторизацияВыполнена = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвторизациюНаПорталеПриОткрытии()
	
	ВыполнитьАвторизациюНаПортале();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвторизациюНаПортале(ПриУстановкеПризнакаНаш = Ложь)
	
	ДополнительныеПараметры = Новый Структура;
	Если ПриУстановкеПризнакаНаш Тогда
		ДополнительныеПараметры.Вставить("ПриУстановкеПризнакаНаш");
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеАутентификации", ЭтаФорма, ДополнительныеПараметры);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ВыполнитьАвторизациюНаПортале(
		ЭтаФорма, Объект.Ссылка, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеАутентификации(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьПризнакАвторизацииНаПортале();
	
	Если ДополнительныеПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ПриУстановкеПризнакаНаш") Тогда
		ОбработатьПриВключенииНаш();
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ПриИзменитьРоли") И АвторизацияВыполнена Тогда
		ОткрытьФормуРедактированияРолей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьАвторизациюНаПортале()
	
	КонтурЛогистика_ОбщегоНазначенияСервер.УдалитьСессиюАутентификацииПоОрганизации(Объект.Ссылка);
	
	ИнициализироватьСервисФизическихЛиц();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьГруппыРолей(Форма)
	
	Форма.Элементы.ГруппаРеестрЭкспедиторов.Видимость = Форма.Объект.Экспедитор;
	
	ИспользуетсяПутевойЛист = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПутевойЛист");
	ИспользуетсяПутевойЛист_5_02 = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПутевойЛист_5_02");
	ИспользуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяТРН");
	ИспользуетсяПоручениеЭкспедитору = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПоручениеЭкспедитору");
	ИспользуетсяЭкспедиторскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяЭкспедиторскаяРасписка");
	ИспользуетсяСкладскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяСкладскаяРасписка");
	ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяЗаказЗаявка");
	ДействуетФорматЭПЛ502 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДействуетФорматЭПЛ502();
	
	Форма.Элементы.ГруппаПредставлениеРолейОсновных.Видимость =
		(ИспользуетсяТРН
			Или ИспользуетсяПоручениеЭкспедитору
			Или ИспользуетсяЭкспедиторскаяРасписка
			Или ИспользуетсяСкладскаяРасписка
			Или ИспользуетсяЗаказЗаявка);
	Форма.Элементы.ГруппаПредставлениеРолейПЛ.Видимость =
		(ИспользуетсяПутевойЛист Или ИспользуетсяПутевойЛист_5_02);
	
	// Обновим описание ролей
	ПереченьРолей = Новый Массив;
	Если Форма.Объект.Экспедитор Тогда
		ПереченьРолей.Добавить("Экспедитор");
	КонецЕсли;
	Если Форма.Объект.Грузоотправитель Тогда
		ПереченьРолей.Добавить("Грузоотправитель");
	КонецЕсли;
	Если Форма.Объект.Перевозчик Тогда
		ПереченьРолей.Добавить("Перевозчик");
	КонецЕсли;
	Если Форма.Объект.Грузополучатель Тогда
		ПереченьРолей.Добавить("Грузополучатель");
	КонецЕсли;
	Форма.ПредставлениеРолейОсновных = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(ПереченьРолей, ", ");
	Если Не ЗначениеЗаполнено(Форма.ПредставлениеРолейОсновных) Тогда
		Форма.ПредставлениеРолейОсновных = "<не выбраны>";
	КонецЕсли;
	
	ПереченьРолей = Новый Массив;
	Если Форма.Объект.Оформитель Тогда
		ПереченьРолей.Добавить("Оформитель");
	КонецЕсли;
	Если Форма.Объект.Медик Тогда
		ПереченьРолей.Добавить("Медик");
	КонецЕсли;
	Если Не ДействуетФорматЭПЛ502 И Форма.Объект.ТехОсмотр Тогда
		ПереченьРолей.Добавить("Тех. осмотр");
	КонецЕсли;
	Если Не ДействуетФорматЭПЛ502 И Форма.Объект.Одометр Тогда
		ПереченьРолей.Добавить("Одометр");
	КонецЕсли;
	Форма.ПредставлениеРолейПЛ = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(ПереченьРолей, ", ");
	Если Не ЗначениеЗаполнено(Форма.ПредставлениеРолейПЛ) Тогда
		Форма.ПредставлениеРолейПЛ = "<не выбраны>";
	КонецЕсли;
	
	Форма.Элементы.МедЛицензияПоУмолчанию.Видимость = Форма.Объект.Наш И Форма.Объект.Медик;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРоли(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Необходимо записать организацию");
		Возврат;
	КонецЕсли;
	
	Если АвторизацияПоOIDC И Объект.Наш И Не АвторизацияВыполнена Тогда
		// Откроем авторизацию
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПриИзменитьРоли");
		
		Оповещение = Новый ОписаниеОповещения("ПослеАутентификации", ЭтаФорма, ДополнительныеПараметры);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ВыполнитьАвторизациюНаПортале(
			ЭтаФорма, Объект.Ссылка, Оповещение);
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуРедактированияРолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияРолей()
	
	РолиОрганизации = Новый Структура;
	Для Каждого ИмяРоли Из ВсеРоли() Цикл
		РолиОрганизации.Вставить(ИмяРоли, Объект[ИмяРоли]);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Ссылка);
	ПараметрыФормы.Вставить("РолиОрганизации", РолиОрганизации);
	ПараметрыФормы.Вставить("Метрики_Категоря", "Организация Диадока");
	ПараметрыФормы.Вставить("Метрики_МестоВызова", ЭтаФорма.ИмяФормы);
	ПараметрыФормы.Вставить("Метрики_Действие", "Выбор роли");
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаРедактированияРолей", ПараметрыФормы, ЭтаФорма,
		ЭтаФорма, "РедактированияРолейЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированияРолейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяРоли Из ВсеРоли() Цикл
		Результат.Свойство(ИмяРоли, Объект[ИмяРоли]);
	КонецЦикла;
	
	Модифицированность = Истина;
	
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВсеРоли()
	
	Возврат Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеРоли();
	
КонецФункции

#КонецОбласти

#Область ФильтрПоИнфоПолям

&НаКлиенте
Процедура ФильтрПоИнфоПолямКодомПриИзменении(Элемент)
	
	ТребуетсяОбновитьПовторноИспользуемыеЗначения = Истина;
	
	ОбновитьВидимостьФильтраПоИнфоПолям();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьФильтраПоИнфоПолям()
	
	Элементы.ГруппаФильтрПоИнфоПолямМаппинг.Видимость = Не Объект.ФильтрПоИнфоПолямКодом;
	Элементы.ГруппаФильтрПоИнфоПолямКодом.Видимость = Объект.ФильтрПоИнфоПолямКодом;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоИнфоПолямКодомВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ФильтрПоИнфоПолямВыражениеВычисления) Тогда
		// Добавим пример
		Объект.ФильтрПоИнфоПолямВыражениеВычисления =
		"//Пример:
		|//Доступны: Организация (ссылка) и ИнфоПоля (соответствие).
		|//Для Каждого ТекущееПоле Из ИнфоПоля Цикл
		|//	Если ТекущееПоле.Ключ = ""НомерПодразделения"" И ТекущееПоле.Значение = ""13"" Тогда
		|//		РезультатВычисления = Истина;
		|//		Прервать;
		|//	КонецЕсли;
		|//КонецЦикла;";
	КонецЕсли;
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОткрытьФормуРедактированияТекста(
		Объект.ФильтрПоИнфоПолямВыражениеВычисления, Объект, "ФильтрПоИнфоПолямВыражениеВычисления");
	
	ТребуетсяОбновитьПовторноИспользуемыеЗначения = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоИнфоПолямВыражениеВычисленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		УспешнаяЗапись = ЭтаФорма.Записать();
		Если Не УспешнаяЗапись Тогда 
			Сообщить("Не удалось записать настройку. Запишите вручную, затем переходите к настройке.");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ФильтрПоИнфоПолям.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СпособМаппинга) Тогда
		ТекущиеДанные.СпособМаппинга = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СпособыМаппингаПоля.ФиксированноеЗначение");
	КонецЕсли;
	
	ПараметрыФормыНастройки = Новый Структура(
		"ВыражениеВычисления, ВыражениеВычисления2, ВыражениеВычисленияСтрокаНеогр, ИмяНастраиваемогоПоля, СвойствоОбъекта,
		|КлючДопСвойстваРеквизита, НастройкаКонвертации, СпособМаппинга, ИмяТабЧастьТовары, ПутьКоллекцияТабЧастьТовары,
		|ПутьКоллекцияТабЧастьТоварыИмяРеквизитаТЧ");
	ПараметрыФормыНастройки.Вставить("ИмяНастраиваемогоПоля", ТекущиеДанные.Ключ);
	
	ПараметрыФормыНастройки.Вставить("НастройкаКонвертации",
		ПредопределенноеЗначение("Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка"));
	ПараметрыФормыНастройки.Вставить("СпособМаппинга", ТекущиеДанные.СпособМаппинга);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисления", ТекущиеДанные.ВыражениеВычисления);
	ПараметрыФормыНастройки.Вставить("ВыражениеВычисленияСтрокаНеогр", ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр);
	ПараметрыФормыНастройки.Вставить("НастройкаИнфоПолей");
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"ОбщаяФорма.КонтурЛогистика_НастойкиКонвертации_Помощник", ПараметрыФормыНастройки,
		ЭтаФорма, ЭтаФорма, "ОбработчикРедактированиеСтрокиВДопФорме", "ФильтрПоИнфоПолям");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикРедактированиеСтрокиВДопФорме(ВыбранноеЗначение = Неопределено, ИмяЭлемента = Неопределено) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено
		И ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
		И ИмяЭлемента <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		ТекущиеДанные = Элементы[ИмяЭлемента].ТекущиеДанные;
		ТекущиеДанные.СпособМаппинга = ВыбранноеЗначение.СпособМаппинга;
		ТекущиеДанные.ВыражениеВычисления = ВыбранноеЗначение.ВыражениеВычисления;
		ТекущиеДанные.ВыражениеВычисленияСтрокаНеогр = ВыбранноеЗначение.ВыражениеВычисленияСтрокаНеогр;
		
		ТребуетсяОбновитьПовторноИспользуемыеЗначения = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтключениеЧтенияЛенты

&НаКлиенте
Процедура ЧитатьЛентуДиадокФлажекВклВыклНажатие(Элемент)
	
	ЧитатьЛентуДиадок = Не ЧитатьЛентуДиадок;
	
	ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяЗаказЗаявка");
	ИспользуетсяПоручениеЭкспедитору = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПоручениеЭкспедитору");
	ИспользуетсяЭкспедиторскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяЭкспедиторскаяРасписка");
	ИспользуетсяСкладскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ИспользуетсяСкладскаяРасписка");
	
	Если Не ЧитатьЛентуДиадок И
		(ИспользуетсяЗаказЗаявка Или ИспользуетсяПоручениеЭкспедитору Или ИспользуетсяЭкспедиторскаяРасписка Или ИспользуетсяСкладскаяРасписка) Тогда
		
		ТекстВопроса = ТекстВопросаДляВыключенияЧтенияЛентыСобытийДиадок(
			ИспользуетсяЗаказЗаявка, ИспользуетсяПоручениеЭкспедитору, ИспользуетсяЭкспедиторскаяРасписка, ИспользуетсяСкладскаяРасписка);
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, РежимДиалогаВопрос.ДаНет,
			,, ЭтаФорма,
			"ВыключениеНастройкиЧитатьЛентуДиадокЗавершение");
	Иначе
	
		УстановитьЗначениеНастройкиЧитатьЛентуДиадок();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстВопросаДляВыключенияЧтенияЛентыСобытийДиадок(ИспользуетсяЗаказЗаявка, ИспользуетсяПоручениеЭкспедитору, ИспользуетсяЭкспедиторскаяРасписка, ИспользуетсяСкладскаяРасписка)
	
	ТекстВопроса = "";
	
	Если ИспользуетсяЗаказЗаявка И ИспользуетсяЭкспедиторскаяРасписка И ИспользуетсяПоручениеЭкспедитору И ИспользуетсяСкладскаяРасписка Тогда
		ТекстВопроса = "В модуле используются документы Заказ (заявка) и Экспедиторские документы.";
	ИначеЕсли ИспользуетсяЗаказЗаявка И Не ИспользуетсяЭкспедиторскаяРасписка И Не ИспользуетсяПоручениеЭкспедитору И Не ИспользуетсяСкладскаяРасписка Тогда
		ТекстВопроса = "В модуле используется документ Заказ (заявка).";
	ИначеЕсли Не ИспользуетсяЗаказЗаявка И (ИспользуетсяЭкспедиторскаяРасписка Или ИспользуетсяПоручениеЭкспедитору Или ИспользуетсяСкладскаяРасписка) Тогда
		ТекстВопроса = "В модуле используется документ Экспедиторские документы.";
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + " "
		+ "Обновление статусов документов происходит только через ленту Диадок.
		|После выключения настройки статусы документов обновляться не будут. Выключить настройку?";
	
	Возврат ТекстВопроса;
	
КонецФункции

&НаКлиенте
Процедура ВыключениеНастройкиЧитатьЛентуДиадокЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ЧитатьЛентуДиадок = Не ЧитатьЛентуДиадок;
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеНастройкиЧитатьЛентуДиадок();		
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеНастройкиЧитатьЛентуДиадок()
		
	УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок"), ЧитатьЛентуДиадок);
			
	Если ЧитатьЛентуДиадок И ЗначениеЗаполнено(АктуальностьЛентыСобытийДиадокДата) Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазницаВДнях(НачалоДня(ТекущаяДата()), НачалоДня(АктуальностьЛентыСобытийДиадокДата)) > 14 Тогда
			УстановитьЗначениеНастройкиСервер(
				Объект.Ссылка, ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата"), НачалоДня(ТекущаяДата()));
		КонецЕсли;
		
	КонецЕсли;
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();	
	ОбновитьВидимостьДоступностьГраниц();
			
КонецПроцедуры

&НаКлиенте
Процедура ЧитатьЛентуЛогистикиФлажекВклВыклНажатие(Элемент)
			
	ЧитатьЛентуЛогистики = Не ЧитатьЛентуЛогистики;
	ЕстьКлючАПИЛогистики = ЕстьКлючАПИЛогистики();
	
	ИспользуетсяПутевойЛист_5_02 = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПутевойЛист_5_02");
	
	Если ЧитатьЛентуЛогистики И Не АвторизацияПоOIDC И Не ЕстьКлючАПИЛогистики Тогда
		
		ПараметрыФормы = Новый Структура("КлючАПИ", "");
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВводаАпиКлюча", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"ИзменениеНастройкиКлючАПИПриУстановкеЧтенияЛентыЛогистики",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		
	КонецЕсли;
	
	Если ИспользуетсяПутевойЛист_5_02 И Не ЧитатьЛентуЛогистики Тогда
		ТекстВопроса = "В модуле используется документ Электронный путевой лист (ф. 5.02). Получение входящего черновика титула 1"
			+ " происходит через ленту Логистики. После выключения настройки входящий черновик загружаться не будет. Выключить настройку?";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, РежимДиалогаВопрос.ДаНет,
			,, ЭтаФорма,
			"ВыключениеНастройкиЧитатьЛентуЛогистикиЗавершение");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыключениеНастройкиЧитатьЛентуЛогистикиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ЧитатьЛентуЛогистики = Не ЧитатьЛентуЛогистики;
	КонецЕсли;
			
	УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеНастройкиЧитатьЛентуЛогистики()
		
	УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики"), ЧитатьЛентуЛогистики);
		
	ДатаГраницыСинхронизацииЛогистика = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"));
	
	Если ЧитатьЛентуЛогистики И ЗначениеЗаполнено(ДатаГраницыСинхронизацииЛогистика) Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазницаВДнях(НачалоДня(ТекущаяДата()), НачалоДня(АктуальностьЛентыСобытийДиадокДата)) > 14 Тогда
			УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"), НачалоДня(ТекущаяДата()));
			УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий"), "");	
		КонецЕсли;
		
	КонецЕсли;
	
	Записать();
		
	Элементы.НастройкиДинСписок.Обновить();		
	ОбновитьВидимостьДоступностьГраниц();
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеНастройкиКлючАПИПриУстановкеЧтенияЛентыЛогистики(НовоеЗначение, ДополнительныеПараметры) Экспорт
	
	Если НовоеЗначение = Неопределено Тогда
		ЧитатьЛентуЛогистики = Не ЧитатьЛентуЛогистики;
		ОбновитьВидимостьДоступностьГраниц();
	Иначе		
			
		УстановитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"), НовоеЗначение);
		УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		 		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеОбъектыПослеУдаления(Элемент)
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#Область СервисФизическихЛиц

&НаСервере
Процедура ИнициализироватьСервисФизическихЛиц()
	
	ДоступенСервисФизЛиц = КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступенСервисФизЛиц(Объект.Ссылка);
	
	ОтборФизическиеЛица = "Все";
	ФизическиеЛица.Параметры.УстановитьЗначениеПараметра("Организация", Объект.Ссылка);
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИПараметрыФизическихЛиц()

	Если ЗначениеЗаполнено(Объект.Ссылка) И ДоступенСервисФизЛиц Тогда
		Элементы.СтраницаФизическиеЛица.Видимость = Истина;
	Иначе
		Элементы.СтраницаФизическиеЛица.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	МастерДанныеСотрудников = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МастерДанныеСотрудников");
	Если МастерДанныеСотрудников = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_МастерДанныеСотрудников.Модуль1с") Тогда
		Элементы.ОткрытьНастройкуМастерДанные.Заголовок = "Источник данных: 1С";
		Элементы.СинхронизироватьФизическиеЛица.Заголовок = "Выгрузить всех в сервис";
	Иначе
		Элементы.ОткрытьНастройкуМастерДанные.Заголовок = "Источник данных: сервис";
		Элементы.СинхронизироватьФизическиеЛица.Заголовок = "Обновить всех из сервиса";
	КонецЕсли;
	
	Элементы.ФизическиеЛицаПроверитьПриглашения.Видимость = КонтурЛогистика_СервисФизическихЛицСервер.ЕстьНепринятыеПриглашения(, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФизическоеЛицо(Команда)
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Добавление сотрудника", "Добавить сотрудника", "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента", "Организация");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Ссылка);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("РегистрСведений.КонтурЛогистика_СервисФизическихЛиц.Форма.ФормаОтправкиПриглашения", 
		ПараметрыФормы, ЭтаФорма, ЭтаФорма, "ОбработчикОтправкиПриглашения");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОтправкиПриглашения(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.ФизическиеЛица.Обновить();
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборФизическиеЛицаПриИзменении(Элемент)
	
	ФизическиеЛица.Отбор.Элементы.Очистить();
	
	Если ОтборФизическиеЛица = "НеПринятые" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "Статус",
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборФизическиеЛица = "Ошибка" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "ЕстьОшибка",
			Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборФизическиеЛица = "ЕстьРасхождения" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "ЕстьРасхождения",
			Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ИначеЕсли ОтборФизическиеЛица = "Удалены" Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ФизическиеЛица, "Статус",
			ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыФизическихЛиц.Удалено"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьФизическиеЛица(Команда)
	
	ПараметрыФоновогоЗадания = Новый Структура;
	ПараметрыФоновогоЗадания.Вставить("Организация", Объект.Ссылка);
	
	Прогресс = Новый Структура("ПорядковыйНомер, Колво", 0, 0);
	
	МастерДанныеСотрудников = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МастерДанныеСотрудников");
	Если МастерДанныеСотрудников = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_МастерДанныеСотрудников.Модуль1с") Тогда
		
		АдресПрогрессаВыгрузкиСотрудниковВСервис = ПоместитьВоВременноеХранилище(Прогресс, ЭтаФорма.УникальныйИдентификатор);
		
		ПараметрыФоновогоЗадания.Вставить("АдресПрогресса", АдресПрогрессаВыгрузкиСотрудниковВСервис);
		
		РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.ВыгрузитьСотрудниковВСервисФизическихЛиц",
			ПараметрыФоновогоЗадания,
			"КлючФЗ_ВыгрузитьСотрудниковВСервисФизическихЛиц",
			"Выгрузить сотрудник в сервис физических лиц");
			
		Сообщить("Выполняется выгрузка сотрудников в сервис");
			
		Если РезультатЗапуска.Статус = "Выполняется" Тогда
			
			ИдентификаторФЗ_ВыгрузитьСотрудниковВСервис = РезультатЗапуска.ИдентификаторЗадания;
			
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц", 0.1, Истина);
			
		ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
			
			ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц();
			
		КонецЕсли;
		
	Иначе
		
		АдресПрогрессаЗагрузкиСотрудниковИзСервиса = ПоместитьВоВременноеХранилище(Прогресс, ЭтаФорма.УникальныйИдентификатор);

		ПараметрыФоновогоЗадания.Вставить("АдресПрогресса", АдресПрогрессаЗагрузкиСотрудниковИзСервиса);
			
		РезультатЗапуска = КонтурЛогистика_ДлительныеОперацииКлиент.ЗапуститьФоновоеЗадание(
			"КонтурЛогистика_ДлительныеОперацииСервер.ЗагрузитьСотрудниковИзСервисаФизическихЛиц",
			ПараметрыФоновогоЗадания,
			"КлючФЗ_ЗагрузитьСотрудниковИзСервисаФизическихЛиц",
			"Загрузить сотрудников из сервиса физических лиц");
			
		Сообщить("Выполняется обновление сотрудников из сервиса");
			
		Если РезультатЗапуска.Статус = "Выполняется" Тогда
			
			ИдентификаторФЗ_ЗагрузитьСотрудниковИзСервиса = РезультатЗапуска.ИдентификаторЗадания;
			
			ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеЗагрузкиСотрудниковИзСервисаФизическихЛиц", 0.1, Истина);
			
		ИначеЕсли РезультатЗапуска.Статус = "Выполнено" Тогда
			
			ПроверитьФоновоеЗаданиеЗагрузкиСотрудниковИзСервисаФизическихЛиц();
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьИПараметрыФизическихЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц() Экспорт
	
	ИнтервалОбработчикаОжидания = 1;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ВыгрузитьСотрудниковВСервис, Элементы.ЛоадерВыполнитьОбмен);
	
	Если ЗаданиеЕщеВыполняется Тогда 
		
		Прогресс = ПолучитьИзВременногоХранилища(АдресПрогрессаВыгрузкиСотрудниковВСервис);
		
		Если ТипЗнч(Прогресс) = Тип("Структура") И Прогресс.Свойство("КолВо") И Прогресс.КолВо > 0 Тогда
			Пояснение = ?(ЗначениеЗаполнено(Прогресс.Сотрудник), Строка(Прогресс.ПорядковыйНомер) + " " + СокрЛП(Прогресс.Сотрудник), "");
			Состояние("Выполняется выгрузка сотрудников", Прогресс.ПорядковыйНомер / Прогресс.КолВо * 100, Пояснение);
			Элементы.ФизическиеЛица.Обновить();
		Иначе
			Состояние("Выполняется выгрузка сотрудников",);	
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеВыгрузкиСотрудниковВСервисФизическихЛиц", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		Элементы.ФизическиеЛица.Обновить();
		
		Результат = ПолучитьИзВременногоХранилища(АдресПрогрессаВыгрузкиСотрудниковВСервис);
		
		Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("ТекстОшибки") Тогда
			Сообщить(Результат.ТекстОшибки);	
		Иначе
			Сообщить("Выгрузка сотрудников в сервис выполнена");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФоновоеЗаданиеЗагрузкиСотрудниковИзСервисаФизическихЛиц() Экспорт
	
	ИнтервалОбработчикаОжидания = 1;
	
	ЗаданиеЕщеВыполняется = КонтурЛогистика_ДлительныеОперацииКлиент.ОбработчикСлеженияЗаФЗ(
		ИдентификаторФЗ_ЗагрузитьСотрудниковИзСервиса, Элементы.ЛоадерВыполнитьОбмен);
	
	Если ЗаданиеЕщеВыполняется Тогда 
		
		Прогресс = ПолучитьИзВременногоХранилища(АдресПрогрессаЗагрузкиСотрудниковИзСервиса);
		
		Если ТипЗнч(Прогресс) = Тип("Структура") И Прогресс.Свойство("КолВо") И Прогресс.КолВо > 0 Тогда
			Пояснение = ?(ЗначениеЗаполнено(Прогресс.Сотрудник), Строка(Прогресс.ПорядковыйНомер) + СокрЛП(Прогресс.Сотрудник), "");
			Состояние("Выполняется загрузка и обновление сотрудников", Прогресс.ПорядковыйНомер / Прогресс.КолВо * 100, Пояснение);
			Элементы.ФизическиеЛица.Обновить();
		Иначе
			Состояние("Выполняется загрузка и обновление сотрудников");
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ПроверитьФоновоеЗаданиеЗагрузкиСотрудниковИзСервисаФизическихЛиц", ИнтервалОбработчикаОжидания, Истина);
		
	Иначе
		
		Элементы.ФизическиеЛица.Обновить();
		
		Результат = ПолучитьИзВременногоХранилища(АдресПрогрессаЗагрузкиСотрудниковИзСервиса);
		
		Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("ТекстОшибки") Тогда
			Сообщить(Результат.ТекстОшибки);	
		Иначе
			Сообщить("Обновление сотрудников из сервиса выполнено");
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФизическиеЛицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Необходимо записать сотрудника");
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ФизическиеЛица.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ, ТекущийЭлемент", ТекущиеДанные.Сотрудник, "ФизическиеЛица");
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаЭлемента", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуМастерДанные(Команда)
	
	НастройкаМастерДанныеСотрудников = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьОбщуюНастройку("МастерДанныеСотрудников");
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(НастройкаМастерДанныеСотрудников);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПриглашения(Команда)
	
	КонтурЛогистика_СервисФизическихЛицСервер.ПроверитьПриглашения(Объект.Ссылка);
	
	Элементы.ФизическиеЛица.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнструкцияДобавитьСотрудникаВСервис(Команда)
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя("Открытие инструкции", "Нажать на гиперссылку", 
		"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента", "Добавление инструкции в карточке организации");
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		ЗапуститьПриложение("https://support.kontur.ru/logistika-1s/56876-rabota_s_sotrudnikami");
	Иначе
		ПерейтиПоНавигационнойСсылке("https://support.kontur.ru/logistika-1s/56876-rabota_s_sotrudnikami");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРасхожденияСотрудников(Команда)
	
	КонтурЛогистика_СервисФизическихЛицСервер.ОбновитьФизическиеЛицаСотрудников(Объект.Ссылка);
	
	Элементы.ФизическиеЛица.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область РеквизитыПоУмолчанию

&НаКлиенте
Процедура ТранспортноеСредствоПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
			
	ПараметрыФормы = Новый Структура("ОтборЭтоТС", Истина);
	ДополнительныеПараметры = Новый Структура("Реквизит", "ТранспортноеСредствоПоУмолчанию");
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_ТранспортныеСредства.Форма.ФормаВыбора", ПараметрыФормы, 
		ЭтаФорма, ЭтаФорма, "ОбработчикВыбораРеквизитаПоУмолчанию", ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
			
	ПараметрыФормы = Новый Структура("ОтборРоль", "Водители");
	ДополнительныеПараметры = Новый Структура("Реквизит", "ВодительПоУмолчанию");
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаВыбора", ПараметрыФормы, 
		ЭтаФорма, ЭтаФорма, "ОбработчикВыбораРеквизитаПоУмолчанию", ДополнительныеПараметры); 
	
КонецПроцедуры

&НаКлиенте
Процедура Водитель2ПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ПараметрыФормы = Новый Структура("ОтборРоль", "Водители");
	ДополнительныеПараметры = Новый Структура("Реквизит", "Водитель2ПоУмолчанию");
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Справочник.КонтурЛогистика_Сотрудники.Форма.ФормаВыбора", ПараметрыФормы, 
		ЭтаФорма, ЭтаФорма, "ОбработчикВыбораРеквизитаПоУмолчанию", ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораРеквизитаПоУмолчанию(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено
		И ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Реквизит") Тогда
		Объект[ДополнительныеПараметры.Реквизит] = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КонтактнаяИнформация

&НаСервере
Процедура СформироватьЭлементыКонтактнойИнформации()
	
	ОписаниеРеквизитовИнформации = Новый Структура;
	
	// Достанем описание из объекта
	ДобавитьОпсаниеРеквизита(ОписаниеРеквизитовИнформации, "Телефон");
	ДобавитьОпсаниеРеквизита(ОписаниеРеквизитовИнформации, "ЭлектроннаяПочта");
	ДобавитьОпсаниеРеквизита(ОписаниеРеквизитовИнформации, "Иной");
	
	СоздатьРеквизитыИЭлементыФормы(ОписаниеРеквизитовИнформации);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыИЭлементыФормы(ОписаниеРеквизитовИнформации)
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовИнформации Цикл
		РеквизитыКИ.Добавить(ОписаниеРеквизита.Ключ);
	КонецЦикла;
	
	// Создадим реквизиты формы
	СоздатьРеквизитыФормыПоОписанию(ОписаниеРеквизитовИнформации);
	
	// Заполним значения реквизитов
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовИнформации Цикл
		ЭтаФорма[ОписаниеРеквизита.Ключ] = ОписаниеРеквизита.Значение;
	КонецЦикла;
	
	// Создадим элементы формы
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовИнформации Цикл
		СоздатьРеквизитФормы(ОписаниеРеквизита);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОпсаниеРеквизита(ОписаниеРеквизитовИнформации, ИмяВидаКИ)
	
	Префикс = "КИ_" + ИмяВидаКИ + "_";
	
	ВидКИ = Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации[ИмяВидаКИ];
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ВидКонтактнойИнформации", ВидКИ);
	
	НайденныеСтроки = Объект.КонтактнаяИнформация.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 Тогда
		ОписаниеРеквизитовИнформации.Вставить(Префикс + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""), "");
	Иначе
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			ОписаниеРеквизитовИнформации.Вставить(Префикс + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""),
				ТекущаяСтрока.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыФормыПоОписанию(ОписаниеРеквизитовИнформации)
	
	ОписаниеТипаСтрока = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.ОписаниеТипаСтрока(255);
	ОписаниеРеквизитов = Новый Структура;
	
	Для Каждого ТекущееОписание Из ОписаниеРеквизитовИнформации Цикл
		ОписаниеРеквизитов.Вставить(ТекущееОписание.Ключ, ОписаниеТипаСтрока);
	КонецЦикла;
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизиты(ЭтаФорма, ОписаниеРеквизитов, Истина);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитФормы(ОписаниеРеквизита)
	
	Если Найти(ОписаниеРеквизита.Ключ, "Телефон") > 0 Тогда
		ГруппаРодитель = Элементы.ГруппаКонтактнаяИнформацияТелефоны;
		ЗаголовокДекарации = "Телефон:";
	ИначеЕсли Найти(ОписаниеРеквизита.Ключ, "ЭлектроннаяПочта") > 0 Тогда
		ГруппаРодитель = Элементы.ГруппаКонтактнаяИнформацияПочта;
		ЗаголовокДекарации = "Электронная почта:";
	Иначе
		ГруппаРодитель = Элементы.ГруппаКонтактнаяИнформацияИное;
		ЗаголовокДекарации = "Другое:";
	КонецЕсли;
	
	Для Каждого ТекущийЭлемент Из Элементы Цикл
		Если ТекущийЭлемент.Родитель = ГруппаРодитель
			И Прав(ТекущийЭлемент.Имя, 20) <> "РасширеннаяПодсказка" Тогда
			
			ЗаголовокДекарации = " ";
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Группа
	ИмяГруппы = "ГруппаКонтактнаяИнформация_" + ОписаниеРеквизита.Ключ;
	Горизонтальная = 3;
	ТекущаяГруппа = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(
		ЭтаФорма, ИмяГруппы, ГруппаРодитель, Горизонтальная);
	
	// Декарация
	ИмяДекорации = "Декорация_" + ОписаниеРеквизита.Ключ;
	РастягиватьПоГоризонтали = Ложь;
	НоваяДекарация = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздДекорацияНадпись(
		ЭтаФорма, ИмяДекорации, ТекущаяГруппа, ЗаголовокДекарации, РастягиватьПоГоризонтали);
	НоваяДекарация.Ширина = 16;
	
	// Поле ввода
	ИмяПоля = "ПолеВвода_" + ОписаниеРеквизита.Ключ;
	ВидПолеВвода = 1;
	
	СвойстваПоля = Новый Структура;
	СвойстваПоля.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздПоле(
		ЭтаФорма, ИмяПоля, ТекущаяГруппа,, ВидПолеВвода, ОписаниеРеквизита.Ключ, СвойстваПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияДобавитьПолеВводаЗавершение(ИмяВидаКИ) Экспорт
	
	ИмяРеквизита = "КИ_" + ИмяВидаКИ + "_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	
	ОписаниеРеквизитовИнформации = Новый Структура;
	ОписаниеРеквизитовИнформации.Вставить(ИмяРеквизита, "");
	
	СоздатьРеквизитыИЭлементыФормы(ОписаниеРеквизитовИнформации);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТелефон(Команда)
	
	КонтактнаяИнформацияДобавитьПолеВводаЗавершение("Телефон");
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДругое(Команда)
	
	КонтактнаяИнформацияДобавитьПолеВводаЗавершение("Иной");
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭлектроннуюПочту(Команда)
	
	КонтактнаяИнформацияДобавитьПолеВводаЗавершение("ЭлектроннаяПочта");
	
КонецПроцедуры

#КонецОбласти

#Область СтатусГотовностиКЭПД

&НаКлиенте
Процедура ПодключитьПроверкуСтатусаГотовностиКЭПД()
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Объект.ИНН)
		И (ЗначениеЗаполнено(Объект.ID)
			Или ЗначениеЗаполнено(Объект.ИдентификаторУчастникаЭДО)) Тогда
		ПодключитьОбработчикОжидания("ОбработчикПроверкиСтатусаГотовностиКЭПД", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВДиадокеСтатусГотовностиКЭПДНажатие(Элемент)
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") = Истина Тогда 
		АдресВебСервиса = "diadoc-staging.kontur.ru";
	Иначе
		АдресВебСервиса = "diadoc.kontur.ru";
	КонецЕсли;
	
	СтрокаШаблона = "https://%1/%2/settings/company?scrollTo=transportEDI";	
	Ссылка = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(СтрокаШаблона, АдресВебСервиса, Объект.ID);
	
	ДопИнформация = Новый Структура("boxId", Объект.ID);
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		"Управление готовностью к ЭПД", "Открыть в Диадоке", "Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаЭлемента",,, ДопИнформация);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПерейтиПоСсылке(Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПроверкиСтатусаГотовностиКЭПД()
	
	ПроверитьСтатусГотовностиКЭПД();
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСтатусГотовностиКЭПД()
	
	Если Не ЗначениеЗаполнено(Объект.ID) Или Не ЗначениеЗаполнено(Объект.ИНН) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПроверкиСтатусаГотовностиКЭПД = "";
	ДействиеПроверкиСтатусаГотовностиКЭПД = "";
	
	Если Объект.СтатусГотовностиКЭПД <> Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.Ready Тогда
						
		ЕстьЯщикиГотовыеКЭПД = ЕстьЯщикиГотовыеКЭПД();
		Если ЕстьЯщикиГотовыеКЭПД Тогда
			
			ДействиеПроверкиСтатусаГотовностиКЭПД = "ВыбратьЯщик";
			Элементы.ВыполнитьДействиеПроверкиСтатусаГотовностиКЭПД.Заголовок = "Заменить";
			ТекстПроверкиСтатусаГотовностиКЭПД = "В выбранном ящике готовность к ЭПД не подтверждена. Работа возможна через другой ящик организации.";
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UndefinedEpdStatus
		Или Объект.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UnknownEpdStatus Тогда
		
		Если Объект.Наш Тогда
			ТекстПроверкиСтатусаГотовностиКЭПД = "Организация не подтвердила готовность к ЭПД. Измените статус с помощью команды ""Изменить в Диадоке"".";				
		Иначе
			ТекстПроверкиСтатусаГотовностиКЭПД = "Организация не подтвердила готовность к ЭПД. Cвяжитесь с контрагентом, чтобы подтвердить готовность."; 
		КонецЕсли;
		
		Если КонтурЛогистика_ОбщегоНазначенияСервер.ВключеныУведомленияОГотовностиКЭПД() 
			И Не Объект.Наш 
			И Не Объект.Роуминговая Тогда
			ДействиеПроверкиСтатусаГотовностиКЭПД = "ОтправитьУведомление";
			Элементы.ВыполнитьДействиеПроверкиСтатусаГотовностиКЭПД.Заголовок = "Отправить уведомление";
		КонецЕсли;
		
	ИначеЕсли Объект.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.NotReady Тогда
		
		Если Объект.Наш Тогда
			ТекстПроверкиСтатусаГотовностиКЭПД = "Организация не готова к ЭПД. Измените статус с помощью команды ""Изменить в Диадоке"".";	
		Иначе
			ТекстПроверкиСтатусаГотовностиКЭПД = "Организация не готова к ЭПД. Cвяжитесь с контрагентом, чтобы подтвердить готовность.";
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЕстьЯщикиГотовыеКЭПД()
	
	ДанныеОрганизаций = КонтурЛогистика_API_Диадок.Диадок_АПИ_GetOrganizationsByInnKpp(Объект.ИНН, Объект.КПП);
	
	Для Каждого ТекущаяСтрока Из ДанныеОрганизаций.Organizations Цикл
				
		Если ТекущаяСтрока.ReadyForEpdStatus = "Ready" Тогда
			
			BoxId = Неопределено;
			Если ТекущаяСтрока.Boxes.Количество() > 1 Тогда
				BoxId = ТекущаяСтрока.Boxes[0].BoxId;
			КонецЕсли;
			
			ОрганизацияГотоваяКЭПД = ОрганизацияГотоваяКЭПД(BoxId);
		
			Если ЗначениеЗаполнено(ОрганизацияГотоваяКЭПД) Тогда
				Продолжить;
			Иначе
				Возврат Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
Конецфункции

&НаСервере
Функция ОрганизацияГотоваяКЭПД(boxId)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ОрганизацииДиадок.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ОрганизацииДиадок КАК КонтурЛогистика_ОрганизацииДиадок
		|ГДЕ
		|	НЕ КонтурЛогистика_ОрганизацииДиадок.ПометкаУдаления
		|	И КонтурЛогистика_ОрганизацииДиадок.ID = &ID		
		|	И КонтурЛогистика_ОрганизацииДиадок.СтатусГотовностиКЭПД = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыГотовностиКЭПД.Ready)";
	
	Запрос.УстановитьПараметр("ID", boxId);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
Конецфункции

&НаКлиенте
Процедура ДействиеПроверкиСтатусаГотовностиКЭПД(Команда)
	
	Если ДействиеПроверкиСтатусаГотовностиКЭПД = "ВыбратьЯщик" Тогда		
		ВыбратьBoxID(Неопределено);
	ИначеЕсли ДействиеПроверкиСтатусаГотовностиКЭПД = "ОтправитьУведомление" Тогда		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Контрагент", Объект.Ссылка);
		ПараметрыФормы.Вставить("ОтправитьУведомлениеПоставитьГотовКЭПД", Истина);
				
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("ОбщаяФорма.КонтурЛогистика_ПриглашениеКОбменуЭПД", ПараметрыФормы, ЭтаФорма);		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВводАдреса

&НаСервере
Процедура ИнициализироватьАдресНаФорме()
	
	КонтурЛогистика_ВводАдреса.ПодготовитьОтображениеАдресаОрганизацииДиадок(Объект);
	АдресСтрокаВвод = Объект.АдресСтрока;
	АдресКодГАРВвод = Объект.АдресКодГАР;
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоАдресРоссииНаСервере(Знач ИнКодСтраны)
	
	Возврат КонтурЛогистика_ВводАдреса.ЭтоСтранаРоссияДляАдреса(ИнКодСтраны);
	
КонецФункции

&НаКлиенте
Процедура ИнКодСтраныПриИзменении(Элемент)
	
	ПриИзмененииСтраныАдресаНаСервере(АдресСтрокаВвод);
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ИдетВыборАдресаИзСписка = Ложь;
	
	Если Не ЭтоАдресРоссииНаСервере(Объект.ИнКодСтраны) Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьПодсказкиАдреса(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ИдетВыборАдресаИзСписка = Истина;
	Попытка
		АдресСтрокаВвод = ВыбранноеЗначение.Подсказка;
		Если ВыбранноеЗначение.Свойство("ЭтоСвободнаяФорма")
			И ВыбранноеЗначение.ЭтоСвободнаяФорма Тогда
			АдресКодГАРВвод = "";
			ПрименитьТекстАдресаНаСервере(ВыбранноеЗначение.Подсказка);
		Иначе
			ПрименитьПодсказкуАдресаНаСервере(ВыбранноеЗначение.ИдентификаторФИАС, ВыбранноеЗначение.Подсказка);
		КонецЕсли;
	Исключение
		ИдетВыборАдресаИзСписка = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресСтрокаПриИзменении(Элемент)
	
	Если ИдетВыборАдресаИзСписка = Истина Тогда
		ИдетВыборАдресаИзСписка = Ложь;
		Возврат;
	КонецЕсли;
	
	АдресКодГАРВвод = "";
	Элементы.ДекорацияТипАдреса.Заголовок = "";
	ПрименитьТекстАдресаНаСервере(АдресСтрокаВвод);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьПодсказкиАдреса(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	ТекстПоиска = СокрЛП(Текст);
	Если СтрДлина(ТекстПоиска) < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Подсказки = ПодсказкиАдресаНаСервере(ТекстПоиска);
	Если Подсказки = Неопределено Тогда
		ДобавитьВыборСвободнойФормыАдреса(ДанныеВыбора, ТекстПоиска);
		Возврат;
	КонецЕсли;
	
	Для Каждого Подсказка Из Подсказки Цикл
		
		Если Подсказка.Свойство("ЭтоСвободнаяФорма")
			И Подсказка.ЭтоСвободнаяФорма Тогда
			ДанныеВыбора.Добавить(Подсказка, Подсказка.ПредставлениеВыбора);
			Продолжить;
		КонецЕсли;
		
		Представление = Подсказка.Подсказка;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыбора.Добавить(Подсказка, Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыборСвободнойФормыАдреса(ДанныеВыбора, Знач ТекстПоиска)
	
	ВыборСвободнойФормы = Новый Структура;
	ВыборСвободнойФормы.Вставить("Подсказка", ТекстПоиска);
	ВыборСвободнойФормы.Вставить("ИдентификаторФИАС", "");
	ВыборСвободнойФормы.Вставить("УровеньФИАС", "");
	ВыборСвободнойФормы.Вставить("ЭтоСвободнаяФорма", Истина);
	ДанныеВыбора.Добавить(ВыборСвободнойФормы, "<добавить в свободной форме>");
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСтраныАдресаНаСервере(Знач ТекстАдреса)
	
	АдресКодГАРВвод = "";
	СброситьКодГАРАдресаНаСервере();
	
	Если КонтурЛогистика_ВводАдреса.ЭтоСтранаРоссияДляАдреса(Объект.ИнКодСтраны) Тогда
		
		Объект.ИнАдресAddress = "";
		Объект.ИнАдресCountry = "";
		
	Иначе
		
		КонтурЛогистика_ВводАдреса.ПрименитьИностранныйАдресОрганизацииДиадок(Объект, ТекстАдреса);
		АдресСтрокаВвод = Объект.АдресСтрока;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СброситьКодГАРАдресаНаСервере()
	
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	КонтурЛогистика_ВводАдреса.ОчиститьАдресРФОрганизацииДиадок(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьТекстАдресаНаСервере(Знач ТекстАдреса)
	
	Если ЗначениеЗаполнено(АдресКодГАРВвод) Тогда
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_ВводАдреса.ПрименитьРучнойТекстАдресаОрганизацииДиадок(Объект, ТекстАдреса);
	АдресСтрокаВвод = Объект.АдресСтрока;
	АдресКодГАРВвод = Объект.АдресКодГАР;
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьПодсказкуАдресаНаСервере(Знач ИдентификаторФИАС, Знач Представление)
	
	КонтурЛогистика_ВводАдреса.ПрименитьАдресИзПодсказкиФИАСКОрганизацииДиадок(
		Объект, ИдентификаторФИАС, Представление);
	АдресСтрокаВвод = Объект.АдресСтрока;
	АдресКодГАРВвод = Объект.АдресКодГАР;
	ОбновитьИнформативнуюНадписьАдреса();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодсказкиАдресаНаСервере(Знач Текст)
	
	Попытка
		Клиент = КонтурЛогистика_ВводАдреса.НовыйФиасКлиент("", КонтурЛогистика_ВводАдреса.ЛокацияФиасПоУмолчанию());
		Возврат КонтурЛогистика_ВводАдреса.ПодсказкиАдреса(Клиент, Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ОбновитьИнформативнуюНадписьАдреса()
	
	ТипАдреса = КонтурЛогистика_ВводАдреса.ОпределитьТипАдресаОрганизацииДиадок(Объект);
	Элементы.ДекорацияТипАдреса.Заголовок = КонтурЛогистика_ВводАдреса.ЗаголовокИнформацииТипаАдресаОрганизации(ТипАдреса);
	
КонецПроцедуры

#КонецОбласти
