&НаКлиенте
Процедура НастройкиДинСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЕстьДоступКНастройкам Тогда 
		ТекущиеДанные = Элементы.НастройкиДинСписок.ТекущиеДанные;
		
		Если Поле.Имя = "НастройкиДинСписокЗначениеНастройки" Тогда
			ИзменитьНастройку(ТекущиеДанные);
		КонецЕсли;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройку(ТекущиеДанные)
	
	ЗаполнятьПоказанияГСМВЭПЛ = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЗаполнятьПоказанияГСМВЭПЛ");
	РазрешитьВодителямВноситьПоказанияГСМ = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.РазрешитьВодителямВноситьПоказанияГСМ");
	
	Если ТипЗнч(ТекущиеДанные.Настройка) = Тип("ПеречислениеСсылка.КонтурЛогистика_НастройкиОрганизацийДиадок") Тогда
		ТипВыбораНастройки = ТипЗначенияВыбораПоНастройке(ТекущиеДанные.Настройка);
	Иначе
		ТипВыбораНастройки = Тип("Строка");
	КонецЕсли;
	
	Если ТекущиеДанные.Настройка = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey") Тогда
		
		ПараметрыФормы = Новый Структура("КлючАПИ", ТекущиеДанные.ЗначениеНастройки);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВводаАпиКлюча", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"ИзменениеНастройкиЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТипВыбораНастройки = Тип("СправочникСсылка.КонтурЛогистика_ПодразделенияДиадок") Тогда
		
		ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПодразделенияДиадок.Форма.ФормаВыбора";
		ЗначениеОтбора = Новый Структура("Организация", Объект.Ссылка);
		ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"ИзменениеНастройкиЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТекущиеДанные.Настройка = ЗаполнятьПоказанияГСМВЭПЛ
		Или ТекущиеДанные.Настройка = РазрешитьВодителямВноситьПоказанияГСМ
		Или ТипВыбораНастройки = Тип("Строка") Тогда
		
		ПараметрыРедактированияЗанчения = ПараметрыРедактированияЗанчения(ТекущиеДанные.Настройка);
		Если ТекущиеДанные.Настройка = ЗаполнятьПоказанияГСМВЭПЛ Тогда
			ПараметрыРедактированияЗанчения.Комментарий =
				"При включенной настройке будет проверка передачи показаний ГСМ на выезде в сервис Логистики при подписании П4 и П5";
			ТекстЗаголовка = Строка(Элементы.НастройкиДинСписок.ТекущиеДанные.Настройка);
		ИначеЕсли ТекущиеДанные.Настройка = РазрешитьВодителямВноситьПоказанияГСМ Тогда
			ПараметрыРедактированияЗанчения.Комментарий =
				"При включенной настройке водители получат возможность вносить показания ГСМ в мобильном приложении";
			ТекстЗаголовка = Строка(Элементы.НастройкиДинСписок.ТекущиеДанные.Настройка);
		Иначе
			ТекстЗаголовка = "Введите значение настройки: " + Элементы.НастройкиДинСписок.ТекущиеДанные.Настройка;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок", ТекстЗаголовка);
		ПараметрыФормы.Вставить("ЗначениеСтрока", ТекущиеДанные.ЗначениеНастройки);
		ПараметрыФормы.Вставить("ЗначениеБулево", ТекущиеДанные.ЗначениеНастройки);
		ПараметрыФормы.Вставить("ТипВыбораНастройки", ТипВыбораНастройки);
		ПараметрыФормы.Вставить("ПараметрыРедактирования", ПараметрыРедактированияЗанчения);
		
		КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"Справочник.КонтурЛогистика_ОрганизацииДиадок.Форма.ФормаВводаЗначенияНастройки", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
			"ИзменениеНастройкиЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТипВыбораНастройки = Тип("Дата") Тогда
		
		ТекстЗаголовка = "Введите значение настройки: " + Элементы.НастройкиДинСписок.ТекущиеДанные.Настройка;
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводЗначения_КонтурЛогистика(
			ТекущиеДанные.ЗначениеНастройки, ТекстЗаголовка,Тип("Дата") , ЭтаФорма, "ИзменениеНастройкиЗавершение");
			
	ИначеЕсли ТипВыбораНастройки = Тип("Булево") Тогда
			
		ТекстЗаголовка = "Введите значение настройки: " + Элементы.НастройкиДинСписок.ТекущиеДанные.Настройка;
		КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводЗначения_КонтурЛогистика(
			ТекущиеДанные.ЗначениеНастройки, ТекстЗаголовка,Тип("Булево") , ЭтаФорма, "ИзменениеНастройкиЗавершение");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыРедактированияЗанчения(Настройка)
	
	Возврат Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.ПараметрыРедактированияЗанчения(Настройка)
	
КонецФункции

&НаКлиенте
Процедура ИзменениеНастройкиЗавершение(НовоеЗначение, ДополнительныеПараметры) Экспорт
	
	Если НовоеЗначение = Неопределено Тогда	// Нажали отмена
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.НастройкиДинСписок.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Настройка = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики") 
		И Объект.Наш 
		И НовоеЗначение Тогда
		
		ApiKey = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey"));
		Если Не ЗначениеЗаполнено(ApiKey) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика("Не заполнен Logistics api key");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТекущиеДанные.Настройка = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок") 
		И Объект.Наш
		И Не НовоеЗначение Тогда
		
		ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ИспользуетсяЗаказЗаявка");
		ИспользуетсяПоручениеЭкспедитору = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ИспользуетсяПоручениеЭкспедитору");
		ИспользуетсяЭкспедиторскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ИспользуетсяЭкспедиторскаяРасписка");
		ИспользуетсяСкладскаяРасписка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ИспользуетсяСкладскаяРасписка");
		
		Если ИспользуетсяЗаказЗаявка Или ИспользуетсяПоручениеЭкспедитору Или ИспользуетсяЭкспедиторскаяРасписка Или ИспользуетсяСкладскаяРасписка Тогда
			
			ЧитатьЛентуДиадок = Не ЧитатьЛентуДиадок;
			
			ТекстВопроса = ТекстВопросаДляВыключенияЧтенияЛентыСобытийДиадок(
				ИспользуетсяЗаказЗаявка, ИспользуетсяПоручениеЭкспедитору, ИспользуетсяЭкспедиторскаяРасписка, ИспользуетсяСкладскаяРасписка);
			КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, РежимДиалогаВопрос.ДаНет,
				,, ЭтаФорма,
				"ВыключениеНастройкиЧитатьЛентуДиадокЗавершение");
				
			Возврат;
				
		КонецЕсли;
		
	ИначеЕсли ТекущиеДанные.Настройка 
				= ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийСервисаФизическихЛицДата") Тогда
		Оповестить("ОбновитьРабочийСтол");				
	КонецЕсли;
	
	УстановитьЗначениеНастройки(ТекущиеДанные.Настройка, НовоеЗначение);
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();
	
	Если ТекущиеДанные.Настройка = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey") И Объект.Наш Тогда
		
		Если ЗначениеЗаполнено(НовоеЗначение) И Не ЧитатьЛентуЛогистики Тогда			
			ЧитатьЛентуЛогистики = Истина;
			УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		ИначеЕсли Не ЗначениеЗаполнено(НовоеЗначение) И ЧитатьЛентуЛогистики Тогда	
			ЧитатьЛентуЛогистики = Ложь;
			УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		КонецЕсли;
		
	КонецЕсли;
	
	РазрешитьВодителямВноситьПоказанияГСМ = ПредопределенноеЗначение(
		"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.РазрешитьВодителямВноситьПоказанияГСМ");
	Если ТекущиеДанные.Настройка = РазрешитьВодителямВноситьПоказанияГСМ И Объект.Наш Тогда
		СохранитьНастройкиОрганизации();
	КонецЕсли;
	
	ОбновитьВидимостьДоступностьГраниц();
	
КонецПроцедуры

