#Область ОписаниеПеременных

&НаКлиенте
Перем ИдетВыборАдресаИзСписка;

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("УказатьКлючАПИ", УказатьКлючАПИ);
	Параметры.Свойство("УказатьПодразделениеОтправитель", УказатьПодразделениеОтправитель);
	Параметры.Свойство("УказатьПодразделениеПолучатель", УказатьПодразделениеПолучатель);
	
	КлючОшибки = Параметры.КлючОшибки;
	
	ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
	ЕстьДоступКНастройкам = (КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистратор()
		Или РольДоступна("КонтурЛогистика_УправлениеОрганизациями"));
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	АвторизацияПоOIDC = (РежимАвторизации = Перечисления.КонтурЛогистика_РежимыАвторизации.OIDCDeviceFlow);
	
	ДоступныйФункционал = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьДоступныйФункционал(Объект);
	ДоступнаТрН = ДоступныйФункционал.ТрН;
	ДоступенПЛ	= ДоступныйФункционал.ПЛ;
	
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
	// +++ КонтурЛогистика_НастройкиКонвертацииСправочников
	КонтурЛогистика_КонвертацияСервер.НастройкиКонвертацииСправочников_ПриСозданииНаСервере(
		ЭтаФорма, "КонтурЛогистика_ОрганизацииДиадок", ЭтаФорма, Элементы.ГруппаШапка);
	// --- КонтурЛогистика_НастройкиКонвертацииСправочников
	
	// Определяем использованность каналов отправки
	Элементы.ГруппаИспользоватьОтправкуВТелеграм.Видимость =
		Не Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм");
	Элементы.ГруппаИспользоватьОтправкуНаПочту.Видимость =
		Не КонтурЛогистика_РаботаСПочтовымиСообщениями.НастройкиОтправкиПочтыЗаполнены();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ИнициализироватьАдресНаФорме();
	
	СформироватьЭлементыКонтактнойИнформации();
	
	УстановитьВидимостьСвойствЛогистики();
	
	ИнициализироватьСервисФизическихЛиц();
	
	ОбновитьПризнакАвторизацииНаПортале();
	
	АктуальностьЛентыСобытийДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		Объект.Ссылка, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок);
	АктуальностьЛентыСобытийДиадокДата = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		Объект.Ссылка, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата);
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаРеквизиты;
	
	Попытка
		Элементы.ГруппаПодразделения.Скрыть();
		Элементы.ГруппаТелефоныПереадресующегоПоУмолчанию.Скрыть();
		
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредствоПоУмолчанию)
			Или ЗначениеЗаполнено(Объект.ВодительПоУмолчанию)
			Или ЗначениеЗаполнено(Объект.Водитель2ПоУмолчанию)
			Или ЗначениеЗаполнено(Объект.ВидПеревозкиПоУмолчанию)
			Или ЗначениеЗаполнено(Объект.ВидСообщенияПоУмолчанию)
			Или ЗначениеЗаполнено(Объект.СрокДействияПоУмолчанию)
			Или ЗначениеЗаполнено(Объект.ТехРаботникПоУмолчанию) Тогда
			
			Элементы.ГруппаРеквизитыПоУмолчанию.Показать();
		Иначе
			Элементы.ГруппаРеквизитыПоУмолчанию.Скрыть();
		КонецЕсли;
	Исключение
		// Перед нами что-то очень старое где у группы нет метода скрыть
		НичегоНеДелаем = Истина;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ИзмениласьРоль = ИзмениласьРоль(ТекущийОбъект);
	
	// Перенесем КИ в объект
	ТекущийОбъект.КонтактнаяИнформация.Очистить();
	Для Каждого ТекущаяСтрока Из РеквизитыКИ Цикл
		
		ЗначениеРеквизита = ЭтаФорма[ТекущаяСтрока.Значение];
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		// Пример имени: "КИ_Иной_0d845ab18cd94ba0bf8a94ee894c64c5"
		СоставИмени = КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ТекущаяСтрока.Значение, "_", Ложь);
		
		НоваяСтрока = ТекущийОбъект.КонтактнаяИнформация.Добавить();
		НоваяСтрока.ВидКонтактнойИнформации = Перечисления.КонтурЛогистика_ВидыКонтактнойИнформации[СоставИмени[1]];
		НоваяСтрока.Значение = ЗначениеРеквизита;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОтправитьМетрикуЗаписи();
	
	Оповестить("КонтурЛогистика_ПерепроверитьДокумент");
	
	Если ИзмениласьРоль = Истина Тогда 
		
		Оповестить("КонтурЛогистика_ИзмениласьРольОрганизации", Объект.Ссылка, "КонтурЛогистика_ОрганизацииДиадок.ФормаЭлемента");
		
	КонецЕсли;
	
	Если ТребуетсяОбновитьПовторноИспользуемыеЗначения Тогда
		ОбновитьПовторноИспользуемыеЗначения();
		ТребуетсяОбновитьПовторноИспользуемыеЗначения = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИзмениласьРоль(ОрганизацияОбъект)
	
	МассивПроверяемыхРеквизитов = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеРоли();
	
	Для Каждого Реквизит Из МассивПроверяемыхРеквизитов Цикл
		
		Если ОрганизацияОбъект.Ссылка[Реквизит] <> ОрганизацияОбъект[Реквизит] Тогда
			Возврат Истина;			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьСвойствЛогистики()
	
	// Индикатор наличия в сервисе выводим только если введен хотя бы 1 апикей
	// (иначе мы никак не можем вычитать значение индикатора и он будет врать что ложь)
	ТочноеСовпадение = Ложь;
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(,, ТочноеСовпадение);
	
	Если ПараметрыСервиса.АвторизацияВыполнена
		И Объект.ЕстьВСервисеЛогистика
		И (Не Объект.ПродуктивТрн
			Или Не Объект.ПродуктивЭпл) Тогда
		
		Элементы.ГруппаЕстьВЛогистике.Видимость = Истина;
		
		Если Не Объект.ПродуктивТрн И Не Объект.ПродуктивЭпл Тогда
			ПредставлениеСтатуса = "Электронные транспортные накладные и путевые листы работают в тестовом режиме";
		ИначеЕсли Не Объект.ПродуктивТрн И Объект.ПродуктивЭпл Тогда
			ПредставлениеСтатуса = "Электронные транспортные накладные работают в тестовом режиме";
		Иначе
			ПредставлениеСтатуса = "Электронные путевые листы работают в тестовом режиме";
		КонецЕсли;
		Элементы.ДекорацияБойТест.Заголовок = ПредставлениеСтатуса;
	Иначе
		Элементы.ГруппаЕстьВЛогистике.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ЕстьВСервисеЛогистика.Видимость = Не Объект.ЕстьВСервисеЛогистика;
	
КонецПроцедуры

&НаСервере
Процедура ПроставитьНазваниеРегиона()

	ТаблицаРегионов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
	Если ЗначениеЗаполнено(Объект.АдресRegion) Тогда 
		НайденнаяРасшифровка = ТаблицаРегионов.Найти(Объект.АдресRegion, "Код");
		Если НайденнаяРасшифровка<> Неопределено Тогда 
			ИмяРегиона = НайденнаяРасшифровка.Наименование;
		Иначе
			ИмяРегиона = "<неизвестный регион>";
		КонецЕсли;
			
	Иначе
		ИмяРегиона = "";
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСвязанныеОбъектыКонтрагентов" Тогда
		
		ОбновитьСвязанныеОбъектыКонтрагентов();
		
	ИначеЕсли ИмяСобытия = "ОбновитьКонтрагентовОрганизации" Или ИмяСобытия = "КонтурЛогистика_ОбновитьОрганизациюДиадок" Тогда
		
		ЭтаФорма.Прочитать();
		ПоказатьСтатусОтправкиПолученияДокументов();
		Элементы.КонтрагентыДинСписок.Обновить();
		
		ПодключитьПроверкуСтатусаГотовностиКЭПД();
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи" Тогда
		
		Прочитать();
		ОбновитьВидимостьДоступностьГраниц();
		
	ИначеЕсли ИмяСобытия = "ИзменениеОбщейНастройки"
		И Параметр = "ИспользоватьОтправкуВТелеграм" Тогда
		
		ИспользоватьОтправкуВТелеграм = ЗначениеОбщейНастройки("ИспользоватьОтправкуВТелеграм");
		УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
		ОбновитьВидимостьГруппыТелеграм();
		
		Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
			ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграм();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзменениеНастройкиУчетнойЗаписиЭлектроннойПочты" Тогда
		
		ИспользоватьОтправкуНаПочту = НастройкиОтправкиПочтыЗаполнены();
		УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
		ОбновитьВидимостьГруппыТелеграм();
		
	ИначеЕсли ИмяСобытия = "ЗавершениеФоновогоЗадания"		
		И Параметр.Свойство("КлючФЗ")
		И Параметр.КлючФЗ = "Синхронизировать контрагентов организации" Тогда
		
		ЭтаФорма.Прочитать();
		ПоказатьСтатусОтправкиПолученияДокументов();
		Элементы.КонтрагентыДинСписок.Обновить();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФизическиеЛица" Тогда		
		Элементы.ФизическиеЛица.Обновить();
		УстановитьВидимостьИПараметрыФизическихЛиц();
	КонецЕсли;
	
	КонтурЛогистика_КонвертацияКлиент.ОбработкаОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ОбновитьДанныеДинамическихСписков();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(КлючОшибки) Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы[КлючОшибки];
	КонецЕсли;
	
	Если УказатьКлючАПИ Тогда
		УстановитьКлючАПИ();
	КонецЕсли;
	
	Если УказатьПодразделениеОтправитель
		Или УказатьПодразделениеПолучатель Тогда
		
		УказатьПодразделениеПЛ();
	КонецЕсли;
	
	ЧитатьЛентуДиадок = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок"));
	ЧитатьЛентуЛогистики = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики"));
	
	ПоказатьСтатусОтправкиПолученияДокументов();
	
	ОбновитьВидимостьДоступностьГраниц();
	ОбновитьВидимостьГруппыТелеграм();
	ОбновитьВидимостьФильтраПоИнфоПолям();
	
	Если ИспользоватьОтправкуВТелеграм Тогда
		Если ЗначениеЗаполнено(Объект.ТелефонУведомленияОшибокРоботов) Тогда
			ПроверитьРегистрациюТелефонаУведомленияОшибокРоботовТелеграм();
		КонецЕсли;
	КонецЕсли;
	
	Если (Не Объект.ЕстьВСервисеЛогистика
			Или Не Объект.ПродуктивТрн
			Или Не Объект.ПродуктивЭпл)
		И ЗначениеЗаполнено(Объект.ИНН) Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикАвтообновлениеИзЛогистики", 0.1, Истина);
		
	КонецЕсли;
	
	ПроверитьСтатусГотовностиКЭПД();
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭкспедиторПриИзменении(Элемент)
	
	Элементы.ГруппаЭкспедитор.Видимость = Объект.Экспедитор;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикАвтообновлениеИзЛогистики()
	
	ОбновитьИзЛогистикиСервер();
	Прочитать();
	УстановитьВидимостьСвойствЛогистики();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИзЛогистикиСервер()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Объект.Ссылка);
	Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТекущийОбъект.СинхронизироватьИзСервисаЛогистика();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьДоступностьГраниц()
	
	ЧитатьЛентуДиадок = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуДиадок"));
	ЧитатьЛентуЛогистики = ПолучитьЗначениеНастройки(ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ЧитатьЛентуЛогистики"));
	ЕстьКлючАПИЛогистики = ЕстьКлючАПИЛогистики();
	
	Элементы.ГруппаГраницаСинхронизацииДиадок.Видимость = ЧитатьЛентуДиадок;
	Элементы.ГруппаГраницаСинхронизацииЛогистики.Видимость = (ЕстьКлючАПИЛогистики Или АвторизацияПоOIDC) И ЧитатьЛентуЛогистики;
	Элементы.ГруппаУстановкаГраницыОбщая.Видимость = (ЕстьКлючАПИЛогистики Или АвторизацияПоOIDC) И ЧитатьЛентуЛогистики И ЧитатьЛентуДиадок;
	Элементы.ГруппаОсобенностиНашихОрганизаций.Видимость = Объект.Наш И (ЧитатьЛентуЛогистики Или ЧитатьЛентуДиадок);
	
	Элементы.ЧитатьЛентуДиадокФлажекВыкл.Видимость = Не ЧитатьЛентуДиадок;
	Элементы.ЧитатьЛентуДиадокФлажекВкл.Видимость = ЧитатьЛентуДиадок;
	Элементы.ЧитатьЛентуЛогистикиФлажекВыкл.Видимость = Не ЧитатьЛентуЛогистики;
	Элементы.ЧитатьЛентуЛогистикиФлажекВкл.Видимость = ЧитатьЛентуЛогистики;
	
	Элементы.ОбновитьСтатусыДОТрНИзЛогистики.Видимость = (ДоступнаТрН И ЧитатьЛентуЛогистики);
	
	ВсеДатыГраницСинхронизацииЛогистика = Новый Массив;
	
	Если ДоступнаТрН Тогда		
		ДобавитьДатуГраницыСинхронизацииЛогистика(ВсеДатыГраницСинхронизацииЛогистика,
												  ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"));
	КонецЕсли;
	
	Если ДоступенПЛ Тогда
		ДобавитьДатуГраницыСинхронизацииЛогистика(ВсеДатыГраницСинхронизацииЛогистика,
												  ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДатаПЛ"));
	КонецЕсли;
	
	ДатаГраницыСинхронизацииЛогистика = ВыбратьМинДатуГраницыСинхронизацииЛогистика(ВсеДатыГраницСинхронизацииЛогистика);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДатуГраницыСинхронизацииЛогистика(ВсеДатыГраницСинхронизацииЛогистика, НастройкаАктуальностьЛентыСобытийДата)
	
	ОчереднаяДатаГраницыСинхронизацииЛогистика = ПолучитьЗначениеНастройки(НастройкаАктуальностьЛентыСобытийДата);
	Если ОчереднаяДатаГраницыСинхронизацииЛогистика = Неопределено Тогда
		ОчереднаяДатаГраницыСинхронизацииЛогистика = Дата(1,1,1);
	КонецЕсли;
	
	ВсеДатыГраницСинхронизацииЛогистика.Добавить(ОчереднаяДатаГраницыСинхронизацииЛогистика);	
	
КонецПроцедуры

&НаКлиенте
Функция ВыбратьМинДатуГраницыСинхронизацииЛогистика(ВсеДатыГраницСинхронизацииЛогистика)
	
	МинДатаГраницыСинхронизацииЛогистика = Дата(1,1,1);
	
	Для Каждого ОчереднаяДатаГраницыСинхронизацииЛогистика Из ВсеДатыГраницСинхронизацииЛогистика Цикл
		
		Если МинДатаГраницыСинхронизацииЛогистика = Дата(1,1,1) Тогда
			МинДатаГраницыСинхронизацииЛогистика = ОчереднаяДатаГраницыСинхронизацииЛогистика;
		ИначеЕсли ОчереднаяДатаГраницыСинхронизацииЛогистика < МинДатаГраницыСинхронизацииЛогистика Тогда
			МинДатаГраницыСинхронизацииЛогистика = ОчереднаяДатаГраницыСинхронизацииЛогистика;
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат МинДатаГраницыСинхронизацииЛогистика;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьМетрикуЗаписи()
	
	// общепродуктовая метрика настройки организации (сейчас считаем что настройка = выбрана роль у "нашей" организации и есть соответствие)
	Если Объект.Наш 
		И Объект.СвязанныеОбъекты.Количество() > 0
		И (Объект.Грузоотправитель
		ИЛИ Объект.Перевозчик
		ИЛИ Объект.Грузополучатель
		ИЛИ Объект.Оформитель
		ИЛИ Объект.Медик
		ИЛИ Объект.ТехОсмотр
		ИЛИ Объект.Одометр) Тогда
		
		ОтправитьМетрикуЗаписиСервер();
		                                 
		ЭтаФорма.Прочитать();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтправитьМетрикуЗаписиСервер()
	
	КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьВыполнениеНастройки(Объект.Ссылка, "КарточкаОрганизации");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКлючАПИ()
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаНастройки;
	
	НастройкаКлючаАПИ = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey");
	ТекстЗаголовка = "Введите значение настройки: " + НастройкаКлючаАПИ;
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьВводСтроки_КонтурЛогистика("", ТекстЗаголовка, Ложь, ЭтаФорма, "УстановитьКлючАПИЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКлючАПИЗавершение(НовоеЗначение, ДополнительныеПараметры) Экспорт
	
	Если НовоеЗначение = Неопределено Тогда	// Нажали отмена
		Возврат;
	КонецЕсли;
	
	НастройкаКлючаАПИ = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.LogisticsApiKey");
	УстановитьЗначениеНастройки(НастройкаКлючаАПИ, НовоеЗначение);
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьПодразделениеПЛ()
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаНастройки;
	
	ИмяФормыСправочника = "Справочник.КонтурЛогистика_ПодразделенияДиадок.Форма.ФормаВыбора";
	ЗначениеОтбора = Новый Структура("Организация", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор", ЗначениеОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		ИмяФормыСправочника, ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"УказатьПодразделениеЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьПодразделениеЗавершение(НовоеЗначение, ДополнительныеПараметры) Экспорт
	
	Если НовоеЗначение = Неопределено Тогда	// Нажали отмена
		Возврат;
	КонецЕсли;
	
	Если УказатьПодразделениеОтправитель Тогда
		НастройкаПодразделение = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ПодразделениеОтправительПутевогоЛиста");
	Иначе
		НастройкаПодразделение = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.ПодразделениеПолучательПутевогоЛиста");
	КонецЕсли;
	
	УстановитьЗначениеНастройки(НастройкаПодразделение, НовоеЗначение);
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатусОтправкиПолученияДокументов()
	
	Статус = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеСтатусаОтправкиПолученияДокументов(Объект.Sociability);
	Если ЗначениеЗаполнено(Статус) Тогда
		Элементы.ТекстСтатусаОтправкиПолученияДокументов.Заголовок = Статус;
	КонецЕсли;
	Элементы.ТекстСтатусаОтправкиПолученияДокументов.Видимость = ЗначениеЗаполнено(Статус);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЛицаПриИзменении(Элемент)
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДоступностьЭлементов(Форма)

	Форма.Элементы.ГруппаРеквизитыИП.Видимость = 
		Форма.Объект.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ФизЛицо")
			ИЛИ
		Форма.Объект.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИП");
		
		
	Форма.Элементы.ГруппаОсобенностиНашихОрганизаций.Видимость 	= Форма.Объект.Наш;	
	
	Форма.Элементы.ДатаГраницыСинхронизации.Видимость 			= Истина;
	Форма.Элементы.ДатаГраницыСинхронизацииВвод.Видимость 		= Ложь;
	
	ЭтоИностранный = 
		Форма.Объект.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИностранныйФизЛицо")
			ИЛИ
		Форма.Объект.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИностранныйЮрЛицо");
		
	Форма.Элементы.ГруппаИностранный.Видимость = ЭтоИностранный;
	
	Форма.Элементы.ГруппаИННКПП.Видимость = НЕ ЭтоИностранный;
	Форма.Элементы.ОГРН.Видимость = НЕ ЭтоИностранный;
	
	ЭтоЮрЛицо = Форма.Объект.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ЮрЛицо");
	Форма.Элементы.КПП.АвтоОтметкаНезаполненного = ЭтоЮрЛицо;
	Форма.Элементы.КПП.ПодсказкаВвода = ?(ЭтоЮрЛицо, "", "необязательно");
	
	Форма.Элементы.ГруппаИнфоОСопоставлении.Видимость = Форма.Параметры.Свойство("ПоказатьИнфоОСопоставлении");
	
	Форма.Элементы.ГруппаТелефонУведомленияОшибокРоботов.Видимость = Форма.ИспользоватьОтправкуВТелеграм;
	Форма.Элементы.ГруппаНастройкиТелеграм.Видимость = Не Форма.ИспользоватьОтправкуВТелеграм;
	
	Форма.Элементы.АдресЭлектроннойПочтыУведомленияОшибокРоботов.Видимость = Форма.ИспользоватьОтправкуНаПочту;
	Форма.Элементы.ГруппаНастройкиПочты.Видимость = Не Форма.ИспользоватьОтправкуНаПочту;
	
	Форма.Элементы.ГруппаНастройки.ТолькоПросмотр = Не Форма.ЕстьДоступКНастройкам;
	Форма.Элементы.НастройкиДинСписок.Доступность = Форма.ЕстьДоступКНастройкам;
	Форма.Элементы.СтраницаТехПоля.ТолькоПросмотр = Не Форма.ЕстьДоступКНастройкам;
	Форма.Элементы.ГруппаОсобенностиНашихОрганизаций.Доступность = Форма.ЕстьДоступКНастройкам;
	
	Форма.Элементы.ГруппаФильтрПоИнфоПолям.Видимость = Форма.Объект.Наш;
	Форма.Элементы.ГруппаЧитатьЛенту.Видимость = Форма.Объект.Наш;
	
	Форма.Элементы.ГруппаСвидетельствоИП.Видимость = Форма.Объект.ТипЛица = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛиц.ИП");
	
	ОбновитьВидимостьГруппыРолей(Форма);
	
	ПоказыватьСтатусКакНеизвестноРоуминг =
		(Форма.Объект.СтатусГотовностиКЭПД = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_СтатусыГотовностиКЭПД.UnknownEpdStatus")
			Или Форма.Объект.СтатусГотовностиКЭПД = ПредопределенноеЗначение(
				"Перечисление.КонтурЛогистика_СтатусыГотовностиКЭПД.UndefinedEpdStatus"))
		И Форма.Объект.Провайдер <> "Контур";
	
	Форма.Элементы.СтатусГотовностиКЭПД.Видимость = Не ПоказыватьСтатусКакНеизвестноРоуминг;
	Форма.Элементы.СтатусГотовностиКЭПДНеизвестноРоуминг.Видимость = ПоказыватьСтатусКакНеизвестноРоуминг;
	
	Форма.Элементы.ИзменитьВДиадокеСтатусГотовностиКЭПД.Видимость = Форма.Объект.Наш И ЗначениеЗаполнено(Форма.Объект.ID);	
	Форма.Элементы.ГруппаПроверкаСтатусаГотовностиКЭПД.Видимость = ЗначениеЗаполнено(Форма.ТекстПроверкиСтатусаГотовностиКЭПД);
	Форма.Элементы.ВыполнитьДействиеПроверкиСтатусаГотовностиКЭПД.Видимость = ЗначениеЗаполнено(Форма.ДействиеПроверкиСтатусаГотовностиКЭПД);
	
	ИспользуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяТРН");
	ИспользуетсяПутевойЛист = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПутевойЛист");
	ИспользуетсяПутевойЛист_5_02 = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"ИспользуетсяПутевойЛист_5_02");
	
	Форма.Элементы.ГруппаРеквизитыПоУмолчаниюЭТрН.Видимость = ИспользуетсяТРН;
	Если (ИспользуетсяПутевойЛист Или ИспользуетсяПутевойЛист_5_02) И Форма.Объект.Наш Тогда
		Форма.Элементы.ГруппаРеквизитыПоУмолчаниюЭПЛ.Видимость =
			(Форма.Объект.Оформитель
				Или Форма.Объект.Медик
				Или Форма.Объект.ТехОсмотр
				Или Форма.Объект.Одометр);
			
		Форма.Элементы.МедЛицензияПоУмолчанию.Видимость = Форма.Объект.Медик;
	Иначе
		Форма.Элементы.ГруппаРеквизитыПоУмолчаниюЭПЛ.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НашПриИзменении(Элемент)
	
	Если Не ПроверитьЗаполнение() Тогда
		Объект.Наш = Не Объект.Наш;
		Возврат;
	КонецЕсли;
	
	Если Объект.Наш Тогда
		Если АвторизацияПоOIDC Тогда
			Если Не ЧитатьЛентуДиадок Тогда
				ЧитатьЛентуДиадок = Истина;
				УстановитьЗначениеНастройкиЧитатьЛентуДиадок();
			КонецЕсли;
			
			Если Не ЧитатьЛентуЛогистики Тогда
				АктуальностьЛентыСобытийДата = ПолучитьЗначениеНастройки(ПредопределенноеЗначение(
					"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"));
				АктуальностьЛентыСобытий = ПолучитьЗначениеНастройки(ПредопределенноеЗначение(
					"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий"));
				
				Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийДата)
					И Не ЗначениеЗаполнено(АктуальностьЛентыСобытий) Тогда
					
					ЧитатьЛентуЛогистики = Истина;
					УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
				КонецЕсли;
			КонецЕсли;
		Иначе
			ОбработатьПриВключенииНаш();
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
	Если Объект.Наш И АвторизацияПоOIDC И Не АвторизацияВыполнена Тогда
		ВыполнитьАвторизациюНаПортале(Истина);
	КонецЕсли;
	
	Если Не Объект.Наш И АвторизацияПоOIDC И АвторизацияВыполнена Тогда
		УдалитьАвторизациюНаПортале();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПриВключенииНаш()
	
	Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийДиадокДата) И Не ЧитатьЛентуДиадок Тогда
		ЧитатьЛентуДиадок = Истина;
		УстановитьЗначениеНастройкиЧитатьЛентуДиадок();
	КонецЕсли;
	
	Если Не ЧитатьЛентуЛогистики Тогда
		
		АктуальностьЛентыСобытийДата = ПолучитьЗначениеНастройки(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата"));
		АктуальностьЛентыСобытий = ПолучитьЗначениеНастройки(ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий"));
		
		Если Не ЗначениеЗаполнено(АктуальностьЛентыСобытийДата) 
			И Не ЗначениеЗаполнено(АктуальностьЛентыСобытий)
			И (ЕстьКлючАПИЛогистики()
				Или АвторизацияПоOIDC) Тогда
			
			ЧитатьЛентуЛогистики = Истина;
			УстановитьЗначениеНастройкиЧитатьЛентуЛогистики();
		КонецЕсли;
		
	КонецЕсли;
	
	Записать();
	
	ОбновитьИнформациюИзДиадока();
	
	Модифицированность = Ложь;
	
	Прочитать();
	
	ИнициализироватьСервисФизическихЛиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаГраницыСинхронизацииВводПриИзменении(Элемент)
	
	УстановитьЗначениеНастройкиСервер(Объект.Ссылка, 
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок"), "");
	УстановитьЗначениеНастройкиСервер(Объект.Ссылка, 
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата"), АктуальностьЛентыСобытийДиадокДата);	
	
	Элементы.AfterIndexKey.Видимость = Ложь;
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура AfterIndexKeyПриИзменении(Элемент)
	
	УстановитьЗначениеНастройкиСервер(Объект.Ссылка, 
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадок"), АктуальностьЛентыСобытийДиадок);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаГраницыСинхронизацииЛогистикаВводПриИзменении(Элемент)
	
	Элементы.ДатаГраницыСинхронизацииЛогистика.Видимость = Истина;
	Элементы.ДатаГраницыСинхронизацииЛогистикаВвод.Видимость = Ложь;
	
	Если ДоступнаТрН Тогда
	
		НастройкаАктуальностьЛентыСобытийДата = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата");
		УстановитьЗначениеНастройки(НастройкаАктуальностьЛентыСобытийДата, ДатаГраницыСинхронизацииЛогистика);
		
		НастройкаАктуальностьЛентыСобытий = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытий");
		УстановитьЗначениеНастройки(НастройкаАктуальностьЛентыСобытий, "");
		
	КонецЕсли;
	
	Если ДоступенПЛ Тогда
		
		НастройкаАктуальностьЛентыСобытийДатаПЛ = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДатаПЛ");
		УстановитьЗначениеНастройки(НастройкаАктуальностьЛентыСобытийДатаПЛ, ДатаГраницыСинхронизацииЛогистика);
		
		НастройкаАктуальностьЛентыСобытийПЛ = ПредопределенноеЗначение(
			"Перечисление.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийПЛ");
		УстановитьЗначениеНастройки(НастройкаАктуальностьЛентыСобытийПЛ, "");
		
	КонецЕсли;
	
	Записать();
	
	Элементы.НастройкиДинСписок.Обновить();
	
КонецПроцедуры

