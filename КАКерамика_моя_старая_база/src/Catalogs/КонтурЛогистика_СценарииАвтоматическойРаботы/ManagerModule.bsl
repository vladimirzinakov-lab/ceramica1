						СнятьОшибкиСценариевАвтоматическойРаботы(СценарийСсылка, ВведенныеДокументы[0]);
					КонецЕсли;
				Иначе
					ТекстОшибки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки);
					КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
						"Проблемы при отправке документов: " + ТекстОшибки);
					ЗафиксироватьОшибкуВРегистреИЖурнале(СценарийСсылка, ВведенныеДокументы[0], ТекстОшибки);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьОтправкуФайла(Контекст)
	
	ФайлыОбмена = Контекст.ФайлыОбмена;
	
	РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(ФайлыОбмена);
	
КонецПроцедуры

Функция ОформлениеНаОснованииУчетногоДокумента(ТипЛогистическогоДокумента, СпецСценарий)
	
	Если ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		Или (ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			И СпецСценарий <> Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя)
		Или ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		Или ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Процедура ЗафиксироватьСообщения(СценарийСсылка, ОбъектОбработки, СообщенияПользователю, КоличествоСообщенийДо)
	
	ТекстОшибки = "";
	
	Для ТекущийИндекс = КоличествоСообщенийДо По СообщенияПользователю.Количество() - 1 Цикл
		Если ТекстОшибки <> "" Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС;
		КонецЕсли;
		ТекстОшибки = ТекстОшибки + СообщенияПользователю[ТекущийИндекс].Текст;
	КонецЦикла;
	
	ЗафиксироватьОшибкуВРегистреИЖурнале(СценарийСсылка, ОбъектОбработки, ТекстОшибки);
	
КонецПроцедуры

Процедура ЗафиксироватьОшибкуВРегистреИЖурнале(СценарийСсылка, ОбъектОбработки, ТекстОшибки)
	
	// Запишем в регистр
	РегистрыСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ДобавитьОшибку(СценарийСсылка, ОбъектОбработки, ТекстОшибки);
	
	// Запишем в ЖР
	Если ЗначениеЗаполнено(ОбъектОбработки) Тогда
		ДанныеЖР = ОбъектОбработки;
	Иначе
		ДанныеЖР = СценарийСсылка;
	КонецЕсли;
	
	ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
	ТекстОшибкиПодробно = "Сценарий роботов: " + Строка(СценарийСсылка) + "
		|Текст ошибки: " + ТекстОшибки;
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, ДанныеЖР, ТекстОшибкиПодробно);
	
КонецПроцедуры

Процедура СнятьОшибкиСценариевАвтоматическойРаботы(СценарийСсылка, ОбъектОбработки = Неопределено)
	
	РегистрыСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.УдалитьЗапись(СценарийСсылка, ОбъектОбработки);
	
КонецПроцедуры

Процедура ДобавитьДопФильтры(Запрос, СценарийСсылка) Экспорт
	
	Если ЗначениеЗаполнено(СценарийСсылка.ДополнительноеУсловиеГДЕ)Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловиеГДЕ", " И " + СценарийСсылка.ДополнительноеУсловиеГДЕ);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СценарийСсылка.ДополнительноеУсловиеГДЕПараметрИзЗначенияНастройки) Тогда
		
		ЗначенияНастройки = Справочники.КонтурЛогистика_Настройки.СписокЗначенийНастройки(
			СценарийСсылка.ДополнительноеУсловиеГДЕПараметрИзЗначенияНастройки);
		
		Если ЗначенияНастройки.Количество() = 0 Тогда
			ВызватьИсключение "При установки параметра дополнительного условия не удалось получить значение параметра, "
				+ "так как в настройке """ + СценарийСсылка.ДополнительноеУсловиеГДЕПараметрИзЗначенияНастройки
				+ """ не заполнены ""Связанные объекты"".";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Параметр", ЗначенияНастройки);
		
	ИначеЕсли ЗначениеЗаполнено(СценарийСсылка.ДополнительноеУсловиеГДЕВычислениеПараметра) Тогда
		
		ВыражениеВычисления = СценарийСсылка.ДополнительноеУсловиеГДЕВычислениеПараметра;
		ВычисленноеЗначение = Неопределено;
		РезультатВычисления = Неопределено;
		
		Параметры = Новый Структура;
		Параметры.Вставить("СценарийСсылка", СценарийСсылка);
		
		ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			ВыражениеВычисления, Параметры);
		
		Запрос.УстановитьПараметр("Параметр", ВычисленноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоСценарийАвтоотправки(Сценарий) Экспорт
	
	Если Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковДокументов
		ИЛИ Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИОтправкаНеподписанных
		ИЛИ Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковИПодготовкаКОтправкеНеподписанных
		ИЛИ Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИПодготовкаКОтправке
		ИЛИ Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИОтправка
		ИЛИ Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного
		ИЛИ Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ОбработатьВходящиеДокументыЛогистики
		Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;

КонецФункции

Функция СформироватьЗапросСпискаЗадачРобота(СценарийСсылка) Экспорт
	
	Запрос = Новый Запрос;
	
	ТипЛогистика = СценарийСсылка.ТипЛогистическогоДокумента;
	
	Если Не ЗначениеЗаполнено(ТипЛогистика) Тогда 
		ВызватьИсключение "Не знаю тип логистического докуента для сценария " + СценарийСсылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СценарийСсылка.НастройкаКонвертации) Тогда
		ТипДокументаКонфигурации = СценарийСсылка.НастройкаКонвертации.ТипДокумента1С;
	Иначе
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			СценарийСсылка.ТипЛогистическогоДокумента);
		ТипДокументаКонфигурации = КонтекстНастройкиКонвертации.ТипДокумента1С;
		Если Не ЗначениеЗаполнено(ТипДокументаКонфигурации) Тогда
			ТипДокументаКонфигурации = "Все типы";
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипДокументаКонфигурации) 
		И СценарийСсылка.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		ВызватьИсключение "Настройте конвертацию документов для автоотправки Т1";
		
	КонецЕсли;
	
	Если СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного
		И Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(СценарийСсылка.ТипЛогистическогоДокумента) Тогда 
		
		ТекстЗапроса = ТекстЗапросаПатчаПодписью(ТипЛогистика, СценарийСсылка);
		
	ИначеЕсли СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьРанееОтправленного
		И Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(СценарийСсылка.ТипЛогистическогоДокумента) Тогда 
		
		ТекстЗапроса = ТекстЗапросаПодписанияПЛ_5_02(ТипЛогистика, СценарийСсылка);
		
	ИначеЕсли СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ОбработатьВходящиеДокументыЛогистики Тогда 
		
		ТекстЗапроса = ТекстЗапросаОбработкиВходящихДокументовЛогистики(ТипЛогистика, СценарийСсылка);
		
	Иначе
		
		РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
			ТипЛогистика, ТипДокументаКонфигурации, СценарийСсылка.СпецСценарий);
		
		ТекстЗапроса = ДополнитьЗапросСценарияПоТипуЛогистики(ТипЛогистика, РезультатаФормированияЗапроса.ПолныйТекстЗапроса, СценарийСсылка);
		
		Для Каждого ПараметрЗапроса Из РезультатаФормированияЗапроса.СтруктураПараметровЗапроса Цикл
			Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
		КонецЦикла;
		
		Если СценарийСсылка.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или СценарийСсылка.ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			Запрос.УстановитьПараметр("СостоянияОтказа", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.СостояниеОтказа());
		КонецЕсли; 
		
	КонецЕсли;
	
	Попытка
		
		Запрос.Текст = ТекстЗапроса;
		
		// Проверим, успешно ли соберется запрос - если запрос плохой - то тут будет падение
		//@skip-warning
		
		УстановитьПараметрыЗапроса(ТипЛогистика, Запрос, СценарийСсылка);
		
	Исключение
		
		ВызватьИсключение ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат Запрос;
	
КонецФункции

Процедура УстановитьПараметрыЗапроса(ТипЛогистика, Запрос, СценарийСсылка)
	
	СекундВЧасе = 60 * 60;
	СекундВДне = 24 * СекундВЧасе;
	
	ЧасовВПрошлое = СценарийСсылка.ИнтервалВремениЗадачЧасов;
	ДатаОкончания = ТекущаяДатаСеанса();
	Если ЧасовВПрошлое = 0 Тогда 
		
		НачалоТекДня = НачалоДня(ДатаОкончания);
		
		Если ДатаОкончания - НачалоТекДня < СекундВЧасе Тогда 
			ДатаНачала = НачалоТекДня - СекундВЧасе;  // иначе при запуске раз в час пропустим задачи с 23:00 до 24:00
		Иначе
			ДатаНачала = НачалоТекДня;
		КонецЕсли;
		
	Иначе
		
		ДатаНачала = ДатаОкончания - ЧасовВПрошлое * СекундВЧасе;
		
	КонецЕсли;
	
	ЧасовВБудущее = СценарийСсылка.ИнтервалВремениЗадачЧасовВБудущее;
	ДатаОкончания = ДатаОкончания + ЧасовВБудущее * СекундВЧасе;
	
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачала);
	Запрос.УстановитьПараметр("НачалоПериодаПоследующийТитул", ДатаНачала - 5 * СекундВДне);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ДатаОкончания);
	Запрос.УстановитьПараметр("ОкончаниеПериодаПоследующийТитул", ДатаОкончания + СекундВДне);
	
	Запрос.УстановитьПараметр("СписокГрузоотправителейВариантФильтрации", СценарийСсылка.СписокГрузоотправителейВариантФильтрации);
	Запрос.УстановитьПараметр("СписокПеревозчиковВариантФильтрации", СценарийСсылка.СписокПеревозчиковВариантФильтрации);
	Запрос.УстановитьПараметр("СписокГрузополучателейВариантФильтрации", СценарийСсылка.СписокГрузополучателейВариантФильтрации);
	Запрос.УстановитьПараметр("СписокГрузоотправителейДиадок", СценарийСсылка.СписокГрузоотправителейДиадок.ВыгрузитьКолонку("ОрганизацияДиадок"));
	Запрос.УстановитьПараметр("СписокПеревозчиковДиадок", СценарийСсылка.СписокПеревозчиковДиадок.ВыгрузитьКолонку("ОрганизацияДиадок"));
	Запрос.УстановитьПараметр("СписокГрузополучателейДиадок", СценарийСсылка.СписокГрузополучателейДиадок.ВыгрузитьКолонку("ОрганизацияДиадок"));
	
	Запрос.УстановитьПараметр("СписокПунктовМаршрутаОтправкиВариантФильтрации", СценарийСсылка.СписокПунктовМаршрутаОтправкиВариантФильтрации);
	Запрос.УстановитьПараметр("СписокПунктовМаршрутаПрибытияВариантФильтрации", СценарийСсылка.СписокПунктовМаршрутаПрибытияВариантФильтрации);
	Запрос.УстановитьПараметр("СписокПунктовМаршрутаОтправки", СценарийСсылка.СписокПунктовМаршрутаОтправки.ВыгрузитьКолонку("ПунктМаршрута"));
	Запрос.УстановитьПараметр("СписокПунктовМаршрутаПрибытия", СценарийСсылка.СписокПунктовМаршрутаПрибытия.ВыгрузитьКолонку("ПунктМаршрута"));
	
	Запрос.УстановитьПараметр("СписокСостоянийДокументооборотаВариантФильтрации", СценарийСсылка.СписокСостоянийДокументооборотаВариантФильтрации);
	Запрос.УстановитьПараметр("СписокСостоянийДокументооборота", СценарийСсылка.СписокСостоянийДокументооборота.ВыгрузитьКолонку("Состояние"));
	
	ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
	Для Каждого ФильтрСостояние Из СценарийСсылка.СписокСостоянийДокументооборота Цикл 
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(ФильтрСостояние.Состояние);
	КонецЦикла;
	Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", НЕ КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьОтправлятьТ2ДоВодителя"));
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-carrier-sign"));
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("r-wait-driver-approve"));
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", НЕ КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РазрешитьОтправлятьТ4ДоВодителя"));
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-carrier-sign"));
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("d-wait-driver-approve"));
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("completed")); //TODO изменить на "c-carrier-signed", когда вэб добавит статусы
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("c-wait-consignor-sign"));
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("c-wait-consignor-sign"));
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-checkupBefore"));
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-checkupBefore2ndDriver"));
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-techOrChekupBefore"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-checkupBefore"));
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-checkupBefore2ndDriver"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-techInspection"));
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-techOrChekupBefore"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-techInspection"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-wait-odometerBefore"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-on-the-way"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
		ТребуемыеСостояниеЭТРНДляОтправки = Новый Массив;
		ТребуемыеСостояниеЭТРНДляОтправки.Добавить(Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("zz-wait-carrier"));
		
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляОтправки", ТребуемыеСостояниеЭТРНДляОтправки);
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		Если СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.СогласованиеДокументов Тогда
			СостояниеДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("fr-сheck-cargo-owner");
			ТребуемыеСостояниеЭТРНДляСогласования = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СостояниеДО);
			
			Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляСогласования", ТребуемыеСостояниеЭТРНДляСогласования);
			
		ИначеЕсли СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьВходящихДокументов Тогда
			СостояниеДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("fr-сheck-forwarder");
			ТребуемыеСостояниеЭТРНДляПодписаниеВходящих = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СостояниеДО);
			
			Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляПодписаниеВходящих", ТребуемыеСостояниеЭТРНДляПодписаниеВходящих);
			
		КонецЕсли;
		
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
		
		Если СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.СогласованиеДокументов Тогда
			СостояниеДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("wr-сheck-cargo-owner");
			ТребуемыеСостояниеЭТРНДляСогласования = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СостояниеДО);
			
			Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляСогласования", ТребуемыеСостояниеЭТРНДляСогласования);
			
		ИначеЕсли СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ПодписьВходящихДокументов Тогда
			СостояниеДО = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("wr-сheck-forwarder");
			ТребуемыеСостояниеЭТРНДляПодписаниеВходящих = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СостояниеДО);
			
			Запрос.УстановитьПараметр("ТребуемыеСостояниеЭТРНДляПодписаниеВходящих", ТребуемыеСостояниеЭТРНДляПодписаниеВходящих);
			
		КонецЕсли;
		
	ИначеЕсли ТипЛогистика <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		// в Т1 запрос без этого параметра, а перед отправкой Т3 нет водителя
		Запрос.УстановитьПараметр("БлокироватьПредыдущимУчастникомЦепочки", Ложь);
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНДляОтправки", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка()); // все равно не попадем в кейс
		Запрос.УстановитьПараметр("ТребуемоеСостояниеЭТРНОжидания", Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ПустаяСсылка());
		
	КонецЕсли;
	
	Если Запрос.Параметры.Свойство("ТекущийПользователь") = Истина Тогда
		Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьФильтрСоединениеПоОрганизации(ТекстЗапроса, ВариантФильтрации, ИмяПараметраСписка, ИмяРеквизита)
	
	Если ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.УказатьСписок Тогда
		
		ШаблонТекста = "
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОрганизацииДиадок КАК ВТ_ОрганизацииДиадок_%1
			|	ПО ВТ_ОрганизацииДиадок_%1.Ссылка В (&%2)
			|		И втДокументы.%1 = ВТ_ОрганизацииДиадок_%1.СвязанныйОбъект";
		
		ТекстСоединения = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(ШаблонТекста,
			ИмяРеквизита, ИмяПараметраСписка);
		
	ИначеЕсли ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеКромеУказанных Тогда
		
		ШаблонТекста = "
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОрганизацииДиадок КАК ВТ_ОрганизацииДиадок_%1
			|	ПО НЕ ВТ_ОрганизацииДиадок_%1.Ссылка В (&%2)
			|		И втДокументы.%1 = ВТ_ОрганизацииДиадок_%1.СвязанныйОбъект";
		
		ТекстСоединения = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(ШаблонТекста,
			ИмяРеквизита, ИмяПараметраСписка);
		
	Иначе
		
		ТекстСоединения = "";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ТекстСоединения;
	
КонецПроцедуры

Процедура ДобавитьФильтрУсловиеПоОрганизации(ТекстЗапроса, ВариантФильтрации, ПутьДоРеквизита, ИмяПараметраСписка)
	
	Если ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.УказатьСписок Тогда
		
		ШаблонТекста = "%1 В (&%2)";
		
		ТекстУсловия = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			ШаблонТекста, ПутьДоРеквизита, ИмяПараметраСписка);
		
	ИначеЕсли ВариантФильтрации = Перечисления.КонтурЛогистика_ВариантыФильтрации.ВсеКромеУказанных Тогда
		
		ШаблонТекста = "НЕ %1 В (&%2)";
		
		ТекстУсловия = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(
			ШаблонТекста, ПутьДоРеквизита, ИмяПараметраСписка);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекстЗапроса = "" Тогда
		ТекстЗапроса = ТекстУсловия;
	Иначе
		ТекстЗапроса = ТекстЗапроса + "
			|И " + ТекстУсловия;
	КонецЕсли;
	
КонецПроцедуры

Функция ДополнитьЗапросСценарияПоТипуЛогистики(ТипЛогистика, ВходнойТекстЗапроса, СценарийСсылка)
		
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		ТекстВТОрганизацииДиадок = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка КАК Ссылка,
			|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.СвязанныйОбъект КАК СвязанныйОбъект
			|ПОМЕСТИТЬ ВТ_ОрганизацииДиадок
			|ИЗ
			|	Справочник.КонтурЛогистика_ОрганизацииДиадок.СвязанныеОбъекты КАК КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты
			|ГДЕ
			|	НЕ КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка.ПометкаУдаления";
		
		ТекстДополнительногоСоединенияИЗ = "";
		ДобавитьФильтрСоединениеПоОрганизации(ТекстДополнительногоСоединенияИЗ,
			СценарийСсылка.СписокГрузоотправителейВариантФильтрации,
			"СписокГрузоотправителейДиадок", "Отправитель");
		ДобавитьФильтрСоединениеПоОрганизации(ТекстДополнительногоСоединенияИЗ,
			СценарийСсылка.СписокПеревозчиковВариантФильтрации,
			"СписокПеревозчиковДиадок", "Перевозчик");
		ДобавитьФильтрСоединениеПоОрганизации(ТекстДополнительногоСоединенияИЗ,
			СценарийСсылка.СписокГрузополучателейВариантФильтрации,
			"СписокГрузополучателейДиадок", "Получатель");
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
			Если СценарийСсылка.ОбработкаОтказа Тогда
				ТекстУсловияОбработкиОтказа = "
					|	ИЛИ (КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние В(&СостоянияОтказа) И "
						+ СценарийСсылка.ДополнительноеУсловиеГДЕОбработкаОтказа + ")";
			Иначе
				ТекстУсловияОбработкиОтказа = "";
			КонецЕсли;
		
			Если СценарийСсылка.СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПЛТитул1ПослеСменыВодителя Тогда
				// Заменим имена таблиц и полей, так как документ основания другой и тип реквизитов организаций другой
				ТекстДополнительногоСоединенияИЗ = СтрЗаменить(
					ТекстДополнительногоСоединенияИЗ, "втДокументы.Отправитель", "ПодзапросТ5СоСменами.Грузоотправитель");
				ТекстДополнительногоСоединенияИЗ = СтрЗаменить(
					ТекстДополнительногоСоединенияИЗ, "втДокументы.Перевозчик", "ПодзапросТ5СоСменами.Перевозчик");
				ТекстДополнительногоСоединенияИЗ = СтрЗаменить(
					ТекстДополнительногоСоединенияИЗ, "втДокументы.Получатель", "ПодзапросТ5СоСменами.Грузополучатель");
				ТекстДополнительногоСоединенияИЗ = СтрЗаменить(
					ТекстДополнительногоСоединенияИЗ, ".СвязанныйОбъект", ".Ссылка");
				
				ТекстДополнительногоУсловия =
					"(ПодзапросТекущийТ1СоСменами.Ссылка ЕСТЬ NULL
					|	ИЛИ КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
					|	ИЛИ КонтурЛогистика_СтатусыТекущихТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)"
						+ ТекстУсловияОбработкиОтказа + ")";
			Иначе
				ТекстДополнительногоУсловия =
					"(КонтурЛогистика_ПЛ_Титул1.Ссылка ЕСТЬ NULL
					|	ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
					|	ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)"
						+ ТекстУсловияОбработкиОтказа + ")";						
			КонецЕсли;
								
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			
			ТекстДополнительногоУсловия =
				"(КонтурЛогистика_ЗЗ_Титул1.Ссылка ЕСТЬ NULL
				|	ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
				|	ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена))";
			
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			
			ТекстДополнительногоУсловия =
				"(КонтурЛогистика_ТрН_Титул1.Ссылка ЕСТЬ NULL
				|	ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
				|	ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена)
				|	ИЛИ ((КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена)
				|			ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен))
				|		И (&Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного)
				|			ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного)
				|			ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного)
				|			ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного)
				|			ИЛИ &Сценарий = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного))))";
			
		Иначе
			
