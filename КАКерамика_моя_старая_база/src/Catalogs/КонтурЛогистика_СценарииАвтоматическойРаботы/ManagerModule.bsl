		// Подписываем файлы
		Если ПараметрыФормированияФайловРеквизиты.ТребуетсяПодпись Тогда
			КоличествоСообщенийДо = ПолучитьСообщенияПользователю().Количество();
			МассивПодписанныхФайловОбмена = КонтурЛогистика_ИнтеграцияДиадокКлиентСервер.ПодписатьФайлыОбмена(
				МассивФайловОбмена,, БезПодписанияНаСервере);
			
			Если МассивПодписанныхФайловОбмена.Количество() = 0 Тогда
				// Не удалось подписать файл, фиксируем ошибку
				СообщенияПользователю = ПолучитьСообщенияПользователю();
				КоличествоСообщенийПосле = СообщенияПользователю.Количество();
				Если КоличествоСообщенийДо <> КоличествоСообщенийПосле Тогда
					ЗафиксироватьСообщения(СценарийСсылка, ВведенныеДокументы[0], СообщенияПользователю, КоличествоСообщенийДо);
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Добавим не подписанные
			МассивПодписанныхФайловОбмена = МассивФайловОбмена;
		КонецЕсли;
		
		РазностьМассивов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивФайловОбмена, МассивПодписанныхФайловОбмена);
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументыНаПодписание, РазностьМассивов);
		
		Если МассивПодписанныхФайловОбмена.Количество() > 0 Тогда
			
			Если СценарийСсылка.Сценарий = Перечисления.КонтурЛогистика_СценарииАвтоматическойРаботы.ВводЧерновиковПодписьИПодготовкаКОтправке Тогда
				
				// Ранее здесь использовался перевод титула в статус подготовлен к отправке.
				// Теперь, когда у титулов появился статус "Подписан", это не требуется
				// Выполнение обмена отправит в фоне титулы в статусе "Подписан"
				
