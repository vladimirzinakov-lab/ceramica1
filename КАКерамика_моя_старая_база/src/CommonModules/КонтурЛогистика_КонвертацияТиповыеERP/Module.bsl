		ТЧТоварыОснования = ПолучитьТЧТовары(ТекДокОснование);
		
		ЕстьПризнакТары = ЕстьПризнакТары(ТЧТоварыОснования);
		
		Для Каждого ТекущаяСтрока Из ТЧТоварыОснования Цикл
			
			Если ЭтоТара(ТекущаяСтрока, ИспользоватьМногооборотнуюТару, ЕстьПризнакТары) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ВидТары = ВидТары;
			НоваяСтрока.СпособУпаковки = "В таре";
			НоваяСтрока.ИдентификаторыЕГАИС = ТекДокОснование.алкНомерФиксацииВЕГАИС;
			
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока);
					
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ТрН_Титул3_ПриобретениеТоваровУслуг(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументЭТРН = ДокументОбъект.ДокументЭТРН;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
		|ГДЕ
		|	НЕ ПриобретениеТоваровУслуг.ПометкаУдаления
		|	И ПриобретениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И НАЧАЛОПЕРИОДА(ПриобретениеТоваровУслуг.ДатаВходящегоДокумента, ДЕНЬ) = &ДатаВходящегоДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПриобретениеТоваровУслуг.Ссылка УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаВходящегоДокумента", ДокументЭТРН.ДатаТрН);
	Запрос.УстановитьПараметр("НомерВходящегоДокумента", ДокументЭТРН.НомерТрН);
	
	Если КонтекстНастройкиКонвертации.ТолькоПроведенные Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕ ПриобретениеТоваровУслуг.ПометкаУдаления", 
												 "НЕ ПриобретениеТоваровУслуг.ПометкаУдаления
												  |	И ПриобретениеТоваровУслуг.Проведен");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДокументОснование = ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		ДокументОснование = Неопределено;
	КонецЕсли;
	
	ДокументОбъект.ДокументОснование = ДокументОснование;
	ДокументОбъект.ОбщееСостояние = "Без замечаний";
		
	ДокументОбъект.ФДатВрУбыт = ТекущаяДатаСеанса();
	
	ПродолжительностьРазгрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СредняяПродолжительностьРазгрузки", ДокументЭТРН.ПартнерГрузополучатель);
	Если ТипЗнч(ПродолжительностьРазгрузки) = Тип("Число") Тогда
		ФДатВрПриб = ДокументОбъект.ФДатВрУбыт - ПродолжительностьРазгрузки * 60;
	Иначе
		ФДатВрПриб = ДокументОбъект.ФДатВрУбыт - 2 * 60 * 60;
	КонецЕсли;
	ДокументОбъект.ФДатВрПриб = ФДатВрПриб;
	
	ЗаявДатВрПриб = ДокументЭТРН.ДатаВремяДоставки;
	ДокументОбъект.ЗаявДатВрПриб = ?(ЗначениеЗаполнено(ЗаявДатВрПриб),ЗаявДатВрПриб,ФДатВрПриб);
	
	ИспользоватьМногооборотнуюТару = ПолучитьФункциональнуюОпцию("ИспользоватьМногооборотнуюТару");
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ТЧТоварыОснования = ПолучитьТЧТовары(ДокументОснование);
		
		ЕстьПризнакТары = ЕстьПризнакТары(ТЧТоварыОснования);
		
		// ТЧ Товары
		Для Каждого ТекущаяСтрока Из ТЧТоварыОснования Цикл
			
			Если ЭтоТара(ТекущаяСтрока, ИспользоватьМногооборотнуюТару, ЕстьПризнакТары) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ТоварыДокументаУчетнойСистемы.Добавить();
				
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь);
					
		КонецЦикла;
		
		ДокументОбъект.СопоставитьТоварыАвтоматически();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ПЛ_Титул1_ЗаданиеНаПеревозку(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ДокументОбъект.СрокПЛ = ДокументОснование.ДатаВремяРейсаПланПо;
