		ТСТип = ДокументОснование.ЗаданиеНаПеревозку.АвтомобильТип;
		ДатВрПод = ДокументОснование.ЗаданиеНаПеревозку.ДатаВремяРейсаПланС;
	Иначе
		Перевозчик = ДокументОснование.Перевозчик;
		ТСВместим = ДокументОснование.АвтомобильВместимостьВКубическихМетрах;
		ТСГрузопод = ДокументОснование.АвтомобильГрузоподъемностьВТоннах;
		ТСТип = ДокументОснование.АвтомобильТип;
		ДатВрПод = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.ДатВрПод = ДатВрПод;
	ДокументОбъект.НомЗак = ДокументОснование.Номер;
	ДокументОбъект.ПрвзПищПрод = "Отсутствуют";
	ДокументОбъект.ПредСрПрвз = "Отсутствуют";
	ДокументОбъект.ТСТип = "Грузовой";
	ДокументОбъект.Функция = Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.Заказ;
	ДокументОбъект.КонПунктМрш = ДокументОснование.АдресДоставки;
	
