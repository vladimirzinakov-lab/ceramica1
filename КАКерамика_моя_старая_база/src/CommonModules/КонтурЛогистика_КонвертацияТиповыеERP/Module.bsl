Процедура ЗаполнитьСправочник_Сотрудники(КонтекстНастройкиКонвертации, УчетныйОбъект, ДокументОснование, ДокументОбъект, Переменные, Результат)
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"РольВодитель", (КонтекстНастройкиКонвертации.РеквизитТитула = "Водитель"));
	КонецЕсли;	
		
	Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Если Переменные.Свойство("ТрН") Тогда
			
			ТрН = Переменные.ТрН;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВУНомер", ТрН.УдостоверениеНомер, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВУСерия", ТрН.УдостоверениеСерия, ОбновлятьРеквизиты);
			
			// ФИО
			ВключатьПустые = Ложь;
			ДанныеФИО = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ТрН.Водитель, " ", ВключатьПустые);
			Если ДанныеФИО.Количество() > 1 Тогда
				
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Имя", ДанныеФИО[1], ОбновлятьРеквизиты);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Фамилия", ДанныеФИО[0], ОбновлятьРеквизиты);
				
				Если ДанныеФИО.Количество() > 3 Тогда
					Отчество = ДанныеФИО[2] + " " + ДанныеФИО[3];
				ИначеЕсли ДанныеФИО.Количество() > 2 Тогда
					Отчество = ДанныеФИО[2];
				КонецЕсли;
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Отчество", Отчество, ОбновлятьРеквизиты);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
			ВУНомер = ДокументОснование.ЗаданиеНаПеревозку.УдостоверениеНомер;
			ВУСерия = ДокументОснование.ЗаданиеНаПеревозку.УдостоверениеСерия;
		Иначе
			ВУНомер = ДокументОснование.УдостоверениеНомер;
			ВУСерия = ДокументОснование.УдостоверениеСерия;
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУНомер", ВУНомер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУСерия", ВУСерия, ОбновлятьРеквизиты);
		
		// ФИО
		ВключатьПустые = Ложь;
		ДанныеФИО = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(УчетныйОбъект, " ", ВключатьПустые);
		Если ДанныеФИО.Количество() > 1 Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Имя", ДанныеФИО[1], ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Фамилия", ДанныеФИО[0], ОбновлятьРеквизиты);
			
			Если ДанныеФИО.Количество() > 3 Тогда
				Отчество = ДанныеФИО[2] + " " + ДанныеФИО[3];
			ИначеЕсли ДанныеФИО.Количество() > 2 Тогда
				Отчество = ДанныеФИО[2];
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Отчество", Отчество, ОбновлятьРеквизиты);
			
		КонецЕсли;
	
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаРождения", УчетныйОбъект.ДатаРождения, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
		
		// Контактная информация
		ТелефонОсновной = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
			УчетныйОбъект, "МобильныйТелефон");
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ТелефонОсновной", ТелефонОсновной);
		
		// ФИО
		ВключатьПустые = Ложь;
		ДанныеФИО = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(УчетныйОбъект.Наименование, " ", ВключатьПустые);
		Если ДанныеФИО.Количество() > 1 Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Имя", ДанныеФИО[1], ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Фамилия", ДанныеФИО[0], ОбновлятьРеквизиты);
			
			Если ДанныеФИО.Количество() > 3 Тогда
				Отчество = ДанныеФИО[2] + " " + ДанныеФИО[3];
			ИначеЕсли ДанныеФИО.Количество() > 2 Тогда
				Отчество = ДанныеФИО[2];
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Отчество", Отчество, ОбновлятьРеквизиты);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСправочник_ПунктыМаршрута(КонтекстНастройкиКонвертации, УчетныйОбъект, ДокументОснование, ДокументОбъект, Результат)
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента")) Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфАдрес", ДокументОснование.АдресДоставки, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Прибытие", Истина, ОбновлятьРеквизиты);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
	
		Если КонтекстНастройкиКонвертации.РеквизитТитула = "МестоДоставки" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфАдрес", ДокументОснование.АдресДоставки, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Прибытие", Истина, ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.РеквизитТитула = "МестоПогрузки"
			Или КонтекстНастройкиКонвертации.РеквизитТитула = "ПунктПод" Тогда
			
			Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.Грузоотправитель, "Грузоотправитель",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфАдрес", ДокументОснование.АдресПогрузки, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Собственник", Собственник, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Отправление", Истина, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наш", Истина, ОбновлятьРеквизиты);
			
		КонецЕсли;	
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Склады" Тогда
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Попытка
				// Может не быть у документа основания реквизита организация
				Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ДокументОснование.Организация, "Грузоотправитель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
						"Собственник", Собственник, ОбновлятьРеквизиты);
			Исключение
				НичегоНеДелаем = Истина;
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Если КонтекстНастройкиКонвертации.РеквизитТитула = "МестоПогрузки" Тогда
				Направление = "Отправление";
			Иначе
				Направление = "Прибытие";
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				Направление, Истина, ОбновлятьРеквизиты);
		КонецЕсли;
		
		АдресИнфАдрес = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
			УчетныйОбъект, "АдресСклада");
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфАдрес", АдресИнфАдрес, ОбновлятьРеквизиты);
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
				
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "алкПунктыРазгрузки" Тогда
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			
			Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				УчетныйОбъект.Владелец, "Грузоотправитель",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);			
			Если ЗначениеЗаполнено(Собственник) Тогда
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Собственник", Собственник, ОбновлятьРеквизиты);
			КонецЕсли;
			
			Если КонтекстНастройкиКонвертации.РеквизитТитула = "МестоПогрузки" Тогда
				Направление = "Отправление";
			Иначе
				Направление = "Прибытие";
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				Направление, Истина, ОбновлятьРеквизиты);
			
		КонецЕсли;			
					
		АдресИнфАдрес = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
			УчетныйОбъект, "АдресПунктаРазгрузки");
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфАдрес", АдресИнфАдрес, ОбновлятьРеквизиты);
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСправочник_ТранспортныеСредства(КонтекстНастройкиКонвертации, УчетныйОбъект, ДокументОснование, ДокументОбъект, Переменные, Результат)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И КонтекстНастройкиКонвертации.ЭтоКТ2000
		И Переменные.Свойство("ТранспортнаяИнформация") Тогда
		
		ПараметрыТС = ИнициализироватьПараметрыТС();
		ЗаполнитьЗначенияСвойств(ПараметрыТС, Переменные.ТранспортнаяИнформация);
	
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров"))
		И Переменные.Свойство("ТрН") Тогда
		
		ТрН = Переменные.ТрН;
	
		ПараметрыТС = ИнициализироватьПараметрыТС();
		ЗаполнитьЗначенияСвойств(ПараметрыТС, ТрН);
		ПараметрыТС.ВместимостьВКубическихМетрах = ТрН.АвтомобильВместимостьВКубическихМетрах;
		ПараметрыТС.ГрузоподъемностьВТоннах = ТрН.АвтомобильГрузоподъемностьВТоннах;
		ПараметрыТС.Марка = ТрН.АвтомобильМарка;
		ПараметрыТС.ГосударственныйНомер = ТрН.АвтомобильГосударственныйНомер;
		ПараметрыТС.Тип = ТрН.АвтомобильТип;
				
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		ИспользоватьЗадания = ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками");
		Если ИспользоватьЗадания Тогда
			ДокументОснованиеЛок = ДокументОснование.ЗаданиеНаПеревозку;
		Иначе
			ДокументОснованиеЛок = ДокументОснование;
		КонецЕсли;
		
		ПараметрыТС = ИнициализироватьПараметрыТС();
		ЗаполнитьЗначенияСвойств(ПараметрыТС, ДокументОснованиеЛок);
		ПараметрыТС.ВместимостьВКубическихМетрах = ДокументОснованиеЛок.АвтомобильВместимостьВКубическихМетрах;
		ПараметрыТС.ГрузоподъемностьВТоннах = ДокументОснованиеЛок.АвтомобильГрузоподъемностьВТоннах;
		ПараметрыТС.Марка = ДокументОснованиеЛок.АвтомобильМарка;
		ПараметрыТС.ГосударственныйНомер = ДокументОснованиеЛок.АвтомобильГосударственныйНомер;
		ПараметрыТС.Тип = ДокументОснованиеЛок.АвтомобильТип;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТипыТранспортныхСредств" Тогда
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда			
			ДокументОснованиеЛок = ДокументОснование;		
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда			
			ИспользоватьЗадания = ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками");
			Если ИспользоватьЗадания Тогда
				ДокументОснованиеЛок = ДокументОснование.ЗаданиеНаПеревозку;
			Иначе
				ДокументОснованиеЛок = ДокументОснование;
			КонецЕсли;			
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда			
			Если Переменные.Свойство("ТрН") Тогда
				ДокументОснованиеЛок = Переменные.ТрН;
			Иначе
				Возврат;
			КонецЕсли;			
		Иначе			
			Возврат;			
		КонецЕсли;
		
		ПараметрыТС = ИнициализироватьПараметрыТС();
		ЗаполнитьЗначенияСвойств(ПараметрыТС, УчетныйОбъект);
		ЗаполнитьЗначенияСвойств(ПараметрыТС, ДокументОснованиеЛок);
		ПараметрыТС.Марка = ДокументОснованиеЛок.АвтомобильМарка;
		ПараметрыТС.ГосударственныйНомер = ДокументОснованиеЛок.АвтомобильГосударственныйНомер;
		ПараметрыТС.Тип = ДокументОснованиеЛок.АвтомобильТип;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортныеСредства" Тогда
		
		ПараметрыТС = ИнициализироватьПараметрыТС();
		ЗаполнитьЗначенияСвойств(ПараметрыТС, УчетныйОбъект);
		ПараметрыТС.ГосударственныйНомер = УчетныйОбъект.Код;
		
	КонецЕсли;
	
	Если Не ПараметрыТС = Неопределено Тогда
		ЭтоПрицеп = (КонтекстНастройкиКонвертации.РеквизитТитула = "Прицеп");
		РассчитатьРеквизитыТС(КонтекстНастройкиКонвертации, Результат, ПараметрыТС, ЭтоПрицеп);
	КонецЕсли;
	
КонецПроцедуры

Функция ИнициализироватьПараметрыТС()
	
	ПараметрыТС = Новый Структура;
	ПараметрыТС.Вставить("ВместимостьВКубическихМетрах");
	ПараметрыТС.Вставить("ГрузоподъемностьВТоннах");
	ПараметрыТС.Вставить("Прицеп");
	ПараметрыТС.Вставить("ГосударственныйНомерПрицепа");
	ПараметрыТС.Вставить("Марка");
	ПараметрыТС.Вставить("ГосударственныйНомер");
	ПараметрыТС.Вставить("Тип");
	
	Возврат ПараметрыТС;
	
КонецФункции

Процедура РассчитатьРеквизитыТС(КонтекстНастройкиКонвертации, Результат, Знач ПараметрыТС, Знач ЭтоПрицеп)
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если ЭтоПрицеп Тогда
	
		ВместимостьКубМ = ПараметрыТС.ВместимостьВКубическихМетрах;
		ГрузоподъемностьТонн = ПараметрыТС.ГрузоподъемностьВТоннах;
		МаркаТС = ПараметрыТС.Прицеп;
		РегНомер = ПараметрыТС.ГосударственныйНомерПрицепа;
		ТипТС = "Прицеп";
		
	Иначе
		
		Если ЗначениеЗаполнено(ПараметрыТС.ГосударственныйНомерПрицепа) Тогда
			ВместимостьКубМ = 0;
			ГрузоподъемностьТонн = 0;
		Иначе
			ВместимостьКубМ = ПараметрыТС.ВместимостьВКубическихМетрах;
			ГрузоподъемностьТонн = ПараметрыТС.ГрузоподъемностьВТоннах;
		КонецЕсли;
		
		МаркаТС = ПараметрыТС.Марка;
		РегНомер = ПараметрыТС.ГосударственныйНомер;
		ТипТС = ПараметрыТС.Тип;
		
	КонецЕсли;
	
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"ВместимостьКубМ", ВместимостьКубМ, ОбновлятьРеквизиты);
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"ГрузоподъемностьТонн", ГрузоподъемностьТонн, ОбновлятьРеквизиты);
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"МаркаТС", МаркаТС, ОбновлятьРеквизиты);
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"РегНомер", РегНомер, ОбновлятьРеквизиты);
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"ТипТС", ТипТС, ОбновлятьРеквизиты);
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"ВидВладения", Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1, ОбновлятьРеквизиты);
	КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
		"ЭтоПрицеп", ЭтоПрицеп, ОбновлятьРеквизиты);
	
КонецПроцедуры

Функция РассчитатьГО_РТУ_ЗаказКлиента(ДокументОснование)
	Возврат ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель), ДокументОснование.Грузоотправитель, ДокументОснование.Организация);
КонецФункции

Функция РассчитатьГП_РТУ(ДокументОснование)
	Возврат ?(ЗначениеЗаполнено(ДокументОснование.Грузополучатель), ДокументОснование.Грузополучатель, ДокументОснование.Контрагент);
КонецФункции

Функция РассчитатьГП_ПеремещениеТоваров(ДокументОснование)
	Возврат ?(ЗначениеЗаполнено(ДокументОснование.ОрганизацияПолучатель), ДокументОснование.ОрганизацияПолучатель, ДокументОснование.Организация);
КонецФункции

Процедура ЗаполнитьПутиРеквизитов_РТУ_ЗаказКлиента(Контекст)
	
	Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
	ИмяТаблицы = Контекст.ТипДокумента1С;
	
	Пути.ПутьОрганизация = "Организация";
	Пути.ПутьКонтрагент = "Контрагент";
	Пути.ПутьГрузоотправитель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
		ИмяТаблицы, "Грузоотправитель", "Организация", ИмяТаблицы);
	Пути.ПутьГрузополучатель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
		ИмяТаблицы, "Грузополучатель", "Контрагент", ИмяТаблицы);
		
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьРеквизитДокумента_("ПеревозчикПартнер", ИмяТаблицы) Тогда
		Пути.ПутьПеревозчик = "ПеревозчикПартнер";
	КонецЕсли;
	
	Пути.ПутьДатаТРН = "Дата";
	Пути.ПутьНомерТРН = "Номер";
	Пути.ПутьМестоДоставки = "АдресДоставки";
	Пути.ПутьМестоПогрузки = "Склад";
	
КонецПроцедуры

Процедура ЗаполнитьПутиРеквизитов_ПеремещениеТоваров(Контекст)
	
	ИмяТаблицы = "ПеремещениеТоваров";
	Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
	
	Пути.ПутьОрганизация = "Организация";
	Пути.ПутьГрузоотправитель = "Организация";
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьРеквизитДокумента_("ОрганизацияПолучатель", ИмяТаблицы) Тогда
		Пути.ПутьГрузополучатель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
			ИмяТаблицы, "ОрганизацияПолучатель", "Организация", ИмяТаблицы);
	Иначе
		Пути.ПутьГрузополучатель = "Организация";
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьРеквизитДокумента_("ПеревозчикПартнер", ИмяТаблицы) Тогда
		Пути.ПутьПеревозчик = "ПеревозчикПартнер";
	КонецЕсли;
	
	Пути.ПутьДатаТРН = "Дата";
	Пути.ПутьНомерТРН = "Номер";
	Пути.ПутьМестоДоставки = "СкладПолучатель";
	Пути.ПутьМестоПогрузки = "СкладОтправитель";
	
КонецПроцедуры

Процедура ЗаполнитьПутиРеквизитов_ЗаданиеНаПеревозку(Контекст)
	
	ИмяТаблицы = "ЗаданиеНаПеревозку";
	Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
	
	Пути.ПутьКонтрагент = "Контрагент";
		
	Пути.ПутьПеревозчик = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
			ИмяТаблицы, "Перевозчик", "Контрагент", ИмяТаблицы);
	
	Пути.ПутьДатаТРН = "Дата";
	Пути.ПутьНомерТРН = "Номер";
	Пути.ПутьМестоПогрузки = "Склад";
	
КонецПроцедуры

Процедура ЗаполнитьБазовыеНастройки_КТ2000(Контекст)
	
	Если Контекст.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
		Контекст.ДополнительныеИсточники = 
			"Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.алкТранспортнаяИнформация КАК алкТранспортнаяИнформация
			|	ПО РеализацияТоваровУслуг.Ссылка = алкТранспортнаяИнформация.Объект
			|		И (алкТранспортнаяИнформация.Перевозчик <> НЕОПРЕДЕЛЕНО)";
		
	ИначеЕсли Контекст.ТипДокумента1С = "ПеремещениеТоваров" Тогда
		
		Контекст.ДополнительныеИсточники = 
			"Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.алкТранспортнаяИнформация КАК алкТранспортнаяИнформация
			|	ПО ПеремещениеТоваров.Ссылка = алкТранспортнаяИнформация.Объект
			|		И (алкТранспортнаяИнформация.Перевозчик <> НЕОПРЕДЕЛЕНО)";
		
	КонецЕсли;
	
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьПеревозчик = "алкТранспортнаяИнформация.Перевозчик";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьВодитель = "алкТранспортнаяИнформация.Водитель";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьТранспортноеСредство = "алкТранспортнаяИнформация.ТранспортноеСредство";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьГрузоотправитель = "алкПунктРазгрузкиОрганизации.Владелец";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьГрузополучатель = "алкПунктРазгрузки.Владелец";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьДатаТРН = "алкТранспортнаяИнформация.ДатаТН";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьНомерТРН = "алкТранспортнаяИнформация.НомерТН";			
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьМестоДоставки = "алкПунктРазгрузки";
	Контекст.ПутиРеквизитовУчетногоДокумента.ПутьМестоПогрузки = "алкПунктРазгрузкиОрганизации";
	
	// Рандомно возникают проблемы с добавлением доп. колонок
	//ОписаниеКолонки = КонтурЛогистика_КонвертацияСерверПовтИсп.МанифестОписанияДоплнительнойКолонки();
	//ОписаниеКолонки.Вставить("Заголовок", "Заказчик");
	//ОписаниеКолонки.Вставить("ПутьКДанным", "алкТранспортнаяИнформация.Заказчик");
	//ОписаниеКолонки.Вставить("ДобавленИзКонструктораЗапроса", Истина);
	//
	//Контекст.ДополнительныеКолонки.Добавить(ОписаниеКолонки);
	
КонецПроцедуры

Функция РассчитатьРеквизитыПогрузкиРазгрузки_КТ2000(ДокументОбъект,
													ДокументОснование,
													Грузоотправитель,
													Грузополучатель,
													МестоПогрузки,
													МестоДоставки)
													
	РеквизитыПогрузкиРазгрузки = Новый Структура;
	
	Если ЗначениеЗаполнено(ДокументОснование.алкПунктРазгрузкиОрганизации) Тогда
		
		РеквизитыПогрузкиРазгрузки.Вставить("Грузоотправитель", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.алкПунктРазгрузкиОрганизации.Владелец, "Грузоотправитель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект)); 
			
		РеквизитыПогрузкиРазгрузки.Вставить("МестоПогрузки", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.алкПунктРазгрузкиОрганизации, "МестоПогрузки",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект));
			
	Иначе
		
		РеквизитыПогрузкиРазгрузки.Вставить("Грузоотправитель", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Грузоотправитель, "Грузоотправитель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект));
		
		РеквизитыПогрузкиРазгрузки.Вставить("МестоПогрузки", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			МестоПогрузки, "МестоПогрузки",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект));
		
	КонецЕсли;
		
	РеквизитыПогрузкиРазгрузки.Вставить("ПунктПод", РеквизитыПогрузкиРазгрузки.МестоПогрузки);
	
	Если ЗначениеЗаполнено(ДокументОснование.алкПунктРазгрузки) Тогда
		
		РеквизитыПогрузкиРазгрузки.Вставить("Грузополучатель", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.алкПунктРазгрузки.Владелец, "Грузополучатель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект));
					
		РеквизитыПогрузкиРазгрузки.Вставить("МестоДоставки", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.алкПунктРазгрузки, "МестоДоставки",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект));
			
		Если РеквизитыПогрузкиРазгрузки.МестоДоставки = РеквизитыПогрузкиРазгрузки.МестоПогрузки Тогда
				
			РеквизитыПогрузкиРазгрузки.Вставить("МестоДоставки", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				МестоДоставки, "МестоДоставки",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
				ДокументОснование, ДокументОбъект));
				
			Если ТипЗнч(МестоДоставки) = Тип("Строка") Тогда			
				РеквизитыПогрузкиРазгрузки.Вставить("КонПунктМрш", МестоДоставки);			
			Иначе			
				РеквизитыПогрузкиРазгрузки.Вставить("КонПунктМрш", КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
					МестоДоставки, "АдресСклада"));			
			КонецЕсли;
				
		Иначе
				
			РеквизитыПогрузкиРазгрузки.Вставить("КонПунктМрш", КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
				ДокументОснование.алкПунктРазгрузки, "АдресПунктаРазгрузки"));		
				
		КонецЕсли;
			
	Иначе
			
		РеквизитыПогрузкиРазгрузки.Вставить("Грузополучатель", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Грузополучатель, "Грузополучатель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект));
				
		РеквизитыПогрузкиРазгрузки.Вставить("МестоДоставки", КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			МестоДоставки, "МестоДоставки",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект));
			
		Если ТипЗнч(МестоДоставки) = Тип("Строка") Тогда			
			РеквизитыПогрузкиРазгрузки.Вставить("КонПунктМрш", МестоДоставки);			
		Иначе			
			РеквизитыПогрузкиРазгрузки.Вставить("КонПунктМрш", КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
				МестоДоставки, "АдресСклада"));			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат РеквизитыПогрузкиРазгрузки;
	
КонецФункции

// Добавляет заказ клиента РТУ в массив связанных оснований (без дублей).
// Сначала шапка ЗаказКлиента, если пусто — первая строка ТЧ Товары с заказом.
//
Процедура ДобавитьЗаказКлиентаРТУВМассив(ДокументРТУ, МассивОснований)
	
	Если Не КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументРТУ, "РеализацияПоЗаказам") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДокументРТУ.РеализацияПоЗаказам Тогда
		Возврат;
	КонецЕсли;
			
	Если ЗначениеЗаполнено(ДокументРТУ.ЗаказКлиента)
		И МассивОснований.Найти(ДокументРТУ.ЗаказКлиента) = Неопределено Тогда
		
		МассивОснований.Добавить(ДокументРТУ.ЗаказКлиента);
		
	ИначеЕсли Не ЗначениеЗаполнено(ДокументРТУ.ЗаказКлиента)
		И ДокументРТУ.Товары.Количество() > 0 Тогда
		
		Для Каждого СтрокаТоваров Из ДокументРТУ.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТоваров.ЗаказКлиента)
				И МассивОснований.Найти(СтрокаТоваров.ЗаказКлиента) = Неопределено Тогда
				
				МассивОснований.Добавить(СтрокаТоваров.ЗаказКлиента);
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ДобавитьСвязаннуюТранспортнуюНакладную(Знач ДокументОснование, Переменные)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);	
	Запрос.Текст = ТекстЗапросаПоискТрНПоОснованию();	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Переменные.Вставить("ТрН", Выборка.Ссылка);
	КонецЕсли;	
	
КонецФункции

Функция ДобавитьТранспортнуюИнформацию(Знач ДокументОснование, Переменные)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаКТ2000();		
	Запрос.УстановитьПараметр("Объект", ДокументОснование);	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Переменные.Вставить("ТранспортнаяИнформация", Запрос.Выполнить().Выгрузить()[0]);
	КонецЕсли;
	
КонецФункции

Функция ВычислитьКонтрагентаИзПеревозчикаПартнера(ПеревозчикПартнер)
	
	Если Не ЗначениеЗаполнено(ПеревозчикПартнер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Партнер = &Партнер
		|	И НЕ Контрагенты.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Ссылка УБЫВ";
	
	Запрос.УстановитьПараметр("Партнер", ПеревозчикПартнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает габариты и массу на 1 упаковку / единицу номенклатуры (семейство ERP).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения, Неопределено - упаковка или единица измерения
//
// Возвращаемое значение:
//  Структура:
//   * Высота - Число
//   * Длина - Число
//   * Ширина - Число
//   * ОбъемКубМ - Число
//   * МассаКг - Число
//   * ЭтоУпаковка - Булево
//
Функция ВесогабаритныеПараметрыГруза(Номенклатура, Упаковка = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Высота", 0);
	Результат.Вставить("Длина", 0);
	Результат.Вставить("Ширина", 0);
	Результат.Вставить("ОбъемКубМ", 0);
	Результат.Вставить("МассаКг", 0);
	Результат.Вставить("ЭтоУпаковка", Ложь);
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка)
		И ЗначениеЗаполнено(Упаковка.ЕдиницаИзмерения) Тогда
		
		Результат.ЭтоУпаковка = Истина;
		Результат.МассаКг = Упаковка.Вес;
		Результат.Высота = Упаковка.Высота;
		Результат.Длина = Упаковка.Глубина;
		Результат.Ширина = Упаковка.Ширина;
		Результат.ОбъемКубМ = Упаковка.Объем;
		
	Иначе
		
		Если ЗначениеЗаполнено(Номенклатура.ВесЕдиницаИзмерения) Тогда
			ВесЗнаменатель = Номенклатура.ВесЕдиницаИзмерения.Знаменатель;
		Иначе
			ВесЗнаменатель = Номенклатура.ВесЗнаменатель;
		КонецЕсли;
		
		Если ВесЗнаменатель > 0 Тогда
			Результат.МассаКг = Номенклатура.ВесЧислитель / ВесЗнаменатель;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Номенклатура.ОбъемЕдиницаИзмерения) Тогда
			ОбъемЗнаменатель = Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель;
		Иначе
			ОбъемЗнаменатель = Номенклатура.ОбъемЗнаменатель;
		КонецЕсли;
		
		Если ОбъемЗнаменатель > 0 Тогда
			Результат.ОбъемКубМ = Номенклатура.ОбъемЧислитель / ОбъемЗнаменатель;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура РассчитатьПараметрыГруза(Знач ТекущаяСтрока, НоваяСтрока, ЭтоТ1 = Истина, ЭтоПЭ1 = Ложь)
	
	Попытка 
		НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки;
	Исключение
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецПопытки;
	НоваяСтрока.ОтгрузочноеНаименование = ТекущаяСтрока.Номенклатура.Наименование;
	
	НоваяСтрока.Количество = ТекущаяСтрока.Количество;
	НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
	НоваяСтрока.Характеристика = ТекущаяСтрока.Характеристика;
	НоваяСтрока.Учитывать = Истина;
	
	Если Не ЭтоПЭ1 Тогда
		НоваяСтрока.СостояниеГруза = "Без замечаний";
	КонецЕсли;
	
	ПараметрыГруза = ВесогабаритныеПараметрыГруза(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Упаковка);
	МассаБрутто = 0;
	
	Если ПараметрыГруза.ЭтоУпаковка Тогда
		
		НоваяСтрока.Количество = ТекущаяСтрока.КоличествоУпаковок;
		НоваяСтрока.УпаковкаЕдиницаИзмерения = ТекущаяСтрока.Упаковка.ЕдиницаИзмерения;
		МассаБрутто = НоваяСтрока.Количество * ПараметрыГруза.МассаКг;
		
		Если ЭтоТ1 Тогда
			НоваяСтрока.МассаПлановаяБруттоКг = МассаБрутто;
			НоваяСтрока.Высота = ПараметрыГруза.Высота;
			НоваяСтрока.Длина = ПараметрыГруза.Длина;
			НоваяСтрока.Ширина = ПараметрыГруза.Ширина;
		Иначе
			НоваяСтрока.МассаБруттоКг = МассаБрутто;
		КонецЕсли;
		
		НоваяСтрока.ОбъемКубМ = НоваяСтрока.Количество * ПараметрыГруза.ОбъемКубМ;
		
		Если ЭтоПЭ1 Тогда
			НоваяСтрока.НалУпак = Истина;
			НоваяСтрока.МассаНеттоКг = МассаБрутто;
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока.Количество = ТекущаяСтрока.Количество;
		НоваяСтрока.УпаковкаЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.ЕдиницаИзмерения;
		МассаБрутто = НоваяСтрока.Количество * ПараметрыГруза.МассаКг;
		
		Если ЭтоТ1 Тогда
			НоваяСтрока.МассаПлановаяБруттоКг = МассаБрутто;
		Иначе
			НоваяСтрока.МассаБруттоКг = МассаБрутто;
		КонецЕсли;
		
		НоваяСтрока.ОбъемКубМ = НоваяСтрока.Количество * ПараметрыГруза.ОбъемКубМ;
		
		Если ЭтоПЭ1 Тогда
			НоваяСтрока.МассаНеттоКг = МассаБрутто;
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
	
КонецПроцедуры

Функция ЕстьПризнакТары(Знач ТЧТоварыОснования)
	
	ЕстьПризнакТары = Ложь;
	Если ТЧТоварыОснования.Количество() > 0
		И КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъектаЛок(ТЧТоварыОснования[0], "ЭтоТара") Тогда
		ЕстьПризнакТары = Истина;
	КонецЕсли;
	
	Возврат ЕстьПризнакТары;
	
КонецФункции

Функция ЭтоТара(Знач ТекущаяСтрока, Знач ИспользоватьМногооборотнуюТару, Знач ЕстьПризнакТары)
	
	ЭтоТара = Ложь;
	
	Если ИспользоватьМногооборотнуюТару Тогда
					
		Если ЕстьПризнакТары Тогда
			
			Если ТекущаяСтрока.ЭтоТара Тогда
				ЭтоТара = Истина;
			КонецЕсли;
			
		Иначе
			
			Если ТекущаяСтрока.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = 
				ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МногооборотнаяТара") Тогда								
				ЭтоТара = Истина;							
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЭтоТара;
	
КонецФункции

Функция ПолучитьТЧТовары(Знач ДокОсн)
	
	Если ТипЗнч(ДокОсн) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат ПолучитьТЧТоварыРТУ(ДокОсн);
	ИначеЕсли ТипЗнч(ДокОсн) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Возврат ПолучитьТЧТоварыПеремещение(ДокОсн);
	ИначеЕсли ТипЗнч(ДокОсн) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Возврат ПолучитьТЧТоварыЗаказКлиента(ДокОсн);
	Иначе
		Возврат ДокОсн.Товары;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьТЧТоварыРТУ(Знач ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка,
		|	РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
		|	РеализацияТоваровУслугТовары.Назначение КАК Назначение,
		|	РеализацияТоваровУслугТовары.Упаковка КАК Упаковка,
		|	РеализацияТоваровУслугТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	РеализацияТоваровУслугТовары.Количество КАК Количество,
		|	РеализацияТоваровУслугТовары.ВидЦены КАК ВидЦены,
		|	РеализацияТоваровУслугТовары.Цена КАК Цена,
		|	РеализацияТоваровУслугТовары.Сумма КАК Сумма,
		|	РеализацияТоваровУслугТовары.СтавкаНДС КАК СтавкаНДС,
		|	РеализацияТоваровУслугТовары.СуммаНДС КАК СуммаНДС,
		|	РеализацияТоваровУслугТовары.СуммаСНДС КАК СуммаСНДС,
		|	РеализацияТоваровУслугТовары.КодСтроки КАК КодСтроки,
		|	РеализацияТоваровУслугТовары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
		|	РеализацияТоваровУслугТовары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
		|	РеализацияТоваровУслугТовары.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
		|	РеализацияТоваровУслугТовары.ПроцентАвтоматическойСкидки КАК ПроцентАвтоматическойСкидки,
		|	РеализацияТоваровУслугТовары.КлючСвязи КАК КлючСвязи,
		|	РеализацияТоваровУслугТовары.Склад КАК Склад,
		|	РеализацияТоваровУслугТовары.СтатусУказанияСерий КАК СтатусУказанияСерий,
		|	РеализацияТоваровУслугТовары.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
		|	РеализацияТоваровУслугТовары.ЗаказКлиента КАК ЗаказКлиента,
		|	РеализацияТоваровУслугТовары.СрокПоставки КАК СрокПоставки,
		|	РеализацияТоваровУслугТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	РеализацияТоваровУслугТовары.Серия КАК Серия,
		|	РеализацияТоваровУслугТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	РеализацияТоваровУслугТовары.НоменклатураНабора КАК НоменклатураНабора,
		|	РеализацияТоваровУслугТовары.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|	РеализацияТоваровУслугТовары.АналитикаУчетаНаборов КАК АналитикаУчетаНаборов,
		|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
		|	ВидыНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара) КАК ЭтоТара
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|			ПО НоменклатураСпр.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
		|		ПО РеализацияТоваровУслугТовары.Номенклатура = НоменклатураСпр.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
		|		ПО (НоменклатураСпр.КодТНВЭД = КлассификаторТНВЭД.Ссылка)
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтранаПроисхождения") <> Неопределено Тогда
		Запрос.Текст = ДополнитьЗапросТоваровСтранойПроисхождения(Запрос.Текст);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ПолучитьТЧТоварыПеремещение(Знач ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваровТовары.Ссылка КАК Ссылка,
		|	ПеремещениеТоваровТовары.НомерСтроки КАК НомерСтроки,
		|	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ПеремещениеТоваровТовары.Характеристика КАК Характеристика,
		|	ПеремещениеТоваровТовары.Назначение КАК Назначение,
		|	ПеремещениеТоваровТовары.Упаковка КАК Упаковка,
		|	ПеремещениеТоваровТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ПеремещениеТоваровТовары.Количество КАК Количество,
		|	ПеремещениеТоваровТовары.КодСтроки КАК КодСтроки,
		|	ПеремещениеТоваровТовары.СтатусУказанияСерий КАК СтатусУказанияСерий,
		|	ПеремещениеТоваровТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ПеремещениеТоваровТовары.Серия КАК Серия,
		|	ПеремещениеТоваровТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
		|	ВидыНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара) КАК ЭтоТара
		|ИЗ
		|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|			ПО НоменклатураСпр.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
		|		ПО ПеремещениеТоваровТовары.Номенклатура = НоменклатураСпр.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
		|		ПО (НоменклатураСпр.КодТНВЭД = КлассификаторТНВЭД.Ссылка)
		|ГДЕ
		|	ПеремещениеТоваровТовары.Ссылка = &Ссылка";
	
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтранаПроисхождения") <> Неопределено Тогда
		Запрос.Текст = ДополнитьЗапросТоваровСтранойПроисхождения(Запрос.Текст);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

