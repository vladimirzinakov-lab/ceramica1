		КонецЕсли;
		
	КонецЕсли;
	
	Если Переменные.Свойство("ТранспортнаяИнформация") Тогда		
		
		ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТранспортнаяИнформация.Перевозчик, "Перевозчик",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
		
		Если ЗначениеЗаполнено(Переменные.ТранспортнаяИнформация.ГрузоподъемностьВТоннах) Тогда
			ДокументОбъект.ТСГрузопод =	Переменные.ТранспортнаяИнформация.ГрузоподъемностьВТоннах;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Переменные.ТранспортнаяИнформация.ВместимостьВКубическихМетрах) Тогда
			ДокументОбъект.ТСВместим =	Переменные.ТранспортнаяИнформация.ВместимостьВКубическихМетрах;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Переменные.ТранспортнаяИнформация.Тип) Тогда
			ДокументОбъект.ТСТип = Переменные.ТранспортнаяИнформация.Тип;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Перевозчик) Тогда
		Перевозчик = ВычислитьКонтрагентаИзПеревозчикаПартнера(ДокументОснование.ПеревозчикПартнер);	
		Если ЗначениеЗаполнено(Перевозчик) Тогда						
			ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				Перевозчик, "Перевозчик",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
	КонецЕсли;
	
	// ТЧ АдрПункт
	НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
	НоваяСтрока.Погрузка = Истина;
	НоваяСтрока.ПунктМаршрута = РеквизитыПогрузкиРазгрузки.МестоПогрузки;
	
	НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
	НоваяСтрока.Выгрузка = Истина;
	НоваяСтрока.ПунктМаршрута = РеквизитыПогрузкиРазгрузки.МестоДоставки;
	
КонецПроцедуры

Процедура ЗаполнитьДокумент_ПЭ_ЗаявкаНаМаршрут_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументОбъект.НомДок = ДокументОснование.Номер;
	ДокументОбъект.ДатаДок = ДокументОснование.Дата;
	
	Если ЗначениеЗаполнено(ДокументОснование.Договор) Тогда
		ДокументОбъект.ДогТрЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Договор, "ДогТрЭксп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;	
	
	ДокументОбъект.СвКлт = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "СвКлт",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	Перевозчик = ВычислитьКонтрагентаИзПеревозчикаПартнера(ДокументОснование.ПеревозчикПартнер);	
	Если ЗначениеЗаполнено(Перевозчик) Тогда						
		ДокументОбъект.СвЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Перевозчик, "СвЭксп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;
		
	ДокументОбъект.СвГО = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		РассчитатьГО_РТУ_ЗаказКлиента(ДокументОснование), "СвГО",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	ДокументОбъект.СвГП = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		РассчитатьГП_РТУ(ДокументОснование), "СвГП",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ВПунктМаршрута = Новый Структура("АдрГруз, АдрПунктНазн", "Склад", "АдресДоставки"); 
	Для Каждого Элемент Из ВПунктМаршрута Цикл
		ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование[Элемент.Значение], Элемент.Ключ,
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументОснование.Валюта) Тогда
		Валюта = ДокументОснование.Валюта;
	Иначе
		Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С("643", "руб");
	КонецЕсли; 
	ДокументОбъект.ВалютаУчетаГруза = Валюта;
	ДокументОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
	
	ТоварыДляТОРГ12 = КонтурЛогистика_ИнтеграцияТиповыеСервер.ТаблицаТоварыДляТОРГ12(ДокументОснование);
	
	ИспользоватьМногооборотнуюТару = ПолучитьФункциональнуюОпцию("ИспользоватьМногооборотнуюТару");
	
	ТЧТоварыОснования = ПолучитьТЧТовары(ДокументОснование);
	
	ЕстьПризнакТары = ЕстьПризнакТары(ТЧТоварыОснования);
	
	КоличествоСтрокТоваров = ТЧТоварыОснования.Количество();
	
	ЕстьСтранаПроисхождения = КоличествоСтрокТоваров > 0
		И КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъектаЛок(ТЧТоварыОснования[0], "СтранаПроисхожденияКЛ");
		
	ЕстьКодТНВЭД = КоличествоСтрокТоваров > 0
		И КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъектаЛок(ТЧТоварыОснования[0], "КодТНВЭД");
	
	// ТЧ Товары
	Для Каждого ТекущаяСтрока Из ТЧТоварыОснования Цикл
		
		Если ЭтоТара(ТекущаяСтрока, ИспользоватьМногооборотнуюТару, ЕстьПризнакТары) Тогда
			Продолжить;
		КонецЕсли;
				
		// При разделении ПЭ_ЗаявкаНаМаршрут — только строки текущего разделителя
		Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
				ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		НоваяСтрока.СтоимостьГруза = ТекущаяСтрока.Сумма;
		НоваяСтрока.ВалютаУчетаГруза = Валюта;
		НоваяСтрока.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
		
		Если ЕстьКодТНВЭД И ЗначениеЗаполнено(ТекущаяСтрока.КодТНВЭД) Тогда
			НоваяСтрока.КодТНВЭД = ТекущаяСтрока.КодТНВЭД;
		КонецЕсли;
		
		РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь, Истина);
		
		Если ЕстьСтранаПроисхождения И ЗначениеЗаполнено(ТекущаяСтрока.СтранаПроисхожденияКЛ) Тогда
			КонтурЛогистика_КонвертацияСервер.ДобавитьСтрануПроисхожденияПродукции(ДокументОбъект, НоваяСтрока.ИдентификаторСтроки,
				ТекущаяСтрока.СтранаПроисхожденияКЛ);
		КонецЕсли;
		
		Если ТоварыДляТОРГ12.Количество() > 0 Тогда  // типовой метод некорректно считает для дублей строк
				
			Если Не ЗначениеЗаполнено(НоваяСтрока.КоличествоМест) Тогда
				НоваяСтрока.КоличествоМест = КонтурЛогистика_ИнтеграцияТиповыеСервер.ЗначениеРеквизитаТЧТоварыДляТОРГ12(
					ТоварыДляТОРГ12, "КоличествоМест", ТекущаяСтрока, ДокументОснование);
			КонецЕсли;
					
			Если Не ЗначениеЗаполнено(НоваяСтрока.МассаБруттоКг) Тогда		
				НоваяСтрока.МассаБруттоКг = КонтурЛогистика_ИнтеграцияТиповыеСервер.ЗначениеРеквизитаТЧТоварыДляТОРГ12(
					ТоварыДляТОРГ12, "МассаБрутто", ТекущаяСтрока, ДокументОснование);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

