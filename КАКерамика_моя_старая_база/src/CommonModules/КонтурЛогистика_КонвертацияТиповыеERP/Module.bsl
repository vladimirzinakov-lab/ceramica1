Функция ПолучитьРеквизитыРаспоряжений(ДокументОснование)
	
	РеквизитыРаспоряжения = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение.Организация КАК Организация,
		|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение.Договор КАК Договор
		|ПОМЕСТИТЬ ВсеДанные
		|ИЗ
		|	Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
		|ГДЕ
		|	ЗаданиеНаПеревозкуРаспоряжения.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВсеДанные.Организация КАК Организация
		|ИЗ
		|	ВсеДанные КАК ВсеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВсеДанные.Договор КАК Договор
		|ИЗ
		|	ВсеДанные КАК ВсеДанные";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаОрганизация = РезультатЗапроса[РезультатЗапроса.ВГраница()-1].Выбрать();
	ВыборкаДоговор = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выбрать();
	
	Если ВыборкаОрганизация.Количество() = 1 Тогда
		ВыборкаОрганизация.Следующий();
		Если ЗначениеЗаполнено(ВыборкаОрганизация.Организация) Тогда
			РеквизитыРаспоряжения.Вставить("Организация", ВыборкаОрганизация.Организация);
		КонецЕсли;
	КонецЕсли;
	
	Если ВыборкаДоговор.Количество() = 1 Тогда
		ВыборкаДоговор.Следующий();
		Если ЗначениеЗаполнено(ВыборкаДоговор.Договор) Тогда
			РеквизитыРаспоряжения.Вставить("Договор", ВыборкаДоговор.Договор);
		КонецЕсли;
	КонецЕсли;
			
	Возврат РеквизитыРаспоряжения;
	
КонецФункции

Функция ДополнитьЗапросТоваровСтранойПроисхождения(Знач вхТекстЗапроса)
	
	ТекстЗапроса = вхТекстЗапроса;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Номенклатура КАК Номенклатура,",
											 "Номенклатура КАК Номенклатура,
											 |	КонтурЛогистика_СтраныМира.Ссылка КАК СтранаПроисхожденияКЛ,");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр",
											 "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
											 |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
											 |				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_СтраныМира КАК КонтурЛогистика_СтраныМира
											 |				ПО СтраныМира.Код = КонтурЛогистика_СтраныМира.Код
											 |			ПО НоменклатураСпр.СтранаПроисхождения = СтраныМира.Ссылка");
	Возврат ТекстЗапроса;
	
КонецФункции

