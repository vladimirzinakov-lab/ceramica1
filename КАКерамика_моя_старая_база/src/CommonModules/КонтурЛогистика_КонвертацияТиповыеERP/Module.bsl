// Конвертация для типового семейства конфигураций ERP.
// Такие как:
//   - 1С:Комплексная автоматизация (КА) 2
//   - 1С:ERP Управление холдингом
//   - Отраслевые решения 1С:ERP
//   - 1С:Управление торговлей 11

#Область СлужебныйПрограммныйИнтерфейс

#Область КонвертацияДокументов

// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыДокументовКонфигурации1С
//
Функция ПоддерживаемыеТипыДокументовКонфигурации1С(ТипДокументаЛогистика, СпецСценарий) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокументаЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокументаЛогистика) Тогда
		
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			
			ТипыДокументовКонфигурации1С.Добавить("ПриобретениеТоваровУслуг");
		
		Иначе
			
			ТипыДокументовКонфигурации1С.Добавить("ТранспортнаяНакладная");
			ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
			ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
			ТипыДокументовКонфигурации1С.Добавить("ЗаказКлиента");
					
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ЗаданиеНаПеревозку");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
		ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
		ТипыДокументовКонфигурации1С.Добавить("ЗаданиеНаПеревозку");
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертации
//
Процедура ЗаполнитьБазовыеНастройкиКонвертации(Контекст) Экспорт
	
	Если Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
		
		ИначеЕсли Контекст.ТипДокумента1С = "ТранспортнаяНакладная" Тогда
				
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;	
			
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьОрганизация = "Организация";
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьКонтрагент = "Плательщик";
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьГрузоотправитель = "Грузоотправитель";
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьГрузополучатель = "Грузополучатель";
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьДатаТРН = "Дата";
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьНомерТРН = "Номер";			
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьМестоДоставки = "АдресДоставки";
			Контекст.ПутиРеквизитовУчетногоДокумента.ПутьМестоПогрузки = "АдресПогрузки";
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
				Контекст.ПутиРеквизитовУчетногоДокумента.ПутьПеревозчик = "ЗаданиеНаПеревозку.Контрагент";
				Контекст.ПутиРеквизитовУчетногоДокумента.ПутьТранспортноеСредство = "ЗаданиеНаПеревозку.АвтомобильГосударственныйНомер";
				Контекст.ПутиРеквизитовУчетногоДокумента.ПутьВодитель = "ЗаданиеНаПеревозку.ВодительФИО";	
			Иначе
				Контекст.ПутиРеквизитовУчетногоДокумента.ПутьПеревозчик = "Перевозчик";
				Контекст.ПутиРеквизитовУчетногоДокумента.ПутьТранспортноеСредство = "АвтомобильГосударственныйНомер";
				Контекст.ПутиРеквизитовУчетногоДокумента.ПутьВодитель = "Водитель";
			КонецЕсли;
			
		ИначеЕсли Контекст.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			ЗаполнитьПутиРеквизитов_РТУ_ЗаказКлиента(Контекст);
			
			Если Контекст.ЭтоКТ2000 Тогда			
				ЗаполнитьБазовыеНастройки_КТ2000(Контекст);
			КонецЕсли;
			
		ИначеЕсли Контекст.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			ЗаполнитьПутиРеквизитов_ПеремещениеТоваров(Контекст);
				
			Если Контекст.ЭтоКТ2000 Тогда			
				ЗаполнитьБазовыеНастройки_КТ2000(Контекст);
			КонецЕсли;
			
		ИначеЕсли Контекст.ТипДокумента1С = "ЗаказКлиента" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			ЗаполнитьПутиРеквизитов_РТУ_ЗаказКлиента(Контекст);
			
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			
		ИначеЕсли Контекст.ТипДокумента1С = "ЗаданиеНаПеревозку" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Если Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
				Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;				
			Иначе
				Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда	
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
						
		ИначеЕсли Контекст.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			Контекст.ДокументыОснованияВложенныхДокументов.ПутьРеквизитДокументОснования = "Ссылка";
			
			ЗаполнитьПутиРеквизитов_РТУ_ЗаказКлиента(Контекст);
			
		ИначеЕсли Контекст.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			Контекст.ДокументыОснованияВложенныхДокументов.ПутьРеквизитДокументОснования = "Ссылка";
			
			ЗаполнитьПутиРеквизитов_ПеремещениеТоваров(Контекст);
			
		ИначеЕсли Контекст.ТипДокумента1С = "ЗаданиеНаПеревозку" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			Контекст.ДокументыОснованияВложенныхДокументов.ПутьРеквизитДокументОснования = "Распоряжение";
			Контекст.ДокументыОснованияВложенныхДокументов.ИмяТЧДокументыОснования = "Распоряжения";
			
			ЗаполнитьПутиРеквизитов_ЗаданиеНаПеревозку(Контекст);
					
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено
			Или Контекст.ТипДокумента1С = "РеализацияТоваровУслуг"
			Или Контекст.ТипДокумента1С = "ПеремещениеТоваров"
			Или Контекст.ТипДокумента1С = "ЗаказКлиента" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.НайтиГлавныйДокументПоДокументуУчетнойСистемы
//
Функция НайтиГлавныйДокументПоДокументуУчетнойСистемы(ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект) Экспорт
	
	ГлавныйДокумент = Неопределено;
	
	Если КонтекстНастройкиКонвертации.ТипДокумента1С = "ТранспортнаяНакладная" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ?(Не ЗначениеЗаполнено(ДокументОснование.Грузоотправитель),
			ДокументОснование.Организация, ДокументОснование.Грузоотправитель);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ДокументОснование.Грузоотправитель;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ПеремещениеТоваров" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ДокументОснование.Организация;
		
	Иначе
		
		НомерДокумента = Неопределено;
		ДатаДокумента = Неопределено;
		Грузоотправитель = Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Грузоотправитель", Грузоотправитель);
		Запрос.УстановитьПараметр("НомерТрН", НомерДокумента);
		Запрос.УстановитьПараметр("ДатаТрН", ДатаДокумента);
		Запрос.УстановитьПараметр("Разделитель", Разделитель);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		|ГДЕ
		|	(КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = &Грузоотправитель
		|			ИЛИ &Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)
		|			ИЛИ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка))
		|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН = &НомерТрН
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН = &ДатаТрН
		|			ИЛИ &ДатаТрН = ДАТАВРЕМЯ(1, 1, 1))
		|	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Разделитель = &Разделитель
		|			ИЛИ &Разделитель = НЕОПРЕДЕЛЕНО)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ГлавныйДокумент = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.СвязанныеОснованияДляПоискаЭЗЗ
//
Функция СвязанныеОснованияДляПоискаЭЗЗ(ДокументОснование) Экспорт
	
	Результат = Новый Массив;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ДобавитьЗаказКлиентаРТУВМассив(ДокументОснование, Результат);
		
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		Для Каждого СтрокаОснования Из ДокументОснование.ДокументыОснования Цикл
			
			Если ТипЗнч(СтрокаОснования.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				ДобавитьЗаказКлиентаРТУВМассив(СтрокаОснования.ДокументОснование, Результат);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные) Экспорт
		
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
		
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
	
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Если КонтекстНастройкиКонвертации.ЭтоКТ2000 Тогда
				
				ЗаполнитьГлавныйДокумент_РеализацияТоваровУслуг_КТ2000(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			Иначе
				
				ЗаполнитьГлавныйДокумент_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			КонецЕсли;
			
		ИначеЕсли ТипДокумента1С = "ЗаказКлиента" Тогда
			
			ЗаполнитьГлавныйДокумент_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
			
		ИначеЕсли ТипДокумента1С = "ТранспортнаяНакладная" Тогда
			
			ЗаполнитьГлавныйДокумент_ТранспортнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если КонтекстНастройкиКонвертации.ЭтоКТ2000 Тогда
				
				ЗаполнитьГлавныйДокумент_ПеремещениеТоваров_КТ2000(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			Иначе
				
				ЗаполнитьГлавныйДокумент_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьДокументЛогистикиДополнительнымиРеквизитами(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
	
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Если КонтекстНастройкиКонвертации.ЭтоКТ2000 Тогда
				
				ЗаполнитьДокументТитул_ТрН_Титул1_РеализацияТоваровУслуг_КТ2000(
					ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			Иначе
				
				ЗаполнитьДокументТитул_ТрН_Титул1_РТУ_ЗаказКлиента(
					ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			КонецЕсли;
			
		ИначеЕсли ТипДокумента1С = "ЗаказКлиента" Тогда
			
			ЗаполнитьДокументТитул_ТрН_Титул1_РТУ_ЗаказКлиента(
					ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли ТипДокумента1С = "ТранспортнаяНакладная" Тогда
			
			ЗаполнитьДокументТитул_ТрН_Титул1_ТранспортнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если КонтекстНастройкиКонвертации.ЭтоКТ2000 Тогда
				
				ЗаполнитьДокументТитул_ТрН_Титул1_ПеремещениеТоваров_КТ2000(
					ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			Иначе
				
				ЗаполнитьДокументТитул_ТрН_Титул1_ПеремещениеТоваров(
					ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		ЗаполнитьДокументТитул_ТрН_Титул3_ПриобретениеТоваровУслуг(
					ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
			
	ИначеЕсли (ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02)
		И ТипДокумента1С = "ЗаданиеНаПеревозку" Тогда
		
		ЗаполнитьДокументТитул_ПЛ_Титул1_ЗаданиеНаПеревозку(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Если КонтекстНастройкиКонвертации.ЭтоКТ2000 Тогда
			
				ЗаполнитьДокументТитул_ЗЗ_Титул1_РеализацияТоваровУслуг_КТ2000(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			Иначе
				
				ЗаполнитьДокументТитул_ЗЗ_Титул1_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			КонецЕсли;
			
		ИначеЕсли ТипДокумента1С = "ТранспортнаяНакладная" Тогда
			
			ЗаполнитьДокументТитул_ЗЗ_Титул1_ТранспортнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если КонтекстНастройкиКонвертации.ЭтоКТ2000 Тогда
			
				ЗаполнитьДокументТитул_ЗЗ_Титул1_ПеремещениеТоваров_КТ2000(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
			Иначе
				
				ЗаполнитьДокументТитул_ЗЗ_Титул1_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
				
			КонецЕсли;
			
		ИначеЕсли ТипДокумента1С = "ЗаказКлиента" Тогда
			
			ЗаполнитьДокументТитул_ЗЗ_Титул1_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_РеализацияТоваровУслуг(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_ПеремещениеТоваров(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
		ИначеЕсли ТипДокумента1С = "ЗаданиеНаПеревозку" Тогда
				
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_ЗаданиеНаПеревозку(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);		
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
				
		Если ТипДокумента1С = "РеализацияТоваровУслуг"
			Или ТипДокумента1С = "ЗаказКлиента" Тогда
			
			ЗаполнитьДокумент_ПЭ_ЗаявкаНаМаршрут_РТУ_ЗаказКлиента(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьДокумент_ПЭ_ЗаявкаНаМаршрут_ПеремещениеТоваров(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
		КонецЕсли;		
		
	КонецЕсли;
	
	ЗаполнитьДокументЛогистикиДополнительнымиРеквизитами(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыДокументаОснования
//
Функция ВычислитьРеквизитыДокументаОснования(ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", РассчитатьГО_РТУ_ЗаказКлиента(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузополучатель", РассчитатьГП_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", ВычислитьКонтрагентаИзПеревозчикаПартнера(ДокументОснование.ПеревозчикПартнер));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.Склад);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.АдресДоставки);
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
			
			Запрос.Текст = ТекстЗапросаПоискТрНПоОснованию();
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				
				ТрН = Выборка.Ссылка;
				
				Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ТрН.АвтомобильГосударственныйНомер);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Прицеп") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Прицеп", ТрН.ГосударственныйНомерПрицепа);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Водитель", ТрН.Водитель);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузополучатель", РассчитатьГП_ПеремещениеТоваров(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", ВычислитьКонтрагентаИзПеревозчикаПартнера(ДокументОснование.ПеревозчикПартнер));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.СкладОтправитель);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.СкладПолучатель);
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
			
			Запрос.Текст = ТекстЗапросаПоискТрНПоОснованию();
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				
				ТрН = Выборка.Ссылка;
				
				Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ТрН.АвтомобильГосударственныйНомер);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Прицеп") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Прицеп", ТрН.ГосударственныйНомерПрицепа);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Водитель", ТрН.Водитель);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ТранспортнаяНакладная" Тогда
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
				Перевозчик = ДокументОснование.ЗаданиеНаПеревозку.Контрагент;
				ТранспортноеСредство = ДокументОснование.ЗаданиеНаПеревозку.ТранспортноеСредство;
				Прицеп = ДокументОснование.ЗаданиеНаПеревозку.ГосударственныйНомерПрицепа;
				Если ЗначениеЗаполнено(ДокументОснование.ЗаданиеНаПеревозку.Водитель) Тогда
					Водитель = ДокументОснование.ЗаданиеНаПеревозку.Водитель;
				Иначе
					Водитель = ДокументОснование.ЗаданиеНаПеревозку.ВодительФИО;
				КонецЕсли;
			Иначе
				Перевозчик = ДокументОснование.Перевозчик;
				ТранспортноеСредство = ДокументОснование.АвтомобильГосударственныйНомер;
				Прицеп = ДокументОснование.ГосударственныйНомерПрицепа;
				Водитель = ДокументОснование.Водитель;
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Грузоотправитель);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", Перевозчик);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузополучатель", ДокументОснование.Грузополучатель);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ТранспортноеСредство);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Прицеп") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Прицеп", Прицеп);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.АдресПогрузки);
			КонецЕсли;
			
