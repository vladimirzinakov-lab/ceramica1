// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыСправочниковКонфигурации1С
//
Функция ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочникаЛогистика) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ФизическиеЛица");
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеДоставкой") Тогда
			ТипыДокументовКонфигурации1С.Добавить("ТранспортнаяНакладная");
		Иначе
			ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
			ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
		КонецЕсли;
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("Контрагенты");
		ТипыДокументовКонфигурации1С.Добавить("Организации");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("Склады");
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеДоставкой") Тогда
			ТипыДокументовКонфигурации1С.Добавить("ТранспортнаяНакладная");
		Иначе
			ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
			ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
		КонецЕсли;
		
		Если КонтурЛогистика_КонвертацияСерверПовтИсп.ЭтоКТ2000() Тогда
			ТипыДокументовКонфигурации1С.Добавить("алкПунктыРазгрузки");
		КонецЕсли;
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ТранспортныеСредства");
		ТипыДокументовКонфигурации1С.Добавить("ТипыТранспортныхСредств");
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеДоставкой") Тогда
			ТипыДокументовКонфигурации1С.Добавить("ТранспортнаяНакладная");
		Иначе
			ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
			ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
		КонецЕсли;
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_Договоры" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ДоговорыКонтрагентов");
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертацииСправочника
//
Процедура ЗаполнитьБазовыеНастройкиКонвертацииСправочника(КонтекстНастройкиКонвертации) Экспорт
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортнаяНакладная"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Склады"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортнаяНакладная"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "алкПунктыРазгрузки"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортнаяНакладная"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортныеСредства"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТипыТранспортныхСредств"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка") Тогда
					
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ДоговорыКонтрагентов") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту
//
Процедура ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(КонтекстНастройкиКонвертации, Параметры, Результат) Экспорт
	
	УчетныйОбъект = Параметры.УчетныйОбъект;
	
	// Могуть быть незаполненными!
	ДокументОснование = Параметры.ДокументОснование;  // От заполненности этого параметра зависит заполненность РеквизитаТитула!
	ДокументОбъект = Параметры.ДокументОбъект;
	Переменные = Параметры.Переменные;
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
		
		ЗаполнитьСправочник_Сотрудники(КонтекстНастройкиКонвертации, УчетныйОбъект, ДокументОснование, ДокументОбъект, Переменные, Результат);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"КПП", УчетныйОбъект.КПП, ОбновлятьРеквизиты);
			
			ТелефонОсновной = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
				УчетныйОбъект, "Телефон");
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ТелефонОсновной", ТелефонОсновной, ОбновлятьРеквизиты);
			
			АдресСтрока = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
				УчетныйОбъект, "ЮридическийАдрес");
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресСтрока", АдресСтрока, ОбновлятьРеквизиты);
			
			Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации" Тогда
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"ОГРН", УчетныйОбъект.ОГРН, ОбновлятьРеквизиты);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		ЗаполнитьСправочник_ПунктыМаршрута(КонтекстНастройкиКонвертации, УчетныйОбъект, ДокументОснование, ДокументОбъект, Результат);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		ЗаполнитьСправочник_ТранспортныеСредства(КонтекстНастройкиКонвертации, УчетныйОбъект, ДокументОснование, ДокументОбъект, Переменные, Результат);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ДоговорыКонтрагентов" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаДокумента", УчетныйОбъект.Дата, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Контрагент", УчетныйОбъект.Контрагент, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КонтрагентИНН", УчетныйОбъект.Контрагент.ИНН, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"НомерДокумента", УчетныйОбъект.Номер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Организация", УчетныйОбъект.Организация, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ОрганизацияИНН", УчетныйОбъект.Организация.ИНН, ОбновлятьРеквизиты);
		
	КонецЕсли;
	
	ВычислитьДополнительныеРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(УчетныйОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Результат);
	
КонецПроцедуры

#КонецОбласти

// Заполняет габариты и массу записи базового соответствия номенклатуры
//
// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.КонтурЛогистика_БазовыеСоответствияНоменклатуры
//
Процедура ЗаполнитьВесогабаритныеПараметрыБазовогоСоответствия(Запись) Экспорт
	
	Если Не ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыГруза = ВесогабаритныеПараметрыГруза(Запись.Номенклатура, Запись.УпаковкаЕдиницаИзмерения);
	
	Если ЗначениеЗаполнено(ПараметрыГруза.Высота) Тогда
		Запись.Высота = ПараметрыГруза.Высота;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыГруза.Длина) Тогда
		Запись.Длина = ПараметрыГруза.Длина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыГруза.Ширина) Тогда
		Запись.Ширина = ПараметрыГруза.Ширина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыГруза.ОбъемКубМ) Тогда
		Запись.ОбъемКубМ = ПараметрыГруза.ОбъемКубМ;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыГруза.МассаКг) Тогда
		Запись.МассаБруттоКг = ПараметрыГруза.МассаКг;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьГлавныйДокумент_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДобавитьСвязаннуюТранспортнуюНакладную(ДокументОснование, Переменные);
	
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.ДатаТрН = ДокументОснование.Дата;
	ДокументОбъект.НомерТрН = ДокументОснование.Номер;
	ДокументОбъект.ЭтоЭкспедиция = Ложь;
	
	ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		РассчитатьГО_РТУ_ЗаказКлиента(ДокументОснование), "Грузоотправитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	Перевозчик = ВычислитьКонтрагентаИзПеревозчикаПартнера(ДокументОснование.ПеревозчикПартнер);	
	Если ЗначениеЗаполнено(Перевозчик) Тогда						
		ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Перевозчик, "Перевозчик",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;
	
	ДокументОбъект.Грузополучатель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		РассчитатьГП_РТУ(ДокументОснование), "Грузополучатель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоДоставки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресДоставки, "МестоДоставки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоПогрузки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Склад, "МестоПогрузки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	
	Если Переменные.Свойство("ТрН") Тогда
		
		ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТрН.АвтомобильГосударственныйНомер, "ТранспортноеСредство",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект, Переменные);
		
		ДокументОбъект.Прицеп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТрН.ГосударственныйНомерПрицепа, "Прицеп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект, Переменные);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьГлавныйДокумент_РеализацияТоваровУслуг_КТ2000(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДобавитьТранспортнуюИнформацию(ДокументОснование, Переменные);	
	
	ВыражениеВычисления_алкТовары = "алкРаботаСДиалогамиСервер.алкПолучитьСведенияПоТабличнойЧастиДокументаНаСервере(ДокументОснование, Истина,, Ложь)";
	алкТовары = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьВБезопасномРежиме(ВыражениеВычисления_алкТовары);
	Если алкТовары <> Неопределено Тогда
		Переменные.Вставить("Товары", алкТовары);
	КонецЕсли;
	
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.ДатаТрН = ДокументОснование.Дата;
	ДокументОбъект.НомерТрН = ДокументОснование.Номер;
	ДокументОбъект.ЭтоЭкспедиция = Ложь;
	
	РеквизитыПогрузкиРазгрузки = РассчитатьРеквизитыПогрузкиРазгрузки_КТ2000(
		ДокументОбъект,
		ДокументОснование,
		РассчитатьГО_РТУ_ЗаказКлиента(ДокументОснование),
		РассчитатьГП_РТУ(ДокументОснование),
		ДокументОснование.Склад,
		ДокументОснование.АдресДоставки);
		
	ЗаполнитьЗначенияСвойств(ДокументОбъект, РеквизитыПогрузкиРазгрузки);
					
	Если Переменные.Свойство("ТранспортнаяИнформация") Тогда
		
		Если ЗначениеЗаполнено(Переменные.ТранспортнаяИнформация.ДатаТН) Тогда
			ДокументОбъект.ДатаЗак = Переменные.ТранспортнаяИнформация.ДатаТН;
			ДокументОбъект.ДатаТрН = Переменные.ТранспортнаяИнформация.ДатаТН;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Переменные.ТранспортнаяИнформация.НомерТН) Тогда 
			ДокументОбъект.НомерТрН = Переменные.ТранспортнаяИнформация.НомерТН;
		КонецЕсли;
		
		ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТранспортнаяИнформация.ТранспортноеСредство, "ТранспортноеСредство",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект, Переменные);
			
		Если ЗначениеЗаполнено(Переменные.ТранспортнаяИнформация.ГосударственныйНомерПрицепа) Тогда				
			ДокументОбъект.Прицеп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				Переменные.ТранспортнаяИнформация.ГосударственныйНомерПрицепа, "Прицеп",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
				ДокументОснование, ДокументОбъект, Переменные);				
		КонецЕсли;
		
		ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТранспортнаяИнформация.Перевозчик, "Перевозчик",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Перевозчик) Тогда
		Перевозчик = ВычислитьКонтрагентаИзПеревозчикаПартнера(ДокументОснование.ПеревозчикПартнер);	
		Если ЗначениеЗаполнено(Перевозчик) Тогда						
			ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				Перевозчик, "Перевозчик",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

Процедура ЗаполнитьГлавныйДокумент_ТранспортнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
		Перевозчик = ДокументОснование.ЗаданиеНаПеревозку.Контрагент;
		ТранспортноеСредство = ДокументОснование.ЗаданиеНаПеревозку.ТранспортноеСредство;
		Прицеп = ДокументОснование.ЗаданиеНаПеревозку.ГосударственныйНомерПрицепа;
	Иначе
		Перевозчик = ДокументОснование.Перевозчик;
		ТранспортноеСредство = ДокументОснование.АвтомобильГосударственныйНомер;
		Прицеп = ДокументОснование.ГосударственныйНомерПрицепа;
	КонецЕсли;
	
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.ДатаТрН = ДокументОснование.Дата;
	ДокументОбъект.НомерТрН = ДокументОснование.Номер;
	ДокументОбъект.ЭтоЭкспедиция = Ложь;
	
	ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Грузоотправитель, "Грузоотправитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		Перевозчик, "Перевозчик",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Грузополучатель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Грузополучатель, "Грузополучатель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ТранспортноеСредство, "ТранспортноеСредство",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Прицеп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		Прицеп, "Прицеп",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоДоставки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресДоставки, "МестоДоставки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоПогрузки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресПогрузки, "МестоПогрузки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
КонецПроцедуры

