Процедура ЗаполнитьГлавныйДокумент_ПЭ_Титул1_ЗаданиеНаПеревозку(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументОбъект.НомДок = ДокументОснование.Номер;
	ДокументОбъект.ДатаДок = ДокументОснование.Дата;
	
	ДокументОбъект.СвЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Контрагент, "СвЭксп",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	Если Не КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументОснование, "Распоряжения") Тогда
		Возврат;
	КонецЕсли;
		
	Если ДокументОснование.Распоряжения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		РеквизитыРаспоряжения = ПолучитьРеквизитыРаспоряжений(ДокументОснование);
	Исключение
		РеквизитыРаспоряжения = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(РеквизитыРаспоряжения) = Тип("Структура") Тогда
		
		Если РеквизитыРаспоряжения.Свойство("Организация") Тогда
			ДокументОбъект.СвКлиент = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				РеквизитыРаспоряжения.Организация, "СвКлиент",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
		
		Если РеквизитыРаспоряжения.Свойство("Договор") Тогда
			ДокументОбъект.ДогТрЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				РеквизитыРаспоряжения.Договор, "ДогТрЭксп",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрокаРаспоряжений Из ДокументОснование.Распоряжения Цикл
		
		НоваяСтрока = ДокументОбъект.ДокументыОснованияМаршрутов.Добавить();
		НоваяСтрока.ДокументОснование = СтрокаРаспоряжений.Распоряжение;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ТрН_Титул1_РТУ_ЗаказКлиента(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументОбъект.ДатаВремяУбытия = ТекущаяДатаСеанса();
	
	ПродолжительностьПогрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СредняяПродолжительностьПогрузки", ДокументОбъект.ДокументЭТРН.ПартнерГрузоотправитель);
	Если ТипЗнч(ПродолжительностьПогрузки) = Тип("Число") Тогда
		ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - ПродолжительностьПогрузки * 60;
	Иначе
		ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - 3600;
	КонецЕсли;	
	ДокументОбъект.ДатаВремяПодачиПлановая 	= ДатаВремяПодачиПлановая;
	ДокументОбъект.ДатаВремяПрибытия 		= ДатаВремяПодачиПлановая;
	
	ДокументОбъект.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель;
	ДокументОбъект.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03;
	
	// ТЧ ТелефоныПереадресующего
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументЭТРН.Грузоотправитель) Тогда
		НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
		НоваяСтрока.Телефон = ДокументОбъект.ДокументЭТРН.Грузоотправитель.ТелефонОсновной;
	КонецЕсли;
	
	// Водитель
	Если Переменные.Свойство("ТрН") Тогда
		
		ДокументОбъект.Водитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТрН.Водитель, "Водитель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
			ДокументОснование, ДокументОбъект, Переменные);
		
	КонецЕсли;
	
	ВидТары = Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду("CT");
	ИспользоватьМногооборотнуюТару = ПолучитьФункциональнуюОпцию("ИспользоватьМногооборотнуюТару");
	
	// ТЧ Товары
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Цикл
		
		ТоварыДляТОРГ12 = КонтурЛогистика_ИнтеграцияТиповыеСервер.ТаблицаТоварыДляТОРГ12(ТекДокОснование);
		
		ТЧТоварыОснования = ПолучитьТЧТовары(ТекДокОснование);
		
		ЕстьПризнакТары = ЕстьПризнакТары(ТЧТоварыОснования);
		
		Для Каждого ТекущаяСтрока Из ТЧТоварыОснования Цикл
			
			Если ЭтоТара(ТекущаяСтрока, ИспользоватьМногооборотнуюТару, ЕстьПризнакТары) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ВидТары = ВидТары;
			НоваяСтрока.СпособУпаковки = "В таре";
			НоваяСтрока.ОбъявленнаяЦенность = ТекущаяСтрока.Сумма;
			НоваяСтрока.ОбъявленнаяЦенностьВалюта = ТекДокОснование.Валюта;
				
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока);
			
			Если ТоварыДляТОРГ12.Количество() > 0 Тогда  // типовой метод некорректно считает для дублей строк
					
				Если Не ЗначениеЗаполнено(НоваяСтрока.КоличествоМест) Тогда
					НоваяСтрока.КоличествоМест = КонтурЛогистика_ИнтеграцияТиповыеСервер.ЗначениеРеквизитаТЧТоварыДляТОРГ12(
						ТоварыДляТОРГ12, "КоличествоМест", ТекущаяСтрока, ТекДокОснование);
				КонецЕсли;
						
				Если Не ЗначениеЗаполнено(НоваяСтрока.МассаПлановаяБруттоКг) Тогда		
					НоваяСтрока.МассаПлановаяБруттоКг = КонтурЛогистика_ИнтеграцияТиповыеСервер.ЗначениеРеквизитаТЧТоварыДляТОРГ12(
						ТоварыДляТОРГ12, "МассаБрутто", ТекущаяСтрока, ТекДокОснование);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ТрН_Титул1_РеализацияТоваровУслуг_КТ2000(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
		
	ДокументОбъект.ДатаВремяУбытия = ТекущаяДатаСеанса();
	
	ПродолжительностьПогрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СредняяПродолжительностьПогрузки", ДокументОбъект.ДокументЭТРН.ПартнерГрузоотправитель);
	Если ТипЗнч(ПродолжительностьПогрузки) = Тип("Число") Тогда
		ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - ПродолжительностьПогрузки * 60;
	Иначе
		ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - 3600;
	КонецЕсли;	
	ДокументОбъект.ДатаВремяПодачиПлановая 	= ДатаВремяПодачиПлановая;
	ДокументОбъект.ДатаВремяПрибытия 		= ДатаВремяПодачиПлановая;
	
	ДокументОбъект.ИнициаторПереадресации 	= Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель;
	ДокументОбъект.МетодОпределенияМассы 	= Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03;
	
	// ТЧ ТелефоныПереадресующего
	НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
	НоваяСтрока.Телефон = ДокументОбъект.ДокументЭТРН.Грузоотправитель.ТелефонОсновной;
	
	// Водитель
	Если Переменные.Свойство("ТранспортнаяИнформация") Тогда
		
		ДокументОбъект.Водитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			Переменные.ТранспортнаяИнформация.Водитель, "Водитель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
			ДокументОснование, ДокументОбъект, Переменные);
			
		ДокументОбъект.СведенияОПломбах = Переменные.ТранспортнаяИнформация.НомераПломб;
			
	КонецЕсли;
	
	ВидТары = Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду("CT");
	ИспользоватьМногооборотнуюТару = ПолучитьФункциональнуюОпцию("ИспользоватьМногооборотнуюТару");
	
	// ТЧ Товары
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Цикл
		
		ТЧТоварыОснования = ПолучитьТЧТовары(ТекДокОснование);
		
		ЕстьПризнакТары = ЕстьПризнакТары(ТЧТоварыОснования);
		
		Для Каждого ТекущаяСтрока Из ТЧТоварыОснования Цикл
			
			Если ЭтоТара(ТекущаяСтрока, ИспользоватьМногооборотнуюТару, ЕстьПризнакТары) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ВидТары = ВидТары;
			НоваяСтрока.СпособУпаковки = "В таре";
			НоваяСтрока.ОбъявленнаяЦенность = ТекущаяСтрока.Сумма;
			НоваяСтрока.ОбъявленнаяЦенностьВалюта = ТекДокОснование.Валюта;
			НоваяСтрока.ИдентификаторыЕГАИС = ТекДокОснование.алкНомерФиксацииВЕГАИС;
			
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока);
			
			Если Переменные.Свойство("Товары") Тогда
				
				Если Переменные.Товары[НоваяСтрока.НомерСтроки] <> Неопределено Тогда
					НоваяСтрока.МассаПлановаяБруттоКг = Переменные.Товары[НоваяСтрока.НомерСтроки].МассаБрутто;
				КонецЕсли;
				
				Если Переменные.Товары[НоваяСтрока.НомерСтроки] <> Неопределено Тогда
					НоваяСтрока.КоличествоМест = Переменные.Товары[НоваяСтрока.НомерСтроки].КоличествоМест;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ТрН_Титул1_ТранспортнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаданияНаПеревозкуДляУчетаДоставкиПеревозчиками") Тогда
		
		Если ЗначениеЗаполнено(ДокументОснование.ЗаданиеНаПеревозку.Водитель) Тогда
			Водитель = ДокументОснование.ЗаданиеНаПеревозку.Водитель;
		Иначе
			Водитель = ДокументОснование.ЗаданиеНаПеревозку.ВодительФИО;
		КонецЕсли; 
		
		ДатаВремяПодачиПлановая = ДокументОснование.ЗаданиеНаПеревозку.ДатаВремяРейсаПланС;
		ДатаВремяПрибытия 		= ДокументОснование.ЗаданиеНаПеревозку.ДатаВремяРейсаФактС;
		ДатаВремяУбытия 		= ДокументОснование.ЗаданиеНаПеревозку.ДатаВремяРейсаФактПо;
		
	Иначе  
		
		Водитель = ДокументОснование.Водитель;
		
		ДатаВремяУбытия = ТекущаяДатаСеанса();
	
		ПродолжительностьПогрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"СредняяПродолжительностьПогрузки", ДокументОбъект.ДокументЭТРН.ПартнерГрузоотправитель);
		Если ТипЗнч(ПродолжительностьПогрузки) = Тип("Число") Тогда
			ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - ПродолжительностьПогрузки * 60;
		Иначе
			ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - 3600;
		КонецЕсли;	
		ДатаВремяПодачиПлановая = ДатаВремяПодачиПлановая;
		ДатаВремяПрибытия 		= ДатаВремяПодачиПлановая;
		
	КонецЕсли;
	
	ДокументОбъект.ДатаВремяПодачиПлановая 	= ДатаВремяПодачиПлановая;
	ДокументОбъект.ДатаВремяПрибытия 		= ДатаВремяПрибытия;
	ДокументОбъект.ДатаВремяУбытия 			= ДатаВремяУбытия;
	
	ДокументОбъект.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель;
	ДокументОбъект.МассаБруттоКг = ДокументОснование.МассаБрутто;
	ДокументОбъект.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03;
	
	ДокументОбъект.Водитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		Водитель, "Водитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
		ДокументОснование, ДокументОбъект);
	
	// ТЧ ТелефоныПереадресующего
	НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
	НоваяСтрока.Телефон = ДокументОбъект.ДокументЭТРН.Грузоотправитель.ТелефонОсновной;
	
	Если ДокументОснование.ДокументыОснования.Количество() > 0 Тогда
		ДокОсн = ДокументОснование.ДокументыОснования[0].ДокументОснование;
		Если ТипЗнч(ДокОсн) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Валюта = ДокОсн.Валюта;
		Иначе
			Валюта = Справочники.Валюты.НайтиПоКоду("643");
		КонецЕсли;
	Иначе
		Валюта = Справочники.Валюты.НайтиПоКоду("643");
	КонецЕсли;
	
	ВидТары = Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду("CT");
	ИспользоватьМногооборотнуюТару = ПолучитьФункциональнуюОпцию("ИспользоватьМногооборотнуюТару");
	
	// ТЧ Товары
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Цикл
		
		ТоварыДляТОРГ12 = КонтурЛогистика_ИнтеграцияТиповыеСервер.ТаблицаТоварыДляТОРГ12(ТекДокОснование);
		
		Для Каждого Элемент Из ТекДокОснование.ДокументыОснования Цикл
			 
			ДокОсн = Элемент.ДокументОснование;
			
			ТЧТоварыОснования = ПолучитьТЧТовары(ДокОсн);
			
			ЕстьПризнакТары = ЕстьПризнакТары(ТЧТоварыОснования);
			
			Для Каждого ТекущаяСтрока Из ТЧТоварыОснования Цикл
				
				Если ЭтоТара(ТекущаяСтрока, ИспользоватьМногооборотнуюТару, ЕстьПризнакТары) Тогда
					Продолжить;
				КонецЕсли;
				
				Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
						ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ДокументОбъект.Товары.Добавить();
				НоваяСтрока.ВидТары = ВидТары;
				НоваяСтрока.СпособУпаковки = "В таре";
				Если ТипЗнч(ДокОсн) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
					НоваяСтрока.ОбъявленнаяЦенность = ТекущаяСтрока.Сумма;
					НоваяСтрока.ОбъявленнаяЦенностьВалюта = Валюта;
				КонецЕсли;
				
				РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока);
				
				Если ТоварыДляТОРГ12.Количество() > 0 Тогда  // типовой метод некорректно считает для дублей строк
					
					Если Не ЗначениеЗаполнено(НоваяСтрока.КоличествоМест) Тогда
						НоваяСтрока.КоличествоМест = КонтурЛогистика_ИнтеграцияТиповыеСервер.ЗначениеРеквизитаТЧТоварыДляТОРГ12(
							ТоварыДляТОРГ12, "КоличествоМест", ТекущаяСтрока, Элемент.ДокументОснование);
					КонецЕсли;
							
					Если Не ЗначениеЗаполнено(НоваяСтрока.МассаПлановаяБруттоКг) Тогда		
						НоваяСтрока.МассаПлановаяБруттоКг = КонтурЛогистика_ИнтеграцияТиповыеСервер.ЗначениеРеквизитаТЧТоварыДляТОРГ12(
							ТоварыДляТОРГ12, "МассаБрутто", ТекущаяСтрока, Элемент.ДокументОснование);
					КонецЕсли;
					
				КонецЕсли;
				
				ЗаполнитьДополнительнымиРеквизитамиТЧДокумента(ДокументОбъект, "Товары", ТекущаяСтрока, НоваяСтрока, КонтекстНастройкиКонвертации);
							
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ТрН_Титул1_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
