		ДокументОбъект.ТСВместим = ТСВместим;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТСГрузопод) Тогда
		ДокументОбъект.ТСГрузопод = ТСГрузопод;
	КонецЕсли;
	
