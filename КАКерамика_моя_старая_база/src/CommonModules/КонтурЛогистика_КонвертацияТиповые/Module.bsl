//
Функция ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному")
		И ДокументОбъект.ДокументыОснования.Количество() > 1 Тогда
		
		Результат = Новый Массив;
		Для Каждого СтрокаОснования Из ДокументОбъект.ДокументыОснования Цикл
			Если ЗначениеЗаполнено(СтрокаОснования.ДокументОснование) Тогда
				Результат.Добавить(СтрокаОснования.ДокументОснование);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
	
КонецФункции

// Формирует путь к реквизиту учетного документа для запроса списка задач
// с учетом запасного значения (аналог ?(ЗначениеЗаполнено(Основной), Основной, Запасной) при заполнении).
//
// Параметры:
//  ИмяТаблицы - Строка - имя документа учетной системы (псевдоним таблицы в запросе)
//  ОсновнойРеквизит - Строка
//  ЗапаснойРеквизит - Строка
//  ТипДокумента1С - Строка
//
// Возвращаемое значение:
//  Строка - выражение языка запросов
//
Функция ПутьРеквизитаСЗапаснымЗначением(ИмяТаблицы, ОсновнойРеквизит, ЗапаснойРеквизит, ТипДокумента1С) Экспорт
	
	ПустоеЗначениеОсновного = ПустоеЗначениеРеквизитаДокументаДляЗапроса(ТипДокумента1С, ОсновнойРеквизит);
	
	Возврат "ВЫБОР
			|	КОГДА " + ИмяТаблицы + "." + ОсновнойРеквизит + " <> " + ПустоеЗначениеОсновного + "
			|		ТОГДА " + ИмяТаблицы + "." + ОсновнойРеквизит + "
			|	ИНАЧЕ " + ИмяТаблицы + "." + ЗапаснойРеквизит + "
			|КОНЕЦ";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьТаблицуТоваровПоПЭ_Маршруту(ДокументОбъект, Источник)
	
	ДефолтМетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
	
	Для Каждого СтрокаГруз Из Источник.Товары Цикл
		
		СтрокаТовары = ДокументОбъект.Товары.Добавить();
		СтрокаТовары.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		
		СтрокаТовары.ОтгрузочноеНаименование = СтрокаГруз.ОтгрузочноеНаименование;
		СтрокаТовары.КоличествоМест = СтрокаГруз.КоличествоМест;
		СтрокаТовары.ОбъемКубМ = СтрокаГруз.ОбъемКубМ;
		
		СтрокаТовары.МассаПлановаяБруттоКг = СтрокаГруз.МассаБруттоКг;
		СтрокаТовары.МассаПлановаяНеттоКг = СтрокаГруз.МассаНеттоКг;
		СтрокаТовары.МетодОпределенияМассы = ДефолтМетодОпределенияМассы;
		
		СтрокаТовары.Учитывать = Истина;
		
		Если ЗначениеЗаполнено(СтрокаГруз.СвОпаснГруз) Тогда
			ОписаниеОпасногоГруза = ДокументОбъект.ОпасныеГрузы.Добавить();
			ОписаниеОпасногоГруза.ИдентификаторСтрокиТоваров = СтрокаТовары.ИдентификаторСтроки;
			ЗаполнитьЗначенияСвойств(ОписаниеОпасногоГруза, СтрокаГруз.СвОпаснГруз);
		КонецЕсли;
		
		Упаковки = Источник.ИнфУпГруз.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаГруз.ИдентификаторСтроки));
		Если Упаковки.Количество() = 1 Тогда
			СтрокаТовары.ВидТары = Упаковки[0].ВидУпак;
			СтрокаТовары.Высота = Упаковки[0].ВысЗнач;
			СтрокаТовары.Длина = Упаковки[0].ДлЗнач;
			СтрокаТовары.Ширина = Упаковки[0].ШирЗнач;
		КонецЕсли;
		
		СтрокаТовары.СостояниеГруза = "В соответствии с договором";
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПустоеЗначениеРеквизитаДокументаДляЗапроса(ТипДокумента1С, ИмяРеквизита)
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ТипДокумента1С);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Реквизит = МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита);
	Если Реквизит = Неопределено Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ТипыРеквизита = Реквизит.Тип.Типы();
	Если ТипыРеквизита.Количество() = 0 Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	МетаданныеТипа = Метаданные.НайтиПоТипу(ТипыРеквизита[0]);
	Если МетаданныеТипа = Неопределено Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ПолноеИмяТипа = МетаданныеТипа.ПолноеИмя();
	Возврат "ЗНАЧЕНИЕ(" + ПолноеИмяТипа + ".ПустаяСсылка)";
	
КонецФункции

Функция МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации)
	
	Если Не ЗначениеЗаполнено(ИмяКонфигурации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Найдем общий модуль по семействам конфигураций
	Если ИмяКонфигурации = "ERP"
		Или ИмяКонфигурации = "КА_2"
		Или ИмяКонфигурации = "УФ_УТ" Тогда
		
		// Семество ERP
		ИмяКонфигурацииЛок = "ERP";
		
	ИначеЕсли ИмяКонфигурации = "УПП"
		Или ИмяКонфигурации = "УТ"
		Или ИмяКонфигурации = "КА" Тогда
		
		// Семейство УПП (обычные формы)
		ИмяКонфигурацииЛок = "УПП";
		
	ИначеЕсли ИмяКонфигурации = "УАТ"
		Или ИмяКонфигурации = "УАТ_ПРОФ"
		Или ИмяКонфигурации = "ТЛЭ"
		Или ИмяКонфигурации = "ERP_УАТ" Тогда
		
		// Сесмейство УАТ
		ИмяКонфигурацииЛок = "УАТ";
		
	Иначе
		
		// Все остальные, как БП, УНФ и т.д.
		ИмяКонфигурацииЛок = ИмяКонфигурации;
		
	КонецЕсли;
	
	// Имя модуля обработки
	ИмяМодуля = "КонтурЛогистика_КонвертацияТиповые" + ИмяКонфигурацииЛок;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль(ИмяМодуля);
	
КонецФункции

#КонецОбласти