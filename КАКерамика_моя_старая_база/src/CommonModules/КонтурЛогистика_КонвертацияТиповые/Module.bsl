#Область СлужебныйПрограммныйИнтерфейс

#Область КонвертацияДокументов

// См. КонтурЛогистика_КонвертацияСерверПовтИсп.ПоддерживаемыеТипыДокументовКонфигурации1С
//
Функция ПоддерживаемыеТипыДокументовКонфигурации1С(ТипДокументаЛогистика, СпецСценарий) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат ТипыДокументовКонфигурации1С;
	КонецЕсли;
	
	ТипыДокументовКонфигурации1С = МодульКонвертацииТиповойКонфигурации.ПоддерживаемыеТипыДокументовКонфигурации1С(
		ТипДокументаЛогистика, СпецСценарий);
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// Заполняет базовые настройки конвертации
//
// Параметры:
//  КонтекстНастройкиКонвертации - Струткура	 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииДокументов
//
Процедура ЗаполнитьБазовыеНастройкиКонвертации(КонтекстНастройкиКонвертации) Экспорт
	
	// Не первые титулы
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
		
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02
		
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2
		
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2 Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		КонтекстНастройкиКонвертации.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
		КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		// можно подписывать полученный, отправленный черновик, можно отправлять черновик
		КонтекстНастройкиКонвертации.Сценарий_РазрешитьПодписыватьПолученныйЧерновик = Истина;
		КонтекстНастройкиКонвертации.Сценарий_РазрешитьПодписыватьПослеОтправки = Истина;
		КонтекстНастройкиКонвертации.Сценарий_ОтправлятьНеподписанный = Истина;
	КонецЕсли;
	
	ЕстьТиповаяКонвертацияПоДокументуКонтурЛогистика = ЗаполнитьБазовыеНастройкиКонвертации_ОснованиеДокументКонтурЛогистика(КонтекстНастройкиКонвертации);
	
	Если Не ЕстьТиповаяКонвертацияПоДокументуКонтурЛогистика Тогда
		МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(КонтекстНастройкиКонвертации.ИмяКонфигурации);
		Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
			Возврат;
		КонецЕсли;

		КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная;

		МодульКонвертацииТиповойКонфигурации.ЗаполнитьБазовыеНастройкиКонвертации(КонтекстНастройкиКонвертации);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьБазовыеНастройкиКонвертации_ОснованиеДокументКонтурЛогистика(Контекст)
	
	Если Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
	
		Если Контекст.ТипДокумента1С = "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная;
			
			Контекст.ВыводитьЗадачи = Ложь;
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;	 
	
	Возврат Ложь;
	
КонецФункции 

Функция КонвертацияПоДокументуКонтурЛогистика(Контекст)
	
	Возврат Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		И Контекст.ТипДокумента1С = "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут";
	
КонецФункции		

// См. КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоДокументуУчетнойСистемы
//
Функция НайтиГлавныйДокументПоДокументуУчетнойСистемы(ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект) Экспорт
	
	ГлавныйДокумент = Неопределено;
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(КонтекстНастройкиКонвертации.ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат ГлавныйДокумент;
	КонецЕсли;
	
	Попытка
		ГлавныйДокумент = МодульКонвертацииТиповойКонфигурации.НайтиГлавныйДокументПоДокументуУчетнойСистемы(
			ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект);
	Исключение
		НичегоНеДелам = Истина;
	КонецПопытки;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

// См. КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(КонтекстНастройкиКонвертации.ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Переменные = Неопределено Тогда
		Переменные = Новый Структура;
	КонецЕсли;
	
	Попытка
		МодульКонвертацииТиповойКонфигурации.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
			ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
	Исключение
		НичегоНеДелам = Истина;
	КонецПопытки;
	
	// Подключаемый модуль
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ГлавныйДокументОбъект", ГлавныйДокументОбъект);
	ПараметрыПМ.Вставить("ДокументОснование", ДокументОснование);
	ПараметрыПМ.Вставить("КонтекстНастройкиКонвертации", КонтекстНастройкиКонвертации);
	ПараметрыПМ.Вставить("Переменные", Переменные);
	
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы_После", Истина, ПараметрыПМ);
	// Подключаемый модуль - Конец
	
КонецПроцедуры

// См. КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	Если Переменные = Неопределено Тогда
		Переменные = Новый Структура;
	КонецЕсли;
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(КонтекстНастройкиКонвертации.ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если КонвертацияПоДокументуКонтурЛогистика(КонтекстНастройкиКонвертации) Тогда
			ЗаполнитьДокументТитулПоДокументуКонтурЛогистика(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
		Иначе
			МодульКонвертацииТиповойКонфигурации.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
				ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
		КонецЕсли;
	Исключение
		НичегоНеДелам = Истина;
	КонецПопытки;
	
	// Подключаемый модуль
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("ДокументОбъект", ДокументОбъект);
	ПараметрыПМ.Вставить("КонтекстНастройкиКонвертации", КонтекстНастройкиКонвертации);
	ПараметрыПМ.Вставить("Переменные", Переменные);
	
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЗаполнитьДокументТитулПоДокументуУчетнойСистемы_После", Истина, ПараметрыПМ);
	// Подключаемый модуль - Конец
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитулПоДокументуКонтурЛогистика(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)

	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда

		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут" Тогда
			
			Источник = ДокументОбъект.ДокументОснование;
			Если ДокументОбъект.ДокументыОснования.Количество() > 0 Тогда 
				МассивИсточников = ДокументОбъект.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование");
			Иначе
				МассивИсточников = Новый Массив;
				МассивИсточников.Добавить(Источник);
			КонецЕсли;	
		
			ДокументОбъект.Функция = Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.Заказ;
			
			Если Источник.ВидТС.Количество() > 0 Тогда

				ДокументОбъект.ТСТип = Источник.ВидТС[0].ВидТС;
				Если ЗначениеЗаполнено(Источник.ВидТС[0].ТипКузов) Тогда
					ДокументОбъект.ТСТипКуз = Источник.ВидТС[0].ТипКузов;
				КонецЕсли;
				
			КонецЕсли;

			ДокументОбъект.ТСГрузопод = Источник.МассаБруттоКг;
			ДокументОбъект.ТСВместим = Источник.ОбъемГруза;
			ДокументОбъект.ПредСрПрвз = "Отсутствуют";
			ДокументОбъект.ПрвзПищПрод = "Отсутствуют";

			ДокументОбъект.ДатаЗак = Источник.ДатаДок;
			ДокументОбъект.НомЗак = Источник.НомДок;

			ДокументОбъект.Грузоотправитель = Источник.СвЭксп;
			// Перевозчика не знаем на момент формирования ЗЗ

			ДокументОбъект.ПунктПод = Источник.АдрГруз;
			ДокументОбъект.ПервыйПунктВыгрузки = Источник.АдрПунктНазн;
			ДокументОбъект.ДатВрПод = Источник.ДатОтгрС + Час(Источник.ВрОтгрС) * 3600 + Минута(Источник.ВрОтгрС) * 60;

			Если ЗначениеЗаполнено(Источник.УказКлнт) Тогда
				ДокументОбъект.ТемператураНеВыше = Источник.УказКлнт.ТемпНеВыше;
				ДокументОбъект.ТемператураНеНиже = Источник.УказКлнт.ТемпНеНиже;
				ДокументОбъект.ВлажностьНеНиже = Источник.УказКлнт.ВлажнНеНиже;
				ДокументОбъект.ВлажностьНеВыше = Источник.УказКлнт.ВлажнНеВыше;
			КонецЕсли;

			Если ЗначениеЗаполнено(Источник.ИдПарт) Тогда
				СтрокаИнфПол = ДокументОбъект.ИнфПол.Добавить();
				СтрокаИнфПол.Идентиф = "ПЭ_ИдПарт";
				СтрокаИнфПол.Значение = Источник.ИдПарт;
			КонецЕсли;
			
			Для Каждого Документ Из МассивИсточников Цикл
				ЗаполнитьТаблицуТоваровПоПЭ_Маршруту(ДокументОбъект, Источник);
			КонецЦикла;

			НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
			НоваяСтрока.Погрузка = Истина;
			НоваяСтрока.ПунктМаршрута = Источник.АдрГруз;

			НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
			НоваяСтрока.Выгрузка = Истина;
			НоваяСтрока.ПунктМаршрута = Источник.АдрПунктНазн;

			ДопПолучатель = ДокументОбъект.ДополнительныеПолучателиФайла.Добавить();
			ДопПолучатель.ОрганизацияДиадок = Источник.СвКлт;

			ДокументОбъект.Комментарий = "Создано из поручения экспедитору: " + Источник.Титул1;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// См. КонтурЛогистика_ОбработкаДокументовСервер.ВычислитьРеквизитыДокументаОснования
//
Функция ВычислитьРеквизитыДокументаОснования(ИменаРеквизитов, ДокументОбъект, Знач КонтекстНастройкиКонвертации) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(КонтекстНастройкиКонвертации.ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат ЗначенияРеквизитов;
	КонецЕсли;
	
	Попытка
		ЗначенияРеквизитов = МодульКонвертацииТиповойКонфигурации.ВычислитьРеквизитыДокументаОснования(
			ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации);
	Исключение
		НичегоНеДелам = Истина;
	КонецПопытки;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Номер счета фактура выданной по документу основания
//
// Параметры:
//  ДокументОснование	 - ДокументСсылка	 - документ основания.
// 
// Возвращаемое значение:
//  Строка - номер счета фактуры
//
Функция НомерСчетаФактураВыданной(ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Номер КАК Номер
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	ВЫРАЗИТЬ(СчетФактураВыданный.ДокументОснование КАК Документ.РеализацияТоваровУслуг) = &ДокументОснование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номер;
	Иначе
		Возврат "-";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область КонвертацияСправочников

// См. КонтурЛогистика_КонвертацияСерверПовтИсп.ПоддерживаемыеТипыСправочниковКонфигурации1С
//
Функция ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочникаЛогистика) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ПоддерживаемыеТипыСправочников = МодульКонвертацииТиповойКонфигурации.ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочникаЛогистика);
	
	// Дополнения
	ДополнительныеТипы = Новый Массив;
	Если КонтурЛогистика_КонвертацияСерверПовтИсп.ЕстьРегистрДокументыФизическихЛиц() Тогда
		Если ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
			ДополнительныеТипы.Добавить("ФизическиеЛица");
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеТипы.Количество() <> 0 Тогда
		ТолькоНовые = Истина;
		КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ДополнитьМассивЛок(ПоддерживаемыеТипыСправочников, ДополнительныеТипы, ТолькоНовые);
	КонецЕсли;
	// Дополнения Конец
	
	Возврат ПоддерживаемыеТипыСправочников;
	
КонецФункции

// Заполняет базовые настройки конвертации справочника
//
// Параметры:
//  КонтекстНастройкиКонвертации - Струткура	 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииСправочника
//
Процедура ЗаполнитьБазовыеНастройкиКонвертацииСправочника(КонтекстНастройкиКонвертации) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная;
	
	МодульКонвертацииТиповойКонфигурации.ЗаполнитьБазовыеНастройкиКонвертацииСправочника(КонтекстНастройкиКонвертации);
	
	// Дополнения
	Если КонтекстНастройкиКонвертации.ЕстьРегистрДокументыФизическихЛиц
		И КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	КонецЕсли;
	// Дополнения Конец
	
КонецПроцедуры

// Вычислить реквизиты справочника логистики по учетному объекту
//
// Параметры:
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииСправочника
//  Параметры					 - Структура
//		* УчетныйОбъект				 - СправочникСсылка, ДокументСсылка	 - Учетный объект конвертации из которго берем данные.
//		* ДокументОснование			 - ДокументСсылка	 - Контекстный документ основания из которого производится заполнение документа Логистики.
//		* ДокументОбъект			 - ДокументОбъект	 - Контекстный документ в котором конвертируется реквизит.
//		* Переменные				 - Структура		 - Контекстные переменные.
//	
//	ВАЖНО! Следующие параметры: 
//		      * ДокументОснование
//			  * ДокументОбъект
//			  * Переменные
//		   могут быть незаполненными, например при обновлении из учетного объекта. Следует в обработчиках проверять их заполненность.
//
//         Кроме того, перед проверкой реквизита КонтекстНастройкиКонвертации.РеквизитТитула также следует проверять заполненность 
//		   параметра ДокументОснование.
//
//  Результат					 - Структура
//		* Успешно					 - Булеов - Признак успешной конвертации.
//		* ОписаниеОшибки			 - Строка - Описание ошибок.
//		* МассивОшибок				 - Массив - Ошибки конвертации.
//		* ВычисленныеРеквизиты		 - ТаблицаЗначений - См. КонтурЛогистика_КонвертацияСервер.ОписаниеТаблицыВычисленныхРеквизитов()
//
Процедура ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(КонтекстНастройкиКонвертации, Параметры, Результат) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МодульКонвертацииТиповойКонфигурации.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(
		КонтекстНастройкиКонвертации, Параметры, Результат);
	
	// Дополнения
	Если КонтекстНастройкиКонвертации.ЕстьРегистрДокументыФизическихЛиц
		И КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица"
		И КонтекстНастройкиКонвертации.РеквизитТитула = "Водитель" Тогда
		
		ВычислитьРеквизитыВодителяИзРСДокументыФизическихЛиц(КонтекстНастройкиКонвертации, Параметры, Результат);
	КонецЕсли;
	// Дополнения Конец
	
	// Подключаемый модуль
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("КонтекстНастройкиКонвертации", КонтекстНастройкиКонвертации);
	ПараметрыПМ.Вставить("Параметры", Параметры);
	ПараметрыПМ.Вставить("Результат", Результат);
	
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту_После", Истина, ПараметрыПМ);
	// Подключаемый модуль - Конец
	
КонецПроцедуры

// Добавить вычесленный реквизит в итоговый результат
//
// Параметры:
//  ВычисленныеРеквизиты		 - ТаблицаЗначений	 - Место хранения результатов
//  ИмяРеквизита				 - Строка			 - Имя расчитываемого реквизита
//  Значение					 - Произвольное		 - Вычесленное значение
//  ОбновитьИзУчетнойСистемы	 - Булево			 - Если флаг установлен, то в процессе конвертации
//													   значение этого реквизита будет обновлено из учетной системы
//
Процедура ДобавитьВычесленныйРеквизит(ВычисленныеРеквизиты, ИмяРеквизита, Значение, ОбновитьИзУчетнойСистемы = Ложь) Экспорт
	
	НоваяСтрока = ВычисленныеРеквизиты.Добавить();
	НоваяСтрока.Реквизит = ИмяРеквизита;
	НоваяСтрока.Значение = Значение;
	НоваяСтрока.Обновить = ОбновитьИзУчетнойСистемы;
	
КонецПроцедуры

#КонецОбласти

#Область БазовыеСоответствияНоменклатуры

// Предзаполняет габариты и массу записи базового соответствия номенклатуры
//
// Параметры:
//  Запись - РегистрСведенийМенеджерЗаписи.КонтурЛогистика_БазовыеСоответствияНоменклатуры
//
Процедура ЗаполнитьВесогабаритныеПараметрыБазовогоСоответствия(Запись) Экспорт
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МодульКонвертацииТиповойКонфигурации.ЗаполнитьВесогабаритныеПараметрыБазовогоСоответствия(Запись);
	
КонецПроцедуры

#КонецОбласти

#Область КовертацияОбъектов

// Конвертируем значение в объект логистики
//
// Параметры:
//  КонвертируемоеЗначение		 - СправочникСсылка									 - Ссылка на объект конвертации.
//  ИмяРеквизитаОбъекта			 - Строка											 - Имя реквизита заполняемого объекта.
//  СпособКонвертацииЗначения	 - Перечисления.КонтурЛогистика_СпособыКонвертации	 - Способ конвертации.
//  ДокументОснование			 - ДокуентСсылка									 - Документ на основании которго происходит заполнение.
//  ДокументОбъект				 - ДокументОбъект									 - Заполняемый документ.
// 
// Возвращаемое значение:
//  Произвольное - Вычисленное значение.
//
Функция КонвертироватьЗначениеВОбъектЛогистики(КонвертируемоеЗначение,
											   ИмяРеквизитаОбъекта,
											   СпособКонвертацииЗначения,
											   ДокументОснование,
											   ДокументОбъект,
											   Переменные = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(КонвертируемоеЗначение) Тогда
		Результат = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_КонвертироватьЗначениеВОбъектЛогистики(
			КонвертируемоеЗначение, СпособКонвертацииЗначения,
			ИмяРеквизитаОбъекта, ДокументОснование,, ДокументОбъект, Переменные);
		
		Если Результат.Успешно Тогда
			Возврат Результат.Значение;
		Иначе
			Сообщить(Результат.ОписаниеОшибки);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область Дополнения

Процедура ВычислитьРеквизитыВодителяИзРСДокументыФизическихЛиц(КонтекстНастройкиКонвертации, Параметры, Результат)
	
	УчетныйОбъект = Параметры.УчетныйОбъект;
	ДокументОснование = Параметры.ДокументОснование;
	ДокументОбъект = Параметры.ДокументОбъект;
	Переменные = Параметры.Переменные;
	
	// Данные водителя из РС.ДокументыФизическихЛиц
	Попытка
		ТекущийВодитель = ДокументОснование.Водитель;
		ТекущаяДата = ДокументОснование.Дата;
	Исключение
		ТекущийВодитель = Неопределено;
		ТекущаяДата = Неопределено;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ТекущийВодитель) Тогда
		Возврат;
	КонецЕсли;
	
	ФизЛицо = Справочники["ФизическиеЛица"].НайтиПоНаименованию(ТекущийВодитель);
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДата);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыФизическихЛиц.Серия КАК Серия,
	|	ДокументыФизическихЛиц.Номер КАК Номер,
	|	ДокументыФизическихЛиц.ДатаВыдачи КАК ДатаВыдачи
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
	|		&ДатаСреза,
	|		ФизЛицо = &ФизЛицо И ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)) КАК ДокументыФизическихЛиц";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"РольВодитель", Истина);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаРождения", ФизЛицо.ДатаРождения);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУСерия", Выборка.Серия);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУНомер", Выборка.Номер);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУДатаВыдачи", Выборка.ДатаВыдачи);
		
		Если ТипЗнч(УчетныйОбъект) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ТекущееФИО = УчетныйОбъект.Наименование;
		Иначе
			ТекущееФИО = Строка(УчетныйОбъект);
		КонецЕсли;
		
		ДанныеФИО = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ТекущееФИО, " ");
		Если ДанныеФИО.Количество() > 1 Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Имя", ДанныеФИО[1]);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Фамилия", ДанныеФИО[0]);
			
			Если ДанныеФИО.Количество() > 3 Тогда
				Отчество = ДанныеФИО[2] + " " + ДанныеФИО[3];
			ИначеЕсли ДанныеФИО.Количество() > 2 Тогда
				Отчество = ДанныеФИО[2];
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Отчество", Отчество);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает связанные учётные документы для поиска ЭЗЗ при вводе ЭТрН.
// Например, для РТУ — ЗаказКлиента (ERP) или ЗаказПокупателя (УПП).
//
// Параметры:
//  ДокументОснование - ДокументСсылка - учётный документ, из которого вводится ЭТрН
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция СвязанныеОснованияДляПоискаЭЗЗ(ДокументОснование) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	МодульКонвертацииТиповойКонфигурации = МодульКонвертацииТиповойКонфигурации(ИмяКонфигурации);
	Если МодульКонвертацииТиповойКонфигурации = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат = МодульКонвертацииТиповойКонфигурации.СвязанныеОснованияДляПоискаЭЗЗ(ДокументОснование);
	Исключение
		// Метод может отсутствовать в модуле семейства конфигурации
		Возврат Результат;
	КонецПопытки;
	
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		Результат = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает документы-основания для заполнения ТЧ Товары ЗЗ.
// При настройке «1 ЭЗЗ из нескольких документов» — все основания из ДокументыОснования логистического документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.КонтурЛогистика_ЗЗ_Титул1
//  ДокументОснование - ДокументСсылка - текущее основание конвертации
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ОснованияДляЗаполненияТоваровЗЗ(ДокументОбъект, ДокументОснование) Экспорт
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдномуЭЗЗ")
		И ДокументОбъект.ДокументыОснования.Количество() > 1 Тогда
		
		Результат = Новый Массив;
		Для Каждого СтрокаОснования Из ДокументОбъект.ДокументыОснования Цикл
			Если ЗначениеЗаполнено(СтрокаОснования.ДокументОснование) Тогда
				Результат.Добавить(СтрокаОснования.ДокументОснование);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
	
КонецФункции

// Возвращает документы-основания для заполнения ТЧ Товары ТрН Титул 1.
// При настройке «1 ЭТрН из нескольких документов» — все основания из ДокументыОснования логистического документа.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.КонтурЛогистика_ТрН_Титул1
