	Если ЗначениеЗаполнено(ДокументОснование.ВалютаДокумента) Тогда
		Валюта = ДокументОснование.ВалютаДокумента;
	Иначе
		Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С("643", "руб");
	КонецЕсли;
	
	ВидТары = Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду("CT");
	
	// ТЧ Товары	
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Цикл
		
		Попытка
			ЕстьГрузовойСостав = ТекДокОснование.ГрузовойСостав.Количество() > 0;
		Исключение
			// Это УАТ Стандарт
			ЕстьГрузовойСостав = Ложь;
		КонецПопытки;
		
		Если ЕстьГрузовойСостав Тогда
			
			Для Каждого ТекущаяСтрока Из ТекДокОснование.ГрузовойСостав Цикл
				
				НоваяСтрока = ДокументОбъект.Товары.Добавить();
				НоваяСтрока.ВидТары = ВидТары;
				НоваяСтрока.СпособУпаковки = "В таре";
				
				РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Истина, Истина, Истина);
				
				Если ЗначениеЗаполнено(НоваяСтрока.ОбъявленнаяЦенность)
					И Не ЗначениеЗаполнено(НоваяСтрока.ОбъявленнаяЦенностьВалюта) Тогда
					
					НоваяСтрока.ОбъявленнаяЦенностьВалюта = Валюта;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого ТекущаяСтрока Из ТекДокОснование.Товары Цикл
				
				НоваяСтрока = ДокументОбъект.Товары.Добавить();
				НоваяСтрока.ВидТары = ВидТары;
				НоваяСтрока.СпособУпаковки = "В таре";
				
				РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Истина, Ложь, Истина);
				
				Если ЗначениеЗаполнено(НоваяСтрока.ОбъявленнаяЦенность)
					И Не ЗначениеЗаполнено(НоваяСтрока.ОбъявленнаяЦенностьВалюта) Тогда
					
					НоваяСтрока.ОбъявленнаяЦенностьВалюта = Справочники.Валюты.НайтиПоКоду("643");
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

