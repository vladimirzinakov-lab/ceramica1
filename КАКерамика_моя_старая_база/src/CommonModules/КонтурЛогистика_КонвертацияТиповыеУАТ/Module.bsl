			ДокументОснование, ДокументОбъект);
		
		Если ЗначениеЗаполнено(Переменные.МаршрутныйЛист.Водитель2) Тогда
			ДокументОбъект.Водитель2 = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				Переменные.МаршрутныйЛист.Водитель2, "Водитель2",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
		
