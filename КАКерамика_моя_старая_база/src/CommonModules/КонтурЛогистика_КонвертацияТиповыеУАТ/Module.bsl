Процедура РассчитатьПараметрыГруза(Знач ТекущаяСтрока, НоваяСтрока, ЭтоТ1 = Истина, ГрузовойСостав = Ложь, ЭтоЗаказ = Ложь, ЭтоПЭ1 = Ложь)
	
	Попытка 
		НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки;
	Исключение
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецПопытки;
	
	НоваяСтрока.Учитывать = Истина;
	
	Если Не ЭтоПЭ1 Тогда
		НоваяСтрока.СостояниеГруза = "Без замечаний";
	КонецЕсли;
	
	Если ГрузовойСостав Тогда
		Номенклатура = ТекущаяСтрока.ГрузовоеМесто;
	Иначе
		Номенклатура = ТекущаяСтрока.Номенклатура;
	КонецЕсли;
	
	ВесОбъем = РассчитатьВесОбъем(ТекущаяСтрока, ГрузовойСостав, ЭтоЗаказ);
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.уатГрузовыеМеста_уэ") Тогда
				
		НоваяСтрока.ОтгрузочноеНаименование = Номенклатура.Наименование;
		НоваяСтрока.Количество 				= ТекущаяСтрока.КоличествоМест;
		
		Если ВесОбъем = Неопределено Тогда 
			НоваяСтрока.Высота 	= Номенклатура.Высота;
			НоваяСтрока.Длина 	= Номенклатура.Длина;
			НоваяСтрока.Ширина 	= Номенклатура.Ширина;
		КонецЕсли;
		
	Иначе
	
		НоваяСтрока.ОтгрузочноеНаименование 	= Номенклатура.НаименованиеПолное;
		НоваяСтрока.Номенклатура 				= Номенклатура;
		НоваяСтрока.УпаковкаЕдиницаИзмерения	= ТекущаяСтрока.ЕдиницаИзмерения;
		НоваяСтрока.Количество 					= ТекущаяСтрока.Количество;
						
	КонецЕсли;
	
	Если ВесОбъем = Неопределено Тогда
		
		НоваяСтрока.КоличествоМест 	= ТекущаяСтрока.КоличествоМест;
		НоваяСтрока.ОбъемКубМ 		= ТекущаяСтрока.Объем;
		
		Если ЭтоТ1 Тогда
			НоваяСтрока.МассаПлановаяБруттоКг = ТекущаяСтрока.ВесБрутто;
		Иначе
			НоваяСтрока.МассаБруттоКг = ТекущаяСтрока.ВесБрутто;
			Если ЭтоПЭ1 Тогда
				НоваяСтрока.МассаНеттоКг = НоваяСтрока.МассаБруттоКг;	
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВесОбъем);
		
		Если НоваяСтрока.КоличествоМест = 0 Тогда
			НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
		КонецЕсли;
		
		Если Не ЭтоТ1 Тогда
			НоваяСтрока.МассаБруттоКг = ВесОбъем.МассаПлановаяБруттоКг;
		КонецЕсли;
		
		Если ЭтоПЭ1 Тогда
			НоваяСтрока.СтоимостьГруза 		= ВесОбъем.ОбъявленнаяЦенность;
			НоваяСтрока.ВалютаУчетаГруза	= ВесОбъем.ОбъявленнаяЦенностьВалюта;
			Если ЗначениеЗаполнено(ВесОбъем.ВесТары) Тогда
				НоваяСтрока.МассаНеттоКг = НоваяСтрока.МассаБруттоКг - ВесОбъем.ВесТары;
			Иначе
				НоваяСтрока.МассаНеттоКг = НоваяСтрока.МассаБруттоКг;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

Функция ПолучитьМаршрутныйЛист(ДокументОснование)
	
	МодульуатОбменСГИСЭПД = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("уатОбменСГИСЭПД");
	Если МодульуатОбменСГИСЭПД <> Неопределено Тогда
		
		Попытка
			СтруктураРезультат = МодульуатОбменСГИСЭПД.ПолучитьСвязанныеРейсы(
				ДокументОснование, Тип("ДокументСсылка.уатЗаказГрузоотправителя"));
		Исключение
			Попытка
				СтруктураРезультат = МодульуатОбменСГИСЭПД.ПолучитьСвязанныеРейсы(
					ДокументОснование);	
			Исключение
				СтруктураРезультат = Неопределено;	
			КонецПопытки;
		КонецПопытки;
			
		Если ТипЗнч(СтруктураРезультат) = Тип("Структура")
			И СтруктураРезультат.Свойство("МаршрутныйЛист") Тогда
			
			МаршрутныйЛист = СтруктураРезультат.МаршрутныйЛист;
			
		Иначе
			МаршрутныйЛист = Неопределено;
		КонецЕсли;
		
	Иначе
		МаршрутныйЛист = Неопределено;
	КонецЕсли;
	
	Возврат МаршрутныйЛист;
	
КонецФункции

#КонецОбласти