Функция ПолучитьДопДанныеДляПЭ(ДокументыОснования)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	уатЗаказГрузоотправителяТовары.Номенклатура КАК Номенклатура,
		|	КонтурЛогистика_СтраныМира.Ссылка КАК СтранаПроисхождения
		|ИЗ
		|	Документ.уатЗаказГрузоотправителя.Товары КАК уатЗаказГрузоотправителяТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_СтраныМира КАК КонтурЛогистика_СтраныМира
		|		ПО уатЗаказГрузоотправителяТовары.Номенклатура.СтранаПроисхождения.Код = КонтурЛогистика_СтраныМира.Код
		|			И (уатЗаказГрузоотправителяТовары.Ссылка В (&ДокументыОснования))";
	
	Запрос.УстановитьПараметр("ДокументыОснования", ДокументыОснования);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
		
КонецФункции

