// Конвертация для типового семейства конфигураций УАТ.
// Такие как:
//   - 1С:УАТ Стандарт
//   - 1С:УАТ ПРОФ
//   - 1С:ТЛЭ КОРП
//   - 1С:Управление автотранспортом. Модуль для 1С:ERP

#Область СлужебныйПрограммныйИнтерфейс

#Область КонвертацияДокументов

// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыДокументовКонфигурации1С
//
Функция ПоддерживаемыеТипыДокументовКонфигурации1С(ТипДокументаЛогистика, СпецСценарий) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатЗаказГрузоотправителя");
		ТипыДокументовКонфигурации1С.Добавить("уатМаршрутныйЛист");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатПутевойЛист");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатЗаказГрузоотправителя");
		ТипыДокументовКонфигурации1С.Добавить("уатМаршрутныйЛист");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатЗаказГрузоотправителя");	
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертации
//
Процедура ЗаполнитьБазовыеНастройкиКонвертации(Контекст) Экспорт
	
	Если Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			
		ИначеЕсли Контекст.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			ЗаполнитьПутиРеквизитов_уатЗаказГрузоотправителя(Контекст);
			
		ИначеЕсли Контекст.ТипДокумента1С = "уатМаршрутныйЛист" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;

			ЗаполнитьПутиРеквизитов_уатМаршрутныйЛист(Контекст);
						
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			
		ИначеЕсли Контекст.ТипДокумента1С = "уатПутевойЛист" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;

			Если Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
				Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;				
			Иначе
				Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе;
			КонецЕсли;
			
			ЗаполнитьПутиРеквизитов_уатПутевойЛист(Контекст);
			
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда	
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			
		ИначеЕсли Контекст.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			Контекст.ДокументыОснованияВложенныхДокументов.ПутьРеквизитДокументОснования = "Ссылка";
			
			ЗаполнитьПутиРеквизитов_уатЗаказГрузоотправителя(Контекст);
								
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено
			Или Контекст.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.НайтиГлавныйДокументПоДокументуУчетнойСистемы
//
Функция НайтиГлавныйДокументПоДокументуУчетнойСистемы(ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект) Экспорт
	
	ГлавныйДокумент = Неопределено;
	
	Если КонтекстНастройкиКонвертации.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ДокументОснование.Грузоотправитель;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "уатМаршрутныйЛист" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ДокументОснование.Организация;
		
	Иначе
		
		НомерДокумента = Неопределено;
		ДатаДокумента = Неопределено;
		Грузоотправитель = Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Грузоотправитель", Грузоотправитель);
		Запрос.УстановитьПараметр("НомерТрН", НомерДокумента);
		Запрос.УстановитьПараметр("ДатаТрН", ДатаДокумента);
		Запрос.УстановитьПараметр("Разделитель", Разделитель);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		|ГДЕ
		|	(КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = &Грузоотправитель
		|			ИЛИ &Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)
		|			ИЛИ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка))
		|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН = &НомерТрН
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН = &ДатаТрН
		|			ИЛИ &ДатаТрН = ДАТАВРЕМЯ(1, 1, 1))
		|	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Разделитель = &Разделитель
		|			ИЛИ &Разделитель = НЕОПРЕДЕЛЕНО)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ГлавныйДокумент = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
		
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
	
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			ЗаполнитьГлавныйДокумент_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "уатМаршрутныйЛист" Тогда
			
			ЗаполнитьГлавныйДокумент_уатМаршрутныйЛист(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
	
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Если ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
		
			ЗаполнитьДокументТитул_ТрН_Титул1_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли ТипДокумента1С = "уатМаршрутныйЛист" Тогда 
			
			ЗаполнитьДокументТитул_ТрН_Титул1_уатМаршрутныйЛист(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокументаЛогистика) Тогда
		
		ЗаполнитьДокументТитул_ПЛ(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
		
			ЗаполнитьДокументТитул_ЗЗ_Титул1_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли ТипДокумента1С = "уатМаршрутныйЛист" Тогда 
			
			ЗаполнитьДокументТитул_ЗЗ_Титул1_уатМаршрутныйЛист(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
		
		ДокументОбъект.Расчет = "Аванс";
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		Если ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
		
		Если ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			ЗаполнитьДокументТитул_ПЭ_ЗаявкаНаМаршрут_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыДокументаОснования
//
Функция ВычислитьРеквизитыДокументаОснования(ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
		
			МодульуатОбменСГИСЭПД = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("уатОбменСГИСЭПД");
			Если МодульуатОбменСГИСЭПД <> Неопределено Тогда
				СтруктураРезультат = МодульуатОбменСГИСЭПД.ПолучитьСвязанныеРейсы(
					ДокументОснование.Ссылка, Тип("ДокументСсылка.уатЗаказГрузоотправителя"));
				Попытка
					МаршрутныйЛист = СтруктураРезультат.МаршрутныйЛист;
				Исключение
					МаршрутныйЛист = Неопределено;
				КонецПопытки;
			Иначе
				МаршрутныйЛист = Неопределено;
			КонецЕсли;
			
			Грузоотправитель = ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель), ДокументОснование.Грузоотправитель, ДокументОснование.Организация);
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", Грузоотправитель);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
				
				Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Перевозчик", МаршрутныйЛист.Контрагент);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("ТранспортноеСредство", МаршрутныйЛист.ТС);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Прицеп") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Прицеп", МаршрутныйЛист.Прицеп1);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Прицеп2") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Прицеп2", МаршрутныйЛист.Прицеп2);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Водитель", МаршрутныйЛист.Водитель1);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Водитель2") <> Неопределено
					И ЗначениеЗаполнено(МаршрутныйЛист.Водитель2) Тогда
					
					ЗначенияРеквизитов.Вставить("Водитель2", МаршрутныйЛист.Водитель2);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузополучатель", ДокументОснование.Грузополучатель);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.АдресОтправления);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.АдресНазначения);
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "уатМаршрутныйЛист" Тогда
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", ДокументОснование.Контрагент);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ДокументОснование.ТС);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Прицеп") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Прицеп", ДокументОснование.Прицеп1);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Прицеп2") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Прицеп2", ДокументОснование.Прицеп2);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Водитель", ДокументОснование.Водитель1);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Водитель2") <> Неопределено
				И ЗначениеЗаполнено(ДокументОснование.Водитель2) Тогда
				
				ЗначенияРеквизитов.Вставить("Водитель2", ДокументОснование.Водитель2);
			КонецЕсли;			
				
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда   
				
				ПоследнийЗаказ = НайтиПоследнийЗаказ(ДокументОснование.Заказы);
				Если ЗначениеЗаполнено(ПоследнийЗаказ) Тогда 
					ЗначенияРеквизитов.Вставить("Грузополучатель", ПоследнийЗаказ.Грузополучатель);
				КонецЕсли;				
				
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.АдресОтправления);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.АдресНазначения);
			КонецЕсли;	
			
		КонецЕсли;
		
	ИначеЕсли (КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02) Тогда
			
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "уатПутевойЛист" Тогда
		
			Если ИменаРеквизитов.Найти("ЛицоОформившееПЛ") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ЛицоОформившееПЛ", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ОрганизацияМедик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ОрганизацияМедик", ДокументОснование.Медорганизация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Водитель", ДокументОснование.Водитель1);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Водитель2") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Водитель2", ДокументОснование.Водитель2);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ДокументОснование.ТранспортноеСредство);
			КонецЕсли;
			
			Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
				
				Если ИменаРеквизитов.Найти("ОрганизацияТехСостояние") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("ОрганизацияТехСостояние", ДокументОснование.КонтрольТранспорта);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("ОрганизацияОдометр") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("ОрганизацияОдометр", ДокументОснование.ПоказанияОдометра);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Контрагент);
				КонецЕсли;
				
				Если ИменаРеквизитов.Найти("МестоОтправления") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("МестоОтправления", ДокументОснование.Гараж);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "уатЗаказГрузоотправителя" Тогда
			
			МодульуатОбменСГИСЭПД = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("уатОбменСГИСЭПД");
			Если МодульуатОбменСГИСЭПД <> Неопределено Тогда
				СтруктураРезультат = МодульуатОбменСГИСЭПД.ПолучитьСвязанныеРейсы(
					ДокументОснование.Ссылка, Тип("ДокументСсылка.уатЗаказГрузоотправителя"));
				Попытка
					МаршрутныйЛист = СтруктураРезультат.МаршрутныйЛист;
				Исключение
					МаршрутныйЛист = Неопределено;
				КонецПопытки;
			Иначе
				МаршрутныйЛист = Неопределено;
			КонецЕсли;
			
			Грузоотправитель = ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель), ДокументОснование.Грузоотправитель, ДокументОснование.Организация);	
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", Грузоотправитель);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
				
				Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("Перевозчик", МаршрутныйЛист.Контрагент);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ПунктПод") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ПунктПод", ДокументОснование.АдресОтправления);
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "уатМаршрутныйЛист" Тогда
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Организация);
			КонецЕсли;
							
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", ДокументОснование.Контрагент);
			КонецЕсли;
				
			Если ИменаРеквизитов.Найти("ПунктПод") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ПунктПод", ДокументОснование.АдресОтправления);
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

#КонецОбласти

#Область КонвертацияСправочников

// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыСправочниковКонфигурации1С
//
Функция ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочникаЛогистика) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("Сотрудники");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("Контрагенты");
		ТипыДокументовКонфигурации1С.Добавить("Организации");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатПунктыНазначения");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатТС");
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию() = "ERP_УАТ" Тогда
			ТипыДокументовКонфигурации1С.Добавить("ТранспортныеСредства");
		КонецЕсли;
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_Лицензии" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("уатРегистрационныеДокументы");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_Договоры" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ДоговорыКонтрагентов");
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертацииСправочника
//
Процедура ЗаполнитьБазовыеНастройкиКонвертацииСправочника(КонтекстНастройкиКонвертации) Экспорт
	
	ЭтоERP_УАТ = (КонтекстНастройкиКонвертации.ИмяКонфигурации = "ERP_УАТ");
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Сотрудники") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "уатПунктыНазначения") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "уатТС"
			Или (ЭтоERP_УАТ И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортныеСредства")) Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Лицензии"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "уатРегистрационныеДокументы") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ДоговорыКонтрагентов") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;	
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту
//
Процедура ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(КонтекстНастройкиКонвертации, Параметры, Результат) Экспорт
	
	УчетныйОбъект = Параметры.УчетныйОбъект;
	
	// Могуть быть незаполненными!
	ДокументОснование = Параметры.ДокументОснование;  // От заполненности этого параметра зависит заполненность РеквизитаТитула!
	ДокументОбъект = Параметры.ДокументОбъект;
	Переменные = Параметры.Переменные;
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Сотрудники"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица") Тогда
			
		Если ТипЗнч(УчетныйОбъект) = Тип("СправочникСсылка.Сотрудники") Тогда
			ФизическоеЛицо = УчетныйОбъект.ФизическоеЛицо;
			Сотрудник	   = УчетныйОбъект; 
		Иначе
			ФизическоеЛицо = УчетныйОбъект;
		КонецЕсли;
			
		МодульУАТОбщегоНазначения = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("уатОбщегоНазначения");
		Если МодульУАТОбщегоНазначения <> Неопределено Тогда
			ВУСерия = "";
			ВУНомер = "";
			ВУДатаВыдачи = "";
			МодульУАТОбщегоНазначения.уатУдостоверениеВодителя(УчетныйОбъект, ВУСерия, ВУНомер, "", ВУДатаВыдачи);
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВУСерия", ВУСерия, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВУНомер", ВУНомер, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВУДатаВыдачи", ВУДатаВыдачи, ОбновлятьРеквизиты);
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаРождения", ФизическоеЛицо.ДатаРождения, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ИНН", ФизическоеЛицо.ИНН, ОбновлятьРеквизиты);
		
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Должность", Сотрудник.Должность, ОбновлятьРеквизиты);
		КонецЕсли;
		
		// ТелефонОсновной
		МодульУАТВзаимодействия = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("Взаимодействия");
		Если МодульУАТВзаимодействия <> Неопределено Тогда
			ТелефонОсновной = "";
			МодульУАТВзаимодействия.ДозаполнитьПоляКонтактов(ФизическоеЛицо, "",
				ТелефонОсновной, ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон"));
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ТелефонОсновной", ТелефонОсновной, ОбновлятьРеквизиты);
		КонецЕсли;
		
		// ФИО
		Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
			ВключатьПустные = Ложь;
			ДанныеФИО = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ФизическоеЛицо.ФИО, " ", ВключатьПустные);
			Если ДанныеФИО.Количество() > 1 Тогда
				
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Имя", ДанныеФИО[1], ОбновлятьРеквизиты);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Фамилия", ДанныеФИО[0], ОбновлятьРеквизиты);
				
				Если ДанныеФИО.Количество() > 3 Тогда
					Отчество = ДанныеФИО[2] + " " + ДанныеФИО[3];
				ИначеЕсли ДанныеФИО.Количество() > 2 Тогда
					Отчество = ДанныеФИО[2];
				КонецЕсли;
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Отчество", Отчество, ОбновлятьРеквизиты);
				
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда		
			Если КонтекстНастройкиКонвертации.РеквизитТитула = "Водитель"
				Или КонтекстНастройкиКонвертации.РеквизитТитула = "Водитель2" Тогда
				
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"РольВодитель", Истина, ОбновлятьРеквизиты);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"СНИЛС", ФизическоеЛицо.СтраховойНомерПФР, ОбновлятьРеквизиты);
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"КПП", УчетныйОбъект.КПП, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"НаименованиеОрганизацииПолное", УчетныйОбъект.НаименованиеПолное, ОбновлятьРеквизиты);
			
			Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты" Тогда
				
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"ИнАдресCountry", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
				
			Иначе
				
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"ОГРН", УчетныйОбъект.ОГРН, ОбновлятьРеквизиты);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Фамилия", УчетныйОбъект.ФамилияИП, ОбновлятьРеквизиты);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Имя", УчетныйОбъект.ИмяИП, ОбновлятьРеквизиты);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Отчество", УчетныйОбъект.ОтчествоИП, ОбновлятьРеквизиты);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "уатПунктыНазначения" Тогда
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Если КонтекстНастройкиКонвертации.РеквизитТитула = "МестоПогрузки" Тогда
				Направление = "Отправление";
			Иначе
				Направление = "Прибытие";
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					Направление, Истина, ОбновлятьРеквизиты);
		КонецЕсли;			
					
		Если Направление = "Отправление" И Не ЗначениеЗаполнено(УчетныйОбъект.Контрагент) Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатМаршрутныйЛист") Тогда
				
				Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ДокументОснование.Организация, "Грузоотправитель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
			
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатЗаказГрузоотправителя") Тогда	
				
				Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ДокументОснование.Грузоотправитель, "Грузоотправитель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);		
					
			КонецЕсли;
			
		Иначе    
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					УчетныйОбъект.Контрагент, "Грузоотправитель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
			КонецЕсли;			
						
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Собственник) Тогда
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"Собственник", Собственник, ОбновлятьРеквизиты);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(УчетныйОбъект.Страна) Тогда
			Страна = Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду(УчетныйОбъект.Страна.Код);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Страна) Тогда
			Страна = Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643");
		КонецЕсли;
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфКодСтраны", Страна, ОбновлятьРеквизиты);
			
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресИнфАдрес", УчетныйОбъект.Адрес, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресПредставление", УчетныйОбъект.Адрес, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КоординатыДолгота", УчетныйОбъект.Лон, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КоординатыШирота", УчетныйОбъект.Лат, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "уатТС" Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				
				Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
					
					МаршрутныйЛист = ДокументОснование;
					Если ДокументОснование.Прицепы.Количество() > 0 Тогда
						Прицеп = ДокументОснование.Прицепы[0].ТС;
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатМаршрутныйЛист") Тогда
					
					МаршрутныйЛист = ДокументОснование;
					Прицеп		   = ДокументОснование.Прицеп1;
					
				ИначеЕсли Переменные.Свойство("МаршрутныйЛист")
					И ЗначениеЗаполнено(Переменные.МаршрутныйЛист) Тогда
					
					МаршрутныйЛист = Переменные.МаршрутныйЛист;					
					Если ТипЗнч(МаршрутныйЛист) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
						Если МаршрутныйЛист.Прицепы.Количество() > 0 Тогда
							Прицеп = МаршрутныйЛист.Прицепы[0].ТС;
						КонецЕсли;
					ИначеЕсли ТипЗнч(МаршрутныйЛист) = Тип("ДокументСсылка.уатМаршрутныйЛист") Тогда
						Прицеп		   = МаршрутныйЛист.Прицеп1;
					КонецЕсли;
					
				КонецЕсли;
							
				Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
					
					Если ЗначениеЗаполнено(Прицеп)
						И Не КонтекстНастройкиКонвертации.РеквизитТитула = "Прицеп" Тогда
						
						КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
							"ВместимостьКубМ", 0, ОбновлятьРеквизиты);
						КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
							"ГрузоподъемностьТонн", 0, ОбновлятьРеквизиты);
						
					Иначе
						
						КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
							"ВместимостьКубМ", УчетныйОбъект.Модель.ОбъемКузова, ОбновлятьРеквизиты);
						КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
							"ГрузоподъемностьТонн", УчетныйОбъект.Модель.Грузоподъемность, ОбновлятьРеквизиты);
						
					КонецЕсли;
					
				КонецЕсли;
				
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"ЭтоПрицеп", КонтекстНастройкиКонвертации.РеквизитТитула = "Прицеп", ОбновлятьРеквизиты);
				
				АрендодательЛизингодатель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					УчетныйОбъект.ВладелецТС, "АрендодательЛизингодатель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"АрендодательЛизингодатель", АрендодательЛизингодатель, ОбновлятьРеквизиты);
				
			КонецЕсли;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"VIN", УчетныйОбъект.VIN, ОбновлятьРеквизиты);							
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МаркаТС", УчетныйОбъект.Марка, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МодельТС", УчетныйОбъект.Модель, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"РегНомер", УчетныйОбъект.ГосударственныйНомер, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ТипТС", УчетныйОбъект.ТипТС, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"СТС", УчетныйОбъект.Организация.СвидетельствоСерияНомер, ОбновлятьРеквизиты);
						
			Если УчетныйОбъект.ПринадлежностьТС = ПредопределенноеЗначение("Перечисление.уатПринадлежностьТС.Собственное") Тогда
				ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1;
			Иначе
				ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Аренда_3;
			КонецЕсли;
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВидВладения", ВидВладения, ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортныеСредства" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"VIN", УчетныйОбъект.уатVIN, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВместимостьКубМ", УчетныйОбъект.уатМодель.ОбъемКузова, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ГрузоподъемностьТонн", УчетныйОбъект.уатМодель.Грузоподъемность, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МаркаТС", УчетныйОбъект.уатМарка, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МодельТС", УчетныйОбъект.уатМодель, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"РегНомер", УчетныйОбъект.Код, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ТипТС", УчетныйОбъект.Тип, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"СТС", УчетныйОбъект.уатОрганизация.СвидетельствоСерияНомер, ОбновлятьРеквизиты);
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				АрендодательЛизингодатель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					УчетныйОбъект.уатВладелецТС, "АрендодательЛизингодатель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"АрендодательЛизингодатель", АрендодательЛизингодатель, ОбновлятьРеквизиты);
				
				Если ДокументОснование.уатПринадлежностьТС = ПредопределенноеЗначение("Перечисление.уатПринадлежностьТС.Собственное") Тогда
					ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1;
				Иначе
					ВидВладения = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Аренда_3;
				КонецЕсли;
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"ВидВладения", ВидВладения, ОбновлятьРеквизиты);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Лицензии"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "уатРегистрационныеДокументы" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Владелец", ДокументОбъект.МедРаботник, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Серия", УчетныйОбъект.Серия, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Номер", УчетныйОбъект.Номер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаВыдачи", УчетныйОбъект.ДатаОкончания, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"СрокОкончанияДействия", УчетныйОбъект.Серия, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КемВыдана", УчетныйОбъект.КемВыдан, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВидЛицензии", Перечисления.КонтурЛогистика_ВидыЛицензий.Медицинская, ОбновлятьРеквизиты);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ДоговорыКонтрагентов" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаДокумента", УчетныйОбъект.Дата, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Контрагент", УчетныйОбъект.Контрагент, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КонтрагентИНН", УчетныйОбъект.Контрагент.ИНН, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"НомерДокумента", УчетныйОбъект.Номер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Организация", УчетныйОбъект.Организация, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ОрганизацияИНН", УчетныйОбъект.Организация.ИНН, ОбновлятьРеквизиты);	
		
	КонецЕсли;
	
КонецПроцедуры

