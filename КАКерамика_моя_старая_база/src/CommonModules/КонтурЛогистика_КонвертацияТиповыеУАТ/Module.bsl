Процедура ЗаполнитьГлавныйДокумент_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	МаршрутныйЛист = ПолучитьМаршрутныйЛист(ДокументОснование.Ссылка);
	
	Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
		Переменные.Вставить("МаршрутныйЛист", МаршрутныйЛист);
	КонецЕсли;
	
	ДокументОбъект.НомерТрН = ДокументОснование.Номер;
	ДокументОбъект.ДатаТрН = ДокументОснование.Дата;
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.СрокДоставки = ДокументОснование.ДоставкаПо;
	ДокументОбъект.ДатаВремяДоставки = ДокументОснование.ДоставкаПо;
	ДокументОбъект.ЭтоЭкспедиция = Ложь;
	
	Грузоотправитель = ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель), ДокументОснование.Грузоотправитель, ДокументОснование.Организация);
	
	ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		Грузоотправитель, "Грузоотправитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
		
		ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			МаршрутныйЛист.Контрагент, "Перевозчик",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
		
		Если ТипЗнч(МаршрутныйЛист) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				
			ТранспортноеСредство = МаршрутныйЛист.ТранспортноеСредство;
			Прицеп1 = МаршрутныйЛист.ОборудованиеПрицеп1;
			Прицеп2 = МаршрутныйЛист.ОборудованиеПрицеп2;
			
		Иначе
			
			ТранспортноеСредство = МаршрутныйЛист.ТС;
			Прицеп1 = МаршрутныйЛист.Прицеп1;
			Прицеп2 = МаршрутныйЛист.Прицеп2;
			
		КонецЕсли;
		
		ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ТранспортноеСредство, "ТранспортноеСредство",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект, Переменные);
			
		Если ЗначениеЗаполнено(Прицеп1) Тогда
		
			ДокументОбъект.Прицеп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				Прицеп1, "Прицеп",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
				ДокументОснование, ДокументОбъект, Переменные);	
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Прицеп2) Тогда
			
			ДокументОбъект.Прицеп2 = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				Прицеп2, "Прицеп",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
				ДокументОснование, ДокументОбъект, Переменные);	
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументОбъект.Грузополучатель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Грузополучатель, "Грузополучатель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоПогрузки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресОтправления, "МестоПогрузки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоДоставки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресНазначения, "МестоДоставки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);	
	
КонецПроцедуры

Процедура ЗаполнитьГлавныйДокумент_уатМаршрутныйЛист(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументОбъект.НомерТрН = ДокументОснование.Номер;
	ДокументОбъект.ДатаТрН = ДокументОснование.Дата;
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.СрокДоставки = ДокументОснование.ДатаИВремяВыполненияПлан;
	ДокументОбъект.ДатаВремяДоставки = ДокументОснование.ДатаИВремяВыполненияПлан;
	ДокументОбъект.ЭтоЭкспедиция = Ложь;
	
	ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "Грузоотправитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Контрагент, "Перевозчик",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.ТС, "ТранспортноеСредство",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
		ДокументОснование, ДокументОбъект, Переменные);
		
	Если ЗначениеЗаполнено(ДокументОснование.Прицеп1) Тогда
		
		ДокументОбъект.Прицеп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Прицеп1, "Прицеп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект, Переменные);	
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование.Прицеп2) Тогда
		
		ДокументОбъект.Прицеп2 = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Прицеп2, "Прицеп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект, Переменные);	
		
	КонецЕсли;
		
	ПоследнийЗаказ = НайтиПоследнийЗаказ(ДокументОснование.Заказы);
	Если ЗначениеЗаполнено(ПоследнийЗаказ) Тогда 
		ДокументОбъект.Грузополучатель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ПоследнийЗаказ.Грузополучатель, "Грузополучатель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;
	
	ДокументОбъект.МестоПогрузки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресОтправления, "МестоПогрузки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.МестоДоставки = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресНазначения, "МестоДоставки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);	
	
КонецПроцедуры

Процедура ЗаполнитьГлавныйДокумент_ПЭ_Титул1_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументОбъект.НомДок = ДокументОснование.Номер;
	ДокументОбъект.ДатаДок = ДокументОснование.Дата;
	
	Если ЗначениеЗаполнено(ДокументОснование.ДоговорКонтрагента) Тогда
		ДокументОбъект.ДогТрЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.ДоговорКонтрагента, "ДогТрЭксп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;
	
