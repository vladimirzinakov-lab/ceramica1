	ДокументОбъект.ТСТип = "Грузовой";
	ДокументОбъект.Функция = Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.Заказ;

	Если ТипЗнч(ДокументОснование.АдресНазначения) = Тип("Строка") Тогда
		ДокументОбъект.КонПунктМрш = ДокументОснование.АдресНазначения;
	Иначе
		ДокументОбъект.КонПунктМрш = ДокументОснование.АдресНазначения.Адрес;
	КонецЕсли;
	
	ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "Грузоотправитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Контрагент, "Перевозчик",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.ПунктПод = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресОтправления, "МестоПогрузки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
		
	ВидТары = Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду("CT");
	
	// ТЧ Товары	
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровЗЗ(ДокументОбъект, ДокументОснование) Цикл
		
		Для Каждого ТекущаяСтрока Из ТекДокОснование.Заказы Цикл
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ВидТары = ВидТары;
			НоваяСтрока.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03;
			
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументОбъект.ТСГрузопод = ДокументОбъект.Товары.Итог("МассаПлановаяБруттоКг") / 1000;
	ДокументОбъект.ТСВместим = ДокументОбъект.Товары.Итог("ОбъемКубМ");
	
	Если ЗначениеЗаполнено(ДокументОснование.ТС) Тогда
		ДокументОбъект.ТСВместим = ДокументОснование.ТС.Модель.ОбъемКузова;
		ДокументОбъект.ТСГрузопод = ДокументОснование.ТС.Модель.Грузоподъемность; 
		ДокументОбъект.ТСТип = ДокументОснование.ТС.ТипТС;
	КонецЕсли;		
	
	// ТЧ АдрПункт
	НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
	НоваяСтрока.Погрузка = Истина;
	НоваяСтрока.ПунктМаршрута = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресОтправления, "МестоПогрузки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
	НоваяСтрока.Выгрузка = Истина;
	НоваяСтрока.ПунктМаршрута = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресНазначения, "МестоДоставки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ПЛ(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
	
	Если (ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02)
		И ТипДокумента1С = "уатПутевойЛист" Тогда
		
		ДокументОбъект.НомерПЛ = ДокументОснование.Номер;
		ДокументОбъект.ДатаПЛ = ДокументОснование.Дата;
		ДокументОбъект.ВидПеревозки = Перечисления.КонтурЛогистика_ВидыПеревозки.ЗначениеИзXDTO(
			ДокументОснование.ВидПеревозки.ВидПеревозкиДляЭПЛ);
		ДокументОбъект.СрокПЛ = ДокументОснование.Дата;
		ДокументОбъект.СрокПЛИнтервал = ДокументОснование.ДействителенДо;
		ДокументОбъект.ОбязМедосмотрПосле = ДокументОснование.ОбязательныйПослерейсовыйМедосмотр;
		
		Если ДокументОснование.ВидСообщения = Справочники.уатВидыСообщения.Городской Тогда
			ВидСообщения = Перечисления.КонтурЛогистика_ВидыПутейСообщений.Г;
		ИначеЕсли ДокументОснование.ВидСообщения = Справочники.уатВидыСообщения.Междугородний Тогда
			ВидСообщения = Перечисления.КонтурЛогистика_ВидыПутейСообщений.М;
		ИначеЕсли ДокументОснование.ВидСообщения = Справочники.уатВидыСообщения.Международный Тогда
			ВидСообщения = Перечисления.КонтурЛогистика_ВидыПутейСообщений.М;
		ИначеЕсли ДокументОснование.ВидСообщения = Справочники.уатВидыСообщения.ПассажирыИБагаж Тогда
			ВидСообщения = Перечисления.КонтурЛогистика_ВидыПутейСообщений.Г;
		ИначеЕсли ДокументОснование.ВидСообщения = Справочники.уатВидыСообщения.Пригородный Тогда
			ВидСообщения = Перечисления.КонтурЛогистика_ВидыПутейСообщений.П;
		Иначе
			ВидСообщения = Перечисления.КонтурЛогистика_ВидыПутейСообщений.ЗначениеИзXDTO(
				ДокументОснование.ВидСообщения.ВидCообщенияДляЭПЛ);
		КонецЕсли;
		ДокументОбъект.ВидСообщения = ВидСообщения;
		
		ДокументОбъект.ЛицоОформившееПЛ = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Организация, "ЛицоОформившееПЛ",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
		
		ДокументОбъект.ОрганизацияМедик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Медорганизация, "ОрганизацияМедик",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
		
		ДокументОбъект.Водитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Водитель1, "Водитель",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
			ДокументОснование, ДокументОбъект);
		
		ДокументОбъект.Водитель2 = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.Водитель2, "Водитель2",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
			ДокументОснование, ДокументОбъект);
		
		ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.ТранспортноеСредство, "ТранспортноеСредство",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
			ДокументОснование, ДокументОбъект);
		
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			
			ДокументОбъект.ОрганизацияТехСостояние = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.КонтрольТранспорта, "ОрганизацияТехСостояние",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
			
			ДокументОбъект.ОрганизацияОдометр = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.ПоказанияОдометра, "ОрганизацияОдометр",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
			
			ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.Контрагент, "Грузоотправитель",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
			
			ДокументОбъект.МестоОтправления = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.Гараж, "МестоОтправления",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
				ДокументОснование, ДокументОбъект);
			
		КонецЕсли;
		
		Если ДокументОснование.Прицепы.Количество() > 0 Тогда
			ДокументОбъект.Прицеп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.Прицепы[0].ТС, "Прицеп",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
			
		Если ДокументОснование.Прицепы.Количество() > 1 Тогда
			ДокументОбъект.Прицеп2 = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование.Прицепы[1].ТС, "Прицеп",
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
				ДокументОснование, ДокументОбъект);
		КонецЕсли;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
			Если ЗначениеЗаполнено(ДокументОбъект.Титул1.ДокументОснование) Тогда
				ДокументОснование = ДокументОбъект.Титул1.ДокументОснование;
			Иначе
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				МедРаботник = ДокументОснование.МедработникВыезд;
				ДокументОбъект.ДатВрПрМО = ДокументОснование.ДатаВыезда;
			Иначе
				МедРаботник = ДокументОснование.МедицинскийРаботник;
				ДокументОбъект.ДатВрПрМО = ДокументОснование.ДатаОсмотра;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(МедРаботник) Тогда
				ДокументОбъект.МедРаботник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					МедРаботник, "МедРаботник",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
					ДокументОснование, ДокументОбъект);
				ДокументОбъект.Должность = МедРаботник.Должность;
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ВладелецДокументов", МедРаботник);
				
				Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	уатРегистрационныеДокументы.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.уатРегистрационныеДокументы КАК уатРегистрационныеДокументы
				|ГДЕ
				|	уатРегистрационныеДокументы.ВладелецДокументов = &ВладелецДокументов
				|	И уатРегистрационныеДокументы.ВидДокумента = ЗНАЧЕНИЕ(Справочник.уатВидыДокументов.МедицинскаяЛицензия)
				|	И уатРегистрационныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.уатСтатусыДействия.Действует)
				|	И НЕ уатРегистрационныеДокументы.ПометкаУдаления
				|
				|УПОРЯДОЧИТЬ ПО
				|	уатРегистрационныеДокументы.ДатаВыдачи УБЫВ";
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					ДокументОбъект.МедЛицензия = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
						Выборка.Ссылка, "МедЛицензия",
						Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВЛицензию,
						ДокументОснование, ДокументОбъект);
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				ДокументОбъект.ДатВрКонтТехСост = ДокументОснование.ДатаВыезда;
				ДокументОбъект.ДатВрВыпНаЛин = ДокументОснование.ДатаВыезда;
				ТехРаботник = ДокументОснование.ВыпустилМеханик;
			Иначе
				ДокументОбъект.ДатВрКонтТехСост = ДокументОснование.ДатаОсмотра;
				ДокументОбъект.ДатВрВыпНаЛин = ДокументОснование.ПутевойЛист.ДатаВыезда;
				ТехРаботник = ДокументОснование.Контролер;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТехРаботник) Тогда
				ДокументОбъект.ТехРаботник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ТехРаботник, "ТехРаботник",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
					ДокументОснование, ДокументОбъект);
				ДокументОбъект.Должность = ТехРаботник.Должность;
			КонецЕсли;
			
			Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
				Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
					ДокументОбъект.ПоказанияОдометра = ДокументОснование.СпидометрВыезда;
				Иначе
					ДокументОбъект.ПоказанияОдометра = ДокументОснование.ПоказаниеОдометра;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				ДокументОбъект.ДатВрОдометр = ДокументОснование.ДатаВыезда;
				ДокументОбъект.ПоказанияОдометра = ДокументОснование.СпидометрВыезда;
				ОдометрРаботник = ДокументОснование.УполномоченныйНаПроставлениеОдометраПриВыезде;
			Иначе
				ДокументОбъект.ДатВрОдометр = ДокументОснование.ДатаОсмотра;
				ДокументОбъект.ПоказанияОдометра = ДокументОснование.ПоказаниеОдометра;
				ОдометрРаботник = ДокументОснование.Контролер;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОдометрРаботник) Тогда
				ДокументОбъект.ОдометрРаботник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ОдометрРаботник, "ОдометрРаботник",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
					ДокументОснование, ДокументОбъект);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				ДокументОбъект.ДтВрВозвр = ДокументОснование.ДатаВозвращения;
				ДокументОбъект.ПоказанияОдометра = ДокументОснование.СпидометрВозвращения;
			Иначе
				ДокументОбъект.ДтВрВозвр = ДокументОснование.ДатаОсмотра;
				ДокументОбъект.ПоказанияОдометра = ДокументОснование.ПоказаниеОдометра;
			КонецЕсли;
			
		ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				ДокументОбъект.ДатВрОдометр = ДокументОснование.ДатаВозвращения;
				ДокументОбъект.ПоказанияОдометра = ДокументОснование.СпидометрВозвращения;
				ОдометрРаботник = ДокументОснование.УполномоченныйНаПроставлениеОдометраПриВозврате;
			Иначе
				ДокументОбъект.ДатВрОдометр = ДокументОснование.ДатаОсмотра;
				ДокументОбъект.ПоказанияОдометра = ДокументОснование.ПоказаниеОдометра;
				ОдометрРаботник = ДокументОснование.Контролер;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОдометрРаботник) Тогда
				ДокументОбъект.ОдометрРаботник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ОдометрРаботник, "ОдометрРаботник",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
					ДокументОснование, ДокументОбъект);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
				МедРаботник = ДокументОснование.МедработникВозврат;
				ДокументОбъект.ДатВрПрМО = ДокументОснование.ДатаВозвращения;
			Иначе
				МедРаботник = ДокументОснование.МедицинскийРаботник;
				ДокументОбъект.ДатВрПрМО = ДокументОснование.ДатаОсмотра;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(МедРаботник) Тогда
				ДокументОбъект.МедРаботник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					МедРаботник, "МедРаботник",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
					ДокументОснование, ДокументОбъект);
				ДокументОбъект.Должность = МедРаботник.Должность;
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ВладелецДокументов", МедРаботник);
				
				Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	уатРегистрационныеДокументы.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.уатРегистрационныеДокументы КАК уатРегистрационныеДокументы
				|ГДЕ
				|	уатРегистрационныеДокументы.ВладелецДокументов = &ВладелецДокументов
				|	И уатРегистрационныеДокументы.ВидДокумента = ЗНАЧЕНИЕ(Справочник.уатВидыДокументов.МедицинскаяЛицензия)
				|	И уатРегистрационныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.уатСтатусыДействия.Действует)
				|	И НЕ уатРегистрационныеДокументы.ПометкаУдаления
				|
				|УПОРЯДОЧИТЬ ПО
				|	уатРегистрационныеДокументы.ДатаВыдачи УБЫВ";
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					ДокументОбъект.МедЛицензия = Выборка.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ПЭ_ЗаявкаНаМаршрут_уатЗаказГрузоотправителя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	МаршрутныйЛист = ПолучитьМаршрутныйЛист(ДокументОснование.Ссылка);
	
	Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
		Переменные.Вставить("МаршрутныйЛист", МаршрутныйЛист);
	КонецЕсли;
	
	ДокументОбъект.НомДок = ДокументОснование.Номер;
	ДокументОбъект.ДатаДок = ДокументОснование.Дата;
	
	Если ЗначениеЗаполнено(ДокументОснование.ДоговорКонтрагента) Тогда
		ДокументОбъект.ДогТрЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.ДоговорКонтрагента, "ДогТрЭксп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВДоговор,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;	
	
	ДокументОбъект.СвКлт = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "СвКлт",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	Если ЗначениеЗаполнено(МаршрутныйЛист) Тогда
			
		ДокументОбъект.СвЭксп = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			МаршрутныйЛист.Контрагент, "СвЭксп",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
			ДокументОснование, ДокументОбъект);
			
	КонецЕсли;
	
	Грузоотправитель = ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель), ДокументОснование.Грузоотправитель, ДокументОснование.Организация);
			
	ДокументОбъект.СвГО = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		Грузоотправитель, "СвГО",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	ДокументОбъект.СвГП = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Грузополучатель, "СвГП",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ВПунктМаршрута = Новый Структура("АдрГруз, АдрПунктНазн", "АдресОтправления", "АдресНазначения"); 
	Для Каждого Элемент Из ВПунктМаршрута Цикл
		ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование[Элемент.Значение], Элемент.Ключ,
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументОснование.ВалютаДокумента) Тогда
		Валюта = ДокументОснование.ВалютаДокумента;
	Иначе
		Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С("643", "руб");
	КонецЕсли; 
	ДокументОбъект.ВалютаУчетаГруза = Валюта;
	ДокументОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
	
	// ТЧ Товары
	
	// Несколько оснований еще не поддержано
	//Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Цикл
	ДокументыОснования = Новый Массив;
	ДокументыОснования.Добавить(ДокументОснование);	
	ДопДанныеДляПЭ = ПолучитьДопДанныеДляПЭ(ДокументыОснования);
	
	ТекДокОснование = ДокументОснование;
	
	Попытка
		ЕстьГрузовойСостав = ТекДокОснование.ГрузовойСостав.Количество() > 0;
	Исключение
		// Это УАТ Стандарт
		ЕстьГрузовойСостав = Ложь;
	КонецПопытки;
	
	Если ЕстьГрузовойСостав Тогда
		
		Для Каждого ТекущаяСтрока Из ТекДокОснование.ГрузовойСостав Цикл
			
			// При разделении ПЭ_ЗаявкаНаМаршрут — только строки текущего разделителя
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
			
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь, Истина, Истина, Истина);
			
			Если ЗначениеЗаполнено(НоваяСтрока.СтоимостьГруза)
				И Не ЗначениеЗаполнено(НоваяСтрока.ВалютаУчетаГруза) Тогда
				
				НоваяСтрока.ВалютаУчетаГруза = Валюта;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого ТекущаяСтрока Из ТекДокОснование.Товары Цикл
			
			// При разделении ПЭ_ЗаявкаНаМаршрут — только строки текущего разделителя
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
			
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь, Ложь, Истина, Истина);
			
			Если ЗначениеЗаполнено(НоваяСтрока.СтоимостьГруза)
				И Не ЗначениеЗаполнено(НоваяСтрока.ВалютаУчетаГруза) Тогда
				
				НоваяСтрока.ВалютаУчетаГруза = Валюта;
				
			КонецЕсли;
			
			СтрокаДопДанныеДляПЭ = ДопДанныеДляПЭ.Найти(ТекущаяСтрока.Номенклатура, "Номенклатура");
			Если СтрокаДопДанныеДляПЭ <> Неопределено Тогда
				КонтурЛогистика_КонвертацияСервер.ДобавитьСтрануПроисхожденияПродукции(ДокументОбъект, НоваяСтрока.ИдентификаторСтроки,
					СтрокаДопДанныеДляПЭ.СтранаПроисхождения);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Функция НайтиПоследнийЗаказ(Заказы)
	
	КоличествоЗаказов = Заказы.Количество();
	Если КоличествоЗаказов > 1 Тогда
		ПоследнийЗаказ = Заказы[КоличествоЗаказов-1].ЗаказГрузоотправителя;
	КонецЕсли;
	
	Возврат ПоследнийЗаказ;
	
КонецФункции

#Область Адаптация_МодульФормы_уатГрузовыеМеста_уэ

Функция РассчитатьВесОбъем(ТекСтрока, ГрузовойСостав, ЭтоЗаказ)
	
	МодульуатОбщегоНазначения = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("уатОбщегоНазначения");
	МодульуатОбщегоНазначенияТиповые = КонтурЛогистика_ОбщегоНазначенияСервер.ОбщийМодуль("уатОбщегоНазначенияТиповые");

	Если ГрузовойСостав Тогда
		Номенклатура = ТекСтрока.ГрузовоеМесто;
	Иначе
		Номенклатура = ТекСтрока.Номенклатура;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура)
		Или (Не ГрузовойСостав И Не ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения)) тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("МассаПлановаяБруттоКг,ВесТары,ОбъемКубМ,КоличествоМест,ОбъявленнаяЦенность,ОбъявленнаяЦенностьВалюта,Длина,Ширина,Высота");
	
	Если Не ЭтоЗаказ И ЗначениеЗаполнено(ТекСтрока.ЗаказГрузоотправителя) Тогда
		ВесОбъем = ПолучитьГрузовойСоставПоЗаказу(ТекСтрока.ЗаказГрузоотправителя, Номенклатура, ТекСтрока.ЕдиницаИзмерения, ТекСтрока.Количество, МодульуатОбщегоНазначения);
		ЗаполнитьВесОбъемПоЗаказу(Результат, ВесОбъем, ТекСтрока.Количество);
	ИначеЕсли ЭтоЗаказ Тогда
		ВесОбъем = ПолучитьГрузовойСоставПоСтрокеЗаказа(ТекСтрока, Номенклатура, ?(ГрузовойСостав, Неопределено, ТекСтрока.ЕдиницаИзмерения),
			?(ГрузовойСостав, ТекСтрока.КоличествоМест, ТекСтрока.Количество), МодульуатОбщегоНазначения);
		ЗаполнитьВесОбъемПоЗаказу(Результат, ВесОбъем, ?(ГрузовойСостав, ТекСтрока.КоличествоМест, ТекСтрока.Количество));
	Иначе
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Если МодульуатОбщегоНазначения <> Неопределено Тогда
				ВесОбъем = МодульуатОбщегоНазначения.ПолучитьВесОбъемНоменклатуры(Номенклатура, ТекСтрока.ЕдиницаИзмерения, ТекСтрока.Количество);
				ЗаполнитьЗначенияСвойств(Результат, ВесОбъем);
				Результат.ОбъемКубМ = ВесОбъем.Объем;
				Результат.МассаПлановаяБруттоКг = ВесОбъем.Вес;
			КонецЕсли;
		Иначе
			Если МодульуатОбщегоНазначенияТиповые <> Неопределено Тогда
				ВесОбъем = МодульуатОбщегоНазначенияТиповые.ПолучитьЗначенияРеквизитов(
					Номенклатура, "Длина, Ширина, Высота, ВесБрутто, ВесТары, Объем, КоличествоМест, Стоимость, Валюта");
				ЗаполнитьЗначенияСвойств(Результат, ВесОбъем,,"КоличествоМест");
				Результат.ОбъемКубМ = ТекСтрока.КоличествоМест * ВесОбъем.Объем;
				Результат.ВесТары = ТекСтрока.КоличествоМест * ВесОбъем.ВесТары;
				Результат.МассаПлановаяБруттоКг = ТекСтрока.КоличествоМест * ВесОбъем.ВесБрутто;
				Результат.ОбъявленнаяЦенность = ТекСтрока.КоличествоМест * ВесОбъем.Стоимость;
				Результат.ОбъявленнаяЦенностьВалюта = ВесОбъем.Валюта;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВесОбъем <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьВесОбъемПоЗаказу(Результат, ВесОбъем, Количество)
	
	ЗаполнитьЗначенияСвойств(Результат, ВесОбъем);
	Результат.ОбъемКубМ = ВесОбъем.Объем;	
	Результат.МассаПлановаяБруттоКг = ВесОбъем.ВесБрутто;
	Результат.ОбъявленнаяЦенность = ВесОбъем.Сумма;
	Результат.ОбъявленнаяЦенностьВалюта = ВесОбъем.Валюта;	
	
КонецПроцедуры

Функция ПолучитьГрузовойСоставПоЗаказу(ЗаказГрузоотправителя, Номенклатура, ЕдиницаИзмерения, Количество, МодульуатОбщегоНазначения)
	
	Результат = Новый Структура("ВесБрутто,Объем,КоличествоМест,Сумма,Длина,Ширина,Высота,Валюта");
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.уатГрузовыеМеста_уэ") Тогда
		СтрокиГруза = ЗаказГрузоотправителя.ГрузовойСостав.НайтиСтроки(Новый Структура("ГрузовоеМесто, ВидУпаковки",
			Номенклатура, ЕдиницаИзмерения));
		Если СтрокиГруза.Количество() Тогда
			ЗаполнитьЗначенияСвойств(Результат, СтрокиГруза[0]);
			
			Результат.ВесБрутто      = СтрокиГруза[0].ВесБрутто * (Количество / СтрокиГруза[0].КоличествоМест);
			Результат.Объем          = СтрокиГруза[0].Объем * (Количество / СтрокиГруза[0].КоличествоМест);
			
			Если ТипЗнч(СтрокиГруза[0].ВидУпаковки) = Тип("СправочникСсылка.уатВидыУпаковки_уэ") Тогда
				Результат.КоличествоМест = ?(СтрокиГруза[0].ВидУпаковки.Коэффициент = 0, 0, Количество / СтрокиГруза[0].ВидУпаковки.Коэффициент);
			Иначе
				Результат.КоличествоМест = 1;
			КонецЕсли;
			Результат.Сумма           = СтрокиГруза[0].Стоимость * (Количество / СтрокиГруза[0].КоличествоМест);
			
			Если Не ЗначениеЗаполнено(СтрокиГруза[0].Валюта) Тогда
				Результат.Валюта = СтрокиГруза[0].ГрузовоеМесто.Валюта;
			КонецЕсли;

		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		СтрокиТовара = ЗаказГрузоотправителя.Товары.НайтиСтроки(Новый Структура("Номенклатура, ЕдиницаИзмерения",
			Номенклатура, ЕдиницаИзмерения));
		Если СтрокиТовара.Количество() Тогда 
			ЗаполнитьЗначенияСвойств(Результат, СтрокиТовара[0]);
				
			Результат.ВесБрутто      = СтрокиТовара[0].ВесБрутто * (Количество / СтрокиТовара[0].Количество);
			Результат.Объем          = СтрокиТовара[0].Объем * (Количество / СтрокиТовара[0].Количество);
			Результат.КоличествоМест = СтрокиТовара[0].КоличествоМест * (Количество / СтрокиТовара[0].Количество);
			
			Если ЗначениеЗаполнено(СтрокиТовара[0].КоличествоМест) Тогда
				Результат.КоличествоМест = СтрокиТовара[0].КоличествоМест * (Количество / СтрокиТовара[0].Количество);
			Иначе
				Результат.КоличествоМест = СтрокиТовара[0].Количество;
			КонецЕсли;
			
			Если МодульуатОбщегоНазначения <> Неопределено Тогда
				ВесОбъем = МодульуатОбщегоНазначения.ПолучитьВесОбъемНоменклатуры(Номенклатура, ЕдиницаИзмерения, Количество);
				Если ВесОбъем.Свойство("Длина") Тогда
					Результат.Длина          = ВесОбъем.Длина;
					Результат.Ширина         = ВесОбъем.Ширина;
					Результат.Высота         = ВесОбъем.Высота;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьГрузовойСоставПоСтрокеЗаказа(СтрокаЗаказа, Номенклатура, ЕдиницаИзмерения, Количество, МодульуатОбщегоНазначения)
	
	Результат = Новый Структура("ВесБрутто,ВесТары,Объем,КоличествоМест,Сумма,Длина,Ширина,Высота,Валюта");
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.уатГрузовыеМеста_уэ") Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, СтрокаЗаказа);
		
		Результат.ВесБрутто      = СтрокаЗаказа.ВесБрутто * (Количество / СтрокаЗаказа.КоличествоМест);
		Результат.Объем          = СтрокаЗаказа.Объем * (Количество / СтрокаЗаказа.КоличествоМест);
		
		Если ТипЗнч(СтрокаЗаказа.ВидУпаковки) = Тип("СправочникСсылка.уатВидыУпаковки_уэ") Тогда
			Результат.КоличествоМест = ?(СтрокаЗаказа.ВидУпаковки.Коэффициент = 0, 0, Количество / СтрокаЗаказа.ВидУпаковки.Коэффициент);
		Иначе
			Результат.КоличествоМест = 1;
		КонецЕсли;
		Результат.Сумма           = СтрокаЗаказа.Стоимость * (Количество / СтрокаЗаказа.КоличествоМест);
		
		Если Не ЗначениеЗаполнено(СтрокаЗаказа.Валюта) Тогда
			Результат.Валюта = СтрокаЗаказа.ГрузовоеМесто.Валюта;
		КонецЕсли;
        	
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				
		ЗаполнитьЗначенияСвойств(Результат, СтрокаЗаказа);
			
		Результат.ВесБрутто      = СтрокаЗаказа.ВесБрутто * (Количество / СтрокаЗаказа.Количество);
		Результат.Объем          = СтрокаЗаказа.Объем * (Количество / СтрокаЗаказа.Количество);
		
		Если ЗначениеЗаполнено(СтрокаЗаказа.КоличествоМест) Тогда
			Результат.КоличествоМест = СтрокаЗаказа.КоличествоМест * (Количество / СтрокаЗаказа.Количество);
		Иначе
			Результат.КоличествоМест = СтрокаЗаказа.Количество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		
			Если МодульуатОбщегоНазначения <> Неопределено Тогда
				ВесОбъем = МодульуатОбщегоНазначения.ПолучитьВесОбъемНоменклатуры(Номенклатура, ЕдиницаИзмерения, Количество);
				Если ВесОбъем.Свойство("Длина") Тогда
					Результат.Длина          = ВесОбъем.Длина;
					Результат.Ширина         = ВесОбъем.Ширина;
					Результат.Высота         = ВесОбъем.Высота;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

