Функция ОписаниеЗамечанийПеревозчика(ШапкаИлиОбъект, ЭтоВыгрузка = Ложь, ИсключитьОписаниеДат = Ложь, Разделитель = ", ") Экспорт 

	ОписанияПоказателей = Новый Массив;
	
	ФорматДаты = "ДФ='dd.MM.yyyy HH:mm'";
	
	Если Не ИсключитьОписаниеДат Тогда 
		
		Если ЭтоВыгрузка Тогда
			ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(Формат(ШапкаИлиОбъект.ЗамДатВрПосВыгр, ФорматДаты), "дата и время пост. на выгрузку - "));
		Иначе
			ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(Формат(ШапкаИлиОбъект.ЗамДатВрПосПрием, ФорматДаты), "дата и время пост. на погрузку - "));
		КонецЕсли;	
		
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(Формат(ШапкаИлиОбъект.ЗамДатВрПриб, ФорматДаты), "дата и время прибытия - "));	
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(Формат(ШапкаИлиОбъект.ЗамДатВрУбыт, ФорматДаты), "дата и время убытия - "));
		
	КонецЕсли;
	
	Если ЭтоВыгрузка Тогда
		
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамРабВыгр, "разгрузочные работы - "));
		
	Иначе
		
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамМасс, "масса груза - "));
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамКолМест, "количество мест - "));  
		ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамПогрРаб, "погрузочные работы - "));
		
	КонецЕсли;	
	
	ДобавитьОписаниеВМассив(ОписанияПоказателей, ОписаниеПоказателя(ШапкаИлиОбъект.ЗамСостГруз, "состояние груза - "));
	
	Возврат ОписаниеПоказателейИзМассива(ОписанияПоказателей,,, Разделитель);
	
КонецФункции

