
Функция ПолучитьТабличныйДокументЭПД(МассивОбъектов, ВариантПечати = Неопределено) Экспорт
	
	Возврат СформироватьТабличныйДокумент(МассивОбъектов);
	
КонецФункции

Функция СформироватьТабличныйДокумент(МассивОбъектов)
	
	ФормируемыйТабличныйДокумент = Новый ТабличныйДокумент;
	ФормируемыйТабличныйДокумент.АвтоМасштаб = Истина;
	ФормируемыйТабличныйДокумент.ОтображатьСетку = Ложь;
	ФормируемыйТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ФормируемыйТабличныйДокумент.КлючПараметровПечати = "v8_Логистика_ПечатьТрН";
	
	МассивОбъектовЭТРН = МассивОбъектовЭТрНПоЛюбымДокументам(МассивОбъектов);
	
	Если МассивОбъектовЭТРН.Количество() > 0 Тогда
		ДанныеДляПечатиЭТРН = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПолучитьДанныеДляПечатиТрН(МассивОбъектовЭТРН);
		ЗаполнитьТабличныйДокументЭТРН(ФормируемыйТабличныйДокумент, ДанныеДляПечатиЭТРН);
	КонецЕсли;
	
	МассивОбъектовЭЗЗ = МассивОбъектовЭЗЗПоЛюбымДокументам(МассивОбъектов);
	
	Если МассивОбъектовЭЗЗ.Количество() > 0 Тогда
		ДанныеДляПечатиЭЗЗ = Документы.КонтурЛогистика_ЗЗ_Титул1.ПолучитьДанныеДляПечатиЭЗЗ(МассивОбъектовЭЗЗ);
		ЗаполнитьТабличныйДокументЭЗЗ(ФормируемыйТабличныйДокумент, ДанныеДляПечатиЭЗЗ);	
	КонецЕсли;
	
	Возврат ФормируемыйТабличныйДокумент;
	
КонецФункции

Процедура ЗаполнитьТабличныйДокументЭТРН(ФормируемыйТабличныйДокумент, ДанныеДляПечати)
	
	Макет = ПолучитьОбщийМакет("КонтурЛогистика_ТранспортнаяНакладная_2200");
	
	Шапка 						= ДанныеДляПечати.Шапка;
	Товары 						= ДанныеДляПечати.Товары;
	Маркировки 					= ДанныеДляПечати.Маркировки;
	Отметки 					= ДанныеДляПечати.Отметки;
	Заказчики 					= ДанныеДляПечати.Заказчики;
	ДопВодители 				= ДанныеДляПечати.ДопВодители;
	СопроводительныеДокументы	= ДанныеДляПечати.СопроводительныеДокументы;
	ДанныеПодписания			= ДанныеДляПечати.ДанныеПодписания;
	ДанныеСотрудников			= ДанныеДляПечати.ДанныеСотрудников;
	ДанныеДоговоров				= ДанныеДляПечати.ДанныеДоговоров;
	ВыборкаОрганизации			= ДанныеДляПечати.ВыборкаОрганизации;
	
	НесколькоДокументовНаПечать = Ложь;
	
	МассивЭТрН = Новый Массив;
	
	Пока Шапка.Следующий() Цикл 
		
		Если Не МассивЭТрН.Найти(Шапка.ДокументЭТРН) = Неопределено Тогда 
			Продолжить;
		Иначе
			МассивЭТрН.Добавить(Шапка.ДокументЭТРН);
		КонецЕсли;	
		
		Если НесколькоДокументовНаПечать Тогда 
			
			ФормируемыйТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;	
		
		НесколькоДокументовНаПечать = Истина;
		
		ОбластьМакета = Макет.ПолучитьОбласть("ГоризонтальнаяЛицеваяСторона");
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Шапка); 
		
		Если Шапка.ГОЭксп = "0" Тогда 
			
			ОбластьМакета.Рисунки.Удалить(ОбластьМакета.Рисунки.КартинкаЭкспедиция)
			
		КонецЕсли;	
		
		// 1. Грузоотправитель
		
		ОбластьМакета.Параметры.СвГО = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Грузоотправитель);
				
		// 1а Заказчик услуг по организации перевозки груза (при наличии)   
		
		ОбластьМакета.Параметры.ЗакУсл 		= ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.ЭкспедицияЗаказчик);
		ОбластьМакета.Параметры.ЗакДоговор 	= ОписаниеДоговора(ДанныеДоговоров, Шапка.ЭкспедицияДоговор);
				
		// 2. Грузополучатель
		
		ОбластьМакета.Параметры.СвГП = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Грузополучатель);
		ОбластьМакета.Параметры.АдресДостГр = Шапка.АдресДостГр;
		Если ЗначениеЗаполнено(Шапка.АдресДостГрСтрана) Тогда
			ОбластьМакета.Параметры.АдресДостГр = ОбластьМакета.Параметры.АдресДостГр + ", " + Строка(Шапка.АдресДостГрСтрана);
		КонецЕсли;
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// 3. Груз 
		
		ТоварыВЭТрН = Товары.Скопировать(Новый Структура("ДокументЭТрН", Шапка.ДокументЭТрН));
				
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТовары"); 
		
		ОбластьМакета.Параметры.Валюта = ПолучитьВалютуЭТрН(ТоварыВЭТрН);
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		Итоги = Новый Структура("КолМестГр,МасНетЗнач,МасБрутЗнач,Объем,ЦеннГруз", 0, 0, 0, 0, 0);
		
		Для Каждого Товар Из ТоварыВЭТрН Цикл 
			
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТовары");  
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Товар);  
			
			ОбластьМакета.Параметры.Марк = ОписаниеМаркировокТовара(Маркировки, Шапка.ДокументЭТрН, Товар.ИдентификаторСтроки);
			
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);	
			
			Для Каждого Показатель Из Итоги Цикл 
				Итоги.Вставить(Показатель.Ключ, Показатель.Значение + Товар[Показатель.Ключ]);
			КонецЦикла;	
			
		КонецЦикла;	
		
		ОбластьМакета = Макет.ПолучитьОбласть("ИтогиТовары");
		
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Итоги);
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// 4. Сопроводительные документы на груз (при наличии)
		
		ОбластьМакета = Макет.ПолучитьОбласть("ГоризонтальнаяЛицеваяСторонаПродолжение");
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Шапка);
		
		Пункт4_1 = Новый Массив;
		Пункт4_2 = Новый Массив;
		ПредставлениеОснования = Новый Массив;
		
		Для каждого Док Из СопроводительныеДокументы Цикл
			
			Если Док.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКЗН
				Или Док.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКТрН Тогда
				Пункт4_1.Добавить(ОписаниеСопроводительногоДокумента(Док));
			КонецЕсли;
				
			Если Док.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокКГр Тогда
				Пункт4_2.Добавить(ОписаниеСопроводительногоДокумента(Док));
			КонецЕсли;
			
			Если Док.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокПерЦенн
				Или Док.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.СопрВед Тогда
				ПредставлениеОснования.Добавить(ОписаниеСопроводительногоДокумента(Док));
			КонецЕсли;
			
		КонецЦикла;
		
		ОбластьМакета.Параметры.Пункт4_1 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Пункт4_1, ", ");
		ОбластьМакета.Параметры.Пункт4_2 = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(Пункт4_2, ", ");
		ОбластьМакета.Параметры.ПредставлениеОснования = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СоединитьСтроку(ПредставлениеОснования, ", ");
		
		//ОбластьМакета.Параметры.ПредставлениеОснования = ОписаниеПредставленияДокументаОснования(Шапка.ДокументОснование);
		
		// 5. Указания грузоотправителя по особым условиям перевозки
				
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ОписаниеУказанийГрузоотправителя(Шапка));
		
		// 6. Перевозчик
		
		ОбластьМакета.Параметры.СвПер = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Перевозчик);
		СвВодит = ОписаниеСотрудника(ДанныеСотрудников, Шапка.Водитель, "ФИО, ИНН, ТелефонОсновной, ТелефонЗапасной, ВУВодителя");
		Если ЗначениеЗаполнено(Шапка.ПутевойЛистНомер) Или ЗначениеЗаполнено(Шапка.ПутевойЛистДата) Тогда
			Если ЗначениеЗаполнено(Шапка.ПутевойЛистНомер) Тогда
				НомерПЛ = Строка(Шапка.ПутевойЛистНомер);
			Иначе
				НомерПЛ = "Без номера";
			КонецЕсли;
			
			СвВодит = СвВодит + ", Путевой лист " + НомерПЛ;
			
			Если ЗначениеЗаполнено(Шапка.ПутевойЛистДата) Тогда
				СвВодит = СвВодит + " от " + Формат(Шапка.ПутевойЛистДата, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		КонецЕсли;
		ОбластьМакета.Параметры.СвВодит = СвВодит;
		
		Для Каждого ДопВодитель Из ДопВодители Цикл
			ОбластьМакета.Параметры.СвВодит = ОбластьМакета.Параметры.СвВодит + Символы.ПС
				+ ОписаниеСотрудника(ДанныеСотрудников, ДопВодитель.Водитель, "ФИО, ИНН, ТелефонОсновной, ТелефонЗапасной, ВУВодителя");
		КонецЦикла;
		
		// 7. Транспортное средство
		ОбластьМакета.Параметры.ТипВлад     = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.ЗначениеДляXDTO(Шапка.ТипВлад);
		ОбластьМакета.Параметры.ПарТС 		= ОписаниеПараметровТС(Шапка);
		
		Если ЗначениеЗаполнено(Шапка.Прицеп) Тогда 
			ОбластьМакета.Параметры.ПарТС = ОбластьМакета.Параметры.ПарТС + "; " + ОписаниеПараметровТС(Шапка.Прицеп, "Прицеп");
			ОбластьМакета.Параметры.РегНомер = "регистрационный номер: " + Шапка.РегНомер + "; " + "регистрационный номер прицепа: " + Шапка.Прицеп.РегНомер;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Шапка.Прицеп2) Тогда 
			ОбластьМакета.Параметры.ПарТС = ОбластьМакета.Параметры.ПарТС + "; " + ОписаниеПараметровТС(Шапка.Прицеп2, "Прицеп");
			ОбластьМакета.Параметры.РегНомер = ОбластьМакета.Параметры.РегНомер + "; " + "регистрационный номер второго прицепа: " + Шапка.Прицеп2.РегНомер;
		КонецЕсли;
		
		Если Не Шапка.ТипВлад = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1 
			И Не Шапка.ТипВлад = Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.СовместнаяСобственностьСупругов_2 Тогда 
			
			ОбластьМакета.Параметры.ОснАрЛиз 	= ОписаниеДоговора(ДанныеДоговоров, Шапка.ДоговорАрендаЛизинг);
			
		КонецЕсли;
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ГоризонтальнаяОборотнаяСторона");  
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Шапка); 
		
		// 8. Прием груза
		
		ФормируемыйТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ОписаниеДоговораПогрузки = "";
		
		Если (ЗначениеЗаполнено(Шапка.СвЛицПогрГр) 
			ИЛИ ЗначениеЗаполнено(Шапка.ДогЛицПогрГр))
			И Шапка.СвЛицПогрГр <> Шапка.Грузоотправитель Тогда 
			
			ОписаниеДоговораПогрузки = ОписаниеДоговора(ДанныеДоговоров, Шапка.ДогЛицПогрГр);
			
		КонецЕсли;
		
		ОбластьМакета.Параметры.ФАдресПогр = Шапка.ФАдресПогр;
		Если ЗначениеЗаполнено(Шапка.ФАдресПогрСтрана) Тогда
			ОбластьМакета.Параметры.ФАдресПогр = ОбластьМакета.Параметры.ФАдресПогр + ", " + Строка(Шапка.ФАдресПогрСтрана);
		КонецЕсли;
		
		ОбластьМакета.Параметры.ФДатВрПриб 	= КонтурЛогистика_КонструкторыXDTO.XDTO_ДатаВремяВЗТип(Шапка.ФДатВрПриб);
		ОбластьМакета.Параметры.ЗаявПогр 	= КонтурЛогистика_КонструкторыXDTO.XDTO_ДатаВремяВЗТип(Шапка.ЗаявПогр);
		ОбластьМакета.Параметры.ФДатВрУбыт 	= КонтурЛогистика_КонструкторыXDTO.XDTO_ДатаВремяВЗТип(Шапка.ФДатВрУбыт);
		
		СвЛицПогрГр = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.СвЛицПогрГр);
		Если Шапка.СвЛицПогрГр = Шапка.Грузоотправитель Тогда
			ОбластьМакета.Параметры.СвЛицПогрГр = "Совпадает с грузоотправителем, " + Строка(СвЛицПогрГр);
		ИначеЕсли Не ЗначениеЗаполнено(СвЛицПогрГр) Тогда
			ОбластьМакета.Параметры.СвЛицПогрГр = "Совпадает с грузоотправителем";
		Иначе
			ОбластьМакета.Параметры.СвЛицПогрГр = СвЛицПогрГр;
		КонецЕсли;
		
		ОписаниеРабЛицПогрГр = ОписаниеСотрудника(ДанныеСотрудников, Шапка.РабЛицПогрГр, "Должность,ФамилияИО,ОДолжОб")
			+ ?(ЗначениеЗаполнено(ОписаниеДоговораПогрузки), "; " + ОписаниеДоговораПогрузки, "");
		
		ОбластьМакета.Параметры.ВладИнфрНаименованиеИлиИНН 	= ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.ВладИнфр, "ПолноеНаименование,ИНН");
		ОбластьМакета.Параметры.МасБрутОтгр_МетОпрМасс 		= ОписаниеМассыБруттоИМетодаОпределенияМассы(Шапка);
		ОбластьМакета.Параметры.КолМестПрием				= ОписаниеКоличестваМест(Шапка.КолМестПрием);
		ОбластьМакета.Параметры.ЗамПрвПрием 				= ОписаниеЗамечанийПеревозчикаТитул2(Шапка);
		ОбластьМакета.Параметры.РабЛицПогрГр 				= ОписаниеРабЛицПогрГр;
		ОбластьМакета.Параметры.ВодитФамилияИО 				= "водитель " + ОписаниеСотрудника(ДанныеСотрудников, Шапка.Водитель, "ФамилияИО");
			
		// 9. Переадресовка (при наличии)
		
		// Титул 7
		
		// 10. Выдача груза
		
		Если ЗначениеЗаполнено(Шапка.Титул4) Тогда 
			ОбластьМакета.Параметры.ЗамПрвВыгрТ4 = ОписаниеЗамечанийПеревозчикаТитул4(Шапка.Титул4);
		КонецЕсли;
	
		ОбластьМакета.Параметры.ВодитФамилияИОТ4 	= "водитель " + ОписаниеСотрудника(ДанныеСотрудников, Шапка.Водитель, "ФамилияИО");
		
		ОбластьМакета.Параметры.АдрВыгрузТ3 = Шапка.АдрВыгрузТ3;
		Если ЗначениеЗаполнено(Шапка.АдрВыгрузТ3Страна) Тогда
			ОбластьМакета.Параметры.АдрВыгрузТ3 = ОбластьМакета.Параметры.АдрВыгрузТ3 + ", " + Строка(Шапка.АдрВыгрузТ3Страна);
		КонецЕсли;
		
		// Титул 3 и 4
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// 11. Отметки грузоотправителей, грузополучателей, перевозчиков (при необходимости)
		
		// Все титулы
		
		НайденныеОтметки = Отметки.НайтиСтроки(Новый Структура("ДокументЭТрН", Шапка.ДокументЭТрН));
		
		Если НайденныеОтметки.Количество() Тогда 
		
			Для Каждого Отметка Из НайденныеОтметки Цикл 
				
				ОбластьМакета = Макет.ПолучитьОбласть("Отметки");
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Отметка);
				
				ОбластьМакета.Параметры.ИтогРазмШтрРФ_РасчШтр = ОписаниеИтоговогоРазмераШтрафа(Отметка);
				
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
						
			КонецЦикла;
		
		Иначе
			
			ОбластьМакета = Макет.ПолучитьОбласть("Отметки");
				
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);

		КонецЕсли;
		
		// 12. Стоимость перевозки груза (установленная плата) в рублях (при необходимости)
		
		ОбластьМакета = Макет.ПолучитьОбласть("ГоризонтальнаяОборотнаяСторонаПродолжение");
		
		// Титул 5 и 6
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// Электронные подписи
		ВывестиДанныеЭлектронныхПодписей(ДанныеПодписания, Макет, Шапка, ФормируемыйТабличныйДокумент);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныйДокументЭЗЗ(ФормируемыйТабличныйДокумент, ДанныеДляПечати)
	// https://normativ.kontur.ru/document?moduleId=1&documentId=441814#h345	
	
	Макет = ПолучитьОбщийМакет("КонтурЛогистика_ЗаказЗаявка");
	
	Шапка				= ДанныеДляПечати.Шапка;
	СвЛицГО				= ДанныеДляПечати.СвЛицГО;
	АдрПункт			= ДанныеДляПечати.АдрПункт;
	ПромПункт			= ДанныеДляПечати.ПромПункт;
	Товары				= ДанныеДляПечати.Товары;
	ОпасныеГрузы		= ДанныеДляПечати.ОпасныеГрузы;
	ИнфПолТ1			= ДанныеДляПечати.ИнфПолТ1;
	Водители			= ДанныеДляПечати.Водители;
	Прицепы				= ДанныеДляПечати.Прицепы;
	СпецРазрешения		= ДанныеДляПечати.СпецРазрешения;
	ИнфПолТ2			= ДанныеДляПечати.ИнфПолТ2;
	ДанныеПодписания	= ДанныеДляПечати.ДанныеПодписания;
	ВыборкаОрганизации	= ДанныеДляПечати.ВыборкаОрганизации;
	ДанныеСотрудников	= ДанныеДляПечати.ДанныеСотрудников;
	ДанныеТС			= ДанныеДляПечати.ДанныеТС;
	ДанныеДоговоров		= ДанныеДляПечати.ДанныеДоговоров;
	ДанныеПунктов		= ДанныеДляПечати.ДанныеПунктов;
	ДокументыОснования 	= ДанныеДляПечати.ДокументыОснования;
	
	НесколькоДокументовНаПечать = Ложь;
	
	МассивЭЗЗ = Новый Массив;
	
	Пока Шапка.Следующий() Цикл 
		
		Если Не МассивЭЗЗ.Найти(Шапка.Титул1) = Неопределено Тогда 
			Продолжить;
		Иначе
			МассивЭЗЗ.Добавить(Шапка.Титул1);
		КонецЕсли;	
		
		Если НесколькоДокументовНаПечать Тогда 
			ФормируемыйТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		НесколькоДокументовНаПечать = Истина;
		
		// Шапка
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		Если Шапка.Титул1Функция = Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.Заказ Тогда
			ОбластьМакета.Параметры.Функция = "Заказ";
		Иначе
			ОбластьМакета.Параметры.Функция = "Заявка";
		КонецЕсли;
		
		ОбластьМакета.Параметры.НомЗак = Шапка.Титул1НомЗак;
		ОбластьМакета.Параметры.ДатаЗак = Формат(Шапка.Титул1ДатаЗак, "ДФ=dd.MM.yyyy;");
		
		ОбластьМакета.Параметры.Грузоотправитель = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Титул1Грузоотправитель);
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// Договор организации перевозки груза
		Если Шапка.Титул1Функция = Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.Заявка Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ДогОргПрвз");
			ОбластьМакета.Параметры.ДогОргПрвз = ОписаниеДоговораЭЗЗ(ДанныеДоговоров, Шапка.Титул1ДогОргПрвз);
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли; 
		
		// Составитель Т1
		Если ЗначениеЗаполнено(Шапка.Титул1Составитель) И Шапка.Титул1Составитель <> Шапка.Титул1Грузоотправитель Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("СоставительТ1");
			ОбластьМакета.Параметры.СоставительТ1 = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Титул1Составитель);
			ОбластьМакета.Параметры.ОснДовОргСостТ1 = ОписаниеДоговораЭЗЗ(ДанныеДоговоров, Шапка.Титул1ОснДовОргСост);
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		// Уполномоченные лица ГО
		СвЛицГОЭЗЗ = СвЛицГО.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
		
		Для Каждого ЛицоГО Из СвЛицГОЭЗЗ Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("СвЛицГО");
			
			Если ЛицоГО.Полномочие = Перечисления.КонтурЛогистика_ПолномочияДействий.Заказ Тогда
				ОбластьМакета.Параметры.Полномочие = "Заполнение и подписание заказа (заявки)";
			ИначеЕсли ЛицоГО.Полномочие = Перечисления.КонтурЛогистика_ПолномочияДействий.Погрузка Тогда
				ОбластьМакета.Параметры.Полномочие = 
					"Погрузка груза в транспортное средство, заполнение и подписание транспортной накладной";
			Иначе
				ОбластьМакета.Параметры.Полномочие = "Осуществление платежей по договору перевозки";
			КонецЕсли;
			
			Если ТипЗнч(ЛицоГО.Участник) = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок") Тогда
				ОбластьМакета.Параметры.СвЛицГО = ОписаниеОрганизации_(ВыборкаОрганизации, ЛицоГО.Участник);
			Иначе
				ОбластьМакета.Параметры.СвЛицГО = ОписаниеСотрудника(ДанныеСотрудников, ЛицоГО.Участник, "ФИО")
			КонецЕсли;
			
			ПредставлениеДокумента = "";
			
			Если Найти(ЛицоГО.ДокументНаименование, ЛицоГО.ДокументНомер) > 0 Тогда
				ПредставлениеДокумента = ЛицоГО.ДокументНаименование;
			Иначе
				ПредставлениеДокумента = ЛицоГО.ДокументНаименование + " от " + 
					Формат(ЛицоГО.ДокументДата, "ДФ=dd.MM.yyyy;") + " № " + ЛицоГО.ДокументНомер;
			КонецЕсли;
			
			ОбластьМакета.Параметры.ДокументСвЛицГО = ПредставлениеДокумента;
			
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
		
		// Обязательные данные ГО
		ОбластьМакета = Макет.ПолучитьОбласть("ОбязательныеДанныеГО");
		
		ОбластьМакета.Параметры.Перевозчик = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Титул1Перевозчик);
		
		ОбластьМакета.Параметры.ПунктПод = ОписаниеПунктаМаршрута(ДанныеПунктов, Шапка.Титул1ПунктПод);
		
		ДатаВремяПодачи = Формат(Шапка.Титул1ДатВрПод, "ДФ='dd.MM.yyyy HH:mm';");
		
		Если ЗначениеЗаполнено(Шапка.Титул1ПредВрПод) Тогда
			ДатаВремяПодачи = ДатаВремяПодачи + " (не позднее " + Формат(Шапка.Титул1ПредВрПод, "ДФ='HH:mm'") + ")";
		КонецЕсли;
		 
		ОбластьМакета.Параметры.ДатВрПод = ДатаВремяПодачи;
		
		// // Параметры ТС
		ПараметрыТСОбяз = Шапка.Титул1ТСТип + " (грузоподъемность " + Шапка.Титул1ТСГрузопод + "т, вместимость " +
			Шапка.Титул1ТСВместим + " куб.м)";
		
		ПараметрыТСНеоб = "";
		Если ЗначениеЗаполнено(Шапка.Титул1ТСТипПогр) Тогда
			ПараметрыТСНеоб = "Тип погрузки: " + Шапка.Титул1ТСТипПогр;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Шапка.Титул1ТСТипПогр) Тогда
			Если ПараметрыТСНеоб = "" Тогда
				ПараметрыТСНеоб = "Тип кузова: " + Шапка.Титул1ТСТипКуз;
			Иначе
				ПараметрыТСНеоб = ПараметрыТСНеоб + "; тип кузова: " + Шапка.Титул1ТСТипКуз;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Шапка.Титул1ТСДрПарам) Тогда
			ПараметрыТСНеоб = ПараметрыТСНеоб + ?(ПараметрыТСНеоб = "", "", "; ") + Шапка.Титул1ТСДрПарам;
		КонецЕсли;
			
		Если ПараметрыТСНеоб = "" Тогда
			ПараметрыТС = ПараметрыТСОбяз;
		Иначе
			ПараметрыТС = ПараметрыТСОбяз + Символы.ПС + ПараметрыТСНеоб;
		КонецЕсли;
		
		ОбластьМакета.Параметры.ПараметрыТС = ПараметрыТС;
		
		// // Указания
		Если ЗначениеЗаполнено(Шапка.Титул1УказанияВОтношенииНормПеревозки) Тогда
			ОбластьМакета.Параметры.Указания = Шапка.Титул1УказанияВОтношенииНормПеревозки;
		Иначе
			ОбластьМакета.Параметры.Указания = "Отсутствуют";
		КонецЕсли;
		
		ОписаниеТемпературы = "";
		Если Шапка.Титул1ТемператураНеНиже <> Шапка.Титул1ТемператураНеВыше Тогда
			ОписаниеТемпературы = "Температура, °С - от " + 
				Формат(Шапка.Титул1ТемператураНеНиже, "ЧН=0;") +
				" до " + Формат(Шапка.Титул1ТемператураНеВыше, "ЧН=0;");	
		КонецЕсли;	
		
		ОписаниеВлажности = "";
		Если Шапка.Титул1ВлажностьНеНиже <> Шапка.Титул1ВлажностьНеВыше Тогда
			ОписаниеВлажности = "Влажность, %  - от " + Шапка.Титул1ВлажностьНеНиже +
				" до " + Шапка.Титул1ВлажностьНеВыше;
		КонецЕсли;
		
		ТребованияТемпВлажПищ = ОписаниеТемпературы;
		ТребованияТемпВлажПищ = ТребованияТемпВлажПищ + ?(ТребованияТемпВлажПищ = "", "", Символы.ПС) + 
			ОписаниеВлажности;
		ТребованияТемпВлажПищ = ТребованияТемпВлажПищ + ?(ТребованияТемпВлажПищ = "", "", Символы.ПС) + 
			Шапка.Титул1ПрвзПищПрод;
				
		ОбластьМакета.Параметры.ТребованияТемпВлажПрвзПищПрод = ТребованияТемпВлажПищ;
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);	
		
		// Предельные сроки перевозки
		Если ЗначениеЗаполнено(Шапка.Титул1ПредСрПрвз) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ПредСрПрвз");
			ОбластьМакета.Параметры.ПредСрПрвз = Шапка.Титул1ПредСрПрвз;
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		// Иные условия
		Если ЗначениеЗаполнено(Шапка.Титул1ИныеУслв) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ИныеУслв");
			ОбластьМакета.Параметры.ИныеУслв = Шапка.Титул1ИныеУслв;
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
		
		// Маршрут
		ОбластьМакета = Макет.ПолучитьОбласть("МаршрутШапка");
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// // Пункты погрузки и выгрузки
		АдрПунктЭЗЗ = АдрПункт.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
		Для Каждого Пункт Из АдрПунктЭЗЗ Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("АдрПунктСтрока");
			Если Пункт.Погрузка Тогда
				ОбластьМакета.Параметры.ПогрузкиИлиВыгрузки = "погрузки";
				ОбластьМакета.Параметры.ПунктМаршрута = ОписаниеПунктаМаршрута(ДанныеПунктов, Пункт.ПунктМаршрута, Пункт);
			Иначе
				ОбластьМакета.Параметры.ПогрузкиИлиВыгрузки = "выгрузки";
				ОбластьМакета.Параметры.ПунктМаршрута = ОписаниеПунктаМаршрута(ДанныеПунктов, Пункт.ПунктМаршрута, Пункт);
			КонецЕсли;
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
		
		// // Промежуточные пункты
		ПромПунктЭЗЗ = ПромПункт.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
		Для Каждого Пункт Из ПромПунктЭЗЗ Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("ПромПунктМршСтрока");
			ОбластьМакета.Параметры.ПромПунктМрш = Пункт.ПромПунктМрш;
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
		
		// // Конечный пункт
		Если ЗначениеЗаполнено(Шапка.Титул1КонПунктМрш) Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("КонПунктМрш");
			ОбластьМакета.Параметры.КонПунктМрш = Шапка.Титул1КонПунктМрш;
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;

		// Груз
		ОбластьМакета = Макет.ПолучитьОбласть("ГрузШапка");
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
		// // Описания грузов
		ТоварыЭЗЗ = Товары.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
		ОпасныеГрузыЭЗЗ = ОпасныеГрузы.Скопировать(Новый Структура("Титул1", Шапка.Титул1));

		Для Каждого Груз Из ТоварыЭЗЗ Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("ГрузСтрока");
			ОбластьМакета.Параметры.ОтгрузочноеНаименование = Груз.ОтгрузочноеНаименование;
			ОбластьМакета.Параметры.ОпГруз = ОписаниеГрузаЭЗЗ(Груз, ОпасныеГрузыЭЗЗ);
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЦикла;

		// Инфополя
		ИнфПолТ1ЭЗЗ = ИнфПолТ1.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
		
		Если ИнфПолТ1ЭЗЗ.Количество() > 0 Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ИнфПолТ1Шапка");
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
				
			Для Каждого Инфополе Из ИнфПолТ1ЭЗЗ Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("ИнфПолТ1Строка");
				ОбластьМакета.Параметры.Идентиф = Инфополе.Идентиф;
				ОбластьМакета.Параметры.Значение = Инфополе.Значение;
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Шапка.Титул2) Тогда // ответа перевозчика может и не быть ¯\_(ツ)_/¯
			ОбластьМакета = Макет.ПолучитьОбласть("ИнформацияПеревозчикаШапка");
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
			
			// Составитель Т2
			Если ЗначениеЗаполнено(Шапка.Титул2Составитель) И Шапка.Титул2Составитель <> Шапка.Титул1Перевозчик Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("СоставительТ2");
				ОбластьМакета.Параметры.СоставительТ2 = ОписаниеОрганизации_(ВыборкаОрганизации, Шапка.Титул2Составитель);
				ОбластьМакета.Параметры.ОснДовОргСостТ2 = ОписаниеДоговораЭЗЗ(ДанныеДоговоров, Шапка.Титул2ОснДовОргСост);
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;
			
			Если Шапка.Титул2ЕстьОтказВПодписи Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ОтказВПодписи");
				ОбластьМакета.Параметры.ПричинаОтказаВПодписи = Шапка.Титул2ПричинаОтказаВПодписи;
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
			Иначе
				// Обязательные данные перевозчика
				ОбластьМакета = Макет.ПолучитьОбласть("ОбязательныеДанныеПРВ");
				ОбластьМакета.Параметры.СвЛицОргПрвз = ОписаниеСотрудника(ДанныеСотрудников, Шапка.Титул2СвЛицОргПрвз, 
					"ФИО,ТелефонОсновной");
				
				ОбластьМакета.Параметры.РазмерПлатыИлиПорядокРасчетов = ОписаниеУсловийРасчетовЭЗЗ(Шапка);
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
				
				// Водители
				ОбластьМакета = Макет.ПолучитьОбласть("ВодителиШапка");
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
				
				ВодителиЭЗЗ = Водители.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
				
				Для Каждого Водитель Из ВодителиЭЗЗ Цикл
					ОбластьМакета = Макет.ПолучитьОбласть("ВодителиСтрока");
					ОбластьМакета.Параметры.ФИО = ОписаниеСотрудника(ДанныеСотрудников, Водитель.СвВодит, "ФИО");
					ОбластьМакета.Параметры.СвВодит = ОписаниеСотрудника(ДанныеСотрудников, Водитель.СвВодит, 
						"ИНН,ТелефонОсновной,ВУВодителя");
					ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЦикла;
				
				// Транспортные средства
				ОбластьМакета = Макет.ПолучитьОбласть("ТранспортныеСредстваШапка");
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ТранспортноеСредство");
				ОбластьМакета.Параметры.ТранспортноеСредство = ОписаниеТранспортногоСредстваЭЗЗ(ДанныеТС, 
					Шапка.Титул2ТранспортноеСредство, ДанныеДоговоров);
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
				
				ПрицепыЭЗЗ = Прицепы.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
				
				Для Каждого Прицеп Из ПрицепыЭЗЗ Цикл
					ОбластьМакета = Макет.ПолучитьОбласть("Прицеп");
					ОбластьМакета.Параметры.Прицеп = ОписаниеТранспортногоСредстваЭЗЗ(ДанныеТС, 
						Прицеп.Прицеп, ДанныеДоговоров);
					ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);	
				КонецЦикла;
								
				// Спец. разрешения
				СпецРазрешенияЭЗЗ = СпецРазрешения.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
				
				Если СпецРазрешенияЭЗЗ.Количество() > 0 Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("СпецУсловияДвиженияШапка");
					ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
						
					Для Каждого СпецРазрешение Из СпецРазрешенияЭЗЗ Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("СпецУсловияДвиженияСтрока");
						
						Если ЗначениеЗаполнено(СпецРазрешение.ВидСР) Тогда
							ОбластьМакета.Параметры.ВидСР = СпецРазрешение.ВидСР;
						Иначе
							ОбластьМакета.Параметры.ВидСР = "Специальное разрешение";
						КонецЕсли;
						ОбластьМакета.Параметры.ДанныеСпецРазрешения = ОписаниеСпецРазрешения(СпецРазрешение);
						ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
					КонецЦикла;
				КонецЕсли;
				
				// Инфополя					
				ИнфПолТ2ЭЗЗ = ИнфПолТ2.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
				
				Если ИнфПолТ2ЭЗЗ.Количество() > 0 Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ИнфПолТ2Шапка");
					ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
						
					Для Каждого Инфополе Из ИнфПолТ2ЭЗЗ Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("ИнфПолТ2Строка");
						ОбластьМакета.Параметры.Идентиф = Инфополе.Идентиф;
						ОбластьМакета.Параметры.Значение = Инфополе.Значение;
						ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		ВывестиДанныеЭлектронныхПодписейЭЗЗ(ДанныеПодписания, Макет, Шапка, ФормируемыйТабличныйДокумент);
		
		// Документы-основания
		ДокументыОснованияЭЗЗ = ДокументыОснования.Скопировать(Новый Структура("Титул1", Шапка.Титул1));
		
		ДокументыОснованияЭЗЗНеПустые = Новый Массив;
		
		Для Каждого Стр Из ДокументыОснованияЭЗЗ Цикл
			Если ЗначениеЗаполнено(Стр.ДокументОснование) Тогда
				ДокументыОснованияЭЗЗНеПустые.Добавить(Стр.ДокументОснование);
			КонецЕсли;
		КонецЦикла;
				
		Если ДокументыОснованияЭЗЗНеПустые.Количество() > 0 Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ДокументыУСШапка");
			ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
			
			Для Каждого ДокОсн Из ДокументыОснованияЭЗЗНеПустые Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("ДокументыУССтрока");
				ОбластьМакета.Параметры.ДокументУчетнойСистемы = ОписаниеПредставленияДокументаОснования(ДокОсн);
				ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиДанныеЭлектронныхПодписей(ДанныеПодписания, Макет, Шапка, ФормируемыйТабличныйДокумент)
	
	НайденныеДанныеПодписания = ДанныеПодписания.НайтиСтроки(Новый Структура("ДокументЭТрН", Шапка.ДокументЭТрН));
	Если НайденныеДанныеПодписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Отступ
	ОбластьМакета = Макет.ПолучитьОбласть("ПустаяСтрока");
	Для Счет = 1 По 15 Цикл
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
	// Шапка данных подписи
	ОбластьМакета = Макет.ПолучитьОбласть("ДанныеПодписиШапка");
	Если ЗначениеЗаполнено(Шапка.kl_id) Тогда
		ОбластьМакета.Параметры.ИдентификаторПеревозки = "Идентификатор перевозки - " + Строка(Шапка.kl_id);
	КонецЕсли; 
	ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
	
	// Данные по титулам
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ДокументЭТрН", Шапка.ДокументЭТрН);
	
	Для НомерТитула = 1 По 4 Цикл
		ПараметрыОтбора.Вставить("НомерТитула", НомерТитула);
		НайденныеДанныеПодписания = ДанныеПодписания.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеДанныеПодписания.Количество() <> 0 Тогда
			ВывестиДанныеСтрокиЭлектроннойПодписи(НайденныеДанныеПодписания[НайденныеДанныеПодписания.ВГраница()],
				Макет, ФормируемыйТабличныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиДанныеЭлектронныхПодписейЭЗЗ(ДанныеПодписания, Макет, Шапка, ФормируемыйТабличныйДокумент)
	
	НайденныеДанныеПодписания = ДанныеПодписания.НайтиСтроки(Новый Структура("Титул1", Шапка.Титул1));
	
	Если НайденныеДанныеПодписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Шапка данных подписи
	ОбластьМакета = Макет.ПолучитьОбласть("ДанныеПодписиШапка");
	Если ЗначениеЗаполнено(Шапка.Титул1УИД_Зак) Тогда
		ОбластьМакета.Параметры.ИдентификаторЗаявки = "Идентификатор заказа (заявки) - " + Шапка.Титул1УИД_Зак;
	КонецЕсли; 
	ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
	
	// Данные по титулам
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Титул1", Шапка.Титул1);
	
	Для НомерТитула = 1 По 2 Цикл
		ПараметрыОтбора.Вставить("НомерТитула", НомерТитула);
		НайденныеДанныеПодписания = ДанныеПодписания.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеДанныеПодписания.Количество() <> 0 Тогда
			ВывестиДанныеСтрокиЭлектроннойПодписи(НайденныеДанныеПодписания[НайденныеДанныеПодписания.ВГраница()],
				Макет, ФормируемыйТабличныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиДанныеСтрокиЭлектроннойПодписи(ТекущаяСтрока, Макет, ФормируемыйТабличныйДокумент)
	
	// Данные подписи
	ОбластьМакета = Макет.ПолучитьОбласть("ДанныеПодписиСтрока");
	
	Если ТекущаяСтрока.НомерТитула = 0 Тогда
		Возврат;
	ИначеЕсли ТекущаяСтрока.НомерТитула = 1 Тогда
		РольПодписанта = "Подпись грузоотправителя";
	ИначеЕсли ТекущаяСтрока.НомерТитула = 2 Тогда
		РольПодписанта = "Подпись перевозчика";
	ИначеЕсли ТекущаяСтрока.НомерТитула = 3 Тогда
		РольПодписанта = "Подпись грузополучателя";
	ИначеЕсли ТекущаяСтрока.НомерТитула = 4 Тогда
		РольПодписанта = "Подпись перевозчика";
	КонецЕсли;
	ОбластьМакета.Параметры.РольПодписанта = РольПодписанта;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.КомуВыданСертификат) Тогда
		ОбластьМакета.Параметры.ВладелецСертификата = ТекущаяСтрока.КомуВыданСертификат;
	КонецЕсли;
	
	ДанныеСертификата = Неопределено;
	ДвоичныеДанныеСертификата = ТекущаяСтрока.Сертификат.Получить();
	Если ДвоичныеДанныеСертификата = Неопределено Тогда
		ДвоичныеДанныеПодпись = ТекущаяСтрока.ФайлОбмена.Подпись.Получить();
		Если ДвоичныеДанныеПодпись <> Неопределено Тогда
			ДанныеСертификата = КонтурЛогистика_ИнтеграцияДиадокСерверПовтИсп.Ядро().ПолучитьСертификатИзПодписи(
				ДвоичныеДанныеПодпись);
		КонецЕсли;
	Иначе
		ДанныеСертификата = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
	КонецЕсли;
		
	Если ДанныеСертификата <> Неопределено Тогда
		ОбластьМакета.Параметры.ДанныеСертификата = СтрЗаменить(ВРег(ДанныеСертификата.СерийныйНомер), " ", "")
			+ Символы.ПС + "с " + Формат(ДанныеСертификата.ДатаНачала, "ДФ='dd.MM.yyyy HH:mm'")
			+ " по " + Формат(ДанныеСертификата.ДатаОкончания, "ДФ='dd.MM.yyyy HH:mm'") + " GMT+03:00";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ДатаВремяФормирования) Тогда
		ОбластьМакета.Параметры.ДатаИВремяПодписания =
			Формат(ТекущаяСтрока.ДатаВремяФормирования, "ДФ='dd.MM.yyyy HH:mm'") + " GMT+03:00"
			+ Символы.ПС + "Подпись соответствует файлу документа";
	КонецЕсли;
	
	ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
	
	Если (ТекущаяСтрока.НомерТитула = 1 Или ТекущаяСтрока.НомерТитула = 3)
		И ЗначениеЗаполнено(ТекущаяСтрока.ВодительДатаСобытия) Тогда
		
		// Подпись водителя
		ОбластьМакета = Макет.ПолучитьОбласть("ДанныеПодписиСтрока");
		ОбластьМакета.Параметры.РольПодписанта = "Подпись водителя";
		ОбластьМакета.Параметры.ДанныеСертификата = "Простая электронная подпись";
		
		ТекстXML = ТекущаяСтрока.ВодительТекст.Получить();
		Если ТекстXML <> Неопределено Тогда
			Попытка
				XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);
				КС = КонтурЛогистика_КонструкторыXDTO;
				
				ОбластьМакета.Параметры.ВладелецСертификата =
					КС.XDTO_Вычислить(XDTO, "Driver.LastName") + " "
					+ КС.XDTO_Вычислить(XDTO, "Driver.FirstName") + " "
					+ КС.XDTO_Вычислить(XDTO, "Driver.MiddleName");
				ОбластьМакета.Параметры.ДатаИВремяПодписания = КонтурЛогистика_КонструкторыXDTO.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(
					КС.XDTO_Вычислить(XDTO, "Driver.ConfirmedAt"));
			Исключение
				ОбластьМакета.Параметры.ДатаИВремяПодписания = Формат(ТекущаяСтрока.ВодительДатаСобытия,
					"ДФ='dd.MM.yyyy HH:mm'") + " GMT+03:00";
			КонецПопытки; 
		КонецЕсли;
		
		ФормируемыйТабличныйДокумент.Вывести(ОбластьМакета);
		
	КонецЕсли;
	
КонецПроцедуры

