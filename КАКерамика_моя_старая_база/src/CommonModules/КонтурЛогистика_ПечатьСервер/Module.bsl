Функция ОписаниеДоговора(ДанныеДоговоров, Договор)
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат "";
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("Договор", Договор);
	НайденныйДоговора = ДанныеДоговоров.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныйДоговора.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекущийДоговор = НайденныйДоговора[0];
	
	Если Найти(ТекущийДоговор.Наименование, ТекущийДоговор.НомерДокумента) > 0 Тогда
		ШаблонСтроки = "%1";
	Иначе
		ШаблонСтроки = "%1 №%2 от %3";
	КонецЕсли;
	
	ОписаниеДоговора = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
		ШаблонСтроки, ТекущийДоговор.Наименование, ТекущийДоговор.НомерДокумента, Формат(ТекущийДоговор.ДатаДокумента, "ДФ=dd.MM.yy"));
	
	Возврат ОписаниеДоговора;
	
КонецФункции

