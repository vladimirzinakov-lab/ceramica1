#Область ИнформацияДляТехПоддержки

Функция СоздатьКнопкуНаписатьВПоддержку(Форма, Родитель)
	
	ИмяКнопоки = "КонтурЛогистикаДинамическаяКнопкаНаписатьВПоддержку";
	
	ЭлементКнопки = Форма.Элементы.Найти(ИмяКнопоки);
	
	Если ЭлементКнопки <> Неопределено Тогда
		Возврат ЭлементКнопки;
	КонецЕсли;
	
	ЗаголовокКнопки = "Написать: help.logistika@kontur.ru";
	
	ИмяДействия = "КонтурЛогистикаПодключаемый_ВыполнитьКоманду";
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("Картинка", БиблиотекаКартинок.КонтурЛогистика_Email);

	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьКоманду(Форма, ИмяКнопоки,, ИмяДействия, СтруктураСвойств);  
	
	Возврат КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздКнопка(Форма, ИмяКнопоки, Родитель, ЗаголовокКнопки, ИмяКнопоки);
	
КонецФункции

Функция ДостаточноПравДляОткрытияИнформацииПоТитулуДляТехподдержки() Экспорт
	
	Если РольДоступна("КонтурЛогистика_ОтчетТехподдержка") 
		Или РольДоступна("КонтурЛогистика_ПолныеПраваЛогистика") 
		Или (КонтурЛогистика_Привилегированный.РольСуществует("КонтурЛогистика_УдалитьАдминистратор")
			И РольДоступна("КонтурЛогистика_УдалитьАдминистратор"))
		Или (КонтурЛогистика_Привилегированный.РольСуществует("АдминистраторСистемы")
			И РольДоступна("АдминистраторСистемы")) 
		Или (КонтурЛогистика_Привилегированный.РольСуществует("ПолныеПрава")
			И РольДоступна("ПолныеПрава")) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ДанныеДляИнформацииПоТитулуВТехподдержку(Титул, РеквизитыФормы = Неопределено) Экспорт
	
	ДанныеДляОтчета = Новый Структура;
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "Общая тех. информация", ЛистОбщаяТехИнформация());
	ДанныеДляОтчета.Вставить("ОбщаяТехИнформация", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "Титул", ЛистРеквизитыТитула(Титул, РеквизитыФормы));
	ДанныеДляОтчета.Вставить("РеквизитыТитула", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "Ошибки", ЛистОшибкиТитула(Титул));
	ДанныеДляОтчета.Вставить("ОшибкиТитула", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "Организации", ЛистОрганизацииТитула(Титул));
	ДанныеДляОтчета.Вставить("ОрганизацииТитула", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "ДопМодули", ЛистДопМодули());
	ДанныеДляОтчета.Вставить("ДопМодули", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "ГруппыДоступа", ЛистГруппыДоступа());
	ДанныеДляОтчета.Вставить("ГруппыДоступа", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "ФайлыОбмена", ЛистФайлыОбмена(Титул));
	ДанныеДляОтчета.Вставить("ФайлыОбмена", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "Робот", ЛистРобот(Титул));
	ДанныеДляОтчета.Вставить("Робот", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "ИсторияСостояний", ЛистИсторияСостояний(Титул));
	ДанныеДляОтчета.Вставить("ИсторияСостояний", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "CustomData", ЛистCustomData(Титул));
	ДанныеДляОтчета.Вставить("CustomData", Данные);
	
	Данные = Новый Структура("Наименование, ТабличныйДокумент", "ВсеТитулыИФайлы", ВсеТитулыИФайлы(Титул));
	ДанныеДляОтчета.Вставить("ВсеТитулыИФайлы", Данные);
	
	Возврат ДанныеДляОтчета;
		
КонецФункции

Функция ЛистОбщаяТехИнформация()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Дата и время выгрузки отчета", ТекущаяДатаСеанса());
	
	ИнформацияДляПоддержки = КонтурЛогистика_ОбщегоНазначенияСервер.ИнформацияДляПоддержки();
	
	Для каждого Информация Из ИнформацияДляПоддержки Цикл
		
		Для каждого Данные Из Информация.Значение Цикл
			
			Параметр = Данные.Ключ;
			
			СтруктураЗамен = СтруктураЗаменДляОбщейТехИнформация();
			Если СтруктураЗамен.Свойство(Параметр) Тогда
				Параметр = СтруктураЗамен[Параметр];
			КонецЕсли;
			
			ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", Параметр, Данные.Значение);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТабДок;
		
КонецФункции

Процедура ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, ИмяОбласти, Параметр, Значение, Полужирный = Ложь)
	
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	
	
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Область = Макет.ПолучитьОбласть(ИмяОбласти + "Хранилище");
		Область.Параметры.Значение = Значение.Получить();
	Иначе
		Область = Макет.ПолучитьОбласть(ИмяОбласти);
		Область.Параметры.Значение = Значение;
	КонецЕсли;
	
	Область.Параметры.Параметр = Параметр;
	
	Если Полужирный Тогда
		Область.Области[ИмяОбласти].Шрифт = Новый Шрифт(,, Истина);
	КонецЕсли;
	
	ТабДок.Вывести(Область);
	
КонецПроцедуры

Функция ЛистРеквизитыТитула(Титул, РеквизитыФормы = Неопределено)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Реквизиты титула:", "");
	ВывестиРеквизитыОбъекта(ТабДок, Макет, Титул);
	
	Если РеквизитыФормы <> Неопределено Тогда
		ВывестиПустуюСтроку(ТабДок, Макет);
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Реквизиты формы титула:", "");
		ВывестиРеквизитыФормы(ТабДок, Макет, РеквизитыФормы)
	КонецЕсли;
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Титул) Тогда
		ВывестиПустуюСтроку(ТабДок, Макет);
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Реквизиты ЭТРН:", "");
		ВывестиРеквизитыОбъекта(ТабДок, Макет, Титул.ДокументЭТРН);
	КонецЕсли;
		
	Возврат ТабДок;
		
КонецФункции

Процедура ВывестиРеквизитыФормы(ТабДок, Макет, РеквизитыФормы)
	
	Для каждого Реквизит Из РеквизитыФормы Цикл
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", Реквизит.Представление, Реквизит.Значение);		
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ВывестиРеквизитыОбъекта(ТабДок, Макет, Объект)
	
	МетаданныеТитула = Объект.Метаданные();
	
	ТаблицаРеквизиты = Новый ТаблицаЗначений;
	ТаблицаРеквизиты.Колонки.Добавить("Имя");
	ТаблицаРеквизиты.Колонки.Добавить("Синоним");
	ТаблицаРеквизиты.Колонки.Добавить("Значение");
	
	Для каждого Реквизит Из МетаданныеТитула.Реквизиты Цикл
		НоваяСтрока = ТаблицаРеквизиты.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Синоним = Реквизит.Синоним;
		НоваяСтрока.Значение = Объект[Реквизит.Имя];		
	КонецЦикла;
	
	ТаблицаРеквизиты.Сортировать("Имя");
	
	НоваяСтрока = ТаблицаРеквизиты.Вставить(0);
	НоваяСтрока.Имя = "ПометкаУдаления";
	НоваяСтрока.Синоним = "Пометка удаления";
	НоваяСтрока.Значение = Объект["ПометкаУдаления"];
	
	Если Метаданные.Справочники.Содержит(Объект.Метаданные()) Тогда
		
		НоваяСтрока = ТаблицаРеквизиты.Вставить(0);
		НоваяСтрока.Имя = "Наименование";
		НоваяСтрока.Синоним = "Наименование";
		НоваяСтрока.Значение = Объект["Наименование"];
		
		НоваяСтрока = ТаблицаРеквизиты.Вставить(0);
		НоваяСтрока.Имя = "Код";
		НоваяСтрока.Синоним = "Код";
		НоваяСтрока.Значение = Объект["Код"];		
		
	Иначе
		
		НоваяСтрока = ТаблицаРеквизиты.Вставить(0);
		НоваяСтрока.Имя = "Дата";
		НоваяСтрока.Синоним = "Дата";
		НоваяСтрока.Значение = Объект["Дата"];
		
		НоваяСтрока = ТаблицаРеквизиты.Вставить(0);
		НоваяСтрока.Имя = "Номер";
		НоваяСтрока.Синоним = "Номер";
		НоваяСтрока.Значение = Объект["Номер"];
			
	КонецЕсли;
	
	Для каждого Реквизит Из ТаблицаРеквизиты Цикл
		Параметр = Реквизит.Синоним + " (" + Реквизит.Имя + ")";
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", Параметр, Объект[Реквизит.Имя]);		
	КонецЦикла;
		
	Для каждого ТЧ Из МетаданныеТитула.ТабличныеЧасти Цикл
		
		Если Объект[ТЧ.Имя].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыТЧ = ТЧ.Реквизиты;
		
		ВывестиПустуюСтроку(ТабДок, Макет);
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Табличная часть " + ТЧ.Синоним + " (" + ТЧ.Имя + ")", "");
		
		ВывестиНомерСтроки(ТабДок, Макет, "№ строки");
		Для каждого РеквизитТЧ Из РеквизитыТЧ Цикл
			ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, РеквизитТЧ.Синоним + " (" + РеквизитТЧ.Имя + ")");
		КонецЦикла;
		
		Для каждого СтрокаТЧ Из Объект[ТЧ.Имя] Цикл
			
			ВывестиНомерСтроки(ТабДок, Макет, СтрокаТЧ.НомерСтроки);			
			Для каждого РеквизитТЧ Из РеквизитыТЧ Цикл
				ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, СтрокаТЧ[РеквизитТЧ.Имя]);
			КонецЦикла
			
		КонецЦикла
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЛистОшибкиТитула(Титул)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	МетаданныеТитула = Титул.Метаданные();
	
	ТаблицаОшибок = Документы[МетаданныеТитула.Имя].ПроверитьДокумент(Титул);	
	
	Для каждого Ошибка Из ТаблицаОшибок.МассивОшибок Цикл
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Ошибка", Ошибка);
	КонецЦикла;
	
	Для каждого Предупреждение Из ТаблицаОшибок.МассивПредупреждений Цикл
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Предупреждение", Предупреждение);
	КонецЦикла;
	
	Возврат ТабДок;
		
КонецФункции

Функция ЛистОрганизацииТитула(Титул)

	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
			
	ОсновныеДанныеФайла = Справочники.КонтурЛогистика_ФайлыОбмена.ПолучитьОсновныеДанныеФайла(Титул);
	ОрганизацияОтправитель = ОсновныеДанныеФайла.Отправитель;
	
	ОрганизацииДляОтчета = Новый ТаблицаЗначений;
	ОрганизацииДляОтчета.Колонки.Добавить("Организация");
	ОрганизацииДляОтчета.Колонки.Добавить("Роль");
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Титул) И ЗначениеЗаполнено(Титул.ДокументЭТРН) Тогда
		
		РолиПеревозки = Новый Массив;
		РолиПеревозки.Добавить("Грузоотправитель");
		РолиПеревозки.Добавить("Перевозчик");
		РолиПеревозки.Добавить("Грузополучатель");
		РолиПеревозки.Добавить("ПогрузкуОсуществляет");
		РолиПеревозки.Добавить("ЭкспедицияЗаказчик");
		РолиПеревозки.Добавить("Составитель");
		
		Для каждого Роль Из РолиПеревозки Цикл
			
			Если Роль = "Составитель" Тогда
				Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
					Организация = Титул[Роль];
				КонецЕсли;
			Иначе
				Организация = Титул.ДокументЭТРН[Роль];
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета);
			
		КонецЦикла;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Титул) Тогда
		
		РолиПеревозки = Новый Массив;
		РолиПеревозки.Добавить("ЛицоОформившееПЛ");
		РолиПеревозки.Добавить("ОрганизацияМедик");
		Если Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ_5_02(Титул) Тогда
			РолиПеревозки.Добавить("ОрганизацияТехСостояние");
			РолиПеревозки.Добавить("ОрганизацияОдометр");	
		КонецЕсли;
		
		Для каждого Роль Из РолиПеревозки Цикл
			
			Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
				Или ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
				Организация = Титул[Роль];
			Иначе
				Организация = Титул.Титул1[Роль];
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета);	
			
		КонецЦикла;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Титул) Тогда
		
		РолиПеревозки = Новый Массив;
		РолиПеревозки.Добавить("Грузоотправитель");
		РолиПеревозки.Добавить("Перевозчик");
		
		Для каждого Роль Из РолиПеревозки Цикл
			
			Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
				Организация = Титул[Роль];
			Иначе
				Организация = Титул.Титул1[Роль];
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета);	
			
		КонецЦикла;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЭ(Титул) Тогда
		
		РолиПеревозки = Новый Массив;
		РолиПеревозки.Добавить("СвКлиент");
		РолиПеревозки.Добавить("СвЭксп");
		
		Для каждого Роль Из РолиПеревозки Цикл
			
			Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1") Тогда
				Организация = Титул[Роль];
			Иначе
				Организация = Титул.Титул1[Роль];
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета);	
			
		КонецЦикла;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЭР(Титул) Тогда
		
		РолиПеревозки = Новый Массив;
		РолиПеревозки.Добавить("Грузоотправитель");
		РолиПеревозки.Добавить("Клиент");
		РолиПеревозки.Добавить("Экспедитор");
		РолиПеревозки.Добавить("ОтправительШаблона");
		
		Для каждого Роль Из РолиПеревозки Цикл
			
			Организация = Титул[Роль];
						
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета);	
			
		КонецЦикла;
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулСР(Титул) Тогда
		
		РолиПеревозки = Новый Массив;
		РолиПеревозки.Добавить("Клиент");
		РолиПеревозки.Добавить("Экспедитор");
		
		Для каждого Роль Из РолиПеревозки Цикл
			
			Организация = Титул[Роль];
			
			Если Не ЗначениеЗаполнено(Организация) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого Строка Из ОрганизацииДляОтчета Цикл		
		ВывестиОрганизацию(ТабДок, Макет, Титул, Строка.Организация, Строка.Роль, ОрганизацияОтправитель);
		ВывестиПустуюСтроку(ТабДок, Макет);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Процедура ДобавитьОрганизацию(Организация, Роль, ОрганизацииДляОтчета)
	
	НайденнаяОрганизация = ОрганизацииДляОтчета.Найти(Организация);
	Если НайденнаяОрганизация = Неопределено Тогда
		НоваяСтрока = ОрганизацииДляОтчета.Добавить();
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Роль = Роль;
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОрганизацию(ТабДок, Макет, Титул, Организация, РольОрганизации, ОрганизацияОтправитель)
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", РольОрганизации, Организация, Истина);
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Наименование", Организация.Наименование);
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "ИНН", Организация.ИНН);
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "КПП", Организация.КПП);
	
	Роли = Новый Массив;
	РолиОрганизации = КонтурЛогистика_ОбщегоНазначенияСервер.РолиОрганизации(Организация);
	Для каждого Роль Из РолиОрганизации Цикл
		Если Роль.Значение Тогда
			Роли.Добавить(Роль.Ключ);	
		КонецЕсли;
	КонецЦикла;
	РолиСтрока = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(Роли, ", ");
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Роли", РолиСтрока);
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "BoxId", Организация.ID);
	
	ДатаГраницыДиадок = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		Организация, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДиадокДата);
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Лента Диадок", ДатаГраницыДиадок);
	
	ДатаГраницыЛогистика = Справочники.КонтурЛогистика_ОрганизацииДиадок.ЗначениеНастройки(
		Организация, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.АктуальностьЛентыСобытийДата);
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Лента Логистика", ДатаГраницыЛогистика);
	
	РежимАвторизации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("РежимАвторизации");
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Тип авторизации", РежимАвторизации);
	
	Если Организация <> ОрганизацияОтправитель Тогда
		Возврат;
	КонецЕсли;
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Пользователь -подписант титула (ФИО)", Титул.ПользовательПодписант);

	ВывестиПользователейПодписантов(ТабДок, Макет, Организация);
		
КонецПроцедуры

Процедура ВывестиПользователейПодписантов(ТабДок, Макет, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Пользователь1С КАК Пользователь1С,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ДатаВыдачи КАК ДатаНачалаДействияСертификата,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.СрокДействия КАК ДатаОкончанияДействияСертификата,
		|	КонтурЛогистика_НастройкиПодписанияСрезПоследних.Сертификат.ОтпечатокСертификата КАК ОтпечатокСертификата
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_НастройкиПодписания.СрезПоследних(&Период, ОрганизацияДиадок = &Организация) КАК КонтурЛогистика_НастройкиПодписанияСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Пользователь1С) Тогда
			Пользователь1С = ВыборкаДетальныеЗаписи.Пользователь1С;
		Иначе
			Пользователь1С = "Все пользователи";
		КонецЕсли;
		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Пользователь -подписант (ФИО)", Строка(ВыборкаДетальныеЗаписи.Пользователь1С));
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Отпечаток сертификата", ВыборкаДетальныеЗаписи.ОтпечатокСертификата);
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Дата начала действия сертификата", ВыборкаДетальныеЗаписи.ДатаНачалаДействияСертификата);
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Дата окончания действия сертификата", ВыборкаДетальныеЗаписи.ДатаОкончанияДействияСертификата);		
	КонецЦикла;
		
КонецПроцедуры

Функция ЛистДопМодули()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ПараметрыУстановкиМодулейКонтура = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПараметрыУстановкиМодулей();	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Версия модуля Диадок", ПараметрыУстановкиМодулейКонтура.Диадок.НомерВерсии);
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Версия модуля EDI", ПараметрыУстановкиМодулейКонтура.EDI.НомерВерсии);
	
	Возврат ТабДок;
	
КонецФункции

Функция МакетДляОтчетаТехПоддержки()

	Возврат ПолучитьОбщийМакет("КонтурЛогистика_ОтчетДляТехподдержки");
	
КонецФункции

Функция ЛистГруппыДоступа()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ТекущийПользователь1С = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Пользователь ФИО", ТекущийПользователь1С);
	
	Если ЗначениеЗаполнено(ТекущийПользователь1С)
		И Метаданные.Справочники.Найти("ГруппыДоступа") = Неопределено 
		И Метаданные.Справочники.Найти("ПрофилиГруппДоступа") = Неопределено Тогда
		
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		
		Если ТекущийПользовательИБ = Неопределено Тогда
			Возврат ТабДок;
		КонецЕсли;
		
		Роли = Новый Массив;
		Для каждого Роль Из ТекущийПользовательИБ.Роли Цикл
			Если Найти(Роль.Имя, "КонтурЛогистика_") > 0 Тогда
				Роли.Добавить(Роль.Имя);	
			КонецЕсли;
		КонецЦикла;
		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Роль", КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(Роли, ", "));
		
		Возврат ТабДок;
		
	КонецЕсли;
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
			|ГДЕ
			|	ГруппыДоступаПользователи.Пользователь = &Пользователь";
		
		Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь1С);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ГруппаДоступа = ВыборкаДетальныеЗаписи.Ссылка;
			Профиль = ГруппаДоступа.Профиль;
			
			Если Не ЗначениеЗаполнено(Профиль) Тогда
				Продолжить;
			КонецЕсли;
			
			ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Группа доступа", ГруппаДоступа);
			ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Профиль", Профиль);
			 
			Роли = Новый Массив;
			Для каждого Строка Из Профиль.Роли Цикл
				
				ИмяРоли = ИмяРолиПрофиляГруппДоступа(Строка.Роль);
				Если Найти(ИмяРоли, "КонтурЛогистика_") > 0 Тогда
					Роли.Добавить(ИмяРоли);
				КонецЕсли;
				
			КонецЦикла;
			
			ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Роль", КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(Роли, ", "));
			
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Сообщить("Ошибка при выгрузке групп доступа." + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
	КонецПопытки;
	
	Возврат ТабДок;
	
КонецФункции

// Возвращает имя роли из значения табличной части профиля групп доступа.
//
// Параметры:
//  РольПрофиля - СправочникСсылка.ИдентификаторыОбъектовМетаданных, Строка, Произвольный -
//                значение реквизита Роль строки профиля.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяРолиПрофиляГруппДоступа(РольПрофиля)
	
	Если Не ЗначениеЗаполнено(РольПрофиля) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(РольПрофиля) = Тип("Строка") Тогда
		Возврат РольПрофиля;
	КонецЕсли;
	
	ОбъектМетаданныхТипа = Метаданные.НайтиПоТипу(ТипЗнч(РольПрофиля));
	Если ОбъектМетаданныхТипа = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не Метаданные.Справочники.Содержит(ОбъектМетаданныхТипа) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ОбъектМетаданныхТипа.Реквизиты.Найти("Имя") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяРоли = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(РольПрофиля, "Имя");
	Если Не ЗначениеЗаполнено(ИмяРоли) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ИмяРоли;
	
КонецФункции

Функция ЛистФайлыОбмена(Титул)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ВывестиФайлыОбмена(ТабДок, Макет, Титул);
					
	Возврат ТабДок;
	
КонецФункции

Процедура ВывестиФайлыОбмена(ТабДок, Макет, Титул)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|ГДЕ
		|	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = &СвязанныйДокумент
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтурЛогистика_ФайлыОбмена.ДатаВремяФормирования";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", Титул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ФайлОбмена = ВыборкаДетальныеЗаписи.Ссылка;
		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Файл:", ФайлОбмена, Истина);
		ВывестиРеквизитыОбъекта(ТабДок, Макет, ФайлОбмена);
		ВывестиПустуюСтроку(ТабДок, Макет);
				
	КонецЦикла;
	
КонецПроцедуры

Функция ЛистРобот(Титул)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ЕстьРобот = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ФайлыОбмена.ТипДокумента КАК ТипДокумента
		|ПОМЕСТИТЬ ТипДокументаЛогистики
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|ГДЕ
		|	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент = &СвязанныйДокумент
		|	И КонтурЛогистика_ФайлыОбмена.СформированАвтоматическимСценарием
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтурЛогистика_ФайлыОбмена.ТипДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонтурЛогистика_СценарииАвтоматическойРаботы.Ссылка КАК Ссылка
		|ИЗ
		|	ТипДокументаЛогистики КАК ТипДокументаЛогистики
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_СценарииАвтоматическойРаботы КАК КонтурЛогистика_СценарииАвтоматическойРаботы
		|		ПО ТипДокументаЛогистики.ТипДокумента = КонтурЛогистика_СценарииАвтоматическойРаботы.ТипЛогистическогоДокумента
		|ГДЕ
		|	НЕ КонтурЛогистика_СценарииАвтоматическойРаботы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.СценарииАвтоматическойРаботы
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы КАК КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы
		|ГДЕ
		|	КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.ОбъектОбработки = &СвязанныйДокумент
		|
		|СГРУППИРОВАТЬ ПО
		|	КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы.СценарииАвтоматическойРаботы";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", Титул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Робот = ВыборкаДетальныеЗаписи.Ссылка;
		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", Робот, "");
		ВывестиРеквизитыОбъекта(ТабДок, Макет, Робот);
		ВывестиПустуюСтроку(ТабДок, Макет);
		
		ЕстьРобот = Истина;
				
	КонецЦикла;
	
	Если ЕстьОшибкиСценариевАвтоматическойРаботы(Титул) Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	Если ЕстьРобот Тогда
		ВывестиПустуюСтроку(ТабДок, Макет);
	КонецЕсли;	
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Ошибки роботов:", "");
	ВывестиРегистрСведений(ТабДок, Макет, "КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы", Титул);
		
	Возврат ТабДок;
	
КонецФункции

Функция ЛистИсторияСостояний(Титул)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
		
	Документ = ГлавныйДокумент(Титул);		
	
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "История состояний:", "");
	ВывестиРегистрСведений(ТабДок, Макет, "КонтурЛогистика_ДвижениеДокументооборота", Документ);
	
	ВывестиПустуюСтроку(ТабДок, Макет);
	 		
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "История статусов:", "");
	ВывестиСтатусыСвязанныхДокументов(ТабДок, Макет, Титул);
	
	Возврат ТабДок;
	
КонецФункции

Функция ГлавныйДокумент(Титул)
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Титул) Тогда
		Документ = Титул.ДокументЭТРН;
	Иначе 
		МетаданныеТитула = Титул.Метаданные();
		
		Если МетаданныеТитула.Реквизиты.Найти("Титул1") = Неопределено Тогда
			Документ = Титул;
		Иначе
			Документ = Титул.Титул1;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Документ;
	
КонецФункции

Процедура ВывестиРегистрСведений(ТабДок, Макет, ИмяРС, Документ)
	
	Если ТипЗнч(Документ) = Тип("Массив") Тогда
		МасивДокументов = Документ;
	Иначе
		МасивДокументов = Новый Массив;
		МасивДокументов.Добавить(Документ);
	КонецЕсли;
	
	ТаблицаРеквизиты = ТаблицаРеквизитовРегистраСведений(ИмяРС);
	
	ПериодичностьРС = Метаданные.РегистрыСведений[ИмяРС].ПериодичностьРегистраСведений;
	Если ПериодичностьРС <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		НоваяСтрока = ТаблицаРеквизиты.Вставить(0);
		НоваяСтрока.Имя = "Период";
		НоваяСтрока.Синоним = "Период";
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.КонтурЛогистика_СтатусыТитулов КАК КонтурЛогистика_СтатусыТитулов
		|ГДЕ
		|	КонтурЛогистика_СтатусыТитулов.Документ В(&Документы)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_СтатусыТитулов", ИмяРС);
	
	Если ИмяРС = "КонтурЛогистика_ОшибкиСценариевАвтоматическойРаботы" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".Документ", ".ОбъектОбработки");	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Документы", МасивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВывестиНомерСтроки(ТабДок, Макет, "№ строки");			
	Для каждого Реквизит Из ТаблицаРеквизиты Цикл
		ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, Реквизит.Синоним + " (" + Реквизит.Имя + ")");
	КонецЦикла;
	
	НомерСтроки = 1;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Индекс = 1;
		
		ВывестиНомерСтроки(ТабДок, Макет, НомерСтроки);			
		Для каждого Реквизит Из ТаблицаРеквизиты Цикл
			ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, ВыборкаДетальныеЗаписи[Реквизит.Имя]);
		КонецЦикла;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСтатусыСвязанныхДокументов(ТабДок, Макет, Титул)
	
	СвязанныеДокументы = СвязанныеДокументы(Титул);
	
	Если СвязанныеДокументы.Количество() > 0 Тогда
		ВывестиРегистрСведений(ТабДок, Макет, "КонтурЛогистика_СтатусыТитулов", СвязанныеДокументы);
	КонецЕсли;
	
КонецПроцедуры

Функция СвязанныеДокументы(Титул)
	
	Шаблон =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
		|ГДЕ
		|	КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = &ДокументЭТРН";
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Титул) Тогда
		
		ДокументЭТРН = Титул.ДокументЭТРН;
		
		ЗапросМассив = Новый Массив;
		
		ВидыТитулов = Новый Массив;
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул1");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул2");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул3");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул4");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул5");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул6");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул7");
		ВидыТитулов.Добавить("КонтурЛогистика_ТрН_Титул8");
								
		Для каждого ВидТитула Из ВидыТитулов Цикл
			ЗапросМассив.Добавить(СтрЗаменить(Шаблон, "КонтурЛогистика_ТрН_Титул1", ВидТитула));
		КонецЦикла;
				
		Запрос = Новый Запрос;
		Запрос.Текст = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(ЗапросМассив, " ОБЪЕДИНИТЬ ");
		
		Запрос.УстановитьПараметр("ДокументЭТРН", ДокументЭТРН);
		
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
				
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ_5_02(Титул) Тогда
		
		Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
			Титул1 = Титул;
		Иначе
			Титул1 = Титул.Титул1;
		КонецЕсли;
		
		ВидыТитулов = Новый Массив;
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул1_5_02");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул2_5_02");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул3_5_02");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул4_5_02");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул5_5_02");
		
		Результат = ВыполнитьЗапрос(Шаблон, ВидыТитулов, "КонтурЛогистика_ПЛ_Титул1_5_02", Титул1);
				
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЛ(Титул) Тогда
		
		Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
			Титул1 = Титул;
		Иначе
			Титул1 = Титул.Титул1;
		КонецЕсли;
		
		ВидыТитулов = Новый Массив;
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул1");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул2");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул3");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул4");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул5");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЛ_Титул6");
		
		Результат = ВыполнитьЗапрос(Шаблон, ВидыТитулов, "КонтурЛогистика_ПЛ_Титул1", Титул1);
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗЗ(Титул) Тогда
		
		Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
			Титул1 = Титул;
		Иначе
			Титул1 = Титул.Титул1;
		КонецЕсли;
		
		ВидыТитулов = Новый Массив;
		ВидыТитулов.Добавить("КонтурЛогистика_ЗЗ_Титул1");
		ВидыТитулов.Добавить("КонтурЛогистика_ЗЗ_Титул2");
		
		Результат = ВыполнитьЗапрос(Шаблон, ВидыТитулов, "КонтурЛогистика_ЗЗ_Титул1", Титул1);		
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулПЭ(Титул) Тогда
		
		Если ТипЗнч(Титул) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1") Тогда
			Титул1 = Титул;
		Иначе
			Титул1 = Титул.Титул1;
		КонецЕсли;
		 		
		ВидыТитулов = Новый Массив;
		ВидыТитулов.Добавить("КонтурЛогистика_ПЭ_Титул1");
		ВидыТитулов.Добавить("КонтурЛогистика_ПЭ_Титул2");
		
		Результат = ВыполнитьЗапрос(Шаблон, ВидыТитулов, "КонтурЛогистика_ПЭ_Титул1", Титул1);
		
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЭР(Титул)
		Или КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулСР(Титул) Тогда
		
		Результат = Новый Массив;
		Результат.Добавить(Титул);
		
	Иначе
		
		Результат = Новый Массив;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьЗапрос(Шаблон, ВидыТитулов, ВидТитула1, Титул1)
	
	ЗапросМассив = Новый Массив;
	
	Для каждого ВидТитула Из ВидыТитулов Цикл
			
		ТекстЗапроса = СтрЗаменить(Шаблон, "КонтурЛогистика_ТрН_Титул1", ВидТитула);
		
		Если ВидТитула = ВидТитула1 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".ДокументЭТРН", ".Ссылка");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументЭТРН", "Титул1");				
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументЭТРН", "Титул1");			
		КонецЕсли;
		
		ЗапросМассив.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(ЗапросМассив, Символы.ПС + " ОБЪЕДИНИТЬ " + Символы.ПС);
	
	Запрос.УстановитьПараметр("Титул1", Титул1);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	 		
КонецФункции

Функция ТаблицаРеквизитовРегистраСведений(Имя)
	
	ТаблицаРеквизиты = Новый ТаблицаЗначений;
	ТаблицаРеквизиты.Колонки.Добавить("Имя");
	ТаблицаРеквизиты.Колонки.Добавить("Синоним");
		
	РС = Метаданные.РегистрыСведений[Имя];
	
	Для каждого Реквизит Из РС.Измерения Цикл
		НоваяСтрока = ТаблицаРеквизиты.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Синоним = Реквизит.Синоним;
	КонецЦикла;
	Для каждого Реквизит Из РС.Ресурсы Цикл
		НоваяСтрока = ТаблицаРеквизиты.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Синоним = Реквизит.Синоним;
	КонецЦикла;
	Для каждого Реквизит Из РС.Реквизиты Цикл
		НоваяСтрока = ТаблицаРеквизиты.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Синоним = Реквизит.Синоним;
	КонецЦикла;
	
	Возврат ТаблицаРеквизиты;
	
КонецФункции

Функция ЛистCustomData(Титул)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	ГлавныйДокумент = ГлавныйДокумент(Титул);	
	
	ТаблицаРеквизиты = Новый ТаблицаЗначений;
	ТаблицаРеквизиты.Колонки.Добавить("Имя");
	ТаблицаРеквизиты.Колонки.Добавить("Синоним");
	ТаблицаРеквизиты.Колонки.Добавить("Значение");
	
	Для каждого Реквизит Из Метаданные.Справочники.КонтурЛогистика_ФайлыОбмена.ТабличныеЧасти.CustomData.Реквизиты Цикл
		НоваяСтрока = ТаблицаРеквизиты.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Синоним = Реквизит.Синоним;		
	КонецЦикла;
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена.CustomData КАК КонтурЛогистика_ФайлыОбменаCustomData
		|ГДЕ
		|	КонтурЛогистика_ФайлыОбменаCustomData.Ссылка.ГлавныйДокумент = &ГлавныйДокумент
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл		
		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Файл:", ВыборкаСсылка.Ссылка, Истина);
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Связанный документ:", ВыборкаСсылка.Ссылка.СвязанныйДокумент);
		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Табличная чась CustomData:", "");
		
		ВывестиНомерСтроки(ТабДок, Макет, "№ строки");			
		Для каждого Реквизит Из ТаблицаРеквизиты Цикл
			ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, Реквизит.Синоним + " (" + Реквизит.Имя + ")");
		КонецЦикла;
		
		НомерСтроки = 1;		
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ВывестиНомерСтроки(ТабДок, Макет, НомерСтроки);			
			Для каждого Реквизит Из ТаблицаРеквизиты Цикл
				ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, ВыборкаДетальныеЗаписи[Реквизит.Имя]);
			КонецЦикла;
					
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		ВывестиПустуюСтроку(ТабДок, Макет);
		
	КонецЦикла;
			
	Возврат ТабДок;
	
КонецФункции

Функция ВсеТитулыИФайлы(Титул)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = МакетДляОтчетаТехПоддержки();
	
	СвязанныеДокументы = СвязанныеДокументы(Титул);
	
	Для каждого СвязанныйДокумент Из СвязанныеДокументы Цикл
		
		ТипТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(СвязанныйДокумент);		
		ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "Титул " + Строка(ТипТитула) + ":", СвязанныйДокумент, Истина);
		
		ТабДок.НачатьГруппуСтрок();
		ВывестиРеквизитыОбъекта(ТабДок, Макет, СвязанныйДокумент);
		ВывестиПустуюСтроку(ТабДок, Макет);
		ВывестиФайлыОбмена(ТабДок, Макет, СвязанныйДокумент);		
		ТабДок.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	ТабДок.ПоказатьУровеньГруппировокСтрок(0);
	
	Возврат ТабДок;
	
КонецФункции

Процедура ВывестиНомерСтроки(ТабДок, Макет, НомерСтроки)
	Область = Макет.ПолучитьОбласть("Строка_ПараметрЗначениеТЧ|КолонкаНомерСтроки");
	Область.Параметры.НомерСтроки = НомерСтроки;
	ТабДок.Вывести(Область);	
КонецПроцедуры

Процедура ВывестиЗначениеКолонкиТЧ(ТабДок, Макет, Значение)
	
	Область = Макет.ПолучитьОбласть("Строка_ПараметрЗначениеТЧ|КолонкаПараметр");
	
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		
		ЗначениеПараметра = Значение.Получить(); 
		Если ТипЗнч(ЗначениеПараметра) = Тип("ДвоичныеДанные") Тогда
			Область = Макет.ПолучитьОбласть("Строка_ПараметрЗначениеТЧХранилище|КолонкаПараметр");
			
		Иначе
			Область = Макет.ПолучитьОбласть("Строка_ПараметрЗначениеТЧ|КолонкаПараметр");
		КонецЕсли;
		Область.Параметры.Параметр = ЗначениеПараметра;
		
	Иначе
		Область = Макет.ПолучитьОбласть("Строка_ПараметрЗначениеТЧ|КолонкаПараметр");
		Область.Параметры.Параметр = Значение;
	КонецЕсли;
	
	ТабДок.Присоединить(Область);
	
КонецПроцедуры

Процедура ВывестиПустуюСтроку(ТабДок, Макет)
	ВывестиПараметрВТабличныйДокумент(ТабДок, Макет, "Строка_ПараметрЗначение", "", "");	
КонецПроцедуры

