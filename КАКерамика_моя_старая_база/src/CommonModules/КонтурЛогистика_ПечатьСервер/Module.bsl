Функция ОписаниеУказанийГрузоотправителя(Шапка)

	Описание = Новый Структура("МршПрвз_ДатВрДостГр, ЗапрПерегруз_КлимРеж_СвПломба", "", "");	
	
	// описание Маршрута перевозки
	
	Если ЗначениеЗаполнено(Шапка.МршПрвз) Тогда
				
		Описание.МршПрвз_ДатВрДостГр = "маршрут перевозки - " + Шапка.МршПрвз;
		
	КонецЕсли;	
	
	// описание даты и времени перевозки
	
	Если ЗначениеЗаполнено(Шапка.ДатВрДостГр) Тогда 
				
		Описание.МршПрвз_ДатВрДостГр = Описание.МршПрвз_ДатВрДостГр 
										+ ?(ЗначениеЗаполнено(Описание.МршПрвз_ДатВрДостГр), "; ", "") 
										+ "дата и время доставки груза - "
										+ Шапка.ДатВрДостГр;
		
	КонецЕсли;	
	
	// описание температуры
	
	ОписаниеТемпературы = ""; 
	
	Если ЗначениеЗаполнено(Шапка.ТемпНеНиже) Тогда 
		
		ОписаниеТемпературы = "температура,°С - от " + Шапка.ТемпНеНиже;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Шапка.ТемпНеВыше) Тогда 
		
		ОписаниеТемпературы = ОписаниеТемпературы 
								+ ?(ЗначениеЗаполнено(ОписаниеТемпературы), "", "температура,°С - ")
								+ " до " + Шапка.ТемпНеВыше;
		
	КонецЕсли; 
	
	// описание влажности
	
	ОписаниеВлажности = "";
	
	Если ЗначениеЗаполнено(Шапка.ВлажнНеНиже) Тогда 
		
		ОписаниеВлажности = "влажность,%  - от " + Шапка.ВлажнНеНиже;
				
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Шапка.ВлажнНеВыше) Тогда 
				
		ОписаниеВлажности = ОписаниеВлажности 
								+ ?(ЗначениеЗаполнено(ОписаниеВлажности), "", "влажность,% - ")
								+ " до " + Шапка.ВлажнНеВыше;
		
	КонецЕсли;
	
	// сведения о пломбах
	
	ОписаниеПломбы = "";
	
	Если ЗначениеЗаполнено(Шапка.СвПломба) Тогда 
		
		ОписаниеПломбы = "сведения о пломбах - " + Шапка.СвПломба;
		
	КонецЕсли;	
	
	// описание перегрузки груза
	
	ОписаниеПерегрузки = ""; 
	
	Если Шапка.ЗапрПерегруз Тогда
		
		ОписаниеПерегрузки = "перегрузка груза запрещена"; 
		
	КонецЕсли;			
	
	// описание ЗапрПерегруз_КлимРеж_СвПломба
	
	Описание.ЗапрПерегруз_КлимРеж_СвПломба = ОписаниеТемпературы + ?(ЗначениеЗаполнено(ОписаниеТемпературы), "; ", "") 
												+ ОписаниеВлажности + ?(ЗначениеЗаполнено(ОписаниеВлажности), "; ", "")
												+ ОписаниеПломбы + ?(ЗначениеЗаполнено(ОписаниеПломбы), "; ", "")
												+ ОписаниеПерегрузки;
	
	Возврат Описание;
		
КонецФункции

Функция ОписаниеСотрудника(ДанныеСотрудников, Сотрудник, СписокПоказателей = "")
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "";
	КонецЕсли;
	
	ОписанияПоказателей = Новый Массив;
	
	Если СписокПоказателей = "" Тогда
		СписокПоказателей = "ФИО,Должность,ИНН,ОснПогрГр,ОДолжОб,ТелефонОсновной,ТелефонЗапасной,ФамилияИО";
	КонецЕсли;
	
	Показатели = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СписокПоказателей);
	
	ПараметрыОтбора = Новый Структура("Сотрудник", Сотрудник);
	НайденныйСотрудник = ДанныеСотрудников.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныйСотрудник.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ЗаполнитьОписанияПоказателей(НайденныйСотрудник[0], ОписанияПоказателей, Показатели);
	
	ОписаниеСотрудника = ОписаниеПоказателейИзМассива(ОписанияПоказателей);
	
	Возврат ОписаниеСотрудника;
	
КонецФункции

