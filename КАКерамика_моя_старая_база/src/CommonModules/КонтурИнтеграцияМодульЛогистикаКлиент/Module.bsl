Процедура ПослеЗаписи(Форма, Объект, ПараметрыЗаписи) Экспорт
	
	ОбновитьСостояниеОсновнойКоманды(Форма);
	
КонецПроцедуры

Процедура ПеревозочныеНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	ОбновитьСостояниеОсновнойКоманды(Форма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьСостояниеОсновнойКоманды(Форма)
	
	МодульКонтурИнтеграцияКлиент = КонтурЛогистика_СтдОбщегоНазначенияКлиент.ОбщийМодульЛок("КонтурИнтеграцияКлиент");
	МодульКонтурИнтеграцияКлиентСервер = КонтурЛогистика_СтдОбщегоНазначенияКлиент.ОбщийМодульЛок("КонтурИнтеграцияКлиентСервер");
	
	ДокументыУчетнойСистемы = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЗначениеВМассивеЛок(Форма.Объект.Ссылка);
	СостояниеЭПД = КонтурЛогистика_ИнтеграцияКонтурСервер.СостояниеЭПД(ДокументыУчетнойСистемы);
	
	НомерКоманды = 1;
	ОписаниеКоманды1 = МодульКонтурИнтеграцияКлиентСервер.ОписаниеКоманды("Логистика", НомерКоманды);
	ОписаниеКоманды1.Заголовок = СостояниеЭПД.Заголовок;
	
	ОписаниеКоманд = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЗначениеВМассивеЛок(ОписаниеКоманды1);
	
	МодульКонтурИнтеграцияКлиент.ОбновитьОсновныеКоманды(Форма, ОписаниеКоманд);
	
КонецПроцедуры

#КонецОбласти