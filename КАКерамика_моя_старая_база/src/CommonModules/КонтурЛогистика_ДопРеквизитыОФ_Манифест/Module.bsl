// Добавление дополнительных реквизитов:
// 1. Проверить снят ли с поддержки объект конфигурации, форма элемента и табличная часть, если реквизит добавляется в нее 
// 2. Для добавления дополнительных реквизитов нужно добавить реквизит в справочник или документ с префиксом в имени "КонтурЛогистика_". 
//	  Синоним будет отображаться на форме, как заголовок реквизита 
// 3. На форме элемента обязательно должен быть элемент вида "Панель" с наименованием "Панель" или "ОсновнаяПанель". Если есть панель с другим наименованием, то его нужно добавить
//    в массив в функцию НаименованияПанелей()
// 4. В процедуру ПриОткрытии() в форме элемента объекта, куда добавляем реквизит добавить код:
//      // КонтурЛогистика
//	    КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыОФ.ВывестиДополнительныеРеквизиты(ЭтаФорма, Ссылка);
//	    // Конец КонтурЛогистика
// 5. Если добавляемые реквизиты требуется разбить на группы, то нужно добавить описание реквизитов в манифест в процедуру ДобавитьДополнительныеРеквизиты(СписокДопРеквизитов) 
//    или создать свою процедуру (см. СписокДополнительныхРеквизитов()) 

#Область Манифест

Функция СписокДополнительныхРеквизитов() Экспорт
	
	СписокДопРеквизитов = Новый Структура;
	
	ДобавитьДополнительныеРеквизиты_РТУ(СписокДопРеквизитов); 
	ДобавитьДополнительныеРеквизиты_Склады(СписокДопРеквизитов);
	ДобавитьДополнительныеРеквизиты_ФизическиеЛица(СписокДопРеквизитов);
	
	ДобавитьДополнительныеРеквизиты(СписокДопРеквизитов);
		
	Возврат СписокДопРеквизитов;
	
КонецФункции

Процедура ДобавитьДополнительныеРеквизиты_РТУ(СписокДопРеквизитов)
	
	СписокРеквизитовОбъекта = Новый Структура;
	
	// Основные
	
	СписокРеквизитовГруппы = Новый Структура;
	
	// Номер заказа
	ОписаниеРеквизита = ОписаниеРеквизитаОбъекта();
	ОписаниеРеквизита.Заголовок = "Номер заказа:";	
	ДобавитьАвтоконвертацию(ОписаниеРеквизита, "НомЗак", "РеализацияТоваровУслуг", "ТрН_Титул1", "РеализацияТоваровУслуг");		
	СписокРеквизитовГруппы.Вставить("КонтурЛогистика_НомерЗаказа", ОписаниеРеквизита);
	
