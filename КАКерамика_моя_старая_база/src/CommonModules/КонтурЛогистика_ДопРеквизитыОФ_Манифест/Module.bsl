	СписокРеквизитовОбъекта.Вставить("Товары", ОписаниеТЧОбъекта);
	
	СписокДопРеквизитов.Вставить("РеализацияТоваровУслуг", СписокРеквизитовОбъекта);
	
КонецПроцедуры

Процедура ДобавитьДополнительныеРеквизиты_Склады(СписокДопРеквизитов)
	
	СписокРеквизитовОбъекта = Новый Структура;
	
	СписокРеквизитовГруппы = Новый Структура;
		
	ОписаниеРеквизита = ОписаниеРеквизитаОбъекта();
	ОписаниеРеквизита.Заголовок = "Собственник:";
	ДобавитьАвтоконвертацию(ОписаниеРеквизита, "Собственник", "Склады", "КонтурЛогистика_ПунктыМаршрута", "Склады");
	СписокРеквизитовГруппы.Вставить("КонтурЛогистика_Собственник", ОписаниеРеквизита);
		
	ОписаниеРеквизита = ОписаниеРеквизитаОбъекта(); 
	ОписаниеРеквизита.Заголовок = "Договор:";
	ДобавитьАвтоконвертацию(ОписаниеРеквизита, "ДоступКОбъектуДоговор", "Склады", "КонтурЛогистика_ПунктыМаршрута", "Склады");
	СписокРеквизитовГруппы.Вставить("КонтурЛогистика_СобственникДоговор", ОписаниеРеквизита);
	
	ОписаниеРеквизита = ОписаниеРеквизитаОбъекта();
	ОписаниеРеквизита.Заголовок = "Если нет договора с собственником, причина:";
	ДобавитьАвтоконвертацию(ОписаниеРеквизита, "ДоступКОбъектуТекст", "Склады", "КонтурЛогистика_ПунктыМаршрута", "Склады");
	СписокРеквизитовГруппы.Вставить("КонтурЛогистика_НетДоговораСобственникТекст", ОписаниеРеквизита);
	
	ОписаниеГруппыОбъекта = ОписаниеГруппыОбъекта();
	ОписаниеГруппыОбъекта.ЗаголовокГруппы = "Основная";
	ОписаниеГруппыОбъекта.Реквизиты = СписокРеквизитовГруппы;
	СписокРеквизитовОбъекта.Вставить("КонтурЛогистика_Основная", ОписаниеГруппыОбъекта);
	
	СписокДопРеквизитов.Вставить("Склады", СписокРеквизитовОбъекта);
	
КонецПроцедуры

Процедура ДобавитьДополнительныеРеквизиты_ФизическиеЛица(СписокДопРеквизитов)
	
	СписокРеквизитовОбъекта = Новый Структура;
	
