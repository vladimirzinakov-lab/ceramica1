Функция ОписаниеРеквизитаОбъекта() Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("Заголовок", "");       // Заголовок реквизита на форме
	Описание.Вставить("ЭтоФлажок", Ложь);	  // Признак флажка 
	Описание.Вставить("Отображать", Истина);  // Не заполнять через манифест! Используется для хранения значение из справочника настроек
	
	Описание.Вставить("СписокСвойствАвтоконвертации", Новый Массив);
	
	Возврат Описание;
	
КонецФункции

Функция ОписаниеГруппыОбъекта() Экспорт 
	
	Описание = Новый Структура;                     
	Описание.Вставить("ЗаголовокГруппы", "");       // Заголовок дополнительной закладки на форме
	Описание.Вставить("Реквизиты", "");             // Список реквизитов в иде структур ОписаниеРеквизитаОбъекта()
	Описание.Вставить("тзРазметка", Неопределено);  // Не заполнять через манифест! Используется в дальнейшем для выравнивания ЭФ
		
	Возврат Описание;
	
КонецФункции

Функция ОписаниеТЧОбъекта() Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("ЗаголовокТЧ", "");
	Описание.Вставить("ЗаголовокДляНастроек", "");
	Описание.Вставить("Реквизиты", "");
		
	Возврат Описание;
	
КонецФункции

Функция НаименованияПанелей() Экспорт

	Наименования = Новый Массив;
	Наименования.Добавить("ОсновнаяПанель");  
	Наименования.Добавить("Панель");
	Наименования.Добавить("ПанельПутевогоЛиста");
	Наименования.Добавить("Панель1");
	
	Возврат Наименования;
	
КонецФункции

Функция ОписаниеСтруктурыСвойстваАвтоконвертации()
	
	СвойстваАвтоконвертации = Новый Структура;
	СвойстваАвтоконвертации.Вставить("РеквизитСправочникаИлиДокументаЛогистика", 	"");  // название реквизита в правилах конвертации НКС или НКД
	СвойстваАвтоконвертации.Вставить("ТипОбъекта1С", 								"");  // тип объекта учетной системы в настройках конвертации
	СвойстваАвтоконвертации.Вставить("ТипОбъектаЛогистика", 						"");  // тип объекта логистики в настройках конвертации
	СвойстваАвтоконвертации.Вставить("РеквизитТитула", 								"");  // Реквизит "РеквизитТитула" в НКС
	СвойстваАвтоконвертации.Вставить("ОбъектКонфигурации", 							"");  // Имя объекта конфигурации в котором находится дополнительный реквизит
	
	Возврат СвойстваАвтоконвертации;
	
КонецФункции

Процедура ДобавитьАвтоконвертацию(ОписаниеРеквизита, ИмяРеквизитаВОбъекткМетаданных, ТипОбъекта1С, ТипОбъектаЛогистика, ИмяОбъекаКонфигурации)
	
	ОписаниеСтруктурыСвойстваАвтоконвертации = ОписаниеСтруктурыСвойстваАвтоконвертации();
	ОписаниеСтруктурыСвойстваАвтоконвертации.РеквизитСправочникаИлиДокументаЛогистика = ИмяРеквизитаВОбъекткМетаданных;
	ОписаниеСтруктурыСвойстваАвтоконвертации.ТипОбъекта1С = ТипОбъекта1С;
	
	Если Лев(ТипОбъектаЛогистика, 16) = "КонтурЛогистика_" Тогда
		ОписаниеСтруктурыСвойстваАвтоконвертации.ТипОбъектаЛогистика = ТипОбъектаЛогистика;
	Иначе
		ОписаниеСтруктурыСвойстваАвтоконвертации.ТипОбъектаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СсылкаПоИмени(ТипОбъектаЛогистика);
	КонецЕсли;
	
	ОписаниеСтруктурыСвойстваАвтоконвертации.ОбъектКонфигурации = ИмяОбъекаКонфигурации;
	
	ОписаниеРеквизита.СписокСвойствАвтоконвертации.Добавить(ОписаниеСтруктурыСвойстваАвтоконвертации);
	
КонецПроцедуры

