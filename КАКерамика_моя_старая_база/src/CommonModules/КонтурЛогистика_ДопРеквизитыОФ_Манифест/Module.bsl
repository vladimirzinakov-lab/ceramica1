	СписокРеквизитовОбъекта.Вставить("КонтурЛогистика_Основная", ОписаниеГруппыОбъекта);
	
	СписокДопРеквизитов.Вставить("ФизическиеЛица", СписокРеквизитовОбъекта);
	
КонецПроцедуры

