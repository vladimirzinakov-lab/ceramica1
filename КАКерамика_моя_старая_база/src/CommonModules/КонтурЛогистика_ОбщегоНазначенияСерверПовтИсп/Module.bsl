Функция Контур_ОпределитьКонфигурацию() Экспорт
	
	СинонимКонфигурации = Метаданные.Синоним;
	ПодробнаяИнформация = Метаданные.ПодробнаяИнформация;
	ВерсияКонфигурации	= Метаданные.Версия;
	
	ИмяКонфигурации1С = Неопределено;
	
	Если Найти(СинонимКонфигурации,"Контур.Логистика") > 0 Тогда
		
		ИмяКонфигурации1С = "КЛ";
		
	ИначеЕсли Найти(СинонимКонфигурации,"ТКПТ") > 0 Тогда
		
		ИмяКонфигурации1С = "ТКПТ";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Торговый дом 7") > 0
		  ИЛИ Найти(СинонимКонфигурации, "Торговый дом 6") > 0 Тогда
		
		ИмяКонфигурации1С = "АСТОР";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Хлебобулочное и кондитерское производство (Управление сбытом продукции)") > 0 Тогда
		
		ИмяКонфигурации1С = "ХБКП_УСП";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление производственным предприятием") > 0
		ИЛИ Найти(СинонимКонфигурации, "1С:Хлебобулочное и кондитерское производство, редакция 1.3") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление проектной организацией") > 0
		ИЛИ Найти(СинонимКонфигурации, "Ликероводочный и винный завод") > 0
		ИЛИ Найти(СинонимКонфигурации, "1С: Спиртовое производство") > 0      
		ИЛИ Найти(СинонимКонфигурации, "1С:Молокозавод") > 0
		ИЛИ Найти(СинонимКонфигурации, "Мясокомбинат, редакция 1.3") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление птицефабрикой, редакция 1.3") > 0 
		ИЛИ Найти(НРег(СинонимКонфигурации), "управление сельскохозяйственным предприятием") > 0 // схожа с УПП
		ИЛИ Найти(СинонимКонфигурации, "Комплексный учет сельскохозяйственного предприятия") > 0 
		Тогда 
		
		ИмяКонфигурации1С = "УПП";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление предприятием 2") > 0
		Или Найти(СинонимКонфигурации, "1С:ERP. Управление холдингом") > 0 Тогда
		
		Если Метаданные.Подсистемы.Найти("уатУправлениеАвтотранспортом") = Неопределено Тогда
			ИмяКонфигурации1С = "ERP";
		Иначе
			ИмяКонфигурации1С = "ERP_УАТ";
		КонецЕсли;
		
	ИначеЕсли Найти(СинонимКонфигурации, "Комплексная автоматизация 2") > 0 Тогда // Управляемая На базе той же бсп что и УТ11.2
		
		ИмяКонфигурации1С = "КА_2";
		
	ИначеЕсли  Найти(СинонимКонфигурации, "Агропромышленный комплекс 2") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление торговлей и взаимоотношениями с клиентами (CRM)") > 0 И Найти(СинонимКонфигурации, "редакция 2") > 0 Тогда 
		
		ИмяКонфигурации1С = "УФ_УТ"; 
		
	ИначеЕсли Найти(СинонимКонфигурации, "Комплексная автоматизация") > 0 Тогда
		
		ИмяКонфигурации1С = "КА";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия Универсал, редакция 3") > 0
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия, редакция 3") > 0 
		ИЛИ (Найти(СинонимКонфигурации, "Трактир") > 0 И Найти(СинонимКонфигурации, "Head") = 0 И Найти(СинонимКонфигурации, "3") > 0) //Управляемый  Трактиръ: Back-Office  3.0 на базе БП
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 3") > 0  
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия предприятия КОРП, редакция 3") > 0  
		ИЛИ Найти(СинонимКонфигурации, "Управление корпоративными финансами, редакция 3") > 0  
		ИЛИ (Найти(СинонимКонфигурации, "Общепит") > 0 И Лев(ВерсияКонфигурации, 1) >= "3")  
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия молокозавода, редакция 3") > 0 Тогда 
		
		
		ИмяКонфигурации1С = "УФ_БП"; 
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 2") > 0
		ИЛИ (Найти(СинонимКонфигурации, "Трактир") > 0 И Найти(СинонимКонфигурации, "Head") = 0) 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия") > 0 
		ИЛИ Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 1.6") > 0 
		ИЛИ (Найти(СинонимКонфигурации, "Общепит") > 0 И Лев(ВерсияКонфигурации, 1) = "2") Тогда

		ИмяКонфигурации1С = "БП";

	ИначеЕсли Найти(СинонимКонфигурации, "Управление небольшой фирмой") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление нашей фирмой") > 0 Тогда

		ИмяКонфигурации1С = "УФ_УНФ";
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации), "управление торговлей") > 0 Тогда
		
		Если Найти(СинонимКонфигурации, "10.2") > 0 Тогда

			ИмяКонфигурации1С = "УТ";
			
		ИначеЕсли Найти(СинонимКонфигурации, "10.3") > 0 Тогда
			
			ИмяКонфигурации1С = "УТ";
			
		ИначеЕсли Найти(СинонимКонфигурации, "11") > 0 
		ИЛИ Найти(ПодробнаяИнформация, "1С:Управление торговлей (11") > 0 Тогда
			
			ИмяКонфигурации1С = "УФ_УТ";
			
		КонецЕсли;
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации), "хлебобулочное и кондитерское производство") > 0 Тогда
		
		ИмяКонфигурации1С = "ХлебУСП";
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации), "розница, редакция 1.0") > 0 Тогда
		
		ИмяКонфигурации1С = "Розница";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Розница, редакция 2.2") > 0 Тогда
		 
		ИмяКонфигурации1С = "УФ_Розница";
		
	ИначеЕсли Найти(СинонимКонфигурации, "RIT:Дистрибуция") > 0 Тогда

		ИмяКонфигурации1С = "RIT";
		
	ИначеЕсли Найти(СинонимКонфигурации, "ДАЛИОН: Управление магазином") > 0 
			ИЛИ (Найти(СинонимКонфигурации, "Трактиръ") > 0 И Найти(СинонимКонфигурации, "Head") > 0) Тогда
		
		ИмяКонфигурации1С = "ДалионУМ";
		
	ИначеЕсли Найти(СинонимКонфигурации, "ДАЛИОН: ТРЕНД, редакция") > 0 Тогда
		
		ИмяКонфигурации1С = "ДалионТРЕНД";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление складом") > 0  И Найти(СинонимКонфигурации, " 3.") > 0 Тогда
		
		ИмяКонфигурации1С = "УС_3";
	
	ИначеЕсли Найти(СинонимКонфигурации,"Транспортная логистика") > 0 Тогда
		
		ИмяКонфигурации1С = "ТЛЭ";
		
	ИначеЕсли Найти(НРег(СинонимКонфигурации),"управление автотранспортом проф") > 0 Тогда
		
