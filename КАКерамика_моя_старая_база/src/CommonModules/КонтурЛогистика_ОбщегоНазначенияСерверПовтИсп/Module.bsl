Функция Контур_ОпределитьРелизКонфигурации() Экспорт
	
	РелизКонфигурации1С = "";
	
	СинонимКонфигурации = Метаданные.Синоним;
	ВерсияКонфигурации 	= Контур_РазобратьВерсиюСтрокой(Метаданные.Версия);
	
	Если Найти(СинонимКонфигурации, "Контур.Логистика") > 0 Тогда
		
		РелизКонфигурации1С = ВерсияКонфигурации;
	
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 3.0") > 0 Тогда
		
		РелизКонфигурации1С = "3.0";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия КОРП, редакция 3.0") > 0 Тогда
		
		РелизКонфигурации1С = "3.0_КОРП";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия сельскохозяйственного предприятия") > 0 Тогда
		
		РелизКонфигурации1С = "3.0_СЕЛ";
		
	ИначеЕсли Найти(СинонимКонфигурации, "Бухгалтерия предприятия, редакция 1.6") > 0 Тогда
		
		РелизКонфигурации1С = "1.6";
		
	ИначеЕсли Найти(СинонимКонфигурации, "1С: Управление торговлей алкогольной продукцией 8, редакция 11") > 0 Тогда
		
		Если ВерсияКонфигурации.Основная = 11 Тогда
			Если ВерсияКонфигурации.Младшая = 1 Тогда
				РелизКонфигурации1С = "11.1";
			ИначеЕсли ВерсияКонфигурации.Младшая >= 2 Тогда
				РелизКонфигурации1С = "11.2";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление торговлей, редакция 11") > 0 Тогда
		
		Если ВерсияКонфигурации.Основная = 11 Тогда
			Если ВерсияКонфигурации.Младшая = 0 Тогда
				РелизКонфигурации1С = "11.0";
			ИначеЕсли ВерсияКонфигурации.Младшая = 1 Тогда
				РелизКонфигурации1С = "11.1";
			ИначеЕсли ВерсияКонфигурации.Младшая >= 2 Тогда
				РелизКонфигурации1С = "11.2";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление торговлей и взаимоотношениями с клиентами") > 0 Тогда
		
		ПодробнаяИнформация = Метаданные.ПодробнаяИнформация;
		
		Если Найти(ПодробнаяИнформация, "1С:Управление торговлей (11") > 0 Тогда
			Если Найти(ПодробнаяИнформация, "1С:Управление торговлей (11.0") > 0 Тогда
				РелизКонфигурации1С = "11.0";
			ИначеЕсли Найти(ПодробнаяИнформация, "1С:Управление торговлей (11.1") > 0 Тогда
				РелизКонфигурации1С = "11.1";
			Иначе
				РелизКонфигурации1С = "11.2";
			КонецЕсли;
		КонецЕсли;  
		
	ИначеЕсли Найти(СинонимКонфигурации, "Комплексная автоматизация 2") > 0    // на базе той же БСП что и УТ11.2
		ИЛИ Найти(СинонимКонфигурации, "Управление предприятием 2") > 0    // на базе той же БСП что и УТ11.2  (Это ERP2.1)
		ИЛИ (Найти(СинонимКонфигурации, "Агропромышленный комплекс 2") > 0
				И ВерсияКонфигурации.Основная = 2
				И ВерсияКонфигурации.Младшая >= 1) Тогда     // на базе той же БСП что и УТ11
		
		РелизКонфигурации1С = "11.2";  
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление предприятием 2.0") > 0    // на базе той же БСП что и УТ11  (Это ERP2.0)
		ИЛИ Найти(СинонимКонфигурации, "Агропромышленный комплекс 2.0") > 0 Тогда  // на базе той же БСП что и УТ11
		
		РелизКонфигурации1С = "11.1";   
		
	ИначеЕсли Найти(СинонимКонфигурации, "Управление небольшой фирмой") > 0
		ИЛИ Найти(СинонимКонфигурации, "Управление нашей фирмой") > 0 Тогда
		
		Если ВерсияКонфигурации.Основная = 1 Тогда
			Если ВерсияКонфигурации.Младшая = 4 Тогда
				РелизКонфигурации1С = "1.4";
			ИначеЕсли ВерсияКонфигурации.Младшая = 5 Тогда
				РелизКонфигурации1С = "1.5";
			ИначеЕсли ВерсияКонфигурации.Младшая >= 6 Тогда
				РелизКонфигурации1С = "1.6";
			КонецЕсли;
		КонецЕсли;

 	КонецЕсли;
	
	Возврат РелизКонфигурации1С;
	
КонецФункции

Функция Контур_РазобратьВерсиюСтрокой(Версия) Экспорт
	
	СтруктураВерсия = Новый Структура;
	СтруктураВерсия.Вставить("Версия", 		"");
	СтруктураВерсия.Вставить("Основная", 	0);
	СтруктураВерсия.Вставить("Младшая", 	0);
	СтруктураВерсия.Вставить("Релиз",		0);
	СтруктураВерсия.Вставить("Сборка",	 	0);
	
	Если Не ЗначениеЗаполнено(Версия)
		ИЛИ НЕ ТипЗнч(Версия) = Тип("Строка") Тогда
		Возврат СтруктураВерсия;
	КонецЕсли;
	
	СтруктураВерсия.Версия = Версия;
	
	МассивРазрядов = Новый Массив;
	ТекРазряд = "";
	ДлинаСтроки = СтрДлина(Версия);
	
	Для Сч = 1 По ДлинаСтроки Цикл
		
		ДобавитьРазряд = Ложь;
		
		ТекСимвол = Сред(Версия, Сч, 1);
		Если ТекСимвол >= "0"
			И ТекСимвол <= "9" Тогда
			ТекРазряд = ТекРазряд + ТекСимвол;
		Иначе
			ДобавитьРазряд = Истина;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ТекРазряд)
			И (ДобавитьРазряд
			ИЛИ Сч = ДлинаСтроки) Тогда
			МассивРазрядов.Добавить(ТекРазряд);
			ТекРазряд = "";
	    КонецЕсли;
		Если МассивРазрядов.Количество() = 4 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Разряды = Новый Соответствие;
	Разряды.Вставить(1, "Основная");
	Разряды.Вставить(2, "Младшая");
	Разряды.Вставить(3, "Релиз");
	Разряды.Вставить(4, "Сборка");
	
	Сч = 0;
	Для каждого Разряд Из МассивРазрядов Цикл
		Сч = Сч + 1;
		СтруктураВерсия[Разряды[Сч]] = Число(Разряд);		
	КонецЦикла;
	
	Возврат СтруктураВерсия;
	
КонецФункции	

