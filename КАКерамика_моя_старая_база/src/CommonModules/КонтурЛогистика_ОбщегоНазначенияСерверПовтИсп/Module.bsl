// Параметры установки модулей Контура

Функция ПараметрыУстановкиМодулей() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Диадок", Новый Структура("МодульУстановлен, ЭтоУФ, ИспользоватьТиповуюПодсистему1С, НомерВерсии"));
	Результат.Вставить("EDI", Новый Структура("МодульУстановлен, НомерВерсии"));
	
	// Диадок
	// Определим УФ или ОФ
	ПланВидовХарактеристик_Свойство = КонтурЛогистика_ОбщегоНазначенияСервер.МетаданынеОбъектаПоИмени(
		"ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения");
	Если ПланВидовХарактеристик_Свойство = Неопределено Тогда
		ПланВидовХарактеристик_Свойство = КонтурЛогистика_ОбщегоНазначенияСервер.МетаданынеОбъектаПоИмени(
			"ПланВидовХарактеристик.СвойстваОбъектов");
		Если ПланВидовХарактеристик_Свойство = Неопределено Тогда
			Результат.Диадок.МодульУстановлен = Ложь;
		Иначе
			Результат.Диадок.ЭтоУФ = Ложь;
		КонецЕсли;
	Иначе
		Результат.Диадок.ЭтоУФ = Истина;
	КонецЕсли;
	
	// Определим установку ДД
	Если ПланВидовХарактеристик_Свойство <> Неопределено Тогда
		Свойство_ИспользоватьТиповуюПодсистему1С = ПланыВидовХарактеристик[ПланВидовХарактеристик_Свойство.Имя].НайтиПоНаименованию(
			"DDPro_ИспользоватьТиповуюПодсистему1С", Истина);
		Если НЕ ЗначениеЗаполнено(Свойство_ИспользоватьТиповуюПодсистему1С) Тогда
			Результат.Диадок.МодульУстановлен = Ложь;
		Иначе
			// Определим тип установки (где хранятся данные, в своих метаданных или в типовых)
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Свойство", Свойство_ИспользоватьТиповуюПодсистему1С);
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗначенияСвойствОбъектов.Значение
			|ИЗ
			|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
			|ГДЕ
			|	ЗначенияСвойствОбъектов.Свойство = &Свойство";
			
			Если Результат.Диадок.ЭтоУФ Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗначенияСвойствОбъектов", "ДополнительныеСведения");
			КонецЕсли;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Результат.Диадок.МодульУстановлен = Истина;
				Результат.Диадок.ИспользоватьТиповуюПодсистему1С = Выборка.Значение;
			Иначе
				Результат.Диадок.МодульУстановлен = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Проверим установку ДД
	Если Результат.Диадок.МодульУстановлен Тогда
		НомерВерсииДиадок = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиДД(Результат.Диадок, "СохраненнаяВерсияМодуля");
		Результат.Диадок.МодульУстановлен = ЗначениеЗаполнено(НомерВерсииДиадок);
		Результат.Диадок.НомерВерсии = НомерВерсииДиадок;
	КонецЕсли;
	
	// EDI (данные всегда хранятся в своих метаданных)
	РегистрыСведений_КонтурEDI_ДополнительныеРеквизиты = КонтурЛогистика_ОбщегоНазначенияСервер.МетаданынеОбъектаПоИмени(
		"РегистрСведений.КонтурEDI_ДополнительныеРеквизиты");
	Если РегистрыСведений_КонтурEDI_ДополнительныеРеквизиты <> Неопределено Тогда
		НомерВерсииEDI = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеОбщейНастройкиEDI("НомерВерсии");
		Результат.EDI.МодульУстановлен = ЗначениеЗаполнено(НомерВерсииEDI);
		Результат.EDI.НомерВерсии = НомерВерсииEDI;
	Иначе
		Результат.EDI.МодульУстановлен = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НоваяТаблицаКэшаИННПартнеровEDI()
	
	ТаблицаИНН = Новый ТаблицаЗначений;
	ТаблицаИНН.Колонки.Добавить("КодПартнера", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаИНН.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
	ТаблицаИНН.Колонки.Добавить("КПП", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
	ОбеспечитьИндексПоискаКэшаИННПартнеровEDI(ТаблицаИНН);
	
	Возврат ТаблицаИНН;
	
КонецФункции

// Гарантирует индекс для НайтиСтроки по паре ИНН+КПП (единственный ключ поиска в кэше).
// После ХранилищеЗначения.Получить() индексы ТЗ обычно пустые — без индекса поиск по ~10^5 строк
// идёт полным перебором.
//
Процедура ОбеспечитьИндексПоискаКэшаИННПартнеровEDI(ТаблицаИНН)
	
	ТаблицаИНН.Индексы.Очистить();
	ТаблицаИНН.Индексы.Добавить("ИНН,КПП");
	
КонецПроцедуры

Функция НайтиПартнераПоКодуПартнераКонтур(КодПартнераКонтур)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодПартнераКонтур", СокрЛП(КодПартнераКонтур));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_Партнеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_Партнеры КАК КонтурЛогистика_Партнеры
	|ГДЕ
	|	КонтурЛогистика_Партнеры.КодПартнераКонтур = &КодПартнераКонтур
	|	И НЕ КонтурЛогистика_Партнеры.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции
