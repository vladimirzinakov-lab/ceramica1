Функция ДоступныеОрганизацииБСП(ТекущийПользователь) Экспорт
	
	ДоступныеОрганизации = Новый Структура;
	ДоступныеОрганизации.Вставить("ПолныйДоступ", Истина);
	ДоступныеОрганизации.Вставить("Организации", Новый Массив);
	
	// Проверим включены или нет ограничения на уровне записей в БСП
	Попытка
		ОграничиватьДоступНаУровнеЗаписей = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
		Если Не ОграничиватьДоступНаУровнеЗаписей Тогда
			Возврат ДоступныеОрганизации;
		КонецЕсли;
	Исключение
		Возврат ДоступныеОрганизации;
	КонецПопытки;
	
	// Получим доступные организации
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ РазрешенныеОрганизации
	|ИЗ
	|	Справочник.Организации КАК Организации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_ОрганизацииДиадок.СвязанныеОбъекты КАК КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РазрешенныеОрганизации КАК РазрешенныеОрганизации
	|		ПО КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.СвязанныйОбъект = РазрешенныеОрганизации.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ОрганизацииДиадокСвязанныеОбъекты.Ссылка";
	
	Попытка
		ДоступныеОрганизации.ПолныйДоступ = Ложь;
		ДоступныеОрганизации.Организации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Исключение
		Возврат ДоступныеОрганизации;
	КонецПопытки;
	
	Возврат ДоступныеОрганизации;
	
КонецФункции

