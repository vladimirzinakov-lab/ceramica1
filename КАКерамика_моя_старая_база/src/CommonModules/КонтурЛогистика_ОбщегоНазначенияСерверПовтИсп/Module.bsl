// Функция - Получить модуль EDI Объект
// 
// Возвращаемое значение:
//   - Обработка Контур.EDI (инициализированная)
//   - Неопределено
//
Функция ПолучитьМодульEDIОбъект() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РасположениеМодуля = "";
	ПутьКМодулю        = "";  	
	
	Попытка
	
		ИнформацияЗапускаМодуля = КонтурЛогистика_ИнтеграцияКонтурСервер.EDI_ИнформацияЗапускаМодуля();
		
		РасположениеМодуля = ИнформацияЗапускаМодуля.РасположениеМодуля;
		ПутьКМодулю        = ИнформацияЗапускаМодуля.ПутьКМодулю;  	
	
	Исключение
		
		Возврат Неопределено; // вероятно нет метаданных edi - дальше делать что-то бессмысленно
		
	КонецПопытки;
	
	Если НЕ (ЗначениеЗаполнено(РасположениеМодуля) 
			И ЗначениеЗаполнено(ПутьКМодулю)) Тогда	
		
		// пробуем наши собственные настройки
		ЛогТипПодключенияEDI = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("EDI_РасположениеМодуля");
		ЛогПутьКМодулюEDI = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("EDI_ПутьКМодулю");
		
		// установить расположение модуля в зависимости от значений
		Если ЛогТипПодключенияEDI = Перечисления.КонтурЛогистика_ТипыПМ.ФайлНаДиске Тогда
			РасположениеМодуля = "Файл";
			ПутьКМодулю = ЛогПутьКМодулюEDI;
		ИначеЕсли ЛогТипПодключенияEDI = Перечисления.КонтурЛогистика_ТипыПМ.ВСправочнике  Тогда
			РасположениеМодуля = "Справочник";
			ПутьКМодулю = ЛогПутьКМодулюEDI;
		ИначеЕсли ЛогТипПодключенияEDI = Перечисления.КонтурЛогистика_ТипыПМ.ВСоставеКонфигурации Тогда
			РасположениеМодуля = "Расширение";  // или прямо в составе основной конфы
			ПутьКМодулю = "КонтурEDI";
		Иначе
			Возврат Неопределено; // отключен
		КонецЕсли;
		
	КонецЕсли;	
		
	Если НЕ (ЗначениеЗаполнено(РасположениеМодуля) 
			И ЗначениеЗаполнено(ПутьКМодулю)) Тогда	
			
		// EDI так и не нашелся, значит не подключаем
		Возврат Неопределено;
		  
	Иначе
		
		Если РасположениеМодуля = "Файл" ИЛИ РасположениеМодуля = "Справочник" Тогда
			
			Если РасположениеМодуля = "Файл" Тогда
				
				ДвоичныеДанныеОбработки = Новый ДвоичныеДанные(ПутьКМодулю); 
				АдресХранилищаОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеОбработки);
				
				ИмяФайла = КонтурЛогистика_ИнтеграцияКонтурСервер.ПроверитьПодключитьОбработкуEDI(АдресХранилищаОбработки);
				
			Иначе // РасположениеМодуля = "Справочник"    
				
				ИмяФайла = КонтурЛогистика_ИнтеграцияКонтурСервер.ПроверитьПодключитьОбработкуEDI(ПутьКМодулю);	
				
			КонецЕсли;    
			
			Если ИмяФайла <> Неопределено Тогда
				
				Попытка
					
					Попытка
						Выполнить("
						|ОбъектОписанияЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
						|ОбъектОписанияЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
						|ВнешнийМодуль = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ОбъектОписанияЗащиты);")
						
					Исключение
						
						ВнешнийМодуль = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
						//в небезопасном режиме, т.к. ПМ может содержать небезопасный код
						
					КонецПопытки;
					
					ВнешнийМодуль.ИнициализироватьПодключаемыеМодули();
					
				Исключение
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось подключить модуль EDI из файла или справочника внешних обработок - " + ОписаниеОшибки();
					Сообщение.Сообщить();
					
				КонецПопытки;
				
				// удалить временный файл
				УдалитьФайлы(ИмяФайла);
				
				Возврат ВнешнийМодуль;
				
			Иначе 
				
				Возврат Неопределено;
				
			КонецЕсли;
			
		ИначеЕсли РасположениеМодуля = "Расширение" Тогда
			
			ЛокОбработка = Обработки[ПутьКМодулю].Создать();
			ЛокОбработка.ИнициализироватьПодключаемыеМодули();

			Возврат ЛокОбработка;

		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции 

