КонецФункции

// Ищет партнера по паре ИНН+КПП грузополучателя по кэшу партнеров EDI.
// При отсутствии элемента справочника создает партнера с синхронизацией только юр. лиц
// (точки доставки не заполняются). ОрганизацииДиадок ищутся по ИНН/КПП без создания дублей.
//
// Параметры:
//  ИНН - Строка - ИНН для поиска
//  КПП - Строка - КПП для поиска (может быть пустым для ИП)
//  ОрганизацияДД - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - организация ДД (Грузополучатель) для ручного добавления в список организаций партнера
//
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_Партнеры - найденный или созданный партнер;
//                                             пустая ссылка, если пара ИНН+КПП не найдена в кэше
//
Функция EDI_ПартнерПоИННКПП(ИНН, КПП, ОрганизацияДД) Экспорт
	
	ИННПоиска = СокрЛП(ИНН);
	КПППоиска = СокрЛП(КПП);
	
	Если Не ЗначениеЗаполнено(ИННПоиска) Тогда
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;
	
	КэшИНН = EDI_КэшИННПартнеров();
	СтрокиКэша = КэшИНН.НайтиСтроки(Новый Структура("ИНН,КПП", ИННПоиска, КПППоиска));
	
	Если СтрокиКэша.Количество() = 0 Тогда
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;
	
	Для Каждого СтрокаКэша Из СтрокиКэша Цикл
		
		ПартнерСсылка = НайтиПартнераПоКодуПартнераКонтур(СтрокаКэша.КодПартнера);
		
		// Для партнера small_retail не сразу загружаем весь список организаций при оформление титула, а добавляем по одной
		Если ЗначениеЗаполнено(ПартнерСсылка) 
			И СтрокаКэша.КодПартнера = "small_retail" 
			И ЗначениеЗаполнено(ОрганизацияДД) Тогда
			НайденнаяОрганизация = ПартнерСсылка.ОрганизацииДиадок.Найти(ОрганизацияДД, "Организация");
			Если НайденнаяОрганизация = Неопределено Тогда
				ПартнерОбъект = ПартнерСсылка.ПолучитьОбъект();				
				НоваяСтрока = ПартнерОбъект.ОрганизацииДиадок.Добавить();
				НоваяСтрока.Организация = ОрганизацияДД;
				НоваяСтрока.boxId = ОрганизацияДД.ID;
				НоваяСтрока.ГП = Истина;				
				ПартнерОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПартнерСсылка) Тогда
			Возврат ПартнерСсылка;
		КонецЕсли;
		
	КонецЦикла;
	
	КодПартнера = СтрокиКэша[0].КодПартнера;
	
	Возврат КонтурЛогистика_ИнтеграцияEDI_Сервер.СоздатьПартнераПоКодуПартнераКонтурТолькоЮрЛица(КодПартнера, ОрганизацияДД);
	
КонецФункции

// Возвращает партнера по кэшу партнеров EDI (ИНН+КПП грузополучателя), если ПартнерГрузополучатель
// еще не заполнен, Грузополучатель заполнен и у него есть ИНН. Иначе - пустая ссылка (ничего не менять).
//
// Параметры:
//  ПартнерГрузополучатель - СправочникСсылка.КонтурЛогистика_Партнеры - текущий партнер
//  Грузополучатель - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - грузополучатель
//
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_Партнеры
//
Функция EDI_ПартнерПоДокументу(ПартнерГрузополучатель, Грузополучатель) Экспорт
	
	Если ЗначениеЗаполнено(ПартнерГрузополучатель)
		Или Не ЗначениеЗаполнено(Грузополучатель) Тогда
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;
	
	РеквизитыГП = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		Грузополучатель,
		"ИНН, КПП");
	
	Если Не ЗначениеЗаполнено(РеквизитыГП.ИНН) Тогда
		Возврат Справочники.КонтурЛогистика_Партнеры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат EDI_ПартнерПоИННКПП(РеквизитыГП.ИНН, РеквизитыГП.КПП, Грузополучатель);
	
КонецФункции

