Функция ПолучитьТаблицуУпаковокПоУмолчанию() Экспорт
	
	ТаблицаУпаковок = Новый ТаблицаЗначений;
	ТаблицаУпаковок.Колонки.Добавить("Наименование", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(150));
	ТаблицаУпаковок.Колонки.Добавить("Код", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(2));
	
	Макет = Справочники.КонтурЛогистика_КлассификаторУпаковок.ПолучитьМакет("ЗначенияПоУмолчанию");
	Область = Макет.ПолучитьОбласть("Упаковки");
			
	Для Сч = 1 По Область.ВысотаТаблицы Цикл
		
		НоваяУпаковка = ТаблицаУпаковок.Добавить();
		
		НоваяУпаковка.Код 			= СокрЛП(Область.ПолучитьОбласть("R" + Сч + "C1").ТекущаяОбласть.Текст);
		НоваяУпаковка.Наименование 	= СокрЛП(Область.ПолучитьОбласть("R" + Сч + "C2").ТекущаяОбласть.Текст);
		
	КонецЦикла;
		
	Возврат ТаблицаУпаковок;
	
КонецФункции

Функция ПолучитьТаблицуОписанияОпасныхГрузов() Экспорт
	
	ОписанияОпасныхГрузов = Новый ТаблицаЗначений;
	ОписанияОпасныхГрузов.Колонки.Добавить("НомерООН", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(7));
	ОписанияОпасныхГрузов.Колонки.Добавить("НадлежащееОтгрузочноеНаименование", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(1000));
	ОписанияОпасныхГрузов.Колонки.Добавить("Класс", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_КлассыОпасностиГрузов"));
	ОписанияОпасныхГрузов.Колонки.Добавить("КлассификационныйКод", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(50));
	ОписанияОпасныхГрузов.Колонки.Добавить("ГруппаУпаковки", Новый ОписаниеТипов("ПеречислениеСсылка.КонтурЛогистика_ГруппыУпаковки"));
	ОписанияОпасныхГрузов.Колонки.Добавить("ЗнакОпасности", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(50));
	ОписанияОпасныхГрузов.Колонки.Добавить("КодОграниченияТуннели", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(50));
	
	Макет = Справочники.КонтурЛогистика_ОписанияОпасныхГрузов.ПолучитьМакет("КлассификаторДОПОГ");
	Область = Макет.ПолучитьОбласть("Строки");
	
	Для Счет = 1 По Область.ВысотаТаблицы Цикл
		
		СчетСтрока = Формат(Счет, "ЧГ=");
		
		НовоеОписание = ОписанияОпасныхГрузов.Добавить();
		
		НомерСтрока = СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C1").ТекущаяОбласть.Текст);
		НовоеОписание.НомерООН = "UN " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ДополнитьСтроку_(НомерСтрока, 4, "0");
		НовоеОписание.НадлежащееОтгрузочноеНаименование = СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C2").ТекущаяОбласть.Текст);
		
		ЗначениеКласса = СтрЗаменить(СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C3").ТекущаяОбласть.Текст), ",", ".");
		НовоеОписание.Класс = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.ЗначениеИзXDTO(ЗначениеКласса);
		
		НовоеОписание.КлассификационныйКод = СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C4").ТекущаяОбласть.Текст);
		
		ГруппаУпаковкиСтрока = СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C5").ТекущаяОбласть.Текст);
		Если ГруппаУпаковкиСтрока = "-" Тогда
			НовоеОписание.ГруппаУпаковки = Перечисления.КонтурЛогистика_ГруппыУпаковки.Отсутствует;
		ИначеЕсли ГруппаУпаковкиСтрока = "I" Тогда
			НовоеОписание.ГруппаУпаковки = Перечисления.КонтурЛогистика_ГруппыУпаковки.Группа1;
		ИначеЕсли ГруппаУпаковкиСтрока = "II" Тогда
			НовоеОписание.ГруппаУпаковки = Перечисления.КонтурЛогистика_ГруппыУпаковки.Группа2;
		ИначеЕсли ГруппаУпаковкиСтрока = "III" Тогда
			НовоеОписание.ГруппаУпаковки = Перечисления.КонтурЛогистика_ГруппыУпаковки.Группа3;
		КонецЕсли;
		
		НовоеОписание.ЗнакОпасности = СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C6").ТекущаяОбласть.Текст);
		НовоеОписание.КодОграниченияТуннели = СокрЛП(Область.ПолучитьОбласть("R" + СчетСтрока + "C18").ТекущаяОбласть.Текст);
		
	КонецЦикла;
	
	Возврат ОписанияОпасныхГрузов;
	
КонецФункции

Функция ПолучитьТаблицуРегионовРФ() Экспорт
	
	ТаблицаРегионов = Новый ТаблицаЗначений;
	ТаблицаРегионов.Колонки.Добавить("Наименование", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(150));
	ТаблицаРегионов.Колонки.Добавить("Код", КонтурЛогистика_ОбщегоНазначенияСервер.ОписаниеТипаСтрока(2));
	
	Макет = ПолучитьОбщийМакет("КонтурЛогистика_КодыРегионов");
	Область = Макет.ПолучитьОбласть("Данные");
			
	Для Сч = 1 По Область.ВысотаТаблицы Цикл
		
		НоваяУпаковка = ТаблицаРегионов.Добавить();
		
		НоваяУпаковка.Код 			= СокрЛП(Область.ПолучитьОбласть("R" + Сч + "C1").ТекущаяОбласть.Текст);
		НоваяУпаковка.Наименование 	= СокрЛП(Область.ПолучитьОбласть("R" + Сч + "C2").ТекущаяОбласть.Текст);
		
	КонецЦикла;
		
	Возврат ТаблицаРегионов;
	
КонецФункции

Функция ПолучитьТекущегоПользователя1С() Экспорт
	
	Результат = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ПолучитьТекущегоПользователя1С");
	
	Если Не Результат = Неопределено Тогда
		
		Возврат Результат;
		
	Иначе
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию() = "ТКПТ" Тогда
			ТекПользователь = Неопределено;
			Выполнить ("ТекПользователь = обОпределитьТекущегоПользователя()");
			Возврат ТекПользователь;
		Иначе
			Возврат ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;

	КонецЕсли;
	
КонецФункции

