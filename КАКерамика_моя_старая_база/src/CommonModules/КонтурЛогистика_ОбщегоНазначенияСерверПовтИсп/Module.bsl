Функция ИспользоватьОтправкуВФоне(КоличествоФайлов = Неопределено) Экспорт
	
	// Если КоличествоФайлов = Неопределено значит нам не важна зависимость от количества файлов
	Если КоличествоФайлов <> Неопределено Тогда
		МинимальноеКоличество = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"Производительность_МинимальноеКоличествоДокументовДляОтправкиВФоне");
		Если КоличествоФайлов < МинимальноеКоличество
			Или МинимальноеКоличество <= 0 Тогда
			
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ФайловаяБаза = (КонтурЛогистика_ОбщегоНазначенияКлиентСервер.КонтурЛогистика_КакаяБаза() = "Файловая");
	
	ПланировщикИспользуется = КонтурЛогистика_ОбщегоНазначенияСервер.РегламентноеЗаданиеИспользуется(
		"КонтурЛогистика_ПланировщикЗапускаРоботов");
	
	КоличествоПотоков = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"Производительность_Роботы_КоличествоПотоков");
	
	Если ФайловаяБаза
		Или Не ПланировщикИспользуется
		Или КоличествоПотоков = 1 Тогда
		
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// для формирования дерева помощника

Процедура ДобавитьВложенныеРеквизиты(СтрокаРодителя, Знач КонтейнерКоллекцииРеквизитов, ТипОснования, УровнейВложенностиДереваРеквизитов)
	
	РеквизитРодитель = СтрокаРодителя.ИмяРеквизита;
	
	Попытка
		
		Если КонтейнерКоллекцииРеквизитов = Неопределено Тогда
			
			ТипТекущегоЭлемента = Метаданные.Документы[ТипОснования].Реквизиты[РеквизитРодитель].Тип.Типы()[0];
			КонтейнерКоллекцииРеквизитов = Метаданные.НайтиПоТипу(ТипТекущегоЭлемента).Реквизиты;
			
		Иначе
			
			ТипТекущегоЭлемента = КонтейнерКоллекцииРеквизитов[РеквизитРодитель].Тип.Типы()[0];
			НайденныйОбъектМетаданных = Метаданные.НайтиПоТипу(ТипТекущегоЭлемента);
			
			Если НайденныйОбъектМетаданных = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			КонтейнерКоллекцииРеквизитов = НайденныйОбъектМетаданных.Реквизиты;
			
			Для Каждого Реквизит Из КонтейнерКоллекцииРеквизитов Цикл
				
				// зацикленные ссылки - нужно защититься (например ДокументЭТРН.ТранспортноеСредство.ПрицепПоУмолчанию.ПрицепПоУмолчанию.ПрицепПоУмолчанию) 
				Если Прав(СтрокаРодителя.ПолныйПуть, СтрДлина(Реквизит.Имя)) = Реквизит.Имя 
					ИЛИ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(СтрокаРодителя.ПолныйПуть, ".").Количество() > УровнейВложенностиДереваРеквизитов Тогда 
					
					Продолжить;
					
				КонецЕсли;
				
				Строка = СтрокаРодителя.Строки.Добавить();
				Строка.ИмяРеквизита = Реквизит.Имя;
				Строка.ПолныйПуть = СтрокаРодителя.ПолныйПуть + "." + Строка.ИмяРеквизита;
				
				// вложенные
				ДобавитьВложенныеРеквизиты(Строка, КонтейнерКоллекцииРеквизитов, ТипОснования, УровнейВложенностиДереваРеквизитов);
				
			КонецЦикла;
			
		КонецЕсли;
		
	Исключение
		
		КонтейнерКоллекцииРеквизитов = Неопределено;
		
	КонецПопытки;
	
КонецПроцедуры

