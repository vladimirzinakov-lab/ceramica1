// Возвращает кэш троек КодПартнера+ИНН+КПП из регистра КонтурЛогистика_ПроизвольныеДанные.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки КодПартнера, ИНН, КПП; пустая таблица, если кэш отсутствует
//
Функция EDI_КэшИННПартнеров() Экспорт
	
	ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ИННПартнеровEDI;
	ПустаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
	ПустойРазрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияДиадок", ПустаяОрганизация);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.УстановитьПараметр("Разрез1", "");
	Запрос.УстановитьПараметр("Разрез2", ПустойРазрез2);
	Запрос.УстановитьПараметр("Разрез3", "");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ДанныеХранилище КАК ДанныеХранилище
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок = &ОрганизацияДиадок
	|	И КонтурЛогистика_ПроизвольныеДанные.ТипДанных = &ТипДанных
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез1 = &Разрез1
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &Разрез2
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез3 = &Разрез3";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат НоваяТаблицаКэшаИННПартнеровEDI();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если Не ЗначениеЗаполнено(Выборка.ДанныеХранилище) Тогда
		Возврат НоваяТаблицаКэшаИННПартнеровEDI();
	КонецЕсли;
	
	Данные = Выборка.ДанныеХранилище.Получить();
	
	Если ТипЗнч(Данные) <> Тип("ТаблицаЗначений") Тогда
		Возврат НоваяТаблицаКэшаИННПартнеровEDI();
	КонецЕсли;
	
	Если Данные.Колонки.Найти("КодПартнера") = Неопределено
		Или Данные.Колонки.Найти("ИНН") = Неопределено
		Или Данные.Колонки.Найти("КПП") = Неопределено Тогда
		Возврат НоваяТаблицаКэшаИННПартнеровEDI();
	КонецЕсли;
	
	// Индексы ТЗ после ХранилищеЗначения.Получить() обычно не восстанавливаются —
	// без индекса НайтиСтроки по ~10^5 строк будет полным перебором.
	ОбеспечитьИндексПоискаКэшаИННПартнеровEDI(Данные);
	
	Возврат Данные;
	
КонецФункции

// Возвращает правила торговой сети по коду PARTIN из кэша требований партнеров.
// Результат кэшируется на время сеанса.
//
// Параметры:
//  КодПартнераКонтур - Строка - код сети (net_code)
//
// Возвращаемое значение:
//  Структура, Неопределено - см. Справочники.КонтурЛогистика_Партнеры.ПравилаПартнера
