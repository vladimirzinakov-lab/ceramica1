Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения) Экспорт
	
	ШаблонПеречисления = "Перечисление.КонтурЛогистика_%1.%2";
	ПолноеИмя = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
					ШаблонПеречисления, 
					ИмяПеречисления, 
					ИмяЗначения);
			
	ЗначениеНастройки  = ПредопределенноеЗначение(ПолноеИмя);
	
	Возврат ЗначениеНастройки;	
	
КонецФункции

