Функция ОпределитьПровайдераПоИдентификатору(ИдентификаторУчастникаЭДО) Экспорт
	
	КодПровайдера = ВРег(Лев(СокрЛП(ИдентификаторУчастникаЭДО), 3));
	
	Если КодПровайдера = "" Тогда
		Провайдер = "Не участник обмена";
	ИначеЕсли КодПровайдера = "2BM" Тогда
		Провайдер = "Контур";
	ИначеЕсли КодПровайдера = "2AL" Тогда
		Провайдер = "Такском";
	ИначеЕсли КодПровайдера = "2AE" Тогда
		Провайдер = "Калуга Астрал";
	ИначеЕсли КодПровайдера = "2BE" Тогда
		Провайдер = "Тензор";
	ИначеЕсли КодПровайдера = "2PS" Тогда
		Провайдер = "ПЕТЕР-СЕРВИС";
	ИначеЕсли КодПровайдера = "2VO" Тогда
		Провайдер = "Эвотор ОФД";
	ИначеЕсли КодПровайдера = "2LT" Тогда
		Провайдер = "Оператор-ЦРПТ";
	ИначеЕсли КодПровайдера = "2HU" Тогда
		Провайдер = "Национальный удостоверяющий центр";
	ИначеЕсли КодПровайдера = "2BK" Тогда
		Провайдер = "СберКорус";
	ИначеЕсли КодПровайдера = "2JD" Тогда
		Провайдер = "НИИАС";
	ИначеЕсли КодПровайдера = "2AH" Тогда
		Провайдер = "ИнфоТеКС Интернет Траст";
	ИначеЕсли КодПровайдера = "2AD" Тогда
		Провайдер = "Русь — Телеком";
	ИначеЕсли КодПровайдера = "2LB" Тогда
		Провайдер = "ЭТП ГПБ";
	ИначеЕсли КодПровайдера = "2BA" Тогда
		Провайдер = "НТЦ СТЭК";
	ИначеЕсли КодПровайдера = "2HX" Тогда
		Провайдер = "Криптэкс";
	ИначеЕсли КодПровайдера = "2AK" Тогда
		Провайдер = "ТаксНет";
	ИначеЕсли КодПровайдера = "2LD" Тогда
		Провайдер = "Э-КОМ";
	ИначеЕсли КодПровайдера = "2LJ" Тогда
		Провайдер = "Финтендер — крипто";
	ИначеЕсли КодПровайдера = "2LH" Тогда
		Провайдер = "ФораПром";
	ИначеЕсли КодПровайдера = "2CI" Тогда
		Провайдер = "Гарант";
	ИначеЕсли КодПровайдера = "2LG" Тогда
		Провайдер = "Бифит ЭДО";
	ИначеЕсли КодПровайдера = "2BV" Тогда
		Провайдер = "ПНИЭИ-КрасКрипт";
	ИначеЕсли КодПровайдера = "2JM" Тогда
		Провайдер = "Сислинк";
	ИначеЕсли КодПровайдера = "2IJ" Тогда
		Провайдер = "Эдивеб";
	ИначеЕсли КодПровайдера = "2MD" Или КодПровайдера = "2MO" Тогда
		Провайдер = "Айтиком";
	ИначеЕсли КодПровайдера = "2MH" Тогда
		Провайдер = "Точка";
	ИначеЕсли КодПровайдера = "2JF" Тогда
		Провайдер = "НТСсофт";
	ИначеЕсли КодПровайдера = "2KX" Тогда
		Провайдер = "Энергетические системы и коммуникации";
	Иначе
		Провайдер = "Провайдер с кодом " + КодПровайдера;
	КонецЕсли;
	
	Если КодПровайдера <> "" И Не ПровайдерПоддерживаетЭПД(КодПровайдера) Тогда
		Провайдер = "ЭПД недоступны - " + Провайдер;
	КонецЕсли;
	
	Возврат Провайдер;
	
КонецФункции

// Признак оператора ЭДО из перечня с поддержкой ЭПД (реестр ФНС).
//
Функция ПровайдерПоддерживаетЭПД(КодПровайдера)
	
	Возврат КодПровайдера = "2AE"
		Или КодПровайдера = "2BM"
		Или КодПровайдера = "2IJ"
		Или КодПровайдера = "2AL"
		Или КодПровайдера = "2BK"
		Или КодПровайдера = "2BE"
		Или КодПровайдера = "2VO"
		Или КодПровайдера = "2LH"
		Или КодПровайдера = "2MD"
		Или КодПровайдера = "2MO"
		Или КодПровайдера = "2LT"
		Или КодПровайдера = "2MH"
		Или КодПровайдера = "2JF"
		Или КодПровайдера = "2KX"
		Или КодПровайдера = "2JD";
	
КонецФункции

Функция СписокРеквизитовОбъектаМетаданных(ИмяОбъекта, ТипОбъектаМетаданных) Экспорт
	
	СписокРеквизитов = Новый Массив;
	
	Реквизиты = Неопределено;
	
	Если ТипОбъектаМетаданных = "Справочник" Тогда
		Реквизиты = Метаданные.Справочники[ИмяОбъекта].Реквизиты;
	ИначеЕсли ТипОбъектаМетаданных = "Документ" Тогда
		Реквизиты = Метаданные.Документы[ИмяОбъекта].Реквизиты;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат СписокРеквизитов;
	КонецЕсли;
	
	Для каждого Стр Из Реквизиты Цикл
		СписокРеквизитов.Добавить(Стр.Имя);	
	КонецЦикла;
	
	Возврат СписокРеквизитов;
	
КонецФункции

Функция СписокТиповДокументаОснования(ДокСсылка) Экспорт
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокСсылка);
	
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(ТипЛогистика);
	Если ЗначениеЗаполнено(НастройкаКонвертации) И ЗначениеЗаполнено(НастройкаКонвертации.ТипДокумента1С) Тогда
		Тип = Тип("ДокументСсылка." + НастройкаКонвертации.ТипДокумента1С);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Тип) Тогда
		
		МассивТиповДокументаОснования = Новый Массив;
		МассивТиповДокументаОснования.Добавить(Тип);
		
		Возврат МассивТиповДокументаОснования;
		
	Иначе
		
		Возврат ДокСсылка.Метаданные().Реквизиты.ДокументОснование.Тип.Типы();
		
	КонецЕсли;
			
КонецФункции

