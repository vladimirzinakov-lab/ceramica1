#Область СлужебныйПрограммныйИнтерфейс

#Область КонвертацияДокументов

// Типы документов конфигурации для которых есть типовая конвертация
//
// Параметры:
//  ТипДокументаЛогистика	 - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов	 - Тип докуента Логистики.
//  СпецСценарий			 - ПеречислениеСсылка.КонтурЛогистика_СпецСценарииЗадач				 - Спец. сценарии задач.
// 
// Возвращаемое значение:
//  Массив из Строка - Имена типов документов.
//
Функция ПоддерживаемыеТипыДокументовКонфигурации1С(Знач ТипДокументаЛогистика, Знач СпецСценарий) Экспорт
	
	Возврат КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыДокументовКонфигурации1С(ТипДокументаЛогистика, СпецСценарий);
	
КонецФункции

// Контекст настройки конвертации документов с учетом типа учетного документа
//
// Параметры:
//  ТипДокументаЛогистика			 - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов	 - Тип документа Логистики.
//  ПредставлениеУчетногоДокумента	 - Строка, Тип, ДокументСсылка, Неопределено	 - Представление учетного документа.
//																					   Неопределено = любой тип.
//  СпецСценарий					 - ПеречислениеСсылка.КонтурЛогистика_СпецСценарииЗадач				 - Спец. сценарии задач.
// 
// Возвращаемое значение:
//  Структура - См. КонтурЛогистика_КонвертацияСерверПовтИсп.МанифестКонтекстаНастройкиКонвертацииДокументов
//
Функция КонтекстНастройкиКонвертацииУчетногоДокумента(Знач ТипДокументаЛогистика, Знач ПредставлениеУчетногоДокумента = Неопределено, Знач СпецСценарий = Неопределено, Знач ОбратныйМаппинг = Неопределено) Экспорт
	
	// Базовое заполнение
	Контекст = МанифестКонтекстаНастройкиКонвертацииДокументов();
	Контекст.ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	Контекст.ТипДокументаЛогистика = ТипДокументаЛогистика;
	Контекст.ТипДокумента1С = КонтурЛогистика_ОбщегоНазначенияСервер.ПредставлениеУчетногоДокументаСтрокой(
		ПредставлениеУчетногоДокумента);
	Если ПредставлениеУчетногоДокумента = Неопределено Тогда
		Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
		Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
		Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
	КонецЕсли;
	
	// Дополнения
	Контекст.ЭтоКТ2000 = ЭтоКТ2000();
	Контекст.ЕстьРегистрДокументыФизическихЛиц = ЕстьРегистрДокументыФизическихЛиц();
	
	// Заполняем типовой частью
	КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертации(Контекст);
	
	// Поиск настроек конвертации в справочнике
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
		ТипДокументаЛогистика, ПредставлениеУчетногоДокумента, СпецСценарий, ОбратныйМаппинг);
	
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		
		Контекст.ЕстьНастройкаКонвертации = Истина;
		Контекст.НастройкаКонвертации = НастройкаКонвертации;
		
		Если НастройкаКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная Тогда
			
			// Для типовой переносим, только часть реквизитов, которые пользователь может изменить интерактивно
			СвойстваТиповойНастройки = СвойстваТиповойНастройкиКонвертацииДокументовДоступныеДляРедактирования();
			Для Каждого ИмяСвойства Из СвойстваТиповойНастройки Цикл
				ТекущееЗначение = НастройкаКонвертации[ИмяСвойства];
				Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
					Контекст[ИмяСвойства] = ТекущееЗначение;
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			// Перенесем настройки
			ЗаполнитьЗначенияСвойств(Контекст, НастройкаКонвертации,, "ДополнительныеКолонки, ПроизвольныеВалидации");
			
			Для Каждого Элемент Из Контекст.ПутиРеквизитовУчетногоДокумента Цикл
				Контекст.ПутиРеквизитовУчетногоДокумента.Вставить(Элемент.Ключ, НастройкаКонвертации[Элемент.Ключ]);
			КонецЦикла;
			
		КонецЕсли;
		
		// Дополнительные колонки
		Для Каждого ТекущаяСтрока Из НастройкаКонвертации.ДополнительныеКолонки Цикл
			ОписаниеКолонки = МанифестОписанияДоплнительнойКолонки();
			ЗаполнитьЗначенияСвойств(ОписаниеКолонки, ТекущаяСтрока);
			Контекст.ДополнительныеКолонки.Добавить(ОписаниеКолонки);
		КонецЦикла;
		
		// Проставим порядковый номер
		НомерСтроки = 0;
		Для Каждого ТекущаяСтрока Из Контекст.ДополнительныеКолонки Цикл
			НомерСтроки = НомерСтроки + 1;
			ТекущаяСтрока.НомерСтроки = НомерСтроки;
		КонецЦикла;
		
		// Валидация
		Для Каждого ТекущаяСтрока Из НастройкаКонвертации.ПроизвольныеВалидации Цикл
			Если Не ТекущаяСтрока.Активна Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеВалидации = МанифестОписанияВалидации();
			ЗаполнитьЗначенияСвойств(ОписаниеВалидации, ТекущаяСтрока);
			Контекст.ПроизвольныеВалидации.Добавить(ОписаниеВалидации);
		КонецЦикла;
		
	КонецЕсли;
	
	Контекст.ЕстьКонвертация = (Контекст.ЕстьТиповаяКонвертация Или Контекст.ЕстьНастройкаКонвертации);
	
	Возврат Контекст;
	
КонецФункции

// Сценарии получения/обработки входящего черновика, для которых допустима НКД
// без ТипДокумента1С (документ без основания в учётной системе).
//
// Параметры:
//  Сценарий - ПеречислениеСсылка.КонтурЛогистика_Сценарии
//
// Возвращаемое значение:
//  Булево
//
Функция СценарийДопускаетПустойТипДокумента1С(Знач Сценарий) Экспорт
	
	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Сценарий = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика
		Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного
		Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновика_ЗагрузкаЧерновика_Обработка_ОтправкаПодписанного
		Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного;
	
КонецФункции

#КонецОбласти

#Область КонвертацияСправочников

// Поддерживаемые типы справочников конфигурации 1С
//
// Параметры:
//  ТипСправочникаЛогистика	 - Строка	 - Имя справочника логистики
// 
// Возвращаемое значение:
//  Массив - Поддерживаемые типы справочников конфигурации 1С
//
Функция ПоддерживаемыеТипыСправочниковКонфигурации1С(Знач ТипДокументаЛогистика) Экспорт
	
	Возврат КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипДокументаЛогистика);
	
КонецФункции

// Контекст настройки конвертации справочников с учетом типа учетного объекта
//
// Параметры:
//  ТипСправочникаЛогистика			 - Строка	 - Имя справочника Логистики
//  ПредставлениеУчетногоДокумента	 - Строка, Тип, ДокументСсылка, Неопределено	 - Представление учетного документа. Неопределено = любой ТипДокумента1С
//  РеквизитТитула					 - Строка	- Имя конвертируемого реквизита. Требуется для поиска настройки для конвретного реквизита.
// 
// Возвращаемое значение:
//  Структура - См. КонтурЛогистика_КонвертацияСерверПовтИсп.МанифестКонтекстаНастройкиКонвертацииСправочников
//
Функция КонтекстНастройкиКонвертацииСправочника(Знач ТипСправочникаЛогистика, Знач ПредставлениеУчетногоДокумента = Неопределено, Знач РеквизитТитула = Неопределено) Экспорт
	
	// Базовое заполнение
	Контекст = МанифестКонтекстаНастройкиКонвертацииСправочников();
	Контекст.ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	Контекст.ТипСправочникаИлиДокументаУС = ПредставлениеУчетногоДокумента;
	Контекст.ТипСправочникаЛогистика = ТипСправочникаЛогистика;
	Контекст.РеквизитТитула = РеквизитТитула;
	
	// Дополнения
	Контекст.ЭтоКТ2000 = ЭтоКТ2000();
	Контекст.ЕстьРегистрДокументыФизическихЛиц = ЕстьРегистрДокументыФизическихЛиц();
	
	// Заполняем типовой частью
	КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертацииСправочника(Контекст);
	
	// Поиск настроек конвертации в справочнике
	НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииСправочников.ПолучитьНастройкуКонвертации(
		Контекст.ТипСправочникаИлиДокументаУС, Контекст.ТипСправочникаЛогистика, РеквизитТитула);
	
	Если ЗначениеЗаполнено(НастройкаКонвертации) Тогда
		
		Если НастройкаКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная Тогда
			
			// Для типовой переносим, только часть реквизитов, которые пользователь может изменить интерактивно
			СвойстваТиповойНастройки = СвойстваТиповойНастройкиКонвертацииСправчниковДоступныеДляРедактирования();
			ЗаполнитьЗначенияСвойств(Контекст, НастройкаКонвертации, СвойстваТиповойНастройки);
			
		Иначе
			
			// Перенесем настройки
			ЗаполнитьЗначенияСвойств(Контекст, НастройкаКонвертации);
			
			Контекст.ЕстьНастройкаКонвертации = Истина;
			Контекст.НастройкаКонвертации = НастройкаКонвертации;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Контекст.ЕстьКонвертация = (Контекст.ЕстьТиповаяКонвертация Или Контекст.ЕстьНастройкаКонвертации);
	
	Возврат Контекст;
	
КонецФункции

#КонецОбласти

#Область Дополнения

// Определяем это конфигурация содержит данные для продавцов алкогольной продукции (КТ-2000)
// 
// Возвращаемое значение:
//  Булево - признак наличия необходимых методанных дополнения КТ-2000
//
Функция ЭтоКТ2000() Экспорт
	
	Возврат Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользуетсяКонвертацияКТ2000");
		
КонецФункции

// Есть регистр сведений "Документы физических лиц"
// 
// Возвращаемое значение:
//  Булево - признак наличия регистра сведений
//
Функция ЕстьРегистрДокументыФизическихЛиц() Экспорт
	
	МетаданныеРСДокументыФизическихЛиц = Метаданные.НайтиПоПолномуИмени("РегистрСведений.ДокументыФизическихЛиц");
	
	Если МетаданныеРСДокументыФизическихЛиц = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

// Поиск уже связанного объекта к логистическому объекту
//
// Параметры:
//  ВычисленноеЗначение			 - Строка, Ссылка	 - Объект для поиска в связях.
//  СпособКонвертацииЗначения	 - Перечисление.КонтурЛогистика_СпособыКонвертации	 - Способ конвертации объекта.
// 
// Возвращаемое значение:
//  СправочникСсылка - Объект логистики к которому привязано начение.
//
Функция СвязанныйОбъектЛогистики(Знач ВычисленноеЗначение, Знач СпособКонвертацииЗначения, Знач РеквизитПоискаНКС) Экспорт
	
	КонтурЛогистика_КонвертацияСервер.СвязанныйОбъектЛогистики(ВычисленноеЗначение, СпособКонвертацииЗначения, РеквизитПоискаНКС);
	
КонецФункции

// Список свойства типовой настройки конвертации доступные для редактирования пользователем
// 
// Возвращаемое значение:
//  Массив - список свойств
//
Функция СвойстваТиповойНастройкиКонвертацииДокументовДоступныеДляРедактирования() Экспорт
	
	СвойстваТиповойНастройки = Новый Массив;
	СвойстваТиповойНастройки.Добавить("Сценарий");
	СвойстваТиповойНастройки.Добавить("СценарийПоУмолчанию");
	СвойстваТиповойНастройки.Добавить("ОбязательноБезЗамечаний");
	СвойстваТиповойНастройки.Добавить("ПодписантТекущийПользователь");
	СвойстваТиповойНастройки.Добавить("ОбязательныйДокументУчетнойСистемыДляОтправки");
	СвойстваТиповойНастройки.Добавить("ВыводитьЗадачи");
	СвойстваТиповойНастройки.Добавить("ТолькоПроведенные");
	
	// Сценарии
	СвойстваТиповойНастройки.Добавить("Сценарий_ОтправлятьНеподписанный");
	СвойстваТиповойНастройки.Добавить("Сценарий_ОтправлятьПодписанный");
	СвойстваТиповойНастройки.Добавить("Сценарий_ОтправлятьВФоне");
	СвойстваТиповойНастройки.Добавить("Сценарий_ОтправлятьВСеансе");
	СвойстваТиповойНастройки.Добавить("Сценарий_РазрешитьПодписыватьПослеОтправки");
	СвойстваТиповойНастройки.Добавить("Сценарий_РазрешитьПодписыватьПолученныйЧерновик");
	
	// Документ учетной системы
	СвойстваТиповойНастройки.Добавить("ПоискОснованийКодНа1С");
	
	// Разделитель
	СвойстваТиповойНастройки.Добавить("Разделитель");
	СвойстваТиповойНастройки.Добавить("РазделительИмяРеквизита");
	СвойстваТиповойНастройки.Добавить("РазделительИмяТЧ");
	СвойстваТиповойНастройки.Добавить("РазделительКодНа1С");
	СвойстваТиповойНастройки.Добавить("РазделительУсловиеСтрокиТоваров");
	
	Возврат СвойстваТиповойНастройки;
	
КонецФункции

// Список свойства типовой настройки конвертации справочников доступные для редактирования пользователем
// 
// Возвращаемое значение:
//  Строка - список свойств
//
Функция СвойстваТиповойНастройкиКонвертацииСправчниковДоступныеДляРедактирования() Экспорт
	
	СвойстваТиповойНастройки = Новый Массив;
	СвойстваТиповойНастройки.Добавить("ОбновлятьРеквизитыИзУчетнойСистемы");
	СвойстваТиповойНастройки.Добавить("СоздаватьЭлементСправочникаУчетнойСистемы");
	
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(СвойстваТиповойНастройки, ",");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МанифестКонтекстаНастройкиКонвертацииДокументов() Экспорт
	
	Манифест = Новый Структура;
	Манифест.Вставить("ИмяКонфигурации");
	Манифест.Вставить("НастройкаКонвертации");
	Манифест.Вставить("ЕстьКонвертация", Ложь);
	Манифест.Вставить("ЕстьТиповаяКонвертация", Ложь);
	Манифест.Вставить("ЕстьНастройкаКонвертации", Ложь);
	Манифест.Вставить("ВыводитьЗадачи", Истина);
	Манифест.Вставить("Тип");
	Манифест.Вставить("ТипДокументаЛогистика");
	Манифест.Вставить("ТипДокумента1С");
	Манифест.Вставить("НаправлениеКонвертации");
	Манифест.Вставить("СценарийПоУмолчанию");
	Манифест.Вставить("Сценарий");
	Манифест.Вставить("ОбязательноБезЗамечаний", Ложь);
	Манифест.Вставить("ОбратныйМаппинг", Ложь);
	Манифест.Вставить("ПодписантТекущийПользователь", Ложь);
	Манифест.Вставить("ТолькоПроведенные", Ложь);
	Манифест.Вставить("СворачиватьТабЧастьТовары", Ложь);
	Манифест.Вставить("УсловиеГруппировкиСтрокТоваров", "");
	Манифест.Вставить("ДополнительныеИсточники", "");
	Манифест.Вставить("ДополнительныеКолонки", Новый Массив);
	Манифест.Вставить("ПроизвольныеВалидации", Новый Массив);
	
