Процедура ЗарегистрироватьМетрикуОтбораОрганизацииНаФорме(ОрганизацияОтбор) Экспорт
	
	ОрганизацииОтбора = Новый Массив;
	
	Если ЗначениеЗаполнено(ОрганизацияОтбор) Тогда
		ОрганизацииОтбора.Добавить(ОрганизацияОтбор);
	Иначе
		Для Каждого Организация Из АвторизованныеОрганизации() Цикл
			ОрганизацииОтбора.Добавить(Организация);
		КонецЦикла;
	КонецЕсли;
	
	Переменные = Новый Структура;
	Переменные.Вставить("BoxID", МассивBoxIdОрганизаций(ОрганизацииОтбора));
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		КатегорияМетрикПодписокИОплаты(),
		"Отбор по организации",
		ПредставлениеФормыПодписокИОплатыМетрики(),,,
		Переменные);
	
КонецПроцедуры

Процедура ЗарегистрироватьМетрикуРезультатаЗапросаФормыПодписокИОплаты(ОтчетСинхронизации) Экспорт
	
	Переменные = Новый Структура;
	Переменные.Вставить("Count", ОтчетСинхронизации.Всего);
	Переменные.Вставить("Time", ОтчетСинхронизации.ВремяМс);
	Переменные.Вставить("Status", СтатусМетрикиСинхронизацииПодписокИОплаты(ОтчетСинхронизации));
	
	КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(
		Переменные,
		КатегорияМетрикПодписокИОплаты(),
		"Запрос в биллинг",
		ПредставлениеФормыПодписокИОплатыМетрики());
	
	Для Каждого ОшибкаСинхронизации Из ОтчетСинхронизации.Ошибки Цикл
		ЗарегистрироватьМетрикуОшибкиЗапросаФормыПодписокИОплаты(ОшибкаСинхронизации);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗарегистрироватьМетрикуПереходаПоГиперссылкеОплаты(Расшифровка) Экспорт
	
	ДанныеСсылки = РазобратьРасшифровкуГиперссылкиОплаты(Расшифровка);
	
	Если ДанныеСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДанных = СтрокаДанныхОрганизацииДляМетрикПоBoxId(ДанныеСсылки.BoxID);
	Переменные = ПеременныеМетрикиСостоянияПодписокОрганизации(СтрокаДанных);
	МеткаСсылки = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Гиперссылка ""%1""", ДанныеСсылки.ТекстСсылки);
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		КатегорияМетрикПодписокИОплаты(),
		"Продление",
		ПредставлениеФормыПодписокИОплатыМетрики(),
		МеткаСсылки,,
		Переменные);
	
КонецПроцедуры

Процедура ЗарегистрироватьМетрикуПомощиНаФормеПодписокИОплаты() Экспорт
	
	КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
		КатегорияМетрикПодписокИОплаты(),
		"Помощь в Подписки и оплата",
		ПредставлениеФормыПодписокИОплатыМетрики());
	
КонецПроцедуры

Процедура ЗарегистрироватьМетрикуОшибкиЗапросаФормыПодписокИОплаты(ОшибкаСинхронизации)
	
	ДопИнформация = Новый Структура;
	ДопИнформация.Вставить("BoxID", ОшибкаСинхронизации.BoxId);
	
	Если ЗначениеЗаполнено(ОшибкаСинхронизации.КодСостояния) Тогда
		ДопИнформация.Вставить("Код", ОшибкаСинхронизации.КодСостояния);
	КонецЕсли;
	
	КонтурЛогистика_Метрика.ОбработатьОшибку(
		КатегорияМетрикПодписокИОплаты(),
		ОшибкаСинхронизации.ТекстОшибки,
		ОшибкаСинхронизации.Организация,
		ДопИнформация,
		ПредставлениеФормыПодписокИОплатыМетрики(),
		Ложь);
	
КонецПроцедуры

Функция СтатусМетрикиСинхронизацииПодписокИОплаты(ОтчетСинхронизации)
	
	Если ОтчетСинхронизации.Всего = 0 Тогда
		Возврат "SUCCESS";
	КонецЕсли;
	
	Если ОтчетСинхронизации.Успешно = ОтчетСинхронизации.Всего Тогда
		Возврат "SUCCESS";
	КонецЕсли;
	
	Если ОтчетСинхронизации.Ошибка = ОтчетСинхронизации.Всего Тогда
		Возврат "ERROR";
	КонецЕсли;
	
	Возврат "PART";
	
КонецФункции

Функция СтрокаДанныхОрганизацииДляМетрик(Организация)
	
	ДанныеОрганизаций = ПолучитьДанныеАвторизованныхОрганизаций(Организация);
	
	Если ДанныеОрганизаций.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеОрганизаций[0];
	
КонецФункции

Функция СтрокаДанныхОрганизацииДляМетрикПоBoxId(BoxId)
	
	Если Не ЗначениеЗаполнено(BoxId) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Организация Из АвторизованныеОрганизации() Цикл
		
		Если BoxIdОрганизации(Организация) = BoxId Тогда
			Возврат СтрокаДанныхОрганизацииДляМетрик(Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПеременныеМетрикиСостоянияПодписокОрганизации(СтрокаДанных)
	
	Переменные = Новый Соответствие;
	
	Если СтрокаДанных = Неопределено Тогда
		Возврат Переменные;
	КонецЕсли;
	
	ДанныеБиллинга = СтрокаДанных.ДанныеБиллинга;
	ЛицевойСчет = ДанныеБиллинга.ЛицевойСчет;
	Лицензия = ДанныеБиллинга.Лицензия;
	Пакет = ДанныеБиллинга.ПакетДокументов;
	
	Переменные.Вставить("BoxID", BoxIdОрганизации(СтрокаДанных.Организация));
	
	Если ЛицевойСчетПроблемный(ЛицевойСчет) Тогда
		Переменные.Вставить("Статус Л/C", "заблокирован");
	Иначе
		Переменные.Вставить("Статус Л/C", "активный");
	КонецЕсли;
	
	Если Лицензия.ЕстьЛицензия И Не Лицензия.НеДействует Тогда
		Переменные.Вставить("Лицензия 1С", "Да");
	Иначе
		Переменные.Вставить("Лицензия 1С", "Нет");
	КонецЕсли;
	
	Переменные.Вставить("Срок действия лицензии 1С", ПредставлениеДатыМетрики(Лицензия.ДатаОкончания));
	
	Если Пакет.ЕстьПакет Тогда
		Переменные.Вставить("Пакет документов", "Да");
	Иначе
		Переменные.Вставить("Пакет документов", "Нет");
	КонецЕсли;
	
	Переменные.Вставить("Остаток по пакету", Пакет.Остаток);
	Переменные.Вставить("Срок действия пакета", ПредставлениеДатыМетрики(Пакет.ДатаОкончания));
	
	Возврат Переменные;
	
КонецФункции

Функция ПредставлениеДатыМетрики(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Формат(Дата, "ДЛФ=D");
	
КонецФункции

