	Переменные.Вставить("BoxID", МассивBoxIdОрганизаций(Организации));
	
	КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(
		Переменные,
		КатегорияМетрикПодписокИОплаты(),
		"Показ баннера",
		ПредставлениеРабочегоСтолаМетрики(),
		Строка(НомерСценария));
	
КонецПроцедуры

