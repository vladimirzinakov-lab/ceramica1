	ДопИнформация.Вставить("BoxID", BoxIdОрганизации(СтрокаДанных.Организация));
	ДопИнформация.Вставить("ТекстОшибкиAPI", СтрокаДанных.ТекстОшибки);
	
	КонтурЛогистика_Метрика.ОбработатьОшибку(
		КатегорияМетрикПодписокИОплаты(),
