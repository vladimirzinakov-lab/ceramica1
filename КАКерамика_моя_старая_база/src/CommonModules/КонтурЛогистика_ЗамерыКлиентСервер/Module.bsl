КонецФункции

Процедура ПодготовитьЗамерОформленияТитула(ТипЛогистика, УчетныйДокумент, СпецСценарий, ПрогреватьКлиентскиеКэши) Экспорт
	
	КонтурЛогистика_ЗамерыСервер.ПрогретьПовтИспДляОформленияТитула(
		ТипЛогистика, УчетныйДокумент, СпецСценарий);
	
	Если ПрогреватьКлиентскиеКэши Тогда
		ПрогретьПовтИспДляОформленияТитулаНаКлиенте(ТипЛогистика);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрогретьПовтИспДляОформленияТитулаНаКлиенте(ТипЛогистика)
	
	#Если Клиент Тогда
		
		КлиентПовтИсп = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп;
		
		КлиентПовтИсп.ОпределитьКонфигурацию();
		ИспользуютсяХарактеристики = КлиентПовтИсп.ИспользуютсяХарактеристики();
		Если ИспользуютсяХарактеристики Тогда
			КлиентПовтИсп.ПустаяХарактеристика();
		КонецЕсли;
		КлиентПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия");
		КлиентПовтИсп.ЗначениеНастройки("ТребоватьНаличиеБазовыхСоответствий");
		
		ПрогретьКлиентскиеПовтИспПоТипуТитула(ТипЛогистика);
		
	#КонецЕсли
	
КонецПроцедуры

Процедура ПрогретьКлиентскиеПовтИспПоТипуТитула(ТипЛогистика)
	
	#Если Клиент Тогда
		
		КлиентПовтИсп = КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп;
		
		Если ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1") Тогда
			
			КлиентПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляТРН");
			КлиентПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто");
			КлиентПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест");
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3") Тогда
			
			КлиентПовтИсп.ЗначениеНастройки("СредняяПродолжительностьРазгрузки");
			КлиентПовтИсп.ЗначениеНастройки("Т3АвтоитогКоличествоМест");
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1") Тогда
			
			КлиентПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляЗН");
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1") Тогда
			
			КлиентПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто");
			КлиентПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест");
			
		ИначеЕсли ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1") Тогда
			
			КлиентПовтИсп.ЗначениеНастройки("ЗЗ_АвтоитогМасса");
			КлиентПовтИсп.ЗначениеНастройки("ЗЗ_АвтоитогОбъем");
			
		КонецЕсли;
		
	#КонецЕсли
	
КонецПроцедуры

Процедура ЗаполнитьПеременныеРекурсивно(ЭлементыОшибки, Переменные, ПредыдущийКлюч = "")
	
	Если ТипЗнч(ЭлементыОшибки) = Тип("Массив") Тогда
		
		Для Каждого ВложенныйЭлемент Из ЭлементыОшибки Цикл
			ЗаполнитьПеременныеРекурсивно(ВложенныйЭлемент, Переменные, ПредыдущийКлюч);
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(ЭлементыОшибки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ЭлементыОшибки Цикл
		ДобавитьПеременнуюОшибки(Элемент.Ключ, Элемент.Значение, Переменные, ПредыдущийКлюч);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПеременнуюОшибки(Ключ, Значение, Переменные, ПредыдущийКлюч)
	
	ПолныйКлюч = ПредыдущийКлюч + Ключ;
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		
		ЗаполнитьПеременныеРекурсивно(Значение, Переменные, ПолныйКлюч + "_");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		
		Для Каждого ВложенныйЭлемент Из Значение Цикл
			ЗаполнитьПеременныеРекурсивно(ВложенныйЭлемент, Переменные, ПолныйКлюч + "_");
		КонецЦикла;
		
	Иначе
		
		Если Не Переменные.Свойство(ПолныйКлюч) Тогда
			Переменные.Вставить(ПолныйКлюч, Значение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти