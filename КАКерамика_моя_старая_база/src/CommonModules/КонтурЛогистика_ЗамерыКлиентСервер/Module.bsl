#Область СлужебныйПрограммныйИнтерфейс

// Возвращает структуру описание замера длительной
//
// Параметры:
//  КлючеваяОперация - Строка	 - Имя ключевой операции
// 
// Возвращаемое значение:
//  Структура - См. НовыйОписаниеЗамера
//
Функция НачатьЗамерДлительнойОперации(КлючеваяОперация) Экспорт
	
	Если Не КонтурЛогистика_ЗамерыСервер.ИспользоватьЗамеры() Тогда
		Возврат НовыйОписаниеЗамера();
	КонецЕсли;
	
	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Результат = НовыйОписаниеЗамера();
	Результат.Категория = КлючеваяОперация;
	Результат.КлючеваяОперация = КлючеваяОперация;
	Результат.ВремяНачала = ТекущееВремя;
	Результат.ВремяПоследнегоЗамера = ТекущееВремя;
	Результат.ВложенныеЗамеры = Новый Структура;
	Результат.ДополнительныеПеременные = Новый Соответствие;
	Результат.ВремяНачалаОсновногоЗамера = ТекущееВремя;
	
	Возврат Результат;
	
КонецФункции

// Фиксирует вложенные замеры и завершает замер длительной
//
// Параметры:
//  ОписаниеЗамера			 - Структура	 - См. НовыйОписаниеЗамера
//  ИмяШага					 - Строка		 - Описание шага
//  ДополнительныеПеременные - Структура	 - Дополнительная информация добавляемая в комментарий в формате JSON
//
Процедура ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, ИмяШага = "", ДополнительныеПеременные = Неопределено) Экспорт
	
	Если Не КонтурЛогистика_ЗамерыСервер.ИспользоватьЗамеры() Или Не ЗначениеЗаполнено(ОписаниеЗамера) Тогда
		Возврат;
	КонецЕсли;
	
	ВремяНачалаЗамера  = ОписаниеЗамера.ВремяНачала;
	ИмяКлючевойОперации = ОписаниеЗамера.КлючеваяОперация;
	ВложенныеЗамеры = ОписаниеЗамера.ВложенныеЗамеры;
	
	ЕстьВложенныеЗамеры = ВложенныеЗамеры.Количество();
	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Длительность = (ТекущееВремя - ВремяНачалаЗамера) / 1000;
	
	Если ЕстьВложенныеЗамеры Тогда
		ЗафиксироватьЗамерДлительнойОперации(
			ОписаниеЗамера, ?(ПустаяСтрока(ИмяШага), "Последний_Шаг", ИмяШага), ДополнительныеПеременные);
	КонецЕсли;
	
	КоллекцияЗамеровДляЗаписи = Новый Массив;
	
	Для Каждого Замер Из ВложенныеЗамеры Цикл
		
		ДействиеЗамера = Замер.Ключ;
		ДанныеЗамера = Замер.Значение;
		ДлительностьВложенногоЗамера = ДанныеЗамера.Длительность;
		КлючеваяОперация = ИмяКлючевойОперации + "." + Замер.Ключ;
		
		ПараметрыЗамера = Новый Структура;
		ПараметрыЗамера.Вставить("Категория", ИмяКлючевойОперации);
		ПараметрыЗамера.Вставить("КлючеваяОперация", КлючеваяОперация);
		ПараметрыЗамера.Вставить("Длительность", ДанныеЗамера.Длительность);
		ПараметрыЗамера.Вставить("ДатаНачалаКлючевойОперации", ДанныеЗамера.ВремяНачала);
		ПараметрыЗамера.Вставить("ДатаОкончанияКлючевойОперации", ДанныеЗамера.ВремяОкончания);
		ПараметрыЗамера.Вставить("ДополнительныеПеременные", ДанныеЗамера.ДополнительныеПеременные);
		ПараметрыЗамера.Вставить("ВремяНачалаОсновногоЗамера", ОписаниеЗамера.ВремяНачалаОсновногоЗамера);
		ПараметрыЗамера.Вставить("ЭтоОсновнойЗамер", Ложь);
		
		КоллекцияЗамеровДляЗаписи.Добавить(ПараметрыЗамера);
		
	КонецЦикла;
	
	ПараметрыЗамера = Новый Структура;
	ПараметрыЗамера.Вставить("Категория", ИмяКлючевойОперации);
	ПараметрыЗамера.Вставить("КлючеваяОперация", ИмяКлючевойОперации);
	ПараметрыЗамера.Вставить("Длительность", Длительность);
	ПараметрыЗамера.Вставить("ДатаНачалаКлючевойОперации", ВремяНачалаЗамера);
	ПараметрыЗамера.Вставить("ДатаОкончанияКлючевойОперации", ТекущееВремя);
	ПараметрыЗамера.Вставить("ДополнительныеПеременные", ДополнительныеПеременные);
	ПараметрыЗамера.Вставить("ВремяНачалаОсновногоЗамера", ОписаниеЗамера.ВремяНачалаОсновногоЗамера);
	ПараметрыЗамера.Вставить("ЭтоОсновнойЗамер", Истина);
	
	КоллекцияЗамеровДляЗаписи.Добавить(ПараметрыЗамера);
	
	КонтурЛогистика_ЗамерыСервер.ЗаписатьЗамерыДлительнойОперации(КоллекцияЗамеровДляЗаписи);
	
КонецПроцедуры

// Вспомогательная, используется в ЗакончитьЗамерДлительнойОперации. Вкладывает шаг замера в описание замера
//
// Параметры:
//  ОписаниеЗамера			 - Структура	 - См. НовыйОписаниеЗамера
//  ИмяШага					 - Строка		 - Описание шага
//  ДополнительныеПеременные - Структура	 - Дополнительная информация добавляемая в комментарий в формате JSON
//
Процедура ЗафиксироватьЗамерДлительнойОперации(ОписаниеЗамера, ИмяШага, ДополнительныеПеременные = Неопределено) Экспорт
	
	Если Не КонтурЛогистика_ЗамерыСервер.ИспользоватьЗамеры() Или Не ЗначениеЗаполнено(ОписаниеЗамера) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Длительность = (ТекущееВремя - ОписаниеЗамера.ВремяПоследнегоЗамера) / 1000;
	
	ШагВложенногоЗамера = Новый Структура;
	ШагВложенногоЗамера.Вставить("ВремяНачала", ОписаниеЗамера.ВремяПоследнегоЗамера);
	ШагВложенногоЗамера.Вставить("ВремяОкончания", ТекущееВремя);
	ШагВложенногоЗамера.Вставить("Длительность", Длительность);
	ШагВложенногоЗамера.Вставить("ДополнительныеПеременные", ДополнительныеПеременные);
	ШагВложенногоЗамера.Вставить("ВремяНачалаОсновногоЗамера", ОписаниеЗамера.ВремяНачалаОсновногоЗамера);
	
	КоллекцияВложенныхЗамеров = ОписаниеЗамера.ВложенныеЗамеры;
	КоллекцияВложенныхЗамеров.Вставить(ИмяШага, ШагВложенногоЗамера);
	
	ОписаниеЗамера.Вставить("ВремяПоследнегоЗамера", ТекущееВремя);
	
КонецПроцедуры

#Область ЗамерыВремениРаботыСТитулом

Функция НачатьЗамерВремениОформленияПользователем(Знач ТипЛогистика, Знач УчетныйДокумент = Неопределено, Знач СпецСценарий = Неопределено) Экспорт
	
	ПодготовитьЗамерОформленияТитула(ТипЛогистика, УчетныйДокумент, СпецСценарий, Истина);
	
	Возврат НовыйЗамерВремениРаботыСТитулом(
		КлючеваяОперацияОформлениеТитулаПользователем(),
		ТипЛогистика);	
	
КонецФункции

Функция НачатьЗамерВремениОформленияПакетного(Знач ТипЛогистика, Знач УчетныйДокумент = Неопределено, Знач СпецСценарий = Неопределено) Экспорт
	
	ПодготовитьЗамерОформленияТитула(ТипЛогистика, УчетныйДокумент, СпецСценарий, Ложь);
	
	Возврат НовыйЗамерВремениРаботыСТитулом(
		КлючеваяОперацияОформлениеТитулаПакетное(),
		ТипЛогистика);	
	
КонецФункции

Функция НачатьЗамерВремениУстраненияОшибокВалидации(Знач ТаблицаОшибок, Знач Ссылка, Знач ТребуемоеДействие) Экспорт
	
	ЗамерВремениУстраненияОшибок = Неопределено;
	
	Если ТребуемоеДействие = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик") Тогда
		Возврат ЗамерВремениУстраненияОшибок;
	КонецЕсли;
	
	ОтборОшибки = Новый Структура("КатегорияОшибки", ПредопределенноеЗначение("Перечисление.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка"));
	ВсеОшибки = ТаблицаОшибок.НайтиСтроки(ОтборОшибки);
	
	Если ВсеОшибки.Количество() = 0 И Ссылка.Пустая() Тогда
		
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Ссылка);
		ЗамерВремениУстраненияОшибок = НовыйЗамерВремениРаботыСТитулом(
			КлючеваяОперацияУстранениеОшибокВалидации(),
			ТипЛогистика);
		ЗарегистрироватьВремяРаботыСТитулом(ЗамерВремениУстраненияОшибок, Истина);
		ЗамерВремениУстраненияОшибок = Неопределено;
		
	ИначеЕсли ВсеОшибки.Количество() > 0 Тогда
		
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Ссылка);
		ЗамерВремениУстраненияОшибок = НовыйЗамерВремениРаботыСТитулом(
			КлючеваяОперацияУстранениеОшибокВалидации(),
			ТипЛогистика);
		
	Иначе
		ЗамерВремениУстраненияОшибок = Неопределено; // записанный без ошибок — метрику не пишем
	КонецЕсли;
	
	Возврат ЗамерВремениУстраненияОшибок;
	
КонецФункции

Процедура ОбработатьЗамерВремениУстраненияОшибокВалидации(Замер, Знач КоличествоОшибок) Экспорт
	
	Если Замер <> Неопределено И КоличествоОшибок = 0 Тогда
		ЗарегистрироватьВремяРаботыСТитулом(Замер);
	КонецЕсли;
	
КонецПроцедуры
	
Функция НачатьЗамерВремениОтправкиТитула(Знач Ссылка) Экспорт
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Ссылка);
	
	Возврат НовыйЗамерВремениРаботыСТитулом(
		КлючеваяОперацияОтправкаТитула(),
		ТипЛогистика);	
	
КонецФункции

Процедура ОбработатьЗамерВремениНеуспешнойОтправки(Замер, Знач КодСостояния, Знач ТелоОтвета) Экспорт
	
	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Переменные = Новый Структура;
	Переменные.Вставить("statusCode", КодСостояния);
	
	Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		
		Попытка
			РазобранноеТело = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(ТелоОтвета);
		Исключение
			РазобранноеТело = Неопределено;
		КонецПопытки;
		
		Если РазобранноеТело <> Неопределено Тогда
			ЗаполнитьПеременныеРекурсивно(РазобранноеТело, Переменные);
		КонецЕсли;
		
	КонецЕсли;
	
	Замер.ДополнительныеПеременные.Вставить("Переменные", Переменные);
	Замер.КлючеваяОперация = КлючеваяОперацияОтправкаТитулаНеуспешная();
	
	ЗарегистрироватьВремяРаботыСТитулом(Замер);
	
КонецПроцедуры

Процедура ЗарегистрироватьВремяРаботыСТитулом(Знач Замер, НулевойЗамер = Ложь) Экспорт 
	
	Если Замер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Замер.ДополнительныеПеременные.Свойство("Переменные") Тогда
		Переменные = Замер.ДополнительныеПеременные.Переменные;
	Иначе
		Переменные = Неопределено;
	КонецЕсли;
	
	ДлительностьМс = ?(НулевойЗамер, 0, ТекущееВремя - Замер.ВремяНачала);
	
	// Label передаём строкой: ЗначениеЗаполнено(0) = Ложь, нулевая длительность должна попадать в Path_Label
	КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(
		Переменные,
		Замер.Категория,
		Замер.КлючеваяОперация,
		КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьИмяСсылкиПоТипуЛогистики(Замер.ДополнительныеПеременные.ТипЛогистика),
		Формат(ДлительностьМс, "ЧН=0; ЧГ=0"));
		
КонецПроцедуры
	
Функция КлючевыеОперацииТранспорта() Экспорт
	
	КлючевыеОперации = Новый Массив;
	КлючевыеОперации.Добавить(КлючеваяОперацияОтправкаТитула());
	КлючевыеОперации.Добавить(КлючеваяОперацияОтправкаТитулаНеуспешная());
	
	Возврат КлючевыеОперации;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОписаниеЗамера()
	
	Результат = Новый Структура;
	Результат.Вставить("Категория");
	Результат.Вставить("КлючеваяОперация");
	Результат.Вставить("ВремяНачала");
	Результат.Вставить("ВремяПоследнегоЗамера");
	Результат.Вставить("ВложенныеЗамеры");
	Результат.Вставить("ДополнительныеПеременные");
	Результат.Вставить("ВремяНачалаОсновногоЗамера");
	
	Возврат Результат;
	
КонецФункции

Функция НовыйЗамерВремениРаботыСТитулом(КлючеваяОперация, ТипЛогистика)
	
	Замер = НовыйОписаниеЗамера();		
	Замер.Категория = КатегорияВремяРаботыСТитулом();
	Замер.КлючеваяОперация = КлючеваяОперация;
	Замер.ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Замер.ДополнительныеПеременные = Новый Структура("ТипЛогистика", ТипЛогистика);
	
	Возврат Замер;	
	
КонецФункции

Функция КатегорияВремяРаботыСТитулом()
	Возврат "Время работы с титулом";	
КонецФункции

Функция КлючеваяОперацияОформлениеТитулаПользователем()
	Возврат "Оформление титула интерактивное";	
КонецФункции

Функция КлючеваяОперацияОформлениеТитулаПакетное()
	Возврат "Оформление титула пакетное";	
КонецФункции

Функция КлючеваяОперацияУстранениеОшибокВалидации()
	Возврат "Устранение ошибок валидации";	
КонецФункции

Функция КлючеваяОперацияОтправкаТитула()
	Возврат "Отправка титула";	
КонецФункции

