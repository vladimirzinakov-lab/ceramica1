#Область СлужебныйПрограммныйИнтерфейс

#Область КонвертацияДокументов

// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыДокументовКонфигурации1С
//
Функция ПоддерживаемыеТипыДокументовКонфигурации1С(ТипДокументаЛогистика, СпецСценарий) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокументаЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
		ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ПутевойЛист");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипДокументаЛогистика) Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
		ТипыДокументовКонфигурации1С.Добавить("ПеремещениеТоваров");
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертации
//
Процедура ЗаполнитьБазовыеНастройкиКонвертации(Контекст) Экспорт
	
	Если (Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1) Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			
		ИначеЕсли Контекст.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			ЗаполнитьПутиРеквизитов_РеализацияТоваровУслуг(Контекст);
			
		ИначеЕсли Контекст.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			ЗаполнитьПутиРеквизитов_ПеремещениеТоваров(Контекст);
			
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			
		ИначеЕсли Контекст.ТипДокумента1С = "ПутевойЛист" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;

			Если Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
				Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;				
			Иначе
				Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.НеПодписыватьОтправитьВСеансе;
			КонецЕсли;
			
			ЗаполнитьПутиРеквизитов_ПутевойЛист(Контекст);
					
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда	
		
		Если Контекст.ТипДокумента1С = Неопределено Тогда
			
			// Если отбор = Неопределено, то подразумеваем, что есть какая то настройка для документа
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
						
		ИначеЕсли Контекст.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			Контекст.ДокументыОснованияВложенныхДокументов.ПутьРеквизитДокументОснования = "Ссылка";
			
			ЗаполнитьПутиРеквизитов_РеализацияТоваровУслуг(Контекст);
			
		ИначеЕсли Контекст.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
			Контекст.ДокументыОснованияВложенныхДокументов.РассчитыватьВложенныеОснования = Истина;
			Контекст.ДокументыОснованияВложенныхДокументов.ПутьРеквизитДокументОснования = "Ссылка";
			
			ЗаполнитьПутиРеквизитов_ПеремещениеТоваров(Контекст);
					
		КонецЕсли;
		
	ИначеЕсли Контекст.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
		
		Если Контекст.ТипДокумента1С = Неопределено
			Или Контекст.ТипДокумента1С = "РеализацияТоваровУслуг"
			Или Контекст.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Контекст.ЕстьТиповаяКонвертация = Истина;
			Контекст.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
			Контекст.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
			Контекст.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.НайтиГлавныйДокументПоДокументуУчетнойСистемы
//
Функция НайтиГлавныйДокументПоДокументуУчетнойСистемы(ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект) Экспорт
	
	ГлавныйДокумент = Неопределено;
	
	Если КонтекстНастройкиКонвертации.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ?(Не ЗначениеЗаполнено(ДокументОснование.Грузоотправитель),
			ДокументОснование.Организация, ДокументОснование.Грузоотправитель);
			
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ПеремещениеТоваров" Тогда
		
		НомерДокумента = ДокументОснование.Номер;
		ДатаДокумента = ДокументОснование.Дата;
		Грузоотправитель = ДокументОснование.Организация;
		
	Иначе
		
		НомерДокумента = Неопределено;
		ДатаДокумента = Неопределено;
		Грузоотправитель = Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Грузоотправитель", Грузоотправитель);
		Запрос.УстановитьПараметр("НомерТрН", НомерДокумента);
		Запрос.УстановитьПараметр("ДатаТрН", ДатаДокумента);
		Запрос.УстановитьПараметр("Разделитель", Разделитель);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		|ГДЕ
		|	(КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = &Грузоотправитель
		|			ИЛИ &Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)
		|			ИЛИ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка))
		|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН = &НомерТрН
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН = &ДатаТрН
		|			ИЛИ &ДатаТрН = ДАТАВРЕМЯ(1, 1, 1))
		|	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Разделитель = &Разделитель
		|			ИЛИ &Разделитель = НЕОПРЕДЕЛЕНО)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ГлавныйДокумент = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
		
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
	
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			ЗаполнитьГлавныйДокумент_РеализацияТоваровУслуг(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьГлавныйДокумент_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
			
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_РеализацияТоваровУслуг(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда	
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы
//
Процедура ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные) Экспорт
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	ТипДокумента1С = КонтекстНастройкиКонвертации.ТипДокумента1С;
	
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
			ЗаполнитьДокументТитул_ТрН_Титул1_РеализацияТоваровУслуг(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьДокументТитул_ТрН_Титул1_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		КонецЕсли;
		
	ИначеЕсли (ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02)
		И ТипДокумента1С = "ПутевойЛист" Тогда
		
		ЗаполнитьДокументТитул_ПЛ_Титул1_ПутевойЛист(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
			ДокументОбъект.ДатВрОдометр = ТекущаяДатаСеанса();
		Иначе
			ДокументОбъект.ДатВрВыпНаЛин = ТекущаяДатаСеанса();
		КонецЕсли;
		
		Титул1 = ДокументОбъект.Титул1;
		Если ЗначениеЗаполнено(Титул1)
			И ЗначениеЗаполнено(Титул1.ДокументОснование)
			И Титул1.ДокументОснование.Маршрут.Количество() > 0 Тогда
			
			ПервыйЭтапМаршрута = ДокументОбъект.Титул1.ДокументОснование.Маршрут[0];
			ДокументОбъект.ПоказанияОдометра = ПервыйЭтапМаршрута.ПоказаниеОдометраДо;
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
		
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
			ДокументОбъект.ДатВрОдометр = ТекущаяДатаСеанса();
		Иначе
			ДокументОбъект.ДтВрВозвр = ТекущаяДатаСеанса();
		КонецЕсли;
		
		Титул1 = ДокументОбъект.Титул1;
		Если ЗначениеЗаполнено(Титул1)
			И ЗначениеЗаполнено(Титул1.ДокументОснование)
			И Титул1.ДокументОснование.Маршрут.Количество() > 0 Тогда
			
			НомерПоследнегоЭтапа = Титул1.ДокументОснование.Маршрут.Количество() - 1;
			ПоследнийЭтапМаршрута = Титул1.ДокументОснование.Маршрут[НомерПоследнегоЭтапа];
			ДокументОбъект.ПоказанияОдометра = ПоследнийЭтапМаршрута.ПоказаниеОдометраПосле;
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда 
		
			ЗаполнитьДокументТитул_ЗЗ_Титул1_РеализацияТоваровУслуг(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьДокументТитул_ЗЗ_Титул1_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
				
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_РеализацияТоваровУслуг(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьГлавныйДокумент_ПЭ_Титул1_ПеремещениеТоваров(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
				
		Если ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
			
			ЗаполнитьДокумент_ПЭ_ЗаявкаНаМаршрут_РеализацияТоваровУслуг(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);	
			
		ИначеЕсли ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			ЗаполнитьДокумент_ПЭ_ЗаявкаНаМаршрут_ПеремещениеТоваров(
				ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыДокументаОснования
//
Функция ВычислитьРеквизитыДокументаОснования(ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", РассчитатьГО_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", ДокументОснование.Перевозчик);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузополучатель", РассчитатьГП_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ДокументОснование.РегистрационныйЗнакАвтомобиля);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.Склад);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.АдресДоставки);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Водитель") <> Неопределено
				И ЗначениеЗаполнено(ДокументОснование.Водитель) Тогда
				ФизЛицо = Справочники.ФизическиеЛица.НайтиПоНаименованию(ДокументОснование.Водитель, Истина);
				ЗначенияРеквизитов.Вставить("Водитель", ФизЛицо);
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузополучатель", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.СкладОтправитель);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.СкладПолучатель);
			КонецЕсли;
						
		КонецЕсли;
		
	ИначеЕсли (КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02) Тогда
			
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "ПутевойЛист" Тогда
		
			Если ИменаРеквизитов.Найти("ЛицоОформившееПЛ") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ЛицоОформившееПЛ", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Водитель", ДокументОснование.ФизЛицо);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ДокументОснование.ТранспортноеСредство);
			КонецЕсли;
			
			Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
				Если ИменаРеквизитов.Найти("МестоОтправления") <> Неопределено Тогда
					ЗначенияРеквизитов.Вставить("МестоОтправления", ДокументОснование.Маршрут[0].ПунктОтправления);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
			Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Перевозчик", ДокументОснование.Перевозчик);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", РассчитатьГО_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ПунктПод") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ПунктПод", ДокументОснование.Склад);
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("ПунктПод") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ПунктПод", ДокументОснование.СкладОтправитель);
			КонецЕсли;
		
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		Если КонтекстНастройкиКонвертации.ТипДокумента1С = "РеализацияТоваровУслуг" Тогда
		
			Если ИменаРеквизитов.Найти("ДогТрЭксп") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("ДогТрЭксп", ДокументОснование.ДоговорКонтрагента);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("СвКлт") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвКлт", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("СвЭксп") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвЭксп", ДокументОснование.Перевозчик);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("СвГО") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвГО", РассчитатьГО_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("СвГП") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвГП", РассчитатьГП_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("АдрГруз") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("АдрГруз", ДокументОснование.Склад);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("АдрПунктНазн") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("АдрПунктНазн", ДокументОснование.АдресДоставки);
			КонецЕсли;
		
		ИначеЕсли КонтекстНастройкиКонвертации.ТипДокумента1С = "ПеремещениеТоваров" Тогда
			
			Если ИменаРеквизитов.Найти("СвКлт") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвКлт", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("СвГО") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвГО", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("СвГП") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвГП", ДокументОснование.Организация);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("АдрГруз") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("АдрГруз", ДокументОснование.СкладОтправитель);
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("АдрПунктНазн") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("АдрПунктНазн", ДокументОснование.СкладПолучатель);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

#КонецОбласти

#Область КонвертацияСправочников

// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыСправочниковКонфигурации1С
//
Функция ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочникаЛогистика) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ФизическиеЛица");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("Контрагенты");
		ТипыДокументовКонфигурации1С.Добавить("Организации");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
		ТипыДокументовКонфигурации1С.Добавить("Склады");
		ТипыДокументовКонфигурации1С.Добавить("ПутевойЛист");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("РеализацияТоваровУслуг");
		ТипыДокументовКонфигурации1С.Добавить("ТранспортныеСредства");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_Договоры" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("ДоговорыКонтрагентов");
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертацииСправочника
//
Процедура ЗаполнитьБазовыеНастройкиКонвертацииСправочника(КонтекстНастройкиКонвертации) Экспорт
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Склады"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ПутевойЛист"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортныеСредства"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ДоговорыКонтрагентов") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту
//
Процедура ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(КонтекстНастройкиКонвертации, Параметры, Результат) Экспорт
	
	УчетныйОбъект = Параметры.УчетныйОбъект;
	
	// Могуть быть незаполненными!
	ДокументОснование = Параметры.ДокументОснование;  // От заполненности этого параметра зависит заполненность РеквизитаТитула!
	ДокументОбъект = Параметры.ДокументОбъект;
	Переменные = Параметры.Переменные;
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица" Тогда
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Попытка
				Если ЗначениеЗаполнено(ДокументОснование.Водитель) Тогда
					ФизЛицо = Справочники.ФизическиеЛица.НайтиПоНаименованию(ДокументОснование.Водитель, Истина);
				КонецЕсли;
			Исключение
				ФизЛицо = Неопределено;
			КонецПопытки;
		Иначе
			ФизЛицо = Неопределено;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ФизЛицо)
			И ТипЗнч(УчетныйОбъект) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			
			ФизЛицо = УчетныйОбъект;
		КонецЕсли;
		
		ДанныеВУ = Новый Структура;
		ДанныеВУ.Вставить("Серия", "");
		ДанныеВУ.Вставить("Номер", "");
		ДанныеВУ.Вставить("ДатаВыдачи", Дата(1, 1, 1, 0, 0, 0));
		
		Если ЗначениеЗаполнено(ФизЛицо) Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДатаСреза", ?(ЗначениеЗаполнено(ДокументОснование), ДокументОснование.Дата, ТекущаяДата()));
			Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ДокументыФизическихЛиц.Серия КАК Серия,
			|	ДокументыФизическихЛиц.Номер КАК Номер,
			|	ДокументыФизическихЛиц.ДатаВыдачи КАК ДатаВыдачи
			|ИЗ
			|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
			|			&ДатаСреза,
			|			Физлицо = &ФизЛицо
			|				И ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)) КАК ДокументыФизическихЛиц";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда 
				ЗаполнитьЗначенияСвойств(ДанныеВУ, Выборка);
			КонецЕсли;
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"РольВодитель", Истина, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУСерия", ДанныеВУ.Серия, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУНомер", ДанныеВУ.Номер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУДатаВыдачи", ДанныеВУ.ДатаВыдачи, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаРождения", УчетныйОбъект.ДатаРождения, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Имя", УчетныйОбъект.Имя, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Фамилия", УчетныйОбъект.Фамилия, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Отчество", УчетныйОбъект.Отчество, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
		
		ТелефонОсновной = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
			УчетныйОбъект, "МобильныйТелефон");
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ТелефонОсновной", ТелефонОсновной, ОбновлятьРеквизиты);
		
		АдресМестаЖительства = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
			УчетныйОбъект, "АдресМестаПроживания");
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресМестаЖительства", АдресМестаЖительства, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"АдресМестаЖительстваСтрана", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"КПП", УчетныйОбъект.КПП, ОбновлятьРеквизиты);
			
			ТелефонОсновной = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
				УчетныйОбъект, "Телефон");
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ТелефонОсновной", ТелефонОсновной, ОбновлятьРеквизиты);
			
			Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации" Тогда
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"ОГРН", УчетныйОбъект.РегистрационныйНомер, ОбновлятьРеквизиты);
				АдресСтрока = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
					УчетныйОбъект, "ФактическийАдрес");
			Иначе
				АдресСтрока = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
					УчетныйОбъект, "ЮридическийАдрес");
			КонецЕсли;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресСтрока", АдресСтрока, ОбновлятьРеквизиты);
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг" Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"АдресИнфАдрес", ДокументОснование.АдресДоставки, ОбновлятьРеквизиты);
			КонецЕсли;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Прибытие", Истина, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наш", Истина, ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Склады" Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				
				Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ДокументОснование.Организация, "Грузоотправитель",
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
						"Собственник", Собственник, ОбновлятьРеквизиты);
				
				Если КонтекстНастройкиКонвертации.РеквизитТитула = "МестоПогрузки" Тогда
					Направление = "Отправление";
				Иначе
					Направление = "Прибытие";
				КонецЕсли;
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					Направление, Истина, ОбновлятьРеквизиты);
				
			КонецЕсли;	
							
			АдресИнфАдрес = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьКонтактнуюИнформациюРеквизитаДокумента(
				УчетныйОбъект, "Адрес");
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфАдрес", АдресИнфАдрес, ОбновлятьРеквизиты);
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наш", Истина, ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ПутевойЛист" Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"АдресИнфАдрес", ДокументОснование, ОбновлятьРеквизиты);
			КонецЕсли;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфАдрес", УчетныйОбъект, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Прибытие", Истина, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наш", Истина, ОбновлятьРеквизиты);
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоПрицеп = (КонтекстНастройкиКонвертации.РеквизитТитула = "Прицеп");
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "РеализацияТоваровУслуг" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВидВладения", Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1, ОбновлятьРеквизиты);
			
			Если ЭтоПрицеп Тогда
				МаркаТС = ДокументОснование.МаркаПрицепа;
				РегНомер = ДокументОснование.РегистрационныйЗнакПрицепа;
			Иначе
				МаркаТС = ДокументОснование.МаркаАвтомобиля;
				РегНомер = ДокументОснование.РегистрационныйЗнакАвтомобиля;
			КонецЕсли;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МаркаТС", МаркаТС, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"РегНомер", РегНомер, ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ТранспортныеСредства" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МаркаТС", УчетныйОбъект.Марка, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МодельТС", УчетныйОбъект.Марка, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"РегНомер", УчетныйОбъект.РегистрационныйЗнак, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АрендодательЛизингодатель", УчетныйОбъект.Собственник, ОбновлятьРеквизиты);
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ВидВладения", Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1, ОбновлятьРеквизиты);
			
			Если ЭтоПрицеп Тогда
				МаркаТС  = ДокументОснование.МаркаПрицепа;
				РегНомер = ДокументОснование.РегистрационныйЗнакПрицепа;
				ТипТС	 = "Прицеп";
			Иначе
				МаркаТС  = ДокументОснование.МаркаАвтомобиля;
				РегНомер = ДокументОснование.РегистрационныйЗнакАвтомобиля;
				ТипТС	 = "Грузовой";
			КонецЕсли;
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"МаркаТС", МаркаТС, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"РегНомер", РегНомер, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ЭтоПрицеп", ЭтоПрицеп, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ТипТС", ТипТС, ОбновлятьРеквизиты);
				
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ДоговорыКонтрагентов" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаДокумента", УчетныйОбъект.Дата, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Контрагент", УчетныйОбъект.Владелец, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КонтрагентИНН", УчетныйОбъект.Владелец.ИНН, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"НомерДокумента", УчетныйОбъект.Номер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Организация", УчетныйОбъект.Организация, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ОрганизацияИНН", УчетныйОбъект.Организация.ИНН, ОбновлятьРеквизиты);
		
	КонецЕсли;
	
КонецПроцедуры

