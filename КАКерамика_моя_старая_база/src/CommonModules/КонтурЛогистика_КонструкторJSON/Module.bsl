#Область СборкаXDTO

Функция СформироватьСодИнфСобИзJSON(ДанныеJSON, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	ИнформацияОРейсе = ЗначениеПоля(ДанныеJSON, "tripInfo");
	
	XDTO_СодИнфСоб = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб", ТипДокументооборота, Формат);
	
	ОбязателенМедосмотрПосле = ЗначениеПоля(ИнформацияОРейсе, "isPostTripDriverCheckupRequired", Ложь);
	КС.XDTO_Установить(XDTO_СодИнфСоб, "ОбМедОсмПосле", ?(ОбязателенМедосмотрПосле = Истина, "1", "2"));
	
	ВидПрв = ВидПеревозкиВЗначениеXDTO(ЗначениеПоля(ИнформацияОРейсе, "transportationType"));
	КС.XDTO_Установить(XDTO_СодИнфСоб, "ВидПрв", ВидПрв);
	
	Если ВидПрв = "КП" Тогда
		КС.XDTO_Установить(XDTO_СодИнфСоб, "ВидКП",
			ВидКоммерческойПеревозкиВЗначениеXDTO(ЗначениеПоля(ИнформацияОРейсе, "commercialTransportationType")));
	КонецЕсли;
	
	ВидыСообщений = ЗначениеПоля(ИнформацияОРейсе, "communicationType");
	Если ТипЗнч(ВидыСообщений) = Тип("Массив") Тогда
		Для Каждого ВидСообщения Из ВидыСообщений Цикл
			XDTO_СодИнфСоб.ВидСообщ.Добавить(ВидСообщенияВЗначениеXDTO(ВидСообщения));
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ВидыСообщений) Тогда
		XDTO_СодИнфСоб.ВидСообщ.Добавить(ВидСообщенияВЗначениеXDTO(ВидыСообщений));
	КонецЕсли;
	
	КС.XDTO_Установить(XDTO_СодИнфСоб, "СрокПЛ",
		СформироватьСрокПЛИзJSON(ИнформацияОРейсе, НомерТитула, Формат, ТипДокументооборота));
	
	КС.XDTO_Установить(XDTO_СодИнфСоб, "СвЛицПЛ",
		СформироватьСвЛицПЛИзJSON(ЗначениеПоля(ИнформацияОРейсе, "issuerInformation"), НомерТитула, Формат, ТипДокументооборота));
	
	КС.XDTO_Установить(XDTO_СодИнфСоб, "СвТС",
		СформироватьСвТСИзJSON(ЗначениеПоля(ДанныеJSON, "vehicle"), НомерТитула, Формат, ТипДокументооборота));
	
	Водители = ЗначениеПоля(ДанныеJSON, "driverDetails");
	Если ТипЗнч(Водители) = Тип("Массив") Тогда
		Для Каждого ДанныеВодителя Из Водители Цикл
			XDTO_СодИнфСоб.СвВодит.Добавить(
				СформироватьСвВодитИзJSON(ДанныеВодителя, НомерТитула, Формат, ТипДокументооборота));
		КонецЦикла;
	КонецЕсли;
	
	СведенияГосСистем = ЗначениеПоля(ИнформацияОРейсе, "goodsUnderLegalRegistration");
	ЕстьГосСистемы = ТипЗнч(СведенияГосСистем) = Тип("Массив") И СведенияГосСистем.Количество() > 0;
	КС.XDTO_Установить(XDTO_СодИнфСоб, "УчГосСист", ?(ЕстьГосСистемы, "1", "0"));
	Если ЕстьГосСистемы Тогда
		Для Каждого СтрокаГосСистемы Из СведенияГосСистем Цикл
			XDTO_СодИнфСоб.СвГосСист.Добавить(
				СформироватьСвГосСистИзJSON(СтрокаГосСистемы, НомерТитула, Формат, ТипДокументооборота));
		КонецЦикла;
	КонецЕсли;
	
	СпецУсловия = ЗначениеПоля(ЗначениеПоля(ИнформацияОРейсе, "specialConditions"), "permissions");
	ЕстьСпецУсловия = ТипЗнч(СпецУсловия) = Тип("Массив") И СпецУсловия.Количество() > 0;
	КС.XDTO_Установить(XDTO_СодИнфСоб, "ОтмСпецУсл", ?(ЕстьСпецУсловия, "1", "0"));
	Если ЕстьСпецУсловия Тогда
		Для Каждого СтрокаСпецУсловия Из СпецУсловия Цикл
			XDTO_СодИнфСоб.СпецУслДвиж.Добавить(
				СформироватьСпецУслДвижИзJSON(СтрокаСпецУсловия, НомерТитула, Формат, ТипДокументооборота));
		КонецЦикла;
	КонецЕсли;
	
	ИнфПоля = ЗначениеПоля(ДанныеJSON, "shippingTermsInfoFields");
	Если ТипЗнч(ИнфПоля) = Тип("Массив") Тогда
		Для Каждого СтрокаИнфПоля Из ИнфПоля Цикл
			СтрокаИнфПол = Новый Структура("Идентиф, Значение",
				ЗначениеПоля(СтрокаИнфПоля, "key"),
				ЗначениеПоля(СтрокаИнфПоля, "value"));
			XDTO_СодИнфСоб.ИнфПол.Добавить(
				КС.XDTO_ИнфПол(НомерТитула, Формат, СтрокаИнфПол, "СодИнфСоб", ТипДокументооборота));
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СодИнфСоб;
	
КонецФункции

Функция СформироватьСрокПЛИзJSON(ИнформацияОРейсе, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	XDTO_СрокПЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СрокПЛ", ТипДокументооборота, Формат);
	
	ПериодДействия = ЗначениеПоля(ИнформацияОРейсе, "validityPeriod");
	ДатаС = ДатаИзJSON(ЗначениеПоля(ПериодДействия, "from"));
	ДатаПо = ДатаИзJSON(ЗначениеПоля(ПериодДействия, "to"));
	
	Если Не ЗначениеЗаполнено(ДатаПо) Или НачалоДня(ДатаС) = НачалоДня(ДатаПо) Тогда
		КС.XDTO_Установить(XDTO_СрокПЛ, "ПЛДень", "1");
		КС.XDTO_Установить(XDTO_СрокПЛ, "ДатаИспПЛ", КС.XDTO_ДатаТип(ДатаС));
	Иначе
		КС.XDTO_Установить(XDTO_СрокПЛ, "ПЛДень", "2");
		КС.XDTO_Установить(XDTO_СрокПЛ, "ДатаНачИспПЛ", КС.XDTO_ДатаТип(ДатаС));
		КС.XDTO_Установить(XDTO_СрокПЛ, "ДатаКонИспПЛ", КС.XDTO_ДатаТип(ДатаПо));
	КонецЕсли;
	
	Возврат XDTO_СрокПЛ;
	
КонецФункции

Функция СформироватьСвЛицПЛИзJSON(СведенияОбОформителе, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	XDTO_СвЛицПЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ", ТипДокументооборота, Формат);
	
	ВидОформителя = ВРег(СокрЛП(Строка(ЗначениеПоля(СведенияОбОформителе, "issuerKind"))));
	ЛицоОфПЛ = ?(ВидОформителя = "LESSOR" Или ВидОформителя = "А", "А", "С");
	КС.XDTO_Установить(XDTO_СвЛицПЛ, "ЛицоОфПЛ", ЛицоОфПЛ);
	
	Реквизиты = ЗначениеПоля(СведенияОбОформителе, "requisites");
	ЮрЛицо = ЗначениеПоля(Реквизиты, "legal");
	ИП = ЗначениеПоля(Реквизиты, "entrepreneur");
	ФизЛицо = ЗначениеПоля(Реквизиты, "person");
	
	XDTO_ИдСв = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв", ТипДокументооборота, Формат);
	
	Если ЮрЛицо <> Неопределено Тогда
		XDTO_СвЮЛУч = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвЮЛУч", ТипДокументооборота, Формат);
		КС.XDTO_Установить(XDTO_СвЮЛУч, "НаимОрг", ЗначениеПоля(ЮрЛицо, "name"));
		КС.XDTO_Установить(XDTO_СвЮЛУч, "ИННЮЛ", ЗначениеПоля(ЮрЛицо, "inn"));
		КС.XDTO_Установить(XDTO_СвЮЛУч, "КПП", ЗначениеПоля(ЮрЛицо, "kpp"));
		КС.XDTO_Установить(XDTO_СвЮЛУч, "ОГРН", ЗначениеПоля(ЮрЛицо, "ogrn"));
		КС.XDTO_Установить(XDTO_ИдСв, "СвЮЛУч", XDTO_СвЮЛУч);
	ИначеЕсли ИП <> Неопределено Тогда
		XDTO_СвИП = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвИП", ТипДокументооборота, Формат);
		КС.XDTO_Установить(XDTO_СвИП, "ИННИП", ЗначениеПоля(ИП, "inn"));
		КС.XDTO_Установить(XDTO_СвИП, "ОГРНИП", ЗначениеПоля(ИП, "ogrnip"));
		ФИО = ЗначениеПоля(ИП, "fio");
		Если ФИО <> Неопределено Тогда
			XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвИП.ФИО", ТипДокументооборота, Формат);
			ЗаполнитьФИОИзJSON(XDTO_ФИО, ФИО);
			КС.XDTO_Установить(XDTO_СвИП, "ФИО", XDTO_ФИО);
		КонецЕсли;
		КС.XDTO_Установить(XDTO_ИдСв, "СвИП", XDTO_СвИП);
	ИначеЕсли ФизЛицо <> Неопределено Тогда
		XDTO_СвФЛ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвФЛ", ТипДокументооборота, Формат);
		КС.XDTO_Установить(XDTO_СвФЛ, "ИННФЛ", ЗначениеПоля(ФизЛицо, "inn"));
		ФИО = ЗначениеПоля(ФизЛицо, "fio");
		Если ФИО <> Неопределено Тогда
			XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвЛицПЛ.ИдСв.СвФЛ.ФИО", ТипДокументооборота, Формат);
			ЗаполнитьФИОИзJSON(XDTO_ФИО, ФИО);
			КС.XDTO_Установить(XDTO_СвФЛ, "ФИО", XDTO_ФИО);
		КонецЕсли;
		КС.XDTO_Установить(XDTO_ИдСв, "СвФЛ", XDTO_СвФЛ);
	КонецЕсли;
	
	КС.XDTO_Установить(XDTO_СвЛицПЛ, "ИдСв", XDTO_ИдСв);
	КС.XDTO_Установить(XDTO_СвЛицПЛ, "Адрес",
		СформироватьАдресИзJSON(ЗначениеПоля(СведенияОбОформителе, "address"), НомерТитула, Формат, ТипДокументооборота, "СодИнфСоб.СвЛицПЛ.Адрес"));
