#Область ПрограммныйИнтерфейс

// Формирует XML титула 1 путевого листа формата 5.02 из строки JSON.
//
// Параметры:
//  СтрокаJSON - Строка - JSON с данными путевого листа.
//  ИспользоватьНовыйGUID - Булево - признак, что нужно заменить GUID при создании нового файла
//
// Возвращаемое значение:
//  Структура - результат формирования текста.
//
Функция СформироватьXMLПутевогоЛистаТитул1ИзJSON(СтрокаJSON, ИспользоватьНовыйGUID = Ложь) Экспорт
	
	ДанныеJSON = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(СтрокаJSON);
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	НомерТитула = 1;
	Формат = "5.02";
	ТипДокументооборота = "__PL";
	
	ИнформацияОРейсе = ЗначениеПоля(ДанныеJSON, "tripInfo");
	ЭлектронныйДокументооборот = ЗначениеПоля(ДанныеJSON, "electronicDocflow");
	
	ДатаФормирования = ДатаИзJSON(ЗначениеПоля(ИнформацияОРейсе, "date"));
	Если Не ЗначениеЗаполнено(ДатаФормирования) Тогда
		ДатаФормирования = ТекущаяДатаСеанса();
	КонецЕсли;
	ВремяФормирования = ДатаФормирования;
	
	GUID = "";
	
	Если ТипЗнч(ЭлектронныйДокументооборот) = Тип("Массив") И ЭлектронныйДокументооборот.Количество() > 0 Тогда
		
		СозданВ = ЗначениеПоля(ЭлектронныйДокументооборот[0], "createdAt");
		ДатаВремяСоздания = ДатаИзJSON(ЗначениеПоля(СозданВ, "dateTime"));
		Если ЗначениеЗаполнено(ДатаВремяСоздания) Тогда
			ДатаФормирования = ДатаВремяСоздания;
			ВремяФормирования = ДатаВремяСоздания;
		КонецЕсли;
		
		ИдентификаторФайла  = ЗначениеПоля(ЭлектронныйДокументооборот[0], "fileId");
		GUID = Прав(СокрЛП(ИдентификаторФайла), 36);
		
	КонецЕсли;
	
	XDTO_Файл = КС.XDTO_ФайлОбмена(НомерТитула, Формат, ТипДокументооборота);
	
	ОформительПЛ = ПолучитьУчастникаПеревозки("carrier", ДанныеJSON); 
	ОрганизацияМедик = ПолучитьУчастникаПеревозки("externalMedic", ДанныеJSON);
	Если Не ЗначениеЗаполнено(ОрганизацияМедик) Тогда
		ОрганизацияМедик = ОформительПЛ;
	КонецЕсли;
	
	W = 0;
	XDTO_Файл.ИдФайл = КС.ИдентификаторФайлаТитулаПЛ_5_02(НомерТитула, ОформительПЛ, ОрганизацияМедик, GUID, W);	
	
	ПодписантСтруктура = ПодписантИзДанныхJSON(ДанныеJSON);
	XDTO_Подписант = КС.XDTO_ПодпИнф(НомерТитула, ТипДокументооборота, Формат, ПодписантСтруктура);
	
	XDTO_Файл.Документ = КС.XDTO_Документ(
		НомерТитула, ТипДокументооборота, Формат, XDTO_Подписант, ДатаФормирования, ВремяФормирования);
	
	XDTO_СодИнфСоб = СформироватьСодИнфСобИзJSON(ДанныеJSON, НомерТитула, Формат, ТипДокументооборота);
	КС.XDTO_Установить(XDTO_Файл.Документ, "СодИнфСоб", XDTO_СодИнфСоб);
	
	КС.XDTO_Установить(XDTO_Файл.Документ, "ДатаДок", КС.XDTO_ДатаТип(ДатаИзJSON(ЗначениеПоля(ИнформацияОРейсе, "date"))));
	КС.XDTO_Установить(XDTO_Файл.Документ, "НомДок", СокрЛП(Строка(ЗначениеПоля(ИнформацияОРейсе, "number"))));
	
	ТекстФайла = КонтурЛогистика_КонструкторыXDTO.ПодготовитьТекстФайлаЛогистика(XDTO_Файл, "5.02");
		
	Возврат ТекстФайла;
		
КонецФункции

// Получает имя Файла XML титула 1 путевого листа формата 5.02 из строки JSON.
//
// Параметры:
//  СтрокаJSON - Строка - JSON с данными путевого листа.
//
// Возвращаемое значение:
//  Строка - имя XML файла обмена.
//
Функция ИмяФайла(СтрокаJSON) Экспорт
	
	ИмФайла = "";
	
	ДанныеJSON = КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(СтрокаJSON);
	
	ЭлектронныйДокументооборот = ЗначениеПоля(ДанныеJSON, "electronicDocflow");
	
	Если ТипЗнч(ЭлектронныйДокументооборот) = Тип("Массив") И ЭлектронныйДокументооборот.Количество() > 0 Тогда
		
		ИмФайла  = ЗначениеПоля(ЭлектронныйДокументооборот[0], "fileId");
		
	КонецЕсли;
	
	Возврат ИмФайла;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЧтениеJSON

Функция ЗначениеПоля(Данные, ИмяПоля, ЗначениеПоУмолчанию = Неопределено)
	
	Если Данные = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(ИмяПоля);
		Если Значение = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(ИмяПоля) Тогда
			Возврат Данные[ИмяПоля];
		КонецЕсли;
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция ДатаИзJSON(Значение)
	
