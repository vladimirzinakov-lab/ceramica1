Функция СформироватьСвТСИзJSON(СведенияОТС, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	XDTO_СвТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС", ТипДокументооборота, Формат);
	
	ИнформацияОТС = ЗначениеПоля(СведенияОТС, "vehicleInfo");
	Паспорт = ЗначениеПоля(ИнформацияОТС, "passport");
	ТипВлад = ВидВладенияВЗначениеXDTO(ЗначениеПоля(ИнформацияОТС, "vehicleOwnership"));
	
	XDTO_ТС = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.ТС", ТипДокументооборота, Формат);
	КС.XDTO_Установить(XDTO_ТС, "Тип", ТипТСВЗначениеXDTO(ЗначениеПоля(Паспорт, "vehicleType")));
	КС.XDTO_Установить(XDTO_ТС, "Марка", ЗначениеПоля(Паспорт, "vehicleBrand"));
	КС.XDTO_Установить(XDTO_ТС, "Модель", ЗначениеПоля(Паспорт, "vehicleModel"));
	КС.XDTO_Установить(XDTO_ТС, "ТипВлад", ТипВлад);
	КС.XDTO_Установить(XDTO_ТС, "РегНомер", ЗначениеПоля(ИнформацияОТС, "registrationNumber"));
	КС.XDTO_Установить(XDTO_ТС, "ИнвНомер", ЗначениеПоля(ИнформацияОТС, "inventoryNumber"));
	КС.XDTO_Установить(XDTO_ТС, "ПризнТопл", ВидТопливаВЗначениеXDTO(ЗначениеПоля(ИнформацияОТС, "fuelUsageType")));
	
	Если ТипВлад = "3" Или ТипВлад = "4" Или ТипВлад = "5" Тогда
		ДокументыВладения = ЗначениеПоля(ИнформацияОТС, "documentDetails");
		Если ТипЗнч(ДокументыВладения) = Тип("Массив") Тогда
			Для Каждого ДокументВладения Из ДокументыВладения Цикл
				XDTO_РеквДок = СформироватьРеквДокИзJSON(ДокументВладения, НомерТитула, Формат, ТипДокументооборота);
				Если XDTO_РеквДок <> Неопределено Тогда
					XDTO_ТС.СвДокВлад.Добавить(XDTO_РеквДок);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	КС.XDTO_Установить(XDTO_СвТС, "ТС", XDTO_ТС);
	
	Прицепы = ЗначениеПоля(СведенияОТС, "trailerInfo");
	Если ТипЗнч(Прицепы) = Тип("Массив") Тогда
		Для Каждого Прицеп Из Прицепы Цикл
			ПаспортПрицепа = ЗначениеПоля(Прицеп, "passport");
			XDTO_Прицеп = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.Прицеп", ТипДокументооборота, Формат);
			КС.XDTO_Установить(XDTO_Прицеп, "Марка",
				ЗначениеПоля(ПаспортПрицепа, "trailerBrand", ЗначениеПоля(Прицеп, "brand")));
			КС.XDTO_Установить(XDTO_Прицеп, "Модель",
				ЗначениеПоля(ПаспортПрицепа, "trailerModel", ЗначениеПоля(Прицеп, "model")));
			КС.XDTO_Установить(XDTO_Прицеп, "РегНомер", ЗначениеПоля(Прицеп, "registrationNumber"));			
			XDTO_СвТС.Прицеп.Добавить(XDTO_Прицеп);
		КонецЦикла;
	КонецЕсли;
	
	Возврат XDTO_СвТС;
	
КонецФункции

Функция СформироватьРеквДокИзJSON(ДокументВладения, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Наименование = ЗначениеПоля(ДокументВладения, "name", ЗначениеПоля(ДокументВладения, "type"));
	НомерДокумента = ЗначениеПоля(ДокументВладения, "number");
	ДатаДокумента = ДатаИзJSON(ЗначениеПоля(ДокументВладения, "date"));
	
	Если Не ЗначениеЗаполнено(Наименование) И Не ЗначениеЗаполнено(НомерДокумента) И Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = "Договор";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НомерДокумента) Тогда
		НомерДокумента = "б/н";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	XDTO_РеквДок = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвТС.ТС.СвДокВлад", ТипДокументооборота, Формат);
	КС.XDTO_Установить(XDTO_РеквДок, "РеквНаимДок", Наименование);
	КС.XDTO_Установить(XDTO_РеквДок, "РеквНомерДок", НомерДокумента);
	КС.XDTO_Установить(XDTO_РеквДок, "РеквДатаДок", КС.XDTO_ДатаТип(ДатаДокумента));
	
	Возврат XDTO_РеквДок;
	
КонецФункции

Функция СформироватьСвВодитИзJSON(ДанныеВодителя, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
