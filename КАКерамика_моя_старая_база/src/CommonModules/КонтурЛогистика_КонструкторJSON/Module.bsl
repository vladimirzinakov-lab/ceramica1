	XDTO_СвВодит = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвВодит", ТипДокументооборота, Формат);
	КС.XDTO_Установить(XDTO_СвВодит, "ИННФЛ", ЗначениеПоля(Информация, "inn"));
	КС.XDTO_Установить(XDTO_СвВодит, "СНИЛС", ЗначениеПоля(Информация, "snils"));
	
	Удостоверение = ЗначениеПоля(Информация, "license");
	XDTO_ВодитУд = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвВодит.ВодитУд", ТипДокументооборота, Формат);
	КС.XDTO_Установить(XDTO_ВодитУд, "НомВУ", ЗначениеПоля(Удостоверение, "number"));
	КС.XDTO_Установить(XDTO_ВодитУд, "СерВУ", ЗначениеПоля(Удостоверение, "series"));
	КС.XDTO_Установить(XDTO_ВодитУд, "ДатаВыдВУ", КС.XDTO_ДатаТип(ДатаИзJSON(ЗначениеПоля(Удостоверение, "issueDate"))));
	КС.XDTO_Установить(XDTO_СвВодит, "ВодитУд", XDTO_ВодитУд);
	
	ДОПОГ = ЗначениеПоля(Информация, "dopogLicense");
	Если ДОПОГ <> Неопределено Тогда
		XDTO_СвДОПОГ = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвВодит.СвДОПОГ", ТипДокументооборота, Формат);
		КС.XDTO_Установить(XDTO_СвДОПОГ, "НомСвДОПОГ", ЗначениеПоля(ДОПОГ, "number"));
		КС.XDTO_Установить(XDTO_СвДОПОГ, "СерСвДОПОГ", ЗначениеПоля(ДОПОГ, "series"));
		КС.XDTO_Установить(XDTO_СвДОПОГ, "КонДатСвДОПОГ", КС.XDTO_ДатаТип(ДатаИзJSON(ЗначениеПоля(ДОПОГ, "expiresOn"))));
		КС.XDTO_Установить(XDTO_СвВодит, "СвДОПОГ", XDTO_СвДОПОГ);
	КонецЕсли;
	
	КС.XDTO_Установить(XDTO_СвВодит, "Контакт",
		СформироватьКонтактИзJSON(ЗначениеПоля(Информация, "contacts"), НомерТитула, Формат, ТипДокументооборота, "СодИнфСоб.СвВодит.Контакт"));
	
	XDTO_ФИО = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СвВодит.ФИО", ТипДокументооборота, Формат);
