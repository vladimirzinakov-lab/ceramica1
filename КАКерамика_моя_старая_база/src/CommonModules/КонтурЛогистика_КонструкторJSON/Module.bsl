Функция СформироватьСпецУслДвижИзJSON(СтрокаСпецУсловия, НомерТитула, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	XDTO_СпецУслДвиж = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СпецУслДвиж", ТипДокументооборота, Формат);
	
	КС.XDTO_Установить(XDTO_СпецУслДвиж, "СпецУсл", СпецУсловиеДвиженияВЗначениеXDTO(ЗначениеПоля(СтрокаСпецУсловия, "condition")));
	КС.XDTO_Установить(XDTO_СпецУслДвиж, "НомСР", ЗначениеПоля(СтрокаСпецУсловия, "number"));
	КС.XDTO_Установить(XDTO_СпецУслДвиж, "ДатаСР", КС.XDTO_ДатаТип(ДатаИзJSON(ЗначениеПоля(СтрокаСпецУсловия, "issueDate"))));
	КС.XDTO_Установить(XDTO_СпецУслДвиж, "СрокСР", ЗначениеПоля(СтрокаСпецУсловия, "expiresOn"));
	КС.XDTO_Установить(XDTO_СпецУслДвиж, "ВидСР", ЗначениеПоля(СтрокаСпецУсловия, "type"));
	КС.XDTO_Установить(XDTO_СпецУслДвиж, "НаимОИВ", ЗначениеПоля(СтрокаСпецУсловия, "issuingAuthorityName"));
	
	СведенияОМаршруте = ЗначениеПоля(СтрокаСпецУсловия, "routeInfo");
	Если СведенияОМаршруте <> Неопределено Тогда
		XDTO_СведМрш = НовыйДочернийОбъектXDTO(НомерТитула, "СодИнфСоб.СпецУслДвиж.СведМрш", ТипДокументооборота, Формат);
		ТипМаршрута = ВРег(СокрЛП(Строка(ЗначениеПоля(СведенияОМаршруте, "type"))));
		Если ТипМаршрута = "TEXT" Или ТипМаршрута = "" Тогда
			КС.XDTO_Установить(XDTO_СведМрш, "МршТекст", ЗначениеПоля(СведенияОМаршруте, "info"));
		Иначе
			КС.XDTO_Установить(XDTO_СведМрш, "МршМашЧит", ЗначениеПоля(СведенияОМаршруте, "info"));
		КонецЕсли;
		КС.XDTO_Установить(XDTO_СпецУслДвиж, "СведМрш", XDTO_СведМрш);
	КонецЕсли;
	
	Возврат XDTO_СпецУслДвиж;
	
КонецФункции

Функция СформироватьАдресИзJSON(АдресJSON, НомерТитула, Формат, ТипДокументооборота, Путь)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	XDTO_Адрес = НовыйДочернийОбъектXDTO(НомерТитула, Путь, ТипДокументооборота, Формат);
	
	АдресРФ = ЗначениеПоля(АдресJSON, "russianAddress");
	Если АдресРФ = Неопределено Тогда
		Возврат XDTO_Адрес;
	КонецЕсли;
	
	XDTO_АдрРФ = НовыйДочернийОбъектXDTO(НомерТитула, Путь + ".АдрРФ", ТипДокументооборота, Формат);
	КодРегиона = ЗначениеПоля(АдресРФ, "regionCode");
	КС.XDTO_Установить(XDTO_АдрРФ, "Индекс", ЗначениеПоля(АдресРФ, "postCode"));
	КС.XDTO_Установить(XDTO_АдрРФ, "КодРегион", КодРегиона);
	
	ТаблицаРегионовРФ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
	СтрокаРегион = ТаблицаРегионовРФ.Найти(КодРегиона, "Код");
	Если СтрокаРегион = Неопределено Или КодРегиона = "99" Тогда
		НаимРегион = "иные";
	Иначе
		НаимРегион = СтрокаРегион.Наименование;
	КонецЕсли;
	
	КС.XDTO_Установить(XDTO_АдрРФ, "НаимРегион", НаимРегион);
	КС.XDTO_Установить(XDTO_АдрРФ, "Город", ЗначениеПоля(АдресРФ, "city"));
	КС.XDTO_Установить(XDTO_АдрРФ, "Улица", ЗначениеПоля(АдресРФ, "street"));
	КС.XDTO_Установить(XDTO_АдрРФ, "Дом", ЗначениеПоля(АдресРФ, "house"));
	КС.XDTO_Установить(XDTO_АдрРФ, "Корпус", ЗначениеПоля(АдресРФ, "building"));
	КС.XDTO_Установить(XDTO_АдрРФ, "Кварт", ЗначениеПоля(АдресРФ, "flatOrOffice"));
	КС.XDTO_Установить(XDTO_Адрес, "АдрРФ", XDTO_АдрРФ);
	
	Возврат XDTO_Адрес;
	
КонецФункции

Функция СформироватьКонтактИзJSON(КонтактыJSON, НомерТитула, Формат, ТипДокументооборота, Путь)
	
	XDTO_Контакт = НовыйДочернийОбъектXDTO(НомерТитула, Путь, ТипДокументооборота, Формат);
	
	Телефоны = ЗначениеПоля(КонтактыJSON, "phoneNumbers");
	Если ТипЗнч(Телефоны) = Тип("Массив") Тогда
		Для Каждого Телефон Из Телефоны Цикл
			XDTO_Контакт.Тлф.Добавить(Телефон);
		КонецЦикла;
	КонецЕсли;
	
	Почты = ЗначениеПоля(КонтактыJSON, "emails");
	Если ТипЗнч(Почты) = Тип("Массив") Тогда
		Для Каждого Почта Из Почты Цикл
			XDTO_Контакт.ЭлПочта.Добавить(Почта);
		КонецЦикла;
	КонецЕсли;
	
	Прочие = ЗначениеПоля(КонтактыJSON, "other");
	Если ТипЗнч(Прочие) = Тип("Массив") И Прочие.Количество() > 0 Тогда
		Части = Новый Массив;
		Для Каждого ЭлементПрочего Из Прочие Цикл
			Части.Добавить(Строка(ЭлементПрочего));
		КонецЦикла;
		КонтурЛогистика_КонструкторыXDTO.XDTO_Установить(XDTO_Контакт, "ИнКонт",
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(Части, "; "));
	ИначеЕсли ЗначениеЗаполнено(Прочие) И ТипЗнч(Прочие) = Тип("Строка") Тогда
		КонтурЛогистика_КонструкторыXDTO.XDTO_Установить(XDTO_Контакт, "ИнКонт", Прочие);
	КонецЕсли;
	
	Возврат XDTO_Контакт;
	
КонецФункции

Процедура ЗаполнитьФИОИзJSON(XDTO_ФИО, ФИО)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
