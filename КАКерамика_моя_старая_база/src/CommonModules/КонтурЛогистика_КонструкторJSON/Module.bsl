Функция ВидПеревозкиВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Ключ = "COMMERCIAL" Или Ключ = "КП" Тогда
		Возврат "КП";
	ИначеЕсли Ключ = "FOROWNNEEDS" Или Ключ = "СН" Тогда
		Возврат "СН";
	ИначеЕсли Ключ = "SPECIALVEHICLES" Или Ключ = "СТ" Тогда
		Возврат "СТ";
	КонецЕсли;
	
	Возврат "КП";
	
КонецФункции

Функция ВидКоммерческойПеревозкиВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Ключ = "REGULARPASSENGER" Или Ключ = "РП" Тогда
		Возврат "РП";
	ИначеЕсли Ключ = "CARGOTRANSPORTATION" Или Ключ = "ПГ" Тогда
		Возврат "ПГ";
	ИначеЕсли Ключ = "ONDEMANDPASSENGER" Или Ключ = "ЗП" Тогда
		Возврат "ЗП";
	ИначеЕсли Ключ = "TAXISERVICE" Или Ключ = "TAXI" Или Ключ = "ЛТ" Тогда
		Возврат "ЛТ";
	ИначеЕсли Ключ = "CHILDRENTRANSPORTATION" Или Ключ = "ПД" Тогда
		Возврат "ПД";
	КонецЕсли;
	
	Возврат "РП";
	
КонецФункции

Функция ВидСообщенияВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Ключ = "URBAN" Или Ключ = "Г" Тогда
		Возврат "Г";
	ИначеЕсли Ключ = "SUBURBAN" Или Ключ = "П" Тогда
		Возврат "П";
	ИначеЕсли Ключ = "INTERCITY" Или Ключ = "М" Тогда
		Возврат "М";
	КонецЕсли;
	
	Возврат "Г";
	
КонецФункции

Функция ВидВладенияВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Ключ = "OWNERSHIP" Или Ключ = "NOTSET" Или Ключ = "1" Тогда
		Возврат "1";
	ИначеЕсли Ключ = "JOINTSPOUSALOWNERSHIP" Или Ключ = "2" Тогда
		Возврат "2";
	ИначеЕсли Ключ = "RENT" Или Ключ = "3" Тогда
		Возврат "3";
	ИначеЕсли Ключ = "LEASING" Или Ключ = "4" Тогда
		Возврат "4";
	ИначеЕсли Ключ = "FREEUSE" Или Ключ = "5" Тогда
		Возврат "5";
	КонецЕсли;
	
	Возврат "1";
	
КонецФункции

Функция ТипТСВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Найти(Ключ, "ЛЕГКОВ") > 0 Или Ключ = "1" Или Ключ = "PASSENGERCAR" Тогда
		Возврат "1";
	ИначеЕсли Найти(Ключ, "АВТОБУС") > 0 Или Ключ = "2" Или Ключ = "BUS" Тогда
		Возврат "2";
	ИначеЕсли Найти(Ключ, "ТРАМВАЙ") > 0 Или Найти(Ключ, "ТРОЛЛЕЙБУС") > 0 Или Ключ = "3" Тогда
		Возврат "3";
	ИначеЕсли Найти(Ключ, "ГРУЗОВ") > 0 Или Ключ = "4" Или Ключ = "TRUCK" Тогда
		Возврат "4";
	КонецЕсли;
	
	Возврат "5";
	
КонецФункции

Функция ВидТопливаВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Ключ = "MULTIFUEL" Или Ключ = "2" Тогда
		Возврат "2";
	КонецЕсли;
	
	Возврат "1";
	
КонецФункции

Функция СпецУсловиеДвиженияВЗначениеXDTO(Значение)
	
	Ключ = ВРег(СокрЛП(Строка(Значение)));
	Если Ключ = "DANGEROUSGOODS" Или Ключ = "1" Тогда
		Возврат "1";
	ИначеЕсли Ключ = "OVERSIZEDORHEAVYVEHICLE" Или Ключ = "2" Тогда
		Возврат "2";
	КонецЕсли;
	
	Возврат "3";
	
КонецФункции

Функция ИдентификаторФайлаИзJSON(ЭлектронныйДокументооборот)
	
	Если ТипЗнч(ЭлектронныйДокументооборот) <> Тип("Массив") Или ЭлектронныйДокументооборот.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеПоля(ЭлектронныйДокументооборот[0], "fileId")));
	
КонецФункции

Функция ПодписантИзДанныхJSON(ДанныеJSON)
	
	Подписант = Новый Структура;
	Подписант.Вставить("Фамилия", "Подписант");
	Подписант.Вставить("Имя", "НеУказан");
	Подписант.Вставить("Отчество", "");
	Подписант.Вставить("Должность", "Уполномоченное лицо");
	Подписант.Вставить("СпосПодтПолном", "1");
	Подписант.Вставить("ДопСведенияОПодписанте", "");
	Подписант.Вставить("МЧД", "");
	Подписант.Вставить("ИдСистХран", "");
	Подписант.Вставить("ДатаВыпускаМЧД", Дата(1, 1, 1));
	Подписант.Вставить("СвДоверБум_ВнНомДовер", "");
	Подписант.Вставить("СвДоверБум_ДатаДовер", Дата(1, 1, 1));
	
	Водители = ЗначениеПоля(ДанныеJSON, "driverDetails");
	Если ТипЗнч(Водители) = Тип("Массив") И Водители.Количество() > 0 Тогда
		ФИО = ЗначениеПоля(ЗначениеПоля(Водители[0], "information"), "fio");
		Если ФИО <> Неопределено Тогда
			Подписант.Фамилия = ЗначениеПоля(ФИО, "lastName", Подписант.Фамилия);
			Подписант.Имя = ЗначениеПоля(ФИО, "firstName", Подписант.Имя);
			Подписант.Отчество = ЗначениеПоля(ФИО, "middleName", "");
			Подписант.Должность = "Водитель";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Подписант;
	
КонецФункции

#КонецОбласти

Функция ПолучитьУчастникаПеревозки(ТипУчастника, ДанныеJSON)
	
	УчастникиПеревозки = ЗначениеПоля(ДанныеJSON, "participants");
	
	Оформитель = ЗначениеПоля(УчастникиПеревозки, ТипУчастника);
	Если Не ЗначениеЗаполнено(Оформитель) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ИНН = ЗначениеПоля(Оформитель, "inn");
	КПП = ЗначениеПоля(Оформитель, "kpp");
	BoxId = ЗначениеПоля(Оформитель, "diadocBoxId");
	ПолноеНаименование = ЗначениеПоля(Оформитель, "fullName");
	Наименование = ЗначениеПоля(Оформитель, "shortName");
	ИдентификаторУчастникаЭДО = ЗначениеПоля(Оформитель, "fnsParticipantId");
	
	НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиПоРеквизиту("ID", BoxId);
	
	Если Не ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
		НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(
			ИНН, КПП,,  ИдентификаторУчастникаЭДО);
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
		НайденнаяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.НайтиОрганизациюПоКлючевымРеквизитам(
			ИНН, КПП);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
		ОрганизацияДиадок = НайденнаяОрганизация;
	Иначе
		НоваяОрганизация = Справочники.КонтурЛогистика_ОрганизацииДиадок.СоздатьЭлемент();
		НоваяОрганизация.ИНН = СокрЛП(ИНН);
		НоваяОрганизация.КПП = КПП;
		НоваяОрганизация.ТипЛица = Перечисления.КонтурЛогистика_ТипыЛиц.ЮрЛицо;
		НоваяОрганизация.Наименование = Наименование;
		НоваяОрганизация.НаименованиеОрганизацииПолное = ПолноеНаименование;
		Если ЗначениеЗаполнено(ИдентификаторУчастникаЭДО) Тогда
			НоваяОрганизация.ИдентификаторУчастникаЭДО = ИдентификаторУчастникаЭДО;
		Иначе
			НоваяОрганизация.ДополнительныеСвойства.Вставить("ПолучитьИдентификаторУчастникаЭДОИзДиадок");
		КонецЕсли;
		
		НоваяОрганизация.ДополнительныеСвойства.Вставить("СинхронизироватьИзСервисаЛогистика");
		
		НоваяОрганизация.Записать();
		ОрганизацияДиадок = НоваяОрганизация.Ссылка;
	КонецЕсли;
	
	Возврат ОрганизацияДиадок;
	
КонецФункции

#КонецОбласти

