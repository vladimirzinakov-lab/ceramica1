Процедура СинхронизироватьОрганизацииИзДиадокаПослеОбмена()
	
	Попытка
		ДанныеГраницы = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОбщуюМинимальнуюДатуГраницыСинхронизации();
		
		ПорогОтставания = 3600;
		МинимальноеОтклонениеГраницыОтТекущегоВремени = 10;
		
		РазницаВСекундах = ТекущаяДатаСеанса() - ДанныеГраницы.ДатаГраницыСинхронизации;
		
		Если ДанныеГраницы.ДатаГраницыСинхронизации <> Дата(1, 1, 1)
			И РазницаВСекундах < ПорогОтставания
			И РазницаВСекундах >= МинимальноеОтклонениеГраницыОтТекущегоВремени
			И Справочники.КонтурЛогистика_ОрганизацииДиадок.ЕстьМаркерОбработаннойЛентыДиадок() Тогда
			
			ВыполнитьВФоне(
				"КонтурЛогистика_ДлительныеОперацииСервер.СинхронизироватьРеквизитыОрганизацийИзДиадока",,
				"КлючФЗ_СинхронизироватьОрганизацииИзДиадока",
				"Синхронизация реквизитов организаций из Диадока");
		КонецЕсли;
	Исключение
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Ошибка при запуске синхронизации организаций после обмена. " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

