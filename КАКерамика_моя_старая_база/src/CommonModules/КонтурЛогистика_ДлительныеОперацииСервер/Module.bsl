Функция ПолучитьПечатнуюФормуИзСервиса(ДокументыТитулы, Интерактивно = Ложь) Экспорт
	
	ПрикреплятьФайл = Ложь;
	ТихийРежим = Ложь;
	ОтпорПоДатеФайлаОбмена = Ложь;
	
	ДокументыТитулыЛок = ГлавныеДокументыДляПолученияПечатныхФорм(ДокументыТитулы);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТитулДатаНачала", Неопределено);
	Запрос.УстановитьПараметр("ТитулДатаОкончания", Неопределено);
	Запрос.УстановитьПараметр("ОтборПоДатеТитула", Ложь);
	Запрос.УстановитьПараметр("ФайлОбменаДатаНачала", Неопределено);
	Запрос.УстановитьПараметр("ОтпорПоДатеФайлаОбмена", ОтпорПоДатеФайлаОбмена);
	Запрос.УстановитьПараметр("ФайлыОбмена", Новый Массив);
	Запрос.УстановитьПараметр("ДокументыТитулы", ДокументыТитулыЛок);
	Запрос.УстановитьПараметр("ВсеНашиОрганизации", Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации());
	Запрос.УстановитьПараметр("ПрикреплятьФайл", ПрикреплятьФайл);
	
	Запрос.Текст = ТекстЗапросаДанныхДляПолученияПечатныхФорм();
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаЭТРН = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЭПЛ = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЭР = Результат[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПЭ = Результат[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаСР = Результат[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЗЗ = Результат[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаЭТРН.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭТРН, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	ИначеЕсли ВыборкаЭПЛ.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭПЛ, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	ИначеЕсли ВыборкаЭР.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭР, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	ИначеЕсли ВыборкаПЭ.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаПЭ, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	ИначеЕсли ВыборкаСР.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаСР, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	ИначеЕсли ВыборкаЗЗ.Следующий() Тогда
		ПечатнаяФорма = ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЗЗ, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	Иначе
		ПечатнаяФорма = Неопределено;
	КонецЕсли;
	
	Возврат ПечатнаяФорма;
	
КонецФункции

Процедура ДобавитьПечатныеФормыЭПДВПрисоединенныеФайлы(ПараметрыФоновогоЗадания) Экспорт
	
	Перем ТитулДатаНачала, ТитулДатаОкончания, ФайлОбменаДатаНачала;
	
	ОтборФайлов = ПараметрыФоновогоЗадания.ОтборФайлов;
	Если ПараметрыФоновогоЗадания.Свойство("ТихийРежим") Тогда
		ТихийРежим = ПараметрыФоновогоЗадания.ТихийРежим;
	Иначе
		ТихийРежим = Ложь;
	КонецЕсли;
	
	Если ПараметрыФоновогоЗадания.Свойство("Интерактивно") Тогда
		Интерактивно = ПараметрыФоновогоЗадания.Интерактивно;
	Иначе
		Интерактивно = Ложь;
	КонецЕсли;
	
	ПрикреплятьФайл = Истина;
	ОтборПоДатеТитула = Ложь;
	ОтпорПоДатеФайлаОбмена = Ложь;
	
	Если ОтборФайлов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ТитулДатаНачала") И ОтборФайлов.Свойство("ТитулДатаОкончания") Тогда
		ТитулДатаНачала = ОтборФайлов.ТитулДатаНачала;
		ТитулДатаОкончания = КонецДня(ОтборФайлов.ТитулДатаОкончания);
		ОтборПоДатеТитула = (ЗначениеЗаполнено(ТитулДатаНачала) И ЗначениеЗаполнено(ТитулДатаОкончания));
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ФайлОбменаДатаНачала") Тогда
		ФайлОбменаДатаНачала = ОтборФайлов.ФайлОбменаДатаНачала;
		ОтпорПоДатеФайлаОбмена = ЗначениеЗаполнено(ФайлОбменаДатаНачала);
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ФайлыОбмена") Тогда
		ФайлыОбмена = ОтборФайлов.ФайлыОбмена;
	Иначе
		ФайлыОбмена = Новый Массив;
	КонецЕсли;
	
	Если ОтборФайлов.Свойство("ДокументыТитулы") Тогда
		
		ДокументыТитулыЛок = ГлавныеДокументыДляПолученияПечатныхФорм(ОтборФайлов.ДокументыТитулы);
		
	Иначе
		ДокументыТитулыЛок = Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТитулДатаНачала", ТитулДатаНачала);
	Запрос.УстановитьПараметр("ТитулДатаОкончания", ТитулДатаОкончания);
	Запрос.УстановитьПараметр("ОтборПоДатеТитула", ОтборПоДатеТитула);
	Запрос.УстановитьПараметр("ФайлОбменаДатаНачала", ФайлОбменаДатаНачала);
	Запрос.УстановитьПараметр("ОтпорПоДатеФайлаОбмена", ОтпорПоДатеФайлаОбмена);
	Запрос.УстановитьПараметр("ФайлыОбмена", ФайлыОбмена);
	Запрос.УстановитьПараметр("ДокументыТитулы", ДокументыТитулыЛок);
	Запрос.УстановитьПараметр("ВсеНашиОрганизации", Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации());
	Запрос.УстановитьПараметр("ПрикреплятьФайл", ПрикреплятьФайл);
	
	Запрос.Текст = ТекстЗапросаДанныхДляПолученияПечатныхФорм();
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаТРН = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПЛ = Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЭР = Результат[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПЭ = Результат[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЗЗ = Результат[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТРН.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаТРН, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	КонецЦикла;
	
	Пока ВыборкаПЛ.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаПЛ, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	КонецЦикла;
	
	Пока ВыборкаЭР.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЭР, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	КонецЦикла;
	
	Пока ВыборкаПЭ.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаПЭ, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	КонецЦикла;
	
	Пока ВыборкаЗЗ.Следующий() Цикл
		ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаЗЗ, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИПрисоединитьПечатнуюФорму(ВыборкаГлавныйДокумент, ОтпорПоДатеФайлаОбмена, ТихийРежим, ПрикреплятьФайл, Интерактивно = Ложь)
	
	ЭтоТрН = Ложь;
	ЭтоПЛ = Ложь;
	ЭтоЭР = Ложь;
	ЭтоПЭ = Ложь;
	ЭтоСР = Ложь;
	ЭтоЗЗ = Ложь;
	
	ТипГлавногоДокумента = ТипЗнч(ВыборкаГлавныйДокумент.ГлавныйДокумент);
	Если ТипГлавногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		ЭтоТрН = Истина;
	ИначеЕсли ТипГлавногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		ЭтоПЛ = Истина;
	ИначеЕсли ТипГлавногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
		ЭтоЭР = Истина;
	ИначеЕсли ТипГлавногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1") Тогда
		ЭтоПЭ = Истина;
	ИначеЕсли ТипГлавногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_СкладскаяРасписка") Тогда
		ЭтоСР = Истина;
	ИначеЕсли ТипГлавногоДокумента = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		ЭтоЗЗ = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаГлавныйДокумент.Организация) Тогда
		Организация = ВыборкаГлавныйДокумент.Организация;
	Иначе
		
		// Попробуем получить из доп. получателей
		Если ЭтоТрН Тогда
			НашиДополнительныеПолучатели = КонтурЛогистика_ОбработкаДокументовСервер.НашиДополнительныеПолучателиФайлаТрН(
				ВыборкаГлавныйДокумент.ГлавныйДокумент);
		ИначеЕсли ЭтоПЛ Тогда
			НашиДополнительныеПолучатели = КонтурЛогистика_ОбработкаДокументовСервер.НашиДополнительныеПолучателиФайлаПЛ(
				ВыборкаГлавныйДокумент.ГлавныйДокумент);
		ИначеЕсли ЭтоЭР Тогда
			НашиДополнительныеПолучатели = Новый Массив;
		ИначеЕсли ЭтоПЭ Тогда
			НашиДополнительныеПолучатели = КонтурЛогистика_ОбработкаДокументовСервер.НашиДополнительныеПолучателиФайлаПЭ(
				ВыборкаГлавныйДокумент.ГлавныйДокумент);
		ИначеЕсли ЭтоЗЗ Тогда
			НашиДополнительныеПолучатели = КонтурЛогистика_ОбработкаДокументовСервер.НашиДополнительныеПолучателиФайлаЗЗ(
				ВыборкаГлавныйДокумент.ГлавныйДокумент);
		Иначе
			НашиДополнительныеПолучатели = Новый Массив;
		КонецЕсли;
		
		Если НашиДополнительныеПолучатели.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Организация = НашиДополнительныеПолучатели[0];
	КонецЕсли;
	
	// Получим параметры сервиса
	Если ЭтоТрН Или ЭтоПЛ Тогда
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Организация);
		Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		
		// Получим печатную форму из сервиса
		Если ЭтоТрН Тогда
			ПечатнаяФорма = КонтурЛогистика_API_Логистика.ПолучитьПечатнуюФормуТранспортнойНакладной(
				ПараметрыСервиса, ВыборкаГлавныйДокумент.kl_id);
		ИначеЕсли ЭтоПЛ Тогда
			ПечатнаяФорма = КонтурЛогистика_API_Логистика.ПолучитьПечатнуюФормуПутевогоЛиста(
				ПараметрыСервиса, ВыборкаГлавныйДокумент.kl_id, ВыборкаГлавныйДокумент.ТипПечатнойФормыПутыхЛистов);
		ИначеЕсли ЭтоЭР Или ЭтоПЭ Или ЭтоСР Или ЭтоЗЗ Тогда
			Результат = КонтурЛогистика_API_Диадок.Диадок_АПИ_GeneratePrintForm(
				Организация.ID, ВыборкаГлавныйДокумент.MessageID, ВыборкаГлавныйДокумент.DocumentId);
				
			Если Интерактивно И Результат.ВремяОжидания > 0 И Результат.ВремяОжидания < 10 Тогда
				// В интерактивном режиме ждем, иначе получим в следующий раз
				КонтурЛогистика_ОбщегоНазначенияСервер.Пауза_(Результат.ВремяОжидания);
				Результат = КонтурЛогистика_API_Диадок.Диадок_АПИ_GeneratePrintForm(
					Организация.ID, ВыборкаГлавныйДокумент.MessageID, ВыборкаГлавныйДокумент.DocumentId);
			КонецЕсли;
			
			Если Результат.Свойство("ДвоичныеДанныеФайла") Тогда
				ПечатнаяФорма = Результат.ДвоичныеДанныеФайла;
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ПолучитьИПрисоединитьПечатнуюФорму",
			ИнформацияОбОшибке(), ВыборкаГлавныйДокумент.ГлавныйДокумент);
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ПечатнаяФорма) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ПрикреплятьФайл Тогда
		Возврат ПечатнаяФорма;
	КонецЕсли;
	
	// Прикрепим полученнй документ в связанным объектам
	ВыборкаДокументыОснования = ВыборкаГлавныйДокумент.Выбрать();
	Пока ВыборкаДокументыОснования.Следующий() Цикл
		
		Попытка
			
			Если ЭтоТрН Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭТРНДляПрисоединенныхФайлов();
			ИначеЕсли ЭтоПЛ Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭПЛДляПрисоединенныхФайлов();
			ИначеЕсли ЭтоЭР Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭЭРДляПрисоединенныхФайлов();
			ИначеЕсли ЭтоПЭ Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭПЭДляПрисоединенныхФайлов();
			ИначеЕсли ЭтоСР Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭСРДляПрисоединенныхФайлов();
			ИначеЕсли ЭтоЗЗ Тогда
				ИмяПечатнойФормы = КонтурЛогистика_ПечатьСервер.ИмяПечатнойФормыЭЗЗДляПрисоединенныхФайлов();
			КонецЕсли;
			
			Результат = КонтурЛогистика_ИнтеграцияТиповыеСервер.ПрикрепитьФайлКДокументуОснования(
				ПечатнаяФорма, ВыборкаДокументыОснования.ДокументОснование, ИмяПечатнойФормы);
				
			Если Не ТихийРежим Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Печатная форма ЭПД прикреплена к " + Строка(ВыборкаДокументыОснования.ДокументОснование);
				Сообщение.Сообщить();
			КонецЕсли;
			
			Если ОтпорПоДатеФайлаОбмена И Результат Тогда
				КонтурЛогистика_ОбщегоНазначенияСервер.УстановитьНастройку(
					"ДатаГраницыПолученияПечатныхФормЭПД", ВыборкаГлавныйДокумент.ДатаВремяФормирования);
			КонецЕсли;
			
		Исключение
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при сохранение печатной формы в присоединенные файлы. Ошибка: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,
				ВыборкаДокументыОснования.ДокументОснование, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ПечатнаяФорма;
	
КонецФункции

// Заявка на маршрут и титул 2 ЗЗ не являются главными документами файла обмена.
//
Функция ГлавныеДокументыДляПолученияПечатныхФорм(ДокументыТитулы)
	
	ДокументыТитулыЛок = Новый Массив;
	ТипМаршрута = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут");
	ТипЗЗТитул2 = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2");
	
	Для Каждого ТекущийТитул Из ДокументыТитулы Цикл
		
		Если ТипЗнч(ТекущийТитул) = ТипМаршрута
			Или ТипЗнч(ТекущийТитул) = ТипЗЗТитул2 Тогда
			ДокументыТитулыЛок.Добавить(ТекущийТитул.Титул1);
		Иначе
			ДокументыТитулыЛок.Добавить(ТекущийТитул);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДокументыТитулыЛок;
	
КонецФункции

