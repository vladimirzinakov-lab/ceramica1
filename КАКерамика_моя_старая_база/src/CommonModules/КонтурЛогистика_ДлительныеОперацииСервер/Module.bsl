// Обновляет кэш ИНН партнеров PARTIN EDI (фоновый запуск).
//
// Параметры:
//  ПараметрыФоновогоЗадания - Структура, Неопределено - параметры ФЗ; при наличии АдресРезультата
//                             туда помещается результат ОбновитьВсеИННПартнеровEDI;
//                             ТихийРежим (Булево) — без сообщений хода выполнения
//
Процедура ОбновитьВсеИННПартнеровEDI(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	ТихийРежим = Ложь;
	Если ПараметрыФоновогоЗадания <> Неопределено
		И ПараметрыФоновогоЗадания.Свойство("ТихийРежим") Тогда
		ТихийРежим = ПараметрыФоновогоЗадания.ТихийРежим;
	КонецЕсли;
	
	Результат = КонтурЛогистика_ИнтеграцияEDI_Сервер.ОбновитьВсеИННПартнеровEDI(ТихийРежим);
	
	ДополнениеОшибки = "";
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ДополнениеОшибки = "; " + Результат.ТекстОшибки;
	КонецЕсли;
	
	ТекстСообщения = "Обновление ИНН партнеров EDI: Успешно="
		+ Строка(Результат.Успешно)
		+ ", Количество="
		+ Строка(Результат.Количество)
		+ ДополнениеОшибки;
	
	Если Не ТихийРежим Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ТекстСообщения);
	КонецЕсли;
	
	Если ПараметрыФоновогоЗадания <> Неопределено
		И ПараметрыФоновогоЗадания.Свойство("АдресРезультата") Тогда
		ПоместитьВоВременноеХранилище(Результат, ПараметрыФоновогоЗадания.АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

// Обновляет кэш требований торговых сетей с сервиса обновлений (фоновый запуск).
//
// Параметры:
//  ПараметрыФоновогоЗадания - Структура, Неопределено - параметры ФЗ; при наличии АдресРезультата
//                             туда помещается результат ОбновитьТребованияПартнеров;
//                             ТихийРежим (Булево) — без сообщений хода выполнения
//
Процедура ОбновитьТребованияПартнеров(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	ТихийРежим = Ложь;
	Если ПараметрыФоновогоЗадания <> Неопределено
		И ПараметрыФоновогоЗадания.Свойство("ТихийРежим") Тогда
		ТихийРежим = ПараметрыФоновогоЗадания.ТихийРежим;
	КонецЕсли;
	
	Результат = КонтурЛогистика_ОбщегоНазначенияСервер.ОбновитьТребованияПартнеров(ТихийРежим);
	
	ДополнениеОшибки = "";
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ДополнениеОшибки = "; " + Результат.ТекстОшибки;
	КонецЕсли;
	
	ТекстСообщения = "Обновление требований партнеров: Успешно="
		+ Строка(Результат.Успешно)
		+ ", Количество="
		+ Строка(Результат.Количество)
		+ ДополнениеОшибки;
	
	Если Не ТихийРежим Тогда
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ТекстСообщения);
	КонецЕсли;
	
	Если ПараметрыФоновогоЗадания <> Неопределено
		И ПараметрыФоновогоЗадания.Свойство("АдресРезультата") Тогда
		ПоместитьВоВременноеХранилище(Результат, ПараметрыФоновогоЗадания.АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура АктуализироватьПартнеров(ПараметрыФоновогоЗадания) Экспорт 
	
	СинхронизируемыеПартнерыМассив = Справочники.КонтурЛогистика_Партнеры.МассивСинхронизируемыхПартнеров();
	
	РезультатВычитки = КонтурЛогистика_ИнтеграцияEDI_Сервер.ПолучитьСтруктуруДанныхТорговойСети("list");
	ТаблицаПартнеров = РезультатВычитки.Сети;
	
	Для каждого текПартнер Из СинхронизируемыеПартнерыМассив Цикл
		
		Если СокрЛП(текПартнер.КодПартнераКонтур) = "" Тогда 
			Продолжить;
		КонецЕсли;
	
		НайденнаяСтрокаТаблицы = ТаблицаПартнеров.Найти(текПартнер.КодПартнераКонтур, "Код");
		
		Если НайденнаяСтрокаТаблицы <> Неопределено 
			И НайденнаяСтрокаТаблицы.ДатаОбновления > текПартнер.ДатаОбновления Тогда
			
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Обновляем данные партнера " + НайденнаяСтрокаТаблицы.Наименование);
			
			// синхронизировать партнера (юрики, ТД, новую дату)
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("КодПартнераКонтур", НайденнаяСтрокаТаблицы.Код);
			ДанныеЗаполнения.Вставить("Наименование", НайденнаяСтрокаТаблицы.Наименование);
			ДанныеЗаполнения.Вставить("ДатаОбновления", НайденнаяСтрокаТаблицы.ДатаОбновления);
			
			ПартнерОбъект = текПартнер.ПолучитьОбъект();
			ПартнерОбъект.Заполнить(ДанныеЗаполнения);
			ПартнерОбъект.Записать();
			
		КонецЕсли;
	
	КонецЦикла;
	
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения("Все партнеры актуальны");
	
КонецПроцедуры

