
// #Область ПрограммныйИнтерфейс

// Отменяет выполнение фонового задания по переданному идентификатору.
// 
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор - идентификатор фонового задания. 
// 
Процедура ОтменитьВыполнениеЗадания(Знач ИдентификаторЗадания) Экспорт 
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат;
	КонецЕсли;
	
	Задание = НайтиЗаданиеПоИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено
		ИЛИ Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Задание.Отменить();
	Исключение
		// Возможно задание как раз в этот момент закончилось и ошибки нет.
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Длительные операции.Отмена выполнения фонового задания" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Функция ЗаданиеВыполнено(Знач ИдентификаторЗадания, Знач ИсключениеПриОшибке = Ложь, ВыводитьСообщения = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "Фоновое задание");
	Результат.Вставить("Статус", "Выполняется");
	Результат.Вставить("КраткоеПредставлениеОшибки", Неопределено);
	Результат.Вставить("ПодробноеПредставлениеОшибки", Неопределено);
	Результат.Вставить("Прогресс", Неопределено);  // В текущей версии работа с прогрессом не реализована
	Результат.Вставить("Сообщения", Неопределено);
	
	
	Задание = НайтиЗаданиеПоИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Пояснение = НСтр("ru = 'Операция не выполнена из-за аварийного завершения фонового задания.
			|Фоновое задание не найдено'") + ": " + Строка(ИдентификаторЗадания);
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Пояснение);
		Если ИсключениеПриОшибке Тогда
			ВызватьИсключение(НСтр("ru = 'Не удалось выполнить данную операцию.'"));
		КонецЕсли;
		Результат.Статус = "Ошибка";
		Результат.КраткоеПредставлениеОшибки = "Операция не выполнена из-за аварийного завершения фонового задания.";
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Задание.Наименование) Тогда 
		Результат.Вставить("Наименование", Задание.Наименование);
	КонецЕсли;
	
	// TODO реализовать вывод прогресса
	Если ВыводитьСообщения Тогда
		Результат.Сообщения = Задание.ПолучитьСообщенияПользователю();
	КонецЕсли;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Результат.Статус = "Отменено";
		Возврат Результат;
	КонецЕсли;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		
		Результат.Статус = "Ошибка";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Результат.КраткоеПредставлениеОшибки   = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
			Результат.ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		Если ИсключениеПриОшибке Тогда
			Если Не ПустаяСтрока(Результат.КраткоеПредставлениеОшибки) Тогда
				ТекстСообщения = Результат.КраткоеПредставлениеОшибки;
			Иначе
				ТекстСообщения = НСтр("ru = 'Не удалось выполнить данную операцию.'");
			КонецЕсли;
			Результат.КраткоеПредставлениеОшибки = ТекстСообщения;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Статус = "Выполнено";
	Возврат Результат;

КонецФункции

Функция НайтиЗаданиеПоИдентификатору(Знач ИдентификаторЗадания) Экспорт
	
	Если ИдентификаторЗадания = "" ИЛИ ИдентификаторЗадания = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;	
		
	Если ТипЗнч(ИдентификаторЗадания) = Тип("Строка") Тогда
		ИдентификаторЗадания = Новый УникальныйИдентификатор(ИдентификаторЗадания);
	КонецЕсли;
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Возврат Задание;
	
КонецФункции

// #КонецОбласти

// #Область Вспомогательные

Функция ВыполнитьВФоне(Метод,
						ПараметрыМетодаСтруктура = Неопределено,
						КлючФЗ = Неопределено,
						НаименованиеФЗ = "Фоновая задача",
						АдресРезультатаФЗ = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", НаименованиеФЗ);
	Результат.Вставить("Статус",    "Выполняется");
	Результат.Вставить("ИдентификаторЗадания", Неопределено);
	Результат.Вставить("КраткоеПредставлениеОшибки", "");
	Результат.Вставить("ПодробноеПредставлениеОшибки", "");
	Результат.Вставить("Прогресс", Неопределено);  // В текущей версии работа с прогрессом не реализована
	Результат.Вставить("Сообщения", Неопределено);
	
	// проверка файловой базы без менеджера ФЗ и режима отладки
	ВыполнитьБезФоновогоЗадания = Ложь;
	ВыполнитьБезФоновогоЗадания = (КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РежимОтладки() 
									Или Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.МенеджерФоновыхЗаданийДоступен());
	
	// Выполнить в основном потоке.
	Если ВыполнитьБезФоновогоЗадания Тогда
		
		Попытка
		
			ВыполнитьБезФоновогоЗадания(Метод, ПараметрыМетодаСтруктура, АдресРезультатаФЗ);
			Результат.Статус = "Выполнено";
		
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			Результат.Статус = "Ошибка";
			Результат.КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			Результат.ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			
			КонтурЛогистика_Метрика.ОбработатьОшибку("ВыполнитьВФоне", ИнформацияОбОшибке);
			
		КонецПопытки;
		
		Возврат Результат;
		
	КонецЕсли;
	
	// Выполнить в фоне.
	Попытка
		
		Задание = ЗапуститьФоновоеЗадание(Метод,
											ПараметрыМетодаСтруктура,
											КлючФЗ,
											НаименованиеФЗ,
											АдресРезультатаФЗ);
	Исключение
		
		Результат.Статус = "Ошибка";
		
		Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ИнформацияОбОшибке = Задание.ИнформацияОбОшибке;
		Иначе
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонецЕсли;
		
		Результат.КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Результат.ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗапуститьФоновоеЗадание", ИнформацияОбОшибке);
		
		Возврат Результат;
		
	КонецПопытки;
	
	Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
		Результат.Статус = "Ошибка";
		Результат.КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		Результат.ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		Возврат Результат;
	КонецЕсли;
	
	Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	
	ЗаполнитьЗначенияСвойств(Результат, ЗаданиеВыполнено(Задание.УникальныйИдентификатор), , "Сообщения");
	
	Возврат Результат;

КонецФункции

// для вызова использовать ВыполнитьВФоне (умеет определять активен ли менеджер фоновых заданий и запускать как фоновое или нет) 
Функция ЗапуститьФоновоеЗадание(Метод,
								ПараметрыМетодаСтруктура = Неопределено,
								КлючФЗ = Неопределено,
								НаименованиеФЗ = "Фоновая задача",
								АдресРезультатаФЗ = Неопределено)

	Попытка
		
		Если (КлючФЗ = Неопределено) Тогда
			КлючФЗ = Метод;
		КонецЕсли;
		
		//@skip-warning
		РезультатФоновогоЗадания = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФоновогоЗадания();
		
		Если ПараметрыМетодаСтруктура = Неопределено Тогда
			ПараметрыМетодаСтруктура = Новый Структура();
		КонецЕсли;
		Если АдресРезультатаФЗ <> Неопределено Тогда
			ПараметрыМетодаСтруктура.Вставить("АдресРезультата", АдресРезультатаФЗ);
		КонецЕсли;
		
		ПараметрыМетодаМассив = Новый Массив();
		ПараметрыМетодаМассив.Добавить(ПараметрыМетодаСтруктура);
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИмяМетода", Метод);
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		
		НайденныеФЗ = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Если НайденныеФЗ.Количество() = 0 Тогда
			// Запустим новое
			Задание = ФоновыеЗадания.Выполнить(Метод, ПараметрыМетодаМассив, КлючФЗ, НаименованиеФЗ);
		Иначе
			// Уже запущенно
			Задание = НайденныеФЗ[0];
		КонецЕсли;
		
		Возврат Задание;
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		ВызватьИсключение "Не удалось запустить фоновое задание " + НаименованиеФЗ +  " по причине: " + ОписаниеОшибки;
		
	КонецПопытки;
	
КонецФункции

Процедура ВыполнитьБезФоновогоЗадания(Знач ИмяМетода, Знач Параметры = Неопределено, АдресРезультатаФЗ = Неопределено)

	ПараметрыВызываемогоМетодаСтрока = "";
	
	Если Параметры = Неопределено 
		ИЛИ ТипЗнч(Параметры) <> Тип("Структура")
		ИЛИ Параметры.Количество() = 0 Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Если Не Параметры.Свойство("АдресРезультата") Тогда 
		Параметры.Вставить("АдресРезультата", АдресРезультатаФЗ);
	КонецЕсли;
	
	Выполнить ИмяМетода + "(Параметры)";
	
КонецПроцедуры

// #КонецОбласти

// #Область Прикладные

Процедура УдалитьСтарыеДанные(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		КонтурЛогистика_ОбработкаДокументовСервер.УдалитьСтарыеДанные();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при очистке старых данных по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
КонецПроцедуры

Процедура РассчитатьСчетчикиПереходов(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	Период = ПараметрыФоновогоЗадания.Период;
	
	СтруктураСчетчиков = КонтурЛогистика_ОбщегоНазначенияСервер.СтруктураСчетчиковРабочегоСтола();
	СтруктураСчетчиков.Вставить("ДанныеГраницы", Справочники.КонтурЛогистика_ОрганизацииДиадок.ПолучитьОбщуюМинимальнуюДатуГраницыСинхронизации());
	
	ПоместитьВоВременноеХранилище(СтруктураСчетчиков, ПараметрыФоновогоЗадания.АдресРезультата);
	
	Для Каждого Счетчик Из СтруктураСчетчиков Цикл
		
		Задач = 0;
		Ошибок = 0;
		Если Счетчик.Ключ = "ДанныеГраницы" Тогда
			Продолжить;
		ИначеЕсли Счетчик.Ключ = "ТрН_Титул7" Тогда 
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4;
			ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7;
		ИначеЕсли Счетчик.Ключ = "ТрН_Титул13" Тогда 
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул3ПослеТитула7;
			ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
		ИначеЕсли Счетчик.Ключ = "ТрН_Титул14" Тогда 
			СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул4ПоВозврату;
			ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4;
		Иначе
			СпецСценарий = Неопределено;
			ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СсылкаПоИмени(Счетчик.Ключ);
		КонецЕсли;
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика,, СпецСценарий);
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
			Настроено = Истина;
		Иначе
			Настроено = (КонтекстНастройкиКонвертации.ЕстьНастройкаКонвертации Или КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация);
		КонецЕсли;
		ОшибкаЗапроса = Ложь;
		
		Если Настроено Тогда
			
			Запрос = Новый Запрос;
			
			Попытка
				
				РезультатаФормированияЗапроса = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СформироватьТекстЗапросаСпискаЗадач(
					ТипЛогистика,, СпецСценарий, КонтекстНастройкиКонвертации);
				
				ПолныйТекстЗапроса = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
				
				Если Найти(ВРег(ПолныйТекстЗапроса), "РАЗРЕШЕННЫЕ") = 0 Тогда
					РезультатаФормированияЗапроса.ПолныйТекстЗапроса = СтрЗаменитьПервое(ПолныйТекстЗапроса , "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
				КонецЕсли;	
				
			Исключение
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ОписаниеОшибки());
				ОшибкаЗапроса = Истина;
				
				Счетчик.Значение.Задач = Задач;
				Счетчик.Значение.Ошибок = Ошибок;
				Счетчик.Значение.Настроено = Настроено;
				Счетчик.Значение.ОшибкаЗапроса = ОшибкаЗапроса;
				
				Продолжить;
				
			КонецПопытки;
			
			КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
				"СписокЗадач_ЗаменитьТекстЗапросаСпискаЗадачИнтеграция",
				Ложь,
				Новый Структура("РезультатаФормированияЗапроса, ТипЛогистика", РезультатаФормированияЗапроса, ТипЛогистика));
				
			Запрос.Текст = РезультатаФормированияЗапроса.ПолныйТекстЗапроса;
			Для Каждого ПараметрЗапроса Из РезультатаФормированияЗапроса.СтруктураПараметровЗапроса Цикл
				Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
			КонецЦикла;
			
			Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
			Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда 
				Запрос.УстановитьПараметр("НачалоПериодаПоследующийТитул", Период.ДатаНачала);
			Иначе
				Запрос.УстановитьПараметр("НачалоПериодаПоследующийТитул", Период.ДатаНачала - 5 * 86400);
			КонецЕсли;
			
			// Определяем дополнительные параметры запроса в зависимости от типа титула и специального сценария
			ПараметрыСписка = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПараметрыСпискаПоТипуЛогистики(
				ТипЛогистика, СпецСценарий);
			Для Каждого ТекущийПараметр Из ПараметрыСписка Цикл
				Запрос.УстановитьПараметр(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
			КонецЦикла;
			
			СекундВЧасе = 60 * 60;
			СмещениеОкончанияПериода = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СмещениеОкончанияПериодаСпискаЗадач") * СекундВЧасе;
			ОкончаниеПериода = Период.ДатаОкончания + СмещениеОкончанияПериода;
			
			Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
			Запрос.УстановитьПараметр("ОкончаниеПериодаПоследующийТитул", ОкончаниеПериода + 5 * 86400);
			Запрос.УстановитьПараметр("НаправлениеКонвертации", КонтекстНастройкиКонвертации.НаправлениеКонвертации);
			
			Попытка
				
				Результат = Запрос.Выполнить();
				
			Исключение
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ОписаниеОшибки());
				ОшибкаЗапроса = Истина;
				
				Счетчик.Значение.Задач = Задач;
				Счетчик.Значение.Ошибок = Ошибок;
				Счетчик.Значение.Настроено = Настроено;
				Счетчик.Значение.ОшибкаЗапроса = ОшибкаЗапроса;
				
				Продолжить;
				
			КонецПопытки;
			
			Выборка = Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
					
					ОсобенностьДокументооборотаЗаполнена = ЗначениеЗаполнено(Выборка.ОсобенностиДокументооборота);
				Иначе
					ОсобенностьДокументооборотаЗаполнена = Ложь;
				КонецЕсли;
				
				// Текущее ТребуемоеДействие
				Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
					Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
					
					ТекущееТребуемоеДействие = КонтурЛогистика_ОбработкаДокументовСервер.ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(
						Выборка.ТребуемоеДействие, Выборка.ДокументЛогистика);
				Иначе
					ТекущееТребуемоеДействие = Выборка.ТребуемоеДействие;
				КонецЕсли;
				
				Если ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Обработать
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Переотправить
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
					Или ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю
					Или ОсобенностьДокументооборотаЗаполнена Тогда
					
					Задач = Задач + 1;
					
				ИначеЕсли ТекущееТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ИсправитьОшибки Тогда
					
					Ошибок = Ошибок + 1;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Связи документов
		Если Счетчик.Значение.СвязиДокументов <> Неопределено Тогда
			Для Каждого ТекущаяСвязьДокументов Из Счетчик.Значение.СвязиДокументов Цикл
				ТекущаяСвязьДокументов.Задач = РегистрыСведений.КонтурЛогистика_СвязиДокументов.СчетчикПоОтбору(
					Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.ВОчереди, Период,
					ТекущаяСвязьДокументов.ТипДокументаОсновной, ТекущаяСвязьДокументов.ТипДокументаПодчиненный);
				ТекущаяСвязьДокументов.Ошибок = РегистрыСведений.КонтурЛогистика_СвязиДокументов.СчетчикПоОтбору(
					Перечисления.КонтурЛогистика_СтатусыСвязейДокументов.Ошибка, Период,
					ТекущаяСвязьДокументов.ТипДокументаОсновной, ТекущаяСвязьДокументов.ТипДокументаПодчиненный);
			КонецЦикла;
		КонецЕсли;
		
		Счетчик.Значение.Задач = Задач;
		Счетчик.Значение.Ошибок = Ошибок;
		Счетчик.Значение.Настроено = Настроено;
		Счетчик.Значение.ОшибкаЗапроса = ОшибкаЗапроса;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(СтруктураСчетчиков, ПараметрыФоновогоЗадания.АдресРезультата);
	
КонецПроцедуры

Процедура ЗагрузкаСобытийИВходящихДокументов(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	ЗагрузкаСобытийЛентыСобытий(ПараметрыФоновогоЗадания);
	
	ОбработкаСобытийЛентыСобытий();
	
КонецПроцедуры

Процедура ЗагрузкаСобытийЛентыСобытий(Организации = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		// Диадок
		КонтурЛогистика_API_Диадок.ОбработатьВсеЛентыСобытий(Организации);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при загрузке событий ленты Диадок и по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
		// Логистика
		КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОбработатьВсеЛентыСобытий(Организации);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при загрузке событий ленты Логистики и по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Переменные = Новый Структура;
	Переменные.Вставить("Организации", Новый Массив);
	Если Организации <> Неопределено Тогда
		Для Каждого ТекущаяОрганизация Из Организации Цикл
			Переменные.Организации.Добавить(Строка(ТекущаяОрганизация));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаСобытийЛентыСобытий() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивПолученныхФайлов = Неопределено;
	
	Попытка
		
		// Создание титулов
		КонтурЛогистика_ОбработкаДокументовСервер.СоздатьТитулыПоЗагруженнымФайламОбмена(МассивПолученныхФайлов);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при обработке загруженных файлов (создании титулов) по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
		// Обработки входящих документов роботами
		Справочники.КонтурЛогистика_СценарииАвтоматическойРаботы.ВыполнитьВсеАктивныеСценарииОбработкиВходящихДокументов();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при обработке входящих документов по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
		// Печатные формы в присоединенные файлы
		СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы(МассивПолученныхФайлов);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при сохранении печатных форм в присоединенные файлы: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
		// Сохранение архивов документооборота
		СохранятьАрхивДокументооборотаВКаталог(МассивПолученныхФайлов);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при сохранении архива документооборота в каталог по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
		КонтурЛогистика_ОбновлениеСервер.ПолучитьУведомленияИзСервиса(Истина);
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при получении уведомлений из сервиса: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправитьГотовыеКОтправкеДокументы(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьВсеФайлыОжидающиеОтправки();	
	
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при отправке файлов по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
	КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьВсеДокументыБезФайловОжидающиеОтправки();	
	
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при отправке документов по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправкаОбработкаПроизвольныхДанных(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьПроизволныеДанные();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при отправке произвольных данных: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Попытка
		
		КонтурЛогистика_КонвертацияСервер.ОбработатьПроизвольныеДанныеРС();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при обработке произвольных данных РС: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьОбмен(ПараметрыФоновогоЗадания = Неопределено) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФоновогоЗадания();
	Результат.Успешно = Истина;
	
	Текст = "ПРОВЕРЯЕМ МЧД";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_МашиночитаемыеДовернностиСервер.ВыполнитьПроверкуМЧД();
	Результат.Прогресс = 10;
	
	Текст = "ЧИТАЕМ ЛЕНТЫ СОБЫТИЙ Апи Логистика";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	Успешно = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОбработатьВсеЛентыСобытий();
	Результат.Прогресс = 20;
	Результат.Успешно = Мин(Результат.Успешно, Успешно);
	Если ПараметрыФоновогоЗадания <> Неопределено И ПараметрыФоновогоЗадания.Свойство("АдресРезультата") Тогда 
		ПоместитьВоВременноеХранилище(Результат, ПараметрыФоновогоЗадания.АдресРезультата);
	КонецЕсли;
	
	Текст = "ЧИТАЕМ ЛЕНТЫ СОБЫТИЙ Диадок";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	Успешно = КонтурЛогистика_API_Диадок.ОбработатьВсеЛентыСобытий();
	Результат.Прогресс = 40;
	Результат.Успешно = Мин(Результат.Успешно, Успешно);
	Если ПараметрыФоновогоЗадания <> Неопределено И ПараметрыФоновогоЗадания.Свойство("АдресРезультата") Тогда 
		ПоместитьВоВременноеХранилище(Результат, ПараметрыФоновогоЗадания.АдресРезультата);
	КонецЕсли;
	
	МассивПолученныхФайлов = Неопределено;
	
	Текст = "СОЗДАЕМ ТИТУЛЫ ИЗ ФАЙЛОВ";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_ОбработкаДокументовСервер.СоздатьТитулыПоЗагруженнымФайламОбмена(МассивПолученныхФайлов);
	Результат.Прогресс = 60;
	Если ПараметрыФоновогоЗадания <> Неопределено И ПараметрыФоновогоЗадания.Свойство("АдресРезультата") Тогда 
		ПоместитьВоВременноеХранилище(Результат, ПараметрыФоновогоЗадания.АдресРезультата);
	КонецЕсли;
	
	Текст = "ОБРАБАТЫВАЕМ OUTERDOCFLOWS ВХОДЯЩИХ ФАЙЛОВ ОБМЕНА";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьOuterDocflowsНеобработанныхФайлов();
	
	Текст = "ОТПРАВЛЯЕМ ГОТОВЫЕ ФАЙЛЫ ОБМЕНА";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьВсеФайлыОжидающиеОтправки();
	
	Текст = "ОТПРАВЛЯЕМ ГОТОВЫЕ ДОКУМЕНТЫ";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьВсеДокументыБезФайловОжидающиеОтправки();
	
	Текст = "ОТПРАВЛЯЕМ ПРОИЗВОЛЬНЫЕ ДАННЫЕ В СЕРВИС";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_ИнтеграцияAPI_ЛогистикаСервер.ОтправитьПроизволныеДанные();
	
	Текст = "ОБРАБАТЫВАЕМ ПОЛУЧЕННЫЕ ПРОИЗВОЛЬНЫЕ ДАННЫЕ";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_КонвертацияСервер.ОбработатьПроизвольныеДанныеРС();
	
	Текст = "ПОЛУЧАЕМ УВЕДОМЛЕНИЯ";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	КонтурЛогистика_ОбновлениеСервер.ПолучитьУведомленияИзСервиса(Истина);
	
	Текст = "ОБМЕН ЗАВЕРШЕН";
	КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
	
	Результат.Прогресс = 100;
	Если ПараметрыФоновогоЗадания <> Неопределено И ПараметрыФоновогоЗадания.Свойство("АдресРезультата") Тогда
		Если Не Результат.Успешно Тогда
			// Зафиксируем лог
			Для Каждого ТекущееСообщение Из ПолучитьСообщенияПользователю() Цикл
				Результат.МассивОшибок.Добавить(ТекущееСообщение.Текст);
			КонецЦикла;
		КонецЕсли;
		
		ПоместитьВоВременноеХранилище(Результат, ПараметрыФоновогоЗадания.АдресРезультата);
	КонецЕсли;
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы(МассивПолученныхФайлов);
	
	СохранятьАрхивДокументооборотаВКаталог(МассивПолученныхФайлов);
	
	ОбновлятьФизическиеЛицаСотрудниковИзСервиса();
	
	СинхронизироватьОрганизацииИзДиадокаПослеОбмена();
	
	КонтурЛогистика_Метрика.ОтправитьМетрикиВремениТранспорта();
	
КонецПроцедуры

Процедура СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы(МассивПолученныхФайлов)
	
	СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы");
	Если СохранятьПечатнуюФормуЭПДВПрисоединенныеФайлы Тогда
		ДатаГраницы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ДатаГраницыПолученияПечатныхФормЭПД");
		
		ОтборФайлов = Новый Структура;
		ОтборФайлов.Вставить("ФайлОбменаДатаНачала", ДатаГраницы);
		ОтборФайлов.Вставить("ФайлыОбмена", МассивПолученныхФайлов);
		
		ПараметрыФоновогоЗадания = Новый Структура;
		ПараметрыФоновогоЗадания.Вставить("ОтборФайлов", ОтборФайлов);
		ПараметрыФоновогоЗадания.Вставить("ТихийРежим", Истина);
		
		ВыполнитьВФоне("КонтурЛогистика_ДлительныеОперацииСервер.ДобавитьПечатныеФормыЭПДВПрисоединенныеФайлы",
			ПараметрыФоновогоЗадания, "КлючФЗ_ДобавитьПечатныеФормуЭПДВПрикрепленныеФайлы", "Добавление печатных форм ЭПД в присоединенные файлы");
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранятьАрхивДокументооборотаВКаталог(МассивПолученныхФайлов)
	
	СохранятьАрхивДокументооборотаВКаталог = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
