Процедура СинхронизироватьКонтрагентовОрганизацииДиадок(ПараметрыФоновогоЗадания) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФоновогоЗадания();
	Результат.Успешно = Истина;
	
	Сч = 1;
	Для Каждого ОрганизацияДД Из ПараметрыФоновогоЗадания.МассивОрганизаций Цикл 
			
		Если Не ОрганизацияДД.Наш Тогда 
			Сообщить("" + ОрганизацияДД + " не отмечена как наша, контрагенты не загружены");
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			КолвоОрганизаций = ПараметрыФоновогоЗадания.МассивОрганизаций.Количество();
			
			ПараметрыФоновогоЗадания.Вставить("Результат", Результат);
			ПараметрыФоновогоЗадания.Вставить("КолвоОрганизаций", КолвоОрганизаций);
															
			Справочники.КонтурЛогистика_ОрганизацииДиадок.СинхронизироватьКонтрагентовОрганизации(ОрганизацияДД, ПараметрыФоновогоЗадания);
			
			Если КолвоОрганизаций > 1 Тогда 
				Текст = Строка(ОрганизацияДД);
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Текст);
				Результат.Прогресс = Окр(Сч / КолвоОрганизаций * 100);
				ПоместитьВоВременноеХранилище(ПараметрыФоновогоЗадания.Результат, ПараметрыФоновогоЗадания.АдресРезультата);
				Сч = Сч + 1;			
			КонецЕсли;
			
		Исключение
			
			Сообщить("Неудача при вычитывании данных из Диадок по Организации: " + ОрганизацияДД + " - " + ОписаниеОшибки());
			
		КонецПопытки;
						
	КонецЦикла;		
	
КонецПроцедуры

Процедура ОбновитьСтатусГотовКЭПДИзДиадокаУВсехОрганизаций(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	СинхронизироватьРеквизитыОрганизацийИзДиадока(ПараметрыФоновогоЗадания);
			
КонецПроцедуры

// Запрашивает сведения о подписках и оплате по нашим организациям с авторизацией и сохраняет в регистр произвольных данных.
//
// Параметры:
//  ПараметрыФоновогоЗадания - Структура, Неопределено - зарезервировано для фонового задания
//
Процедура СинхронизироватьДанныеПодписокИОплаты(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	СинхронизироватьДанныеПодписокИОплатыСОтчетом(ПараметрыФоновогоЗадания, Ложь);
	
КонецПроцедуры

// Запрашивает сведения о подписках и оплате и возвращает отчёт о результатах синхронизации.
//
// Параметры:
//  ПараметрыФоновогоЗадания - Структура, Неопределено
//  РегистрироватьМетрикуФормы - Булево - зарегистрировать метрику результата запроса формы
//
// Возвращаемое значение:
//  Структура - Всего, Успешно, Ошибка, ВремяМс, Ошибки
//
Функция СинхронизироватьДанныеПодписокИОплатыСОтчетом(ПараметрыФоновогоЗадания = Неопределено,
	РегистрироватьМетрикуФормы = Ложь) Экспорт
	
	Отчет = Новый Структура;
	Отчет.Вставить("Всего", 0);
	Отчет.Вставить("Успешно", 0);
	Отчет.Вставить("Ошибка", 0);
	Отчет.Вставить("ВремяМс", 0);
	Отчет.Вставить("Ошибки", Новый Массив);
	
	Если Не КонтурЛогистика_ПодпискиИОплатаСервер.ПодпискиИОплатаДоступны() Тогда
		Возврат Отчет;
	КонецЕсли;
	
	МассивОрганизаций = Неопределено;
	
	Если ПараметрыФоновогоЗадания <> Неопределено
		И ПараметрыФоновогоЗадания.Свойство("МассивОрганизаций") Тогда
		МассивОрганизаций = ПараметрыФоновогоЗадания.МассивОрганизаций;
	КонецЕсли;
	
	Если МассивОрганизаций <> Неопределено Тогда
		ОрганизацииДляСинхронизации = МассивОрганизаций;
	Иначе
		ОрганизацииДляСинхронизации = Справочники.КонтурЛогистика_ОрганизацииДиадок.ВсеНашиОрганизации();
	КонецЕсли;
	
	КоличествоОрганизаций = ОрганизацииДляСинхронизации.Количество();
	Сч = 0;
	НачалоСинхронизации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Для Каждого Организация Из ОрганизацииДляСинхронизации Цикл
		
		Если КонтурЛогистика_ПодпискиИОплатаСервер.ОрганизацияИсключенаИзПодписокИОплаты(Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(Организация);
		
		Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
			Продолжить;
		КонецЕсли;
		
		Отчет.Всего = Отчет.Всего + 1;
		РезультатОрганизации = СинхронизироватьДанныеПодписокИОплатыОрганизации(Организация, ПараметрыСервиса);
		
		Если РезультатОрганизации.Успешно Тогда
			Отчет.Успешно = Отчет.Успешно + 1;
		Иначе
			Отчет.Ошибка = Отчет.Ошибка + 1;
			Отчет.Ошибки.Добавить(РезультатОрганизации);
		КонецЕсли;
		
		Если КоличествоОрганизаций > 1 Тогда
			
			Сч = Сч + 1;
			КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(Строка(Организация));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Отчет.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСинхронизации;
	
	Если РегистрироватьМетрикуФормы Тогда
		КонтурЛогистика_ПодпискиИОплатаСервер.ЗарегистрироватьМетрикуРезультатаЗапросаФормыПодписокИОплаты(Отчет);
	КонецЕсли;
	
	Возврат Отчет;
	
КонецФункции

Функция СинхронизироватьДанныеПодписокИОплатыОрганизации(Организация, ПараметрыСервиса)
	
	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("BoxId", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("Организация", Организация);
	
	BoxId = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(Организация, "ID");
	Результат.BoxId = BoxId;
	
	Если Не ЗначениеЗаполнено(BoxId) Тогда
		
		Результат.ТекстОшибки = "У организации не заполнен идентификатор ящика (ID).";
		ЗаписатьСведенияПодписокИОплатыОрганизацииВРегистр(
			Организация,
			Неопределено,
			Результат.ТекстОшибки);
		Возврат Результат;
		
	КонецЕсли;
	
	Попытка
		
		ОтветAPI = КонтурЛогистика_API_Логистика.ПолучитьИнформациюОЛицевыхСчетах(ПараметрыСервиса, BoxId);
		
		Если Не ОтветAPI.Успешно Тогда
			
			ТекстОшибки = ОтветAPI.ОписаниеОшибки;
			
			Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
				ТекстОшибки = "Не удалось получить сведения о лицевых счетах. Код состояния: " + Строка(ОтветAPI.КодСостояния);
			КонецЕсли;
			
			Результат.ТекстОшибки = ТекстОшибки;
			Результат.КодСостояния = ОтветAPI.КодСостояния;
			ЗаписатьСведенияПодписокИОплатыОрганизацииВРегистр(Организация, Неопределено, ТекстОшибки);
			Возврат Результат;
			
		КонецЕсли;
		
		ДанныеРазбора = КонтурЛогистика_API_Логистика.РазобратьИнформациюОЛицевыхСчетах(ОтветAPI.ДанныеAPI, BoxId);
		ЗаписатьСведенияПодписокИОплатыОрганизацииВРегистр(Организация, ДанныеРазбора, "");
		Результат.Успешно = Истина;
		
	Исключение
		
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьСведенияПодписокИОплатыОрганизацииВРегистр(Организация, Неопределено, Результат.ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьСведенияПодписокИОплатыОрганизацииВРегистр(Организация, ДанныеРазбора, ТекстОшибки)
	
	ТипДанных = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.ТипыДанных().ПодпискиИОплата;
	ПустойРазрез2 = Перечисления.КонтурЛогистика_ТипыПоказанийТоплива.ПустаяСсылка();
	
	НаборЗаписей = РегистрыСведений.КонтурЛогистика_ПроизвольныеДанные.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ОрганизацияДиадок.Установить(Организация);
	НаборЗаписей.Отбор.ТипДанных.Установить(ТипДанных);
	НаборЗаписей.Отбор.Разрез1.Установить("");
	НаборЗаписей.Отбор.Разрез2.Установить(ПустойРазрез2);
	НаборЗаписей.Отбор.Разрез3.Установить("");
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ОрганизацияДиадок = Организация;
	НоваяЗапись.ТипДанных = ТипДанных;
	НоваяЗапись.Разрез1 = "";
	НоваяЗапись.Разрез2 = ПустойРазрез2;
	НоваяЗапись.Разрез3 = "";
	НоваяЗапись.Дата = КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК();
	НоваяЗапись.ТекстОшибки = ТекстОшибки;
	
	Если ДанныеРазбора <> Неопределено Тогда
		НоваяЗапись.ДанныеХранилище = Новый ХранилищеЗначения(ДанныеРазбора, Новый СжатиеДанных(6));
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура СинхронизироватьРеквизитыОрганизацийИзДиадока(ПараметрыФоновогоЗадания = Неопределено) Экспорт
	
	МассивОрганизаций = Неопределено;
	
	Если ПараметрыФоновогоЗадания <> Неопределено
		И ПараметрыФоновогоЗадания.Свойство("МассивОрганизаций") Тогда
		МассивОрганизаций = ПараметрыФоновогоЗадания.МассивОрганизаций;
	КонецЕсли;
	
	Справочники.КонтурЛогистика_ОрганизацииДиадок.СинхронизироватьРеквизитыОрганизацийИзДиадока(МассивОрганизаций);
	
КонецПроцедуры 

Функция СтрЗаменитьПервое(Знач Строка, Знач ПодстрокаПоиска, Знач ПодстрокаЗамены)
	Позиция = Найти(Строка, ПодстрокаПоиска);
	Если Позиция > 0 Тогда
		Возврат Лев(Строка, Позиция - 1) + ПодстрокаЗамены + Сред(Строка, Позиция + СтрДлина(ПодстрокаПоиска));
	КонецЕсли;
	Возврат Строка;
КонецФункции