		Для Каждого Элемент Из ВОрганизациюДиадок Цикл
			ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование[Элемент.Значение], Элемент.Ключ,
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
		КонецЦикла;
		
		ВПунктМаршрута = Новый Структура("АдрГруз, АдрПунктНазн", "АдресДоставкиПеревозчика", "АдресДоставки"); 
		Для Каждого Элемент Из ВПунктМаршрута Цикл
			ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование[Элемент.Значение], Элемент.Ключ,
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
				ДокументОснование, ДокументОбъект);
		КонецЦикла;
		
		ДокументОбъект.ВрДостГрС = ДокументОснование.ВремяДоставкиС;
		ДокументОбъект.ВрДостГрПо = ДокументОснование.ВремяДоставкиПо;
		
		Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С("643", "руб");
		ДокументОбъект.ВалютаУчетаГруза = Валюта;
		ДокументОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
		// ТЧ Товары
		Для Каждого ТоварОснования Из ДокументОснование.Товары Цикл
			
			// При разделении ПЭ_ЗаявкаНаМаршрут — только строки текущего разделителя
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТоварОснования, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
			НоваяСтрока.Номенклатура = ТоварОснования.Номенклатура;
			НоваяСтрока.Количество = ТоварОснования.Количество;
			НоваяСтрока.УпаковкаЕдиницаИзмерения = ТоварОснования.Упаковка;
			НоваяСтрока.Характеристика = ТоварОснования.Характеристика;
			
			НоваяСтрока.СтоимостьГруза = ТоварОснования.Сумма;
			НоваяСтрока.ВалютаУчетаГруза = Валюта;
			НоваяСтрока.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
			
		КонецЦикла;
	
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
 		И КонтекстНастройкиКонвертации.ТипДокумента1С = "УчетнаяСистема_РеализацияТоваровУслуг" Тогда
		
		    ДокументОбъект.НомДок = ДокументОснование.НомерПЭ;
			ДокументОбъект.ДатаДок = ДокументОснование.Дата;
		
			ДокументОбъект.ДогТрЭксп = ДокументОснование.Договор;
			
			ВОрганизациюДиадок = Новый Структура("СвКлиент, СвЭксп", "Организация", "ПеревозчикПартнер"); 
			Для Каждого Элемент Из ВОрганизациюДиадок Цикл
				ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
				ДокументОснование[Элемент.Значение], Элемент.Ключ,
				Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
				ДокументОснование, ДокументОбъект);
			КонецЦикла;
		
			НоваяСтрока = ДокументОбъект.ДокументыОснованияМаршрутов.Добавить();
	 		НоваяСтрока.ДокументОснование = ДокументОснование;
			
 	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
 		И КонтекстНастройкиКонвертации.ТипДокумента1С = "УчетнаяСистема_ТранспортнаяНакладная" Тогда
			
			ДокументОбъект.НомДок = ДокументОснование.Номер;
			ДокументОбъект.ДатаДок = ДокументОснование.Дата;
			
			ВОрганизациюДиадок = Новый Структура("СвКлиент, СвЭксп", "Организация", "Перевозчик");
			Для Каждого Элемент Из ВОрганизациюДиадок Цикл
				ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
					ДокументОснование[Элемент.Значение], Элемент.Ключ,
					Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
					ДокументОснование, ДокументОбъект);
			КонецЦикла;
			
			// Основания маршрутов — связанные реализации/перемещения из ТН
			Для Каждого СтрокаОснования Из ДокументОснование.ДокументыОснования Цикл
				
				// При разделении ПЭ_Титул1 — только строки текущего разделителя
				Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					СтрокаОснования, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
					Продолжить;
				КонецЕсли;
						
				НоваяСтрока = ДокументОбъект.ДокументыОснованияМаршрутов.Добавить();
				НоваяСтрока.ДокументОснование = СтрокаОснования.ДокументОснование;
				
			КонецЦикла;
 	
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыДокументаОснования
//
Функция ВычислитьРеквизитыДокументаОснования(ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	ДокументОснование = ДокументОбъект.ДокументОснование;
	
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И КонтекстНастройкиКонвертации.ТипДокумента1С = "УчетнаяСистема_ТранспортнаяНакладная" Тогда
		
		Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Грузоотправитель);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Перевозчик", ДокументОснование.Перевозчик);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("Грузополучатель") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Грузополучатель", ДокументОснование.Грузополучатель);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ДокументОснование.ЗаданиеНаПеревозку.ТранспортноеСредство);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("МестоПогрузки") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("МестоПогрузки", ДокументОснование.ЗаданиеНаПеревозку.Склад);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("МестоДоставки") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("МестоДоставки", ДокументОснование.АдресДоставкиЗначение);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("ЭкспедицияЗаказчик") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("ЭкспедицияЗаказчик", ДокументОснование.ЗаказчикПеревозки);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Водитель", ДокументОснование.ЗаданиеНаПеревозку.Водитель);
		КонецЕсли;
		
	ИначеЕсли (КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02)
		И КонтекстНастройкиКонвертации.ТипДокумента1С = "УчетнаяСистема_ЗаданиеНаПеревозку" Тогда
		
		Если ИменаРеквизитов.Найти("ЛицоОформившееПЛ") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("ЛицоОформившееПЛ", ДокументОснование.Организация);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("Водитель") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Водитель", ДокументОснование.Водитель);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("ТранспортноеСредство") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("ТранспортноеСредство", ДокументОснование.ТранспортноеСредство);
		КонецЕсли;
		
		Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
			Если ИменаРеквизитов.Найти("МестоОтправления") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("МестоОтправления", ДокументОснование.Склад);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		И КонтекстНастройкиКонвертации.ТипДокумента1С = "УчетнаяСистема_ЗаданиеНаПеревозку" Тогда
		
		Если ИменаРеквизитов.Найти("Перевозчик") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Перевозчик", ДокументОснование.Перевозчик);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("Грузоотправитель") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("Грузоотправитель", ДокументОснование.Организация);
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
		И КонтекстНастройкиКонвертации.ТипДокумента1С = "УчетнаяСистема_РеализацияТоваровУслуг" Тогда
		
		Если ИменаРеквизитов.Найти("АдрГруз") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("АдрГруз", ДокументОснование.АдресДоставкиПеревозчика);
		КонецЕсли;
		
		Если ИменаРеквизитов.Найти("АдрПунктНазн") <> Неопределено Тогда
			ЗначенияРеквизитов.Вставить("АдрПунктНазн", ДокументОснование.АдресДоставки);
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

#КонецОбласти

#Область КонвертацияСправочников

// См. КонтурЛогистика_КонвертацияТиповые.ПоддерживаемыеТипыСправочниковКонфигурации1С
//
Функция ПоддерживаемыеТипыСправочниковКонфигурации1С(ТипСправочникаЛогистика) Экспорт
	
	ТипыДокументовКонфигурации1С = Новый Массив;
	
	Если ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_ФизическиеЛица");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_Контрагенты");
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_Организации");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_Склады");
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_ТранспортнаяНакладная");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_ТранспортныеСредства");
		
	ИначеЕсли ТипСправочникаЛогистика = "КонтурЛогистика_Договоры" Тогда
		
		ТипыДокументовКонфигурации1С.Добавить("УчетнаяСистема_ДоговорыКонтрагентов");
		
	КонецЕсли;
	
	Возврат ТипыДокументовКонфигурации1С;
	
КонецФункции

// См. КонтурЛогистика_КонвертацияТиповые.ЗаполнитьБазовыеНастройкиКонвертацииСправочника
//
Процедура ЗаполнитьБазовыеНастройкиКонвертацииСправочника(КонтекстНастройкиКонвертации) Экспорт
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ФизическиеЛица") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_Организации") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_Склады"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ТранспортнаяНакладная") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ТранспортныеСредства") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И (КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = Неопределено
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ДоговорыКонтрагентов") Тогда
		
		КонтекстНастройкиКонвертации.ЕстьТиповаяКонвертация = Истина;
		КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту
//
Процедура ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(КонтекстНастройкиКонвертации, Параметры, Результат) Экспорт
	
	УчетныйОбъект = Параметры.УчетныйОбъект;
	
	// Могуть быть незаполненными!
	ДокументОснование = Параметры.ДокументОснование;  // От заполненности этого параметра зависит заполненность РеквизитаТитула!
	ДокументОбъект = Параметры.ДокументОбъект;
	Переменные = Параметры.Переменные;
	
	ОбновлятьРеквизиты = КонтекстНастройкиКонвертации.ОбновлятьРеквизитыИзУчетнойСистемы;
	
	Если КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Сотрудники"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ФизическиеЛица" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУНомер", УчетныйОбъект.ВУНомер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУДатаВыдачи", УчетныйОбъект.ВУДатаВыдачи, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаРождения", УчетныйОбъект.ДатаРождения, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Имя", УчетныйОбъект.Имя, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Отчество", УчетныйОбъект.Отчество, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВУСерия", УчетныйОбъект.ВУСерия, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Фамилия", УчетныйОбъект.Фамилия, ОбновлятьРеквизиты);
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"РольВодитель", (КонтекстНастройкиКонвертации.РеквизитТитула = "Водитель"), ОбновлятьРеквизиты);
		КонецЕсли;	
			
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Должность", "Водитель", ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ТелефонОсновной", УчетныйОбъект.Телефон, ОбновлятьРеквизиты);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ОрганизацииДиадок" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_Контрагенты"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_Организации" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"ИНН", УчетныйОбъект.ИНН, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"КПП", УчетныйОбъект.КПП, ОбновлятьРеквизиты);
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ПунктыМаршрута" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_Склады" Тогда
			
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфАдрес", УчетныйОбъект.АдресСтрока, ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Отправление", Истина, ОбновлятьРеквизиты);
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				
				Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.УчетнаяСистема_ТранспортнаяНакладная") Тогда
					Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
						ДокументОснование.Грузоотправитель, "Грузоотправитель",
						Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
						ДокументОснование, ДокументОбъект);
				ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.УчетнаяСистема_ЗаданиеНаПеревозку") Тогда
					Собственник = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
						ДокументОснование.Организация, "Грузоотправитель",
						Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
						ДокументОснование, ДокументОбъект);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Собственник) Тогда
					КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
						"Собственник", Собственник, ОбновлятьРеквизиты);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ТранспортнаяНакладная" Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
					"АдресИнфАдрес", ДокументОснование.АдресДоставкиЗначение, ОбновлятьРеквизиты);
			КонецЕсли;	
				
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"АдресИнфКодСтраны", Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643"), ОбновлятьРеквизиты);
			КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
				"Прибытие", Истина, ОбновлятьРеквизиты);
			
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_ТранспортныеСредства"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ТранспортныеСредства" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"VIN", УчетныйОбъект.VIN, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"РегНомер", УчетныйОбъект.РегНомер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"СТС", УчетныйОбъект.СТС, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВидВладения", Перечисления.КонтурЛогистика_ВидыВладенияТранспортнымСредством.Собственность_1, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ВместимостьКубМ", УчетныйОбъект.ВместимостьВКубическихМетрах, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ГрузоподъемностьТонн", УчетныйОбъект.ГрузоподъемностьВТоннах, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"МаркаТС", УчетныйОбъект.Марка, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ТипТС", УчетныйОбъект.Тип, ОбновлятьРеквизиты);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаЛогистика = "КонтурЛогистика_Договоры"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "УчетнаяСистема_ДоговорыКонтрагентов" Тогда
		
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ДатаДокумента", УчетныйОбъект.Дата, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Контрагент", УчетныйОбъект.Контрагент, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"КонтрагентИНН", УчетныйОбъект.Контрагент.ИНН, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Наименование", УчетныйОбъект.Наименование, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"НомерДокумента", УчетныйОбъект.Номер, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"Организация", УчетныйОбъект.Организация, ОбновлятьРеквизиты);
		КонтурЛогистика_КонвертацияТиповые.ДобавитьВычесленныйРеквизит(Результат.ВычисленныеРеквизиты,
			"ОрганизацияИНН", УчетныйОбъект.Организация.ИНН, ОбновлятьРеквизиты);
		
	КонецЕсли;
	
КонецПроцедуры

