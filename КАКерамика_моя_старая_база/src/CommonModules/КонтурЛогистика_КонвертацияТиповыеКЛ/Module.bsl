						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = ДокументОбъект.Товары.Добавить();
					Попытка 
						НоваяСтрока.ИдентификаторСтроки = ТоварОснования.ИдентификаторСтроки;
					Исключение
						НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
					КонецПопытки;
					НоваяСтрока.Номенклатура = ТоварОснования.Номенклатура;
					НоваяСтрока.Количество = ТоварОснования.КоличествоУпаковок;
					НоваяСтрока.УпаковкаЕдиницаИзмерения = ТоварОснования.Упаковка;
					НоваяСтрока.Характеристика = ТоварОснования.Характеристика;
					НоваяСтрока.СостояниеГруза = "Без замечаний";
					НоваяСтрока.Учитывать = Истина;
					НоваяСтрока.КодТНВЭД = ТоварОснования.КодТНВЭД;
