#Область ПрограммныйИнтерфейс

// Возвращает URL API ФИАС по умолчанию.
//
// Возвращаемое значение:
//  Строка - базовый адрес сервиса ФИАС.
//
Функция ЛокацияФиасПоУмолчанию() Экспорт
	Возврат "https://api.kontur.ru/fias";
КонецФункции

// Создаёт пустую структуру результата ввода адреса.
//
// Возвращаемое значение:
//  Структура - поля результата ввода адреса.
//
Функция НовыйРезультатВводаАдреса() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ТипАдреса", "");
	Результат.Вставить("Представление", "");
	Результат.Вставить("АдресКодГАР", "");
	Результат.Вставить("АдресГАРЗначение", "");
	Результат.Вставить("АдресRegion", "");
	Результат.Вставить("АдресRegionName", "");
	Результат.Вставить("АдресZipCode", "");
	Результат.Вставить("АдресTerritory", "");
	Результат.Вставить("АдресCity", "");
	Результат.Вставить("АдресLocality", "");
	Результат.Вставить("АдресStreet", "");
	Результат.Вставить("АдресBuilding", "");
	Результат.Вставить("АдресBlock", "");
	Результат.Вставить("АдресApartment", "");
	Результат.Вставить("АдресСтрока", "");
	Результат.Вставить("ИнКодСтраны", Справочники.КонтурЛогистика_СтраныМира.ПустаяСсылка());
	Результат.Вставить("ИнАдресAddress", "");
	Результат.Вставить("ИнАдресCountry", "");
	Возврат Результат;
КонецФункции

// Создаёт и настраивает клиент API ФИАС.
//
// Параметры:
//  КлючАПИ - Строка - ключ доступа к API.
//  Локация - Строка - базовый URL сервиса; если пусто - используется значение по умолчанию.
//
// Возвращаемое значение:
//  ОбработкаОбъект.КонтурЛогистика_ФиасКлиент - клиент API ФИАС.
//
Функция НовыйФиасКлиент(Знач КлючАПИ = "", Знач Локация = "") Экспорт
	Клиент = Обработки.КонтурЛогистика_ФиасКлиент.Создать();
	Параметры = Клиент.ФиасПараметры();
	Если ЗначениеЗаполнено(Локация) Тогда
		Параметры.Локация = Локация;
	Иначе
		Параметры.Локация = ЛокацияФиасПоУмолчанию();
	КонецЕсли;
	Параметры.КлючАПИ = СокрЛП(КлючАПИ);
	Возврат Клиент.Фиас(Параметры);
КонецФункции

// Возвращает подсказки адресов по тексту.
//
// Параметры:
//  Клиент - ОбработкаОбъект.КонтурЛогистика_ФиасКлиент - клиент, созданный через НовыйФиасКлиент.
//  Текст - Строка - строка поиска.
//  Лимит - Число - максимальное число подсказок.
//
// Возвращаемое значение:
//  Массив из Структура - первый элемент: свободная форма (ЭтоСвободнаяФорма);
//                        далее подсказки ФИАС с полями Подсказка, ИдентификаторФИАС, УровеньФИАС.
//
Функция ПодсказкиАдреса(Знач Клиент, Знач Текст, Знач Лимит = 7) Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ПодсказкаСвободнойФормыДляВыбора(Текст));
	Попытка
		Запрос = Клиент.ЗапросНайтиАдресаСПодсказками();
		Запрос.Адрес = Текст;
		Запрос.Лимит = Лимит;
		Запрос.ТолькоПодсказки = Истина;
		Запрос.Уровень = "House";
		Ответ = Клиент.НайтиАдресаСПодсказками(Запрос);
		Для Каждого Элемент Из Ответ Цикл
			Результат.Добавить(ПодсказкаДляФормы(Элемент));
		КонецЦикла;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Возвращает текст пункта выбора адреса в свободной форме.
//
// Возвращаемое значение:
//  Строка - представление элемента списка выбора.
//
Функция ПредставлениеВыбораСвободнойФормыАдреса() Экспорт
	Возврат "<добавить в свободной форме>";
КонецФункции

// Получает данные адреса по идентификатору ФИАС.
//
// Параметры:
//  Клиент - ОбработкаОбъект.КонтурЛогистика_ФиасКлиент - клиент, созданный через НовыйФиасКлиент.
//  ИдентификаторФИАС - Строка - идентификатор ФИАС/ГАР.
//
// Возвращаемое значение:
//  Структура - результат ввода адреса в формате НовыйРезультатВводаАдреса.
//
Функция ДанныеАдресаПоИдентификаторуФИАС(Знач Клиент, Знач ИдентификаторФИАС) Экспорт
	ИдентификаторФИАС = СокрЛП(ИдентификаторФИАС);
	Адрес = АдресФИАСПоИдентификатору(Клиент, ИдентификаторФИАС);
	Результат = НовыйРезультатВводаАдреса();
	Результат.ТипАдреса = "ГАР";
	ЗаполнитьРезультатИзАдресаФИАС(Адрес, ИдентификаторФИАС, Результат, Клиент);
	Возврат Результат;
КонецФункции

// Получает данные адреса по коду КЛАДР через сопоставление с ФИАС.
//
// Параметры:
//  Клиент - ОбработкаОбъект.КонтурЛогистика_ФиасКлиент - клиент, созданный через НовыйФиасКлиент.
//  КодКЛАДР - Строка - код КЛАДР.
//
// Возвращаемое значение:
//  Структура - результат ввода адреса в формате НовыйРезультатВводаАдреса.
//
Функция ДанныеАдресаПоКодуКЛАДР(Знач Клиент, Знач КодКЛАДР) Экспорт
	Запрос = Клиент.ЗапросПолучитьКодыФИАСПоКЛАДР();
	Запрос.КодыКЛАДР.Добавить(СокрЛП(КодКЛАДР));
	Соответствие = Клиент.ПолучитьКодыФИАСПоКЛАДР(Запрос);
	ИдентификаторФИАС = Соответствие.Получить(СокрЛП(КодКЛАДР));
	Если Не ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
		ВызватьИсключение КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Не удалось определить идентификатор ФИАС по коду КЛАДР ""%1"".", КодКЛАДР);
	КонецЕсли;
	Результат = ДанныеАдресаПоИдентификаторуФИАС(Клиент, ИдентификаторФИАС);
	Результат.ТипАдреса = "КЛАДР";
	Возврат Результат;
КонецФункции

// Формирует результат произвольного (свободного) адреса.
//
// Параметры:
//  Текст - Строка - текст адреса.
//
// Возвращаемое значение:
//  Структура - результат ввода адреса.
//
Функция РезультатВводаАдресаПроизвольный(Знач Текст) Экспорт
	Результат = НовыйРезультатВводаАдреса();
	Результат.ТипАдреса = "Произвольный";
	Результат.АдресСтрока = СокрЛП(Текст);
	Результат.Представление = Результат.АдресСтрока;
	Возврат Результат;
КонецФункции

// Формирует результат иностранного адреса.
//
// Параметры:
//  ИнКодСтраны - СправочникСсылка.КонтурЛогистика_СтраныМира - страна.
//  ИнАдресAddress - Строка - текст адреса.
//  ИнАдресCountry - Строка - наименование страны (если ссылка не заполнена).
//
// Возвращаемое значение:
//  Структура - результат ввода адреса.
//
Функция РезультатВводаАдресаИностранный(Знач ИнКодСтраны, Знач ИнАдресAddress, Знач ИнАдресCountry = "") Экспорт
	Результат = НовыйРезультатВводаАдреса();
	Результат.ТипАдреса = "Иностранный";
	Результат.ИнКодСтраны = ИнКодСтраны;
	Результат.ИнАдресAddress = СокрЛП(ИнАдресAddress);
	Результат.ИнАдресCountry = СокрЛП(ИнАдресCountry);
	Если ЗначениеЗаполнено(ИнКодСтраны) Тогда
		НаименованиеСтраны = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(ИнКодСтраны, "Наименование");
		Результат.Представление = СокрЛП(НаименованиеСтраны + ", " + Результат.ИнАдресAddress);
	ИначеЕсли ЗначениеЗаполнено(Результат.ИнАдресCountry) Тогда
		Результат.Представление = СокрЛП(Результат.ИнАдресCountry + ", " + Результат.ИнАдресAddress);
	Иначе
		Результат.Представление = Результат.ИнАдресAddress;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Формирует результат ручного ввода по полям КЛАДР без обязательного идентификатора ФИАС.
//
// Параметры:
//  Данные - Структура - поля адреса КЛАДР.
//
// Возвращаемое значение:
//  Структура - результат ввода адреса.
//
Функция РезультатВводаАдресаКЛАДРРучной(Знач Данные) Экспорт
	Результат = НовыйРезультатВводаАдреса();
	Результат.ТипАдреса = "КЛАДР";
	ЗаполнитьЗначенияСвойств(Результат, Данные,
		"АдресКодГАР, АдресRegion, АдресZipCode, АдресTerritory, АдресCity, АдресLocality,
		|АдресStreet, АдресBuilding, АдресBlock, АдресApartment");
	Результат.АдресRegionName = НаименованиеРегионаПоКоду(Результат.АдресRegion);
	Результат.Представление = ПредставлениеАдресаКЛАДР(Результат);
	Результат.АдресСтрока = Результат.Представление;
	Возврат Результат;
КонецФункции

// Возвращает наименование региона РФ по коду.
//
// Параметры:
//  КодРегиона - Строка - код региона.
//
// Возвращаемое значение:
//  Строка - наименование региона или "иные".
//
Функция НаименованиеРегионаПоКоду(Знач КодРегиона) Экспорт
	КодРегиона = СокрЛП(КодРегиона);
	Если Не ЗначениеЗаполнено(КодРегиона) Тогда
		Возврат "";
	КонецЕсли;
	ТаблицаРегионов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТаблицуРегионовРФ();
	СтрокаРегион = ТаблицаРегионов.Найти(КодРегиона, "Код");
	Если СтрокаРегион = Неопределено Или КодРегиона = "99" Тогда
		Возврат "иные";
	КонецЕсли;
	Возврат СтрокаРегион.Наименование;
КонецФункции

// Применяет результат ввода к реквизитам организации Диадок.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  Результат - Структура - результат ввода адреса.
//  РежимФорматаАдреса - Строка - зарезервированный параметр режима формата.
//
Процедура ПрименитьРезультатКОрганизацииДиадок(Объект, Знач Результат, Знач РежимФорматаАдреса = "") Экспорт
	
	ОчиститьАдресОрганизацииДиадок(Объект);
	
	ТипАдреса = "";
	Если Результат.Свойство("ТипАдреса") Тогда
		ТипАдреса = Результат.ТипАдреса;
	КонецЕсли;
	
	Если ТипАдреса = "Иностранный" Тогда
		Объект.ИнКодСтраны = Результат.ИнКодСтраны;
		Объект.ИнАдресAddress = Результат.ИнАдресAddress;
		Объект.ИнАдресCountry = Результат.ИнАдресCountry;
		Объект.АдресСтрока = Результат.Представление;
		Объект.АдресПредставление = Результат.Представление;
	ИначеЕсли ТипАдреса = "Произвольный" Тогда
		Объект.АдресСтрока = Результат.АдресСтрока;
		Объект.АдресПредставление = Результат.Представление;
	Иначе
		Объект.АдресСтрока = Результат.Представление;
		Объект.АдресПредставление = Результат.Представление;
		Объект.АдресКодГАР = Результат.АдресКодГАР;
		ЗаполнитьРеквизитыАдресаРФИзРезультатаВвода(Объект, Результат);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает текст адреса для отображения на форме организации.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  РежимФорматаАдреса - Строка - зарезервированный параметр режима формата.
//
// Возвращаемое значение:
//  Строка - текст адреса для поля ввода.
//
Функция ТекстАдресаДляОтображенияОрганизации(Объект, Знач РежимФорматаАдреса = "") Экспорт
	
	Если ЗначениеЗаполнено(Объект.АдресСтрока) Тогда
		Возврат Объект.АдресСтрока;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ИнАдресAddress) Тогда
		Если ЗначениеЗаполнено(Объект.ИнКодСтраны) Тогда
			НаименованиеСтраны = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(
				Объект.ИнКодСтраны, "Наименование");
			Возврат СокрЛП(НаименованиеСтраны + ", " + Объект.ИнАдресAddress);
		КонецЕсли;
		Возврат Объект.ИнАдресAddress;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.АдресПредставление) Тогда
		Возврат Объект.АдресПредставление;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает ссылку на страну Россия (код ОКСМ 643).
//
// Возвращаемое значение:
//  СправочникСсылка.КонтурЛогистика_СтраныМира - ссылка на страну Россия.
//
Функция СтранаРоссияСсылка() Экспорт
	Возврат Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643");
КонецФункции

// Определяет, что страна адреса - Россия (пустая ссылка или код 643).
//
// Параметры:
//  ИнКодСтраны - СправочникСсылка.КонтурЛогистика_СтраныМира - страна.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес считается российским.
//
Функция ЭтоСтранаРоссияДляАдреса(Знач ИнКодСтраны) Экспорт
	Если Не ЗначениеЗаполнено(ИнКодСтраны) Тогда
		Возврат Истина;
	КонецЕсли;
	КодСтраны = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(ИнКодСтраны, "Код");
	Возврат СокрЛП(КодСтраны) = "643";
КонецФункции

// Определяет, что у организации иностранный адрес.
// Учитывает случай, когда заполнены ИнАдресAddress или ИнАдресCountry, а ИнКодСтраны пуст.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес следует считать иностранным.
//
Функция ОрганизацияДиадокИмеетПризнакиИностранногоАдреса(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.ИнКодСтраны) Тогда
		Возврат Не ЭтоСтранаРоссияДляАдреса(Объект.ИнКодСтраны);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ИнАдресCountry) Тогда
		Возврат Не ЭтоСтранаРоссияПодразделенияДиадок(Объект.ИнАдресCountry);
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Объект.ИнАдресAddress);
КонецФункции

// Определяет тип адреса организации для отображения на форме и XDTO.
// Возможные значения: "ГАР", "КЛАДР", "Иностранный", "Свободный", "".
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
// Возвращаемое значение:
//  Строка - тип адреса.
//
Функция ОпределитьТипАдресаОрганизацииДиадок(Объект) Экспорт
	Если ОрганизацияДиадокИмеетПризнакиИностранногоАдреса(Объект) Тогда
		Если ЗначениеЗаполнено(Объект.ИнАдресAddress) Или ЗначениеЗаполнено(Объект.АдресСтрока)
			Или ЗначениеЗаполнено(Объект.ИнАдресCountry) Тогда
			Возврат "Иностранный";
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АдресКодГАР) Тогда
		Возврат "ГАР";
	КонецЕсли;
	Если ОрганизацияДиадокИспользуетАдресКЛАДР(Объект) Тогда
		Возврат "КЛАДР";
	КонецЕсли;
	Если ЭтоСохраненныйСвободныйАдресОрганизацииДиадок(Объект) Тогда
		Возврат "Свободный";
	КонецЕсли;
	Возврат "";
КонецФункции

// Определяет, что организация хранит российский адрес в свободной форме (без ГАР и без КЛАДР).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес свободной формы.
//
Функция ЭтоСохраненныйСвободныйАдресОрганизацииДиадок(Объект) Экспорт
	Если ОрганизацияДиадокИмеетПризнакиИностранногоАдреса(Объект) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЭтоСтранаРоссияДляАдреса(Объект.ИнКодСтраны) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АдресКодГАР) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОрганизацияДиадокИспользуетАдресКЛАДР(Объект) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Объект.АдресСтрока) Или ЗначениеЗаполнено(Объект.АдресПредставление);
КонецФункции

// Определяет, что организация использует адрес по полям КЛАДР.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
// Возвращаемое значение:
//  Булево - Истина, если заполнена детализация КЛАДР.
//
Функция ОрганизацияДиадокИспользуетАдресКЛАДР(Объект) Экспорт
	
	Если ЗначениеЗаполнено(Объект.АдресКодГАР) Тогда
		Возврат ЗначениеЗаполнено(Объект.АдресTerritory)
			Или ЗначениеЗаполнено(Объект.АдресCity)
			Или ЗначениеЗаполнено(Объект.АдресLocality)
			Или ЗначениеЗаполнено(Объект.АдресStreet)
			Или ЗначениеЗаполнено(Объект.АдресBuilding)
			Или ЗначениеЗаполнено(Объект.АдресBlock)
			Или ЗначениеЗаполнено(Объект.АдресApartment);
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Объект.АдресRegion)
		Или ЗначениеЗаполнено(Объект.АдресZipCode)
		Или ЗначениеЗаполнено(Объект.АдресTerritory)
		Или ЗначениеЗаполнено(Объект.АдресCity)
		Или ЗначениеЗаполнено(Объект.АдресLocality)
		Или ЗначениеЗаполнено(Объект.АдресStreet)
		Или ЗначениеЗаполнено(Объект.АдресBuilding)
		Или ЗначениеЗаполнено(Объект.АдресBlock)
		Или ЗначениеЗаполнено(Объект.АдресApartment);
	
КонецФункции

// Определяет, что организация использует адрес ГАР (заполнен код ГАР).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
// Возвращаемое значение:
//  Булево - Истина, если заполнен код ГАР.
//
Функция ОрганизацияДиадокИспользуетАдресГАР(Объект) Экспорт
	Возврат ЗначениеЗаполнено(Объект.АдресКодГАР);
КонецФункции

// Возвращает заголовок информативной надписи типа адреса на форме организации.
//
// Параметры:
//  ТипАдреса - Строка - тип адреса (ГАР, КЛАДР, Иностранный, Свободный).
//
// Возвращаемое значение:
//  Строка - текст надписи.
//
Функция ЗаголовокИнформацииТипаАдресаОрганизации(Знач ТипАдреса) Экспорт
	Если ТипАдреса = "ГАР" Тогда
		Возврат "Адрес найден в государственном адресном реестре";
	ИначеЕсли ТипАдреса = "КЛАДР" Тогда
		Возврат "Адрес по КЛАДР";
	ИначеЕсли ТипАдреса = "Иностранный" Тогда
		Возврат "Иностранный адрес";
	ИначеЕсли ТипАдреса = "Свободный" Тогда
		Возврат "Адрес указан в свободной форме";
	КонецЕсли;
	Возврат "";
КонецФункции

// Проставляет страну Россия по умолчанию для новых и российских адресов.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
Процедура ИнициализироватьСтрануАдресаОрганизацииДиадок(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.ИнКодСтраны) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ИнАдресAddress) И Не ОрганизацияДиадокИспользуетАдресКЛАДР(Объект)
		И Не ЗначениеЗаполнено(Объект.АдресКодГАР) Тогда
		Возврат;
	КонецЕсли;
	Объект.ИнКодСтраны = СтранаРоссияСсылка();
КонецПроцедуры

// Подготавливает поле адреса на форме: страна по умолчанию и текст для отображения.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  РежимФорматаАдреса - Строка - зарезервированный параметр режима формата.
//
Процедура ПодготовитьОтображениеАдресаОрганизацииДиадок(Объект, Знач РежимФорматаАдреса = "") Экспорт
	ИнициализироватьСтрануАдресаОрганизацииДиадок(Объект);
	ТекстОтображения = ТекстАдресаДляОтображенияОрганизации(Объект);
	Если Не ЗначениеЗаполнено(ТекстОтображения) И ЗначениеЗаполнено(Объект.АдресПредставление) Тогда
		ТекстОтображения = Объект.АдресПредставление;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.АдресСтрока) И ЗначениеЗаполнено(ТекстОтображения) Тогда
		Объект.АдресСтрока = ТекстОтображения;
	КонецЕсли;
КонецПроцедуры

// Применяет адрес из подсказки ФИАС к реквизитам организации.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  ИдентификаторФИАС - Строка - идентификатор выбранной подсказки.
//  Представление - Строка - текст подсказки.
//  РежимФорматаАдреса - Строка - зарезервированный параметр режима формата.
//
Процедура ПрименитьАдресИзПодсказкиФИАСКОрганизацииДиадок(Объект, Знач ИдентификаторФИАС, Знач Представление,
	Знач РежимФорматаАдреса = "") Экспорт
	Клиент = НовыйФиасКлиент("", ЛокацияФиасПоУмолчанию());
	Данные = ДанныеАдресаПоИдентификаторуФИАС(Клиент, ИдентификаторФИАС);
	Если ЗначениеЗаполнено(Представление) Тогда
		Данные.Представление = Представление;
		Данные.АдресСтрока = Представление;
	КонецЕсли;
	ПрименитьРезультатКОрганизацииДиадок(Объект, Данные);
	Объект.ИнКодСтраны = СтранаРоссияСсылка();
	Объект.ИнАдресAddress = "";
	Объект.ИнАдресCountry = "";
КонецПроцедуры

// Сохраняет иностранный адрес из строки ввода.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьИностранныйАдресОрганизацииДиадок(Объект, Знач ТекстАдреса) Экспорт
	ТекстАдреса = СокрЛП(ТекстАдреса);
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	Объект.АдресRegion = "";
	Объект.АдресZipCode = "";
	Объект.АдресTerritory = "";
	Объект.АдресCity = "";
	Объект.АдресLocality = "";
	Объект.АдресStreet = "";
	Объект.АдресBuilding = "";
	Объект.АдресBlock = "";
	Объект.АдресApartment = "";
	Объект.ИнАдресAddress = ТекстАдреса;
	Объект.АдресСтрока = ТекстАдреса;
	Если ЗначениеЗаполнено(Объект.ИнКодСтраны) Тогда
		НаименованиеСтраны = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(
			Объект.ИнКодСтраны, "Наименование");
		Объект.ИнАдресCountry = НаименованиеСтраны;
		Объект.АдресПредставление = СокрЛП(НаименованиеСтраны + ", " + ТекстАдреса);
	Иначе
		Объект.АдресПредставление = ТекстАдреса;
	КонецЕсли;
КонецПроцедуры

// Сохраняет адрес в свободной форме (РФ, без идентификатора ГАР).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьСвободныйАдресОрганизацииДиадок(Объект, Знач ТекстАдреса) Экспорт
	ТекстАдреса = СокрЛП(ТекстАдреса);
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	Объект.АдресRegion = "";
	Объект.АдресZipCode = "";
	Объект.АдресTerritory = "";
	Объект.АдресCity = "";
	Объект.АдресLocality = "";
	Объект.АдресStreet = "";
	Объект.АдресBuilding = "";
	Объект.АдресBlock = "";
	Объект.АдресApartment = "";
	Объект.ИнАдресAddress = "";
	Объект.ИнАдресCountry = "";
	Объект.АдресСтрока = ТекстАдреса;
	Объект.АдресПредставление = ТекстАдреса;
	Объект.ИнКодСтраны = СтранаРоссияСсылка();
КонецПроцедуры

// Очищает реквизиты адреса РФ при переключении на иностранный.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//
Процедура ОчиститьАдресРФОрганизацииДиадок(Объект) Экспорт
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	Объект.АдресRegion = "";
	Объект.АдресZipCode = "";
	Объект.АдресTerritory = "";
	Объект.АдресCity = "";
	Объект.АдресLocality = "";
	Объект.АдресStreet = "";
	Объект.АдресBuilding = "";
	Объект.АдресBlock = "";
	Объект.АдресApartment = "";
КонецПроцедуры

// Применяет ручной ввод адреса организации (свободный РФ или иностранный).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок, ДанныеФормыСтруктура - организация.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьРучнойТекстАдресаОрганизацииДиадок(Объект, Знач ТекстАдреса) Экспорт
	Если ОрганизацияДиадокИмеетПризнакиИностранногоАдреса(Объект) Тогда
		ПрименитьИностранныйАдресОрганизацииДиадок(Объект, ТекстАдреса);
	Иначе
		ПрименитьСвободныйАдресОрганизацииДиадок(Объект, ТекстАдреса);
	КонецЕсли;
КонецПроцедуры

// Определяет тип адреса пункта маршрута для отображения на форме.
// Возможные значения: "ГАР", "КЛАДР", "Иностранный", "Свободный", "".
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
// Возвращаемое значение:
//  Строка - тип адреса.
//
Функция ОпределитьТипАдресаПунктаМаршрута(Объект) Экспорт
	Если Не ЭтоСтранаРоссияДляАдреса(Объект.АдресИнфКодСтраны) Тогда
		Если ЗначениеЗаполнено(Объект.АдресИнфАдрес) Тогда
			Возврат "Иностранный";
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.КодГАР) Тогда
		Возврат "ГАР";
	КонецЕсли;
	Если ПунктМаршрутаИспользуетАдресКЛАДР(Объект) Тогда
		Возврат "КЛАДР";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АдресПредставление) Или ЗначениеЗаполнено(Объект.АдресИнфАдрес) Тогда
		Возврат "Свободный";
	КонецЕсли;
	Возврат "";
КонецФункции

// Определяет, что пункт маршрута использует адрес по полям КЛАДР.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
// Возвращаемое значение:
//  Булево - Истина, если заполнена детализация КЛАДР.
//
Функция ПунктМаршрутаИспользуетАдресКЛАДР(Объект) Экспорт
	Возврат ЗначениеЗаполнено(Объект.АдресРайон)
		Или ЗначениеЗаполнено(Объект.АдресГород)
		Или ЗначениеЗаполнено(Объект.АдресНаселПункт)
		Или ЗначениеЗаполнено(Объект.АдресУлица)
		Или ЗначениеЗаполнено(Объект.АдресДом)
		Или ЗначениеЗаполнено(Объект.АдресКорпус)
		Или ЗначениеЗаполнено(Объект.АдресКварт);
КонецФункции

// Возвращает заголовок информативной надписи типа адреса пункта маршрута.
//
// Параметры:
//  ТипАдреса - Строка - тип адреса.
//
// Возвращаемое значение:
//  Строка - текст надписи.
//
Функция ЗаголовокИнформацииТипаАдресаПунктаМаршрута(Знач ТипАдреса) Экспорт
	Возврат ЗаголовокИнформацииТипаАдресаОрганизации(ТипАдреса);
КонецФункции

// Проставляет страну Россия по умолчанию для пункта маршрута.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
Процедура ИнициализироватьСтрануАдресаПунктаМаршрута(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.АдресИнфКодСтраны) Тогда
		Возврат;
	КонецЕсли;
	Объект.АдресИнфКодСтраны = СтранаРоссияСсылка();
КонецПроцедуры

// Возвращает текст адреса для поля ввода на форме пункта маршрута.
// Приоритет: АдресИнфАдрес, АдресПредставление, сборка из полей КЛАДР.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
// Возвращаемое значение:
//  Строка - текст для отображения в поле адреса.
//
Функция ТекстАдресаДляОтображенияПунктаМаршрута(Объект) Экспорт
	
	Если ЗначениеЗаполнено(Объект.АдресИнфАдрес) Тогда
		Возврат Объект.АдресИнфАдрес;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.АдресПредставление) Тогда
		Возврат Объект.АдресПредставление;
	КонецЕсли;
	
	Если ПунктМаршрутаИспользуетАдресКЛАДР(Объект)
		Или ЗначениеЗаполнено(Объект.АдресКодРегион)
		Или ЗначениеЗаполнено(Объект.АдресИндекс) Тогда
		Возврат ТекстАдресаКЛАДРПунктаМаршрута(Объект);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Собирает текстовое представление адреса пункта маршрута из полей КЛАДР.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
// Возвращаемое значение:
//  Строка - представление адреса по полям КЛАДР.
//
Функция ПредставлениеАдресаКЛАДРПунктаМаршрута(Объект) Экспорт
	
	Возврат ТекстАдресаКЛАДРПунктаМаршрута(Объект);
	
КонецФункции

// Собирает текстовое представление адреса пункта маршрута из полей КЛАДР.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
// Возвращаемое значение:
//  Строка - представление адреса по КЛАДР.
//
Функция ТекстАдресаКЛАДРПунктаМаршрута(Объект)
	
	Данные = Новый Структура;
	Данные.Вставить("АдресZipCode", Объект.АдресИндекс);
	Данные.Вставить("АдресRegion", Объект.АдресКодРегион);
	Данные.Вставить("АдресTerritory", Объект.АдресРайон);
	Данные.Вставить("АдресCity", Объект.АдресГород);
	Данные.Вставить("АдресLocality", Объект.АдресНаселПункт);
	Данные.Вставить("АдресStreet", Объект.АдресУлица);
	Данные.Вставить("АдресBuilding", Объект.АдресДом);
	Данные.Вставить("АдресBlock", Объект.АдресКорпус);
	Данные.Вставить("АдресApartment", Объект.АдресКварт);
	
	Возврат ПредставлениеАдресаКЛАДР(Данные);
	
КонецФункции

// Подготавливает страну и текст адреса пункта маршрута для отображения на форме.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
Процедура ПодготовитьОтображениеАдресаПунктаМаршрута(Объект) Экспорт
	
	ИнициализироватьСтрануАдресаПунктаМаршрута(Объект);
	ТекстОтображения = ТекстАдресаДляОтображенияПунктаМаршрута(Объект);
	Если Не ЗначениеЗаполнено(Объект.АдресИнфАдрес) И ЗначениеЗаполнено(ТекстОтображения) Тогда
		Объект.АдресИнфАдрес = ТекстОтображения;
	КонецЕсли;
	
КонецПроцедуры

// Очищает поля детализации КЛАДР пункта маршрута.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//
Процедура ОчиститьАдресКЛАДРПунктаМаршрута(Объект) Экспорт
	Объект.АдресКодРегион = "";
	Объект.АдресИндекс = "";
	Объект.АдресРайон = "";
	Объект.АдресГород = "";
	Объект.АдресНаселПункт = "";
	Объект.АдресУлица = "";
	Объект.АдресДом = "";
	Объект.АдресКорпус = "";
	Объект.АдресКварт = "";
КонецПроцедуры

// Применяет адрес из подсказки ФИАС к пункту маршрута (режим ГАР).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//  ИдентификаторФИАС - Строка - идентификатор выбранной подсказки.
//  Представление - Строка - текст подсказки.
//
Процедура ПрименитьАдресИзПодсказкиФИАСКПунктуМаршрута(Объект, Знач ИдентификаторФИАС, Знач Представление) Экспорт
	Клиент = НовыйФиасКлиент("", ЛокацияФиасПоУмолчанию());
	Данные = ДанныеАдресаПоИдентификаторуФИАС(Клиент, ИдентификаторФИАС);
	Если ЗначениеЗаполнено(Представление) Тогда
		Данные.Представление = Представление;
		Данные.АдресСтрока = Представление;
	КонецЕсли;
	ОчиститьАдресКЛАДРПунктаМаршрута(Объект);
	Объект.КодГАР = Данные.АдресКодГАР;
	Объект.АдресГАРЗначение = Данные.АдресГАРЗначение;
	Объект.АдресПредставление = Данные.Представление;
	Объект.АдресИнфАдрес = Данные.Представление;
	Объект.АдресИнфКодСтраны = СтранаРоссияСсылка();
	ЗаполнитьРеквизитыАдресаРФПунктаИзРезультатаВвода(Объект, Данные);
	Если ЗначениеЗаполнено(Объект.АдресКодРегион) Тогда
		Объект.ЧасовойПояс = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЧасовойПоясПоКодуРегиона(Объект.АдресКодРегион);
	КонецЕсли;
КонецПроцедуры

// Сохраняет иностранный адрес пункта маршрута из строки ввода.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьИностранныйАдресПунктаМаршрута(Объект, Знач ТекстАдреса) Экспорт
	ТекстАдреса = СокрЛП(ТекстАдреса);
	Объект.КодГАР = "";
	Объект.АдресГАРЗначение = "";
	ОчиститьАдресКЛАДРПунктаМаршрута(Объект);
	Объект.АдресИнфАдрес = ТекстАдреса;
	Объект.АдресПредставление = ТекстАдреса;
	Если ЗначениеЗаполнено(Объект.АдресИнфКодСтраны) Тогда
		НаименованиеСтраны = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(
			Объект.АдресИнфКодСтраны, "Наименование");
		Объект.АдресПредставление = СокрЛП(НаименованиеСтраны + ", " + ТекстАдреса);
	КонецЕсли;
КонецПроцедуры

// Сохраняет адрес пункта маршрута в свободной форме (РФ, без идентификатора ГАР).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьСвободныйАдресПунктаМаршрута(Объект, Знач ТекстАдреса) Экспорт
	ТекстАдреса = СокрЛП(ТекстАдреса);
	Объект.КодГАР = "";
	Объект.АдресГАРЗначение = "";
	ОчиститьАдресКЛАДРПунктаМаршрута(Объект);
	Объект.АдресИнфАдрес = ТекстАдреса;
	Объект.АдресПредставление = ТекстАдреса;
	Объект.АдресИнфКодСтраны = СтранаРоссияСсылка();
КонецПроцедуры

// Применяет ручной ввод адреса пункта маршрута (свободный РФ или иностранный).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, ДанныеФормыСтруктура - пункт маршрута.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьРучнойТекстАдресаПунктаМаршрута(Объект, Знач ТекстАдреса) Экспорт
	Если ЭтоСтранаРоссияДляАдреса(Объект.АдресИнфКодСтраны) Тогда
		ПрименитьСвободныйАдресПунктаМаршрута(Объект, ТекстАдреса);
	Иначе
		ПрименитьИностранныйАдресПунктаМаршрута(Объект, ТекстАдреса);
	КонецЕсли;
КонецПроцедуры

#Область ПодразделенияДиадок

// Определяет, что страна подразделения - Россия (по строковому наименованию/коду).
//
// Параметры:
//  ИнАдресCountry - Строка - страна подразделения.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес считается российским.
//
Функция ЭтоСтранаРоссияПодразделенияДиадок(Знач ИнАдресCountry) Экспорт
	Страна = СокрЛП(ИнАдресCountry);
	Если Не ЗначениеЗаполнено(Страна) Тогда
		Возврат Истина;
	КонецЕсли;
	СтранаНижний = НРег(Страна);
	Если Страна = "643" Тогда
		Возврат Истина;
	КонецЕсли;
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(СтранаНижний, "росси") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтранаНижний = "рф" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Определяет, что подразделение использует адрес по полям КЛАДР.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//
// Возвращаемое значение:
//  Булево - Истина, если заполнена детализация КЛАДР.
//
Функция ПодразделениеДиадокИспользуетАдресКЛАДР(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.АдресКодГАР) Тогда
		Возврат ЗначениеЗаполнено(Объект.АдресTerritory)
			Или ЗначениеЗаполнено(Объект.АдресCity)
			Или ЗначениеЗаполнено(Объект.АдресLocality)
			Или ЗначениеЗаполнено(Объект.АдресStreet)
			Или ЗначениеЗаполнено(Объект.АдресBuilding)
			Или ЗначениеЗаполнено(Объект.АдресBlock)
			Или ЗначениеЗаполнено(Объект.АдресApartment);
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Объект.АдресRegion)
		Или ЗначениеЗаполнено(Объект.АдресZipCode)
		Или ЗначениеЗаполнено(Объект.АдресTerritory)
		Или ЗначениеЗаполнено(Объект.АдресCity)
		Или ЗначениеЗаполнено(Объект.АдресLocality)
		Или ЗначениеЗаполнено(Объект.АдресStreet)
		Или ЗначениеЗаполнено(Объект.АдресBuilding)
		Или ЗначениеЗаполнено(Объект.АдресBlock)
		Или ЗначениеЗаполнено(Объект.АдресApartment);
КонецФункции

// Определяет тип адреса подразделения для отображения на форме.
// Возможные значения: "ГАР", "КЛАДР", "Иностранный", "Свободный", "".
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//
// Возвращаемое значение:
//  Строка - тип адреса.
//
Функция ОпределитьТипАдресаПодразделенияДиадок(Объект) Экспорт
	Если Не ЭтоСтранаРоссияПодразделенияДиадок(Объект.ИнАдресCountry) Тогда
		Если ЗначениеЗаполнено(Объект.ИнАдресAddress) Или ЗначениеЗаполнено(Объект.АдресПредставление) Тогда
			Возврат "Иностранный";
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АдресКодГАР) Тогда
		Возврат "ГАР";
	КонецЕсли;
	Если ПодразделениеДиадокИспользуетАдресКЛАДР(Объект) Тогда
		Возврат "КЛАДР";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АдресПредставление) Или ЗначениеЗаполнено(Объект.ИнАдресAddress) Тогда
		Возврат "Свободный";
	КонецЕсли;
	Возврат "";
КонецФункции

// Возвращает текст адреса подразделения для поля ввода на форме.
// Для иностранного адреса возвращает ИнАдресAddress без префикса страны,
// иначе АдресПредставление или ИнАдресAddress.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//
// Возвращаемое значение:
//  Строка - текст для отображения в поле адреса.
//
Функция ТекстАдресаДляОтображенияПодразделенияДиадок(Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.ИнАдресAddress) Тогда
		Возврат Объект.ИнАдресAddress;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.АдресПредставление) Тогда
		Возврат Объект.АдресПредставление;
	КонецЕсли;
	Возврат "";
КонецФункции

// Подготавливает страну и текст адреса подразделения для отображения на форме.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//
Процедура ПодготовитьОтображениеАдресаПодразделенияДиадок(Объект) Экспорт
	Если Не ЗначениеЗаполнено(Объект.ИнАдресCountry) Тогда
		Объект.ИнАдресCountry = "Россия";
	КонецЕсли;
КонецПроцедуры

// Очищает поля детализации КЛАДР подразделения.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//
Процедура ОчиститьАдресКЛАДРПодразделенияДиадок(Объект) Экспорт
	Объект.АдресRegion = "";
	Объект.АдресZipCode = "";
	Объект.АдресTerritory = "";
	Объект.АдресCity = "";
	Объект.АдресLocality = "";
	Объект.АдресStreet = "";
	Объект.АдресBuilding = "";
	Объект.АдресBlock = "";
	Объект.АдресApartment = "";
КонецПроцедуры

// Применяет адрес из подсказки ФИАС к подразделению Диадок.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//  ИдентификаторФИАС - Строка - идентификатор выбранной подсказки.
//  Представление - Строка - текст подсказки.
//
Процедура ПрименитьАдресИзПодсказкиФИАСКПодразделениюДиадок(Объект, Знач ИдентификаторФИАС, Знач Представление) Экспорт
	Клиент = НовыйФиасКлиент("", ЛокацияФиасПоУмолчанию());
	Данные = ДанныеАдресаПоИдентификаторуФИАС(Клиент, ИдентификаторФИАС);
	Если ЗначениеЗаполнено(Представление) Тогда
		Данные.Представление = Представление;
		Данные.АдресСтрока = Представление;
	КонецЕсли;
	ОчиститьАдресКЛАДРПодразделенияДиадок(Объект);
	Объект.АдресКодГАР = Данные.АдресКодГАР;
	Объект.АдресГАРЗначение = Данные.АдресГАРЗначение;
	Объект.АдресПредставление = Данные.Представление;
	Объект.ИнАдресAddress = Данные.Представление;
	Объект.ИнАдресCountry = "Россия";
	ЗаполнитьРеквизитыАдресаРФИзРезультатаВвода(Объект, Данные);
КонецПроцедуры

// Сохраняет иностранный адрес подразделения из строки ввода.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьИностранныйАдресПодразделенияДиадок(Объект, Знач ТекстАдреса) Экспорт
	ТекстАдреса = СокрЛП(ТекстАдреса);
	Если ЗначениеЗаполнено(Объект.ИнАдресCountry) Тогда
		ПрефиксСтраны = СокрЛП(Объект.ИнАдресCountry) + ", ";
		Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНачинаетсяСЛок(ТекстАдреса, ПрефиксСтраны) Тогда
			ТекстАдреса = СокрЛП(Сред(ТекстАдреса, СтрДлина(ПрефиксСтраны) + 1));
		КонецЕсли;
	КонецЕсли;
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	ОчиститьАдресКЛАДРПодразделенияДиадок(Объект);
	Объект.ИнАдресAddress = ТекстАдреса;
	Если ЗначениеЗаполнено(Объект.ИнАдресCountry) Тогда
		Объект.АдресПредставление = СокрЛП(Объект.ИнАдресCountry + ", " + ТекстАдреса);
	Иначе
		Объект.АдресПредставление = ТекстАдреса;
	КонецЕсли;
КонецПроцедуры

// Сохраняет адрес подразделения в свободной форме (РФ, без идентификатора ГАР).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьСвободныйАдресПодразделенияДиадок(Объект, Знач ТекстАдреса) Экспорт
	ТекстАдреса = СокрЛП(ТекстАдреса);
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	ОчиститьАдресКЛАДРПодразделенияДиадок(Объект);
	Объект.ИнАдресCountry = "Россия";
	Объект.ИнАдресAddress = ТекстАдреса;
	Объект.АдресПредставление = ТекстАдреса;
КонецПроцедуры

// Применяет ручной ввод адреса подразделения (свободный РФ или иностранный).
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок, ДанныеФормыСтруктура - подразделение.
//  ТекстАдреса - Строка - текст адреса.
//
Процедура ПрименитьРучнойТекстАдресаПодразделенияДиадок(Объект, Знач ТекстАдреса) Экспорт
	Если ЭтоСтранаРоссияПодразделенияДиадок(Объект.ИнАдресCountry) Тогда
		ПрименитьСвободныйАдресПодразделенияДиадок(Объект, ТекстАдреса);
	Иначе
		ПрименитьИностранныйАдресПодразделенияДиадок(Объект, ТекстАдреса);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Преобразует адрес ФИАС в JSON-значение для адресных типов XDTO.
//
// Параметры:
//  Адрес - Структура - адрес, полученный от API ФИАС.
//  ИдентификаторФИАС - Строка - идентификатор запрошенного адреса.
//
// Возвращаемое значение:
//  Строка - JSON структуры адреса ГАР.
//
Функция АдресГАРЗначениеИзАдресаФИАС(Адрес, ИдентификаторФИАС) Экспорт

	АдресГАР = Новый Структура;
	Если Адрес = Неопределено Тогда
		Если ЗначениеЗаполнено(ИдентификаторФИАС) Тогда
			АдресГАР.Вставить("ИдНом", СокрЛП(ИдентификаторФИАС));
		КонецЕсли;
		Возврат КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(АдресГАР);
	КонецЕсли;

	ИдНом = ИдентификаторФИАСИзУровняАдреса(Адрес.Помещение);
	Если Не ЗначениеЗаполнено(ИдНом) Тогда
		ИдНом = ИдентификаторФИАСИзУровняАдреса(ДомАдресаФИАС(Адрес));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИдНом) Тогда
		ИдНом = СокрЛП(ИдентификаторФИАС);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдНом) Тогда
		АдресГАР.Вставить("ИдНом", ИдНом);
	КонецЕсли;

	Индекс = ПочтовыйИндексИзАдресаФИАС(Адрес);
	Если ЗначениеЗаполнено(Индекс) Тогда
		АдресГАР.Вставить("Индекс", Индекс);
	КонецЕсли;

	КодРегиона = Лев(СокрЛП(ТекстСвойстваУровняАдреса(Адрес.Регион, "Код")), 2);
	Если ЗначениеЗаполнено(КодРегиона) Тогда
		АдресГАР.Вставить("Регион", КодРегиона);
	КонецЕсли;
	НаимРегиона = НаименованиеУровняДляГАР(Адрес.Регион);
	Если Не ЗначениеЗаполнено(НаимРегиона) Тогда
		НаимРегиона = НаименованиеРегионаПоКоду(КодРегиона);
	КонецЕсли;
	Если ЗначениеЗаполнено(НаимРегиона) Тогда
		АдресГАР.Вставить("НаимРегион", НаимРегиона);
	КонецЕсли;

	МуниципРайон = Адрес.МуниципальныйРайон;
	Если МуниципРайон = Неопределено Тогда
		МуниципРайон = Адрес.Район;
	КонецЕсли;
	Если МуниципРайон <> Неопределено Тогда
		ДобавитьМуниципРайонГАР(АдресГАР, МуниципРайон);
	ИначеЕсли Адрес.Город <> Неопределено Тогда
		ДобавитьУровеньВАдресГАР(АдресГАР, "МуниципРайон", "ВидКод", "2", Адрес.Город);
	КонецЕсли;

	Поселение = Адрес.ГородскоеИСельскоеПоселение;
	Если Поселение = Неопределено Тогда
		Поселение = Адрес.ВнутригородскаяТерритория;
	КонецЕсли;
	Если Поселение <> Неопределено Тогда
		ДобавитьПоселениеГАР(АдресГАР, Поселение);
	КонецЕсли;

	Если Адрес.НаселенныйПункт <> Неопределено Тогда
		ДобавитьУровеньВАдресГАР(АдресГАР, "НаселенПункт", "Вид", СокращениеУровняДляГАР(Адрес.НаселенныйПункт, "г"),
			Адрес.НаселенныйПункт);
	ИначеЕсли Адрес.Город <> Неопределено И МуниципРайон <> Неопределено Тогда
		ДобавитьУровеньВАдресГАР(АдресГАР, "НаселенПункт", "Вид", "г", Адрес.Город);
	КонецЕсли;

	ДобавитьУровеньВАдресГАР(АдресГАР, "ЭлПланСтруктур", "Тип",
		СокращениеУровняДляГАР(Адрес.ПланировочнаяСтруктура, ""), Адрес.ПланировочнаяСтруктура);
	ДобавитьУровеньВАдресГАР(АдресГАР, "ЭлУлДорСети", "Тип",
		СокращениеУровняДляГАР(Адрес.Улица, "ул"), Адрес.Улица);

	НомерЗемельногоУчастка = НомерУровняАдреса(Адрес.ЗемельныйУчасток);
	Если ЗначениеЗаполнено(НомерЗемельногоУчастка) Тогда
		АдресГАР.Вставить("ЗемелУчасток", НомерЗемельногоУчастка);
	КонецЕсли;

	Здания = Новый Массив;
	Дом = ДомАдресаФИАС(Адрес);
	ДобавитьНомерАдресаГАР(Здания, СокращениеУровняДляГАР(Дом, "д."), НомерУровняАдреса(Дом));
	ДобавитьНомерАдресаГАР(Здания, "к.", ТекстСвойстваУровняАдреса(Дом, "НомерКорпуса"));
	ДобавитьНомерАдресаГАР(Здания, "стр.", ТекстСвойстваУровняАдреса(Дом, "НомерСтроения"));
	Если Здания.Количество() > 0 Тогда
		АдресГАР.Вставить("Здания", Здания);
	КонецЕсли;

	НомерПомещения = ТекстСвойстваУровняАдреса(Адрес.Помещение, "НомерКвартиры");
	Если Не ЗначениеЗаполнено(НомерПомещения) Тогда
		НомерПомещения = ТекстСвойстваУровняАдреса(Адрес.Помещение, "НомерКомнаты");
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерПомещения) Тогда
		АдресГАР.Вставить("ПомещЗдания", Новый Структура("Тип, Номер",
			СокращениеУровняДляГАР(Адрес.Помещение, "кв."), НомерПомещения));
	КонецЕсли;

	Возврат КонтурЛогистика_СтдJSONКлиентСервер.ЗаписатьЗначение(АдресГАР);

КонецФункции

// Читает JSON-значение адреса ГАР в структуру.
//
// Параметры:
//  АдресГАРЗначение - Строка - сохраненное JSON-значение адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - структура адреса или Неопределено при ошибке чтения.
//
Функция СтруктураАдресаГАРИзЗначения(АдресГАРЗначение) Экспорт

	Если Не ЗначениеЗаполнено(АдресГАРЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат КонтурЛогистика_СтдJSONКлиентСервер.ПрочитатьЗначение(АдресГАРЗначение, Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Определяет, что JSON адреса ГАР содержит развернутую структуру, а не только идентификатор.
//
// Параметры:
//  АдресГАРЗначение - Строка - сохраненное JSON-значение адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если заполнены уровни адреса сверх ИдНом/Регион/Индекс.
//
Функция СтруктураАдресаГАРПолная(АдресГАРЗначение) Экспорт

	АдресГАР = СтруктураАдресаГАРИзЗначения(АдресГАРЗначение);
	Если АдресГАР = Неопределено Или ТипЗнч(АдресГАР) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	ИменаУровней = "МуниципРайон, ГородСелПоселен, НаселенПункт, ЭлПланСтруктур, ЭлУлДорСети, ЗемелУчасток, Здания, ПомещЗдания, ПомещКвартиры";
	Для Каждого ИмяУровня Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ИменаУровней, ",", Истина) Цикл
		ИмяУровня = СокрЛП(ИмяУровня);
		Если АдресГАР.Свойство(ИмяУровня) И ЗначениеЗаполнено(АдресГАР[ИмяУровня]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьАдресОрганизацииДиадок(Объект)
	Объект.АдресКодГАР = "";
	Объект.АдресГАРЗначение = "";
	Объект.АдресRegion = "";
	Объект.АдресZipCode = "";
	Объект.АдресTerritory = "";
	Объект.АдресCity = "";
	Объект.АдресLocality = "";
	Объект.АдресStreet = "";
	Объект.АдресBuilding = "";
	Объект.АдресBlock = "";
	Объект.АдресApartment = "";
	Объект.АдресСтрока = "";
	Объект.АдресПредставление = "";
	Объект.ИнКодСтраны = Справочники.КонтурЛогистика_СтраныМира.ПустаяСсылка();
	Объект.ИнАдресAddress = "";
	Объект.ИнАдресCountry = "";
КонецПроцедуры

Процедура ЗаполнитьРеквизитыАдресаРФИзРезультатаВвода(Объект, Результат)

	ИменаПолей = "АдресRegion, АдресZipCode, АдресTerritory, АдресCity, АдресLocality,
		|АдресStreet, АдресBuilding, АдресBlock, АдресApartment, АдресГАРЗначение";
	Для Каждого ИмяПоля Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ИменаПолей, ",", Истина) Цикл
		ИмяПоля = СокрЛП(ИмяПоля);
		Если Результат.Свойство(ИмяПоля) И ЗначениеЗаполнено(Результат[ИмяПоля]) Тогда
			Объект[ИмяПоля] = Результат[ИмяПоля];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыАдресаРФПунктаИзРезультатаВвода(Объект, Результат)

	СоответствиеПолей = Новый Соответствие;
	СоответствиеПолей.Вставить("АдресRegion", "АдресКодРегион");
	СоответствиеПолей.Вставить("АдресZipCode", "АдресИндекс");
	СоответствиеПолей.Вставить("АдресTerritory", "АдресРайон");
	СоответствиеПолей.Вставить("АдресCity", "АдресГород");
	СоответствиеПолей.Вставить("АдресLocality", "АдресНаселПункт");
	СоответствиеПолей.Вставить("АдресStreet", "АдресУлица");
	СоответствиеПолей.Вставить("АдресBuilding", "АдресДом");
	СоответствиеПолей.Вставить("АдресBlock", "АдресКорпус");
	СоответствиеПолей.Вставить("АдресApartment", "АдресКварт");
	СоответствиеПолей.Вставить("АдресГАРЗначение", "АдресГАРЗначение");

	Для Каждого Элемент Из СоответствиеПолей Цикл
		Если Результат.Свойство(Элемент.Ключ) И ЗначениеЗаполнено(Результат[Элемент.Ключ]) Тогда
			Объект[Элемент.Значение] = Результат[Элемент.Ключ];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеАдресаКЛАДР(Знач Данные)
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Данные.АдресZipCode) Тогда
		Части.Добавить(СокрЛП(Данные.АдресZipCode));
	КонецЕсли;
	НаименованиеРегиона = "";
	Если Данные.Свойство("АдресRegionName") Тогда
		НаименованиеРегиона = Данные.АдресRegionName;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НаименованиеРегиона) Тогда
		НаименованиеРегиона = НаименованиеРегионаПоКоду(Данные.АдресRegion);
	КонецЕсли;
	Если ЗначениеЗаполнено(НаименованиеРегиона) Тогда
		Части.Добавить(НаименованиеРегиона);
	КонецЕсли;
	Поля = Новый Массив;
	Поля.Добавить("АдресTerritory");
	Поля.Добавить("АдресCity");
	Поля.Добавить("АдресLocality");
	Поля.Добавить("АдресStreet");
	Поля.Добавить("АдресBuilding");
	Поля.Добавить("АдресBlock");
	Поля.Добавить("АдресApartment");
	Для Каждого ИмяПоля Из Поля Цикл
		Значение = Данные[ИмяПоля];
		Если ЗначениеЗаполнено(Значение) Тогда
			Части.Добавить(СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(Части, ", ");
КонецФункции
Процедура ЗаполнитьРезультатИзАдресаФИАС(Знач Адрес, Знач ИдентификаторФИАС, Результат, Знач Клиент = Неопределено)
	Если Адрес <> Неопределено Тогда
		Если Адрес.Регион <> Неопределено И ЗначениеЗаполнено(Адрес.Регион.Код) Тогда
			Результат.АдресRegion = Лев(СокрЛП(Адрес.Регион.Код), 2);
			Результат.АдресRegionName = НаименованиеУровняАдреса(Адрес.Регион);
			Если Не ЗначениеЗаполнено(Результат.АдресRegionName) Тогда
				Результат.АдресRegionName = НаименованиеРегионаПоКоду(Результат.АдресRegion);
			КонецЕсли;
		ИначеЕсли Адрес.Регион <> Неопределено Тогда
			Результат.АдресRegionName = НаименованиеУровняАдреса(Адрес.Регион);
		КонецЕсли;
		Результат.АдресZipCode = ПочтовыйИндексИзАдресаФИАС(Адрес);
		ДополнитьПочтовыйИндексПоAPI(Клиент, Адрес, Результат);
		Результат.АдресTerritory = НаименованиеУровняАдреса(Адрес.Район);
		Если Не ЗначениеЗаполнено(Результат.АдресTerritory) Тогда
			Результат.АдресTerritory = НаименованиеУровняАдреса(Адрес.МуниципальныйРайон);
		КонецЕсли;
		Результат.АдресCity = НаименованиеУровняАдреса(Адрес.Город);
		Если Не ЗначениеЗаполнено(Результат.АдресCity) Тогда
			Результат.АдресCity = НаименованиеУровняАдреса(Адрес.ГородскоеИСельскоеПоселение);
		КонецЕсли;
		Результат.АдресLocality = НаименованиеУровняАдреса(Адрес.НаселенныйПункт);
		Результат.АдресStreet = НаименованиеУровняАдреса(Адрес.Улица);
		Дом = ДомАдресаФИАС(Адрес);
		Если Дом <> Неопределено Тогда
			Результат.АдресBuilding = СокрЛП(Дом.НомерДома);
			Если Не ЗначениеЗаполнено(Результат.АдресBuilding) Тогда
				Результат.АдресBuilding = СокрЛП(Дом.Номер);
			КонецЕсли;
			Результат.АдресBlock = СокрЛП(Дом.НомерКорпуса);
			Если Не ЗначениеЗаполнено(Результат.АдресBlock) Тогда
				Результат.АдресBlock = СокрЛП(Дом.НомерСтроения);
			КонецЕсли;
		КонецЕсли;
		Если Адрес.Помещение <> Неопределено Тогда
			Результат.АдресApartment = СокрЛП(Адрес.Помещение.НомерКвартиры);
			Если Не ЗначениеЗаполнено(Результат.АдресApartment) Тогда
				Результат.АдресApartment = СокрЛП(Адрес.Помещение.НомерКомнаты);
			КонецЕсли;
		КонецЕсли;
		Результат.Представление = ПредставлениеАдресаФИАС(Адрес, Результат.АдресZipCode);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.Представление) Тогда
		Результат.Представление = "Код ГАР: " + ИдентификаторФИАС;
	КонецЕсли;
	Результат.АдресКодГАР = ИдентификаторФИАС;
	Результат.АдресСтрока = Результат.Представление;
	Результат.АдресГАРЗначение = АдресГАРЗначениеИзАдресаФИАС(Адрес, ИдентификаторФИАС);
КонецПроцедуры
Функция АдресФИАСПоИдентификатору(Знач Клиент, Знач ИдентификаторФИАС)
	Адрес = ПопыткаПолучитьАдресФИАС(Клиент, ИдентификаторФИАС);
	Если Адрес <> Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;
	Адрес = ПопыткаПолучитьСтруктурированныйАдресФИАС(Клиент, ИдентификаторФИАС);
	Если Адрес <> Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;
	Адрес = ПопыткаПолучитьАдресФИАСПоКодам(Клиент, ИдентификаторФИАС);
	Если Адрес <> Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;
	ВызватьИсключение КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Адрес не найден по идентификатору ФИАС ""%1"".", ИдентификаторФИАС);
КонецФункции
Функция ПопыткаПолучитьАдресФИАС(Знач Клиент, Знач ИдентификаторФИАС)
	Попытка
		Запрос = Клиент.ЗапросПолучитьАдрес();
		Запрос.ИдентификаторФИАС = ИдентификаторФИАС;
		Запрос.ПолныйАдрес = Истина;
		Возврат Клиент.ПолучитьАдрес(Запрос);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
Функция ПопыткаПолучитьСтруктурированныйАдресФИАС(Знач Клиент, Знач ИдентификаторФИАС)
	Попытка
		Запрос = Клиент.ЗапросПолучитьСтруктурированныйАдрес();
		Запрос.ИдентификаторФИАС = ИдентификаторФИАС;
		Возврат Клиент.ПолучитьСтруктурированныйАдрес(Запрос);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
Функция ПопыткаПолучитьАдресФИАСПоКодам(Знач Клиент, Знач ИдентификаторФИАС)
	Попытка
		Запрос = Клиент.ЗапросПолучитьАдресаПоКодам();
		Запрос.ИдентификаторыФИАС.Добавить(ИдентификаторФИАС);
		Запрос.ПолныйАдрес = Истина;
		Адреса = Клиент.ПолучитьАдресаПоКодам(Запрос);
		Если Адреса.Количество() > 0 Тогда
			Возврат Адреса[0];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ИдентификаторФИАСИзУровняАдреса(Знач Уровень)
	Возврат СокрЛП(ТекстСвойстваУровняАдреса(Уровень, "ИдентификаторФИАС"));
КонецФункции

Функция НаименованиеУровняДляГАР(Знач Уровень)
	Наименование = СокрЛП(ТекстСвойстваУровняАдреса(Уровень, "Наименование"));
	Если ЗначениеЗаполнено(Наименование) Тогда
		Возврат Наименование;
	КонецЕсли;
	Возврат НаименованиеУровняАдреса(Уровень);
КонецФункции

Функция СокращениеУровняДляГАР(Знач Уровень, Знач ЗначениеПоУмолчанию)
	Сокращение = СокрЛП(ТекстСвойстваУровняАдреса(Уровень, "Сокращение"));
	Если Не ЗначениеЗаполнено(Сокращение) Тогда
		Сокращение = СокрЛП(ТекстСвойстваУровняАдреса(Уровень, "СокращениеДома"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Сокращение) Тогда
		Сокращение = СокрЛП(ТекстСвойстваУровняАдреса(Уровень, "СокращениеТипа"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Сокращение) Тогда
		Сокращение = ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Сокращение;
КонецФункции

Функция НомерУровняАдреса(Знач Уровень)
	Номер = ТекстСвойстваУровняАдреса(Уровень, "Номер");
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Номер = ТекстСвойстваУровняАдреса(Уровень, "НомерДома");
	КонецЕсли;
	Возврат СокрЛП(Номер);
КонецФункции

Процедура ДобавитьНомерАдресаГАР(Здания, Знач Тип, Знач Номер)
	Если ЗначениеЗаполнено(Тип) И ЗначениеЗаполнено(Номер) И Здания.Количество() < 3 Тогда
		Здания.Добавить(Новый Структура("Тип, Номер", Тип, СокрЛП(Номер)));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьУровеньВАдресГАР(АдресГАР, Знач ИмяСвойства, Знач ИмяТипа, Знач Тип, Знач Уровень)
	Наименование = НаименованиеУровняДляГАР(Уровень);
	Если ЗначениеЗаполнено(Тип) И ЗначениеЗаполнено(Наименование) Тогда
		АдресГАР.Вставить(ИмяСвойства, Новый Структура(ИмяТипа + ", Наим", Тип, Наименование));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьМуниципРайонГАР(АдресГАР, Знач Уровень)
	ТекстВида = НРег(СокращениеУровняДляГАР(Уровень, "") + " " + НаименованиеУровняАдреса(Уровень));
	ВидКод = "1";
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "федерал") > 0
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "ф.т") > 0 Тогда
		ВидКод = "5";
	ИначеЕсли КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "внутригород") > 0
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "вн.тер") > 0 Тогда
		ВидКод = "3";
	ИначеЕсли (КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "муниципальн") > 0
		И КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "округ") > 0)
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "м.о") > 0 Тогда
		ВидКод = "4";
	ИначеЕсли (КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "городск") > 0
		И КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "округ") > 0)
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "г.о") > 0 Тогда
		ВидКод = "2";
	КонецЕсли;
	ДобавитьУровеньВАдресГАР(АдресГАР, "МуниципРайон", "ВидКод", ВидКод, Уровень);
КонецПроцедуры

Процедура ДобавитьПоселениеГАР(АдресГАР, Знач Уровень)
	ТекстВида = НРег(СокращениеУровняДляГАР(Уровень, "") + " " + НаименованиеУровняАдреса(Уровень));
	ВидКод = "1";
	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "с.п") > 0
		Или КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "сельск") > 0 Тогда
		ВидКод = "2";
	ИначеЕсли КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "межсел") > 0 Тогда
		ВидКод = "3";
	ИначеЕсли КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(ТекстВида, "внутригород") > 0 Тогда
		ВидКод = "4";
	КонецЕсли;
	ДобавитьУровеньВАдресГАР(АдресГАР, "ГородСелПоселен", "ВидКод", ВидКод, Уровень);
КонецПроцедуры

Функция ДомАдресаФИАС(Знач Адрес)
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Адрес.Дом <> Неопределено Тогда
		Возврат Адрес.Дом;
	КонецЕсли;
	Если Адрес.ДомГАР <> Неопределено Тогда
		Возврат Адрес.ДомГАР;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
Функция ПочтовыйИндексИзУровня(Знач Уровень)
	Если Уровень = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Уровень.ПочтовыйИндекс);
КонецФункции
Функция ПочтовыйИндексИзАдресаФИАС(Знач Адрес)
	Если Адрес = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Уровни = Новый Массив;
	Уровни.Добавить(ДомАдресаФИАС(Адрес));
	Уровни.Добавить(Адрес.Улица);
	Уровни.Добавить(Адрес.НаселенныйПункт);
	Уровни.Добавить(Адрес.Город);
	Уровни.Добавить(Адрес.ГородскоеИСельскоеПоселение);
	Уровни.Добавить(Адрес.МуниципальныйРайон);
	Уровни.Добавить(Адрес.Район);
	Уровни.Добавить(Адрес.ЗемельныйУчасток);
	Уровни.Добавить(Адрес.Регион);
	Для Каждого Уровень Из Уровни Цикл
		Индекс = ПочтовыйИндексИзУровня(Уровень);
		Если ЗначениеЗаполнено(Индекс) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции
Процедура ДополнитьПочтовыйИндексПоAPI(Знач Клиент, Знач Адрес, Результат)
	Если ЗначениеЗаполнено(Результат.АдресZipCode) Или Клиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Дом = ДомАдресаФИАС(Адрес);
	Если Дом = Неопределено Или Не ЗначениеЗаполнено(Дом.ИдентификаторФИАС) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Запрос = Клиент.ЗапросПолучитьПочтовыйИндексДома();
		Запрос.ИдентификаторФИАС = Дом.ИдентификаторФИАС;
		Ответ = Клиент.ПолучитьПочтовыйИндексДома(Запрос);
		Результат.АдресZipCode = СокрЛП(Ответ.ПочтовыйИндекс);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры
Функция НаименованиеУровняАдреса(Знач Уровень)
	Если Уровень = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Текст = ТекстСвойстваУровняАдреса(Уровень, "НаименованиеССокращением");
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат СокрЛП(Текст);
	КонецЕсли;
	Текст = ТекстСвойстваУровняАдреса(Уровень, "Наименование");
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат СокрЛП(Текст);
	КонецЕсли;
	Текст = ПредставлениеДомаУровняАдреса(Уровень);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат ПредставлениеПомещенияУровняАдреса(Уровень);
КонецФункции
Функция ТекстСвойстваУровняАдреса(Знач Уровень, Знач ИмяСвойства)
	Если Не УровеньАдресаИмеетСвойство(Уровень, ИмяСвойства) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Уровень[ИмяСвойства];
КонецФункции
Функция УровеньАдресаИмеетСвойство(Знач Уровень, Знач ИмяСвойства)
	ТипУровня = ТипЗнч(Уровень);
	Если ТипУровня = Тип("Структура") Или ТипУровня = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Уровень.Свойство(ИмяСвойства);
	КонецЕсли;
	Возврат Ложь;
КонецФункции
Функция ПредставлениеДомаУровняАдреса(Знач Уровень)
	Номер = ТекстСвойстваУровняАдреса(Уровень, "НомерДома");
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Номер = ТекстСвойстваУровняАдреса(Уровень, "Номер");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат "";
	КонецЕсли;
	Сокращение = ТекстСвойстваУровняАдреса(Уровень, "СокращениеДома");
	Если ЗначениеЗаполнено(Сокращение) Тогда
		Возврат СокрЛП(Сокращение) + " " + СокрЛП(Номер);
	КонецЕсли;
	Возврат "д. " + СокрЛП(Номер);
КонецФункции
Функция ПредставлениеПомещенияУровняАдреса(Знач Уровень)
	Номер = ТекстСвойстваУровняАдреса(Уровень, "НомерКвартиры");
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Номер = ТекстСвойстваУровняАдреса(Уровень, "НомерКомнаты");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат "";
	КонецЕсли;
	Сокращение = ТекстСвойстваУровняАдреса(Уровень, "СокращениеТипа");
	Если Не ЗначениеЗаполнено(Сокращение) Тогда
		Сокращение = ТекстСвойстваУровняАдреса(Уровень, "СокращениеКомнаты");
	КонецЕсли;
	Если ЗначениеЗаполнено(Сокращение) Тогда
		Возврат СокрЛП(Сокращение) + " " + СокрЛП(Номер);
	КонецЕсли;
	Возврат "кв. " + СокрЛП(Номер);
КонецФункции
Функция ПредставлениеАдресаФИАС(Знач Адрес, Знач ПочтовыйИндекс = "")
	Части = Новый Массив;
	Если Адрес = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПочтовыйИндекс) Тогда
		ПочтовыйИндекс = ПочтовыйИндексИзАдресаФИАС(Адрес);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПочтовыйИндекс) Тогда
		Части.Добавить(СокрЛП(ПочтовыйИндекс));
	КонецЕсли;
	Уровни = Новый Массив;
	Уровни.Добавить(Адрес.Регион);
	Уровни.Добавить(Адрес.МуниципальныйРайон);
	Уровни.Добавить(Адрес.Город);
	Уровни.Добавить(Адрес.ГородскоеИСельскоеПоселение);
	Уровни.Добавить(Адрес.НаселенныйПункт);
	Уровни.Добавить(Адрес.Улица);
	Уровни.Добавить(ДомАдресаФИАС(Адрес));
	Уровни.Добавить(Адрес.Помещение);
	Для Каждого Уровень Из Уровни Цикл
		Текст = НаименованиеУровняАдреса(Уровень);
		Если ЗначениеЗаполнено(Текст) Тогда
			Части.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(Части, ", ");
КонецФункции
Функция ПодсказкаСвободнойФормыДляВыбора(Знач ТекстАдреса)
	Возврат Новый Структура("Подсказка, ИдентификаторФИАС, УровеньФИАС, ЭтоСвободнаяФорма, ПредставлениеВыбора",
		СокрЛП(ТекстАдреса), "", "", Истина, ПредставлениеВыбораСвободнойФормыАдреса());
КонецФункции
Функция ПодсказкаДляФормы(Элемент)
	ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	Возврат Новый Структура("Подсказка, ИдентификаторФИАС, УровеньФИАС, ЭтоСвободнаяФорма",
		ТекстПодсказкиИзЭлемента(Элемент, ПодсказкаСырая),
		ИдентификаторФИАСИзЭлемента(Элемент, ПодсказкаСырая),
		УровеньФИАСИзЭлемента(Элемент, ПодсказкаСырая),
		Ложь);
КонецФункции
Функция ТекстПодсказкиИзЭлемента(Элемент, ПодсказкаСырая = Неопределено)
	Если ПодсказкаСырая = Неопределено Тогда
		ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	КонецЕсли;
	Текст = ТекстИзОбъектаПодсказки(ПодсказкаСырая);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат ТекстИзОбъектаПодсказки(Элемент);
КонецФункции
Функция ИдентификаторФИАСИзЭлемента(Элемент, ПодсказкаСырая = Неопределено)
	Идентификатор = ЗначениеСвойстваЭлемента(Элемент, "ИдентификаторФИАС", "fiasId");
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;
	Если ПодсказкаСырая = Неопределено Тогда
		ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	КонецЕсли;
	Возврат ЗначениеСвойстваЭлемента(ПодсказкаСырая, "", "fiasId");
КонецФункции
Функция УровеньФИАСИзЭлемента(Элемент, ПодсказкаСырая = Неопределено)
	Уровень = ЗначениеСвойстваЭлемента(Элемент, "УровеньФИАС", "fiasLevel");
	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Уровень = ЗначениеСвойстваЭлемента(Элемент, "", "level");
	КонецЕсли;
	Если ЗначениеЗаполнено(Уровень) Тогда
		Возврат Уровень;
	КонецЕсли;
	Если ПодсказкаСырая = Неопределено Тогда
		ПодсказкаСырая = ЗначениеСвойстваЭлемента(Элемент, "Подсказка", "suggest");
	КонецЕсли;
	Уровень = ЗначениеСвойстваЭлемента(ПодсказкаСырая, "", "fiasLevel");
	Если Не ЗначениеЗаполнено(Уровень) Тогда
		Уровень = ЗначениеСвойстваЭлемента(ПодсказкаСырая, "", "level");
	КонецЕсли;
	Возврат Уровень;
КонецФункции
Функция ТекстИзОбъектаПодсказки(Данные)
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипДанных = ТипЗнч(Данные);
	Если ТипДанных = Тип("Строка") Тогда
		Возврат Данные;
	КонецЕсли;
	Если ТипДанных = Тип("Структура")
		ИЛИ ТипДанных = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипДанных = Тип("Соответствие")
		ИЛИ ТипДанных = Тип("ФиксированноеСоответствие") Тогда
		Текст = ЗначениеСвойстваЭлемента(Данные, "", "value");
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = ЗначениеСвойстваЭлемента(Данные, "", "label");
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) И ТипЗнч(Текст) <> Тип("Строка") Тогда
			Текст = ТекстИзОбъектаПодсказки(Текст);
		КонецЕсли;
		Если Текст = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Текст;
	КонецЕсли;
	Возврат "";
КонецФункции
Функция ЗначениеСвойстваЭлемента(Элемент, ИмяРус, ИмяАнгл)
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЭлемента = ТипЗнч(Элемент);
	Если ТипЭлемента = Тип("Структура")
		ИЛИ ТипЭлемента = Тип("ФиксированнаяСтруктура") Тогда
		Если ЗначениеЗаполнено(ИмяРус) И Элемент.Свойство(ИмяРус) Тогда
			Возврат Элемент[ИмяРус];
		КонецЕсли;
	ИначеЕсли ТипЭлемента = Тип("Соответствие")
		ИЛИ ТипЭлемента = Тип("ФиксированноеСоответствие") Тогда
		Если ЗначениеЗаполнено(ИмяАнгл) Тогда
			Возврат Элемент.Получить(ИмяАнгл);
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
#КонецОбласти
