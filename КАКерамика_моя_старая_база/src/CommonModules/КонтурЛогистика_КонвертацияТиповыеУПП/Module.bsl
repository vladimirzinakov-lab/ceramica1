Процедура ЗаполнитьДокументТитул_ТрН_Титул3_ПоступлениеТоваровУслуг(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ДокументЭТРН = ДокументОбъект.ДокументЭТРН;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
		|	И ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И НАЧАЛОПЕРИОДА(ПоступлениеТоваровУслуг.ДатаВходящегоДокумента, ДЕНЬ) = &ДатаВходящегоДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоступлениеТоваровУслуг.Ссылка УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаВходящегоДокумента", ДокументЭТРН.ДатаТрН);
	Запрос.УстановитьПараметр("НомерВходящегоДокумента", ДокументЭТРН.НомерТрН);
	
	Если КонтекстНастройкиКонвертации.ТолькоПроведенные Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕ ПоступлениеТоваровУслуг.ПометкаУдаления", 
												 "НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
												  |	И ПоступлениеТоваровУслуг.Проведен");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДокументОснование = ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		ДокументОснование = Неопределено;
	КонецЕсли;
	
	ДокументОбъект.ДокументОснование = ДокументОснование;
	ДокументОбъект.ОбщееСостояние = "Без замечаний";
		
	ДокументОбъект.ФДатВрУбыт = ТекущаяДатаСеанса();
	
	ПродолжительностьРазгрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СредняяПродолжительностьРазгрузки", ДокументЭТРН.ПартнерГрузополучатель);
	Если ТипЗнч(ПродолжительностьРазгрузки) = Тип("Число") Тогда
		ФДатВрПриб = ДокументОбъект.ФДатВрУбыт - ПродолжительностьРазгрузки * 60;
	Иначе
		ФДатВрПриб = ДокументОбъект.ФДатВрУбыт - 2 * 60 * 60;
	КонецЕсли;
	ДокументОбъект.ФДатВрПриб = ФДатВрПриб;
	
	ЗаявДатВрПриб = ДокументЭТРН.ДатаВремяДоставки;
	ДокументОбъект.ЗаявДатВрПриб = ?(ЗначениеЗаполнено(ЗаявДатВрПриб),ЗаявДатВрПриб,ФДатВрПриб);
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		// ТЧ Товары
		Для Каждого ТекущаяСтрока Из ДокументОснование.Товары Цикл
			
			НоваяСтрока = ДокументОбъект.ТоварыДокументаУчетнойСистемы.Добавить();
				
			РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь);
					
		КонецЦикла;
		
		ДокументОбъект.СопоставитьТоварыАвтоматически();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ЗЗ_Титул1_РТУ_ЗаказПокупателя(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
