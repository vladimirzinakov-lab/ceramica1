	КонецПопытки;
		
	ДокументОбъект.СвГО = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		РассчитатьГО_РТУ(ДокументОснование), "СвГО",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	ДокументОбъект.СвГП = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		РассчитатьГП_РТУ(ДокументОснование), "СвГП",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ВПунктМаршрута = Новый Структура("АдрГруз, АдрПунктНазн", "Склад", "АдресДоставки"); 
	Для Каждого Элемент Из ВПунктМаршрута Цикл
		ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование[Элемент.Значение], Элемент.Ключ,
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументОснование.ВалютаДокумента) Тогда
		Валюта = ДокументОснование.ВалютаДокумента;
	Иначе
		Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С("643", "руб");
	КонецЕсли; 
	ДокументОбъект.ВалютаУчетаГруза = Валюта;
	ДокументОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
	
	Товары = ПолучитьТЧТоварыРТУ(ДокументОснование);
	
	// ТЧ Товары
	Для Каждого ТекущаяСтрока Из Товары Цикл
		
		// При разделении ПЭ_ЗаявкаНаМаршрут — только строки текущего разделителя
		Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
				ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		НоваяСтрока.СтоимостьГруза = ТекущаяСтрока.Сумма;
		НоваяСтрока.ВалютаУчетаГруза = Валюта;
		НоваяСтрока.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.КодТНВЭД) Тогда
			НоваяСтрока.КодТНВЭД = ТекущаяСтрока.КодТНВЭД;
		КонецЕсли;
		
		РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь, Истина);
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.СтранаПроисхожденияКЛ) Тогда
			КонтурЛогистика_КонвертацияСервер.ДобавитьСтрануПроисхожденияПродукции(ДокументОбъект, НоваяСтрока.ИдентификаторСтроки,
				ТекущаяСтрока.СтранаПроисхожденияКЛ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокумент_ПЭ_ЗаявкаНаМаршрут_ПеремещениеТоваров(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные)
	
	ДокументОбъект.НомДок = ДокументОснование.Номер;
	ДокументОбъект.ДатаДок = ДокументОснование.Дата;
	
		
	ДокументОбъект.СвКлт = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "СвКлт",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	ДокументОбъект.СвГО = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "СвГО",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
		
	ДокументОбъект.СвГП = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "СвГП",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ВПунктМаршрута = Новый Структура("АдрГруз, АдрПунктНазн", "СкладОтправитель", "СкладПолучатель"); 
	Для Каждого Элемент Из ВПунктМаршрута Цикл
		ДокументОбъект[Элемент.Ключ] = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование[Элемент.Значение], Элемент.Ключ,
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект);
	КонецЦикла;
	
	Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С("643", "руб");
	
	ДокументОбъект.ВалютаУчетаГруза = Валюта;
	ДокументОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
	
	Товары = ПолучитьТЧТоварыПеремещение(ДокументОснование);
	
	// ТЧ Товары
	Для Каждого ТекущаяСтрока Из Товары Цикл
		
		// При разделении ПЭ_ЗаявкаНаМаршрут — только строки текущего разделителя
		Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
				ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		НоваяСтрока.ВалютаУчетаГруза = Валюта;
		НоваяСтрока.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.КодТНВЭД) Тогда
			НоваяСтрока.КодТНВЭД = ТекущаяСтрока.КодТНВЭД;
		КонецЕсли;
		
		РассчитатьПараметрыГруза(ТекущаяСтрока, НоваяСтрока, Ложь, Истина);
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.СтранаПроисхожденияКЛ) Тогда
			КонтурЛогистика_КонвертацияСервер.ДобавитьСтрануПроисхожденияПродукции(ДокументОбъект, НоваяСтрока.ИдентификаторСтроки,
				ТекущаяСтрока.СтранаПроисхожденияКЛ);
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Функция ВычислитьАдресСклада(УчетныйОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Представление КАК Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)";
	
	Запрос.УстановитьПараметр("Объект", УчетныйОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Представление;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция РассчитатьГО_РТУ(ДокументОснование)
	Возврат ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель), ДокументОснование.Грузоотправитель, ДокументОснование.Организация);		
КонецФункции

Функция РассчитатьГП_РТУ(ДокументОснование)
	Возврат ?(ЗначениеЗаполнено(ДокументОснование.Грузополучатель), ДокументОснование.Грузополучатель, ДокументОснование.Контрагент);
КонецФункции

Процедура ЗаполнитьПутиРеквизитов_РТУ_ЗаказПокупателя(Контекст)
	
	ИмяТаблицы = Контекст.ТипДокумента1С;
	Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
	
	Пути.ПутьОрганизация = "Организация";
	Пути.ПутьКонтрагент = "Контрагент";
	Пути.ПутьГрузоотправитель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
		ИмяТаблицы, "Грузоотправитель", "Организация", ИмяТаблицы);
	Пути.ПутьГрузополучатель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
		ИмяТаблицы, "Грузополучатель", "Контрагент", ИмяТаблицы);
	Пути.ПутьДатаТРН = "Дата";
	Пути.ПутьНомерТРН = "Номер";
	
	Если ИмяТаблицы = "РеализацияТоваровУслуг" Тогда
		Пути.ПутьМестоПогрузки = "Склад";
	ИначеЕсли ИмяТаблицы = "ЗаказПокупателя" Тогда
		Пути.ПутьМестоПогрузки = "СкладГруппа";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПутиРеквизитов_ПеремещениеТоваров(Контекст)
	
	ИмяТаблицы = "ПеремещениеТоваров";
	Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
	
	Пути.ПутьОрганизация = "Организация";
	Пути.ПутьГрузоотправитель = "Организация";
	Пути.ПутьГрузополучатель = "Организация";
	Пути.ПутьДатаТРН = "Дата";
	Пути.ПутьНомерТРН = "Номер";
	Пути.ПутьМестоДоставки = "СкладПолучатель";
	Пути.ПутьМестоПогрузки = "СкладОтправитель";
	
КонецПроцедуры

// Добавляет заказ клиента РТУ в массив связанных оснований (без дублей).
// Сначала шапка ЗаказПокупателя, если пусто — первая строка ТЧ Товары с заказом.
//
Процедура ДобавитьЗаказПокупателяРТУВМассив(ДокументРТУ, МассивОснований)
	
	Если Не КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументРТУ, "Сделка") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументРТУ.Сделка)
		И ТипЗнч(ДокументРТУ.Сделка) = Тип("ДокументСсылка.ЗаказПокупателя")
		И МассивОснований.Найти(ДокументРТУ.Сделка) = Неопределено Тогда
		
		МассивОснований.Добавить(ДокументРТУ.Сделка);
		
	ИначеЕсли Не ЗначениеЗаполнено(ДокументРТУ.Сделка)
		И ДокументРТУ.Товары.Количество() > 0 Тогда
		
		Для Каждого СтрокаТоваров Из ДокументРТУ.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТоваров.ЗаказПокупателя)
				И МассивОснований.Найти(СтрокаТоваров.ЗаказПокупателя) = Неопределено Тогда
				
				МассивОснований.Добавить(СтрокаТоваров.ЗаказПокупателя);
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТЧТоварыРТУ(Знач ДокументОснование)
	
	Запрос = Новый Запрос;	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.КодТНВЭД.Код КАК КодТНВЭД,
		|	КонтурЛогистика_СтраныМира.Ссылка КАК СтранаПроисхожденияКЛ,
		|	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка,
		|	РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.КоличествоМест КАК КоличествоМест,
		|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	РеализацияТоваровУслугТовары.Коэффициент КАК Коэффициент,
		|	РеализацияТоваровУслугТовары.Количество КАК Количество,
		|	РеализацияТоваровУслугТовары.Цена КАК Цена,
		|	РеализацияТоваровУслугТовары.Сумма КАК Сумма,
		|	РеализацияТоваровУслугТовары.СтавкаНДС КАК СтавкаНДС,
		|	РеализацияТоваровУслугТовары.СуммаНДС КАК СуммаНДС,
		|	РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры,
		|	РеализацияТоваровУслугТовары.ЕдиницаИзмеренияМест
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК СтраныМира
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_СтраныМира КАК КонтурЛогистика_СтраныМира
		|			ПО СтраныМира.Код = КонтурЛогистика_СтраныМира.Код
		|		ПО РеализацияТоваровУслугТовары.СтранаПроисхождения = СтраныМира.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		// в старых версиях нет СтраныПроисхождения в ТЧ Товары
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПО РеализацияТоваровУслугТовары.СтранаПроисхождения",
												 "ПО РеализацияТоваровУслугТовары.Номенклатура.СтранаПроисхождения");
		РезультатЗапроса = Запрос.Выполнить();
	КонецПопытки;
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ПолучитьТЧТоварыПеремещение(Знач ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
		|	КонтурЛогистика_СтраныМира.Ссылка КАК СтранаПроисхожденияКЛ,
		|	ПеремещениеТоваровТовары.Ссылка КАК Ссылка,
		|	ПеремещениеТоваровТовары.НомерСтроки КАК НомерСтроки,
		|	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ПеремещениеТоваровТовары.КоличествоМест КАК КоличествоМест,
		|	ПеремещениеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПеремещениеТоваровТовары.Коэффициент КАК Коэффициент,
		|	ПеремещениеТоваровТовары.Количество КАК Количество,
		|	ПеремещениеТоваровТовары.Цена КАК Цена,
		|	ПеремещениеТоваровТовары.ХарактеристикаНоменклатуры,
		|	ПеремещениеТоваровТовары.ЕдиницаИзмеренияМест
		|ИЗ
		|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК СтраныМира
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтурЛогистика_СтраныМира КАК КонтурЛогистика_СтраныМира
		|				ПО СтраныМира.Код = КонтурЛогистика_СтраныМира.Код
		|			ПО НоменклатураСпр.СтранаПроисхождения = СтраныМира.Ссылка
		|		ПО ПеремещениеТоваровТовары.Номенклатура = НоменклатураСпр.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
		|		ПО (НоменклатураСпр.КодТНВЭД = КлассификаторТНВЭД.Ссылка)
		|ГДЕ
		|	ПеремещениеТоваровТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ПолучитьСкладИзГруппыДоступности(Знач вхСклад)
	
	Если ТипЗнч(вхСклад) = Тип("СправочникСсылка.Склады") Тогда
		Возврат вхСклад;
	КонецЕсли;
	
	Если ТипЗнч(вхСклад) = Тип("СправочникСсылка.ГруппыДоступностиСкладов") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СоставГруппДоступностиСкладов.Склад
			|ИЗ
			|	РегистрСведений.СоставГруппДоступностиСкладов КАК СоставГруппДоступностиСкладов
			|ГДЕ
			|	СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступности
			|	И НЕ СоставГруппДоступностиСкладов.Склад.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ГруппаДоступности", вхСклад);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.Склад;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции

Процедура РассчитатьПараметрыГруза(Знач ТекущаяСтрока, НоваяСтрока, ЭтоТ1 = Истина, ЭтоПЭ1 = Ложь)
	
	Попытка 
		НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки;
	Исключение
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецПопытки;
	
	Если Не ЭтоПЭ1 Тогда
		НоваяСтрока.СостояниеГруза = "Без замечаний";	
	КонецЕсли;
		
	НоваяСтрока.ОтгрузочноеНаименование = ТекущаяСтрока.Номенклатура.Наименование;
	НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
	НоваяСтрока.Характеристика = ТекущаяСтрока.ХарактеристикаНоменклатуры;
	НоваяСтрока.УпаковкаЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
	НоваяСтрока.Количество = ТекущаяСтрока.Количество;
	НоваяСтрока.КоличествоМест = ТекущаяСтрока.Количество;
	НоваяСтрока.Учитывать = Истина;
	
	Попытка
		МассаПлановаяБруттоКг = КонтурЛогистика_ИнтеграцияТиповыеСервер.МассаБрутто(ТекущаяСтрока);
	Исключение
		МассаПлановаяБруттоКг = 0;
	КонецПопытки;
	
	Если ЭтоТ1 Тогда
		НоваяСтрока.МассаПлановаяБруттоКг = МассаПлановаяБруттоКг;
	Иначе
		НоваяСтрока.МассаБруттоКг = МассаПлановаяБруттоКг;
	КонецЕсли;
	
	Если ЭтоПЭ1 Тогда
		НоваяСтрока.МассаНеттоКг = МассаПлановаяБруттоКг;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаИзмеренияМест) Тогда
		НоваяСтрока.УпаковкаЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмеренияМест;
		НоваяСтрока.ОбъемКубМ = ТекущаяСтрока.ЕдиницаИзмеренияМест.Объем;
	ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаИзмерения) Тогда 
		НоваяСтрока.ОбъемКубМ = ТекущаяСтрока.ЕдиницаИзмерения.Объем;
	КонецЕсли;
	
	Если ТекущаяСтрока.КоличествоМест > 0 Тогда
		НоваяСтрока.КоличествоМест = ТекущаяСтрока.КоличествоМест;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеРеквизиты

Процедура ЗаполнитьДокументЛогистикиДополнительнымиРеквизитами(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	Попытка
	    
		Если КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСерверПовтИсп.РасширениеСДополнительнымиРеквизитамиУстановлено()
				Или КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыОФПовтИсп.КонфигурацияСДополнительнымиРеквизитамиУстановлена() Тогда		
			ПродолжитьЗаполнениеДокументаЛогистикиДополнительнымиРеквизитами(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации);		
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = "Ошибка заполнения дополнительными реквизитами при конвертации документа. " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПродолжитьЗаполнениеДокументаЛогистикиДополнительнымиРеквизитами(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_НомерЗаказа", "НомЗак");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ДатаЗаказа", "ДатаЗак");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_Перевозчик", "Перевозчик", "КонвертироватьВОрганизациюДиадок");
		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ЭтоЭкспедиция", "ЭтоЭкспедиция");		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_ЭкспедицияЗаказчик", "ЭкспедицияЗаказчик", "КонвертироватьВОрганизациюДиадок");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_ЭкспедицияДоговор", "ЭкспедицияДоговор", "КонвертироватьВДоговор");		
		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_ПогрузкуОсуществляет", "ПогрузкуОсуществляет", "КонвертироватьВОрганизациюДиадок");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_ПогрузкуОсуществляетСотрудник", "ПогрузкаСотрудник", "КонвертироватьВСотрудника");		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_ПогрузкуОсуществляетДоговор", "ПогрузкаДоговор", "КонвертироватьВДоговор");
		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ТранспортноеСредство", "ТранспортноеСредство");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_Прицеп", "Прицеп");	
		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитДокумента(ДокументОбъект, 
		ДокументОснование, "КонтурЛогистика_Водитель", "Водитель", "КонвертироватьВСотрудника");	
		
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ЗаявленнаяДатаПодачиТС", "ДатаВремяПодачиПлановая");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ФактическаяДатаПодачиТС", "ДатаВремяПрибытия");
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ФактическаяДатаУбытияТС", "ДатаВремяУбытия");
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(ДокументОбъект, ДокументОснование, 
		"КонтурЛогистика_ИнициаторПереадресации", "ИнициаторПереадресации");
	
	Если ДокументОбъект.Метаданные().ТабличныеЧасти.Найти("ТелефоныПереадресующего") <> Неопределено 
		И ЗначениеЗаполнено(ДокументОснование.КонтурЛогистика_КонтактыИнициатораПереадресации) Тогда  
		НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
		НоваяСтрока.Телефон = ДокументОснование.КонтурЛогистика_КонтактыИнициатораПереадресации;
	КонецЕсли;
			
КонецПроцедуры

Процедура ВычислитьДополнительныеРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(СправочникОснование, ДокументОснование, 
	КонтекстНастройкиКонвертации, Результат)
	
	Попытка
	    
		Если КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСерверПовтИсп.РасширениеСДополнительнымиРеквизитамиУстановлено()
				Или КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыОФПовтИсп.КонфигурацияСДополнительнымиРеквизитамиУстановлена() Тогда		
			ПродолжитьВычислениеДополнительныхРеквизитоыСправочникаЛогистикиПоУчетномуОбъекту(СправочникОснование, ДокументОснование, 
				КонтекстНастройкиКонвертации, Результат);		
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = "Ошибка вычисления дополнительных реквизитов при конвертации справочника. " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПродолжитьВычислениеДополнительныхРеквизитоыСправочникаЛогистикиПоУчетномуОбъекту(СправочникОснование, ДокументОснование, 
	КонтекстНастройкиКонвертации, Результат)
	
	Если КонтекстНастройкиКонвертации.РеквизитТитула = "МестоПогрузки" Тогда
		
		Если КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Строка"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Организации"
			Или КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Контрагенты" Тогда
			
			КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитСправочника(СправочникОснование, 
				ДокументОснование.КонтурЛогистика_Собственник, "Собственник", "КонвертироватьВОрганизациюДиадок", Результат);
			КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитСправочника(СправочникОснование, 
				ДокументОснование.КонтурЛогистика_СобственникДоговор, "ДоступКОбъектуДоговор", "КонвертироватьВДоговор", Результат);
			КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитСправочника(ДокументОснование, "КонтурЛогистика_НетДоговораСобственникТекст",
				"ДоступКОбъектуТекст", Результат);	
			
		ИначеЕсли КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "Склады" Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И ЗначениеЗаполнено(ДокументОснование) Тогда
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитСправочника(СправочникОснование, 
					ДокументОснование.КонтурЛогистика_Собственник, "Собственник", "КонвертироватьВОрганизациюДиадок", Результат);
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитСправочника(СправочникОснование, 
					ДокументОснование.КонтурЛогистика_СобственникДоговор, "ДоступКОбъектуДоговор", "КонвертироватьВДоговор", Результат);
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитСправочника(ДокументОснование, 
					"КонтурЛогистика_НетДоговораСобственникТекст", "ДоступКОбъектуТекст", Результат);
			Иначе
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитСправочника(СправочникОснование, 
					СправочникОснование.КонтурЛогистика_Собственник, "Собственник", "КонвертироватьВОрганизациюДиадок", Результат);
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьСконвертированныйДополнительныйРеквизитСправочника(СправочникОснование, 
					СправочникОснование.КонтурЛогистика_СобственникДоговор, "ДоступКОбъектуДоговор", "КонвертироватьВДоговор", Результат);
				КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитСправочника(СправочникОснование, 
					СправочникОснование.КонтурЛогистика_НетДоговораСобственникТекст, "ДоступКОбъектуТекст", Результат);
			КонецЕсли;
				
		КонецЕсли;		
				
	ИначеЕсли КонтекстНастройкиКонвертации.РеквизитТитула = "Водитель"
		И КонтекстНастройкиКонвертации.ТипСправочникаИлиДокументаУС = "ФизическиеЛица" Тогда
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("ВУНомер", СправочникОснование.КонтурЛогистика_НомерВУ, Результат);
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("ВУСерия", СправочникОснование.КонтурЛогистика_СерияВУ, Результат);
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("ВУДатаВыдачи", СправочникОснование.КонтурЛогистика_ДатаВыдачиВУ, Результат);
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("ТелефонОсновной", СправочникОснование.КонтурЛогистика_Телефон, Результат);
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("РольВодитель", Истина, Результат);
		
	ИначеЕсли КонтекстНастройкиКонвертации.РеквизитТитула = "ПогрузкаСотрудник" Тогда
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("Должность", "Сотрудник", Результат);
		КонтурЛогистика_ОбщегоНазначенияСервер.ДобавитьВВычисленныеРеквизиты("РольКладовщик", Истина, Результат);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьДополнительнымиРеквизитамиТЧДокумента(ДокументОбъект, ИмяТЧ, СтрокаОснование, НоваяСтрока, КонтекстНастройкиКонвертации)
	
	Попытка
	    
		Если КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыСерверПовтИсп.РасширениеСДополнительнымиРеквизитамиУстановлено()
				Или КонтурЛогистика_ИнтеграцияТиповые_ДопРеквизитыОФПовтИсп.КонфигурацияСДополнительнымиРеквизитамиУстановлена() Тогда		
			ПродолжитьЗаполнениеДополнительнымиРеквизитамиТЧДокумента(ДокументОбъект, ИмяТЧ, СтрокаОснование, НоваяСтрока, КонтекстНастройкиКонвертации);		
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = "Ошибка заполнения дополнительными реквизитами при конвертации табличной части документа. " + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПродолжитьЗаполнениеДополнительнымиРеквизитамиТЧДокумента(ДокументОбъект, ИмяТЧ, СтрокаОснование, НоваяСтрока, КонтекстНастройкиКонвертации) 
	
	Если ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти("СостояниеГруза") <> Неопределено Тогда
		КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(НоваяСтрока, СтрокаОснование, 
			"КонтурЛогистика_СостояниеГруза", "СостояниеГруза", Истина);	
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти("КоличествоМест") <> Неопределено Тогда
		КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(НоваяСтрока, СтрокаОснование, 
			"КонтурЛогистика_КоличествоМест", "КоличествоМест", Истина);
	КонецЕсли;
	
	Если ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти("ВидТары") <> Неопределено Тогда
		КонтурЛогистика_ОбщегоНазначенияСервер.ЗаполнитьДополнительныйРеквизитДокумента(НоваяСтрока, СтрокаОснование, 
			"КонтурЛогистика_ВидТары", "ВидТары", Истина);
	КонецЕсли;
	
КонецПроцедуры

