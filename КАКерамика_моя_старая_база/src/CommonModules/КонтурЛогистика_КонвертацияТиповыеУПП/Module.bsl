			Если ИменаРеквизитов.Найти("СвГП") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("СвГП", РассчитатьГП_РТУ(ДокументОснование));
			КонецЕсли;
			
			Если ИменаРеквизитов.Найти("АдрГруз") <> Неопределено Тогда
				ЗначенияРеквизитов.Вставить("АдрГруз", ДокументОснование.Склад);
