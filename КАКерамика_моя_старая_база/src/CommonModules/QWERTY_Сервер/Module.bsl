Функция ПолучитьЦенуОптРасч(п_Номенклатура, п_ДатаЦены) Экспорт
	
	ЦенаОпт			= ПолучитьЦенуОпт(п_Номенклатура, п_ДатаЦены);
	ЦенаАкционная	= ПолучитьЦенуАкция(п_Номенклатура, п_ДатаЦены);
	Наценка			= ПолучитьНаценкуОпт();

	Если ЦенаАкционная = 0 Тогда
		Рез = ЦенаОпт;
	Иначе
		СкидкаСумма = ЦенаАкционная * Наценка / 100;
		Рез = ЦенаОпт + СкидкаСумма;
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()
	
