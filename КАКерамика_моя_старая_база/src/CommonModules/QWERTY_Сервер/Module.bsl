	Если ТипЗнч(п_Док) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Попытка
			Если ЗначениеЗаполнено(п_Док.Партнер) Тогда
				Возврат п_Док.Партнер.ОсновнойМенеджер;	
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;	

	Возврат "";
	
КонецФункции // ()

