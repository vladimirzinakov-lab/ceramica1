Процедура ЗаполнитьПутиРеквизитов_РасходнаяНакладная(Контекст)
	
	ИмяТаблицы = "РасходнаяНакладная";
	Пути = Контекст.ПутиРеквизитовУчетногоДокумента;
	
	Пути.ПутьОрганизация = "Организация";
	Пути.ПутьКонтрагент = "Контрагент";
	Пути.ПутьГрузоотправитель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
		ИмяТаблицы, "Грузоотправитель", "Организация", ИмяТаблицы);
	Пути.ПутьГрузополучатель = КонтурЛогистика_КонвертацияТиповые.ПутьРеквизитаСЗапаснымЗначением(
		ИмяТаблицы, "Грузополучатель", "Контрагент", ИмяТаблицы);
	Пути.ПутьДатаТРН = "Дата";
	Пути.ПутьНомерТРН = "Номер";
	Пути.ПутьМестоДоставки = "АдресДоставки";
	Пути.ПутьМестоПогрузки = "СтруктурнаяЕдиница";
	Пути.ПутьПеревозчик = "Перевозчик";
	Пути.ПутьТранспортноеСредство = "Автомобиль";
	Пути.ПутьВодитель = "Водитель";
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ТрН_Титул1_РасходнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ДокументОбъект.ДатаВремяУбытия = ТекущаяДатаСеанса();
	
	ПродолжительностьПогрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"СредняяПродолжительностьПогрузки", ДокументОбъект.ДокументЭТРН.ПартнерГрузоотправитель);
	Если ТипЗнч(ПродолжительностьПогрузки) = Тип("Число") Тогда
		ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - ПродолжительностьПогрузки * 60;
	Иначе
		ДатаВремяПодачиПлановая = ДокументОбъект.ДатаВремяУбытия - 3600;
	КонецЕсли;	
	ДокументОбъект.ДатаВремяПодачиПлановая 	= ДатаВремяПодачиПлановая;
	ДокументОбъект.ДатаВремяПрибытия 		= ДатаВремяПодачиПлановая;
	
	ДокументОбъект.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель;
	ДокументОбъект.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03;
	
	// ТЧ ТелефоныПереадресующего
	НоваяСтрока = ДокументОбъект.ТелефоныПереадресующего.Добавить();
	НоваяСтрока.Телефон = ДокументОбъект.ДокументЭТРН.Грузоотправитель.ТелефонОсновной;
	
	МодульОбщегоПользователи = КонтурЛогистика_СтдОбщегоНазначения.ОбщийМодульЛок("Пользователи");
	Если МодульОбщегоПользователи <> Неопределено Тогда
		ДокументОбъект.ПользовательПодписант = МодульОбщегоПользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.Водитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Водитель, "Водитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
		ДокументОснование, ДокументОбъект);
	
	// ТЧ Товары
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровТрН(ДокументОбъект, ДокументОснование) Цикл
		
		Для Каждого ТекущаяСтрока Из ТекДокОснование.Запасы Цикл
			
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			Попытка 
				НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки;
			Исключение
				НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецПопытки;
			НоваяСтрока.СостояниеГруза = "Без замечаний";
			НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
			НоваяСтрока.Характеристика = ТекущаяСтрока.Характеристика;
			НоваяСтрока.Количество = ТекущаяСтрока.Количество;
			НоваяСтрока.ОбъявленнаяЦенность = ТекущаяСтрока.Сумма;
			НоваяСтрока.Учитывать = Истина;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ПЛ_Титул1_РасходнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ДокументОбъект.СрокПЛ = ДокументОснование.Дата;
	ДокументОбъект.ДатаПЛ = ДокументОснование.Дата;
	ДокументОбъект.НомерПЛ = ДокументОснование.Номер;
	
	ДокументОбъект.ЛицоОформившееПЛ = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Организация, "ЛицоОформившееПЛ",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Водитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Водитель, "Водитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВСотрудника,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.ТранспортноеСредство = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Автомобиль, "ТранспортноеСредство",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВТранспортноеСредство,
		ДокументОснование, ДокументОбъект);
	
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		ДокументОбъект.МестоОтправления = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
			ДокументОснование.СтруктурнаяЕдиница, "МестоОтправления",
			Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
			ДокументОснование, ДокументОбъект);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитул_ЗЗ_Титул1_РасходнаяНакладная(ДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации)
	
	ДокументОбъект.ДатаЗак = ДокументОснование.Дата;
	ДокументОбъект.ДатВрПод = ТекущаяДатаСеанса();
	ДокументОбъект.ТСВместим = ДокументОснование.Автомобиль.ВместимостьВКубическихМетрах;
	ДокументОбъект.ТСГрузопод = ДокументОснование.Автомобиль.ГрузоподъемностьВТоннах;
	ДокументОбъект.ТСТип = "Грузовой";
	ДокументОбъект.Функция = Перечисления.КонтурЛогистика_ФункцииЗаказаЗаявки.Заказ;
	ДокументОбъект.ПрвзПищПрод = "Отсутствуют";
	ДокументОбъект.ПредСрПрвз = "Отсутствуют";
	ДокументОбъект.КонПунктМрш = ДокументОснование.АдресДоставки;
	ДокументОбъект.НомЗак = ДокументОснование.Номер;
	
	Грузоотправитель = ?(ЗначениеЗаполнено(ДокументОснование.Грузоотправитель),
		ДокументОснование.Грузоотправитель, ДокументОснование.Организация);
	ДокументОбъект.Грузоотправитель = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		Грузоотправитель, "Грузоотправитель",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.Перевозчик = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.Перевозчик, "Перевозчик",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок,
		ДокументОснование, ДокументОбъект);
	
	ДокументОбъект.ПунктПод = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.СтруктурнаяЕдиница, "ПунктПод",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	// ТЧ Товары
	Для Каждого ТекДокОснование Из КонтурЛогистика_КонвертацияТиповые.ОснованияДляЗаполненияТоваровЗЗ(ДокументОбъект, ДокументОснование) Цикл
		
		Для Каждого ТекущаяСтрока Из ТекДокОснование.Запасы Цикл
			
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
					ТекущаяСтрока, КонтекстНастройкиКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			Попытка 
				НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки;
			Исключение
				НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецПопытки;
			НоваяСтрока.ОтгрузочноеНаименование = ТекущаяСтрока.Номенклатура.Наименование;
			НоваяСтрока.СостояниеГруза = "Без замечаний";
			НоваяСтрока.Количество = ТекущаяСтрока.Количество;
			НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
			НоваяСтрока.Характеристика = ТекущаяСтрока.Характеристика;
			НоваяСтрока.УпаковкаЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
			НоваяСтрока.МетодОпределенияМассы = Перечисления.КонтурЛогистика_МетодыОпределенияМассы._03;
			НоваяСтрока.Учитывать = Истина;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// ТЧ АдрПункт
	НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
	НоваяСтрока.Погрузка = Истина;
	НоваяСтрока.ПунктМаршрута = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.СтруктурнаяЕдиница, "ПунктМаршрута",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
	НоваяСтрока = ДокументОбъект.АдрПункт.Добавить();
	НоваяСтрока.Выгрузка = Истина;
	НоваяСтрока.ПунктМаршрута = КонтурЛогистика_КонвертацияТиповые.КонвертироватьЗначениеВОбъектЛогистики(
		ДокументОснование.АдресДоставки, "МестоДоставки",
		Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВПунктМаршрута,
		ДокументОснование, ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти