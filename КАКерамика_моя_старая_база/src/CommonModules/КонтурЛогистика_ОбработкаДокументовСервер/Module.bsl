Функция ОтправитьШаблоныВДиадок(МассивСсылок) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;

	Для Каждого ФайлОбменаСсылка Из МассивСсылок Цикл
		
		Попытка
			
			ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
			РезультатОтправки = ФайлОбменаОбъект.ОтправитьШаблон();
			
				
			Если НЕ РезультатОтправки.Успешно Тогда
				
				Результат.Успешно = Ложь;
				Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
				
			КонецЕсли;
			
		Исключение
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить("Не удалось отправить шаблон в Диадок " + ФайлОбменаСсылка + " по причине: " + ОписаниеОшибки());
			
		КонецПопытки;
		
		//Если РезультатОтправки.Успешно Тогда
		//	
		//	// TODO пока непонятно, что делать после отправки
		//	
		//КонецЕсли;	
		
	КонецЦикла;	

КонецФункции	

Процедура СохранитьДанныеCustomDataВДокументЭТРН(Знач CustomDataМассив, Знач ДатаВремяМСК, Знач ГлавныйДокумент,
	Знач ДопДанные = Неопределено, Знач СобытиеБезИзмененияСтатусаДокументооборота = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ГлавныйДокумент) Тогда
		Возврат;
	КонецЕсли;
	
	// CustomDataМассив может быть как массив так и ТЧ CustomData спарвочника Файлы
	Для Каждого элементCustomData Из CustomDataМассив Цикл
		
		Если элементCustomData.Key = "kl-id"
			И (ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
				Или ЭтоТитулПЛ(ГлавныйДокумент)
				Или ЭтоТитулЭР(ГлавныйДокумент)
				Или ЭтоТитулСР(ГлавныйДокумент)) Тогда
			
			Если Не ЗначениеЗаполнено(СокрЛП(ГлавныйДокумент.kl_id)) Тогда
				
				Если ЗначениеЗаполнено(ГлавныйДокумент.Номер) Тогда // мало ли там объект не найден в результате криворукого удаления
					ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
					ГлавныйДокументОбъект.kl_id = элементCustomData.Value;
					ГлавныйДокументОбъект.Записать();
				КонецЕсли;
				
			ИначеЕсли ГлавныйДокумент.kl_id <> элементCustomData.Value Тогда
				
				Сообщить("По " + ГлавныйДокумент + " Перепутаны идентификатор kl_id в 1С модуле: "
					+ ГлавныйДокумент.kl_id + " и в сервисе: " + элементCustomData.Value);
				
			КонецЕсли;
			
		ИначеЕсли элементCustomData.Key = "kl-status"
			Или элементCustomData.Key = "kl-newStatus" Тогда
			
			// Если статус не менялся, то не будем записывать
			Если СобытиеБезИзмененияСтатусаДокументооборота Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(элементCustomData) = Тип("Структура") Тогда
				Период = ДатаВремяМСК;
			Иначе
				Период = элементCustomData.ДатаВремяМСКПолучения;
			КонецЕсли;
			
			Если элементCustomData.Key = "kl-status" Тогда
				КодСостоянияСервиса = ПривестиКодСостоянияСервисаДляДокумента(ГлавныйДокумент, элементCustomData.Value);
				Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоКодуСостояниюСервиса(
					КодСостоянияСервиса);
			Иначе
				Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоАнглНаименованиюСостояниюСервиса(
					элементCustomData.Value);
			КонецЕсли;
			
			Попытка
				Если ДопДанные <> Неопределено // возможен разный тип у элементCustomData!
					И (ТипЗнч(элементCustomData) = Тип("Структура") И элементCustomData.Свойство("EventId")
						ИЛИ
						ТипЗнч(элементCustomData) = Тип("СправочникТабличнаяЧастьСтрока.КонтурЛогистика_ФайлыОбмена.CustomData"))
					Тогда
					ДопДанные.ИдентификаторСобытия = элементCustomData.EventId;
					Если Лев(элементCustomData.Value, 3) = "pl-" Тогда
						ДопДанные.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
					Иначе
						ДопДанные.КаналТранспорта = КаналТранспортаПоИдентификаторуСобытия(элементCustomData.EventId);
					КонецЕсли;
				КонецЕсли;
			Исключение
				НичегоНеДелаем = Истина;
			КонецПопытки; 
			
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ГлавныйДокумент, Состояние, Период,,, ДопДанные);
			
		ИначеЕсли элементCustomData.Key = "mt-id" Тогда
			
			Если ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
				И Не ЗначениеЗаполнено(ГлавныйДокумент.УИД) Тогда
				
				ДобавитьУИДМинтрансаВЭТрНИТитул(ГлавныйДокумент, элементCustomData.Value);
				
			ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				И Не ЗначениеЗаполнено(ГлавныйДокумент.УИД_Зак)
				И ГлавныйДокумент.УИД_Зак <> элементCustomData.Value Тогда
				
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.УИД_Зак = элементCustomData.Value;
				ГлавныйДокументОбъект.Записать();
				
			ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка")
				И Не ЗначениеЗаполнено(ГлавныйДокумент.УИД_ЭкспР)
				И ГлавныйДокумент.УИД_ЭкспР <> элементCustomData.Value Тогда
				
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.УИД_ЭкспР = элементCustomData.Value;
				ГлавныйДокументОбъект.Записать();
			
			ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_СкладскаяРасписка")
				И Не ЗначениеЗаполнено(ГлавныйДокумент.УИД_СкладР)
				И ГлавныйДокумент.УИД_СкладР <> элементCustomData.Value Тогда
				
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.УИД_СкладР = элементCustomData.Value;
				ГлавныйДокументОбъект.Записать();
			
			ИначеЕсли ТипЗнч(ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1")
				И Не ЗначениеЗаполнено(ГлавныйДокумент.УИД_ПорЭксп)
				И ГлавныйДокумент.УИД_ПорЭксп <> элементCustomData.Value Тогда
				
				ГлавныйДокументОбъект = ГлавныйДокумент.ПолучитьОбъект();
				ГлавныйДокументОбъект.УИД_ПорЭксп = элементCustomData.Value;
				ГлавныйДокументОбъект.Записать();	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КаналТранспортаПоИдентификаторуСобытия(ИдентификаторСобытия) Экспорт
	
	Если ЗначениеЗаполнено(ИдентификаторСобытия) Тогда
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторСобытия) Тогда
			КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.Диадок;
		Иначе
			КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика;
		КонецЕсли;
	Иначе
		КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.ПустаяСсылка();
	КонецЕсли;
	
	Возврат КаналТранспорта;
	
КонецФункции

Процедура СохранитьДанныеCustomDataВФайл(ФайлОбменаОбъект, ЕстьИзмененияФайлаОбмена, Знач CustomDataМассив, Знач ДатаВремяМСК, Знач EventId) Экспорт
	
	Для Каждого ЭлементCustomData Из CustomDataМассив Цикл
		
		Если ЭлементCustomData.Key = "kl-id" И ФайлОбменаОбъект.kl_id = "" Тогда 
			
			ФайлОбменаОбъект.kl_id = ЭлементCustomData.Value;
			ЕстьИзмененияФайлаОбмена = Истина;
			
		Иначе
			
			Если ФайлОбменаОбъект.CustomData.Найти(ЭлементCustomData.Value, "Value") = Неопределено Тогда 
			
				НоваяЗапись = ФайлОбменаОбъект.CustomData.Добавить();
				НоваяЗапись.Key = ЭлементCustomData.Key;
				НоваяЗапись.Value = ЭлементCustomData.Value;
				НоваяЗапись.ДатаВремяМСКПолучения = ДатаВремяМСК;
				НоваяЗапись.EventId = EventId;
				
				ЕстьИзмененияФайлаОбмена = Истина;
				
				// Отправка уведомлений водителю о необходимости подписать
				Если НоваяЗапись.Key = "kl-status"
					И (НоваяЗапись.Value = "r-wait-driver-approve"
						Или НоваяЗапись.Value = "d-wait-driver-approve"
						Или НоваяЗапись.Value = "pd-wait-driver-approve")
					И ФайлОбменаОбъект.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
					И ЗначениеЗаполнено(ФайлОбменаОбъект.ГлавныйДокумент) Тогда
					
					Попытка
						КонтурЛогистика_Уведомления.ОтправитьУведомленияОНеобходимостиПодписатьВодителем(
							ФайлОбменаОбъект.ГлавныйДокумент, НоваяЗапись.Value);
					Исключение
						ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
						ТекстОшибки = "Ошибка при отправке уведомления водителя.
							|Текст ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,
							ФайлОбменаОбъект.ГлавныйДокумент, ТекстОшибки);
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеПользователяИзСобытия(ДанныеСобытия) Экспорт
	
	Данные = Новый Соответствие;
	
	СырыеДанные = ДанныеСобытия.Event.Document.DocumentInfo.CustomData;
	
	Для каждого ЭлементДанных Из СырыеДанные Цикл
		
		Данные.Вставить(ЭлементДанных["Key"], ЭлементДанных["Value"]);
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция СсылкаВБраузереДиадок(ДокументСсылка) Экспорт
	
	ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументСсылка); 
	
	Если ФайлОбмена = Неопределено Тогда
		
		Результат = Неопределено;
		
	Иначе
		
		Если ФайлОбмена.Состояние = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СосотоянияФайловОбмена.Получен") Тогда 
			// это входящий
			BoxId = ФайлОбмена.Получатель.ID;
		Иначе
			// исходящий
			Если  ЗначениеЗаполнено(ФайлОбмена.ОтправительШаблона) Тогда
				BoxId = ФайлОбмена.ОтправительШаблона.ID;
			Иначе 	
				BoxId = ФайлОбмена.Отправитель.ID;
			КонецЕсли;
				
		КонецЕсли;
		
		LetterId	= ФайлОбмена.MessageID;
		DocumentId	= ФайлОбмена.DocumentId;
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") = Истина Тогда 
			АдресВебСервиса = "diadoc-staging.kontur.ru";
		Иначе
			АдресВебСервиса = "diadoc.kontur.ru";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФайлОбмена.ОтправительШаблона) Тогда
			СтрокаШаблона = "https://%1/%2/templates/%3/documents/%4";
		Иначе
			СтрокаШаблона = "https://%1/%2/document/show?letterId=%3&documentId=%4";
		КонецЕсли;
		
		Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(СтрокаШаблона, АдресВебСервиса, BoxId, LetterId, DocumentId);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СсылкаВБраузереЛогистика(ДокументСсылка) Экспорт
	
	Перем ДокЭтрн, ДокЭПЛ;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументСсылка);
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда
		ДокЭтрн = ДокументСсылка.ДокументЭТРН;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная") Тогда
		ДокЭтрн = ДокументСсылка;
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
			ДокЭПЛ = ДокументСсылка;
		Иначе
			ДокЭПЛ = ДокументСсылка.Титул1;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокЭтрн) Тогда
		
		Т1 = НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокЭтрн); 
		Если ЗначениеЗаполнено(Т1.Составитель) 
			И Не ДокЭтрн.Грузоотправитель.Наш Тогда
			
			Сторона = "consignor"; // у составителя страница consignor  
			boxId = Т1.Составитель.ID;
		
		ИначеЕсли ЗначениеЗаполнено(ДокЭтрн.Грузоотправитель) И ДокЭтрн.Грузоотправитель.Наш Тогда
			Сторона = "consignor"; // ГО
			boxId = ДокЭтрн.Грузоотправитель.ID;
		ИначеЕсли ЗначениеЗаполнено(ДокЭтрн.Грузополучатель) И ДокЭтрн.Грузополучатель.Наш Тогда
			Сторона = "consignee";  // ГП
			boxId = ДокЭтрн.Грузополучатель.ID;
		ИначеЕсли ЗначениеЗаполнено(ДокЭтрн.Перевозчик) И ДокЭтрн.Перевозчик.Наш Тогда
			Сторона = "carrier";  // ПВ
			boxId = ДокЭтрн.Перевозчик.ID;
		Иначе
			boxId = Неопределено;
			Сообщить("Не могу определить нашу организацию по документу: " + ДокументСсылка + " Проверьте галочку Наш в организациях.");
			Возврат Неопределено;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СокрЛП(ДокЭтрн.kl_id)) Тогда 
			kl_id = Неопределено;
			Сообщить("Из диадока еще не получен идентификатор по документу: " + ДокументСсылка + " Проверьте что документ отправлен.");
			Возврат Неопределено;
		Иначе
			kl_id = ДокЭтрн.kl_id;
		КонецЕсли;
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") = Истина Тогда 
			АдресВебСервиса = "logist-staging.kontur.ru";
		Иначе
			АдресВебСервиса = "logist.kontur.ru";
		КонецЕсли;
		
		ЗакладкаВВебеПоТрн = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ЗакладкаВВебеПоТрн(ДокЭтрн);
		
		СтрокаШаблона = "https://%1/%2/"+ Сторона +"/%3/%4";
		
		Если  Сторона = "ПВ" И ЗакладкаВВебеПоТрн = "shipped" Тогда
			
			ЗакладкаВВебеПоТрн = "on-the-way";
			
		КонецЕсли;
		
		Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(СтрокаШаблона, АдресВебСервиса, BoxId, ЗакладкаВВебеПоТрн, kl_id);
		
	ИначеЕсли ЗначениеЗаполнено(ДокЭПЛ) Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") = Истина Тогда
			АдресВебСервиса = "logist-staging.kontur.ru";
		Иначе
			АдресВебСервиса = "logist.kontur.ru";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокЭПЛ.ЛицоОформившееПЛ) И ДокЭПЛ.ЛицоОформившееПЛ.Наш Тогда
			boxId = ДокЭПЛ.ЛицоОформившееПЛ.ID;
		ИначеЕсли ЗначениеЗаполнено(ДокЭПЛ.ОрганизацияМедик) И ДокЭПЛ.ОрганизацияМедик.Наш Тогда
			boxId = ДокЭПЛ.ОрганизацияМедик.ID;
		ИначеЕсли ЗначениеЗаполнено(ДокЭПЛ.ОрганизацияТехСостояние) И ДокЭПЛ.ОрганизацияТехСостояние.Наш Тогда
			boxId = ДокЭПЛ.ОрганизацияТехСостояние.ID;
		ИначеЕсли ЗначениеЗаполнено(ДокЭПЛ.ОрганизацияОдометр) И ДокЭПЛ.ОрганизацияОдометр.Наш Тогда
			boxId = ДокЭПЛ.ОрганизацияОдометр.ID;
		Иначе
			Сообщить("Не могу определить нашу организацию по документу: " + ДокументСсылка + " Проверьте галочку Наш в организациях.");
			Возврат Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СокрЛП(ДокЭПЛ.kl_id)) Тогда
			kl_id = ДокЭПЛ.kl_id;
		Иначе
			Сообщить("Из Логистики еще не получен идентификатор по документу: " + ДокументСсылка + ". Проверьте что документ отправлен.");
			Возврат Неопределено;
		КонецЕсли;
		
		СтрокаШаблона = "https://%1/%2/carrier/sign/epl/%3";
		
		Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
			СтрокаШаблона, АдресВебСервиса, BoxId, kl_id);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьВФайлПодписьИРазблокировать(ФайлОбменаСсылка, ДанныеПодписи, ДанныеСертификата) Экспорт
	
