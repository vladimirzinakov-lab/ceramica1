Функция НайтиЗН(ДокументУчетнойСистемы, НастройкаКонвертации) Экспорт

	НайденныйЗН = Неопределено;
	
	// Поиск существующего Этрн по: НомерТрН+ДатаТрН+Грузоотправитель
	// Сконвертируем ключевые реквизиты поиска	
	
	ПравилоКонвертацииНомерЗН = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти("НомерЗН", "РеквизитТитула");
	Если ПравилоКонвертацииНомерЗН <> Неопределено Тогда 
		РезультатНомерЗН = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(ДокументУчетнойСистемы, ПравилоКонвертацииНомерЗН, НастройкаКонвертации);  
		НомерЗН = РезультатНомерЗН.Значение;
	КонецЕсли;
	
	ПравилоКонвертацииДатаЗН = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти("ДатаЗН", "РеквизитТитула");
	Если ПравилоКонвертацииНомерЗН <> Неопределено Тогда 
		РезультатДатаЗН = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(ДокументУчетнойСистемы, ПравилоКонвертацииДатаЗН, НастройкаКонвертации);  
		ДатаЗН = РезультатДатаЗН.Значение;
		Если Не ЗначениеЗаполнено(ДатаЗН) Тогда 
			ДатаЗН = Дата(1,1,1);
		КонецЕсли;
	КонецЕсли;
	
	ПравилоКонвертацииФрахтователь = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти("Фрахтователь", "РеквизитТитула");
	Если ПравилоКонвертацииФрахтователь <> Неопределено Тогда 
		РезультатФрахтователь = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(ДокументУчетнойСистемы, ПравилоКонвертацииФрахтователь, НастройкаКонвертации);  
		Фрахтователь = РезультатФрахтователь.Значение;
		Если Не ЗначениеЗаполнено(Фрахтователь) Тогда
			Фрахтователь = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	// Сам запрос
	Если ЗначениеЗаполнено(НомерЗН) Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ЭлектронныйЗаказНаряд.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.КонтурЛогистика_ЭлектронныйЗаказНаряд КАК КонтурЛогистика_ЭлектронныйЗаказНаряд
		               |ГДЕ
		               |	(КонтурЛогистика_ЭлектронныйЗаказНаряд.Фрахтователь = &Фрахтователь
		               |			ИЛИ КонтурЛогистика_ЭлектронныйЗаказНаряд.Фрахтователь = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка))
		               |	И КонтурЛогистика_ЭлектронныйЗаказНаряд.НомерЗН = &НомерЗН
		               |	И (КонтурЛогистика_ЭлектронныйЗаказНаряд.ДатаЗН = &ДатаЗН
		               |			ИЛИ &ДатаЗН = ДАТАВРЕМЯ(1, 1, 1))
		               |	И НЕ КонтурЛогистика_ЭлектронныйЗаказНаряд.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Фрахтователь", Фрахтователь);
		Запрос.УстановитьПараметр("НомерЗН", НомерЗН);
		Запрос.УстановитьПараметр("ДатаЗН", ДатаЗН);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
		
			НайденныйЗН = Выборка.Ссылка;	
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НайденныйЗН;

КонецФункции

Функция НайтиГлавныйДокументПоФайлу(ФайлСсылка) Экспорт
	
	//1. Ищем: по kl-id
	Если ЗначениеЗаполнено(ФайлСсылка.kl_id) Тогда
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ФайлСсылка.ТипДокумента) Тогда
			ИмяДокумента = "КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная";
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ФайлСсылка.ТипДокумента) Тогда
			ИмяДокумента = "КонтурЛогистика_ПЛ_Титул1_5_02";
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ФайлСсылка.ТипДокумента) Тогда
			ИмяДокумента = "КонтурЛогистика_ПЛ_Титул1";			
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ФайлСсылка.ТипДокумента) Тогда
			ИмяДокумента = "КонтурЛогистика_ПЭ_Титул1";	
		Иначе
			ИмяДокумента = Неопределено;
		КонецЕсли;
		
		Если ИмяДокумента <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("kl_id", ФайлСсылка.kl_id);
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	КонтурЛогистика_Документ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.КонтурЛогистика_Документ КАК КонтурЛогистика_Документ
			|ГДЕ
			|	НЕ КонтурЛогистика_Документ.ПометкаУдаления
			|	И КонтурЛогистика_Документ.kl_id = &kl_id";
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_Документ", ИмяДокумента);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	//2. по УИД (минтранса) - неудаленные, начиная с самой свежей
	ТекстФайла = ФайлСсылка.ТекстXML.Получить();
	XDTOФайл = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
	УИД = ПолучитьМинтрансУИДпоXDTOФайл(XDTOФайл);
	
	Если ЗначениеЗаполнено(УИД) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		               |ГДЕ
		               |	НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
		               |	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.УИД = &УИД
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН УБЫВ,
		               |	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("УИД", УИД);
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ФайлСсылка.ТипДокумента) Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаТрН", "ДатаЗН");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная", "КонтурЛогистика_ЭлектронныйЗаказНаряд");
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(ФайлСсылка.ТипДокумента) Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаТрН", "ДатаСВ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная", "КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость");
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ФайлСсылка.ТипДокумента) Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаТрН", "ДатаПЛ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная", "КонтурЛогистика_ПЛ_Титул1_5_02");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".УИД", ".УИД_ПЛ");	
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ФайлСсылка.ТипДокумента) Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаТрН", "ДатаПЛ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная", "КонтурЛогистика_ПЛ_Титул1");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".УИД", ".УИД_ПЛ");
		ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ФайлСсылка.ТипДокумента) Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаТрН", "ДатаЗак");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная", "КонтурЛогистика_ЗЗ_Титул1");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".УИД", ".УИД_Зак");	
		КонецЕсли;
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
		
				Возврат Выборка.Ссылка;
		
		КонецЕсли;
		
	КонецЕсли;
	
	// 3. по messageId (через другие файлы)
	Если ЗначениеЗаполнено(ФайлСсылка.MessageID) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка,
		               |	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент
		               |ИЗ
		               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		               |ГДЕ
		               |	КонтурЛогистика_ФайлыОбмена.MessageID = &MessageID
		               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
		               |	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент <> ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПустаяСсылка)
		               |	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент <> ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.ПустаяСсылка)
		               |	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент <> ЗНАЧЕНИЕ(Документ.КонтурЛогистика_ЭлектронныйЗаказНаряд.ПустаяСсылка)
		               |	И КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент <> НЕОПРЕДЕЛЕНО";
		
		Запрос.УстановитьПараметр("MessageID", ФайлСсылка.MessageID);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			Возврат Выборка.ГлавныйДокумент;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// 4. по НомерТрН + ДатаТрН / ЗН / СВ из XML
	// 4.1 по указателям на предыдущий файл
	ГлавныйДокумент = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПустаяСсылка();
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ФайлСсылка.ТипДокумента) Тогда 
		
		ГлавныйДокумент = НайтиГлавныйДокументПоФайлуЗН(XDTOФайл, ФайлСсылка);
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(ФайлСсылка.ТипДокумента) Тогда 
		
		ГлавныйДокумент = НайтиГлавныйДокументПоФайлуСВ(XDTOФайл, ФайлСсылка);
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ФайлСсылка.ТипДокумента) Тогда 
		
		ГлавныйДокумент = НайтиГлавныйДокументПоФайлуПЛ(ФайлСсылка);
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ФайлСсылка.ТипДокумента) Тогда 
		
		ГлавныйДокумент = НайтиГлавныйДокументПоФайлуЗЗ(ФайлСсылка);
		
		// TODO для ТРН
		
	КонецЕсли;
	
	// 5. По шаблону основания. Т.е. когда документ сформирован на основании шаблона.
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ФайлСсылка.ТипДокумента)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ФайлСсылка.ТипДокумента)
		И ЗначениеЗаполнено(ФайлСсылка.ШаблонОснование) Тогда
		
		ГлавныйДокумент = ФайлСсылка.ШаблонОснование.ГлавныйДокумент;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

Функция НайтиГлавныйДокументПоФайлуЗЗ(ФайлСсылка) Экспорт
	
	УжеУказанныйВФайле = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ФайлСсылка, "ГлавныйДокумент");
	Если ЗначениеЗаполнено(УжеУказанныйВФайле) Тогда 
		Возврат УжеУказанныйВФайле;
	КонецЕсли;
	
	ГлавныйДокумент = Неопределено;
	
	ТекстФайла = ФайлСсылка.ТекстXML.Получить();
	XDTOФайл = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
	
	Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
		
		ИмяФайла = XDTOФайл.Документ.ИдИнфГО.ИдФайлИнфГО;
		ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка,
		               |	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент,
		               |	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент КАК Титул
		               |ИЗ
		               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		               |ГДЕ
		               |	КонтурЛогистика_ФайлыОбмена.ИмяФайла = &ИмяФайла
		               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
		               |	И КонтурЛогистика_ФайлыОбмена.ТипДокумента = &ТипДокумента";
		
		Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
		Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			ГлавныйДокумент = Выборка.Титул;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

Функция НайтиГлавныйДокументПоФайлуПЛ(ФайлСсылка) Экспорт

	ТипДокумента = Неопределено;
	
	УжеУказанныйВФайле = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаСсылки(ФайлСсылка, "ГлавныйДокумент");
	Если ЗначениеЗаполнено(УжеУказанныйВФайле) Тогда 
		Возврат УжеУказанныйВФайле;
	КонецЕсли;
	
	ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		
	Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
		Или ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
		
		XDTOФайл = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		ИмяФайла = XDTOФайл.Документ.ИдИнфСоб.ИдФайлИнфСоб;
			
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ФайлСсылка.ТипДокумента) Тогда
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02;
		Иначе
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка,
		               |	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент,
		               |	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент КАК Титул
		               |ИЗ
		               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		               |ГДЕ
		               |	КонтурЛогистика_ФайлыОбмена.ИмяФайла = &ИмяФайла
		               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
		               |	И КонтурЛогистика_ФайлыОбмена.ТипДокумента = &ТипДокумента";
		
		Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
		Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			ГлавныйДокумент = Выборка.Титул;
			
		КонецЕсли;
		
	ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5
		Или ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
		
		XDTOФайл = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ФайлСсылка.ТипДокумента) Тогда
			ИмяФайла = XDTOФайл.Документ.ИдИнфВыпуск.ИдФайлИнфВыпуск;
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02;
		Иначе
			ИмяФайла = XDTOФайл.Документ.ИдИнфВыезд.ИдФайлИнфВыезд;
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка,
		               |	КонтурЛогистика_ФайлыОбмена.ГлавныйДокумент КАК ГлавныйДокумент,
		               |	КонтурЛогистика_ФайлыОбмена.СвязанныйДокумент КАК Титул
		               |ИЗ
		               |	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		               |ГДЕ
		               |	КонтурЛогистика_ФайлыОбмена.ИмяФайла = &ИмяФайла
		               |	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
		               |	И КонтурЛогистика_ФайлыОбмена.ТипДокумента = &ТипДокумента";
		
		Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
		Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			ГлавныйДокумент = Выборка.ГлавныйДокумент;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

Функция НайтиГлавныйДокументПоФайлуЗН(Знач XDTOФайл, Знач ФайлСсылка)
	
	ГлавныйДокумент = Документы.КонтурЛогистика_ЭлектронныйЗаказНаряд.ПустаяСсылка();
	
	Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда 
		
		ДатаЗН 	= КонтурЛогистика_КонструкторыXDTO.Конвертировать_ДатаТип_вДата(КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодЗНИнфФт.ДатаЗН"));
		НомерЗН = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодЗНИнфФт.НомерЗН");
		
		Если ЗначениеЗаполнено(НомерЗН) И ЗначениеЗаполнено(ДатаЗН) Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	КонтурЛогистика_ЭлектронныйЗаказНаряд.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.КонтурЛогистика_ЭлектронныйЗаказНаряд КАК КонтурЛогистика_ЭлектронныйЗаказНаряд
			|ГДЕ
			|	КонтурЛогистика_ЭлектронныйЗаказНаряд.ДатаЗН = &Дата
			|	И КонтурЛогистика_ЭлектронныйЗаказНаряд.НомерЗН = &Номер
			|	И НЕ КонтурЛогистика_ЭлектронныйЗаказНаряд.ПометкаУдаления";
			
			Запрос.УстановитьПараметр("Дата", ДатаЗН);
			Запрос.УстановитьПараметр("Номер", НомерЗН);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				ГлавныйДокумент = Выборка.Ссылка;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2
		ИЛИ ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3
		ИЛИ ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4 Тогда
		
		Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2 Тогда
			ИмяФайла = XDTOФайл.Документ.ИдИнфФт.ИдФайлИнфФт;
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1;
		ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3 Тогда
			ИмяФайла = XDTOФайл.Документ.ИдИнфФщ.ИдФайлИнфФщ;
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2;
		ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4 Тогда
			ИмяФайла = XDTOФайл.Документ.ИдИнфФт.ИдФайлИнфФт;
			ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|ГДЕ
		|	КонтурЛогистика_ФайлыОбмена.ИмяФайла = &ИмяФайла
		|	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления
		|	И КонтурЛогистика_ФайлыОбмена.ТипДокумента = &ТипДокумента";
		
		Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
		Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			ГлавныйДокумент = Выборка.Ссылка.ГлавныйДокумент;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат ГлавныйДокумент;
	
КонецФункции

Функция НайтиГлавныйДокументПоФайлуСВ(Знач XDTOФайл, Знач ФайлСсылка)
	
	ГлавныйДокумент = Документы.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.ПустаяСсылка();
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТитулСВПеревозчика(ФайлСсылка.ТипДокумента) Тогда // первые титулы в сценариях
		
		ДатаСВ 	= КонтурЛогистика_КонструкторыXDTO.Конвертировать_ДатаТип_вДата(КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодСВИнфПрв.ДатаСВ"));
		НомерСВ = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодСВИнфПрв.НомерСВ");
		
		Если ЗначениеЗаполнено(НомерСВ) И ЗначениеЗаполнено(ДатаСВ) Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.Ссылка КАК Ссылка
			               |ИЗ
			               |	Документ.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость КАК КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость
			               |ГДЕ
			               |	НЕ КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.ПометкаУдаления
			               |	И КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.НомерСВ = &НомерСВ
			               |	И КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.ДатаСВ = &ДатаСВ";
			
			Запрос.УстановитьПараметр("ДатаСВ", ДатаСВ);
			Запрос.УстановитьПараметр("НомерСВ", НомерСВ);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				ГлавныйДокумент = Выборка.Ссылка;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ИмяФайла = XDTOФайл.Документ.ИдИнфФщ.ИдФайлИнфПрв; // если не титул перевозчика то любой другой титул имеет ИдФайлИнфПрв
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтурЛогистика_ФайлыОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтурЛогистика_ФайлыОбмена КАК КонтурЛогистика_ФайлыОбмена
		|ГДЕ
		|	КонтурЛогистика_ФайлыОбмена.ИмяФайла = &ИмяФайла
		|	И НЕ КонтурЛогистика_ФайлыОбмена.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			ГлавныйДокумент = Выборка.Ссылка.ГлавныйДокумент;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат ГлавныйДокумент;
	
КонецФункции

Функция НайтиГлавныйДокументПоТитулу(Знач ДокументТитул) Экспорт
	
	Если ДокументТитул <> Неопределено Тогда
		
		ДокументТитулСсылка = ДокументТитул.Ссылка;
		
		Если ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
			Или ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектронныйЗаказНаряд")
			Или ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость")
			Или ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка")
			Или ТипЗнч(ДокументТитул) = Тип("ДокументСсылка.КонтурЛогистика_СкладскаяРасписка") Тогда
			
			Возврат ДокументТитул;
		КонецЕсли;
		
		Если ЭтоТитулТрн(ДокументТитулСсылка) Тогда 
			Возврат ДокументТитул.ДокументЭТРН;
		ИначеЕсли ЭтоТитулПЛ(ДокументТитулСсылка) Или ЭтоТитулЗЗ(ДокументТитулСсылка) Или ЭтоТитулДФ(ДокументТитулСсылка)
				Или ЭтоТитулПЭ(ДокументТитулСсылка) Тогда
			Если ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
				Или ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02")
				Или ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")  
				Или ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ДФ_Титул1")
				Или ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1") Тогда 
				Возврат ДокументТитул;
			Иначе
				Возврат ДокументТитул.Титул1;
			КонецЕсли;
		ИначеЕсли ЭтоТитулЗН(ДокументТитулСсылка) Тогда
			Возврат ДокументТитул.ДокументЗН;
		ИначеЕсли ЭтоТитулСВ(ДокументТитулСсылка) Тогда
			Возврат ДокументТитул.ДокументСВ;
		Иначе
			ВызватьИсключение "Непредполагаемое использование Функция НайтиГлавныйДокументПоТитулу";
		КонецЕсли;
		
	Иначе 
		
		ВызватьИсключение "Непредполагаемое использование Функция НайтиГлавныйДокументПоТитулу";	
		
	КонецЕсли;
	
	
КонецФункции

Функция НайтиПЛМедосмотрВодителя(Титул1, ТипТитула, Водитель) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ПЛ_Титул2.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул2.Водитель = &Водитель
	               |	И НЕ КонтурЛогистика_ПЛ_Титул2.ПометкаУдаления
	               |	И КонтурЛогистика_ПЛ_Титул2.Титул1 = &Титул1";
	
	Запрос.УстановитьПараметр("Титул1", Титул1);
	Запрос.УстановитьПараметр("Водитель", Водитель);
	
	Если ТипТитула= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЛ_Титул2", "ПЛ_Титул6");
	ИначеЕсли ТипТитула= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЛ_Титул2", "ПЛ_Титул2_5_02");
	ИначеЕсли ТипТитула= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЛ_Титул2", "ПЛ_Титул5_5_02");
	КонецЕсли;
	
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура НайтиСоздатьДокументыГлавныйИТитулПоФайлу(ФайлСсылка, ТипДокумента) Экспорт
	
	НайденныйГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлу(ФайлСсылка);
	
	Если Не ЗначениеЗаполнено(НайденныйГлавныйДокумент) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ДФ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1  Тогда
			
			// Cоздадим главный документ
			ТекущийГлавныйДокумент = СоздатьНовыйГлавныйДокументИзФайла(ТипДокумента, ФайлСсылка);
			
		Иначе
			
			// Если мы не смогли найти ДокЭТРН по файлу-титулу 2,3,... то мы не можем обработать файл.
			// требуется сначала дождаться обработки Т1 (создания документа ЭТРН)
			// Оставим файл без соданного документа-титула, попробуем позже (когда дойдет и обработается Т1)
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда // для ПЛТ1 И ЗЗТ1 главный и есть связанный
			
			НайденныйДокументТитул = НайденныйГлавныйДокумент;
			ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
			ФайлОбъект.СвязанныйДокумент = НайденныйДокументТитул; 
			ФайлОбъект.Записать();
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2 Тогда
			НайденныйДокументТитул = Документы.КонтурЛогистика_ПЭ_Титул2.НайтиПоРеквизиту("kl_id", ФайлСсылка.kl_id); 
		Иначе 	
			НайденныйДокументТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ТипДокумента, НайденныйГлавныйДокумент, ФайлСсылка);
		КонецЕсли;
		
		ТекущийГлавныйДокумент = НайденныйГлавныйДокумент;
		
	КонецЕсли;
	
	// Проставим Главный документ в файл (проверив что параллельный поток это уже не сделал)
	Если ЗначениеЗаполнено(ТекущийГлавныйДокумент) И Не ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) Тогда
		
		ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
		ФайлОбъект.ГлавныйДокумент = ТекущийГлавныйДокумент;
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
			
			ФайлОбъект.СвязанныйДокумент = ТекущийГлавныйДокумент; // для ПЛТ1 главный и есть связанный
		КонецЕсли;
		ФайлОбъект.Записать();
		
	КонецЕсли;
	
	ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
	СохранитьДанныеCustomDataВДокументЭТРН(ФайлСсылка.CustomData, ФайлСсылка.ДатаВремяФормирования, ТекущийГлавныйДокумент, ДопДанные);
	
	// Обновим данные ЭТрН по полученному файлу, если ЭТрН уже был создан ранее
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И ЗначениеЗаполнено(НайденныйГлавныйДокумент) Тогда
		
		ГлавныйДокумент = ТекущийГлавныйДокумент.ПолучитьОбъект();
		ГлавныйДокумент.Заполнить(ФайлСсылка);
		ГлавныйДокумент.Записать();
	КонецЕсли;
	
	// Заполним данные подписи в черновиках Т2 и Т4
	Если (ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3)
		И ФайлСсылка.ПодписьВерна
		И ЗначениеЗаполнено(ТекущийГлавныйДокумент)
		И ЗначениеЗаполнено(НайденныйДокументТитул) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			ТипТекущегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
			ТипСледующегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2;
			ИмяРеквизитаПроверки = "ЭПГО";
		Иначе
			ТипТекущегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
			ТипСледующегоТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4;
			ИмяРеквизитаПроверки = "ЭПГП";
		КонецЕсли;
		
		Попытка
			ТитулыСледующегоТитула = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитулыГлавногоПоТипу(ТипСледующегоТитула, ТекущийГлавныйДокумент);
			Если ТитулыСледующегоТитула.Количество() <> 0
				И Не ЗначениеЗаполнено(ТитулыСледующегоТитула[0][ИмяРеквизитаПроверки]) Тогда
				
				ТитулСледующегоТитула = ТитулыСледующегоТитула[0].ПолучитьОбъект();
				ТитулСледующегоТитула.ЗаполнитьУказателиНаПредыдущийТитул(НайденныйДокументТитул, ФайлСсылка);
				ТитулСледующегоТитула.Записать();
			КонецЕсли;
		Исключение
			ТекстОшибки = "Ошибка при обновлении подписи черновиков Т2 и Т4: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонтурЛогистика_Метрика.ОбработатьОшибку("НайтиСоздатьДокументыГлавныйИТитулПоФайлу", ТекстОшибки, ФайлСсылка);
		КонецПопытки;
		
	КонецЕсли;
	
	// Обновим данные ЭР по полученному файлу
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
		И ФайлСсылка.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен Тогда
		
		Если ЗначениеЗаполнено(НайденныйДокументТитул) Тогда
			НайтиСоздатьДокументТитулПоФайлуИГлавному(НайденныйДокументТитул, ТипДокумента, ФайлСсылка);
		ИначеЕсли ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
			ГлавныйДокумент = ТекущийГлавныйДокумент.ПолучитьОбъект();
			ГлавныйДокумент.Заполнить(ФайлСсылка);
			ГлавныйДокумент.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	// Обновим данные СР по полученному файлу
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка
		И ФайлСсылка.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен Тогда
		
		Если ЗначениеЗаполнено(НайденныйДокументТитул) Тогда
			НайтиСоздатьДокументТитулПоФайлуИГлавному(НайденныйДокументТитул, ТипДокумента, ФайлСсылка);
		ИначеЕсли ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
			ГлавныйДокумент = ТекущийГлавныйДокумент.ПолучитьОбъект();
			ГлавныйДокумент.Заполнить(ФайлСсылка);
			ГлавныйДокумент.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
		
		Если ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			И ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
			И ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
			И ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
			И ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
			И ТипДокумента <> Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
			
			НайтиСоздатьДокументТитулПоФайлуИГлавному(НайденныйДокументТитул, ТипДокумента, ФайлСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
	// Обновим счетчик смен в ЭТрН
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8
		И ЗначениеЗаполнено(ТекущийГлавныйДокумент)
		И ЗначениеЗаполнено(НайденныйДокументТитул) Тогда
		
		Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ОбновитьСчетчикСменИТелефон(ТекущийГлавныйДокумент, НайденныйДокументТитул);
	КонецЕсли;
	
	// TODO статус из веба для Т5 И Т6 не приходит, поэтому установим его принудительно.
	Если ЗначениеЗаполнено(ТекущийГлавныйДокумент) И ЗначениеЗаполнено(НайденныйДокументТитул) Тогда 
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 
			Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда  
			
			Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда 
				Состояние = "c-wait-consignor-sign";
			Иначе
				НайденныйДокументТитулОбъект = НайденныйДокументТитул.ПолучитьОбъект();
				НайденныйДокументТитулОбъект.Заполнить(ФайлСсылка);
				НайденныйДокументТитулОбъект.Записать();
				
				Если НайденныйДокументТитул.ЕстьОтказВПодписи Тогда
					Состояние = "c-rejected";
				Иначе
					Состояние = "c-completed";
				КонецЕсли;
			КонецЕсли;
			
			ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ТекущийГлавныйДокумент, Состояние, ФайлСсылка.ДатаВремяФормирования,,, ДопДанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента)
		И ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
		
		Состояние = ПолучитьСтатусДОПутевойЛистПоФайлуОтправленномуИлиПолученному(ФайлСсылка);
		
		Если ФайлСсылка.Состояние = Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен Тогда
			ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка,, ФайлСсылка.КаналТранспорта);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ФайлСсылка.ГлавныйДокумент, Состояние,,,, ДопДанные);
		Иначе
			ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка,, ФайлСсылка.КаналТранспорта);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ФайлСсылка.ГлавныйДокумент, Состояние, ФайлСсылка.ДатаВремяФормирования,,, ДопДанные);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокумента)
		И ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
		
		Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			
			Если ЗначениеЗаполнено(ФайлСсылка.ОтправительШаблона) Тогда
				Состояние = "zz-templateReceived";
			ИначеЕсли Справочники.КонтурЛогистика_ФайлыОбмена.ЭтоВходящийНеподписанный(ФайлСсылка) Тогда
				Состояние = "zz-wait-consignor-sign";
			Иначе
				Состояние = "zz-wait-carrier";
			КонецЕсли;
	
		Иначе
			Если ФайлСсылка.СвязанныйДокумент.ЕстьОтказВПодписи Тогда 
				Состояние = "zz-rejected";
			Иначе
				Состояние = "zz-сheckAnswer";
			КонецЕсли;
		КонецЕсли;
		
		ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
		РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
			ФайлСсылка.ГлавныйДокумент, Состояние, ФайлСсылка.ДатаВремяФормирования,,, ДопДанные);
	КонецЕсли;
	
	Если (Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипДокумента)
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипДокумента))
		И ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
		
		Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
			Или ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
			
			ЭтоШаблон = ЗначениеЗаполнено(ФайлСсылка.ОтправительШаблона);
			ЭтоДокументИзШаблона = ЗначениеЗаполнено(ФайлСсылка.ШаблонОснование);
			
			Если ЭтоШаблон И Справочники.КонтурЛогистика_ФайлыОбмена.ЭтоВходящийНеподписанный(ФайлСсылка) Тогда
				Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "сheck-forwarder");
			Иначе
				// Пока убираем логику ответной подписи
				//// Если не требуется ответной подписи, то документооборот завершаем
				//Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ТребуетсяОтветнаяПодписьЗаказчикаЭР") Тогда
				//	Если ФайлСсылка.ГлавныйДокумент.Грузоотправитель.Наш Тогда
				//		Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "сheck-cargo-owner");
				//	Иначе
				//		Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "wait-cargo-owner");
				//	КонецЕсли;
				//Иначе
				//	Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "completed");
				//КонецЕсли;
				
				Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
					И (ФайлСсылка.ГлавныйДокумент.Грузоотправитель.Наш
						Или ФайлСсылка.ГлавныйДокумент.Клиент.Наш) Тогда
					
					Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "forwarding-cargo-owner");
				ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка
					И ФайлСсылка.ГлавныйДокумент.Клиент.Наш Тогда
					
					Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "forwarding-cargo-owner");
				Иначе
					Состояние = КодСостоянияДОЭРСР(ФайлСсылка.ТипДокумента, "completed");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
		РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
			ФайлСсылка.ГлавныйДокумент, Состояние, ФайлСсылка.ДатаВремяФормирования,,, ДопДанные);
		
	КонецЕсли;
	
	УстановитьДвижениеДокументооборотаДляПЭ(ТипДокумента, ТекущийГлавныйДокумент, ФайлСсылка);
	
	ТЛД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов; 
	УстанавливатьСтатус = (ТЛД.ЭтоПЭ(ТипДокумента) Или ТЛД.ЭтоЭР(ТипДокумента) Или ТЛД.ЭтоСР(ТипДокумента)
		Или ТЛД.ЭтоЗЗ(ТипДокумента) Или ТЛД.ЭтоПЛ(ТипДокумента));
							
	ТипДокументаРаботаетСЦепочкойШаблонов = (ТЛД.ЭтоПЭ(ТипДокумента) Или ТЛД.ЭтоЗЗ(ТипДокумента));
	
	Если УстанавливатьСтатус И ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
		
		// СвязанныйДокумент на ссылке файла может быть пустым из-за кэша после записи объекта.
		// Для титулов, где главный = связанный, берём ТекущийГлавныйДокумент (как НайденныйДокументТитул у ТРН).
		ДокументТитул = ФайлСсылка.СвязанныйДокумент;
		Если Не ЗначениеЗаполнено(ДокументТитул)
			И (ТипДокумента = ТЛД.ЗЗ_Титул1
				Или ТипДокумента = ТЛД.ПЛ_Титул1
				Или ТипДокумента = ТЛД.ПЛ_Титул1_5_02
				Или ТипДокумента = ТЛД.ПЭ_Титул1
				Или ТипДокумента = ТЛД.ЭкспедиторскаяРасписка
				Или ТипДокумента = ТЛД.СкладскаяРасписка) Тогда
			ДокументТитул = ТекущийГлавныйДокумент;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументТитул) Тогда
			
			Если ТипДокументаРаботаетСЦепочкойШаблонов 
				И ТекущийГлавныйДокумент.ЭтоВходящийШаблон Тогда
					
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
					ДокументТитул,
					Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
			Иначе
				
				УстановитьСтатусТитуловПолученныхДокументов(ДокументТитул, ТипДокумента);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДвижениеДокументооборотаДляПЭ(ТипДокумента, ТекущийГлавныйДокумент, ФайлСсылка)
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипДокумента)
		И ЗначениеЗаполнено(ТекущийГлавныйДокумент) Тогда
		
		Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
			
			Если ЗначениеЗаполнено(ФайлСсылка.ОтправительШаблона) Тогда
				Состояние = "pe-templateReceived";
			Иначе
				Состояние = "pe-wait-forwarder";
			КонецЕсли;
			
		ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2 Тогда 
			Состояние = "pe-сheckAnswer";
		Иначе 
			Состояние = "";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Состояние) Тогда 
			ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ФайлСсылка.ГлавныйДокумент, Состояние, ФайлСсылка.ДатаВремяФормирования,,, ДопДанные);
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры	

Процедура УстановитьСтатусТитуловПолученныхДокументов(ДокументТитул, ТипДокумента)

	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипДокумента);

	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации)
		 И Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.НужнаОбработка(КонтекстНастройкиКонвертации) Тогда

		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументТитул,
																		 Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки);
	Иначе
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументТитул,
																		 Перечисления.КонтурЛогистика_СтатусыТитулов.Получен);
	КонецЕсли;

КонецПроцедуры	

Процедура СинхронизироватьСтатусДокументооборотаИзФайла(Знач НайденныйГлавныйДокумент, Знач ТипДокумента, Знач ФайлСсылка)
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда
		
		СинхронизироватьЛогистическийСтатусИзФайла(ФайлСсылка, НайденныйГлавныйДокумент);
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипДокумента) Тогда
		
		УстановитьЛогистическийСтатусЗаказНаряда(ФайлСсылка, НайденныйГлавныйДокумент);
		
	КонецЕсли;

КонецПроцедуры

Функция СоздатьНовыйГлавныйДокументИзФайла(Знач ТипДокумента, Знач ФайлСсылка)
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда 
		ГлавныйДокумент = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ЭлектронныйЗаказНаряд.СоздатьДокумент();
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ЭлектроннаяСопроводительнаяВедомость.СоздатьДокумент();
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ПЛ_Титул1_5_02.СоздатьДокумент();
		ГлавныйДокумент.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);	
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ПЛ_Титул1.СоздатьДокумент();
		ГлавныйДокумент.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ЗЗ_Титул1.СоздатьДокумент();
		ГлавныйДокумент.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоДФ(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ДФ_Титул1.СоздатьДокумент();
		ГлавныйДокумент.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.СоздатьДокумент();
		ГлавныйДокумент.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_СкладскаяРасписка.СоздатьДокумент();
		ГлавныйДокумент.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипДокумента) Тогда
		ГлавныйДокумент = Документы.КонтурЛогистика_ПЭ_Титул1.СоздатьДокументГлавныйДокумент(ФайлСсылка);
		Возврат ГлавныйДокумент;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ГлавныйДокумент.УстановитьНовыйНомер();
	ГлавныйДокумент.Дата = ТекущаяДатаСеанса();
	ГлавныйДокумент.Заполнить(ФайлСсылка);
	ГлавныйДокумент.Записать();
	
	Возврат ГлавныйДокумент.Ссылка;
	
КонецФункции

Процедура НайтиСоздатьДокументТитулПоФайлуИГлавному(НайденныйДокументТитул, Знач ТипДокумента, ФайлСсылка)
	
	Перем ДокументЛогистика, ФайлОбъект;
	
	Если ЗначениеЗаполнено(НайденныйДокументТитул) Тогда
		
		// обновление данных Документа-титула из файла (файл мог быть создан ранее) 
		ДокументЛогистика = НайденныйДокументТитул.ПолучитьОбъект();
		ДокументЛогистика.Заполнить(ФайлСсылка);
		ДокументЛогистика.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
		ДокументЛогистика.Записать();
		
	Иначе
		
		// создать титул
		ДокументЛогистика = Документы[КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипДокумента)].СоздатьДокумент();
		ДокументЛогистика.УстановитьНовыйНомер();
		ДокументЛогистика.Дата = ТекущаяДатаСеанса();
		ДокументЛогистика.Заполнить(ФайлСсылка);
		ДокументЛогистика.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
		ДокументЛогистика.Записать();
		
		НайденныйДокументТитул = ДокументЛогистика.Ссылка;
		
		Если КонтурЛогистика_Уведомления.ТребуетсяОтправкаУведомленияОЗамечаниях(НайденныйДокументТитул) Тогда
			ЭтоПогрузка = (ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2);
			Попытка
				КонтурЛогистика_Уведомления.ОтправитьУведомленияОЗамечанияхВодителя(ДокументЛогистика.ДокументЭТРН, Неопределено, ЭтоПогрузка, НайденныйДокументТитул);
			Исключение
				ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
				ТекстОшибки = "Ошибка при отправке файла: " + Строка(НайденныйДокументТитул) + "
					|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, НайденныйДокументТитул, ТекстОшибки);
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйДокументТитул) И Не ЗначениеЗаполнено(ФайлСсылка.СвязанныйДокумент) Тогда
		
		ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
		ФайлОбъект.СвязанныйДокумент = НайденныйДокументТитул;
		ФайлОбъект.Записать();
		
	КонецЕсли;
	
	Если (ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 
		Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6
		Или ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2) 
		И ФайлСсылка.СвязанныйДокумент.ЕстьОтказВПодписи Тогда 
		
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(НайденныйДокументТитул, Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи);
		
	Иначе
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипДокумента);
		Если Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.НужнаОбработка(КонтекстНастройкиКонвертации) Тогда
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
				НайденныйДокументТитул, Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки);
		Иначе
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
				НайденныйДокументТитул, Перечисления.КонтурЛогистика_СтатусыТитулов.Получен);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьЛогистическийСтатусИзФайла(ФайлСсылка, ДокументЭТРН)
	
	Для Каждого ЗаписьCustomData Из ФайлСсылка.CustomData Цикл
		
		Если ЗаписьCustomData.Key = "kl-status" Тогда
			
			Период = ЗаписьCustomData.ДатаВремяМСКПолучения;
			КодСостоянияСервиса = ПривестиКодСостоянияСервисаДляДокумента(ДокументЭТРН, ЗаписьCustomData.Value);
			Состояние = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.Состояние1СПоКодуСостояниюСервиса(КодСостоянияСервиса);
			ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ДокументЭТРН, Состояние, Период,,, ДопДанные);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьЛогистическийСтатусЗаказНаряда(ФайлСсылка, ДокументЗН)
	
	Если ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда 
		
		Состояние = "zn-wait-freighter";
		
	ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2 Тогда 
		
		Состояние = "zn-wait-arrival";
		
	ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3 Тогда 
		
		Состояние = "zn-on-the-way";
		
	ИначеЕсли ФайлСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4 Тогда 
		
		Состояние = "completed";
		
	КонецЕсли;
	
	ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлСсылка);
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
		ДокументЗН, Состояние, ФайлСсылка.ДатаВремяФормирования,,, ДопДанные);
	
КонецПроцедуры

Процедура НайтиДокументыУчетнойСистемыИПривязатьКТитулам(ПараметрыВводаДокументов) Экспорт
	
	МассивДокументов = ПараметрыВводаДокументов.МассивДокументов;
	УточнениеТипаЛогистика = ПараметрыВводаДокументов.УточнениеТипаЛогистика;
	
	Для Каждого ДокументТитул Из МассивДокументов Цикл 
		
		Если Не ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда 
			УточнениеТипаЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументТитул);
		КонецЕсли;	
		
		НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляТекущегоТитула(ДокументТитул);
		Если ЗначениеЗаполнено(НайденныйДокУчСист) Тогда
			КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				УточнениеТипаЛогистика);
			
			ДокументТитулОбъект = ДокументТитул.ПолучитьОбъект();
			ДокументТитулОбъект.ДокументОснование = НайденныйДокУчСист;
			ДокументТитулОбъект.ЗаполнитьЧерезНастройкиКонвертации(КонтекстНастройкиКонвертации);
			ДокументТитулОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьФайлыОбменаПоДокументам(МассивДокументов, ПараметрыФормированияФайловРеквизиты = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	РезультатПодготовкиКОтправке = КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьДокументыКОтправке(
		МассивДокументов, Истина, ПараметрыФормированияФайловРеквизиты);
	
	Если Не РезультатПодготовкиКОтправке.Успешно Тогда
		
		Для Каждого Ошибка Из РезультатПодготовкиКОтправке.МассивОшибок Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Ошибка;
			Сообщение.Сообщить();
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		// перепроверим тек. статус должен быть ПодготовленКОтправке
		ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументСсылка, Истина);
		Если ТекущийСтатус <> Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке Тогда
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить("Титул " + ДокументСсылка + " не переведен в статус Подготовлен к отправке");
			Продолжить;
		КонецЕсли;
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		РезультатФормирования = ДокОбъект.СформироватьФайлОбмена(ПараметрыФормированияФайловРеквизиты);
		
		Если РезультатФормирования.Успешно Тогда
			
			Для Каждого текЗаявка Из РезультатФормирования.МассивФайловОбмена Цикл
				Результат.МассивФайловОбмена.Добавить(текЗаявка);
			КонецЦикла;
			
		Иначе
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормирования));
			
			// если файл не сформирован, то должна быть ошибка
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументСсылка, Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
		
КонецФункции	

Процедура ОбработатьПараметрыФормированияФайла(ФайлОбъект, Знач ПараметрыФайлаРеквизиты) Экспорт
	
	Перем ПараметрФормирования;
	
	Если ПараметрыФайлаРеквизиты <> Неопределено Тогда 
		
		Для Каждого ПараметрФормирования Из ПараметрыФайлаРеквизиты Цикл 
			
			Попытка
				
				ФайлОбъект[ПараметрФормирования.Ключ] = ПараметрФормирования.Значение;
				
			Исключение
				
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ОписаниеОшибки());
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

Функция ПроверитьТекущийСтатусДокументаДляСозданияФайловОбмена(Ссылка) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	АктуальныйСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Ссылка, Истина);
	
	РазрешенныеСтатусы = Новый Массив;
	РазрешенныеСтатусы.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.ПустаяСсылка());
	РазрешенныеСтатусы.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
	РазрешенныеСтатусы.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке);
	РазрешенныеСтатусы.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка);
	
	Если РазрешенныеСтатусы.Найти(АктуальныйСтатус) = Неопределено Тогда 
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Неподходящий статус (" + АктуальныйСтатус + ") документа " + Ссылка + " для создания файлов обмена";
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура УстановитьЗаголовокКнопкеПоУмолчанию(СсылкаНаДокумент, ДокументОснованиеСсылка, Кнопка, ТекущийСтатус, ТребуемоеДействие = Неопределено) Экспорт
	
	// СсылкаНаДокумент - документ может еще быть не записан
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(СсылкаНаДокумент);
	
	Если ЗначениеЗаполнено(ДокументОснованиеСсылка) Тогда
		ТипДокОснования = ТипЗнч(ДокументОснованиеСсылка);
	Иначе
		ТипДокОснования = Неопределено;
	КонецЕсли;
	
	КонтекстНастройкиКонвертации = КонтекстНастройкиКонвертацииДляДействияПоУмолчаниюТитула(
		ТипЛогистика, СсылкаНаДокумент, ТипДокОснования, ДокументОснованиеСсылка);
	
	Если КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
		
		ТекТребуемоеДействие = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьДействиеПоУмолчаниюДокТитул(
			СсылкаНаДокумент, ТипДокОснования);
		Кнопка.Заголовок = ТекТребуемоеДействие;
		ТребуемоеДействие = ТекТребуемоеДействие;
		
		Если ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена
			Или ТекТребуемоеДействие = Неопределено Тогда
			
			Кнопка.Видимость = Ложь;
			
		ИначеЕсли ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
			Или ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик Тогда
			
			Кнопка.Видимость = Истина;
			Кнопка.Картинка = БиблиотекаКартинок.КонтурЛогистика_ЛогоСПередачей;
			
		ИначеЕсли ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание Тогда
			
			Кнопка.Видимость = Истина;
			Кнопка.Картинка = БиблиотекаКартинок.КонтурЛогистика_ЧеловекГалстук;
			
		ИначеЕсли ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю Тогда
			
			Кнопка.Видимость = Истина;
			Кнопка.Картинка = БиблиотекаКартинок.КонтурЛогистика_Водитель;
			
		ИначеЕсли ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный
			Или ТекТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеПодписанный Тогда
			
			Кнопка.Видимость = Истина;
			Кнопка.Картинка = БиблиотекаКартинок.КонтурЛогистика_ПодписатьИОтправить;
			
		Иначе
			
			Кнопка.Видимость = Истина;
			Кнопка.Картинка = БиблиотекаКартинок.КонтурЛогистика_ДействиеПоУмоланию;
			
		КонецЕсли;
		
	КонецЕсли;

	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда 
		
		Кнопка.Заголовок = "Повторно " + Кнопка.Заголовок;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПЛ_ФормаДокумента_УстановитьВидимостьВЗависимостиОтСтатуса(ФормаДокПЛ) Экспорт
	
	Перем ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЛогистическийТипПоТипуДокумента(ТипЗнч(ФормаДокПЛ.Объект.Ссылка));
	
	Если ФормаДокПЛ.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ФормаДокПЛ.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
		Или ФормаДокПЛ.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки Тогда
		ДоступнаОсновнаяКнопкаПоУмолчанию = Истина;
	Иначе
		ДоступнаОсновнаяКнопкаПоУмолчанию = Ложь;
	КонецЕсли;
	
	ФормаДокПЛ.Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = ДоступнаОсновнаяКнопкаПоУмолчанию;
	
	Если ФормаДокПЛ.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
		Или ФормаДокПЛ.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке")
		Или ФормаДокПЛ.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена")
		Или ФормаДокПЛ.ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		
		ФормаДокПЛ.ТолькоПросмотр = Ложь;
		
	Иначе
		
		ФормаДокПЛ.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	Если ФормаДокПЛ.ТолькоПросмотр Тогда 
		ФормаДокПЛ.Элементы.ПодменюУправление.Видимость = Ложь;
	КонецЕсли;
		
	Если Не (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		И ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02) Тогда
		
		Титул1 = ФормаДокПЛ.Объект.Титул1;
		Если ЗначениеЗаполнено(Титул1) Тогда 
			
			Если Не ЗначениеЗаполнено(Титул1.ОрганизацияМедик) Тогда 
				ФормаДокПЛ.Элементы.ДокументТитул1ЛицоМедик.Видимость = Ложь;
			КонецЕсли;
			
			Если Не Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипЛогистика) Тогда
			
				Если Не ЗначениеЗаполнено(Титул1.ОрганизацияТехСостояние) Тогда 
					ФормаДокПЛ.Элементы.ДокументТитул1ЛицоТехСостояние.Видимость = Ложь;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Титул1.ОрганизацияОдометр) Тогда 
					ФормаДокПЛ.Элементы.ДокументТитул1ЛицоОдометр.Видимость = Ложь;
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЕсли;
		
		ФормаДокПЛ.ДопВодителей = Титул1.ДополнительныеВодители.Количество();
				
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоТитулТрн(ДокТитулСсылка) Экспорт
	
	ТипЗнчОбъекта = ТипЗнч(ДокТитулСсылка);
	
	Если ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
		ИЛИ ТипЗнчОбъекта = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")
		Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

