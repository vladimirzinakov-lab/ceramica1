Функция ПолучитьПодкаталогАрхиваМесяц(ДатаДокумента) Экспорт
	
	Если ДатаДокумента = Дата(1, 1, 1) Тогда
		Возврат "";
	Иначе
		Возврат Формат(ДатаДокумента, "ДФ='\yyyy\ММ MMММ'");
	КонецЕсли;
	
КонецФункции

Функция ИмяАрхива(ПрефиксИмениФайла, НомерДокумента, ДатаДокумента) Экспорт
	
	Возврат ПрефиксИмениФайла + " " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy") + ".zip";
	
КонецФункции

Функция ПодкаталогОрганизации(ГлавныйДокумент, Роль) Экспорт
	
	Попытка
		Наш = ГлавныйДокумент[Роль].Наш;
	Исключение
		Наш = Ложь;
	КонецПопытки;
	
	Если Не Наш Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ИНН = ГлавныйДокумент[Роль].ИНН;
	Исключение
		ИНН = "";
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Возврат "\" + Строка(ИНН);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

