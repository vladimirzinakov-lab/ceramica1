Процедура ДобавитьУИДМинтрансаВЭТрНИТитул(ДокументЭТрН, uid)
	
	Если ДокументЭТрН.Номер <> 0 Тогда // ДокументЭТрН при бездумном удалении может оказаться <Объект не найден>
		ДобавитьУИДМинтрансаВЭТрН(ДокументЭТрН, uid);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУИДМинтрансаВЭТрН(ДокументЭТрН, uid)
	
	Если ДокументЭТрН.УИД <> uid Тогда
		
		ДокументЭТрНОбъект = ДокументЭТрН.ПолучитьОбъект();
		ДокументЭТрНОбъект.УИД = uid;
		ДокументЭТрНОбъект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПредупреждениеМинтрансаВТитул(ФайлОбменаСсылка, СтруктураJSON)

	СтатусОтветаМинтранса = СтатусОтветаМинтрансаИзJSON(СтруктураJSON);
	КомментарийОтветаМинтранса = КомментарийОтветаМинтрансаИзJSON(СтруктураJSON);
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	
	ОписаниеПредупреждения = "Предупреждение: "
		+ Формат(ОписаниеТипаЧисло.ПривестиЗначение(СтатусОтветаМинтранса), "ЧГ=0")
		+ " " + КомментарийОтветаМинтранса;
	
	ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
	
	ФайлОбменаОбъект.ОписаниеПредупреждения = ОписаниеПредупреждения; 
	
	ФайлОбменаОбъект.Записать();
		
КонецПроцедуры

Процедура ДобавитьОшибкуМинтрансаВТитул(ФайлОбменаСсылка, СтруктураJSON, УдалитьФайлыИТитулы = Ложь)

	СтатусОтветаМинтранса = СтатусОтветаМинтрансаИзJSON(СтруктураJSON);
	КомментарийОтветаМинтранса = КомментарийОтветаМинтрансаИзJSON(СтруктураJSON);
	ОшибкиОтветаМинтранса = ОшибкиОтветаМинтрансаИзJSON(СтруктураJSON);
	
	ОписаниеОшибки = "Ошибка: " + СтатусОтветаМинтранса + " " + КомментарийОтветаМинтранса;
	
	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаГИС);
	СтруктураОшибки.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	СтруктураОшибки.Вставить("МассивОшибок", ОшибкиОтветаМинтранса);
	СтруктураОшибки.Вставить("КодОшибки", СтатусОтветаМинтранса);
	
	ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
	
	ФайлОбменаОбъект.Состояние 		= Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.ОшибкаОтправки;
	ФайлОбменаОбъект.ОписаниеОшибок = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(СтруктураОшибки); 
	
	СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", ФайлОбменаОбъект.ОписаниеОшибок);
	
	ФайлОбменаОбъект.Записать();
	
	Если УдалитьФайлыИТитулы Тогда 
		ФайлОбменаОбъект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
		
		НовыйСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка;
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ФайлОбменаСсылка.СвязанныйДокумент, НовыйСтатусТитула, , , СтруктураОшибки);
		
		Если УдалитьФайлыИТитулы Тогда
			ТитулОбъект = ФайлОбменаСсылка.СвязанныйДокумент.ПолучитьОбъект();
			ТитулОбъект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработатьЗамечанияВодителяДиадок(Файл, ТекстXML, ЗачечанияОбработаны)
	
	Попытка
		
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстXML);
		
		КС = КонтурЛогистика_КонструкторыXDTO;
		
		Документ 	= КС.XDTO_Вычислить(XDTO, "CarrierTitle.Файл.Документ");
		ИдФайл 		= КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "CarrierTitle.Файл.ИдФайл");
		
		ЭтоНашПеревозчик 	= Файл.Получатель.Наш И Файл.Получатель.Перевозчик;
		ТипТитула 			= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ОпределитьТипДокументаПоFileName(ИдФайл);
		ЭтоПогрузка 		= ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2;
		
		СодИнфПрв 	= СодИнфПрвXDTO(Документ, ТипТитула);
		ОтметПрв 	= ОтметПрвXDTO(СодИнфПрв, ТипТитула);
		
		Постфикс = ?(ЭтоПогрузка, "Прием", "Выд");
		ЗамПрв = КС.XDTO_Вычислить(СодИнфПрв, "ЗамПрв" + ПостФикс);
		
		ЕстьЗамечанияПеревозчика = ЗамПрв <> Неопределено;
		ЕстьОтметкиПеревозчика = ЕстьОтметкиПеревозчикаXDTO(ОтметПрв);
		
		Если ЕстьЗамечанияПеревозчика Или ЕстьОтметкиПеревозчика Тогда
			СтруктураЗамечаний = ЗамечанияВодителяXDTO(СодИнфПрв, ЭтоПогрузка);
			ЗаполнитьКомментарииВодителяВЭТрН(Файл.ГлавныйДокумент, СтруктураЗамечаний.ЗамечанияВодителя, ТипТитула);
		КонецЕсли;
		
		Если ЭтоНашПеревозчик И (ЕстьЗамечанияПеревозчика Или ЕстьОтметкиПеревозчика) Тогда
			
			НайденныйТитул = НайтиСоздатьТитулПоЭТРН(Файл, ТипТитула);
			НайденныйТитулОбъект = НайденныйТитул.ПолучитьОбъект();
			
			// Уже получили комментарии из Логистики
			Если НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика Или НайденныйТитулОбъект.ЕстьОтметкиПеревозчика Тогда
				Возврат;
			КонецЕсли;
			
			Если ЕстьЗамечанияПеревозчика Тогда
				ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, СтруктураЗамечаний);
				КонтурЛогистика_КонструкторыXDTO.ЗаполнитьИнфПолИзXDTO(ЗамПрв, НайденныйТитулОбъект, "ЗамечанияИнфПол");
			КонецЕсли;
			
			Если ЕстьОтметкиПеревозчика Тогда
				ЗаполнитьОтметкиПеревозчикаXDTO(ОтметПрв, НайденныйТитулОбъект);
			КонецЕсли;
			
			// Перенесем ОтметкиПеревозчика в СтруктураЗамечаний для формирования сообщений
			Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
				Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
				
				Для Каждого ТекущаяОтметка Из НайденныйТитулОбъект.ОтметкиПеревозчика Цикл
					НоваяОтметка = КонтурЛогистика_Уведомления.НоваяОтметкаПеревозчика();
					НоваяОтметка.Вставить("ДатаИВремяОтметки", ТекущаяОтметка.ДатаИВремяОтметки);
					НоваяОтметка.Вставить("ОписаниеОбстоятельств", ТекущаяОтметка.ОписаниеОбстоятельств);
					
					СтруктураЗамечаний.ОтметкиПеревозчика.Добавить(НоваяОтметка);
				КонецЦикла;
			КонецЕсли;
			
			НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика = ЕстьЗамечанияПеревозчика;
			НайденныйТитулОбъект.ЕстьОтметкиПеревозчика = ЕстьОтметкиПеревозчика;
			
			НайденныйТитулОбъект.Записать();
			
			Если ЕстьЗамечанияПеревозчика
				И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4) Тогда
				
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(НайденныйТитулОбъект.Ссылка);
			КонецЕсли;
			
			// Отправка сообщений с замечаниями
			КонтурЛогистика_Уведомления.ОтправитьУведомленияОЗамечанияхВодителя(НайденныйТитулОбъект.ДокументЭТРН, СтруктураЗамечаний, ЭтоПогрузка);
			
		КонецЕсли;
		
		ЗачечанияОбработаны = Истина;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Обработка замечаний водителя из OuterDocflow.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьЗамечанияВодителяЛогистика(Файл, ЗамечанияВодителя, ТипТитула) Экспорт
	
	Попытка
		
		Если Не ЗначениеЗаполнено(Файл.ГлавныйДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоНашПеревозчик = (Файл.Получатель.Наш И Файл.Получатель.Перевозчик);
		ЭтоПогрузка = (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2);
		
		ЕстьЗамечанияПеревозчика = ЗамечанияВодителя.ЕстьЗамечания;
		ЕстьОтметкиПеревозчика = (ЗамечанияВодителя.ОтметкиПеревозчика.Количество() <> 0);
		
		Если ЕстьЗамечанияПеревозчика Тогда
			ЗаполнитьКомментарииВодителяВЭТрН(Файл.ГлавныйДокумент, ЗамечанияВодителя.ПредставлениеЗамечанийВодителя, ТипТитула);
		КонецЕсли;
		
		Если ЭтоНашПеревозчик И (ЕстьЗамечанияПеревозчика Или ЕстьОтметкиПеревозчика) Тогда
			
			НайденныйТитул = НайтиСоздатьТитулПоЭТРН(Файл, ТипТитула, Истина);
			НайденныйТитулОбъект = НайденныйТитул.ПолучитьОбъект();
			
			// Уже получили комментарии из Диадок
			Если (НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика И НайденныйТитулОбъект.ЗамечанияВодителя = ЗамечанияВодителя.ПредставлениеЗамечанийВодителя)
				Или НайденныйТитулОбъект.ЕстьОтметкиПеревозчика Тогда
				
				Возврат;
			КонецЕсли;
			
			Если ЕстьЗамечанияПеревозчика Тогда
				ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, ЗамечанияВодителя);
				
				Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
					
					НайденныйТитулОбъект.ЗамечанияВодителя = ЗамечанияВодителя.ПредставлениеЗамечанийВодителя;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЕстьОтметкиПеревозчика Тогда
				Для Каждого ОтметкаПеревозчика Из ЗамечанияВодителя.ОтметкиПеревозчика Цикл
					ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, ОтметкаПеревозчика, Ложь);
				КонецЦикла;
			КонецЕсли;
			
			НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика = ЕстьЗамечанияПеревозчика;
			НайденныйТитулОбъект.ЕстьОтметкиПеревозчика = ЕстьОтметкиПеревозчика;
			
			НайденныйТитулОбъект.Записать();
			
			Если ЕстьЗамечанияПеревозчика
				И (ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
					Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4) Тогда
				
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(НайденныйТитулОбъект.Ссылка);
			КонецЕсли;
			
			// Отправка сообщений с замечаниями
			КонтурЛогистика_Уведомления.ОтправитьУведомленияОЗамечанияхВодителя(НайденныйТитулОбъект.ДокументЭТРН, ЗамечанияВодителя, ЭтоПогрузка);
			
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Обработка замечаний водителя из ленты Логистики.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьЗамечанияВодителяЛогистика(Файл, ЗамечанияВодителя, ТипТитула) Экспорт
	
	Попытка
		
		ЭтоНашПеревозчик = (Файл.Получатель.Наш И Файл.Получатель.Перевозчик);
		
		Если Не ЗначениеЗаполнено(Файл.ГлавныйДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьКомментарииВодителяВЭТрН(Файл.ГлавныйДокумент, ЗамечанияВодителя.ПредставлениеЗамечанийВодителя, ТипТитула);
		
		Если ЭтоНашПеревозчик Тогда
			
			НайденныййТитул = НайтиТитул(ТипТитула, Файл.ГлавныйДокумент);
			Если Не ЗначениеЗаполнено(НайденныййТитул) Тогда
				// Нет титула, не надо удалять замечания
				Возврат;
			КонецЕсли;
			
			// Найдем и перезаполним уже созданный титул (могут доехать данные подписи)
			НайденныйТитул = НайтиСоздатьТитулПоЭТРН(Файл, ТипТитула, Истина);
			НайденныйТитулОбъект = НайденныйТитул.ПолучитьОбъект();
			
			ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, ЗамечанияВодителя);
			
			Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
				Или ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
				
				НайденныйТитулОбъект.ЗамечанияВодителя = ЗамечанияВодителя.ПредставлениеЗамечанийВодителя;
				НайденныйТитулОбъект.ЕстьЗамечанияПеревозчика = Ложь;
			КонецЕсли;
			
			НайденныйТитулОбъект.Записать();
			
		КонецЕсли;
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Удаление замечаний водителя из ленты Логистики.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Функция ЗамечанияВодителяXDTO(СодИнфПрвXDTO, ЭтоПогрузка = Истина)
	
	Если ЭтоПогрузка Тогда
		ИмяРодителя = "ЗамПрвПрием";
	Иначе
		ИмяРодителя = "ЗамПрвВыд";
	КонецЕсли;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СтруктураЗамечаний = Новый Структура;
	СтруктураЗамечаний.Вставить("ЗамДатВрПриб", 	Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамДатВрУбыт", 	Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамДатВрПосПрием", Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамДатВрПосВыгр", 	Дата(1, 1, 1, 0, 0, 0));
	СтруктураЗамечаний.Вставить("ЗамСостГруз", 		"");
	СтруктураЗамечаний.Вставить("ЗамМасс", 			"");
	СтруктураЗамечаний.Вставить("ЗамКолМест", 		"");
	СтруктураЗамечаний.Вставить("ЗамПогрРаб", 		"");
	СтруктураЗамечаний.Вставить("ЗамРабВыгр", 		"");
	СтруктураЗамечаний.Вставить("ЗамечанияВодителя", "");
	СтруктураЗамечаний.Вставить("ОтметкиПеревозчика", Новый Массив);
	
	ЗамДатВрПриб_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрПриб");
	Если ЗначениеЗаполнено(ЗамДатВрПриб_raw) Тогда
		СтруктураЗамечаний.ЗамДатВрПриб = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПриб_raw);
	Иначе
		ЗамДатВрПриб_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатаВрПриб");
		
		Если ЗначениеЗаполнено(ЗамДатВрПриб_raw) Тогда
			СтруктураЗамечаний.ЗамДатВрПриб = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПриб_raw);
		КонецЕсли;
	КонецЕсли;
	
	ЗамДатВрУбыт_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрУбыт");
	Если ЗначениеЗаполнено(ЗамДатВрУбыт_raw) Тогда
		СтруктураЗамечаний.ЗамДатВрУбыт = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрУбыт_raw);
	КонецЕсли;
	
	СтруктураЗамечаний.ЗамСостГруз = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамСостГруз");
	
	Если ЭтоПогрузка Тогда
		
		ЗамДатВрПосПрием_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрПосПрием");
		Если ЗначениеЗаполнено(ЗамДатВрПосПрием_raw) Тогда
			СтруктураЗамечаний.ЗамДатВрПосПрием = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПосПрием_raw);
		КонецЕсли;
		
		СтруктураЗамечаний.ЗамМасс 		= КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамМасс");
		СтруктураЗамечаний.ЗамКолМест 	= КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамКолМест");
		СтруктураЗамечаний.ЗамПогрРаб 	= КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамПогрРаб");
		
		СтруктураЗамечаний.ЗамечанияВодителя = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(СтруктураЗамечаний);
		
	Иначе
		
		ЗамДатВрПосВыгр_raw = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамДатВрПосВыгр");
		Если ЗначениеЗаполнено(ЗамДатВрПосВыгр_raw) Тогда
			СтруктураЗамечаний.ЗамДатВрПосВыгр = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(ЗамДатВрПосВыгр_raw);
		КонецЕсли;
		
		СтруктураЗамечаний.ЗамРабВыгр = КС.XDTO_Вычислить(СодИнфПрвXDTO, ИмяРодителя + ".ЗамРабВыгр");
		СтруктураЗамечаний.ЗамечанияВодителя = КонтурЛогистика_ПечатьСервер.ОписаниеЗамечанийПеревозчика(СтруктураЗамечаний, Истина);
		
	КонецЕсли;
	
	Возврат СтруктураЗамечаний;
	
КонецФункции

Функция СодИнфПрвXDTO(ДокументXDTO, ТипТитула)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2") Тогда 
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодИнфПрвПрием");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодПрвВыд");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7") Тогда
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодПрвВыд");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8") Тогда
		
		СодИнфПрв 	= КС.XDTO_Вычислить(ДокументXDTO, "СодИнфЗамен");
		
	Иначе	
		
		СодИнфПрв 		= Неопределено;
		
	КонецЕсли;
	
	Возврат СодИнфПрв;
	
КонецФункции

Функция ОтметПрвXDTO(СодИнфПрвXDTO, ТипТитула)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2") Тогда 
		
		ОтметПрв 		= КС.XDTO_Вычислить(СодИнфПрвXDTO, "ОтметПрвПрием"); 
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4") Тогда
		
		ОтметПрв 		= КС.XDTO_Вычислить(СодИнфПрвXDTO, "ОтметПрвВыд");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7") Тогда
		
		ОтметПрв 		= КС.XDTO_Вычислить(СодИнфПрвXDTO, "ОтметкиПА");
		
	ИначеЕсли ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул8") Тогда
		
		ОтметПрв 		= КС.XDTO_Вычислить(СодИнфПрвXDTO, "ОтметЗам");
		
	Иначе	
		
		ОтметПрв 		= Неопределено;
		
	КонецЕсли;
	
	Возврат ОтметПрв;
	
КонецФункции

Функция ЕстьЗамечанияПеревозчикаXDTO(СодИнфПрвXDTO, ЭтоПогрузка = Истина) Экспорт 
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Постфикс = ?(ЭтоПогрузка, "Прием", "Выд");
	
	Возврат КС.XDTO_Вычислить(СодИнфПрвXDTO, "ЗамПрв" + ПостФикс) <> Неопределено;
	                                           
КонецФункции

Функция ЕстьОтметкиПеревозчикаXDTO(ОтметПрвXDTO) Экспорт 
		
	Возврат Не ОтметПрвXDTO = Неопределено;
	                                           
КонецФункции	

Процедура ЗаполнитьЗамечанияПеревозчикаXDTO(СодИнфПрвXDTO, НайденныйТитулОбъект, ЭтоПогрузка = Истина) Экспорт 
	
	КС = КонтурЛогистика_КонструкторыXDTO;

	СтруктураЗамечаний = ЗамечанияВодителяXDTO(СодИнфПрвXDTO, ЭтоПогрузка);
	ЗаполнитьЗначенияСвойств(НайденныйТитулОбъект, СтруктураЗамечаний);	
	
КонецПроцедуры

Процедура ЗаполнитьОтметкиПеревозчикаXDTO(ОтметПрвXDTO, НайденныйТитулОбъект) Экспорт 
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если Не ОтметПрвXDTO = Неопределено Тогда
		
		Если ТипЗнч(ОтметПрвXDTO) = Тип("ОбъектXDTO") Тогда
			
			ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, ОтметПрвXDTO);
			
		Иначе
			
			Для Каждого Отметка Из ОтметПрвXDTO Цикл
				
				ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, Отметка);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОтметкуВТаблицуОтметок(НайденныйТитулОбъект, Отметка, ОтметкаВФорматеXDTO = Истина)
	
	ДатаИВремяОтметки = Неопределено;
	ОписаниеОбстоятельств = Неопределено;
	
	Если ОтметкаВФорматеXDTO Тогда
		КС = КонтурЛогистика_КонструкторыXDTO;
		СвойствоДатВрОтмет = Отметка.Свойства().Получить("ДатВрОтмет");
		
		Если СвойствоДатВрОтмет <> Неопределено Тогда
			ДатаИВремяОтметки = КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяМСК(Отметка.ДатВрОтмет);
		КонецЕсли;
		
		ОписаниеОбстоятельств = Отметка.ОбстОтмет;
	Иначе
		ДатаИВремяОтметки = Отметка.ДатаИВремяОтметки;
		ОписаниеОбстоятельств = Отметка.ОписаниеОбстоятельств;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаИВремяОтметки) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьТЧОтметкиИнфПол = Ложь;
	
	Если ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул2")
		Или ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул4") Тогда
		
		ИмяТЧ = "ОтметкиПеревозчика";
		ЕстьТЧОтметкиИнфПол = Истина;
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1") Тогда
		
		ИмяТЧ = "ОтметкиГрузоотправителя";
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул3") Тогда
		
		ИмяТЧ = "ОтметкиГрузополучателя";
		ЕстьТЧОтметкиИнфПол = Истина;
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул7") Тогда
		
		ИмяТЧ = "ОтметкиПА";
		
	ИначеЕсли ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул8") Тогда
		
		ИмяТЧ = "ОтметЗам";
		
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ДатаИВремяОтметки, ОписаниеОбстоятельств", ДатаИВремяОтметки, ОписаниеОбстоятельств);
	НайденныеОтметки = НайденныйТитулОбъект[ИмяТЧ].НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеОтметки.Количество() <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Добавляем отметку
	НоваяОтметка = НайденныйТитулОбъект[ИмяТЧ].Добавить();
	
	Если Не ТипЗнч(НайденныйТитулОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул7") Тогда
		НоваяОтметка.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	НоваяОтметка.ДатаИВремяОтметки = ДатаИВремяОтметки;
	НоваяОтметка.ОписаниеОбстоятельств = ОписаниеОбстоятельств;
	
	Если ЕстьТЧОтметкиИнфПол И ОтметкаВФорматеXDTO Тогда
		КС.ЗаполнитьИнфПолИзXDTO(Отметка, НайденныйТитулОбъект, "ОтметкиИнфПол", НоваяОтметка.ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКомментарииВодителяВЭТрН(ДокументЭТРН, ЗамечанияВодителя, ТипТитула)
	
	Если ДокументЭТРН = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	РеквизитЭТрН = ?(ТипТитула = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2"), 
						"КомментарииВодителяПриПогрузке", 
						"КомментарииВодителяПриВыгрузке");		
	
	РеквизитСогласованияЭТРН = СтрЗаменить(РеквизитЭТрН, "КомментарииВодителя", "СогласованоВодителем"); 
	
	ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
	Если ДокументЭТРНОбъект <> Неопределено Тогда // мог быть объект не найден в ДокументЭТРН
		ДокументЭТРНОбъект[РеквизитЭТрН] = ЗамечанияВодителя;
		ДокументЭТРНОбъект[РеквизитСогласованияЭТРН] = Истина;
		ДокументЭТРНОбъект.Записать();		
	КонецЕсли;
	
КонецПроцедуры


Функция НайтиСоздатьТитулПоЭТРН(Знач ФайлСсылка, ТипТитула, Перезаполнить = Ложь)
	
	ПредыдущийТипВЦепочке = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредыдущийПоЦепочкеТипЛогистика(ТипТитула);
	ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ПредыдущийТипВЦепочке , ФайлСсылка.ГлавныйДокумент);
	
	Если ТипТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4
		И ЗначениеЗаполнено(ПредыдущийТитул)
		И ПредыдущийТитул.ЭтоПриемВозврата Тогда
		
		НайденныйИлиСозданныйТитул = НайтиПриемкуТрнТ4Возвратную(ФайлСсылка.ГлавныйДокумент);
		
	Иначе
	
		НайденныйИлиСозданныйТитул = НайтиТитул(ТипТитула, ФайлСсылка.ГлавныйДокумент);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйИлиСозданныйТитул) И Не Перезаполнить Тогда
		Возврат НайденныйИлиСозданныйТитул
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйИлиСозданныйТитул) Тогда
		ТитулОбъект = НайденныйИлиСозданныйТитул.ПолучитьОбъект();
	Иначе
		ТитулОбъект = Документы[КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипТитула)].СоздатьДокумент();
		ТитулОбъект.Дата = ТекущаяДатаСеанса();
		ТитулОбъект.УстановитьВремя();
		ТитулОбъект.ДокументЭТРН = ФайлСсылка.ГлавныйДокумент;
	КонецЕсли;
	
	ТитулОбъект.Заполнить(Новый Структура("ПредыдущийТитул,ТипЛогистика", ПредыдущийТитул, ТипТитула));
	
	ТитулОбъект.ДополнительныеСвойства.Вставить("ФайлОснование", ФайлСсылка);
	
	ТитулОбъект.Записать();
	
	НайденныйИлиСозданныйТитул = ТитулОбъект.Ссылка;
	
	Возврат НайденныйИлиСозданныйТитул;

КонецФункции

Процедура ОбработкаПолученияПредставленияДокументаТитулаТрН(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	
	НомерТрН = "";
	ДатаТрН = "";
	ТестовыйДокумент = Ложь;
	
	ДокументЭТРН = Неопределено;
	Если Данные.Свойство("ДокументЭТРН") Тогда
		ДокументЭТРН = Данные.ДокументЭТРН;
	ИначеЕсли Данные.Свойство("Ссылка") И ЗначениеЗаполнено(Данные.Ссылка) Тогда
		ДокументЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Данные.Ссылка, "ДокументЭТРН");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЭТРН) Тогда
		РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ДокументЭТРН, "НомерТрН, ДатаТрН, ТестовыйДокумент");
		
		НомерТрН = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(РеквизитыДокумента.НомерТрН);
		ДатаТрН = Формат(РеквизитыДокумента.ДатаТрН, "ДФ=dd.MM.yy");
		ТестовыйДокумент = РеквизитыДокумента.ТестовыйДокумент;
	КонецЕсли;
	
	Заголовок = "";
	Если Номер = "1" Тогда 
		Заголовок = "Оформление грузоотправителем";
	ИначеЕсли Номер = "2" Тогда 
		Заголовок = "Погрузка перевозчиком";
	ИначеЕсли Номер = "3" Тогда 
		Заголовок = "Приемка, грузополучателем";
	ИначеЕсли Номер = "4" Тогда 
		Заголовок = "Разгрузка перевозчиком";
	ИначеЕсли Номер = "5" Тогда 
		Заголовок = "Выставление стоимости перевозчиком";
	ИначеЕсли Номер = "6" Тогда 
		Заголовок = "Согласование стоимости грузоотправителем";
	ИначеЕсли Номер = "7" Тогда 
		Заголовок = "Переадресация перевозчиком";
	ИначеЕсли Номер = "8" Тогда 
		Заголовок = "Замена ТС/водителя перевозчиком";
	КонецЕсли;
	
	Представление = "ЭТрН №" + НомерТрН + " от " + ДатаТрН + " " + Заголовок + " (Титул " + Номер + ")";
	
	Если ТестовыйДокумент = Истина Тогда
		Представление = Представление + " - Тестовый";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставленияДокументаТитулаЗН(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	НомерЗН = "";
	ДатаЗН = "";
	Если ЗначениеЗаполнено(Данные.Ссылка) И ЗначениеЗаполнено(Данные.Ссылка.ДокументЗН) Тогда 
		НомерЗН = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(Данные.Ссылка.ДокументЗН.НомерЗН);
		ДатаЗН = Формат(Данные.Ссылка.ДокументЗН.ДатаЗН,"ДФ=dd.MM.yy");
	КонецЕсли;
	
	Представление = "Титул " + Номер + " Заказ-Наряда №" + НомерЗН + " от " + ДатаЗН;

КонецПроцедуры

Процедура ОбработкаПолученияПредставленияДокументаТитулаСВ(Данные, Представление, СтандартнаяОбработка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	НомерСВ = "";
	ДатаСВ = "";
	ТипТитула = "";
	
	ДокументСВ = Неопределено;
	Если Данные.Свойство("ДокументСВ") Тогда
		ДокументСВ = Данные.ДокументСВ;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументСВ) Тогда
		РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ДокументСВ, "НомерСВ, ДатаСВ");
		НомерСВ = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(РеквизитыДокумента.НомерСВ);
		ДатаСВ = Формат(РеквизитыДокумента.ДатаСВ, "ДФ=dd.MM.yy");
	КонецЕсли;
	
	Если Данные.Свойство("ТипТитула") Тогда
		ТипТитула = Данные.ТипТитула;
	КонецЕсли;
	
	Представление = "Титул " + ТипТитула + " Сопроводительной ведомости №" + НомерСВ + " от " + ДатаСВ;

КонецПроцедуры

Процедура ОбработкаПолученияПредставленияДокументаТитулаЗЗ(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	
	НомЗак = "";
	ДатаЗак = "";
	ТестовыйДокумент = Ложь;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		
		Если Данные.Свойство("НомЗак") Тогда
			НомЗак = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(Данные.НомЗак);
		КонецЕсли;
		Если Данные.Свойство("ДатаЗак") Тогда
			ДатаЗак = Формат(Данные.ДатаЗак, "ДФ=dd.MM.yy");
		КонецЕсли;
		Если Данные.Свойство("ТестовыйДокумент") Тогда
			ТестовыйДокумент = Данные.ТестовыйДокумент;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Данные) Тогда
		
		РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			Данные, "НомЗак, ДатаЗак, ТестовыйДокумент");
		
		НомЗак = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(РеквизитыДокумента.НомЗак);
		ДатаЗак = Формат(РеквизитыДокумента.ДатаЗак, "ДФ=dd.MM.yy");
		ТестовыйДокумент = РеквизитыДокумента.ТестовыйДокумент;
		
	КонецЕсли;
	
	Представление = "Заказ (заявка) №" + НомЗак + " от " + ДатаЗак + " Титул " + Номер;
	
	Если ТестовыйДокумент = Истина Тогда
		Представление = Представление + " - Тестовый";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставленияДокументаТитулаПЛ(Данные, Представление, СтандартнаяОбработка, Номер) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	НомерПЛ = "";
	ДатаПЛ = "";
	ТестовыйДокумент = Ложь;
	
	Если ЗначениеЗаполнено(Данные.Ссылка) Тогда
		Если ТипЗнч(Данные.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1")
			Или ТипЗнч(Данные.Ссылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1_5_02") Тогда
			НомерПЛ = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(Данные.Ссылка.НомерПЛ);
			ДатаПЛ = Формат(Данные.Ссылка.ДатаПЛ, "ДФ=dd.MM.yy");
			ТестовыйДокумент = Данные.Ссылка.ТестовыйДокумент;
		Иначе
			РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
				Данные.Ссылка.Титул1, "НомерПЛ, ДатаПЛ, ТестовыйДокумент");
			
			НомерПЛ = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(РеквизитыДокумента.НомерПЛ);
			ДатаПЛ = Формат(РеквизитыДокумента.ДатаПЛ, "ДФ=dd.MM.yy");
			ТестовыйДокумент = РеквизитыДокумента.ТестовыйДокумент;
		КонецЕсли;
	КонецЕсли;
	
	Представление = "Путевой лист №" + НомерПЛ + " от " + ДатаПЛ + " Титул " + Номер;
	
	Если ТестовыйДокумент = Истина Тогда
		Представление = Представление + " - Тестовый";
	КонецЕсли;
	
КонецПроцедуры

