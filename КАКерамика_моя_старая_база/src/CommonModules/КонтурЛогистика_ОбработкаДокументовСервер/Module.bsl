	|	ВсеОбъекты.Ссылка КАК Ссылка
	|ИЗ
	|	ВсеОбъекты КАК ВсеОбъекты
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеОбъекты.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ТекущийОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			НаУдаление = Новый Массив;
			Для Каждого ТекущийЭлемент Из ТекущийОбъект.СвязанныеОбъекты Цикл
				Если ЗначениеЗаполнено(ТекущийЭлемент.СвязанныйОбъект) Тогда
					Продолжить;
				КонецЕсли;
				
				НаУдаление.Добавить(ТекущийЭлемент);
			КонецЦикла;
			
			Для Каждого ТекущийЭлемент Из НаУдаление Цикл
				ТекущийОбъект.СвязанныеОбъекты.Удалить(ТекущийЭлемент);
			КонецЦикла;
			
			ТекущийОбъект.Записать();
			
		Исключение
			ТекстОшибки = "Не удалось очистить пустые связанные объекты для: " + Строка(Выборка.Ссылка) + "
				|Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Сообщить(ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНомерИсправленияТитула(ТитулСсылка) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(КонтурЛогистика_ТрН_Титул.НомИспр) КАК НомИспр
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул.ДокументЭТРН = &ДокументЭТРН";

	Запрос.УстановитьПараметр("ДокументЭТРН", ТитулСсылка.ДокументЭТРН);
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТитулСсылка);
	НомерТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.НомерТитула(ТипДокумента);
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_ТрН_Титул1", "КонтурЛогистика_ТрН_Титул" + Строка(НомерТитула));	
	
	ПоследнийНомерИсправления = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ПоследнийНомерИсправления = Выборка.НомИспр;
	КонецЕсли;	
	
	Возврат ПоследнийНомерИсправления + 1; 
	
КонецФункции 

Функция СформироватьТитул2ИФайлыОбменаСквозногоСценарияПутевогоЛиста(Титул1Ссылка) Экспорт
	
	РеквизитыТитула1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		Титул1Ссылка, "Водитель, Водитель2, ДополнительныеВодители");
	
	ДокументыЛогистики = Новый Массив;
	
	ПредыдущиеТитулы = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Титул1Ссылка);
	
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(Титул1Ссылка) 
		= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		УточнениеТипаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02;
	Иначе
		УточнениеТипаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2;
	КонецЕсли;
	
	Водители = Новый Массив;
	
	Если ЗначениеЗаполнено(РеквизитыТитула1.Водитель) Тогда
		Водители.Добавить(РеквизитыТитула1.Водитель);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыТитула1.Водитель2) Тогда
		Водители.Добавить(РеквизитыТитула1.Водитель2);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыТитула1.ДополнительныеВодители) Тогда
		Для Каждого СтрокаДопВодителя Из РеквизитыТитула1.ДополнительныеВодители.Выгрузить() Цикл
			Если ЗначениеЗаполнено(СтрокаДопВодителя.Водитель) Тогда
				Водители.Добавить(СтрокаДопВодителя.Водитель);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Водители = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(Водители);
	
	// Формируем титул 2 для водителей
	Для Каждого Водитель Из Водители Цикл
		
		ДополнительныеДанные = Новый Структура("Водитель", Водитель);
		ДанныеЗаполнения = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеДанные);
		
		РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(
			ПредыдущиеТитулы, УточнениеТипаЛогистика, Ложь, ДанныеЗаполнения);
		Если РезультатВвода.ВведенныеДокументы.Количество() > 0 Тогда
			ДокументыЛогистики.Добавить(РезультатВвода.ВведенныеДокументы[0]);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыФормированияФайловРеквизиты = Новый Структура;
	ПараметрыФормированияФайловРеквизиты.Вставить("ТребуетсяПодпись", Истина);
	
	// Формируем файл обмена титула 2
	РезультатФормированияФайлов = КонтурЛогистика_ОбработкаДокументовСервер.СформироватьФайлыОбменаПоМассивуДокументов(
		ДокументыЛогистики, ПараметрыФормированияФайловРеквизиты);
	Если РезультатФормированияФайлов.Успешно Тогда
		Если РезультатФормированияФайлов.МассивФайловОбмена.Количество() = 0 Тогда
			МассивФайловОбмена = Новый Массив;
			Для Каждого ДокументЛогистики Из ДокументыЛогистики Цикл
				ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументЛогистики);
				Если ЗначениеЗаполнено(ФайлОбмена) Тогда
					МассивФайловОбмена.Добавить(ФайлОбмена);
				КонецЕсли;
			КонецЦикла;
			Возврат МассивФайловОбмена;
		Иначе
			Возврат РезультатФормированияФайлов.МассивФайловОбмена;
		КонецЕсли;
	Иначе
		ВызватьИсключение РезультатФормированияФайлов.ОписаниеОшибки;
	КонецЕсли;
	
КонецФункции

