Процедура ЗаполнитьПредставлениеРеквизитовДокументаОснования(ТипЛогистическогоДокумента, МассивКонвертируемыхРеквизитов, Форма) Экспорт
	
	Объект = Форма.Объект;
	Представления = КонтурЛогистика_ОбработкаДокументовСервер.ПолучитьПредставлениеРеквизитовДокументаОснования(ТипЛогистическогоДокумента, Объект.ДокументОснование, Объект, МассивКонвертируемыхРеквизитов);
	
	Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл
		
		Значение = Неопределено;
		ИмяЭлементаЛогистика = Эл.Значение; // сконвертированного
		ИмяЭлементаНадписиСопоставить = "ДокУчСист_" + Эл.Ключ + "_Сопоставить";
		ИмяЭлементаЗначениеИзДокУчСист = "ДокУчСист_" + Эл.Ключ;
		
		
		Если Представления.Свойство(Эл.Ключ, Значение) Тогда
			
			// Есть значение в реквизите ДокУчСист_ххх извлеченного из Документа учетной системы
			
			текВыражение = "Форма.ДокУчСист_" + Эл.Ключ + " = Значение";
			Выполнить (текВыражение);
			
			// определим доступность команды сопоставления
			
			Если ЗначениеЗаполнено(ИмяЭлементаЛогистика) Тогда
				
				ПутьПроверкиДанных = Форма.Элементы.Найти(ИмяЭлементаЛогистика).ПутьКДанным;
				
				РеквизитИзвлеченИзДокумента = ЗначениеЗаполнено(Форма[ИмяЭлементаЗначениеИзДокУчСист]);
				
				Если РеквизитИзвлеченИзДокумента Тогда // если этот элемент выведен на форму и он рассчитан из документа уч сист
					
					Если Форма.Элементы.Найти(ИмяЭлементаЛогистика) <> Неопределено Тогда
						
						ЗначениеВРеквизите = Вычислить(ПутьПроверкиДанных);
						НужноСопоставить = Не ЗначениеЗаполнено(ЗначениеВРеквизите);
						
					Иначе
						
						НужноСопоставить = Ложь;
						
					КонецЕсли;
					
					Форма.Элементы.Найти(ИмяЭлементаЛогистика).Видимость = Не НужноСопоставить;
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Видимость = НужноСопоставить;
					Форма.Элементы.Найти(ИмяЭлементаЗначениеИзДокУчСист).Видимость = НужноСопоставить ИЛИ Форма.РеквизитыУчетногоДокументаВидимы;
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Заголовок = "Сопоставить";
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Подсказка = "Установить новое соответствие";
					
				Иначе // не извлечен из документа Уч сист
					
					Форма.Элементы.Найти(ИмяЭлементаЗначениеИзДокУчСист).Видимость = Ложь;
					Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Видимость = Ложь;
					
					Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
						
						Форма.Элементы.Найти(ИмяЭлементаНадписиСопоставить).Подсказка = "Не извлечен или не заполнен в док. основании. Открыть исходный документ";
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если Форма.Элементы.Найти(ИмяЭлементаЛогистика) <> Неопределено Тогда
				Форма.Элементы.Найти(ИмяЭлементаЛогистика).Видимость 	= Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПредставлениеРеквизитовДокументаОснования(ТипЛогистическогоДокумента, ДокументОснование, Знач ДокументТитулОбъект, МассивКонвертируемыхРеквизитов) Экспорт

	СтруктураПредставлений = Новый Структура();
	Для Каждого Эл Из МассивКонвертируемыхРеквизитов Цикл
		СтруктураПредставлений.Вставить(Эл.Ключ);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат СтруктураПредставлений;
	КонецЕсли;
	
	ИменаРеквизитов = Новый Массив;
	
	СоответствиеКонвертируемыхРеквизитов = МассивКонвертируемыхРеквизитов;
	Для Каждого ТекущееЗначение Из СоответствиеКонвертируемыхРеквизитов Цикл
		ИменаРеквизитов.Добавить(ТекущееЗначение.Ключ);
	КонецЦикла;
	
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		ТипЛогистическогоДокумента, ДокументОснование);
	
	СтруктураПредставлений = КонтурЛогистика_ОбработкаДокументовСервер.ВычислитьРеквизитыДокументаОснования(
		ИменаРеквизитов, ДокументТитулОбъект, КонтекстНастройкиКонвертации);
	
	Возврат СтруктураПредставлений;
	
КонецФункции

Процедура Валидатор_ПроверитьДружбуКонтрагентов(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		Грузоотправитель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузоотправитель;
		Перевозчик = ДокументОбъектИлиСсылка.ДокументЭТРН.Перевозчик;
		Грузополучатель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузополучатель;
		ЛОП = ДокументОбъектИлиСсылка.ДокументЭТРН.ПогрузкуОсуществляет;
		
		Если Валидатор_ТРН_ПроверитьПривязкуЛицКДиадоку(Грузоотправитель, Грузополучатель, ЛОП, Перевозчик, 
				ДокументОбъектИлиСсылка.ДополнительныеПолучателиФайла, ТаблицаОшибок) Тогда
			Возврат;
		КонецЕсли;
		
		ОрганизацииБезИДУчастникаЭДО = Валидатор_ТРН_ПроверитьРегистрациюЛицВЛогистике(
			Грузоотправитель, Грузополучатель, ЛОП, Перевозчик, ТаблицаОшибок);
			
		ПроверитьПару(Грузоотправитель, Перевозчик, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
		ПроверитьПару(Грузоотправитель, Грузополучатель, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
		ПроверитьПару(Перевозчик, Грузополучатель, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
		
		Если ЗначениеЗаполнено(ЛОП)
			И ОрганизацииБезИДУчастникаЭДО.Получить(ЛОП) = Неопределено Тогда
			
			ПроверитьПару(ЛОП, Грузоотправитель, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			ПроверитьПару(ЛОП, Перевозчик, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			ПроверитьПару(ЛОП, Грузополучатель, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			
		КонецЕсли;
		
		Для Каждого Получатель Из ДокументОбъектИлиСсылка.ДополнительныеПолучателиФайла Цикл
			
			Если ОрганизацииБезИДУчастникаЭДО.Получить(Получатель.ОрганизацияДиадок) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьПару(Получатель.ОрганизацияДиадок, Грузоотправитель, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			ПроверитьПару(Получатель.ОрганизацияДиадок, Перевозчик, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			ПроверитьПару(Получатель.ОрганизацияДиадок, Грузополучатель, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			
			Если ЗначениеЗаполнено(ЛОП) Тогда
				ПроверитьПару(Получатель.ОрганизацияДиадок, ЛОП, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
			КонецЕсли;			
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда
		
		Грузоотправитель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузоотправитель;
		Перевозчик = ДокументОбъектИлиСсылка.ДокументЭТРН.Перевозчик;
		Грузополучатель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузополучатель;
		ЛОП = ДокументОбъектИлиСсылка.ДокументЭТРН.ПогрузкуОсуществляет;
		НовГрузополучатель = ДокументОбъектИлиСсылка.НовГрузПол;
		
		ОрганизацииБезИДУчастникаЭДО = Валидатор_ТРН_ПроверитьРегистрациюЛицВЛогистике(
			Грузоотправитель, НовГрузополучатель, ЛОП, Перевозчик, ТаблицаОшибок);
		
		Если ЗначениеЗаполнено(НовГрузополучатель)
			И НовГрузополучатель <> ДокументОбъектИлиСсылка.ПредГрузополучатель
			И ОрганизацииБезИДУчастникаЭДО.Получить(НовГрузополучатель) = Неопределено Тогда
			
			ПроверитьПару(Грузоотправитель, НовГрузополучатель, ТаблицаОшибок, КатегорияПредупреждение);
			ПроверитьПару(Перевозчик, НовГрузополучатель, ТаблицаОшибок, КатегорияПредупреждение);
			
			Если ЗначениеЗаполнено(ЛОП) Тогда
				ПроверитьПару(ЛОП, НовГрузополучатель, ТаблицаОшибок, КатегорияПредупреждение);
			КонецЕсли;
			
			ДополнительныеПолучателиФайла = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДопПолучателейФайла(ДокументОбъектИлиСсылка.ДокументЭТРН);
			Для Каждого Получатель Из ДополнительныеПолучателиФайла Цикл				
				ПроверитьПару(Получатель.ОрганизацияДиадок, НовГрузополучатель, ТаблицаОшибок, КатегорияПредупреждение);					
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		
		ЛицоОформившееПЛ = ДокументОбъектИлиСсылка.ЛицоОформившееПЛ;
		ОрганизацияМедик = ДокументОбъектИлиСсылка.ОрганизацияМедик;
		ОрганизацияТехСостояние = ДокументОбъектИлиСсылка.ОрганизацияТехСостояние;
		ОрганизацияОдометр = ДокументОбъектИлиСсылка.ОрганизацияОдометр;
		
		Если Валидатор_ПЛ_ПроверитьПривязкуЛицКДиадоку(ЛицоОформившееПЛ, ОрганизацияМедик, ОрганизацияТехСостояние, ОрганизацияОдометр, ТаблицаОшибок) Тогда
			Возврат;
		КонецЕсли;
		
		Валидатор_ПЛ_ПроверитьРегистрациюЛицВЛогистике(ЛицоОформившееПЛ, ОрганизацияМедик, ОрганизацияТехСостояние, ОрганизацияОдометр, ТаблицаОшибок);		
		
		Если ЗначениеЗаполнено(ОрганизацияМедик) Тогда
			ПроверитьПару(ЛицоОформившееПЛ, ОрганизацияМедик, ТаблицаОшибок, КатегорияПредупреждение);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОрганизацияТехСостояние) Тогда
			ПроверитьПару(ЛицоОформившееПЛ, ОрганизацияТехСостояние, ТаблицаОшибок, КатегорияПредупреждение);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОрганизацияТехСостояние) Тогда
			ПроверитьПару(ЛицоОформившееПЛ, ОрганизацияОдометр, ТаблицаОшибок, КатегорияПредупреждение);
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
		ЛицоОформившееПЛ = ДокументОбъектИлиСсылка.ЛицоОформившееПЛ;
		ОрганизацияМедик = ДокументОбъектИлиСсылка.ОрганизацияМедик;
		
		Если Валидатор_ПЛ_ПроверитьПривязкуЛицКДиадоку(ЛицоОформившееПЛ, ОрганизацияМедик, Неопределено, Неопределено, ТаблицаОшибок) Тогда
			Возврат;
		КонецЕсли;
		
		Валидатор_ПЛ_ПроверитьРегистрациюЛицВЛогистике(ЛицоОформившееПЛ, ОрганизацияМедик, Неопределено, Неопределено, ТаблицаОшибок);		
		
		Если ЗначениеЗаполнено(ОрганизацияМедик) Тогда
			ПроверитьПару(ЛицоОформившееПЛ, ОрганизацияМедик, ТаблицаОшибок, КатегорияПредупреждение);
		КонецЕсли;
						
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		Грузоотправитель = ДокументОбъектИлиСсылка.Грузоотправитель;
		Перевозчик = ДокументОбъектИлиСсылка.Перевозчик;
		
		Если Валидатор_ЗЗ_ПроверитьПривязкуЛицКДиадоку(Грузоотправитель, Перевозчик, ТаблицаОшибок) Тогда
			Возврат;
		КонецЕсли;
		
		ОрганизацииБезИДУчастникаЭДО = Валидатор_ЗЗ_ПроверитьРегистрациюЛицВЛогистике(Грузоотправитель, Перевозчик, ТаблицаОшибок);
		
		ПроверитьПару(Грузоотправитель, Перевозчик, ТаблицаОшибок, КатегорияПредупреждение, ОрганизацииБезИДУчастникаЭДО);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПару(Организация1, Организация2, ТаблицаОшибок, КатегорияОшибка, ОрганизацииБезИДУчастникаЭДО = Неопределено)
	
	Если ЗначениеЗаполнено(ОрганизацииБезИДУчастникаЭДО)
		И ОрганизацииБезИДУчастникаЭДО.Получить(Организация1) = Неопределено
		И ОрганизацииБезИДУчастникаЭДО.Получить(Организация2) = Неопределено Тогда
		
		ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Организация1, Организация2);
	КонецЕсли;
	
	Если Организация1 <> Организация2		
		И Не КонтурЛогистика_ОбщегоНазначенияСервер.УстановленыОтношения(Организация1, Организация2)
		И (Организация1.Наш Или Организация2.Наш) Тогда
		
		ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Организация1, Организация2);
	КонецЕсли;
	
КонецПроцедуры

Процедура Валидатор_ПроверитьОтправителя(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) И Не ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = Справочники.КонтурЛогистика_ФайлыОбмена.ПолучитьОсновныеДанныеФайла(ДокументОбъектИлиСсылка);
	
	ОрганизацияОтправителя = Неопределено;
	Если ДанныеФайла.Свойство("ОтправительШаблона")
		И ЗначениеЗаполнено(ДанныеФайла.ОтправительШаблона) Тогда
		ОрганизацияОтправителя = ДанныеФайла.ОтправительШаблона;
	ИначеЕсли ДанныеФайла.Свойство("Отправитель")
		И ТипЗнч(ДанныеФайла.Отправитель) = Тип("СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок")
		И ЗначениеЗаполнено(ДанныеФайла.Отправитель) Тогда
		ОрганизацияОтправителя = ДанныеФайла.Отправитель;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОрганизацияОтправителя)
		И Не ОрганизацияОтправителя.Наш Тогда
		
		Организации = Новый Массив;
		Организации.Добавить(ОрганизацияОтправителя);
		
		ТекстОшибки = "Организация отправитель " + Строка(ОрганизацияОтправителя) + " не Наша";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Отправитель", КатегорияПредупреждение, ТекстОшибки, "Указать", , , , Организации);
		
	КонецЕсли;
	
КонецПроцедуры

Функция Валидатор_ТРН_ПроверитьПривязкуЛицКДиадоку(Грузоотправитель, Грузополучатель, ЛОП, Перевозчик, ДополнительныеПолучателиФайла, ТаблицаОшибок)
		
	ЕстьОшибка = Ложь;
	
	Если ЗначениеЗаполнено(Грузоотправитель) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Грузоотправитель, ЕстьОшибка, "ОрганизацияГрузоотправитель");		
	КонецЕсли;
	Если ЗначениеЗаполнено(Перевозчик) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Перевозчик, ЕстьОшибка, "ОрганизацияПеревозчик");		
	КонецЕсли;
	Если ЗначениеЗаполнено(Грузополучатель) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Грузополучатель, ЕстьОшибка, "ОрганизацияГрузополучатель");		
	КонецЕсли;
	Если ЗначениеЗаполнено(ЛОП) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, ЛОП, ЕстьОшибка, "ОрганизацияПогрузкуОсуществляет");		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеПолучателиФайла) Тогда
		
		Для каждого Получатель Из ДополнительныеПолучателиФайла Цикл
			
			Если Не ЗначениеЗаполнено(Получатель.ОрганизацияДиадок) Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Получатель.ОрганизацияДиадок, ЕстьОшибка, "ДополнительныйПолучатель", 
				"ДополнительныеПолучателиФайла", Получатель.НомерСтроки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЕстьОшибка;
	
КонецФункции

Процедура ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Организация, ЕстьОшибка, ИмяПоля, ИмяТабличнойЧасти = "", НомерСтроки = "")
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	Если Не ЗначениеЗаполнено(Организация.ID) Или Не ЗначениеЗаполнено(Организация.ИдентификаторУчастникаЭДО) Тогда
			
		ДополнительныеПараметры = Новый Массив;
		ДополнительныеПараметры.Добавить(Организация);
		
		ТекстОшибки = "У организации " + Организация + " не выбран ящик в Диадоке.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки,
			"", КатегорияОшибка, ТекстОшибки, "Выбрать ящик",,,, ДополнительныеПараметры);
		
		ЕстьОшибка = Истина;
		
	ИначеЕсли Организация.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.NotReady Тогда

		ТекстОшибки = "Организация " + Организация + " не готова работать с ЭПД";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки,
			ИмяПоля, КатегорияПредупреждение, ТекстОшибки, "Открыть");
				
	ИначеЕсли Организация.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UnknownEpdStatus
		Или Организация.СтатусГотовностиКЭПД = Перечисления.КонтурЛогистика_СтатусыГотовностиКЭПД.UndefinedEpdStatus Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияСервер.ВключеныУведомленияОГотовностиКЭПД() 
			И Не Организация.Наш
			И ИмяПоля <> "ОрганизацияГрузоотправитель"
			И ИмяПоля <> "ОрганизацияПогрузкуОсуществляет"
			И ИмяПоля <> "ОрганизацияОформитель" Тогда  
			Действие = "Отправить уведомление";
		Иначе
			Действие = "Открыть";
		КонецЕсли;
		
		Если Организация.Наш Тогда
			ТекстОшибки = "Для организации " + Организация + " подтвердите готовность к ЭПД";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки,
				ИмяПоля, КатегорияПредупреждение, ТекстОшибки, "Открыть");
		ИначеЕсли Организация.Роуминговая Тогда
			ТекстОшибки = "Организация " + Организация + " работает через другого оператора ЭДО и не подтвердила готовность.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТабличнойЧасти, НомерСтроки,
