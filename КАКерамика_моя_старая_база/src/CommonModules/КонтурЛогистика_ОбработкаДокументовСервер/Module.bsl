Функция ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ4(Знач Документ)
	
	ТекСтатус = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Документ);
	
	// если ждали одометр - то теперь в пути
	Если ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-odometerBefore") Тогда
		
		Состояние = "pl-on-the-way";
		
	Иначе // иначе ждем медосмотр
		
		Состояние = "pl-wait-checkupBefore";
		
	КонецЕсли;
	
