// Функция - Найти титул  возвращает нужный титул по документу ЭТРН
//
// Параметры:
//  ТипЛогистическогоДокументаКоторыйИщем	 - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - какой титул ищем
//  ДокументЭТРН							 - ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная - По какому ЭТРН
// 
// Возвращаемое значение:
//  ДокументСсылка - первый найденный документ титул или пустая ссылка этого типа
//
Функция НайтиТитулыГлавногоПоТипу(ТипЛогистическогоДокументаКоторыйИщем, ГлавныйДокумент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//  если ищем себя же, то просто вернуть себя
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ГлавныйДокумент) = ТипЛогистическогоДокументаКоторыйИщем Тогда 
		МассивТитулов = Новый Массив;
		МассивТитулов.Добавить(ГлавныйДокумент);
		Возврат МассивТитулов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_ТрН_Титул2.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	               |ГДЕ
	               |	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = &ГлавныйДокумент
	               |	И НЕ КонтурЛогистика_ТрН_Титул2.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_ТрН_Титул2.Дата УБЫВ";
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистическогоДокументаКоторыйИщем);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТрН_Титул2", ИмяТитула);
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипЛогистическогоДокументаКоторыйИщем) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".ДокументЗН");
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(ТипЛогистическогоДокументаКоторыйИщем) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".ДокументСВ");
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистическогоДокументаКоторыйИщем) 
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистическогоДокументаКоторыйИщем) Тогда
		Если ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
			Или ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".Ссылка");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументЭТРН", ".Титул1");
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
	
	Результат = Запрос.Выполнить();
	МассивТитулов = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивТитулов;
	
КонецФункции

Функция ВыполненныеМедосмотрыПутевогоЛиста(Титул1Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ПЛ_Титул2.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ Титулы2
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул2.Титул1 = &Титул1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул2.ПометкаУдаления
	               |	И НЕ КонтурЛогистика_ПЛ_Титул2.ЕстьОтказВПодписи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтурЛогистика_ПЛ_Титул6.Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ПЛ_Титул6 КАК КонтурЛогистика_ПЛ_Титул6
	               |ГДЕ
	               |	КонтурЛогистика_ПЛ_Титул6.Титул1 = &Титул1
	               |	И НЕ КонтурЛогистика_ПЛ_Титул6.ПометкаУдаления
	               |	И НЕ КонтурЛогистика_ПЛ_Титул6.ЕстьОтказВПодписи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Титулы2.Ссылка КАК Ссылка
	               |ИЗ
	               |	Титулы2 КАК Титулы2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних(
	               |				,
	               |				Документ В
	               |					(ВЫБРАТЬ
	               |						Титулы2.Ссылка КАК Ссылка
	               |					ИЗ
	               |						Титулы2 КАК Титулы2)) КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	               |		ПО Титулы2.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
	               |ГДЕ
	               |	(КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.Получен)
	               |			ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена))";
	
	Запрос.УстановитьПараметр("Титул1", Титул1Ссылка);
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция НайтиЭТрН(ДокументУчетнойСистемы, НастройкаКонвертации, Разделитель = Неопределено, Объект = Неопределено, Переменные = Неопределено) Экспорт
	
	НайденныйЭТрН = Неопределено;
	
	Если Переменные = Неопределено Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
			Объект, ДокументУчетнойСистемы, НастройкаКонвертации, "");
	КонецЕсли;
	
	// Поиск существующего Этрн по: НомерТрН+ДатаТрН+Грузоотправитель
	// Сконвертируем ключевые реквизиты поиска	
	
	Если Объект <> Неопределено И КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(Объект.Ссылка) Тогда
		
		Если ЗначениеЗаполнено(Объект.ДокументЭТРН) Тогда 
			ДокЭТРН = Объект.ДокументЭТРН;
		ИначеЕсли Разделитель <> Неопределено Тогда // поиск по номеру трн, а номер зависит от разделителя (если разделитель есть)
			ДокЭТРН = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
			ДокЭТРН.Разделитель = Разделитель;
		Иначе
			ДокЭТРН = Неопределено;
		КонецЕсли;
		
	Иначе
		
		ДокЭТРН = Объект;
		
	КонецЕсли;
	
	ПравилоКонвертацииНомерТрН = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти("НомерТрН", "РеквизитТитула");
	Если ПравилоКонвертацииНомерТрН <> Неопределено
		И (ЗначениеЗаполнено(ПравилоКонвертацииНомерТрН.ВыражениеВычисления)
			Или ЗначениеЗаполнено(ПравилоКонвертацииНомерТрН.ВыражениеВычисленияСтрокаНеогр)) Тогда
		
		РезультатНомерТрН = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			ДокументУчетнойСистемы, ПравилоКонвертацииНомерТрН, НастройкаКонвертации, ДокЭТРН,, Переменные);
		НомерТрН = РезультатНомерТрН.Значение;
	Иначе
		ВызватьИсключение "В настройке конвертации настройте правило для НомерТрН";
	КонецЕсли;
	
	ПравилоКонвертацииДатаТрН = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти("ДатаТрН", "РеквизитТитула");
	Если ПравилоКонвертацииДатаТрН <> Неопределено
		И (ЗначениеЗаполнено(ПравилоКонвертацииДатаТрН.ВыражениеВычисления)
			Или ЗначениеЗаполнено(ПравилоКонвертацииДатаТрН.ВыражениеВычисленияСтрокаНеогр)) Тогда
		
		РезультатДатаТрН = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			ДокументУчетнойСистемы, ПравилоКонвертацииДатаТрН, НастройкаКонвертации, ДокЭТРН,, Переменные);  
		ДатаТрН = РезультатДатаТрН.Значение;
		Если Не ЗначениеЗаполнено(ДатаТрН) Тогда 
			ДатаТрН = Дата(1,1,1);
		КонецЕсли;
	Иначе
		ВызватьИсключение "В настройке конвертации настройте правило для ДатаТрН";
	КонецЕсли;
	
	ПравилоКонвертацииГрузоотправитель = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти(
		"Грузоотправитель", "РеквизитТитула");
	Если ПравилоКонвертацииГрузоотправитель <> Неопределено
		И (ЗначениеЗаполнено(ПравилоКонвертацииГрузоотправитель.ВыражениеВычисления)
			Или ЗначениеЗаполнено(ПравилоКонвертацииГрузоотправитель.ВыражениеВычисленияСтрокаНеогр)) Тогда
		
		РезультатГрузоотправитель = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			ДокументУчетнойСистемы, ПравилоКонвертацииГрузоотправитель, НастройкаКонвертации, ДокЭТРН,, Переменные);  
		Грузоотправитель = РезультатГрузоотправитель.Значение;
		Если Не ЗначениеЗаполнено(Грузоотправитель) Тогда
			Грузоотправитель = Справочники.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка();
		КонецЕсли;
	Иначе
		ВызватьИсключение "В настройке конвертации настройте правило для Грузоотправитель";
	КонецЕсли;
	
	// Сам запрос
	Если ЗначениеЗаполнено(НомерТрН) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Грузоотправитель", Грузоотправитель);
		Запрос.УстановитьПараметр("НомерТрН", НомерТрН);
		Запрос.УстановитьПараметр("ДатаТрН", ДатаТрН);
		Запрос.УстановитьПараметр("Разделитель", Разделитель);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
		|ГДЕ
		|	(КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = &Грузоотправитель
		|			ИЛИ &Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка)
		|			ИЛИ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка))
		|	И КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.НомерТрН = &НомерТрН
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ДатаТрН = &ДатаТрН
		|			ИЛИ &ДатаТрН = ДАТАВРЕМЯ(1, 1, 1))
		|	И НЕ КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
		|	И (КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Разделитель = &Разделитель
		|			ИЛИ &Разделитель = НЕОПРЕДЕЛЕНО)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			НайденныйЭТрН = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НайденныйЭТрН;

КонецФункции

