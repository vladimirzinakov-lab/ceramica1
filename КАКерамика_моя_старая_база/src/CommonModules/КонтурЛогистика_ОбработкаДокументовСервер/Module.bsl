	Если ЗначениеЗаполнено(Медик) Тогда
		Если Не Медик.ЕстьВСервисеЛогистика Тогда 
			ТекстОшибки = "Медик, " + Медик + ", впервые будет работать с ЭПД в сервисе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Медик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
		ИначеЕсли Не Медик.ПродуктивЭпл Тогда 
			ТекстОшибки = "Медик, " + Медик + ", работает в тестовом режиме. Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Медик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Техник) Тогда
		Если Не Техник.ЕстьВСервисеЛогистика Тогда 
			ТекстОшибки = "Техник, " + Техник + ", впервые будет работать с ЭПД в сервисе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Техник", КатегорияПредупреждение, ТекстОшибки, "Внимание");
		ИначеЕсли Не Техник.ПродуктивЭпл Тогда 
			ТекстОшибки = "Техник, " + Техник + ", работает в тестовом режиме. Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Техник", КатегорияПредупреждение, ТекстОшибки, "Внимание");
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Одометр) Тогда
		Если Не Одометр.ЕстьВСервисеЛогистика Тогда 
			ТекстОшибки = "Лицо, проставляющее одометр, " + Одометр + ", впервые будет работать с ЭПД в сервисе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Одометр", КатегорияПредупреждение, ТекстОшибки, "Внимание");
		ИначеЕсли Не Одометр.ПродуктивЭпл Тогда 
			ТекстОшибки = "Лицо, проставляющее одометр, " + Одометр + ", работает в тестовом режиме. Электронный документ не будет иметь юр. силу. Для поездки требуется печатная форма на бумажном носителе.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"Одометр", КатегорияПредупреждение, ТекстОшибки, "Внимание");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция Валидатор_ПЛ_ПроверитьПривязкуЛицКДиадоку(Знач Оформитель, Знач Медик, Знач Техник, Знач Одометр, Знач ТаблицаОшибок)
		
	ЕстьОшибка = Ложь;
	
	Если ЗначениеЗаполнено(Оформитель) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Оформитель, ЕстьОшибка, "ОрганизацияОформитель");		
	КонецЕсли;
	Если ЗначениеЗаполнено(Медик) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Медик, ЕстьОшибка, "ОрганизацияМедик");		
	КонецЕсли;
	Если ЗначениеЗаполнено(Техник) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Техник, ЕстьОшибка, "ОрганизацияТехник");		
	КонецЕсли;
	Если ЗначениеЗаполнено(Одометр) Тогда		
		ПроверитьПривязкуОрганизацииКДиадоку(ТаблицаОшибок, Одометр, ЕстьОшибка, "ОрганизацияОдометр");		
	КонецЕсли;
	
	Возврат ЕстьОшибка;
	
КонецФункции

// Проверяет, что ТС из входящего Т1 не расходится с элементом справочника.
// При включенной настройке ошибка блокирует подпись и отправку Т2;
// при выключенной показывается предупреждение. При отказе в подписи проверку не вызывают.
//
// Параметры:
//  ДокументОбъектИлиСсылка - ДокументСсылка.КонтурЛогистика_ТрН_Титул2, ДокументОбъект.КонтурЛогистика_ТрН_Титул2
//  ТаблицаОшибок - ТаблицаЗначений
//
Процедура Валидатор_ПроверитьТранспортноеСредствоВходящегоТитула1(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	ДокументЭТРН = ДокументОбъектИлиСсылка.ДокументЭТРН;
	Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	Титул1 = НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументЭТРН);
	Если Не ЗначениеЗаполнено(Титул1) Тогда
		Возврат;
	КонецЕсли;
	
	ФайлТитула1 = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(Титул1);
	Если Не ЗначениеЗаполнено(ФайлТитула1) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстXMLХранилище = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ФайлТитула1, "ТекстXML");
	Если ТекстXMLХранилище = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстФайла = ТекстXMLХранилище.Получить();
	Если Не ЗначениеЗаполнено(ТекстФайла) Тогда
		Возврат;
	КонецЕсли;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	XDTO = КС.ПолучитьXDTOпоXML(ТекстФайла);
	Если XDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СвТС = КС.XDTO_Вычислить(XDTO, "Документ.СодИнфГО.СвТС");
	Если СвТС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		ДокументЭТРН, "ТранспортноеСредство, Прицеп, Прицеп2");
	
	КатегорияРасхождения = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	Если КС.ТранспортноеСредствоРасходитсяСВходящимиДанными(
		РеквизитыЭТРН.ТранспортноеСредство, КС.XDTO_ПолучитьЗначениеСвойства(СвТС, "ТС")) Тогда
		
		ТекстОшибки = "Реквизиты транспортного средства, указанные в файле Т1, отличаются от реквизитов в справочнике ТС.
			| Проверьте/измените реквизиты ТС";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"ГлавныйДокумент.ТранспортноеСредство.Ссылка", КатегорияРасхождения, ТекстОшибки, "Изменить");
		
	КонецЕсли;
	
	ПрицепыXDTO = КС.XDTO_ВычислитьМассивXDTO(КС.XDTO_ПолучитьЗначениеСвойства(СвТС, "Прицеп"));
	Если ПрицепыXDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПрицепыXDTO.Количество() > 0
		И КС.ТранспортноеСредствоРасходитсяСВходящимиДанными(РеквизитыЭТРН.Прицеп, ПрицепыXDTO[0]) Тогда
		
		ТекстОшибки = "Реквизиты прицепа, указанные в файле Т1, отличаются от реквизитов в справочнике ТС.
			| Проверьте/измените реквизиты прицепа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"ГлавныйДокумент.Прицеп.Ссылка", КатегорияРасхождения, ТекстОшибки, "Изменить");
		
	КонецЕсли;
	
	Если ПрицепыXDTO.Количество() > 1
		И КС.ТранспортноеСредствоРасходитсяСВходящимиДанными(РеквизитыЭТРН.Прицеп2, ПрицепыXDTO[1]) Тогда
		
		ТекстОшибки = "Реквизиты второго прицепа, указанные в файле Т1, отличаются от реквизитов в справочнике ТС.
			| Проверьте/измените реквизиты второго прицепа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"ГлавныйДокумент.Прицеп2.Ссылка", КатегорияРасхождения, ТекстОшибки, "Изменить");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Валидатор_ПроверитьРоуминг(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ТипДокумента = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументОбъектИлиСсылка.Ссылка);
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоТРН(ТипДокумента) Тогда
		
		Грузоотправитель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузоотправитель;
		Перевозчик = ДокументОбъектИлиСсылка.ДокументЭТРН.Перевозчик;
		Грузополучатель = ДокументОбъектИлиСсылка.ДокументЭТРН.Грузополучатель;
		ЛОП = ДокументОбъектИлиСсылка.ДокументЭТРН.ПогрузкуОсуществляет;
		
		Если ЗначениеЗаполнено(Грузоотправитель) И Грузоотправитель.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + Грузоотправитель;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Грузоотправитель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Перевозчик) И Перевозчик.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + Перевозчик;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Перевозчик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Грузополучатель) И Грузополучатель.Роуминговая  Тогда 
			ТекстОшибки = "Роуминг с " + Грузополучатель;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Грузополучатель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЛОП)
			И ДокументОбъектИлиСсылка.ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку Тогда
			
			Если ЛОП.Роуминговая  Тогда 
				ТекстОшибки = "Роуминг с " + ЛОП;
				Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"ЛОП", КатегорияПредупреждение, ТекстОшибки, "Внимание");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ДополнительныеПолучателиФайла = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДопПолучателейФайла(ДокументОбъектИлиСсылка.ДокументЭТРН);
		Для каждого Получатель Из ДополнительныеПолучателиФайла Цикл
			Если ЗначениеЗаполнено(Получатель.ОрганизацияДиадок) И Получатель.ОрганизацияДиадок.Роуминговая Тогда
				ТекстОшибки = "Роуминг с " + Получатель.ОрганизацияДиадок;
				Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "ДополнительныеПолучателиФайла", Получатель.НомерСтроки, 
						"Получатель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда			
			Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.НовГрузПол) И ДокументОбъектИлиСсылка.НовГрузПол.Роуминговая Тогда
				ТекстОшибки = "Роуминг с " + ДокументОбъектИлиСсылка.НовГрузПол;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"НовГрузПол", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда			
			ЛицоОформившееПЛ = ДокументОбъектИлиСсылка.ЛицоОформившееПЛ;
			ОрганизацияМедик = ДокументОбъектИлиСсылка.ОрганизацияМедик;
			ОрганизацияТехСостояние = ДокументОбъектИлиСсылка.ОрганизацияТехСостояние;
			ОрганизацияОдометр = ДокументОбъектИлиСсылка.ОрганизацияОдометр;
			ДополнительныеПолучателиФайла =  ДокументОбъектИлиСсылка.ДополнительныеПолучателиФайла;
		ИначеЕсли ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
			ЛицоОформившееПЛ = ДокументОбъектИлиСсылка.ЛицоОформившееПЛ;
			ОрганизацияМедик = ДокументОбъектИлиСсылка.ОрганизацияМедик;
			ОрганизацияТехСостояние = Неопределено;
			ОрганизацияОдометр = Неопределено;
			ДополнительныеПолучателиФайла =  ДокументОбъектИлиСсылка.ДополнительныеПолучателиФайла;
		Иначе
			ЛицоОформившееПЛ = ДокументОбъектИлиСсылка.Титул1.ЛицоОформившееПЛ;
			ОрганизацияМедик = ДокументОбъектИлиСсылка.Титул1.ОрганизацияМедик;
						
			Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипДокумента) Тогда
				ОрганизацияТехСостояние = Неопределено;
				ОрганизацияОдометр = Неопределено;
			Иначе
				ОрганизацияТехСостояние = ДокументОбъектИлиСсылка.Титул1.ОрганизацияТехСостояние;
				ОрганизацияОдометр = ДокументОбъектИлиСсылка.Титул1.ОрганизацияОдометр;				
			КонецЕсли;
			
			ДополнительныеПолучателиФайла =  ДокументОбъектИлиСсылка.Титул1.ДополнительныеПолучателиФайла;			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЛицоОформившееПЛ) И ЛицоОформившееПЛ.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + ЛицоОформившееПЛ;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ЛицоОформившееПЛ", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОрганизацияМедик) И ОрганизацияМедик.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + ОрганизацияМедик;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ОрганизацияМедик", КатегорияПредупреждение, ТекстОшибки, "Внимание");		
		КонецЕсли;
		Если ЗначениеЗаполнено(ОрганизацияТехСостояние) И ОрганизацияТехСостояние.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + ОрганизацияТехСостояние;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ОрганизацияТехСостояние", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			Конецесли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОрганизацияОдометр) И ОрганизацияОдометр.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + ОрганизацияОдометр;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"ОрганизацияОдометр", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		
		Для каждого Получатель Из ДополнительныеПолучателиФайла Цикл
			Если ЗначениеЗаполнено(Получатель.ОрганизацияДиадок) И Получатель.ОрганизацияДиадок.Роуминговая Тогда
				ТекстОшибки = "Роуминг с " + Получатель.ОрганизацияДиадок + " в дополнительных получателях файла";
				Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"Получатель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипДокумента) Тогда
		
		Если ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			Грузоотправитель = ДокументОбъектИлиСсылка.Грузоотправитель;
			Перевозчик = ДокументОбъектИлиСсылка.Перевозчик;			
		Иначе
			Грузоотправитель = ДокументОбъектИлиСсылка.Титул1.Грузоотправитель;
			Перевозчик = ДокументОбъектИлиСсылка.Титул1.Перевозчик;			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Грузоотправитель) И Грузоотправитель.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + Грузоотправитель;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Грузоотправитель", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Перевозчик) И Перевозчик.Роуминговая Тогда 
			ТекстОшибки = "Роуминг с " + Перевозчик;
			Если ТаблицаОшибок.НайтиСтроки(Новый Структура("ТекстОшибки", ТекстОшибки)).Количество() = 0 Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"Перевозчик", КатегорияПредупреждение, ТекстОшибки, "Внимание");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Валидация_ГСМ(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок, ТипПоказанийТоплива, АвтоФормированиеИзТ1 = Ложь) Экспорт
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	ДокументТитул1 = ДокументОбъектИлиСсылка.Титул1;
	
	Если Не ЗначениеЗаполнено(ДокументТитул1) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеТитула1 = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(
		ДокументТитул1, "ЛицоОформившееПЛ, kl_id");
	
	Если Не ЗначениеЗаполнено(ДанныеТитула1.kl_id) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнятьПоказанияГСМВЭПЛ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиОрганизацииДиадок(
		ДанныеТитула1.ЛицоОформившееПЛ, Перечисления.КонтурЛогистика_НастройкиОрганизацийДиадок.ЗаполнятьПоказанияГСМВЭПЛ);
	
	Если ЗаполнятьПоказанияГСМВЭПЛ = Неопределено Или Не ЗаполнятьПоказанияГСМВЭПЛ Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьПоказанийГСМ = ЕстьПоказанийГСМ(ДанныеТитула1.kl_id, ТипПоказанийТоплива);
	
	Если Не ЕстьПоказанийГСМ И Не АвтоФормированиеИзТ1 Тогда
		
		ТекстОшибки = "Нет показаний топлива";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"ОстатокТоплива", КатегорияОшибка, ТекстОшибки, "Указать");
		
		Возврат;
	КонецЕсли;
	
	ЕстьОтправленныеСОшибкойПоГСМ = ЕстьОтправленныеСОшибкойПоГСМ(ДанныеТитула1.kl_id, ТипПоказанийТоплива);
	
	Если ЕстьОтправленныеСОшибкойПоГСМ Тогда
		ТекстОшибки = "Отправлены данные по ГСМ с ошибкой";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"ОстатокТоплива", КатегорияОшибка, ТекстОшибки, "Исправить");
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьПоказанийГСМ(kl_id, ТипПоказанийТоплива)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Разрез1", kl_id);
	Запрос.УстановитьПараметр("Разрез2", ТипПоказанийТоплива);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПроизвольныеДанные.ОрганизацияДиадок КАК ОрганизацияДиадок
	|ИЗ
	|	РегистрСведений.КонтурЛогистика_ПроизвольныеДанные КАК КонтурЛогистика_ПроизвольныеДанные
	|ГДЕ
	|	КонтурЛогистика_ПроизвольныеДанные.Разрез1 = &Разрез1
	|	И КонтурЛогистика_ПроизвольныеДанные.Разрез2 = &Разрез2";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

