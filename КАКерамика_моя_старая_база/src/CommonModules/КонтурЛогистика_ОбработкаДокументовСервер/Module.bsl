			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфЭксп.УИД_ПорЭксп");	
		ИначеЕсли КНД = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.КНД() Тогда
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфЭксп.УИД_ЭкспР");
		ИначеЕсли КНД = Документы.КонтурЛогистика_СкладскаяРасписка.КНД() Тогда
			УИД = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTOФайл, "Документ.СодИнфЭксп.УИД_СкладР");
		КонецЕсли;
			
	КонецЕсли;
	
	Если УИД = "Отсутствует" ИЛИ УИД = "Без номера" Тогда 
		УИД = Неопределено;
	КонецЕсли;
	
	Возврат УИД;

КонецФункции 

Процедура ДополнитьДополнительныхПолучателейИзГлавногоДокумента(ТекущийТитулОбъект, Знач ГлавныйДокумент = Неопределено) Экспорт
	
	// доп получатели
	Если ЗначениеЗаполнено(ГлавныйДокумент) Тогда
		
		Для Каждого СтрДопПолучатель из ГлавныйДокумент.ДополнительныеПолучателиФайла Цикл
			Если ЗначениеЗаполнено(СтрДопПолучатель.ОрганизацияДиадок) Тогда 
				НайденныйВТитуле = ТекущийТитулОбъект.ДополнительныеПолучателиФайла.Найти(СтрДопПолучатель.ОрганизацияДиадок, "ОрганизацияДиадок");
				
				Если НайденныйВТитуле = Неопределено Тогда 
					НовСтр = ТекущийТитулОбъект.ДополнительныеПолучателиФайла.Добавить();
					НовСтр.ОрганизацияДиадок = СтрДопПолучатель.ОрганизацияДиадок; 
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

