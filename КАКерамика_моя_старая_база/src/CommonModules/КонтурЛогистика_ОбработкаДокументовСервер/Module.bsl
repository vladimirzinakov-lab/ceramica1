Процедура УдалитьФайлыИСвязныеОбъекты(ФайлыКУдалению) Экспорт 
	
	Для Каждого Файл Из ФайлыКУдалению Цикл 
		
		ФайлОбменаОбъект = Файл.ПолучитьОбъект();
		ФайлОбменаОбъект.УстановитьПометкуУдаления(Истина);
		
		Если ЗначениеЗаполнено(Файл.СвязанныйДокумент) Тогда
			
			ТитулОбъект = Файл.СвязанныйДокумент.ПолучитьОбъект();
			ТитулОбъект.УстановитьПометкуУдаления(Истина);
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Файл.СвязанныйДокумент, 
				Перечисления.КонтурЛогистика_СтатусыТитулов.Удален);
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	

// Удаляет старые данные из базы
//
// Параметры:
//  ДатаУстаревания	 - Дата	 - дата, ниже которой данные считаются старыми 
//
Процедура УдалитьСтарыеДанные(ДатаУстаревания = Неопределено) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ДатаУстаревания = Неопределено Тогда 
	
		ДнейДоУстаревания = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("УдалятьДанныеЧерезДней");
		
		МинимальныйСрокХраненияВРегистрах = 90;
		Если ДнейДоУстаревания < МинимальныйСрокХраненияВРегистрах Тогда 
			ДнейДоУстаревания = МинимальныйСрокХраненияВРегистрах;
		КонецЕсли;
		
		ДатаУстаревания	= КонтурЛогистика_ОбщегоНазначенияСервер.ТекущийМоментВремениМСК() - ДнейДоУстаревания * 24 * 3600;
				
	КонецЕсли;

	ДеревоДанныхТРН = ПолучитьДеревоУдаленияТРН(ДатаУстаревания);
	УдалитьДанныеДерева(ДеревоДанныхТРН);
	
	ДеревоДанныхПЛ = ПолучитьДеревоУдаленияПЛ(ДатаУстаревания);
	УдалитьДанныеДерева(ДеревоДанныхПЛ);
	
	ДеревоДанныхЗЗ = ПолучитьДеревоУдаленияЗЗ(ДатаУстаревания);
	УдалитьДанныеДерева(ДеревоДанныхЗЗ);
	
	// Удалим пустые связанные объекты
	УдалитьПустыеСвязанныеОбъекты();
	
	// Удалим выполненные задачи из регистра КонтурЛогистика_ОчередьЗаданийСценариевАвтоматическойРаботы
	РегистрыСведений.КонтурЛогистика_ОчередьЗаданийСценариевАвтоматическойРаботы.УдалитьСтарыеВыполненныеЗадачи();
	
КонецПроцедуры

Процедура УдалитьДанныеДерева(Знач ДеревоДанныхТРН)
	
	Перем ГлавныйДокументОбъект, НаборЗаписей, СтрокаГлавныйДокумент, СтрокаТитул, СтрокаФайл, ТитулОбъект, ФайлОбъект;
	
	Для Каждого СтрокаГлавныйДокумент Из ДеревоДанныхТРН.Строки Цикл 
		
		Для Каждого СтрокаТитул Из СтрокаГлавныйДокумент.Строки Цикл 
			
			Для Каждого СтрокаФайл Из СтрокаТитул.Строки Цикл 
				
				// удаление Файлов
				Если ЗначениеЗаполнено(СтрокаФайл.Файл) Тогда 
					
					ФайлОбъект = СтрокаФайл.Файл.ПолучитьОбъект();
					Если ФайлОбъект <> Неопределено Тогда // уже удален? 
						ФайлОбъект.Удалить();
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЦикла;
			
			// удаление Титулов
			Если ЗначениеЗаполнено(СтрокаТитул.Титул) Тогда 
				
				НаборЗаписей = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Документ.Установить(СтрокаТитул.Титул);
				НаборЗаписей.Прочитать();
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();
				
				ТитулОбъект = СтрокаТитул.Титул.ПолучитьОбъект();
				ТитулОбъект.Удалить();
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		// удаление ЭТрН
		Если ЗначениеЗаполнено(СтрокаГлавныйДокумент.ГлавныйДокумент) Тогда
			
			НаборЗаписей = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Документ.Установить(СтрокаГлавныйДокумент.ГлавныйДокумент);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			
			ГлавныйДокументОбъект = СтрокаГлавныйДокумент.ГлавныйДокумент.ПолучитьОбъект();
			ГлавныйДокументОбъект.Удалить();
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьДеревоУдаленияТРН(Знач ДатаУстаревания)
	
	Перем ДеревоДанных, Запрос;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка КАК ДокументЭТрН
	|ПОМЕСТИТЬ ВТ_ВсеЭТрН
	|ИЗ
	|	Документ.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная КАК КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
	|		ПО КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Период ЕСТЬ NULL
	|				ТОГДА КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Дата < &ДатаУстаревания
	|			ИНАЧЕ КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Период < &ДатаУстаревания
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеЭТрН.ДокументЭТрН КАК ДокументЭТрН,
	|	ЕСТЬNULL(КонтурЛогистика_СтатусыТитуловСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаУстаревания КАК ИсключитьЭТрН,
	|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Титул,
	|	КонтурЛогистика_ТрН_Титул1.Ссылка ЕСТЬ NULL КАК НетТитула
	|ПОМЕСТИТЬ ЭТрНСТитулами
	|ИЗ
	|	ВТ_ВсеЭТрН КАК ВТ_ВсеЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|		ПО ВТ_ВсеЭТрН.ДокументЭТрН = КонтурЛогистика_ТрН_Титул1.ДокументЭТРН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО (КонтурЛогистика_ТрН_Титул1.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ВсеЭТрН.ДокументЭТрН,
	|	ЕСТЬNULL(КонтурЛогистика_СтатусыТитуловСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаУстаревания,
	|	КонтурЛогистика_ТрН_Титул2.Ссылка,
	|	КонтурЛогистика_ТрН_Титул2.Ссылка ЕСТЬ NULL
	|ИЗ
	|	ВТ_ВсеЭТрН КАК ВТ_ВсеЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|		ПО ВТ_ВсеЭТрН.ДокументЭТрН = КонтурЛогистика_ТрН_Титул2.ДокументЭТРН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО (КонтурЛогистика_ТрН_Титул2.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ВсеЭТрН.ДокументЭТрН,
	|	ЕСТЬNULL(КонтурЛогистика_СтатусыТитуловСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаУстаревания,
	|	КонтурЛогистика_ТрН_Титул3.Ссылка,
	|	КонтурЛогистика_ТрН_Титул3.Ссылка ЕСТЬ NULL
	|ИЗ
	|	ВТ_ВсеЭТрН КАК ВТ_ВсеЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул3 КАК КонтурЛогистика_ТрН_Титул3
	|		ПО ВТ_ВсеЭТрН.ДокументЭТрН = КонтурЛогистика_ТрН_Титул3.ДокументЭТРН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО (КонтурЛогистика_ТрН_Титул3.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ВсеЭТрН.ДокументЭТрН,
	|	ЕСТЬNULL(КонтурЛогистика_СтатусыТитуловСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаУстаревания,
	|	КонтурЛогистика_ТрН_Титул4.Ссылка,
	|	КонтурЛогистика_ТрН_Титул4.Ссылка ЕСТЬ NULL
	|ИЗ
	|	ВТ_ВсеЭТрН КАК ВТ_ВсеЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул4 КАК КонтурЛогистика_ТрН_Титул4
	|		ПО ВТ_ВсеЭТрН.ДокументЭТрН = КонтурЛогистика_ТрН_Титул4.ДокументЭТРН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО (КонтурЛогистика_ТрН_Титул4.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ)
	|
