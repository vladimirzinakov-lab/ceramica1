Функция НайтиПервоначальнуюВерсиюТ2(Знач ЛюбойТитулТрН) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Поищем первоначальную версию Т2 (она может быть помечена на удаление)
	Если Не ЗначениеЗаполнено(ЛюбойТитулТрН.ДокументЭТРН) Тогда 
		ВызватьИсключение "Не найден главный документ ЭТРН для титула 2" + ЛюбойТитулТрН;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул2.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ТрН_Титул2.ДатИнфПрвПрием КАК ДатИнфПрвПрием,
	|	КонтурЛогистика_ТрН_Титул2.ВрИнфПрвПрием КАК ВрИнфПрвПрием
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул2 КАК КонтурЛогистика_ТрН_Титул2
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул2.ДокументЭТРН = &ДокументЭТРН
	|	И КонтурЛогистика_ТрН_Титул2.ДатИнфПрвПрием <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_ТрН_Титул2.ДатИнфПрвПрием,
	|	КонтурЛогистика_ТрН_Титул2.ВрИнфПрвПрием";
	
	Запрос.УстановитьПараметр("ДокументЭТРН", ЛюбойТитулТрН.ДокументЭТРН);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать(); // Отладка Результат.Выгрузить()
	
	Если Выборка.Следующий() Тогда 
		ПервоначальнаВерсияТ2 = Выборка.Ссылка;	
	Иначе
		ПервоначальнаВерсияТ2 = Неопределено;
	КонецЕсли;
	
	Возврат ПервоначальнаВерсияТ2;
	
КонецФункции

