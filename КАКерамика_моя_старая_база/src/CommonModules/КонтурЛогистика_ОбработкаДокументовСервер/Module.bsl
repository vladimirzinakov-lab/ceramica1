Функция ОпределитьСтатусПодписанта(ОбщийСпособПодтвержденияПолномочий, ОтправительЛОП) Экспорт
	
	Если ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.МЧД Тогда
		СтатусПодписанта = ?(ОтправительЛОП, "_5", "_2");
	ИначеЕсли ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.БумажнаяДоверенность Тогда
		СтатусПодписанта = ?(ОтправительЛОП, "_6", "_3");
	ИначеЕсли ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.БезДоверенности Тогда
		СтатусПодписанта = ?(ОтправительЛОП, "_4", "_1");
	Иначе
		Возврат Перечисления.КонтурЛогистика_СтатусыПодписанта.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Перечисления.КонтурЛогистика_СтатусыПодписанта[СтатусПодписанта];	
	
КонецФункции

Функция ОпределитьСпосПодтПолном(ОбщийСпособПодтвержденияПолномочий, ИсключениеДляОтдельныхДокументов) Экспорт
	
	Если ИсключениеДляОтдельныхДокументов Тогда
		СпособПодтвержденияПолномочий = "_6";
	ИначеЕсли ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.МЧД Тогда
		СпособПодтвержденияПолномочий = "_3";
	ИначеЕсли ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.БумажнаяДоверенность Тогда
		СпособПодтвержденияПолномочий = "_5";
	ИначеЕсли ОбщийСпособПодтвержденияПолномочий = Перечисления.КонтурЛогистика_ОбщиеСпособыПодтвержденияПолномочий.БезДоверенности Тогда
		СпособПодтвержденияПолномочий = "_1";
	Иначе
		Возврат Перечисления.КонтурЛогистика_СпособыПодтвержденияПолномочий.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Перечисления.КонтурЛогистика_СпособыПодтвержденияПолномочий[СпособПодтвержденияПолномочий];	
	
КонецФункции

