// Валидирует содержатие таблицы ИнфПол по документу и переданному списку имен ТЧ с этим инфополем
Процедура ПроверитьИнфПол(Знач Объект, МассивПроверок, ТаблицаОшибок) Экспорт

	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Для Каждого ИмяКонтейнераИнфПол Из МассивПроверок Цикл
		
		Контейнер = Объект[ИмяКонтейнераИнфПол];
		
		Для Каждого СтрокаИнфПол Из Контейнер Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаИнфПол.Идентиф) Тогда
				
				ТекстОшибки = "В блоке информационных полей не указан Ключ";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаИнфПол.Значение) Тогда
				
				ТекстОшибки = "В блоке информационных полей не указано Значение";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Валидирует содержатие таблицы ИнфПол по документу и переданному списку имен ТЧ с этим инфополем с учетом поля ИдФайлИнфПол
Процедура ПроверитьИнфПолСИдФайл(Знач Объект, СтуктураПроверки, ТаблицаОшибок) Экспорт

	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Для Каждого Строка Из СтуктураПроверки Цикл
		
		ИмяКонтейнераИнфПол = Строка.Ключ;
		ОписаниеКонтейнераИнфПол = ?(ЗначениеЗаполнено(Строка.Значение), Строка.Значение + " ", "");
		
		Контейнер = Объект[ИмяКонтейнераИнфПол];
		
		Для Каждого СтрокаИнфПол Из Контейнер Цикл
			
			Если ЗначениеЗаполнено(СтрокаИнфПол.ИдФайлИнфПол) И СтрДлина(СтрокаИнфПол.ИдФайлИнфПол) <> 36 Тогда
					
				ТекстОшибки = "В блоке информационных полей " + ОписаниеКонтейнераИнфПол + "длина поля Ид файла не равна 36";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяКонтейнераИнфПол, СтрокаИнфПол.НомерСтроки, 
					"ИдФайлИнфПол", КатегорияОшибка, ТекстОшибки, "Указать");
					
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаИнфПол.Идентиф) Или ЗначениеЗаполнено(СтрокаИнфПол.Значение) Тогда
			
				Если НЕ ЗначениеЗаполнено(СтрокаИнфПол.Идентиф) Тогда
					
					ТекстОшибки = "В блоке информационных полей " + ОписаниеКонтейнераИнфПол + "не указан Ключ";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяКонтейнераИнфПол, СтрокаИнфПол.НомерСтроки, 
						"Идентиф", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаИнфПол.Значение) Тогда
					
					ТекстОшибки = "В блоке информационных полей " + ОписаниеКонтейнераИнфПол + "не указано Значение";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяКонтейнераИнфПол, СтрокаИнфПол.НомерСтроки, 
						"Значение", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Проверяет заполнение связанных строк табличной части ОпасныеГрузы для строки товара.
//
// Параметры:
//  Объект - ДокументОбъект - титул с табличной частью ОпасныеГрузы
//  СтрокаТовара - СтрокаТабличнойЧасти - строка табличной части Товары
//  ТаблицаОшибок - ТаблицаЗначений - таблица панели ошибок
//  ПредупреждатьОНесколькихСтроках - Булево - если Истина, при нескольких строках ОГ на товар
//                                             добавляется предупреждение (формат ЭЗЗ допускает одну строку)
//
Процедура ПроверитьСвязанныеОпасныеГрузы(Знач Объект, Знач СтрокаТовара, ТаблицаОшибок,
		ПредупреждатьОНесколькихСтроках = Ложь) Экспорт
	
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ТекущийНомерСтроки = СтрокаТовара.НомерСтроки;
	ИмяТЧ = "Товары";
	
	СвязанныеСтрокиОГ = Объект.ОпасныеГрузы.НайтиСтроки(
		Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки));
	
	Если ПредупреждатьОНесколькихСтроках И СвязанныеСтрокиОГ.Количество() > 1 Тогда
		
		ТекстОшибки = "По формату для одной строки груза допускается только одна запись об опасном грузе."
			+ " В файл будет выгружена только первая строка";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
			"ОтгрузочноеНаименование", КатегорияПредупреждение, ТекстОшибки, "Исправить");
		
	КонецЕсли;
	
	Для Каждого СтрокаОГ Из СвязанныеСтрокиОГ Цикл
		
		Источник = СтрокаОГ;
		
		Если Не ЗначениеЗаполнено(Источник.НомерООН) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Номер ООН опасного груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Источник.НадлежащееОтгрузочноеНаименование) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Надлежащее отгрузочное наименование опасного груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Источник.Класс) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Класс опасного груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Источник.КлассификационныйКод) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Классификационный код опасного груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Источник.ГруппаУпаковки) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Группу упаковки опасного груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Источник.ЗнакОпасности) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Знак опасности опасного груза");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Источник.КодОграниченияТуннели) Тогда
			ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
				"Укажите Код ограничения проезда через туннели опасного груза");
		КонецЕсли;
		
		Если Источник.Класс = Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.Класс1 Тогда
			
			Если Не ЗначениеЗаполнено(Источник.ОбМасНетВзрСод) Тогда
				ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
					"Укажите Общая масса нетто взрывчатого содержимого в килограммах для каждого вещества или изделия,"
					+ " имеющего отдельный номер ООН (т.к. класс = 1)");
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Источник.ОбМасНетВзрСодВсех) Тогда
				ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, ТекущийНомерСтроки,
					"Укажите Общая масса нетто взрывчатого содержимого в килограммах для всех веществ и изделий,"
					+ " которых касается сопроводительная ведомость (т.к. класс = 1)");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОшибкуЗаполненияОпасногоГруза(ТаблицаОшибок, НомерСтроки, ТекстОшибки)
	
	КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
		ТаблицаОшибок,
		"Товары",
		НомерСтроки,
		"ОтгрузочноеНаименование",
		Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка,
		ТекстОшибки,
		"Заполнить",
		Неопределено,
		Неопределено,
		"Указать");
	
КонецПроцедуры

Процедура ПроверитьВодителя(Водитель, ТаблицаОшибок, КатегорияОшибка, СтрокаДопВодитель = Неопределено, ТипЭПД = Неопределено, ГлавныйДокумент) Экспорт
	
	Если СтрокаДопВодитель = "" Или СтрокаДопВодитель = Неопределено Тогда 
		НомерСтроки = "";
		ИмяТЧ 		= "";
		РеквизитВодитель = "Водитель";
		ПрефВодителя	= " ";
	ИначеЕсли СтрокаДопВодитель = "2" Тогда 
		НомерСтроки = "";
		ИмяТЧ 		= "";
		РеквизитВодитель = "Водитель2";
		ПрефВодителя	= " второго ";
	Иначе
		НомерСтроки = СтрокаДопВодитель.НомерСтроки;
		ИмяТЧ 		= "ДополнительныеВодители";
		РеквизитВодитель = "Водитель";
		ПрефВодителя	= " дополнительного ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Водитель) Тогда
		
		Если Не ЗначениеЗаполнено(Водитель.Фамилия) 
			Или Не ЗначениеЗаполнено(Водитель.Имя) Тогда
			
			ТекстОшибки = "Не заполнены ФИО" + ПрефВодителя + "водителя";
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
			РеквизитВодитель+".Фамилия", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЭПД) Тогда
			
			Если ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
				И Не ЗначениеЗаполнено(Водитель.СНИЛС) Тогда
				
				ТекстОшибки = "Укажите СНИЛС" + ПрефВодителя + "водителя в соотв с приказом МинТранса №159 от 5 мая 2023г";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
				РеквизитВодитель+".СНИЛС", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			Если  Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(ТипЭПД) Тогда
				
				Если Не ЗначениеЗаполнено(Водитель.СНИЛС) Тогда
					
					ТекстОшибки = "Укажите СНИЛС" + ПрефВодителя + "водителя";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".СНИЛС", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать");
					
				Иначе
					
					Если Не КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВФорматеСНИЛС(Водитель.СНИЛС) Тогда
						ТекстОшибки = "СНИЛС водителя " + ПрефВодителя + "водителя не соответствует формату XXX-XXX-XXX YY";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						РеквизитВодитель+".СНИЛС", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать");
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
				
					Если Не ЗначениеЗаполнено(Водитель.ВУНомер) Тогда
					
						ТекстОшибки = "Не заполнен номер ВУ" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						РеквизитВодитель+".ВУНомер", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать");
						
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда
					
						ТекстОшибки = "Не заполнена серия ВУ" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						РеквизитВодитель+".ВУСерия", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать");
						
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) Тогда
					
						ТекстОшибки = "Не заполнена дата выдачи ВУ" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						РеквизитВодитель+".ВУДатаВыдачи", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать");
						
					КонецЕсли;
									
					Если Не ЗначениеЗаполнено(Водитель.ТелефонОсновной) И Не ЗначениеЗаполнено(Водитель.АдресЭлектроннойПочты) Тогда
						ТекстОшибки = "Не заполнены телефон или e-mail" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
							ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
					КонецЕсли;
						
					Если ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02
						И ГлавныйДокумент <> Неопределено
						И ГлавныйДокумент.СпецУслДвиж.Количество() > 0
						И (ЗначениеЗаполнено(Водитель.ДОПОГСерия) Или ЗначениеЗаполнено(Водитель.ДОПОГНомер) Или ЗначениеЗаполнено(Водитель.ДОПОГДатаОкончания)) Тогда
						
						Если Не ЗначениеЗаполнено(Водитель.ДОПОГСерия) Тогда
							ТекстОшибки = "Не заполнены серия ДОПОГ " + ПрефВодителя + " водителя";
							КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
								ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ДОПОГСерия", КатегорияОшибка, ТекстОшибки, "Указать");
						КонецЕсли;
							
						Если Не ЗначениеЗаполнено(Водитель.ДОПОГНомер) Тогда
							ТекстОшибки = "Не заполнен номер ДОПОГ " + ПрефВодителя + "водителя";
							КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
								ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ДОПОГНомер", КатегорияОшибка, ТекстОшибки, "Указать");
						КонецЕсли;
							
						Если Не ЗначениеЗаполнено(Водитель.ДОПОГДатаОкончания) Тогда
							ТекстОшибки = "Не заполнена дата окончания ДОПОГ " + ПрефВодителя + "водителя";
							КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
								ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ДОПОГДатаОкончания", КатегорияОшибка, ТекстОшибки, "Указать");
						КонецЕсли;
							
					КонецЕсли;
															
				КонецЕсли;
				
			Иначе
				
				Если ЗначениеЗаполнено(Водитель.ВУНомер)
					Или ЗначениеЗаполнено(Водитель.ВУСерия)
					Или ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) Тогда
					
					Если Не ЗначениеЗаполнено(Водитель.ВУНомер) Тогда
						ТекстОшибки = "Не заполнен номер водительского удостоверения" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
							ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ВУНомер", КатегорияОшибка, ТекстОшибки, "Указать");
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда
						ТекстОшибки = "Не заполнена серия водительского удостоверения" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
							ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ВУСерия", КатегорияОшибка, ТекстОшибки, "Указать");
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) Тогда
						ТекстОшибки = "Не заполнена дата выдачи водительского удостоверения" + ПрефВодителя + "водителя";
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
							ТаблицаОшибок, ИмяТЧ, НомерСтроки, РеквизитВодитель + ".ВУДатаВыдачи", КатегорияОшибка, ТекстОшибки, "Указать");
					КонецЕсли;
						
				ИначеЕсли Не ЗначениеЗаполнено(Водитель.ВУНомер) И Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда
					
					ТекстОшибки = "Для водителя " + Водитель.Наименование + " не указаны серия и номер вод.удостоверения. В личном кабинете и мобильном приложении водитель не сможет просмотреть документ и QR-код";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".ВУСерия", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
			КонецЕсли;
												
			Если ЗначениеЗаполнено(ГлавныйДокумент.ЛицоОформившееПЛ)
				И (ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 
					Или ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02)
				И КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступенСервисФизЛиц(ГлавныйДокумент.ЛицоОформившееПЛ) Тогда
				
				ПроверитьВодителяВСервисе(ГлавныйДокумент.ЛицоОформившееПЛ, Водитель, РеквизитВодитель, ТаблицаОшибок, ИмяТЧ, НомерСтроки);
				
			КонецЕсли;
			
		Иначе 			
			
			Если Не ЗначениеЗаполнено(Водитель.ТелефонОсновной) Тогда
				
				Если Не ЗначениеЗаполнено(ГлавныйДокумент)
					Или (ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 
						И Не ЗначениеЗаполнено(ГлавныйДокумент.ТелефонВодителя)) Тогда
					
					ТекстОшибки = "Укажите телефон" + ПрефВодителя + "водителя";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".ТелефонОсновной", КатегорияОшибка, ТекстОшибки, "Указать");
					
				КонецЕсли;
				
			Иначе
				
				Партнер = Неопределено;
				Если ТипЭПД = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда 
					Партнер = ГлавныйДокумент.ПартнерПеревозчик;
				КонецЕсли;
				
				ИспользоватьОтправкуВТелеграм = Справочники.КонтурЛогистика_Настройки.ЗначениеНастройки("ИспользоватьОтправкуВТелеграм", Партнер);
	
				Если ИспользоватьОтправкуВТелеграм Тогда
					
					Если Водитель.ТелефонЗарегестрированВТелеграм = Ложь Тогда
						
						ТекстОшибки = "Водитель " + Водитель + " не зарегистрирован в телеграм по номеру " + Водитель.ТелефонОсновной;
						КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
						РеквизитВодитель+".ТелефонОсновной", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Подключить");
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Водитель.ИНН) 
				И Не ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) 
				И Не ЗначениеЗаполнено(Водитель.ВУНомер)
				И Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда
				
				ТекстОшибки = "Не заполнен ИНН" + ПрефВодителя + "водителя или дата выдачи, серия и номер водительского удостоверения";
				
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
				РеквизитВодитель+".ИНН", КатегорияОшибка, ТекстОшибки, "Указать ИНН");	
				
			ИначеЕсли Не ЗначениеЗаполнено(Водитель.ИНН) Тогда 
				
				Если Не ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) Тогда			
					ТекстОшибки = "Укажите у" + ПрефВодителя + "водителя дату выдачи ВУ";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".ВУДатаВыдачи", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Водитель.ВУНомер) Тогда
					ТекстОшибки = "Укажите у" + ПрефВодителя + "водителя номер ВУ";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".ВУНомер", КатегорияОшибка, ТекстОшибки, "Указать");
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда				
					ТекстОшибки = "Укажите у" + ПрефВодителя + "водителя серию ВУ";				
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".ВУСерия", КатегорияОшибка, ТекстОшибки, "Указать");				
				КонецЕсли;	
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Водитель.ИНН) Тогда 
				
				ТекстОшибки = Справочники.КонтурЛогистика_Сотрудники.ТекстОшибкиПроверкиИНН(Водитель.ИНН);
				
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда 
					
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					РеквизитВодитель+".ИНН", КатегорияОшибка, "Укажите верный ИНН" + ПрефВодителя + "водителя. " + ТекстОшибки, "Указать");
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ГлавныйДокумент.Перевозчик)
				И КонтурЛогистика_ИнтеграцияAPI_СервисФизическихЛицПовтИсп.ДоступенСервисФизЛиц(ГлавныйДокумент.Перевозчик) Тогда
				
				ПроверитьВодителяВСервисе(ГлавныйДокумент.Перевозчик, Водитель, РеквизитВодитель, ТаблицаОшибок, ИмяТЧ, НомерСтроки);
				
			КонецЕсли;
			
		КонецЕсли;
		
		//Иначе	// заполненность самого водителя уже проверена
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПроверитьВодителяВСервисе(Организация, Водитель, РеквизитВодитель, ТаблицаОшибок, ИмяТЧ, НомерСтроки) Экспорт
				
	ЗапретОтправкиПервыхТитуловБезВодителяВСервисе = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЗапретОтправкиПервыхТитуловБезВодителяВСервисе");
	
	СценарийПриглашения = Перечисления.КонтурЛогистика_СценарииПриглашенийФизическихЛиц.Водитель;
	
	Запись = КонтурЛогистика_СервисФизическихЛицСервер.ДанныеЗаписиРегистраСведений(Организация, Водитель, СценарийПриглашения);
			 					
	Если Запись <> Неопределено И Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ПринятоПриглашение Тогда
		
		ЕстьРасхожденияВУ = КонтурЛогистика_СервисФизическихЛицСервер.ЕстьРасхожденияПоРеквизитам(
			Водитель, "ВУНомер,ВУСерия,ВУДатаВыдачи", Организация);
		Если ЕстьРасхожденияВУ Тогда
			ТекстОшибки = "У водителя " + Водитель.Наименование + " есть расхождения в данных ВУ";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
				РеквизитВодитель + ".ГруппаРоли", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Изменить");	
		КонецЕсли;
			
		ЕстьРасхожденияТелефон = КонтурЛогистика_СервисФизическихЛицСервер.ЕстьРасхожденияПоРеквизитам(
			Водитель, "ТелефонОсновной", Организация);
		Если ЕстьРасхожденияТелефон Тогда
			ТекстОшибки = "У водителя " + Водитель.Наименование + " есть расхождения в телефоне";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
				РеквизитВодитель + ".ГруппаРоли", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Изменить");	
		КонецЕсли;
		
	Иначе
		
		Если ЗапретОтправкиПервыхТитуловБезВодителяВСервисе Тогда
			
			ТекстОшибки = "";
			ИмяПоля = РеквизитВодитель + ".ФизическиеЛица";
			Действие = "Открыть";
			
			Если Не ЗначениеЗаполнено(Водитель.ТелефонОсновной) Тогда
				
				ТекстОшибки = "У водителя " + Водитель.Наименование + " не заполнен телефон для отправки приглашения";
				ИмяПоля = РеквизитВодитель + ".ТелефонОсновной";
				
			ИначеЕсли Не ЗначениеЗаполнено(Водитель.ВУСерия) Тогда
				
				ТекстОшибки = "У водителя " + Водитель.Наименование + " не заполнена серия ВУ";
				ИмяПоля = РеквизитВодитель + ".ВУСерия"; 
				
			ИначеЕсли Не ЗначениеЗаполнено(Водитель.ВУНомер) Тогда
				
				ТекстОшибки = "У водителя " + Водитель.Наименование + " не заполнен номер ВУ";
				ИмяПоля = РеквизитВодитель + ".ВУНомер";
				
			ИначеЕсли Не ЗначениеЗаполнено(Водитель.ВУДатаВыдачи) Тогда
				
				ТекстОшибки = "У водителя " + Водитель.Наименование + " не заполнена дата выдачи ВУ";
				ИмяПоля = РеквизитВодитель + ".ВУДатаВыдачи";
				
			ИначеЕсли Запись = Неопределено Тогда
				
				ПараметрыФоновогоЗадания = Новый Структура;
				ПараметрыФоновогоЗадания.Вставить("Организация", Организация);
				ПараметрыФоновогоЗадания.Вставить("Водитель", Водитель);
				ПараметрыФоновогоЗадания.Вставить("СценарийПриглашения", СценарийПриглашения);
				ПараметрыФоновогоЗадания.Вставить("Телефон", Водитель.ТелефонОсновной);
				КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьВФоне("КонтурЛогистика_ДлительныеОперацииСервер.ОтправитьПриглашение", ПараметрыФоновогоЗадания,, "Отправка приглашения");
				
				ТекстОшибки = "Водителю " + Водитель.Наименование + " отправлено приглашение";
				Действие = "Проверить";
				ИмяПоля = "ПроверитьОтправкуПриглашенияСотруднику";
				
			ИначеЕсли Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.ОтправленоПриглашение Тогда
				
				ПараметрыФоновогоЗадания = Новый Структура;
				ПараметрыФоновогоЗадания.Вставить("Организация", Организация);
				ПараметрыФоновогоЗадания.Вставить("Водитель", Водитель);
				ПараметрыФоновогоЗадания.Вставить("СценарийПриглашения", СценарийПриглашения);
				ПараметрыФоновогоЗадания.Вставить("PersonId", Запись.PersonId);
				КонтурЛогистика_ДлительныеОперацииСервер.ВыполнитьВФоне("КонтурЛогистика_ДлительныеОперацииСервер.ПроверитьПриглашение", ПараметрыФоновогоЗадания,, "Проверка приглашения");
				
				ТекстОшибки = "Водитель " + Водитель.Наименование + " не принял приглашение";
				ИмяПоля = "ПроверитьПриглашениеСотруднику";
				Действие = "Проверить";				
				
			ИначеЕсли Запись.Статус = Перечисления.КонтурЛогистика_СтатусыФизическихЛиц.Удалено Тогда
				
				ТекстОшибки = "Водитель " + Водитель.Наименование + " удален из сервиса";
				
			ИначеЕсли Запись.ЕстьОшибка Или Запись.Статус.Пустая() Тогда
				
				ТекстОшибки = "Есть ошибки при отправке приглашения водителю " + Водитель.Наименование;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
					ИмяПоля, Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, Действие);
			КонецЕсли;
			
		Иначе
			
			Если РеквизитВодитель = "СвВодит" Тогда
				РеквизитВодитель = "Водитель";	
			КонецЕсли;
			
			ТекстОшибки = "Водитель " + Водитель.Наименование + " не добавлен в " + Организация;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НомерСтроки, 
				"Добавить" + РеквизитВодитель + "ВСервис", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение, ТекстОшибки, "Добавить");
			
		КонецЕсли;
		
	КонецЕсли;
				
КонецПроцедуры

Функция АктуализироватьСтатусыВодителейТелеграм() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурЛогистика_Сотрудники.Ссылка КАК Ссылка,
		|	КонтурЛогистика_Сотрудники.ТелефонОсновной КАК Телефон
		|ИЗ
		|	Справочник.КонтурЛогистика_Сотрудники КАК КонтурЛогистика_Сотрудники
		|ГДЕ
		|	НЕ КонтурЛогистика_Сотрудники.ПометкаУдаления
		|	И КонтурЛогистика_Сотрудники.ТелефонОсновной <> """"
		|	И НЕ КонтурЛогистика_Сотрудники.ТелефонЗарегестрированВТелеграм";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	Попытка
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Водитель = ВыборкаДетальныеЗаписи.Ссылка;
			
			ТелефонЗарегестрированВТелеграм = КонтурЛогистика_РаботаСТелеграм.ТелефонЗарегестрирован(ВыборкаДетальныеЗаписи.Телефон);
			
			Если Водитель.ТелефонЗарегестрированВТелеграм <> ТелефонЗарегестрированВТелеграм Тогда
				ВодительОбъект = Водитель.ПолучитьОбъект();
				ВодительОбъект.ТелефонЗарегестрированВТелеграм = ТелефонЗарегестрированВТелеграм;
				ВодительОбъект.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = ОписаниеОшибки();
		Возврат ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Процедура ПроверитьДоговор(ДоговорСсылка, ТаблицаОшибок, КатегорияОшибка, Путь) Экспорт

	Если Не ЗначениеЗаполнено(ДоговорСсылка.ДатаДокумента)
		И Не ЗначениеЗаполнено(ДоговорСсылка.ИдДок) Тогда
			
			ТекстОшибки = "В договоре " + ДоговорСсылка + " укажите Дату или Идентификатор файла документа";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				Путь, КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПроведениеДокументаОснования(Объект, ТаблицаОшибок, КатегорияОшибки) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЛогистическийТипПоТипуДокумента(ТипЗнч(Объект.Ссылка));
	Если Не КонтурЛогистика_ОбработкаДокументовСервер.ПроверкаПроведенияПройдена(Объект.ДокументОснование, ТипЛогистика) Тогда
		ТекстОшибки = "Документ должен быть проведен для отражения в Контур.Логистика";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, "", "", "ДокументОснование", КатегорияОшибки, ТекстОшибки, "Ошибка");
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьТитулГотовымКОтправке(Знач ДокументСсылка) Экспорт
	                                                                            
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументСсылка, 
																			Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке,
																			Истина,
																			Истина);

КонецПроцедуры

Функция ПроверкаПроведенияПройдена(Документ1ССсылка, ТипЛогистика) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ1ССсылка) Тогда
		
		ТребуетсяПроведение = Ложь;	// нет документа - нет проблем )
		
	Иначе
		
		ТребуетсяПроведение = ТребуетсяПроведение(Документ1ССсылка, ТипЛогистика);	
		
	КонецЕсли;
		
	
	Возврат Не ТребуетсяПроведение Или Документ1ССсылка.Проведен = Истина;
	
КонецФункции

Функция ТребуетсяПроведение(Документ1ССсылка, ТипЛогистика) Экспорт
	
	Если ЗначениеЗаполнено(ТипЛогистика) Тогда 
	
		ТипЗначенияОснования = ТипЗнч(Документ1ССсылка);
		Объектметаданных = Метаданные.НайтиПоТипу(ТипЗначенияОснования);
		ИмяТипа1СДокумента = Объектметаданных.Имя;
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика, ИмяТипа1СДокумента);
		
		ТребуетсяПроведение = КонтекстНастройкиКонвертации.ТолькоПроведенные;
		
	Иначе
		
		ТребуетсяПроведение =  Ложь;
		
	КонецЕсли;
	
	Возврат ТребуетсяПроведение;
	
КонецФункции

// Процедура - Ввести документ Логистика на основани документа1 С
//
// Параметры:
//  Документ1ССсылка	 - ДокументСсылка - Документ конфигурации (например РТУ) для которого требуется ввести Документ Подсистемы КонтурЛогистика.
//  ТипЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - Имя типа вводимого документа Подсистемы так как оно задано в конфигураторе. 
//		(возможны варианты интеграции когда для 1 документа учетной системы предусмотрен ввод сразу нескольких типов документов Подсистемы.
//  СразуВОчередь		 - Булево - Сразу установит статус вводимого документа в ПодготовленКОтправке. (Регламентное задание генерации заявок сразуотправит его) Производится проверка валидации документа.
//  РежимПропускаДокументов - Булево - ввод докуентов для цели их пропустить
Функция ВвестиДокументЛогистикаНаОснованиДокумента1С(Документ1ССсылка,
														ТипЛогистика,
														СразуВОчередь = Ложь,
														Знач РежимПропускаДокументов = Ложь,
														ПерезаполнятьЧерновики = Ложь) Экспорт
	
	// Ввести документ Логистика требуемого типа, проверив что такого документа еще нет.
	// После этого (или если такой есть) если СразуВОчередь - перевести в статус готов к отправке. 
	// В !обработчике заполнения документа! должны сработать все конвертации и автоподбор.
	
	Если Не РежимПропускаДокументов
		И Не Документ1ССсылка.Проведен
		И ТребуетсяПроведение(Документ1ССсылка, ТипЛогистика) Тогда 
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Требуется проведение " + Документ1ССсылка + " для ввода документа Логистики";
		Сообщение.Сообщить();
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	ВведенныеДокументы = УжеВведенныеДокументыЛогистикаПоДокументу1С(Документ1ССсылка, ТипЛогистика);
	
	Если ВведенныеДокументы.Количество() = 0 Тогда
		
		// Ввести Документ
		РазделителиМассив = РассчитатьРазделительДокументаУчетнойСистемы(ТипЛогистика, Документ1ССсылка);
		Если РазделителиМассив = Неопределено Тогда
			РазделителиМассив = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Неопределено);
		КонецЕсли;
		
		Для Каждого Разделитель Из РазделителиМассив Цикл
			
			ТипВводимогоДокумента = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ТипЛогистика);
			
			Если Не РежимПропускаДокументов Тогда			
				ЗамерВремениОформления = КонтурЛогистика_ЗамерыКлиентСервер.НачатьЗамерВремениОформленияПакетного(ТипЛогистика, Документ1ССсылка);
			КонецЕсли;
			
			НовыйДокОбъект = Документы[ТипВводимогоДокумента].СоздатьДокумент();
			
			Если РежимПропускаДокументов = Истина Тогда
				
				Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
				    Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
					
					НоваяСтрока = НовыйДокОбъект.ДокументыОснования.Добавить();
					НоваяСтрока.ДокументОснование = Документ1ССсылка;
					
				КонецЕсли;	
				
				НовыйДокОбъект.ДокументОснование = Документ1ССсылка;
				НовыйДокОбъект.ДополнительныеСвойства.Вставить("ЭтоПропускДокумента", Истина);
				
				НовыйДокОбъект.Дата = ТекущаяДатаСеанса();
				НовыйДокОбъект.УстановитьВремя();
				НовыйДокОбъект.Записать();
				
				РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
					НовыйДокОбъект.Ссылка, Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен, Истина);
							
			Иначе
				
				ПараметрыЗаполнения = Новый Структура;
				ПараметрыЗаполнения.Вставить("ДокументОснование", Документ1ССсылка);
				ПараметрыЗаполнения.Вставить("ТипЛогистика", ТипЛогистика);
				ПараметрыЗаполнения.Вставить("Разделитель", Разделитель);
				Если ПерезаполнятьЧерновики Тогда
					ПараметрыЗаполнения.Вставить("ПерезаполнитьГлавныйДокументЕслиСуществует", Истина);
				КонецЕсли;
				
				НовыйДокОбъект.Заполнить(ПараметрыЗаполнения);
				
				Если ВДокументеЕстьПолезнаяНагрузка(НовыйДокОбъект) Тогда 
					
					НовыйДокОбъект.Дата = ТекущаяДатаСеанса();
					НовыйДокОбъект.УстановитьВремя();
					НовыйДокОбъект.Записать();
					
					ВведенныеДокументы.Добавить(НовыйДокОбъект.Ссылка);
					
					Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
						И ПараметрыЗаполнения.Свойство("МассивПартий") Тогда
						
						// Свяжем маршрут с порученем
						Для Каждого ТекущаяПартия Из ПараметрыЗаполнения.МассивПартий Цикл
							ДокументМаршрут = ТекущаяПартия.ПолучитьОбъект();
							ДокументМаршрут.Титул1 = НовыйДокОбъект.Ссылка;
							ДокументМаршрут.Записать();
						КонецЦикла;
						
					КонецЕсли;
					
					КонтурЛогистика_ЗамерыКлиентСервер.ЗарегистрироватьВремяРаботыСТитулом(ЗамерВремениОформления);
					
				Иначе
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Введенный документ из " + Документ1ССсылка + " не несет полезной нагрузки. Не записан.";
					Сообщение.Сообщить();
					
					Возврат Новый Массив;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ВведенныеДокументы.Количество() = 1 И ПерезаполнятьЧерновики Тогда
		
		ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ВведенныеДокументы[0]);
		Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик Тогда
			
			// Перезаполним черновик
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("ДокументОснование", Документ1ССсылка);
			ПараметрыЗаполнения.Вставить("ТипЛогистика", ТипЛогистика);
			ПараметрыЗаполнения.Вставить("Разделитель", Разделитель);
			ПараметрыЗаполнения.Вставить("ПерезаполнитьГлавныйДокументЕслиСуществует", Истина);
			ПараметрыЗаполнения.Вставить("Перезаполнить", Истина);
			
			ТекущийДокументОбъект = ВведенныеДокументы[0].ПолучитьОбъект();
			ТекущийДокументОбъект.Заполнить(ПараметрыЗаполнения);
			ТекущийДокументОбъект.Записать();
			
		КонецЕсли;
		
	ИначеЕсли ВведенныеДокументы.Количество() > 1 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Введено несколько документов " + ТипЛогистика
			+ " для " + Документ1ССсылка + " операция не предусматривает автоматическую обработку";
		Сообщение.Сообщить();
		Возврат Новый Массив;
		
	КонецЕсли;
	
	Если СразуВОчередь И ВведенныеДокументы.Количество() > 0 Тогда
		
		// ПодготовитьДокументыЛогистикаКОтправке(ВведенныеДокументы);
		Сообщить("Если СразуВОчередь >> ПодготовитьДокументыЛогистикаКОтправке НЕ реализовано");
		
	КонецЕсли;
	
	Возврат ВведенныеДокументы; 
	
КонецФункции

Функция ВвестиДокументыПакетно(МассивДокументов, СразуВОчередь = Ложь, УточнениеТипаЛогистика = Неопределено, РежимПропустить = Ложь) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ВведенныеДокументы", Новый Массив);
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЭтоДокументПодсистемы(ДокументСсылка) Тогда
			
			НужноВводитьНаОсновании = Ложь;
			Если ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда
				ТипТекущего = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументСсылка);
				Если ТипТекущего <> УточнениеТипаЛогистика Тогда
					КонтекстНКД = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
						УточнениеТипаЛогистика, ДокументСсылка);
					НужноВводитьНаОсновании = КонтекстНКД.ЕстьНастройкаКонвертации;
				КонецЕсли;
			КонецЕсли;
			
			Если Не НужноВводитьНаОсновании Тогда
				Результат.ВведенныеДокументы.Добавить(ДокументСсылка);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		// Определим тип логистического документа
		Если ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда
			ТипыЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(УточнениеТипаЛогистика);
		Иначе
			ТипыЛогистика = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьТипыЛогистикаПоДокументу1С(
				ДокументСсылка);
		КонецЕсли;
		
		// Заполняем только по одному типу
		Если ТипыЛогистика.Количество() <> 1 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для документа " + ДокументСсылка
				+ " указано несколько типов, не могу выбрать какой документ подсистемы создавать";
			Сообщение.Сообщить();
			
			Продолжить;
		КонецЕсли;
		
		УжеВведенные = УжеВведенныеДокументыЛогистикаПоДокументу1С(ДокументСсылка, ТипыЛогистика[0]);
		Если УжеВведенные.Количество() = 0 Тогда
			
			// Вводим новый
			ВведенныеДокументы = ВвестиДокументЛогистикаНаОснованиДокумента1С(ДокументСсылка, ТипыЛогистика[0], СразуВОчередь, РежимПропустить);
			
			Для Каждого ВведенныйДокумент Из ВведенныеДокументы Цикл 
				Результат.ВведенныеДокументы.Добавить(ВведенныйДокумент);
			КонецЦикла;
			
		Иначе
			
			// Уже есть какой-то введенный документ
			Для Каждого ТекущийДокумент Из УжеВведенные Цикл
				
				Результат.ВведенныеДокументы.Добавить(ТекущийДокумент);
				
				Если РежимПропустить = Истина Тогда
					
					ПропуститьОбработкуДокумента(ТекущийДокумент);
					
					// В тек. момент можем пропустить только документы в состоянии,
					// у которого требуемое действие Т1 = значению настройки "Т1НастройкаСостояниеРаспечатать"
					// и значение настройки "ВыводитьЗадачуРаспечатать" должно быть "Истина"
					РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОтметитьДокументыРаспечатанными(УжеВведенные);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПропуститьДокументыПакетно(Документы1С, ДокументыЛогистики, УточнениеТипаЛогистика = Неопределено) Экспорт
	
	// Пропустим учетные документы
	СразуВОчередь = Ложь;
	РежимПропустить = Истина;
	ВвестиДокументыПакетно(Документы1С, СразуВОчередь, УточнениеТипаЛогистика, РежимПропустить);
	
	// Пропустим логистические документы
	СтатусыКотореМожноПропустить = Новый Массив;
	СтатусыКотореМожноПропустить.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
	СтатусыКотореМожноПропустить.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка);
	
	СтатусПропущен = Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен;
	
	Для Каждого ДокументСсылка Из ДокументыЛогистики Цикл
		
		ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументСсылка, Истина);
		
		Если ТекущийСтатус = СтатусПропущен Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтатусыКотореМожноПропустить.Найти(ТекущийСтатус) <> Неопределено Тогда
			
			// Установим статус пропуска
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументСсылка, СтатусПропущен);
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Неподходящий статус документа " + ДокументСсылка + ": " + ТекущийСтатус;
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПропуститьОбработкуДокумента(Документ)
	
	СтатусВведенного = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Документ, Истина);
	
	Если СтатусВведенного <> Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен Тогда
		
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
			Документ, Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен, Истина, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПропускЗадачЭкспедиторскойЦепочки_ТРНЗЗ(ДокументОбъект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	// Может не быть прав на смежные документы
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПоручениеЭкспедитору") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ПропускатьЗадачиПриОформленииЗЗИЭТрН") Тогда
		Возврат;
	КонецЕсли;
	
	// Если офорляется ПЭ, то ТрН и ЗЗ пропускаем и на оборот
	ДокументыОснования = Новый Массив;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
		ДокументыОснования.Добавить(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ДокументОбъект.ДокументыОснования Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументОснование) Тогда
			ДокументыОснования.Добавить(ТекущаяСтрока.ДокументОснование);
		КонецЕсли;
	КонецЦикла;
	
	Если ДокументыОснования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокументаОснование = ТипЗнч(ДокументыОснования[0]);
	
	МассивТипов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(
					Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1, Неопределено, Истина);
					
	Если Не ЕстьВМассивеТипов(ТипДокументаОснование, МассивТипов) Тогда 
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументыОснования);
	
	ДокументыОснования = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(ДокументыОснования);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтурЛогистика_ПЭ_Титул1.ДокументОснование КАК ДокументОснование,
		|	КонтурЛогистика_ПЭ_Титул1.Ссылка КАК ПЭ_Титул1
		|ИЗ
		|	Документ.КонтурЛогистика_ПЭ_Титул1 КАК КонтурЛогистика_ПЭ_Титул1
		|ГДЕ
		|	КонтурЛогистика_ПЭ_Титул1.ДокументОснование В (&ДокументОснование)";
		
	ДанныеПоВведеннымПоручаниям = Запрос.Выполнить().Выгрузить();
		
	ДокументыОснованияДляПропуска = Новый Массив;
	
	// Обойдем все документы основания
	Для Каждого ТекущийДокументОснования Из ДокументыОснования Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ДокументОснование", ТекущийДокументОснования);
		
		НайденныеСтроки = ДанныеПоВведеннымПоручаниям.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			ДокументыОснованияДляПропуска.Добавить(ТекущийДокументОснования);
			Продолжить;
	 	КонецЕсли;
		
	КонецЦикла;
		
	ДокументыОснованияДляПропуска = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(ДокументыОснованияДляПропуска);
		
	ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1;
	ПропуститьДокументыПакетно(ДокументыОснованияДляПропуска, Новый Массив, ТипЛогистика);
	
КонецПроцедуры

Процедура ПропускЗадачЭкспедиторскойЦепочки_ПЭ(ДокументОбъект) Экспорт
	
		УстановитьПривилегированныйРежим(Истина);	// Может не быть прав на смежные документы
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ПропускатьЗадачиЗЗИЭТрНПриОформленииПЭ") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользуетсяЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
	ИспользуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
	
	Если Не ИспользуетсяЗЗ И Не ИспользуетсяТРН Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокументаОснование = ТипЗнч(ДокументОбъект.ДокументОснование);
	
	МассивТипов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(
					Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, Неопределено, Истина);
					
	ИспользуетсяЗЗ = ИспользуетсяЗЗ И ЕстьВМассивеТипов(ТипДокументаОснование, МассивТипов);
	
	МассивТипов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТипыЗначенияДокумента1С(
					Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, Неопределено, Истина);
					
	ИспользуетсяТРН = ИспользуетсяТРН И ЕстьВМассивеТипов(ТипДокументаОснование, МассивТипов);
	
	Если Не ИспользуетсяЗЗ И Не ИспользуетсяТРН Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьНКДОтправкиПрототипаЭТрН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьНастройкаКонвертацииОтправкиПрототипаЭТрН();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.ДокументОснование);
	Запрос.Текст = ТекстЗапросаВведенныхЛогистическихТитуловПоДокументуОснования();
	
	ПропускатьТРН = Истина;
	ПропускатьЗЗ = Истина;
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	МассивДокументов1С = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.ЗначениеВМассивеЛок(ДокументОбъект.ДокументОснование);
	
	ВыборкаПоДокументамЛогистики = РезультатЗапроса.Выбрать();
	Пока ВыборкаПоДокументамЛогистики.Следующий() Цикл
		
		// Проставим признаки наличия пропуска
		Если ТипЗнч(ВыборкаПоДокументамЛогистики.ДокументЛогистики) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
			ПропускатьЗЗ = Ложь;
		ИначеЕсли ТипЗнч(ВыборкаПоДокументамЛогистики.ДокументЛогистики) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
			ПропускатьТРН = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЕстьНКДОтправкиПрототипаЭТрН И ПропускатьТРН И ИспользуетсяТРН Тогда
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		ПропуститьДокументыПакетно(МассивДокументов1С, Новый Массив, ТипЛогистика);
	КонецЕсли;
	
	Если ПропускатьЗЗ И ИспользуетсяЗЗ Тогда
		ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1;
		ПропуститьДокументыПакетно(МассивДокументов1С, Новый Массив, ТипЛогистика);
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьВМассивеТипов(ТипДокументаОснование, МассиваТипов)
	
	Для Каждого ТипДокумента Из МассиваТипов Цикл
	
		Если Тип("ДокументСсылка." + ТипДокумента) = ТипДокументаОснование Тогда
			Возврат Истина;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции	

Функция ТекстЗапросаВведенныхЛогистическихТитуловПоДокументуОснования()
	
	Возврат
	"ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК ДокументЛогистики,
	|	КонтурЛогистика_ТрН_Титул1.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|ГДЕ
	|	КонтурЛогистика_ТрН_Титул1.ДокументОснование = &ДокументОснование
	|	И НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1.Ссылка,
	|	КонтурЛогистика_ЗЗ_Титул1.ДокументОснование
	|ИЗ
	|	Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
	|ГДЕ
	|	КонтурЛогистика_ЗЗ_Титул1.ДокументОснование = &ДокументОснование
	|	И НЕ КонтурЛогистика_ЗЗ_Титул1.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1ДокументыОснования.Ссылка,
	|	КонтурЛогистика_ЗЗ_Титул1ДокументыОснования.ДокументОснование
	|ИЗ
	|	Документ.КонтурЛогистика_ЗЗ_Титул1.ДокументыОснования КАК КонтурЛогистика_ЗЗ_Титул1ДокументыОснования
	|ГДЕ
	|	НЕ КонтурЛогистика_ЗЗ_Титул1ДокументыОснования.Ссылка.ПометкаУдаления
	|	И КонтурЛогистика_ЗЗ_Титул1ДокументыОснования.ДокументОснование = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1ДокументыОснования.Ссылка,
	|	КонтурЛогистика_ТрН_Титул1ДокументыОснования.ДокументОснование
	|ИЗ
	|	Документ.КонтурЛогистика_ТрН_Титул1.ДокументыОснования КАК КонтурЛогистика_ТрН_Титул1ДокументыОснования
	|ГДЕ
	|	НЕ КонтурЛогистика_ТрН_Титул1ДокументыОснования.Ссылка.ПометкаУдаления
	|	И КонтурЛогистика_ТрН_Титул1ДокументыОснования.ДокументОснование = &ДокументОснование";
	
КонецФункции

Функция ТекстЗапросаВведенныхЛогистическихТитуловСвязанныхСПоручениемЭкспедитору()
	
	Возврат
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_Титул1.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ ДокументыОснованияПоручения
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_Титул1 КАК КонтурЛогистика_ПЭ_Титул1
	|ГДЕ
	|	КонтурЛогистика_ПЭ_Титул1.ДокументОснование = &Титул1
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ПЭ_Титул1.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка,
	|	ДокументыОснованияПоручения.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ ЛогистическиеДокументы
	|ИЗ
	|	ДокументыОснованияПоручения КАК ДокументыОснованияПоручения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	|		ПО ДокументыОснованияПоручения.ДокументОснование = КонтурЛогистика_ТрН_Титул1.ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ТрН_Титул1ДокументыОснования.Ссылка,
	|	ДокументыОснованияПоручения.ДокументОснование
	|ИЗ
	|	ДокументыОснованияПоручения КАК ДокументыОснованияПоручения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ТрН_Титул1.ДокументыОснования КАК КонтурЛогистика_ТрН_Титул1ДокументыОснования
	|		ПО ДокументыОснованияПоручения.ДокументОснование = КонтурЛогистика_ТрН_Титул1ДокументыОснования.ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1.Ссылка,
	|	ДокументыОснованияПоручения.ДокументОснование
	|ИЗ
	|	ДокументыОснованияПоручения КАК ДокументыОснованияПоручения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
	|		ПО ДокументыОснованияПоручения.ДокументОснование = КонтурЛогистика_ЗЗ_Титул1.ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтурЛогистика_ЗЗ_Титул1ДокументыОснования.Ссылка,
	|	ДокументыОснованияПоручения.ДокументОснование
	|ИЗ
	|	ДокументыОснованияПоручения КАК ДокументыОснованияПоручения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ЗЗ_Титул1.ДокументыОснования КАК КонтурЛогистика_ЗЗ_Титул1ДокументыОснования
	|		ПО ДокументыОснованияПоручения.ДокументОснование = КонтурЛогистика_ЗЗ_Титул1ДокументыОснования.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛогистическиеДокументы.ДокументОснование КАК ДокументОснование,
	|	ЛогистическиеДокументы.Ссылка КАК ДокументЛогистики,
	|	МАКСИМУМ(КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус) КАК Статус
	|ИЗ
	|	ЛогистическиеДокументы КАК ЛогистическиеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО ЛогистическиеДокументы.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЛогистическиеДокументы.ДокументОснование,
	|	ЛогистическиеДокументы.Ссылка
	|ИТОГИ ПО
	|	ДокументОснование";
	
КонецФункции

Функция ЕстьПропущенныеЗадачиПоПоручениюЭкспедитора(ПЭ_Титул1) Экспорт
	
	Если Не ЗначениеЗаполнено(ПЭ_Титул1) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтатусПропущен = Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титул1", ПЭ_Титул1);
	Запрос.Текст = ТекстЗапросаВведенныхЛогистическихТитуловСвязанныхСПоручениемЭкспедитору();
	
	ВыборкаПоДокументамОснования = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументамОснования.Следующий() Цикл
		
		ВыборкаПоДокументамЛогистики = ВыборкаПоДокументамОснования.Выбрать();
		Пока ВыборкаПоДокументамЛогистики.Следующий() Цикл
			
			Если ВыборкаПоДокументамЛогистики.Статус = СтатусПропущен Тогда
				Возврат Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ОтменитьПропускЗадачЭкспедитора(ПЭ_Титул1, ТихийРежим = Ложь) Экспорт
	
	СтатусПропущен = Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен;
	СтатусЧерновик = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титул1", ПЭ_Титул1);
	Запрос.Текст = ТекстЗапросаВведенныхЛогистическихТитуловСвязанныхСПоручениемЭкспедитору();
	
	ВыборкаПоДокументамОснования = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументамОснования.Следующий() Цикл
		
		ВыборкаПоДокументамЛогистики = ВыборкаПоДокументамОснования.Выбрать();
		Пока ВыборкаПоДокументамЛогистики.Следующий() Цикл
			
			Если ВыборкаПоДокументамЛогистики.Статус <> СтатусПропущен Тогда
				Продолжить;
			КонецЕсли;
			
			// Отменим пропуск
			ДокОбъект = ВыборкаПоДокументамЛогистики.ДокументЛогистики.ПолучитьОбъект();
			ДокОбъект.УстановитьПометкуУдаления(Истина);
			ДокОбъект.Записать();
			
			Если Не ТихийРежим Тогда
				Сообщить("Документ введен в работу: " + Строка(ВыборкаПоДокументамЛогистики.ДокументЛогистики));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗарегистрироватьСтатистику_ОтправитьПодписанный(ТипЛогистика, Документ) Экспорт
	
	Если (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
		Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка) Тогда 
			
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда	
			Данные = Документы.КонтурЛогистика_ПЭ_Титул1.ПолучитьДанныеДляМетрик(Документ);
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2 Тогда	
			Данные = Документы.КонтурЛогистика_ПЭ_Титул2.ПолучитьДанныеДляМетрик(Документ);
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
			Данные = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.ПолучитьДанныеДляМетрик(Документ);
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СкладскаяРасписка Тогда
			Данные = Документы.КонтурЛогистика_СкладскаяРасписка.ПолучитьДанныеДляМетрик(Документ);
		КонецЕсли;
				
		КонтурЛогистика_Метрика.ЗарегистрироватьСтатистику(Данные.Переменные, Данные.Path_Category, "Подписать и отправить", Данные.Path_View);
			
	КонецЕсли;
	
КонецПроцедуры 	

Функция ВвестиСледующиеТитулыПоПереданнымПакетно(МассивПереданныхТитулов, ВводимыйТип, РежимПропустить = Ложь,
	МассивДопДанныеЗаполнения, ПерезаполнятьЧерновики = Ложь, СпецСценарий = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Ложь;
	Результат.Вставить("ВведенныеДокументы", Новый Массив);
	
	сч = 0;
	Для Каждого ПредыдущийТитул Из МассивПереданныхТитулов Цикл
		
		сч = сч + 1;
		допДанныеЗаполнения = Неопределено;
		Если МассивДопДанныеЗаполнения.Количество() >= сч Тогда
			допДанныеЗаполнения = МассивДопДанныеЗаполнения[сч-1];
		КонецЕсли;
		
		Если СпецСценарий = Перечисления.КонтурЛогистика_СпецСценарииЗадач.ТрнТитул7ПослеТитула4 Тогда
			Если допДанныеЗаполнения = Неопределено Тогда
				допДанныеЗаполнения = Новый Структура;
			КонецЕсли;
			Если ТипЗнч(допДанныеЗаполнения) = Тип("Структура") Тогда
				допДанныеЗаполнения.Вставить("ЭтоВозвратнаяЦепочка", Истина);
			КонецЕсли;
		КонецЕсли;
		
		КонтекстНастройкиКонвертации = КонтекстНастройкиКонвертацииБезОснования(
			ВводимыйТип, СпецСценарий);
		Если КонтекстНастройкиКонвертации.ОбязательныйДокументУчетнойСистемыДляОтправки
			И Не КонтурЛогистика_КонвертацияСерверПовтИсп.СценарийДопускаетПустойТипДокумента1С(
				КонтекстНастройкиКонвертации.Сценарий) Тогда 
			
			НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляСледующегоТитула(
				ПредыдущийТитул, СпецСценарий);
			Если Не ЗначениеЗаполнено(НайденныйДокУчСист) Тогда
				ТекстОшибки = "Не найден документ учетной системы следующего титула для: " + ПредыдущийТитул;
				Результат.МассивОшибок.Добавить(ТекстОшибки);
				КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ГлавныйДок = НайтиГлавныйДокументПоТитулу(Предыдущийтитул);
		
		МассивУжеВведенныхДокументов = УжеВведенныеДокументыЛогистикаПоГлавномуДокументу(
			ГлавныйДок, ВводимыйТип, ПредыдущийТитул, допДанныеЗаполнения);
		
		Если МассивУжеВведенныхДокументов.Количество() = 0 Тогда
			
			ТипНовогоДокументаСтрокой = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТипДокументаСтрокойПоТипуЛогистика(ВводимыйТип);
			
			ЗамерВремениОформления = КонтурЛогистика_ЗамерыКлиентСервер.НачатьЗамерВремениОформленияПакетного(ВводимыйТип);
			
			ЗаполняемыйТитулОбъект = Документы[ТипНовогоДокументаСтрокой].СоздатьДокумент();
			ЗаполняемыйТитулОбъект.УстановитьНовыйНомер();
			ЗаполняемыйТитулОбъект.Дата = ТекущаяДата();
			
		Иначе // в массиве есть доки
			
			ЗаполняемыйТитулОбъект = МассивУжеВведенныхДокументов[0].ПолучитьОбъект();
			
		КонецЕсли;
		
		ДанныеЗаполнения = Новый Структура("ПредыдущийТитул,ТипЛогистика", ПредыдущийТитул, ВводимыйТип);
		
		Если допДанныеЗаполнения <> Неопределено Тогда 
			
			Для Каждого ЭлементСтруктуры Из допДанныеЗаполнения Цикл 
				ДанныеЗаполнения.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
		ЗаполняемыйТитулОбъект.Заполнить(ДанныеЗаполнения);
		ЗаполняемыйТитулОбъект.Записать();
		
		КонтурЛогистика_ЗамерыКлиентСервер.ЗарегистрироватьВремяРаботыСТитулом(ЗамерВремениОформления);
		
		Результат.ВведенныеДокументы.Добавить(ЗаполняемыйТитулОбъект.Ссылка);
		Результат.Успешно = Истина;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВвестиТРНизЗЗПакетно(МассивПереданныхТитулов) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Ложь;
	Результат.Вставить("ВведенныеДокументы", Новый Массив);
	
	БылиОтказыГОнеНаш = Ложь;
	БылУспешныйВвод = Ложь;
	сч = 0;
	Для Каждого ПредыдущийТитул Из МассивПереданныхТитулов Цикл
		
		сч = сч + 1;
		
		ДокументОснованиеСсылка = ПредыдущийТитул;
		
		Если ТипЗнч(ДокументОснованиеСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда 
			ДокументОснованиеСсылка = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ДокументОснованиеСсылка, "Титул1");
		КонецЕсли;
		
		ГОНаш = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ДокументОснованиеСсылка, "Грузоотправитель.Наш");
		
		Если ГОНаш = Истина Тогда 
			
			СуществующаяЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрНпоЗаказЗаявке(ДокументОснованиеСсылка);
			Если Не ЗначениеЗаполнено(СуществующаяЭТРН) Тогда
				НовыйТ1 = Документы.КонтурЛогистика_ТрН_Титул1.СоздатьДокумент();
				НовыйТ1.Дата = ТекущаяДатаСеанса();
				ДанныеЗаполнения = Новый Структура("ДокументОснование, ТипЛогистика", ДокументОснованиеСсылка, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
				НовыйТ1.Заполнить(ДанныеЗаполнения);
				НовыйТ1.Записать();
				БылУспешныйВвод = Истина;
			КонецЕсли;
			
		Иначе
			
			БылиОтказыГОнеНаш = Истина;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Если БылиОтказыГОнеНаш Тогда 
		
		Если БылУспешныйВвод Тогда 
			Сообщить("Часть документов не введена т.к. к Грузоотправителю нет доступа (не Наш)");
		Иначе
			Сообщить("Документы не введены т.к. к Грузоотправителю нет доступа(не Наш)");
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

Функция ЗаполнитьТекущиеДокументыЛогистикаИзПредыдущихТитулов(МассивПереданныхТитулов, РежимПропустить = Ложь) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Ложь;
	Результат.Вставить("ВведенныеДокументы", Новый Массив);
	
	Для Каждого ТекТитул Из МассивПереданныхТитулов Цикл
		
		ЗаполнитьТекущийДокументЛогистикаИзПредыдущеготитула(ТекТитул);
		
	КонецЦикла;
	
	Возврат Результат
	
КонецФункции

Процедура ЗаполнитьТекущийДокументЛогистикаИзПредыдущеготитула(Знач ТекТитул) Экспорт
	
	Перем ДанныеЗаполнения, ГлавныйДокумент, ЗаполняемыйТитулОбъект, ПредыдущийТипВЦепочке, ПредыдущийТитул, ТипЛогистикаТекущегоТитула;
	
	ПредыдущийТитул = ПредыдущийТитулПоЗаписанномуТекущему(ТекТитул, ТипЛогистикаТекущегоТитула);
	
	ДанныеЗаполнения 	= Новый Структура("ПредыдущийТитул, ТипЛогистика", ПредыдущийТитул, ТипЛогистикаТекущегоТитула);
	
	ЗаполняемыйТитулОбъект = ТекТитул.ПолучитьОбъект();
	ЗаполняемыйТитулОбъект.Заполнить(ДанныеЗаполнения);
	ЗаполняемыйТитулОбъект.Записать();

КонецПроцедуры

Функция ПредыдущийТитулПоЗаписанномуТекущему(Знач ТекТитул, ТипЛогистикаТекущегоТитула) Экспорт
	
	ГлавныйДокумент = НайтиГлавныйДокументПоТитулу(ТекТитул);
	ТипЛогистикаТекущегоТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТекТитул);
	ПредыдущийТипВЦепочке = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредыдущийПоЦепочкеТипЛогистика(ТипЛогистикаТекущегоТитула);
	ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ПредыдущийТипВЦепочке , ГлавныйДокумент);
	
	Возврат ПредыдущийТитул;
	
КонецФункции

Функция ПредыдущийТитулПоГлавномуИТекущемуТипу(Знач ГлавныйДокумент, ТипЛогистикаТекущегоТитула) Экспорт
	
	ПредыдущийТипВЦепочке = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредыдущийПоЦепочкеТипЛогистика(ТипЛогистикаТекущегоТитула);
	ПредыдущийТитул = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(ПредыдущийТипВЦепочке , ГлавныйДокумент);
	
	Возврат ПредыдущийТитул;
	
КонецФункции

Процедура ПреобразоватьДанныеЗаполненияДляУчетныхДокументов(ДанныеЗаполнения, ТипЛогистика) Экспорт
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	ПолноеИмяДокументаЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку_(
		"КонтурЛогистика_%1",
		ИмяТитула);
		
	ТипыОснования = Метаданные.Документы[ПолноеИмяДокументаЛогистика].Реквизиты.ДокументОснование.Тип.Типы();
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если  ТипыОснования.Найти(ТипДанныхЗаполнения) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОснование = ДанныеЗаполнения;
	ДанныеЗаполнения  = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", ДокументОснование);
	ДанныеЗаполнения.Вставить("ТипЛогистика", ТипЛогистика);
	
КонецПроцедуры

Функция УжеВведенныеДокументыЛогистикаПоДокументу1С(Документ1СОснование, Знач ТипЛогистика, Знач ДопПараметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипСсылки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	               |ГДЕ
	               |	КонтурЛогистика_ТрН_Титул1.ДокументОснование = &ДокументОснование
	               |	И НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления";
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") Тогда
		
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		   |	КонтурЛогистика_ТрН_Титул1ДокументыОснования.Ссылка КАК Ссылка
		   |ИЗ
		   |	Документ.КонтурЛогистика_ТрН_Титул1.ДокументыОснования КАК КонтурЛогистика_ТрН_Титул1ДокументыОснования
		   |ГДЕ
		   |	КонтурЛогистика_ТрН_Титул1ДокументыОснования.ДокументОснование = &ДокументОснование
		   |	И НЕ КонтурЛогистика_ТрН_Титул1ДокументыОснования.Ссылка.ПометкаУдаления";
			
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		// Ищем титулы ПЭ по документу УС; при разделении у каждого титула свой Разделитель,
		// но проверка «уже введены» — по наличию любого титула с этим основанием (как у ТрН).
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтурЛогистика_ПЭ_Титул1.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ПЭ_Титул1 КАК КонтурЛогистика_ПЭ_Титул1
		|ГДЕ
		|	КонтурЛогистика_ПЭ_Титул1.ДокументОснование = &ДокументОснование
		|	И НЕ КонтурЛогистика_ПЭ_Титул1.ПометкаУдаления";
		ТипСсылки = "ПЭ_Титул1";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументОснование", Документ1СОснование);
	
	Если Не ЗначениеЗаполнено(ТипСсылки) Тогда
		ТипСсылки = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТрН_Титул1", ТипСсылки);
	
	Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2	Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ДокументОснование", ".Титул1");
	КонецЕсли;	
	
	Результат = Запрос.Выполнить();
	
	МассивВведенных = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивВведенных;
	
КонецФункции

Функция УжеВведенныеДокументыЛогистикаПоГлавномуДокументу(ГлавныйДокумент, ТипЛогистика, ПредыдущийТитул = Неопределено, Знач ДопПараметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ДопПараметры = Неопределено Тогда 
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	               |ГДЕ
	               |	НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	               |	И КонтурЛогистика_ТрН_Титул1.ДокументЭТРН = &ГлавныйДокумент //ДопУсловие" ;
	
	Запрос.УстановитьПараметр("ГлавныйДокумент", ГлавныйДокумент);
	
	Если ЗначениеЗаполнено(ПредыдущийТитул) Тогда
		
		Если  ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7") Тогда
			
			НовыйГП = ПредыдущийТитул.НовГрузПол;
			НовоеМестоВыгрузки = ПредыдущийТитул.АдрВыгруз;
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", "И КонтурЛогистика_ТрН_Титул1.МестоВыгрузки = &НовоеМестоВыгрузки И КонтурЛогистика_ТрН_Титул1.Грузополучатель = &НовыйГП //ДопУсловие");
			
			Запрос.УстановитьПараметр("НовоеМестоВыгрузки", НовоеМестоВыгрузки);
			Запрос.УстановитьПараметр("НовыйГП", НовыйГП);
		
		ИначеЕсли  ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
			И ПредыдущийТитул.ЭтоПриемВозврата Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", "И КонтурЛогистика_ТрН_Титул1.ЭтоПриемВозврата //ДопУсловие");
			
		КонецЕсли;
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул6 Тогда 
						
			Запрос.Текст = СтрЗаменить(Запрос.Текст, 
										"Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1", 
										"Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
										|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
										|		ПО КонтурЛогистика_ТрН_Титул1.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ");
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", "И (НЕ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаОтказВПодписи)"
				+ " ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус ЕСТЬ NULL) //ДопУсловие");
			
		ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7 Тогда 
			
			Если ДопПараметры.Свойство("ЭтоВозвратнаяЦепочка") И ДопПараметры.ЭтоВозвратнаяЦепочка = Истина Тогда 
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", "И КонтурЛогистика_ТрН_Титул1.ЭтоВозвратнаяЦепочка = Истина //ДопУсловие");
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", "И КонтурЛогистика_ТрН_Титул1.ЭтоВозвратнаяЦепочка = Ложь //ДопУсловие");
			КонецЕсли;
			
		КонецЕсли;
		
		// Добавка для отслеживания исправлений
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4 Тогда
			
			Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2 Тогда
				ТекстУсловия = "И КонтурЛогистика_ТрН_Титул1.НомИспрГО = &НомИспр //ДопУсловие";
			Иначе
				ТекстУсловия = "И КонтурЛогистика_ТрН_Титул1.НомИспрГП = &НомИспр //ДопУсловие";
			КонецЕсли;
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", ТекстУсловия);
			Запрос.УстановитьПараметр("НомИспр", ПредыдущийТитул.НомИспр);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСВ(ТипЛогистика) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "ДокументСВ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", "И КонтурЛогистика_ТрН_Титул1.ТипТитула = &ТипТитула");
		Запрос.УстановитьПараметр("ТипТитула", ТипЛогистика);
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ТипЛогистика) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "ДокументЗН");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ТипЛогистика) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "Титул1");	
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоДФ(ТипЛогистика) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "Титул1");	
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ТипЛогистика) Тогда
		
		Если (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 
			И ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул5"))
			Или (ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 
			И ТипЗнч(ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул4_5_02")) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "ПредыдущийПЛ");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "Титул1");
		КонецЕсли;
		
		Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
			Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
			
			Если ДопПараметры.Свойство("Водитель") И ЗначениеЗаполнено(ДопПараметры.Водитель) Тогда 
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ДопУсловие", " И КонтурЛогистика_ТрН_Титул1.Водитель = &Водитель //ДопУсловие");
				Запрос.УстановитьПараметр("Водитель", ДопПараметры.Водитель);
			
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ТипЛогистика) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "Титул1");
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ТипЛогистика)
		Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ТипЛогистика) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДокументЭТРН", "ПЭ_Титул1");
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТрН_Титул1", Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика));
	
	Результат = Запрос.Выполнить();
	
	МассивВведенных = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивВведенных;
	
КонецФункции 

Функция ВДокументеЕстьПолезнаяНагрузка(ДокументОбъект)

	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул1")
		ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул3") Тогда
		
		Возврат ДокументОбъект.Товары.Количество() > 0;
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул2") Тогда 
		Возврат Истина; // TODO
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул4") Тогда 
		Возврат Истина; // TODO
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул5") Тогда 
		Возврат Истина; // TODO
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул6") Тогда 
		Возврат Истина; // TODO
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул7") Тогда 
		Возврат Истина; // TODO
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КонтурЛогистика_ТрН_Титул8") Тогда 
		Возврат Истина; // TODO	
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции 

Функция ОтправитьФайлыВДиадок(МассивСсылок) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	Для Каждого ФайлОбменаСсылка Из МассивСсылок Цикл
		
		ЭтоШаблон = ЗначениеЗаполнено(ФайлОбменаСсылка.ОтправительШаблона);
		ЭтоДокументИзШаблона = ЗначениеЗаполнено(ФайлОбменаСсылка.ШаблонОснование);
		
		РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
		
		// Такая же проверка есть в ФайлОбменаОбъект.Отправить()
		Если Не ЭтоШаблон И Не ЭтоДокументИзШаблона И Не ФайлОбменаСсылка.ПодписьВерна  И ФайлОбменаСсылка.ТребуетсяПодпись Тогда 
			Сообщить("Файл " + ФайлОбменаСсылка + " нельзя отправить т.к. он не подписан (или подпись не верна)");
			Продолжить;
		КонецЕсли;
			
		Попытка
			
			ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
			
			РезультатОтправки = ФайлОбменаОбъект.Отправить();
			
			Если Не РезультатОтправки.Успешно Тогда
				
				Результат.Успешно = Ложь;
				Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
				
			КонецЕсли;
			
		Исключение
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить("Не удалось отправить файл обмена в Диадок "
				+ ФайлОбменаСсылка + " по причине: " + ОписаниеОшибки());
						
		КонецПопытки;
		
		// Действия после успешной отправки
		Если РезультатОтправки.Успешно Тогда
			
			КонтурЛогистика_Метрика.Общепродуктовая_ОтправитьВыполнениеЦелевогоДействия(ФайлОбменаСсылка.Отправитель);
			
			Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
				
				Если ЭтоТитул12Исправления(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
					// Для титулов исправления не трогаем документооборот, если потребуется, то отразиться в особенностях
					Продолжить;
				КонецЕсли;
								
				// Может возникнуть соблазн сразу же получить идентификаторы из custom data
				// делать это синхронно не следует т.к. они к этому моменту с большой вероятностью еще не готовы на стороне сервиса
				Если ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент)
					И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
					
					Если ЭтоШаблон Тогда
						Состояние = "completed";
					ИначеЕсли ТипЗнч(ФайлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
						И ЗначениеЗаполнено(ФайлОбменаСсылка.Составитель)
						И ФайлОбменаСсылка.Составитель <> ФайлОбменаСсылка.ГлавныйДокумент.Грузоотправитель
						И ФайлОбменаСсылка.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда
						
						Состояние = "r-wait-storekeeper";
					ИначеЕсли ТипЗнч(ФайлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
						И ФайлОбменаСсылка.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда
						
						СтатусДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ФайлОбменаСсылка.ГлавныйДокумент);
						Если ЗначениеЗаполнено(СтатусДО) И СтатусДО.Код = "r-wait-consignor-sign" Тогда
							Состояние = "r-consignor-signed";
						Иначе
							Состояние = "new";
						КонецЕсли;
					Иначе
						Состояние = "new";
					КонецЕсли;
					
					// Если получатель не наш, то установим состояние ДО сразу после отправки
					Если (Состояние = "new" Или Состояние = "r-consignor-signed") И Не ФайлОбменаСсылка.Получатель.Наш Тогда
						
						Если ФайлОбменаСсылка.ПодписьВерна Тогда
							
							Состояние = "r-wait-driver-approve";
							
						ИначеЕсли ФайлОбменаСсылка.ПередатьНаПодписание Тогда
							
							Состояние = "r-wait-consignor-sign";
							
						ИначеЕсли ФайлОбменаСсылка.ПередатьНаСогласованиеВодителю Тогда
							
							Состояние = "r-wait-driver-draftApprove";
							
						Иначе
							
							Состояние = "r-wait-storekeeper";
							
						КонецЕсли;											
							
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул2")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент) Тогда
					
					Если ФайлОбменаСсылка.СвязанныйДокумент.ЕстьОтказВПодписи Тогда
						Состояние = "r-rejected";
					Иначе
						Если Не ФайлОбменаСсылка.Получатель.Наш Тогда
							Состояние = "on-the-way";
						Иначе
							Состояние = "r-carrier-signed";
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент)
					И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
					
					Если ФайлОбменаСсылка.ПодписьВерна Тогда
						Состояние = "d-consingee-singed";
					ИначеЕсли ТипЗнч(ФайлОбменаСсылка.ГлавныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная")
						И ФайлОбменаСсылка.КаналТранспорта = Перечисления.КонтурЛогистика_КаналыТранспорта.API_КонтурЛогистика Тогда
						
						СтатусДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ФайлОбменаСсылка.ГлавныйДокумент);
						Если ЗначениеЗаполнено(СтатусДО) И СтатусДО.Код = "d-wait-storekeeper" Тогда
							Состояние = "d-consingee-singed";
						Иначе
							Состояние = "new";
						КонецЕсли;
					Иначе
						Состояние = "d-wait-storekeeper";
					КонецЕсли;
					
					// Если получатель не наш, то установим состояние ДО сразу после отправки
					Если (Состояние = "new" Или Состояние = "d-consingee-singed") И Не ФайлОбменаСсылка.Получатель.Наш 
					Тогда
						
						Если ФайлОбменаСсылка.ПодписьВерна Тогда
							
							Если ФайлОбменаСсылка.СвязанныйДокумент.ОтказВПриемке Или ФайлОбменаСсылка.СвязанныйДокумент.ПринятьЧастично Тогда
								Состояние = "pd-wait-driver-approve";
							Иначе
								Состояние = "d-wait-driver-approve";
							КонецЕсли;
														
						ИначеЕсли ФайлОбменаСсылка.ПередатьНаПодписание Тогда
							
							Состояние = "d-wait-consignee-sign";
							
						ИначеЕсли ФайлОбменаСсылка.ПередатьНаСогласованиеВодителю Тогда
							
							Состояние = "r-wait-driver-draftApprove";
							
						Иначе
							
							Состояние = "d-wait-driver-draftApprove";
							
						КонецЕсли;
						
					КонецЕсли;
										
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул4")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент) Тогда
					
					Если Не ФайлОбменаСсылка.Получатель.Наш Тогда
						
						Если ФайлОбменаСсылка.СвязанныйДокумент.ОтказВПриемке Или ФайлОбменаСсылка.СвязанныйДокумент.ПринятьЧастично Тогда
							Состояние = "d-carrier-signed";
						Иначе
							Состояние = "completed";
						КонецЕсли;
					
					Иначе
						
						Состояние = "d-carrier-signed";
					
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул5")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент) Тогда
					
					Состояние = "c-wait-consignor-sign";
					
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул6")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент) 
					Тогда
					
					Если ФайлОбменаСсылка.СвязанныйДокумент.ЕстьОтказВПодписи Тогда 
						Состояние = "c-rejected";
					Иначе
						Состояние = "c-completed"; //TODO изменить на "c-consignor-sign", когда вэб добавит статусы 	
					КонецЕсли;
				
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул7")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент) 
					И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) 
					Тогда
					
					Состояние = "pd-on-the-way";
					
					// обновим данные из Титула 7 в ЭТрН
					Попытка
					
						Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ОбновитьГрузополучателяИМестоДоставки(ФайлОбменаСсылка.ГлавныйДокумент, ФайлОбменаСсылка.СвязанныйДокумент);
						Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ОбновитьСчетчикПереадресовок(ФайлОбменаСсылка.ГлавныйДокумент);
					
					Исключение
					    // (заблокирован?) последствия не отражения не кажутся ужасными, промоличм
					КонецПопытки;
					
				ИначеЕсли ТипЗнч(ФайлОбменаСсылка.СвязанныйДокумент) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул8")
					И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент)
					И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
					
					ВсеПереадресации = Документы.КонтурЛогистика_ТрН_Титул7.ВсеПереадресации(ФайлОбменаСсылка.ГлавныйДокумент);
					Если ВсеПереадресации.Количество() = 0 Тогда
						Состояние = "on-the-way";
					Иначе
						Состояние = "pd-on-the-way";
					КонецЕсли;
					
					// обновим данные из Титула 8 в ЭТрН
					Попытка
					
						Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ОбновитьСчетчикСменИТелефон(ФайлОбменаСсылка.ГлавныйДокумент, ФайлОбменаСсылка.СвязанныйДокумент);
					
					Исключение
					    // (заблокирован?) последствия не отражения не кажутся ужасными, промоличм
					КонецПопытки;
					
				КонецЕсли;
				
			ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗН(ФайлОбменаСсылка.ТипДокумента)
				И ЗначениеЗаполнено(ФайлОбменаСсылка.ГлавныйДокумент) 
				И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
				
				Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1 Тогда
					
					Состояние = "zn-wait-freighter";
					
				ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул2 Тогда
					
					Состояние = "zn-wait-arrival";
					
				ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул3 Тогда
					
					Состояние = "zn-on-the-way";
					
				ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул4 Тогда
					
					Состояние = "completed";
					
				КонецЕсли;
				
				Документ = ФайлОбменаСсылка.ГлавныйДокумент;
				
			ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ(ФайлОбменаСсылка.ТипДокумента)
				И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
				
				Состояние = ПолучитьСтатусДОПутевойЛистПоФайлуОтправленномуИлиПолученному(ФайлОбменаСсылка);
				
			ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЗЗ(ФайлОбменаСсылка.ТипДокумента)
				И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
				
				Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
					Если ЭтоШаблон Тогда
						Состояние = "zz-templateSend-carrier"; 
					ИначеЕсли Не ФайлОбменаСсылка.ТребуетсяПодпись Или Не ФайлОбменаСсылка.ПодписьВерна Тогда
						Состояние = "zz-wait-consignor-sign";
					Иначе 	
						Состояние = "zz-wait-carrier";
					КонецЕсли;	
				Иначе
					Если ФайлОбменаСсылка.СвязанныйДокумент.ЕстьОтказВПодписи Тогда 
						Состояние = "zz-rejected";
					Иначе
						Состояние = "zz-сheckAnswer";
					КонецЕсли;
				КонецЕсли;
			
			ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(ФайлОбменаСсылка.ТипДокумента)
				И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
				
				Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
					Если ЭтоШаблон Тогда
						Состояние = "pe-templateSend-forwarder";
					ИначеЕсли Не ФайлОбменаСсылка.ТребуетсяПодпись Или Не ФайлОбменаСсылка.ПодписьВерна Тогда
						Состояние = "pe-wait-customer-sign";
					Иначе
						Состояние = "pe-wait-forwarder";
					КонецЕсли;
				Иначе
					Состояние = "pe-completed";
				КонецЕсли;	
				
			ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ФайлОбменаСсылка.ТипДокумента)
				Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ФайлОбменаСсылка.ТипДокумента)
				И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
				
				Если ЭтоШаблон Тогда
					Если ФайлОбменаСсылка.ГлавныйДокумент.Экспедитор.Наш Тогда
						Состояние = КодСостоянияДОЭРСР(ФайлОбменаСсылка.ТипДокумента, "сheck-forwarder");
					Иначе
						Состояние = КодСостоянияДОЭРСР(ФайлОбменаСсылка.ТипДокумента, "wait-forwarder");
					КонецЕсли;
				Иначе
					// Пока убираем логику ответной подписи
					// Если не требуется ответной подписи, то документооборот завершаем
					//Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ТребуетсяОтветнаяПодписьЗаказчикаЭР") Тогда
					//	Если ФайлОбменаСсылка.ГлавныйДокумент.Грузоотправитель.Наш Тогда
					//		Состояние = КодСостоянияДОЭРСР(ФайлОбменаСсылка.ТипДокумента, "сheck-cargo-owner");
					//	Иначе
					//		Состояние = КодСостоянияДОЭРСР(ФайлОбменаСсылка.ТипДокумента, "wait-cargo-owner");
					//	КонецЕсли;
					//Иначе
						Состояние = КодСостоянияДОЭРСР(ФайлОбменаСсылка.ТипДокумента, "completed");
					//КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			ДатаВремяОтправки = Неопределено;
			РезультатОтправки.Свойство("ДатаВремяМСК", ДатаВремяОтправки);
			ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлОбменаСсылка, , ФайлОбменаСсылка.КаналТранспорта);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ФайлОбменаСсылка.ГлавныйДокумент, Состояние, ДатаВремяОтправки,,, ДопДанные);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ФайлыОбменаСогласованния(ДокументыСогласования) Экспорт
	
	СостоянияФайлаОбмена = Новый Массив;
	СостоянияФайлаОбмена.Добавить(Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Получен);
	СостоянияФайлаОбмена.Добавить(Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен);
	
	ТаблицаКрайнихФайловДокументов = Справочники.КонтурЛогистика_ФайлыОбмена.ТаблицаКрайниеФайлыСоСвязаннымиДокументами(
		ДокументыСогласования, СостоянияФайлаОбмена, 1);
	
	Возврат ТаблицаКрайнихФайловДокументов.ВыгрузитьКолонку("ФайлОбмена");
	
КонецФункции

Функция ОтправитьСогласованныеФайлыВДиадок(ФайлыОбмена) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Истина;
	
	Для Каждого ФайлОбменаСсылка Из ФайлыОбмена Цикл
		
		РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
		
		Попытка
			
			ФайлОбменаОбъект = ФайлОбменаСсылка.ПолучитьОбъект();
			РезультатОтправки = ФайлОбменаОбъект.ОтправитьСогласование();
			
			Если Не РезультатОтправки.Успешно Тогда
				
				Результат.Успешно = Ложь;
				Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
				
			КонецЕсли;
			
		Исключение
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить("Не удалось отправить согласование файла обмена в Диадок "
				+ ФайлОбменаСсылка + " по причине: " + ОписаниеОшибки());
			
		КонецПопытки;
		
		// Действия после успешной отправки
		Если Не РезультатОтправки.Успешно Тогда
			Продолжить;
		КонецЕсли;
		
		Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(ФайлОбменаСсылка.ТипДокумента)
			Или Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(ФайлОбменаСсылка.ТипДокумента)
			И ЗначениеЗаполнено(ФайлОбменаСсылка.СвязанныйДокумент) Тогда
			
			Состояние = КодСостоянияДОЭРСР(ФайлОбменаСсылка.ТипДокумента, "completed");
		КонецЕсли;
		
		ДопДанные = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ОписаниеДополнительныхДанных(ФайлОбменаСсылка);
		РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ФайлОбменаСсылка.ГлавныйДокумент, Состояние,,,, ДопДанные);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтатусДОПутевойЛистПоФайлуОтправленномуИлиПолученному(Знач ФайлОбменаСсылка)
	
	Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
		Или ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		Документ = ФайлОбменаСсылка.СвязанныйДокумент;
	Иначе
		Документ = ФайлОбменаСсылка.ГлавныйДокумент;
	КонецЕсли;
	
	Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1 Тогда
		
		Если Документ.ЭтоСменаВодителя Тогда
			Состояние = "pl-wait-checkupBefore";
		Иначе
			Состояние = "pl-wait-techOrChekupBefore";
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2 Тогда
		
		Если ЗначениеЗаполнено(Документ) Тогда 
			
			Состояние = ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ2(Документ, ФайлОбменаСсылка.СвязанныйДокумент);
			
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3 Тогда
		
		Если ЗначениеЗаполнено(Документ) Тогда 
			
			Состояние = ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ3(Документ, ФайлОбменаСсылка.СвязанныйДокумент);
			
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4 Тогда
		
		Если ЗначениеЗаполнено(Документ) Тогда 
			
			Состояние = ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ4(Документ);
			
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5 Тогда
		
		Если ЗначениеЗаполнено(Документ) И Документ.ОбязМедосмотрПосле Тогда 
			
			Состояние = "pl-wait-checkupAfter";
			
		Иначе
			
			Состояние = "pl-completed";
			
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6 Тогда
		
		Состояние = "pl-completed";
		
	КонецЕсли;
	
	Если ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
					
		ТекСтатус = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ФайлОбменаСсылка.СвязанныйДокумент);
			
		Если ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-opened-sign") Тогда
			Состояние = "pl-wait-techInspection";
		Иначе
			Состояние = "pl-wait-checkupBefore";
		КонецЕсли;
				
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02 Тогда
		
		Если ЗначениеЗаполнено(Документ) Тогда 
			
			Состояние = ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ2_5_02(Документ, ФайлОбменаСсылка.СвязанныйДокумент);

		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3_5_02 Тогда
		
		Если ЗначениеЗаполнено(Документ) Тогда 
			
			Состояние = ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ3_5_02(Документ, ФайлОбменаСсылка.СвязанныйДокумент);
			
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4_5_02 Тогда
		
		Если ЗначениеЗаполнено(Документ) И Документ.ОбязМедосмотрПосле Тогда 
			
			Состояние = "pl-wait-checkupAfter";
			
		Иначе
			
			Состояние = "pl-completed";
			
		КонецЕсли;
		
	ИначеЕсли ФайлОбменаСсылка.ТипДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул5_5_02 Тогда
		
		Состояние = "pl-completed";
		
	КонецЕсли;
	
	Возврат Состояние;

КонецФункции

Функция ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ2(Знач Документ, Знач ЗначДокТ2Ссылка)
	
	Перем ВсегоВодителей, ОтправленоТ2, ТекСтатус;
	
	ТекСтатус = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Документ);
	
	Если ТекСтатус = НайтиСостояниеДОПоКоду("pl-rejected-techInspection") Тогда	// Отказ тех. контроль
		
		Состояние = "pl-rejected-techInspection";
		
	// Проверить что нет еще водителей
	ИначеЕсли ЗначДокТ2Ссылка.ЕстьОтказВПодписи
		Или Документ.ЕстьОтказВПодписи Тогда
		
		Состояние = "pl-rejected-cheсkup";
		
	ИначеЕсли Документ.ДополнительныеВодители.Количество() = 0
		И Не ЗначениеЗаполнено(Документ.Водитель2) Тогда
		
		// 1 водитель
		
		// Если тех контроль уже пройден или это смена водителя, тогда нужны показания одметра (но они могут уже быть сделаны)
		Если ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-checkupBefore")
			Или ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-odometerOrChekupBefore")
			Или Документ.ЭтоСменаВодителя Тогда
			
			ВведенныеТ3 = НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(
				Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3, Документ);
			Если ВведенныеТ3.Количество() > 0
				Или Документ.ЭтоСменаВодителя Тогда
				
				ВведенныеТ4 = НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(
					Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4, Документ);
				Если ВведенныеТ4.Количество() > 0 Тогда
					Состояние = "pl-on-the-way"; // уже есть показания одометра - можно ехать
				Иначе
					Состояние = "pl-wait-odometerBefore"; // нужен одометр
				КонецЕсли;
				
			Иначе
				
				Состояние = "pl-wait-techInspection"; // нужен техосмотр
				
			КонецЕсли;
			
		Иначе
			
			Состояние = "pl-wait-techInspection"; // нужен техосмотр
			
		КонецЕсли;
		
	Иначе
		
		ВсегоВодителей = 1 + ЗначениеЗаполнено(Документ.Водитель2) + Документ.ДополнительныеВодители.Количество();
		
		ОтправленоТ2Массив = НайтиТитулыГлавногоПоТипу(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2, Документ);
		
		Если ОтправленоТ2Массив.Количество() >= ВсегоВодителей Тогда
			
			// Если тех контроль уже пройден или это смена водителя, тогда статус показания одметра (или если показания одометра есть то можно ехать)
			Если ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-checkupBefore")
				Или ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-checkupBefore2ndDriver")
				Или ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-odometerOrChekupBefore")
				Или ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-odometerBefore")
				Или ТекСтатус = НайтиСостояниеДОПоКоду("pl-on-the-way")
				Или Документ.ЭтоСменаВодителя Тогда
				
				ВведенныеТ3 = НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(
					Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул3, Документ);
				Если ВведенныеТ3.Количество() > 0
					Или Документ.ЭтоСменаВодителя Тогда
					
					ВведенныеТ4 = НайтиОтправленныеПолученныеТитулыГлавногоПоТипу(
						Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул4, Документ);
					Если ВведенныеТ4.Количество() > 0 Тогда
						Состояние = "pl-on-the-way"; // уже есть показания одометра - можно ехать
					Иначе
						Состояние = "pl-wait-odometerBefore"; // нужен одометр
					КонецЕсли;
					
				Иначе
					
					Состояние = "pl-wait-techInspection"; // нужен техосмотр
					
				КонецЕсли;
				
			Иначе
				
				Состояние = "pl-wait-techInspection"; // нужен техосмотр
				
			КонецЕсли;
			
		Иначе // не хватает титулов медосмотра - ждем или медосмотр 2,3 водителя или еще и техосмотр
			
			Если ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-checkupBefore")
				Или ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-checkupBefore2ndDriver") Тогда
				
				Состояние = "pl-wait-checkupBefore2ndDriver";
				
			ИначеЕсли ТекСтатус = НайтиСостояниеДОПоКоду("pl-wait-techOrChekupBefore") Тогда
				
				Состояние = "pl-wait-techOrChekupBefore";
				
			Иначе
				
				Состояние = "pl-wait-checkupBefore2ndDriver";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

Функция ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ2_5_02(Знач Документ, Знач ЗначДокТ2Ссылка)
			
	Перем ВсегоВодителей, ОтправленоТ2, ТекСтатус;
	
	ТекСтатус = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Документ);
	
	Если ЗначДокТ2Ссылка.ЕстьОтказВПодписи
		Или Документ.ЕстьОтказВПодписи Тогда
		
		Состояние = "pl-rejected-cheсkup";
		
	ИначеЕсли Документ.ДополнительныеВодители.Количество() = 0
		И Не ЗначениеЗаполнено(Документ.Водитель2) Тогда
		
		// 1 водитель
		Состояние = "pl-wait-opened-sign";
				
	Иначе
		
		ВсегоВодителей = 1 + ЗначениеЗаполнено(Документ.Водитель2) + Документ.ДополнительныеВодители.Количество();
		
		ОтправленоТ2Массив = НайтиТитулыГлавногоПоТипу(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02, Документ);
		
		Если ОтправленоТ2Массив.Количество() >= ВсегоВодителей Тогда
			
			Состояние = "pl-wait-opened-sign";
			
		Иначе // не хватает титулов медосмотра - ждем или медосмотр 2,3 водителя или еще и техосмотр
			
			Состояние = "pl-wait-checkupBefore2ndDriver";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

Функция ПЛ_ПолучитьНовоеСостояниеДокументооборота_ПослеТ3(Знач Документ, ЗначДокТ3Ссылка)
	
