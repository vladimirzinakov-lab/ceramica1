			|ГДЕ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ПЛ_Титул1_5_02 КАК КонтурЛогистика_ПЛ_Титул1
			|ГДЕ
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ПЛ_Титул1.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ПЛ_Титул1.НомерПЛ УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ЗЗ_Титул1.НомЗак КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ЗЗ_Титул1 КАК КонтурЛогистика_ЗЗ_Титул1
			|ГДЕ
			|	КонтурЛогистика_ЗЗ_Титул1.НомЗак ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ЗЗ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ЗЗ_Титул1.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ЗЗ_Титул1.НомЗак УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ЭкспедиторскаяРасписка.НомерДок КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ЭкспедиторскаяРасписка КАК КонтурЛогистика_ЭкспедиторскаяРасписка
			|ГДЕ
			|	КонтурЛогистика_ЭкспедиторскаяРасписка.НомерДок ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ЭкспедиторскаяРасписка.ПометкаУдаления
			|	И КонтурЛогистика_ЭкспедиторскаяРасписка.Дата МЕЖДУ &НачДата И &КонДата
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонтурЛогистика_ЭкспедиторскаяРасписка.НомерДок УБЫВ";
	ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтурЛогистика_ПЭ_Титул1.НомДок КАК Номер
			|ИЗ
			|	Документ.КонтурЛогистика_ПЭ_Титул1 КАК КонтурЛогистика_ПЭ_Титул1
			|ГДЕ
			|	КонтурЛогистика_ПЭ_Титул1.НомДок ПОДОБНО &НомерДокумента
			|	И Не КонтурЛогистика_ПЭ_Титул1.ПометкаУдаления
