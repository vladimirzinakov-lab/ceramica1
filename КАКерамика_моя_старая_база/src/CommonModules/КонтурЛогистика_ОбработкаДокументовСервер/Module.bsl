Процедура ДобавитьОшибкуОтношенияНеУстановлены(ТаблицаОшибок, КатегорияОшибка, Орг1, Орг2)
	
	Контрагенты = Новый Массив;
	Контрагенты.Добавить(Орг1);
	Контрагенты.Добавить(Орг2);
		
	ТекстОшибки = "Между " + Орг1.Наименование + " и " + Орг2.Наименование + " не установлены отношения";
	КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", Неопределено, 
				"ФормаДружбыКонтрагентов", КатегорияОшибка, ТекстОшибки, "Настроить", , , , Контрагенты);	
	
КонецПроцедуры

Функция ПолучитьПолномочиеПоТипуЛогистическогоДокумента(ТипТитула, ТребуемоеДействие) Экспорт
	Возврат Перечисления.КонтурЛогистика_Полномочия.ПолучитьПолномочиеПоТипуЛогистическогоДокумента(ТипТитула, ТребуемоеДействие);
КонецФункции

Процедура ПроверитьПолномочияУВходящейМЧД(ФайлСсылка, ТипТитула) Экспорт
	
	Титул = ФайлСсылка.СвязанныйДокумент;
	
	МЧД = Справочники.КонтурЛогистика_МЧД.НайтиПоРеквизиту("ИдентификаторДоверенности", ФайлСсылка.ИдентификаторМЧД);
	Если МЧД.Пустая() Или Не ЗначениеЗаполнено(ФайлСсылка.Отпечаток) Или Не МЧД.ПроверятьПолномочия Тогда
		Возврат;
	КонецЕсли;
	
	Полномочие = Перечисления.КонтурЛогистика_Полномочия.ПолучитьПолномочиеПоТипуЛогистическогоДокумента(ТипТитула);
	
	Если Не РегистрыСведений.КонтурЛогистика_НастройкиПолномочийМЧД.ПроверитьПолномочияМЧД(Титул, МЧД, Полномочие, ТипТитула, ФайлСсылка.Отпечаток) Тогда
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("ТипОшибки", Перечисления.КонтурЛогистика_ТипыОшибокСтатусаТитула.ОшибкаМЧД);
		
		КодОшибки = КонтурЛогистика_МашиночитаемыеДоверенностиКлиентСервер.КодОшибкиСтатусаПолномочияМЧД();
		ОписаниеОшибки = "Проверка полномочий не пройдена";
		
		СтруктураОшибки.Вставить("КодОшибки", КодОшибки);
		СтруктураОшибки.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		СтруктураОшибки.Вставить("ПодробноеОписаниеОшибки", "Проверка полномочий не пройдена");
		
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
							Титул, Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка, , , СтруктураОшибки);
							
		ФайлОб = ФайлСсылка.ПолучитьОбъект();
		ФайлОб.ПолномочияМЧДНеПрошлиПроверку = Истина;
		ФайлОб.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументЛогистики(ДокументЛогистика, УстановитьСтатусОбработан = Ложь, БылиОшибкиПриКонвертации = Ложь) Экспорт

	Если ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1") Тогда
		ОбработатьДокументЛогистикиПЭ1(ДокументЛогистика, УстановитьСтатусОбработан, БылиОшибкиПриКонвертации);
		Возврат;
	КонецЕсли;
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументУчетнойСистемыПоТитулу(ДокументЛогистика, УстановитьСтатусОбработан, БылиОшибкиПриКонвертации);
	
	Попытка
	
		ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументЛогистика);
		
		НайденныйДокУчСист = КонтурЛогистика_ОбработкаДокументовСервер.НайтиДокументУчетнойСистемыДляТекущегоТитула(ДокументЛогистика);
		
		НастройкаКонвертации = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.ПолучитьНастройкуКонвертации(
			ТипЛогистика, ДокументЛогистика.ДокументОснование);
		
		ДокументЛогистикаОбъект = ДокументЛогистика.ПолучитьОбъект();
		ДокументУчетнойСистемы = ДокументЛогистика.ДокументОснование;
		
		Если НастройкаКонвертации <> Неопределено
			И НастройкаКонвертации.ЗапускатьКонвертациюПослеОбработкиВходящего
			И ЗначениеЗаполнено(НайденныйДокУчСист) Тогда
			
			Переменные = Неопределено; // ЗаполнитьДокументТитулПоДокументуУчетнойСистемы рассчитает их сама
			
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
				ДокументЛогистикаОбъект, НастройкаКонвертации, ДокументУчетнойСистемы, Переменные, Истина);
				
			Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				ДокументЛогистикаОбъект.ЗаполнитьИСконвертироватьТовары(НастройкаКонвертации, Переменные);
			КонецЕсли;
			
		КонецЕсли;
		
		ДокументЛогистикаОбъект.ЗаполнитьРеквизитыПоПользователю();
		ДокументЛогистикаОбъект.Записать();
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при очистке старых данных по причине: " + ОписаниеОшибки();
		Сообщение.Сообщить();	
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьДокументЛогистикиПЭ1(ДокументЛогистика, УстановитьСтатусОбработан, БылиОшибкиПриКонвертации)
	
	Запрос = Документы.КонтурЛогистика_ПЭ_Титул1.ПолучитьЗапросСпискаДокументовМаршрута(ДокументЛогистика);
	Маршруты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Для Каждого Маршрут Из Маршруты Цикл
		ОбработатьДокументЛогистики(Маршрут, УстановитьСтатусОбработан, БылиОшибкиПриКонвертации);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПодробноеОписаниеОшибки(ДокументСсылка) Экспорт
	
	Возврат РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьПодробноеОписаниеОшибки(ДокументСсылка);
	
КонецФункции

Процедура УстановитьСтатус(Документ, Статус, УказатьПользователя = Ложь, ПроверятьПоследовательностьСтатуса = Ложь, СтруктураОшибки = Неопределено) Экспорт
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Документ, Статус, УказатьПользователя, ПроверятьПоследовательностьСтатуса, СтруктураОшибки);
	
КонецПроцедуры

Процедура УстановитьПроверкаОтветаПройдена(ТитулСсылка) Экспорт
	
	Если ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
		
		ГлавныйДокумент = ТитулСсылка.Титул1;
		
		ОформитьЭТрНПослеЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОформитьЭТрНПослеЗЗ"); 
		// особенности отправки в разрезе партнеров 
		Если ЗначениеЗаполнено(ГлавныйДокумент)
			И ЗначениеЗаполнено(ГлавныйДокумент.ПартнерПеревозчик) Тогда
			
			ОформитьЭТрНПослеЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ОформитьЭТрНПослеЗЗ", ГлавныйДокумент.ПартнерПеревозчик);
			
		КонецЕсли;
		
		Если ОформитьЭТрНПослеЗЗ Тогда 
			
			// Если ТРН не введена то требуемое действие - ввести. Если введена - то завершено
			НайденнаяТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрНпоЗаказЗаявке(ГлавныйДокумент);
			Если ЗначениеЗаполнено(НайденнаяТРН) Тогда 
				Состояние = "zz-enterBasedOnConsignorAfter";
			Иначе 
				Состояние = "zz-wait-enterBasedOnConsignor";
			КонецЕсли;
		Иначе
			Состояние = "zz-completed";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка") Тогда
		
		ГлавныйДокумент = ТитулСсылка;
		
		Состояние = "fr-completed";
	
	ИначеЕсли ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_СкладскаяРасписка") Тогда
		
		ГлавныйДокумент = ТитулСсылка;
		
		Состояние = "wr-completed";
	
	ИначеЕсли ТипЗнч(ТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул2") Тогда
		
		ГлавныйДокумент = ТитулСсылка.Титул1;
		
		Состояние = "pe-completed";	
		
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(ГлавныйДокумент, Состояние,, Истина);
	
КонецПроцедуры

Функция ПоследниеПоказанияОдометра(Титул1) Экспорт
	
	Результат = 0;
	
	ТранспортноеСредство = КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(Титул1, "ТранспортноеСредство");
	СостояниеЗавершено = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pl-completed");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТранспортноеСредство", ТранспортноеСредство);
	Запрос.УстановитьПараметр("Состояние", СостояниеЗавершено);
	
	Если ТипЗнч(Титул1) = Тип("ДокументСсылка.КонтурЛогистика_ПЛ_Титул1") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтурЛогистика_ПЛ_Титул5.ПоказанияОдометра КАК ПоказанияОдометра
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул5 КАК КонтурЛогистика_ПЛ_Титул5
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул1 КАК КонтурЛогистика_ПЛ_Титул1
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
		|			ПО КонтурЛогистика_ПЛ_Титул1.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
		|		ПО КонтурЛогистика_ПЛ_Титул5.Титул1 = КонтурЛогистика_ПЛ_Титул1.Ссылка
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул1.ТранспортноеСредство = &ТранспортноеСредство
		|	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &Состояние
		|	И НЕ КонтурЛогистика_ПЛ_Титул5.ПометкаУдаления
		|	И НЕ КонтурЛогистика_ПЛ_Титул1.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтурЛогистика_ПЛ_Титул5.ДатИнфЗаезд УБЫВ,
		|	КонтурЛогистика_ПЛ_Титул5.ВрИнфЗаезд УБЫВ";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтурЛогистика_ПЛ_Титул4_5_02.ПоказанияОдометра КАК ПоказанияОдометра
		|ИЗ
		|	Документ.КонтурЛогистика_ПЛ_Титул4_5_02 КАК КонтурЛогистика_ПЛ_Титул4_5_02
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЛ_Титул1_5_02 КАК КонтурЛогистика_ПЛ_Титул1_5_02
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_ДвижениеДокументооборота.СрезПоследних КАК КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних
		|			ПО КонтурЛогистика_ПЛ_Титул1_5_02.Ссылка = КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Документ
		|		ПО КонтурЛогистика_ПЛ_Титул4_5_02.Титул1 = КонтурЛогистика_ПЛ_Титул1_5_02.Ссылка
		|ГДЕ
		|	КонтурЛогистика_ПЛ_Титул1_5_02.ТранспортноеСредство = &ТранспортноеСредство
		|	И КонтурЛогистика_ДвижениеДокументооборотаСрезПоследних.Состояние = &Состояние
		|	И НЕ КонтурЛогистика_ПЛ_Титул4_5_02.ПометкаУдаления
		|	И НЕ КонтурЛогистика_ПЛ_Титул1_5_02.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтурЛогистика_ПЛ_Титул4_5_02.ДатИнфВозвр УБЫВ,
		|	КонтурЛогистика_ПЛ_Титул4_5_02.ВрИнфВозвр УБЫВ";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ПоказанияОдометра;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ПроверкаНКДОбщихКоманд

// Контекст НКД для параметра общей команды (титул Логистики или документ учётной системы).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка
//  УточнениеТипаЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов, Неопределено
//
// Возвращаемое значение:
//  Структура:
//   * ТипЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов, Неопределено
//   * ДокументОснование - ДокументСсылка, Неопределено
//   * ЭтоДокументУчетнойСистемы - Булево
//   * КонтекстОпределен - Булево
//
Функция КонтекстПроверкиНКДДляПараметраОбщейКоманды(ДокументСсылка, УточнениеТипаЛогистика = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТипЛогистика", Неопределено);
	Результат.Вставить("ДокументОснование", Неопределено);
	Результат.Вставить("ЭтоДокументУчетнойСистемы", Ложь);
	Результат.Вставить("КонтекстОпределен", Ложь);
	
	МассивПроверки = Новый Массив;
	МассивПроверки.Добавить(ДокументСсылка);
	
	Если КонтурЛогистика_ОбщегоНазначенияСервер.ЭтоМассивДокументовУчетнойСистемы(МассивПроверки) Тогда
		
		Результат.ЭтоДокументУчетнойСистемы = Истина;
		Результат.ДокументОснование = ДокументСсылка;
		
		Если ЗначениеЗаполнено(УточнениеТипаЛогистика) Тогда
			Результат.ТипЛогистика = УточнениеТипаЛогистика;
			Результат.КонтекстОпределен = Истина;
		КонецЕсли;
		
	Иначе
		
		Результат.ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументСсылка);
		РеквизитыДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
			ДокументСсылка, "ДокументОснование");
		Результат.ДокументОснование = РеквизитыДокумента.ДокументОснование;
		Результат.КонтекстОпределен = ЗначениеЗаполнено(Результат.ТипЛогистика);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет флаги НКД Сценарий_ОтправлятьПодписанный / Сценарий_ОтправлятьНеподписанный.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка
//  ТребуетсяПодпись - Булево - Истина для ПодписатьИ*, Ложь для команд черновика.
//  УточнениеТипаЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов, Неопределено
//
// Возвращаемое значение:
//  Булево
//
Функция КомандаОтправкиРазрешенаСценариемНКД(ДокументСсылка, ТребуетсяПодпись, УточнениеТипаЛогистика = Неопределено) Экспорт
	
	КонтекстПроверки = КонтекстПроверкиНКДДляПараметраОбщейКоманды(ДокументСсылка, УточнениеТипаЛогистика);
	Возврат КомандаОтправкиРазрешенаПоКонтекстуНКД(КонтекстПроверки, ТребуетсяПодпись);
	
КонецФункции

// Отбирает элементы ПараметрКоманды, разрешённые настройками НКД для вида отправки.
//
// Параметры:
//  МассивДокументов - Массив из ДокументСсылка
//  ТребуетсяПодпись - Булево
//  УточнениеТипаЛогистика - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов, Неопределено
//  СообщатьОбОтказах - Булево
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
//
Функция ОтфильтроватьМассивДокументовКОбработкеПоНастройкамНКД(
	МассивДокументов,
	ТребуетсяПодпись,
	УточнениеТипаЛогистика = Неопределено,
	СообщатьОбОтказах = Истина) Экспорт
	
	РазрешенныеДокументы = Новый Массив;
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		КонтекстПроверки = КонтекстПроверкиНКДДляПараметраОбщейКоманды(ДокументСсылка, УточнениеТипаЛогистика);
		
		Если Не КонтекстПроверки.КонтекстОпределен Тогда
			Если СообщатьОбОтказах Тогда
				ТекстСообщения = НСтр("ru = 'Не удалось определить тип логистического документа для проверки настройки конвертации: %1'");
				Сообщить(КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(ТекстСообщения, ДокументСсылка));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если КомандаОтправкиРазрешенаПоКонтекстуНКД(КонтекстПроверки, ТребуетсяПодпись) Тогда
			РазрешенныеДокументы.Добавить(ДокументСсылка);
		ИначеЕсли СообщатьОбОтказах Тогда
			Сообщить(ТекстОтказаОбщейКомандыПоНКД(ДокументСсылка, ТребуетсяПодпись));
		Иначе
			// отказ без сообщения
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РазрешенныеДокументы;
	
КонецФункции

Функция КомандаОтправкиРазрешенаПоКонтекстуНКД(КонтекстПроверки, ТребуетсяПодпись)
	
	Если Не КонтекстПроверки.КонтекстОпределен Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТребуетсяПодпись Тогда
		Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СценарийРазрешаетОтправкуПодписанного(
			КонтекстПроверки.ТипЛогистика, КонтекстПроверки.ДокументОснование);
	КонецЕсли;
	
	Возврат Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.СценарийРазрешаетОтправкуНеподписанного(
		КонтекстПроверки.ТипЛогистика, КонтекстПроверки.ДокументОснование);
	
КонецФункции

Функция ТекстОтказаОбщейКомандыПоНКД(ДокументСсылка, ТребуетсяПодпись)
	
	Если ТребуетсяПодпись Тогда
		ШаблонСообщения = НСтр("ru = 'Отправка подписанного документа запрещена настройкой конвертации: %1'");
	Иначе
		ШаблонСообщения = НСтр("ru = 'Отправка черновика запрещена настройкой конвертации: %1'");
	КонецЕсли;
	
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок(ШаблонСообщения, ДокументСсылка);
	
КонецФункции

#КонецОбласти

#Область НастройкаСценарияПодписания

Функция ЗначениеНастройкиПодписания(ИмяЗначения)
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеПеречисления("СценарииПодписанияТитулов", ИмяЗначения);
	
КонецФункции

Функция РазбитьДокументыНаМассивыПоТипам(МассивДокументовЛогистика)
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументыТ1", 	Новый Массив);
	//Результат.Вставить("ДокументыТ2", 	Новый Массив);
	Результат.Вставить("ДокументыТ3", 	Новый Массив);
	//Результат.Вставить("ДокументыТ4", 	Новый Массив);
	//Результат.Вставить("ДокументыТ5", 	Новый Массив);
	//Результат.Вставить("ДокументыТ6", 	Новый Массив);
	//Результат.Вставить("ДокументыТ7", 	Новый Массив);
	//Результат.Вставить("ДокументыТ8", 	Новый Массив);
	Результат.Вставить("ДокументыЭР", 	Новый Массив);
	Результат.Вставить("Другие", 	Новый Массив);
	
	Для Каждого ДокументЛогистика Из МассивДокументовЛогистика Цикл
		
		// сейчас мы явно ограничены ядром в сценариях - можно подписывать из черновиков только Т1 и Т3 трн, экспедиторскую и складскую расписки
		Если ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
			Результат.ДокументыТ1.Добавить(ДокументЛогистика);
		ИначеЕсли ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул3") Тогда
			Результат.ДокументыТ3.Добавить(ДокументЛогистика);
		ИначеЕсли ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_ЭкспедиторскаяРасписка")
			Или ТипЗнч(ДокументЛогистика) = Тип("ДокументСсылка.КонтурЛогистика_СкладскаяРасписка") Тогда
			Результат.ДокументыЭР.Добавить(ДокументЛогистика);
		Иначе
			Результат.Другие.Добавить(ДокументЛогистика);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыРазрешенныеКОтправкеСценариемПодписания(МассивДокументовЛогистика) Экспорт
	
	РазрешенныеДокументы = Новый Массив;
	
	МассивыДокументовПоТитулам = РазбитьДокументыНаМассивыПоТипам(МассивДокументовЛогистика);
	
	Если МассивыДокументовПоТитулам.ДокументыТ1.Количество() > 0 Тогда 
		
		ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1;
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистическогоДокумента, МассивыДокументовПоТитулам.ДокументыТ1[0].ДокументОснование);
		
		Если Не КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
			КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				ТипЛогистическогоДокумента);
		КонецЕсли;
		
		МассивДокументовЭтогоТипа = МассивыДокументовПоТитулам.ДокументыТ1;
		
		ВычленитьРазрешенныеКОтправкеДокументыИзМассива(РазрешенныеДокументы, МассивДокументовЭтогоТипа, КонтекстНастройкиКонвертации);
		
	КонецЕсли;
	
	Если МассивыДокументовПоТитулам.ДокументыТ3.Количество() > 0 Тогда 
		
		ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3;
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистическогоДокумента, МассивыДокументовПоТитулам.ДокументыТ3[0].ДокументОснование);
		МассивДокументовЭтогоТипа = МассивыДокументовПоТитулам.ДокументыТ3;
		
		ВычленитьРазрешенныеКОтправкеДокументыИзМассива(РазрешенныеДокументы, МассивДокументовЭтогоТипа, КонтекстНастройкиКонвертации);
		
	КонецЕсли;
	
	Если МассивыДокументовПоТитулам.ДокументыЭР.Количество() > 0 Тогда 
		
		Для Каждого ТекущийДокумент Из МассивыДокументовПоТитулам.ДокументыЭР Цикл
			ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ТекущийДокумент, Истина);
			ТекКодСостоянияДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ТекущийДокумент).Код;
			ПрефиксСостояния = ПрефиксСостоянияДОЭРСРПоДокументу(ТекущийДокумент);
			Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
				Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
				Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
				Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка
				Или ТекКодСостоянияДО = ПрефиксСостояния + "-сheck-forwarder"
				Или ТекКодСостоянияДО = ПрефиксСостояния + "-сheck-cargo-owner" Тогда
				
				РазрешенныеДокументы.Добавить(ТекущийДокумент);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// другие типы титулов сейчас проверям только просто по статусу
	Для Каждого Документ Из МассивыДокументовПоТитулам.Другие Цикл 
		ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Документ, Истина);
		Если (ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
			ИЛИ ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
			ИЛИ ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
			ИЛИ ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка) Тогда
			
			// требуется ли дополнительно проверять статус документооборота?
			// кажется что здесь это может быть лишним запросом
			РазрешенныеДокументы.Добавить(Документ);
		Иначе
		
			ТекКодСостоянияДО = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(Документ).Код;
			Если Найти(ТекКодСостоянияДО, "templateReceived") Или Найти(ТекКодСостоянияДО, "pl-wait-opened-sign") Тогда
				РазрешенныеДокументы.Добавить(Документ);
			КонецЕсли;	  
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат РазрешенныеДокументы;
	
КонецФункции

Процедура ВычленитьРазрешенныеКОтправкеДокументыИзМассива(РазрешенныеДокументы, Знач МассивДокументовЭтогоТипа, Знач КонтекстНастройкиКонвертации)
	
	Для Каждого Документ Из МассивДокументовЭтогоТипа Цикл
		
		Если ДокументМожноОтправлять(Документ, КонтекстНастройкиКонвертации) Тогда
			РазрешенныеДокументы.Добавить(Документ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументМожноОтправлять(ДокументСсылка, КонтекстНастройкиКонвертации) Экспорт
	
	Если КонтекстНастройкиКонвертации = Неопределено Тогда
		ПодписьПолученногоЧерновикаРазрешена = Ложь;
		ПодписьОтправленногоЧерновикаРазрешена = Ложь;
		ПодписьВМодулеРазрешена = Ложь;
		ОтправкаНеподписанногоРазрешена = Ложь;
	Иначе
		ПодписьПолученногоЧерновикаРазрешена = КонтекстНастройкиКонвертации.Сценарий_РазрешитьПодписыватьПолученныйЧерновик;
		ПодписьОтправленногоЧерновикаРазрешена = КонтекстНастройкиКонвертации.Сценарий_РазрешитьПодписыватьПослеОтправки;
		ПодписьВМодулеРазрешена = КонтекстНастройкиКонвертации.Сценарий_ОтправлятьПодписанный;
		ОтправкаНеподписанногоРазрешена = КонтекстНастройкиКонвертации.Сценарий_ОтправлятьНеподписанный;
	КонецЕсли;
	
	СостояниеТитулаИНастройки = СостояниеТитулаИНастройки(ДокументСсылка);
	СтатусТитула = СостояниеТитулаИНастройки.СтатусТитула;
	Сценарий = СостояниеТитулаИНастройки.Сценарий;
	
	Если (СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка)
		И (ПодписьВМодулеРазрешена Или ОтправкаНеподписанногоРазрешена)Тогда
		
		// требуется ли дополнительно проверять статус документооборота?
		// кажется что здесь это может быть лишним запросом
		Возврат Истина;
		
	ИначеЕсли (СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением)
		И (ПодписьПолученногоЧерновикаРазрешена Или ОтправкаНеподписанногоРазрешена) Тогда
		
		Файл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументСсылка);
		Если Файл <> Неопределено И Не Файл.ПодписьВерна Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		Или СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
		
		Если (СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-storekeeper"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-storekeeper"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-storekeeper"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-consignor-sign"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "d-wait-consignee-sign"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "pd-wait-consignee-sign"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "zz-wait-consignor-sign"
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "pe-wait-customer-sign")
			И (Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаСогласованногоКладовщиком_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновик_СогласованиеКладовщик_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_ОтправкаПодписанного
				Или Сценарий = Перечисления.КонтурЛогистика_Сценарии.ОтправкаЧерновикаВодителю_СогласованиеКладовщик_ОтправкаПодписанного)
			И ПодписьОтправленногоЧерновикаРазрешена Тогда
			
			Файл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументСсылка);
			Если Файл <> Неопределено И Не Файл.ПодписьВерна Тогда
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ВыполнитьДействиеПоУмолчанию

Функция ИзготовитьФайлыДляОтправкиЧерновиков(МассивДокументов, ПараметрыФормированияФайловРеквизиты = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		РезультатФормирования = ДокОбъект.СформироватьФайлОбмена(ПараметрыФормированияФайловРеквизиты);
		
		Если РезультатФормирования.Успешно Тогда
			
			Для каждого текЗаявка Из РезультатФормирования.МассивФайловОбмена Цикл
				Результат.МассивФайловОбмена.Добавить(текЗаявка);
			КонецЦикла;
			
		Иначе
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормирования));
			
			// если файл не сформирован, то должна быть ошибка
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(ДокументСсылка, Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат.МассивФайловОбмена;
	
КонецФункции

Функция ВвестиДокументы(МассивДокументов, УточнениеТипаЛогистика)Экспорт
	
	РезультатВвода = ВвестиДокументыПакетно(МассивДокументов, Ложь, УточнениеТипаЛогистика);
	
	МассивДокументовЛогистика = РезультатВвода.ВведенныеДокументы;
	Возврат МассивДокументовЛогистика;
	
КонецФункции

Процедура ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика) Экспорт
	
	// Отправим файлы
	Если ТипЗнч(МассивДокументовЛогистика) = Тип("Массив")
		И МассивДокументовЛогистика.Количество() > 0 Тогда
		
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ПодготовитьДокументыКОтправке(МассивДокументовЛогистика, Истина);
		Если НЕ РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьКОтправкеПодписанные(МассивПодписанныхФайловОбмена) Экспорт
	
	МассивДокументовЛогистика = Новый Массив;
	Для Каждого ФайлОбмена Из МассивПодписанныхФайловОбмена Цикл 
		МассивДокументовЛогистика.Добавить(ФайлОбмена.СвязанныйДокумент);
	КонецЦикла;
	
	ПодготовитьКОтправкеНеподписанные(МассивДокументовЛогистика)
	
КонецПроцедуры

Функция ОтправитьФайлы(ФайлыОбмена, ИспользоватьОтправкуВФоне = Ложь) Экспорт
	
	РезультатОтправки = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Если ТипЗнч(ФайлыОбмена) <> Тип("Массив") Тогда
		Возврат РезультатОтправки;
	КонецЕсли;
	
	Если ФайлыОбмена.Количество() = 0 Тогда
		Возврат РезультатОтправки;
	КонецЕсли;
	
	Если ИспользоватьОтправкуВФоне Тогда
		
		Контекст = Новый Структура;
		Контекст.Вставить("ФайлыОбмена", ФайлыОбмена);
		
		// Добавляем в очередь
		РегистрыСведений.КонтурЛогистика_ОчередьЗаданийСценариевАвтоматическойРаботы.ДобавитьВОчередь(,
			ФайлыОбмена[0].СвязанныйДокумент, Контекст);
		
		РезультатОтправки.Успешно = Истина;
		
	Иначе
		
		// Отправим файлы
		РезультатОтправки = КонтурЛогистика_ОбработкаДокументовСервер.ОтправитьФайлыВДиадок(ФайлыОбмена);
		Если Не РезультатОтправки.Успешно Тогда
			Сообщить("Проблемы при отправке документов: "
				+ КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатОтправки));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ВвестиСледующиеДокументыТитулыПакетно(УточнениеТипаЛогистика, МассивДокументов, МассивДанныеЗаполнения) Экспорт

	РезультатВвода = КонтурЛогистика_ОбработкаДокументовСервер.ВвестиСледующиеТитулыПоПереданнымПакетно(МассивДокументов, УточнениеТипаЛогистика, Ложь, МассивДанныеЗаполнения);

	МассивДокументовЛогистика = РезультатВвода.ВведенныеДокументы;
	Возврат МассивДокументовЛогистика;

КонецФункции

Функция ВвестиДокументыПереотправка(МассивТитулов, ТипЛогистика) Экспорт
	
	МассивВведенных = Новый Массив; 
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистика);
	
	Для Каждого Титул Из МассивТитулов Цикл 
		
		КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
		
		Попытка
			
			Если ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				
				КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
					ТипЛогистика, Титул.ДокументОснование);
				Если КонтекстНастройкиКонвертации <> Неопределено И КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
					
					// Создадим и перезаполним ЭТрН
					ДокументЭТрНОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
					
					ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
						ДокументЭТрНОбъект, Титул.ДокументОснование, КонтекстНастройкиКонвертации);
					
					ДокументЭТрНОбъект.Записать();
					ДокументЭТРН = ДокументЭТрНОбъект.Ссылка;
					
					// Копируем Титул 1
					НовыйТитул = Титул.Скопировать();
					НовыйТитул.ДокументЭТРН = ДокументЭТРН;
					НовыйТитул.Записать();
					
					Состояние 			= "forwarded";
					ДобавляемыйТитул 	= НовыйТитул.Ссылка;
					ПредыдущийГлавный	= Титул.ДокументЭТРН;
					
				КонецЕсли;
				
			ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
				
				НовыйТитул = Титул.Скопировать();
				НовыйТитул.УИД_Зак = "";
				НовыйТитул.Записать();
				
				Состояние 			= "forwarded";
				ДобавляемыйТитул 	= НовыйТитул.Ссылка;
				ПредыдущийГлавный	= Титул;
				
			ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул5 Тогда
				
				Состояние 			= "completed";		
				ДобавляемыйТитул 	= Титул;
				ПредыдущийГлавный	= Титул.ДокументЭТРН;
				
			ИначеЕсли ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1
				Или ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
				
				НовыйТитул = Титул.Скопировать();
				НовыйТитул.УИД_ПЛ = "";
				НовыйТитул.Записать();
				
				Состояние 			= "forwarded";
				ДобавляемыйТитул 	= НовыйТитул.Ссылка;
				ПредыдущийГлавный	= Титул;
				
			Иначе
				
				ВызватьИсключение "Не удалось ввести переотправку по Титулу: " + Титул.Ссылка;
				
			КонецЕсли;
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
				ДобавляемыйТитул, Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ПредыдущийГлавный, Состояние);
			
			МассивВведенных.Добавить(ДобавляемыйТитул);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Не удалось ввести переотправку по Титулу: " + Титул.Ссылка + "
				|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, Титул.Ссылка, ТекстОшибки);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат МассивВведенных;
	
КонецФункции	

// Вспомогательные

Функция ДокументУспешноПодготовлен(ДокументТитул) Экспорт

	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументТитул, Истина);
	Если ТекущийСтатус = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьСледующийПоЦепочкеТипТитула(ДокументСсылка) Экспорт

	Возврат Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПолучитьСледующийПоЦепочкеТипТитулаЭТРН(ДокументСсылка.ДокументЭТРН);	

КонецФункции

Функция ПолучитьДействиеПоУмолчаниюДокУчСист(ДокументСсылка, ТипыЛогистика) Экспорт

	Если ТипыЛогистика.Количество() = 1 Тогда
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипыЛогистика[0], ДокументСсылка);
		Если КонтекстНастройкиКонвертации = Неопределено Тогда
			Сообщить("Не могу определить какой вводить тип титула из документа (не найдена настройка конвертации)");
			Возврат Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПустаяСсылка();
		Иначе
			Возврат КонтекстНастройкиКонвертации.СценарийПоУмолчанию;
		КонецЕсли;
		
	Иначе
		
		Сообщить("Не могу определить какой вводить тип титула из документа (найдено несколько)"); // TODO спросить у пользователя
		Возврат Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДействиеПоУмолчаниюДокТитул(ДокументТитулСсылка, ТипДокОснования = Неопределено) Экспорт
	
	ТипЛогистика = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ДокументТитулСсылка);
	
	КонтекстНастройкиКонвертации = КонтекстНастройкиКонвертацииДляДействияПоУмолчаниюТитула(
		ТипЛогистика, ДокументТитулСсылка, ТипДокОснования);
	
	Возврат ПолучитьТребуемоеДействиеПоДокТитулИНастройкеКонвертации(ДокументТитулСсылка, КонтекстНастройкиКонвертации);
	
КонецФункции

Функция КонтекстНастройкиКонвертацииДляДействияПоУмолчаниюТитула(
	ТипЛогистика, ДокументТитулСсылка, ТипДокОснования = Неопределено, ДокументОснование = Неопределено)
	
	Если ДокументОснование = Неопределено Тогда
		
		Попытка
			ДокументОснование = ДокументТитулСсылка.ДокументОснование;
		Исключение
			ДокументОснование = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	// Ввод вручную — нет документа учетной системы; ищем только НКД «ввод вручную» (пустой тип документа 1С)
	Если ТипДокОснования = Неопределено
		И Не ЗначениеЗаполнено(ДокументОснование) Тогда
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика, "");
		
		Если Не КонтекстНастройкиКонвертации.ЕстьНастройкаКонвертации Тогда
			УстановитьКонтекстДействияПоУмолчаниюВводВручнуюБезНКД(КонтекстНастройкиКонвертации);
		КонецЕсли;
		
		Возврат КонтекстНастройкиКонвертации;
		
	КонецЕсли;
	
	Если ТипДокОснования = Неопределено
		И Не ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1")
		И Не ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул2")
		И Не ТипЗнч(ДокументТитулСсылка) = Тип("ДокументСсылка.КонтурЛогистика_СкладскаяРасписка")
		И ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ТипДокОснования = ТипЗнч(ДокументОснование);
	КонецЕсли;
	
	ПредставлениеУчетногоДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ПредставлениеУчетногоДокументаСтрокой(
		ТипДокОснования);
	
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		ТипЛогистика, ПредставлениеУчетногоДокумента);
	Если Не КонтекстНастройкиКонвертации.ЕстьКонвертация И ЗначениеЗаполнено(ТипДокОснования) Тогда
		// поищем без указания типа документа основания
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			ТипЛогистика);
	КонецЕсли;
	
	Возврат КонтекстНастройкиКонвертации;
	
КонецФункции

Процедура УстановитьКонтекстДействияПоУмолчаниюВводВручнуюБезНКД(КонтекстНастройкиКонвертации)
	
	КонтекстНастройкиКонвертации.Сценарий = Перечисления.КонтурЛогистика_Сценарии.Отправка;
	КонтекстНастройкиКонвертации.СценарийПоУмолчанию = Перечисления.КонтурЛогистика_СценарииОтправкиТитулов.ПодписыватьОтправитьВСеансе;
	КонтекстНастройкиКонвертации.НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее;
	КонтекстНастройкиКонвертации.ЕстьКонвертация = Истина;
	
КонецПроцедуры

// Рассчитает текущее требуемое действие с титулом (будет запрошен его статус если передать)
//
// Параметры:
//  ДокументТитулСсылка	 - Любой Документ-титул подсистемы
//  КонтекстНастройкиКонвертации - необязательно - если не передан запросим 
//  СтатусТитула - необязательно - если передать, то не будем запрашивать из регистра КонтурЛогистика_СтатусыТитулов. Используйте для записи в регистр КонтурЛогистика_СтатусыТитулов нового статуса 
// 
// Возвращаемое значение:
//  ТребуемоеДействие - что сейчас требуется делать с документом.
//
Функция ПолучитьТребуемоеДействиеПоДокТитулИНастройкеКонвертации(ДокументТитулСсылка, КонтекстНастройкиКонвертации = Неопределено, СтатусТитула = Неопределено) Экспорт
	
	ТребуемоеДействие = Неопределено;
	
	// Узнаем сценарий
	Если КонтекстНастройкиКонвертации = Неопределено Тогда
		Сообщить("Не могу определить действие по умолчанию с документом (не найдена настройка конвертации)");
		Возврат ТребуемоеДействие;                               
	Иначе
		НаправлениеКонвертации = КонтекстНастройкиКонвертации.НаправлениеКонвертации;
	КонецЕсли;
	
	// Расчитаем требуемое действие по статусу ДО
	СостояниеТитулаИНастройки = СостояниеТитулаИНастройки(ДокументТитулСсылка, КонтекстНастройкиКонвертации);
	ТребуемоеДействие = ПолучитьТребуемоеДействиеПоСтатусуДО(СостояниеТитулаИНастройки);
	
	Если Не ЗначениеЗаполнено(ТребуемоеДействие) Тогда
		
		// Узнаем ТД по сценарию
		Если НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Исходящее Тогда
			
			ТребуемоеДействие = ПолучитьТребуемоеДействиеИсходящего(СостояниеТитулаИНастройки);
			
		ИначеЕсли НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.Входящее Тогда
			
			ТребуемоеДействие = ПолучитьТребуемоеДействиеВходящего(СостояниеТитулаИНастройки.СтатусТитула);
			
		ИначеЕсли НаправлениеКонвертации = Перечисления.КонтурЛогистика_НаправлениеКонвертации.ИсходящееВходящее Тогда
			
			ТребуемоеДействие = ПолучитьТребуемоеДействиеСложныйОбмен(СостояниеТитулаИНастройки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТребуемоеДействие = ТребуемоеДействиеРазрешенияРаботыСДокументамиПользователя(ТребуемоеДействие, ДокументТитулСсылка);
	
	Возврат ТребуемоеДействие;
	
КонецФункции

Функция ПолучитьТребуемоеДействиеПоСтатусуДО(Знач СостояниеТитулаИНастройки)
	
	ТребуемоеДействие = Неопределено;
	
	Если СостояниеТитулаИНастройки.КодСтатусаДО = "r-rejected"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "c-rejected"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "zz-rejected"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "pl-rejected-cheсkup"
		Или СостояниеТитулаИНастройки.КодСтатусаДО = "pl-rejected-techInspection" Тогда
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Переотправить;

	ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "zz-templateReceived" 
			Или СостояниеТитулаИНастройки.КодСтатусаДО = "pe-templateReceived"  Тогда 
		
		ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		
	ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "r-wait-storekeeper" Тогда
		
		ТребуемоеДействие = ТребуемоеДействиеПриОжиданииКладовщика(СостояниеТитулаИНастройки);
		
	КонецЕсли;
	
	Если Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоЭР(СостояниеТитулаИНастройки.ТипЛогистика) Тогда
		
		Если СостояниеТитулаИНастройки.КодСтатусаДО = "fr-сheck-forwarder" Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "fr-forwarding-cargo-owner" Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника;
		КонецЕсли;
	
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЭ(СостояниеТитулаИНастройки.ТипЛогистика) Тогда
		
		Если СостояниеТитулаИНастройки.КодСтатусаДО = "pe-completed" Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоПЛ_5_02(СостояниеТитулаИНастройки.ТипЛогистика) Тогда
		
		Если СостояниеТитулаИНастройки.ТипЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02 Тогда
		
			Если Не ЗначениеЗаполнено(СостояниеТитулаИНастройки.КодСтатусаДО)
				Или СостояниеТитулаИНастройки.КодСтатусаДО = "new" Тогда
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
			ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "pl-wait-opened-sign" Тогда
				ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭтоСР(СостояниеТитулаИНастройки.ТипЛогистика) Тогда
		
		Если СостояниеТитулаИНастройки.КодСтатусаДО = "wr-сheck-forwarder" Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
		ИначеЕсли СостояниеТитулаИНастройки.КодСтатусаДО = "wr-forwarding-cargo-owner" Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТребуемоеДействие;
	
КонецФункции

// Возвращает требуемое действие при статусе ДО r-wait-storekeeper.
// Учитывает сценарий и действие по умолчанию НКД: при отправке черновика
// не подменяет его на «Подписать и отправить». Пока титул требует обработки,
// возвращает Неопределено, чтобы сработало действие «Обработать».
//
Функция ТребуемоеДействиеПриОжиданииКладовщика(СостояниеТитулаИНастройки)
	
	ДействиеИзНКД = ТребуемоеДействиеПоСценариюПоУмолчанию(СостояниеТитулаИНастройки.СценарийПоУмолчанию);
	
	ОтправкаЧерновикаПоНКД =
		СостояниеТитулаИНастройки.Сценарий = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_Обработка_ОтправкаЧерновика
		Или ДействиеИзНКД = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
		Или ДействиеИзНКД = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик;
	
	Если Не ОтправкаЧерновикаПоНКД Тогда
		Возврат Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
	КонецЕсли;
	
	Если СостояниеТитулаИНастройки.СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДействиеИзНКД = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
		Или ДействиеИзНКД = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьВФонеЧерновик Тогда
		Возврат ДействиеИзНКД;
	КонецЕсли;
	
	Возврат Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик;
	
КонецФункции

Функция ПолучитьТребуемоеДействиеСложныйОбмен(Знач СостояниеТитулаИНастройки)
	
	Перем НайденныйВходящийФайл, ТребуемоеДействие;
	
	СтатусТитула = СостояниеТитулаИНастройки.СтатусТитула;
	СценарийРаботы = СостояниеТитулаИНастройки.Сценарий;
	
	Если СценарийРаботы = Перечисления.КонтурЛогистика_Сценарии.ЗагрузкаЧерновика_ОтправкаПодписанного Тогда
		
		Если СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан Тогда
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена;
			
		ИначеЕсли СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена 
			ИЛИ СтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
			
			ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьПодписанный;
			
