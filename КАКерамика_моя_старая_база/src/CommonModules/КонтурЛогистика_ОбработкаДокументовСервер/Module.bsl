#Область РаботаСНастройкамиКонвертации

// Поиск главного документа по документу учетной системы
//
// Параметры:
//  ДокументОснование			 - ДокументСсылка	 - Документ основания (учетный документ)
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииДокументов
//  Разделитель					 - ОпределяемыйТип.КонтурЛогистика_РазделительДокументаУчетнойСистемы	 - Разделитель одного документов на несколько
//  ДокументОбъект				 - ДокументОбъект	 - Объект текущего документа
//  Переменные					 - Структура		 - См. КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные
// 
// Возвращаемое значение:
//  ДокументСсылка - Найденный документ
//
Функция НайтиГлавныйДокументПоДокументуУчетнойСистемы(ДокументОснование, КонтекстНастройкиКонвертации, Разделитель = Неопределено, ДокументОбъект = Неопределено, Переменные = Неопределено) Экспорт
	
	ГлавныйДокумент = Неопределено;
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
		
		Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная
			Или КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
			
			// Заполним типовой частью
			ГлавныйДокумент = КонтурЛогистика_КонвертацияТиповые.НайтиГлавныйДокументПоДокументуУчетнойСистемы(
				ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект);
			
		ИначеЕсли КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Замещающая Тогда
			
			// Заполним только из НКД
			ГлавныйДокумент = НайтиЭТрН(
				ДокументОснование, КонтекстНастройкиКонвертации.НастройкаКонвертации, Разделитель, ДокументОбъект, Переменные);
			
		КонецЕсли;
		
	Иначе
		
		// Заполним типовой частью
		ГлавныйДокумент = КонтурЛогистика_КонвертацияТиповые.НайтиГлавныйДокументПоДокументуУчетнойСистемы(
			ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ДокументОбъект);
		
	КонецЕсли;
	
	Возврат ГлавныйДокумент;
	
КонецФункции

// Заполняет главный документ по документу учетной системы
//
// Параметры:
//  ГлавныйДокументОбъект		 - ДокументОбъект	 - Главный документ для заполнения
//  ДокументОснование			 - ДокументСсылка	 - Документ основания (учетный документ)
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииДокументов
//  Переменные					 - Структура		 - См. КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные
//
Процедура ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
		
		Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная
			Или КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
			
			// Заполним типовой частью
			КонтурЛогистика_КонвертацияТиповые.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
				ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
			
			// Дозаполним из НКД
			Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
				
				КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
					ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации.НастройкаКонвертации, Переменные);
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Замещающая Тогда
			
			// Заполним только из НКД
			КонтурЛогистика_КонвертацияСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
				ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации.НастройкаКонвертации, Переменные);
			
		КонецЕсли;
		
	Иначе
		
		// Заполним типовой частью
		КонтурЛогистика_КонвертацияТиповые.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
			ГлавныйДокументОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
		
	КонецЕсли;
	
	// Заполним номер и дату если пустые
	Если Не ЗначениеЗаполнено(ГлавныйДокументОбъект.Номер) Тогда
		ГлавныйДокументОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ГлавныйДокументОбъект.Дата) Тогда
		ГлавныйДокументОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

// Заполняет документ титул по документу учетной системы
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект	 - Объект текущего документа
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииДокументов
//  Переменные					 - Структура		 - См. КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные
//
Процедура ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(ДокументОбъект, Знач КонтекстНастройкиКонвертации, Переменные = Неопределено) Экспорт
	
	// Очистим ТЧ товары
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
		Или КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
		
		ДокументОбъект.Товары.Очистить();
		Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика	= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
			ДокументОбъект.СтраныПроисхожденияПродукции.Очистить();
		КонецЕсли;
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		ДокументОбъект.ТоварыДокументаУчетнойСистемы.Очистить();
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2 Тогда
		ДокументОбъект.Водители.Очистить();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
		
		Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная
			Или КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
			
			// Заполним типовой частью
			КонтурЛогистика_КонвертацияТиповые.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
				ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
			
			// Дозаполним из НКД
			Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
				
				ЗаполнитьДокументТитулПоНастройкеКонвертации(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Замещающая Тогда
			
			// Заполним только из НКД
			ЗаполнитьДокументТитулПоНастройкеКонвертации(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
			
		КонецЕсли;
		
	Иначе
		
		// Заполним типовой частью
		КонтурЛогистика_КонвертацияТиповые.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
			ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
		
	КонецЕсли;
	
	// Обработаем табличную часть товаров
	ОбработатьТабЧастьТовары(ДокументОбъект, КонтекстНастройкиКонвертации);
	
КонецПроцедуры

Процедура ЗаполнитьДокументТитулПоНастройкеКонвертации(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)
	
	// Заполнчем документ титул
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
		ДокументОбъект, КонтекстНастройкиКонвертации.НастройкаКонвертации,, Переменные);
	
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда
		
		ЗаполнитьДокументыОснованияМаршрутовПоНастройкеКонвертации(ДокументОбъект, КонтекстНастройкиКонвертации.НастройкаКонвертации);
		
	КонецЕсли;
	
	// Заполним ТЧ Товары
	Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
		
		ЗаполнитьТабЧастьТоварыДокументаТитула1(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
		
		ЗаполнитьТабЧастьТоварыДокументаТитула3(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
		
		ЗаполнитьТабЧастьТоварыДокументаЗЗ_Титул1(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
	
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
			
		ЗаполнитьТабЧастьТоварыДокументаПЭ(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);	
		
	ИначеЕсли КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка Тогда
		
		ЗаполнитьТабЧастьТоварыДокументаЭкспедиторскаяРасписка(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные);
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет ПЭ_Титул1.ДокументыОснованияМаршрутов по путям НКД
// (ИмяТЧДокументыОснования / ПутьДокументОснования) из документа учетной системы.
//
// Параметры:
//  ДокументОбъект       - ДокументОбъект.КонтурЛогистика_ПЭ_Титул1 - заполняемый титул
//  НастройкаКонвертации - СправочникСсылка.КонтурЛогистика_НастройкиКонвертацииДокументов - НКД
//
Процедура ЗаполнитьДокументыОснованияМаршрутовПоНастройкеКонвертации(ДокументОбъект, НастройкаКонвертации)
	
	ДокументУС = ДокументОбъект.ДокументОснование;
	Если Не (ЗначениеЗаполнено(НастройкаКонвертации) И ЗначениеЗаполнено(ДокументУС)) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ = СокрЛП(НастройкаКонвертации.ИмяТЧДокументыОснования);
	ПутьДокументОснования = СокрЛП(НастройкаКонвертации.ПутьДокументОснования);
	ЕстьНастройкаПутей = ЗначениеЗаполнено(ИмяТЧ) Или ЗначениеЗаполнено(ПутьДокументОснования);
	
	Если Не ЕстьНастройкаПутей Тогда
		
		// Для замещающей НКД без путей — как минимум одно основание-маршрут (сам документ УС),
		// с учётом разделителя. Для расширенной оставляем то, что уже заполнила типовая конвертация.
		Если ДокументОбъект.ДокументыОснованияМаршрутов.Количество() = 0
			И (Не ЗначениеЗаполнено(ДокументОбъект.Разделитель)
				Или ДокументОбъект.Разделитель = ДокументУС) Тогда
			ДобавитьДокументОснованияМаршрута(ДокументОбъект, ДокументУС);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	ЭтоРеквизитДокумента = Не ЗначениеЗаполнено(ИмяТЧ) Или ИмяТЧ = "<реквизит документа>"
		Или ИмяТЧ = "Реквизит документа";
	ПроизвольноеВычислениеЗначения = (ИмяТЧ = "<код на языке 1С>") И ЗначениеЗаполнено(НастройкаКонвертации.ВыражениеВычисленияДокументОснования);	
	
	Если ЭтоРеквизитДокумента Тогда
		
		ДокументОбъект.ДокументыОснованияМаршрутов.Очистить();
		
		ДокументОснованияМаршрута = ДокументУС;
		Если ЗначениеЗаполнено(ПутьДокументОснования)
			И Не ВРег(ПутьДокументОснования) = ВРег("Ссылка") Тогда
			
			ДокументОснованияМаршрута = КонтурЛогистика_КонвертацияСервер.ПолучитьЗначениеРеквизитаОбъектаПоПути(
				ДокументУС, ПутьДокументОснования);
			
		КонецЕсли;
		
		Если КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
				ДокументОснованияМаршрута, НастройкаКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
			
			ДобавитьДокументОснованияМаршрута(ДокументОбъект, ДокументОснованияМаршрута);
			
		КонецЕсли;
	
	ИначеЕсли ПроизвольноеВычислениеЗначения Тогда 
		
		ДокументОбъект.ДокументыОснованияМаршрутов.Очистить();
		
		ВыражениеВычисления = НастройкаКонвертации.ВыражениеВычисленияДокументОснования;
		
		Если ВыражениеВычисления <> Неопределено Тогда

			Параметры = Новый Структура();
			Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
			Параметры.Вставить("ДокументОснование", ДокументУС);

			ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
				ВыражениеВычисления, Параметры);
		
		КонецЕсли;
		
		Для Каждого СтрокаОснования Из ВычисленноеЗначение Цикл
	
			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
				СтрокаОснования, НастройкаКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
		
			ДобавитьДокументОснованияМаршрута(ДокументОбъект, СтрокаОснования);
		
		КонецЦикла;	

	ИначеЕсли Не ДокументУС.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
			
		ДокументОбъект.ДокументыОснованияМаршрутов.Очистить();
	
		ИмяРеквизитаВСтроке = ПутьДокументОснования;
		Если Не ЗначениеЗаполнено(ИмяРеквизитаВСтроке) Тогда
			ИмяРеквизитаВСтроке = "ДокументОснование";
		КонецЕсли;
	
		Для Каждого СтрокаОснования Из ДокументУС[ИмяТЧ] Цикл
		
			ДокументОснованияМаршрута = КонтурЛогистика_КонвертацияСервер.ПолучитьЗначениеРеквизитаОбъектаПоПути(
				СтрокаОснования, ИмяРеквизитаВСтроке);

			Если Не КонтурЛогистика_КонвертацияСервер.СтрокаТоваровПодходитПоРазделителю(
				СтрокаОснования, НастройкаКонвертации, ДокументОбъект, ДокументОбъект.Разделитель) Тогда
				Продолжить;
			КонецЕсли;
		
			ДобавитьДокументОснованияМаршрута(ДокументОбъект, ДокументОснованияМаршрута);
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Добавляет строку в ДокументыОснованияМаршрутов, если ссылка заполнена.
//
// Параметры:
//  ДокументОбъект             - ДокументОбъект.КонтурЛогистика_ПЭ_Титул1 - титул
//  ДокументОснованияМаршрута  - ОпределяемыйТип.КонтурЛогистика_ДокументыУчетнойСистемы - основание маршрута
//
Процедура ДобавитьДокументОснованияМаршрута(ДокументОбъект, ДокументОснованияМаршрута)
	
	Если Не ЗначениеЗаполнено(ДокументОснованияМаршрута) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ДокументОбъект.ДокументыОснованияМаршрутов.Добавить();
	НоваяСтрока.ДокументОснование = ДокументОснованияМаршрута;
	
КонецПроцедуры

Процедура ОбработатьТабЧастьТовары(ДокументОбъект, КонтекстНастройкиКонвертации) Экспорт
	
	ТипДокументаЛогистика = КонтекстНастройкиКонвертации.ТипДокументаЛогистика;
	Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка 
		Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут Тогда
		
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			ТоварыВременная = ДокументОбъект.ТоварыДокументаУчетнойСистемы.Выгрузить();
		Иначе
			ТоварыВременная = ДокументОбъект.Товары.Выгрузить();
		КонецЕсли;
		
		// Если не были сгенерированы при формировании
		КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТоварыВременная);
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда 
			КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТоварыВременная, ДокументОбъект);
		КонецЕсли;
		
		// Сворачиваем товары
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка
			Или ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут	Тогда
			
			Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
				Партнер = ДокументОбъект.ДокументЭТРН.ПартнерГрузополучатель;
			ИначеЕсли ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
				Партнер = ДокументОбъект.ПартнерПеревозчик;
			Иначе
				Партнер = Неопределено;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
				СворачиватьТовары = КонтекстНастройкиКонвертации.НастройкаКонвертации.СворачиватьТабЧастьТовары;
			Иначе
				СворачиватьТовары = КонтекстНастройкиКонвертации.СворачиватьТабЧастьТовары;
			КонецЕсли;
			
			Если НужноСворачиватьТовары(ТоварыВременная, Партнер, СворачиватьТовары) Тогда
				ТоварыВременная = КонтурЛогистика_КонвертацияСервер.СвернутьТовары(
						ТоварыВременная, ДокументОбъект, КонтекстНастройкиКонвертации);
			КонецЕсли;
			
		КонецЕсли;
		
		// Загружаем итоговый результат
		Если ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			ДокументОбъект.ТоварыДокументаУчетнойСистемы.Загрузить(ТоварыВременная);
		Иначе
			ДокументОбъект.Товары.Загрузить(ТоварыВременная);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Дополняет типовое заполнение ТЧ Товары значениями расширенной НКД по совпадающим идентификаторам строк.
//
// Параметры:
//  ТабличнаяЧастьТовары             - ТабличнаяЧасть - Типовое заполнение (приёмник).
//  ТоварыРасширеннойКонвертации     - ТаблицаЗначений - Результат расширенной НКД.
//  ЗаполненныеРеквизитыПоСтрокам    - Соответствие - Ключ: ИдентификаторСтроки, Значение: Массив имён явно заполненных реквизитов.
//
Процедура ДополнитьТабЧастьТоварыРасширеннойКонвертацией(ТабличнаяЧастьТовары, ТоварыРасширеннойКонвертации,
	ЗаполненныеРеквизитыПоСтрокам = Неопределено) Экспорт
	
	КоличествоСтрокВременнойТаблицы = ТоварыРасширеннойКонвертации.Количество();
	КоличествоСтрокИсходнойТаблицы = ТабличнаяЧастьТовары.Количество();
	
	Если КоличествоСтрокВременнойТаблицы = 0 Тогда
		// Оставляем только типовое заполнение
		Возврат;
	КонецЕсли;
	
	НетЗаполненныхРеквизитовРасширеннойКонвертацией = ЗаполненныеРеквизитыПоСтрокам = Неопределено
		Или ЗаполненныеРеквизитыПоСтрокам.Количество() = 0;
	
	Если НетЗаполненныхРеквизитовРасширеннойКонвертацией Тогда
		// Расширенная НКД не заполнила реквизиты — оставляем типовое заполнение
		Возврат;
	КонецЕсли;
	
	Если КоличествоСтрокИсходнойТаблицы = 0
		Или Не КоличествоСтрокИсходнойТаблицы = КоличествоСтрокВременнойТаблицы Тогда
		
		// Загружаем только кастомизированное заполнение
		ТабличнаяЧастьТовары.Загрузить(ТоварыРасширеннойКонвертации);
		Возврат;
		
	КонецЕсли;
	
	// Пустые или разные ИдентификаторСтроки — выравниваем по порядку строк и дополняем по индексу.
	СинхронизироватьИдентификаторыСтрокТоваровДляДополнения(ТабличнаяЧастьТовары, ТоварыРасширеннойКонвертации,
		ЗаполненныеРеквизитыПоСтрокам);
	
	ИсходнаяТаблица = ТабличнаяЧастьТовары.Выгрузить();
	Для Индекс = 0 По ТоварыРасширеннойКонвертации.Количество() - 1 Цикл
		
		СтрокаТоваров = ТоварыРасширеннойКонвертации[Индекс];
		НайденнаяСтрокаТоваров = ИсходнаяТаблица[Индекс];
		ИдентификаторСтроки = НайденнаяСтрокаТоваров.ИдентификаторСтроки;
		
		Для Каждого Колонка Из ТоварыРасширеннойКонвертации.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Если ИмяКолонки = "ИдентификаторСтроки" Тогда
				Продолжить;
			КонецЕсли;
			Если Не РеквизитТЧТоварыЗаполненРасширеннойКонвертацией(ИмяКолонки, ИдентификаторСтроки,
					ЗаполненныеРеквизитыПоСтрокам) Тогда
				Продолжить;
			КонецЕсли;
			НайденнаяСтрокаТоваров[ИмяКолонки] = СтрокаТоваров[ИмяКолонки];
		КонецЦикла;
		
	КонецЦикла;
	
	// Загружаем типовое заполнение, дополненное кастомизированным
	ТабличнаяЧастьТовары.Загрузить(ИсходнаяТаблица);
	
КонецПроцедуры

// Выравнивает ИдентификаторСтроки типовой и расширенной таблиц по порядку строк (после генерации GUID там, где пусто).
//
Процедура СинхронизироватьИдентификаторыСтрокТоваровДляДополнения(ТабличнаяЧастьТовары, ТоварыРасширеннойКонвертации,
	ЗаполненныеРеквизитыПоСтрокам = Неопределено)
	
	КоличествоСтрок = ТоварыРасширеннойКонвертации.Количество();
	ЗаполненныеРеквизитыПоИндексу = Новый Массив;
	
	Если ЗаполненныеРеквизитыПоСтрокам <> Неопределено Тогда
		
		Для Индекс = 0 По КоличествоСтрок - 1 Цикл
			ИдентификаторРасширеннойСтроки = ТоварыРасширеннойКонвертации[Индекс].ИдентификаторСтроки;
			ЗаполненныеРеквизитыПоИндексу.Добавить(ЗаполненныеРеквизитыПоСтрокам[ИдентификаторРасширеннойСтроки]);
		КонецЦикла;
		
	КонецЕсли;
	
	ТоварыТиповые = ТабличнаяЧастьТовары.Выгрузить();
	КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТоварыТиповые);
	КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТоварыРасширеннойКонвертации);
	
	Для Индекс = 0 По КоличествоСтрок - 1 Цикл
		
		ИдентификаторТиповойСтроки = ТоварыТиповые[Индекс].ИдентификаторСтроки;
		ТоварыРасширеннойКонвертации[Индекс].ИдентификаторСтроки = ИдентификаторТиповойСтроки;
		
	КонецЦикла;
	
	ТабличнаяЧастьТовары.Загрузить(ТоварыТиповые);
	
	Если ЗаполненныеРеквизитыПоСтрокам <> Неопределено Тогда
		
		КлючиЗаполненныхРеквизитов = Новый Массив;
		Для Каждого ЭлементЗаполненныхРеквизитов Из ЗаполненныеРеквизитыПоСтрокам Цикл
			КлючиЗаполненныхРеквизитов.Добавить(ЭлементЗаполненныхРеквизитов.Ключ);
		КонецЦикла;
		
		Для Каждого КлючЗаполненныхРеквизитов Из КлючиЗаполненныхРеквизитов Цикл
			ЗаполненныеРеквизитыПоСтрокам.Удалить(КлючЗаполненныхРеквизитов);
		КонецЦикла;
		
		Для Индекс = 0 По КоличествоСтрок - 1 Цикл
			
			ЗаполненныеРеквизиты = ЗаполненныеРеквизитыПоИндексу[Индекс];
			Если ЗаполненныеРеквизиты <> Неопределено Тогда
				ЗаполненныеРеквизитыПоСтрокам.Вставить(ТоварыТиповые[Индекс].ИдентификаторСтроки, ЗаполненныеРеквизиты);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция РеквизитТЧТоварыЗаполненРасширеннойКонвертацией(ИмяРеквизита, ИдентификаторСтроки, ЗаполненныеРеквизитыПоСтрокам)
	
	Если ЗаполненныеРеквизитыПоСтрокам = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполненныеРеквизиты = ЗаполненныеРеквизитыПоСтрокам[ИдентификаторСтроки];
	Если ЗаполненныеРеквизиты = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗаполненныеРеквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
КонецФункции

Функция ЗаполнитьВременнуюТаблицуТоваровРасширеннойНКД(ДокументОбъект, НастройкаКонвертации, Переменные, ИмяТабличнойЧасти,
	НесколькоОснований = Ложь)
	
	ТоварыВременная = ДокументОбъект[ИмяТабличнойЧасти].Выгрузить();
	ТоварыВременная.Очистить();
	ЗаполненныеРеквизитыПоСтрокам = Новый Соответствие;
	
	Если НесколькоОснований Тогда
		
		Для Каждого Элемент Из ДокументОбъект.ДокументыОснования Цикл
			КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ЗаполнитьТабЧастьТоварыПоДокументуУчетнойСистемы(
				ТоварыВременная, НастройкаКонвертации, ДокументОбъект, Элемент.ДокументОснование, Переменные, ЗаполненныеРеквизитыПоСтрокам, НесколькоОснований);
		КонецЦикла;
		
	Иначе
		КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ЗаполнитьТабЧастьТоварыПоДокументуУчетнойСистемы(
			ТоварыВременная, НастройкаКонвертации, ДокументОбъект,, Переменные, ЗаполненныеРеквизитыПоСтрокам);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТоварыВременная", ТоварыВременная);
	Результат.Вставить("ЗаполненныеРеквизитыПоСтрокам", ЗаполненныеРеквизитыПоСтрокам);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТабЧастьТоварыДокументаТитула1(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	НесколькоОснований = ДокументОбъект.ДокументыОснования.Количество() > 1;
	
	РезультатЗаполнения = ЗаполнитьВременнуюТаблицуТоваровРасширеннойНКД(
		ДокументОбъект, НастройкаКонвертации, Переменные, "Товары", НесколькоОснований);
	
	ДополнитьТабЧастьТоварыРасширеннойКонвертацией(
		ДокументОбъект.Товары, РезультатЗаполнения.ТоварыВременная, РезультатЗаполнения.ЗаполненныеРеквизитыПоСтрокам);
	
	// Заполнить способ упаковки из настроек
	СпособУпаковки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособУпаковкиПоУмолчанию");
	Для Каждого Строка Из ДокументОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(Строка.СпособУпаковки) Тогда
			Строка.СпособУпаковки = СпособУпаковки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабЧастьТоварыДокументаПЭ(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	
	РезультатЗаполнения = ЗаполнитьВременнуюТаблицуТоваровРасширеннойНКД(
		ДокументОбъект, НастройкаКонвертации, Переменные, "Товары");
	
	ДополнитьТабЧастьТоварыРасширеннойКонвертацией(
		ДокументОбъект.Товары, РезультатЗаполнения.ТоварыВременная, РезультатЗаполнения.ЗаполненныеРеквизитыПоСтрокам);
	
КонецПроцедуры

Процедура ЗаполнитьТабЧастьТоварыДокументаТитула3(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	
	РезультатЗаполнения = ЗаполнитьВременнуюТаблицуТоваровРасширеннойНКД(
		ДокументОбъект, НастройкаКонвертации, Переменные, "ТоварыДокументаУчетнойСистемы");
	
	ДополнитьТабЧастьТоварыРасширеннойКонвертацией(
		ДокументОбъект.ТоварыДокументаУчетнойСистемы, РезультатЗаполнения.ТоварыВременная,
		РезультатЗаполнения.ЗаполненныеРеквизитыПоСтрокам);
	
КонецПроцедуры

Процедура ЗаполнитьТабЧастьТоварыДокументаЗЗ_Титул1(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	НесколькоОснований = ДокументОбъект.ДокументыОснования.Количество() > 1;
	
	Если Переменные = Неопределено Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
			ДокументОбъект, ДокументОбъект.ДокументыОснования, НастройкаКонвертации, "");
	КонецЕсли;
	
	РезультатЗаполнения = ЗаполнитьВременнуюТаблицуТоваровРасширеннойНКД(
		ДокументОбъект, НастройкаКонвертации, Переменные, "Товары", НесколькоОснований);
	
	ДополнитьТабЧастьТоварыРасширеннойКонвертацией(
		ДокументОбъект.Товары, РезультатЗаполнения.ТоварыВременная, РезультатЗаполнения.ЗаполненныеРеквизитыПоСтрокам);
	
	// Заполнить метод определения массы из настроек
	МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
	Для Каждого ТекущаяСтрока Из ДокументОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.МетодОпределенияМассы) Тогда 
			ТекущаяСтрока.МетодОпределенияМассы = МетодОпределенияМассы;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабЧастьТоварыДокументаЭкспедиторскаяРасписка(ДокументОбъект, КонтекстНастройкиКонвертации, Переменные)
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	
	Если Переменные = Неопределено Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
			ДокументОбъект, ДокументОбъект.ДокументыОснования, НастройкаКонвертации, "");
	КонецЕсли;
	
	РезультатЗаполнения = ЗаполнитьВременнуюТаблицуТоваровРасширеннойНКД(
		ДокументОбъект, НастройкаКонвертации, Переменные, "Товары");
	
	ДополнитьТабЧастьТоварыРасширеннойКонвертацией(
		ДокументОбъект.Товары, РезультатЗаполнения.ТоварыВременная, РезультатЗаполнения.ЗаполненныеРеквизитыПоСтрокам);
	
	// Заполнить способ упаковки из настроек
	СпособУпаковки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособУпаковкиПоУмолчанию");
	Для Каждого ТекущаяСтрока Из ДокументОбъект.Товары Цикл 
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.СпособУпаковки) Тогда
			ТекущаяСтрока.СпособУпаковки = СпособУпаковки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Вычисляет реквизиты документа основания без конвертации
//
// Параметры:
//  ИменаРеквизитов				 - Массив			 - Имена реквизитов требуемые вычислить.
//  ДокументОбъект				 - ДокументОбъект	 - Объект текущего документа.
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииДокументов
// 
// Возвращаемое значение:
//  Структура - Вычисленные значения реквизитов.
//
Функция ВычислитьРеквизитыДокументаОснования(ИменаРеквизитов, ДокументОбъект, Знач КонтекстНастройкиКонвертации) Экспорт
	
	ЗначенияРеквизитов = Новый Структура;
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
		
		Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная
			Или КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
			
			// Заполним типовой частью
			ЗначенияРеквизитов = КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыДокументаОснования(
				ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации);
			
			// Дозаполним из НКД
			Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
				
				ЗначенияРеквизитовПоНКД = ВычислитьРеквизитыДокументаОснованияПоНКД(
					ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации);
				
				Для Каждого ТекущийЭлемент Из ЗначенияРеквизитовПоНКД Цикл
					ЗначенияРеквизитов.Вставить(ТекущийЭлемент.Ключ, ТекущийЭлемент.Значение);
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Замещающая Тогда
			
			// Заполним только из НКД
			ЗначенияРеквизитов = ВычислитьРеквизитыДокументаОснованияПоНКД(
				ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации);
			
		КонецЕсли;
		
	Иначе
		
		// Заполним типовой частью
		ЗначенияРеквизитов = КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыДокументаОснования(
			ИменаРеквизитов, ДокументОбъект, КонтекстНастройкиКонвертации);
		
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Вычисление реквизтов документа основания по НКД
//
// Параметры:
//  ИменаРеквизитов				 - Массив			 - Имена реквизитов требуемые вычислить.
//  ДокументОбъект				 - ДокументОбъект	 - Объект текущего документа.
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииДокументов
// 
// Возвращаемое значение:
//  Структура - Вычисленные значения реквизитов.
//
Функция ВычислитьРеквизитыДокументаОснованияПоНКД(ИменаРеквизитов, ДокументОбъект, Знач КонтекстНастройкиКонвертации)
	
	ЗначенияРеквизитов = Новый Структура;
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	
	Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
		ДокументОбъект, ДокументОбъект.ДокументОснование, НастройкаКонвертации, "");
	
	Для Каждого ТекущееИмяРеквизита Из ИменаРеквизитов Цикл
		
		Если КонтекстНастройкиКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1
			И ТекущееИмяРеквизита <> "Водитель"
			И ТекущееИмяРеквизита <> "Водитель2"
			И ТекущееИмяРеквизита <> "ОтправительШаблона" Тогда
			
			ТекущийОбъектДляВычисления = ДокументОбъект.ДокументЭТРН;
			НастройкаКонвертацииРеквизита = НастройкаКонвертации.ПравилаКонвертацииГлавногоДокумента.Найти(
				ТекущееИмяРеквизита, "РеквизитТитула");
		Иначе
			ТекущийОбъектДляВычисления = ДокументОбъект;
			НастройкаКонвертацииРеквизита = НастройкаКонвертации.ПравилаКонвертацииТитулаРеквизиты.Найти(
				ТекущееИмяРеквизита, "РеквизитТитула");
		КонецЕсли;
		
		
		Если НастройкаКонвертацииРеквизита = Неопределено Тогда
			// Настройка не введена
			Продолжить;
		КонецЕсли;
		
		Если НастройкаКонвертацииРеквизита.СпособМаппинга = Перечисления.КонтурЛогистика_СпособыМаппингаПоля.НеЗаполнять Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатВычисления = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьРеквизитОснования(
			ДокументОбъект.ДокументОснование, НастройкаКонвертацииРеквизита, НастройкаКонвертации,
			ТекущийОбъектДляВычисления, Ложь, Переменные);
		
		Если РезультатВычисления.Успешно Тогда
			ЗначенияРеквизитов.Вставить(ТекущееИмяРеквизита, РезультатВычисления.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Вычислить реквизиты справочника логистики по учетному объекту
//
// Параметры:
//  КонтекстНастройкиКонвертации - Структура		 - См. КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииСправочника
//  УчетныйОбъект				 - СправочникСсылка, ДокументСсылка	 - Учетный объект конвертации из которго берем данные.
//  ДокументОснование			 - ДокументСсылка	 - Контекстный документ основания из которого производится заполнение документа Логистики.
//  ДокументОбъект				 - ДокументОбъект	 - Контекстный документ в котором конвертируется реквизит.
//  Переменные					 - Структура		 - Значения переменных.
// 
// Возвращаемое значение:
//  Структура
//		* Успешно					 - Булеов - Признак успешной конвертации.
//		* ОписаниеОшибки			 - Строка - Описание ошибок.
//		* МассивОшибок				 - Массив - Ошибки конвертации.
//		* ВычисленныеРеквизиты		 - ТаблицаЗначений - См. КонтурЛогистика_КонвертацияСервер.ОписаниеТаблицыВычисленныхРеквизитов()
//
Функция ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(КонтекстНастройкиКонвертации,
																УчетныйОбъект,
																ДокументОснование = Неопределено,
																ДокументОбъект = Неопределено,
																Переменные = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("УчетныйОбъект", УчетныйОбъект);
	Параметры.Вставить("ДокументОснование", ДокументОснование);
	Параметры.Вставить("ДокументОбъект", ДокументОбъект);
	Параметры.Вставить("Переменные", Переменные);
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ВычисленныеРеквизиты", КонтурЛогистика_КонвертацияСервер.ОписаниеТаблицыВычисленныхРеквизитов());
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
		
		Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Основная
			Или КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
			
			// Заполним типовой частью
			КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(
				КонтекстНастройкиКонвертации, Параметры, Результат);
			
			// Дозаполним из НКС
			Если КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Расширенная Тогда
				
				КонтурЛогистика_КонвертацияСервер.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(
					КонтекстНастройкиКонвертации.НастройкаКонвертации, Параметры, Результат);
				
			КонецЕсли;
			
		ИначеЕсли КонтекстНастройкиКонвертации.Тип = Перечисления.КонтурЛогистика_ТипыНастроекКонвертаций.Замещающая Тогда
			
			// Заполним только из НКС
			КонтурЛогистика_КонвертацияСервер.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(
				КонтекстНастройкиКонвертации.НастройкаКонвертации, Параметры, Результат);
			
		КонецЕсли;
		
	Иначе
		
		// Заполним типовой частью
		КонтурЛогистика_КонвертацияТиповые.ВычислитьРеквизитыСправочникаЛогистикиПоУчетномуОбъекту(
			КонтекстНастройкиКонвертации, Параметры, Результат);
		
	КонецЕсли;
	
	Если Результат.МассивОшибок.Количество() = 0 Тогда
		Результат.Успешно = Истина;
	Иначе
		Результат.ОписаниеОшибки = КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(
			Результат.МассивОшибок, Символы.ПС + Символы.ПС);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

Функция НайтиДокументУчетнойСистемыДляТекущегоТитула(ТекущийТитул) Экспорт
	
	НайденныйДокументУчСист = Неопределено;
	ТипЛогистикаККоторомуИщем = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ТекущийТитул);
	
	Возврат НайтиДокументУчетнойСистемыПоТипуЛогистика(ТекущийТитул, ТипЛогистикаККоторомуИщем);
	
КонецФункции

Функция НайтиДокументУчетнойСистемыДляСледующегоТитула(ИсходныйТитул, СпецСценарий = Неопределено) Экспорт
	
	НайденныйДокументУчСист = Неопределено;
	ТипИсходногоТитула = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПолучитьТипЛогистикаПоДокументуТитулу(ИсходныйТитул);
	ТипЛогистикаККоторомуИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СледующийТипДокумента(ТипИсходногоТитула, СпецСценарий);
	
	Возврат НайтиДокументУчетнойСистемыПоТипуЛогистика(ИсходныйТитул, ТипЛогистикаККоторомуИщем, СпецСценарий);
	
КонецФункции

Функция НайтиДокументУчетнойСистемыПоТипуЛогистика(ТитулСсылка, ТипЛогистикаККоторомуИщем, СпецСценарий = Неопределено) Экспорт
	
	НайденныйДокументУчСист = Неопределено;
	
	// настройки конвертации для этого типа
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипДокументаЛогистика", ТипЛогистикаККоторомуИщем);
	Если СпецСценарий = Неопределено Тогда
		Запрос.УстановитьПараметр("СпецСценарий", Перечисления.КонтурЛогистика_СпецСценарииЗадач.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("СпецСценарий", СпецСценарий);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов КАК КонтурЛогистика_НастройкиКонвертацииДокументов
	|ГДЕ
	|	КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокументаЛогистика = &ТипДокументаЛогистика
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.ТипДокумента1С <> """"""""
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.Родитель = ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_НастройкиКонвертацииДокументов.ПустаяСсылка)
	|	И НЕ КонтурЛогистика_НастройкиКонвертацииДокументов.ПометкаУдаления
	|	И КонтурЛогистика_НастройкиКонвертацииДокументов.СпецСценарий = &СпецСценарий";
	
	Результат = Запрос.Выполнить();
	МассивНастроекКонвертацииТитула = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Для Каждого НастрокаКонвертации Из МассивНастроекКонвертацииТитула Цикл
		
		Если Не ЗначениеЗаполнено(НастрокаКонвертации.ПоискУчВариант)
			Или НастрокаКонвертации.ПоискУчВариант = Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.НеИскать Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если НастрокаКонвертации.ПоискУчВариант = Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоНомеруИДате Тогда
			НайденныйДокументУчСист = НайтиДокументУчетнойСистемыПоНастройкеКонвертации(ТитулСсылка, НастрокаКонвертации);
		ИначеЕсли НастрокаКонвертации.ПоискУчВариант = Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.ПоПрямойСвязиСТ1 Тогда
			НайденныйДокументУчСист = НайтиДокументУчетнойСистемыПоСвязиСТ1(ТитулСсылка, НастрокаКонвертации);
		ИначеЕсли НастрокаКонвертации.ПоискУчВариант = Перечисления.КонтурЛогистика_ВариантыПоискаУчетногоДокумента.СвойАлгоритм Тогда
			НайденныйДокументУчСист = НайтиДокументУчетнойСистемыСвойАлгоритм(ТитулСсылка, НастрокаКонвертации);
		Иначе
			НайденныйДокументУчСист = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденныйДокументУчСист) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НайденныйДокументУчСист;
	
КонецФункции

Функция НайтиДокументУчетнойСистемыПоНастройкеКонвертации(ТитулСсылка, НастройкаКонвертации)
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации.ТипДокумента1С) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ПМ замена механизма
	СтандартнаяОбработка = Истина;
	РезультатПМ = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
					"НайтиДокументУчетнойСистемыПоНастройкеКонвертации_ЗаменаМеханизма",
					СтандартнаяОбработка,
					Новый Структура("ТитулСсылка, НастройкаКонвертации", ТитулСсылка, НастройкаКонвертации));
					
	Если СтандартнаяОбработка = Ложь Тогда 
		Возврат РезультатПМ;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкаКонвертации.ПутьОрганизация) Тогда
		Сообщить("В настройке конвертации " + НастройкаКонвертации + " не задано ПутьОрганизация не могу сопоставить документ учетной системы титула для " + ТитулСсылка);
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НастройкаКонвертации.ПутьПоискУчДокНомер) Тогда 
		Сообщить("В настройке конвертации " + НастройкаКонвертации + " не задано ПутьПоискУчДокНомер не могу сопоставить документ учетной системы титула для " + ТитулСсылка);
		Возврат Неопределено;
	КонецЕсли;
	
	ГлавныйДокумент = ОпределитьГлавныйДокументПоТитулу(ТитулСсылка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_Вспомогательный.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_Вспомогательный КАК КонтурЛогистика_Вспомогательный
	               |ГДЕ
	               |	КонтурЛогистика_Вспомогательный.ИмяРеквизитаПоискаНомер ПОДОБНО &Номер
	               |	И (&НетДаты
	               |			ИЛИ НАЧАЛОПЕРИОДА(КонтурЛогистика_Вспомогательный.ИмяРеквизитаПоискаДата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ))
	               |	И КонтурЛогистика_Вспомогательный.ИмяРеквизитаОрганизация В(&Организации)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КонтурЛогистика_Вспомогательный", НастройкаКонвертации.ТипДокумента1С);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяРеквизитаПоискаНомер", НастройкаКонвертации.ПутьПоискУчДокНомер);
	
	Если ЗначениеЗаполнено(НастройкаКонвертации.ПутьПоискУчДокДата) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяРеквизитаПоискаДата", НастройкаКонвертации.ПутьПоискУчДокДата);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяРеквизитаПоискаДата", "Дата");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяРеквизитаОрганизация", НастройкаКонвертации.ПутьОрганизация);
	
	Запрос.УстановитьПараметр("НетДаты", Не ЗначениеЗаполнено(НастройкаКонвертации.ПутьПоискУчДокДата));
	
	Если ЭтоТитулТрн(ТитулСсылка) Тогда
		
		ПоискПоНомеру 	= ГлавныйДокумент.НомерТрН;
		ПоискПоДате		= ГлавныйДокумент.ДатаТрН;
		
		Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			Организации = ГлавныйДокумент.Грузоотправитель.СвязанныеОбъекты.Выгрузить().ВыгрузитьКолонку("СвязанныйОбъект");
		ИначеЕсли НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3 Тогда
			Организации = ГлавныйДокумент.Грузополучатель.СвязанныеОбъекты.Выгрузить().ВыгрузитьКолонку("СвязанныйОбъект");
		Иначе			
			Организации = ГлавныйДокумент.Перевозчик.СвязанныеОбъекты.Выгрузить().ВыгрузитьКолонку("СвязанныйОбъект");
		КонецЕсли;
		
	ИначеЕсли ЭтоТитулЗЗ(ТитулСсылка) Тогда 	
		
		ПоискПоНомеру 	= ГлавныйДокумент.НомЗак;
		ПоискПоДате		= ГлавныйДокумент.ДатаЗак;
		
		Если НастройкаКонвертации.ТипДокументаЛогистика = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1 Тогда
			Организации = ГлавныйДокумент.Грузоотправитель.СвязанныеОбъекты.Выгрузить().ВыгрузитьКолонку("СвязанныйОбъект");
		Иначе			
			Организации = ГлавныйДокумент.Перевозчик.СвязанныеОбъекты.Выгрузить().ВыгрузитьКолонку("СвязанныйОбъект");
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "Не реализован поиск учетного документа для титула: " + ТитулСсылка;
		
	КонецЕсли;	
			
	Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеНастройки("Т3ПоискПоНомеруТРНСУчетомЛидиующихНулей") = Истина Тогда 
		ПоискПоНомеру = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(ПоискПоНомеру);
		ПоискПоНомеру = "%" + ПоискПоНомеру;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Номер", ПоискПоНомеру);
	Запрос.УстановитьПараметр("Дата", ПоискПоДате);
	Запрос.УстановитьПараметр("Организации", Организации);
	
	// ПМ замена текста запроса
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"НайтиДокументУчетнойСистемыПоНастройкеКонвертации_ЗаменаТекстаЗапроса",
		Истина,
		Новый Структура("Запрос, ГлавныйДокумент, НастройкаКонвертации", Запрос, ГлавныйДокумент, НастройкаКонвертации));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	// отладка Результат.Выгрузить()
	
	НайденоПодходящихДокументов = Выборка.Количество();
	
	Если НайденоПодходящихДокументов = 1 Тогда
		
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
		
	ИначеЕсли НайденоПодходящихДокументов = 0 Тогда
		
		Возврат Неопределено;
		
	Иначе // более 1
		
		МассивНайденныхДокументов = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		СтокаДокументов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(МассивНайденныхДокументов);
		Сообщить("По настройке конвертации " + НастройкаКонвертации + " найдено " + НайденоПодходящихДокументов + " документов учетной системы: " +
		СтокаДокументов + ". Не могу определить какой выбрать. Укажите основание вручную.");
		
	КонецЕсли;
	
КонецФункции

Функция НайтиДокументУчетнойСистемыПоСвязиСТ1(ТитулСсылка, НастройкаКонвертации)
	
	НайденныйДокУч = Неопределено;
	
	ГлавныйДокумент = ОпределитьГлавныйДокументПоТитулу(ТитулСсылка);	
	
	Если КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулТрн(ТитулСсылка) Тогда
		НайденныйТ1 	=  КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ГлавныйДокумент);
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулЗН(ТитулСсылка) Тогда 
		НайденныйТ1 	=  КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗН_Титул1, ГлавныйДокумент);
	ИначеЕсли КонтурЛогистика_ОбработкаДокументовСервер.ЭтоТитулСВ(ТитулСсылка) Тогда 
		НайденныйТ1 	=  КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.СВ_Титул1, ГлавныйДокумент);
	Иначе // путевой, заказ-заявка и договорф фрахтования - главный и есть Т1
		НайденныйТ1 = ГлавныйДокумент;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныйТ1) Тогда
		ВызватьИсключение "Не найден Т1 в цепочке по ЭТРН: " + ГлавныйДокумент;
	КонецЕсли;
			
	Попытка
		НайденныйДокУч = НайденныйТ1[НастройкаКонвертации.ПутьПоискУчДокСвязь];
	Исключение
		ВызватьИсключение "Поиск учетного документа по связи с Т1. Не верно указан путь к документу-основнию: " + НастройкаКонвертации.ПутьПоискУчДокСвязь + "
		| Ошибка: " + ОписаниеОшибки();
	КонецПопытки;	
	
	Возврат НайденныйДокУч;
	
КонецФункции

Функция НайтиДокументУчетнойСистемыСвойАлгоритм(Объект, НастройкаКонвертации)
	
	ВычисленноеЗначение = Неопределено;
	
	Если ЗначениеЗаполнено(НастройкаКонвертации.ПутьПоискУчСвойАлгоритм) Тогда 
		
		ВыражениеВычисления = НастройкаКонвертации.ПутьПоискУчСвойАлгоритм;
		РезультатВычисления = Неопределено;
		
		Попытка
			
			Параметры = Новый Структура;
			Параметры.Вставить("Объект", Объект);
			Параметры.Вставить("НастройкаКонвертации", НастройкаКонвертации);
			
			ВычисленноеЗначение = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
				ВыражениеВычисления, Параметры);
			
		Исключение	
			
			Сообщить("Не удалось вычислить выражение вычисления для нахождения документа учетной системы. Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;	
		
	КонецЕсли;
	
	Возврат ВычисленноеЗначение;
	
КонецФункции	

// Функция - Найти все титулы
//
// Параметры:
//  ДокументЭТРНИлиМассивЭТрН - ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная, Массив - По каким ЭТРН 
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица найденных титулов по ЭТрН
//
Функция НайтиВсеТитулы(ДокументЭТРНИлиМассивЭТрН) Экспорт 

	Запрос = Новый Запрос;
	
	ПоследнийНомерТитула = 8;
	ТекстЗапроса = "";
	
	Для Сч = 1 По ПоследнийНомерТитула Цикл 
		
		ТекстПодзапроса = 
		"ВЫБРАТЬ
		|	КонтурЛогистика_ТрН_Титул.Ссылка,
		|	КонтурЛогистика_ТрН_Титул.ДокументЭТРН
		|ИЗ
		|	Документ.КонтурЛогистика_ТрН_Титул" + Строка(Сч) + " КАК КонтурЛогистика_ТрН_Титул
		|ГДЕ
		|	КонтурЛогистика_ТрН_Титул.ДокументЭТРН В (&ДокументыЭТРН)";
				
		ТекстЗапроса = ТекстЗапроса + ТекстПодзапроса;
		
		Если Не Сч = ПоследнийНомерТитула Тогда 
			
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументыЭТРН", ДокументЭТРНИлиМассивЭТрН);
	
	Возврат Запрос.Выполнить().Выгрузить();	

КонецФункции 


// Функция - Найти титул  возвращает нужный титул по документу ЭТРН
//
// Параметры:
//  ТипЛогистическогоДокументаКоторыйИщем	 - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - какой титул ищем
//  ДокументЭТРН							 - ДокументСсылка.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная - По какому ЭТРН
// 
// Возвращаемое значение:
//  ДокументСсылка - первый найденный документ титул или пустая ссылка этого типа
//
Функция НайтиТитул(ТипЛогистическогоДокументаКоторыйИщем, ГлавныйДокумент, ФайлСсылка = Неопределено) Экспорт
	
	Титулы = НайтиТитулыГлавногоПоТипу(ТипЛогистическогоДокументаКоторыйИщем, ГлавныйДокумент);
	
	Если Титулы.Количество() > 0 Тогда
		
		Если (ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2
			Или ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул2_5_02)
			И ЗначениеЗаполнено(ГлавныйДокумент.Водитель2) Тогда
			
			Если ЗначениеЗаполнено(ФайлСсылка) Тогда
				Титул = НайтиПЛТитул2ПоВодителю(Титулы, ФайлСсылка);
			Иначе
				Возврат Титулы;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Титул) Тогда
				Возврат Титул;
			Иначе
				Возврат Документы.КонтурЛогистика_ПЛ_Титул2.ПустаяСсылка();
			КонецЕсли;
			
		ИначеЕсли ТипЛогистическогоДокументаКоторыйИщем = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул6
			И ЗначениеЗаполнено(ГлавныйДокумент.Водитель2) Тогда
			
			Титул = НайтиПЛТитул6ПоВодителю(Титулы, ФайлСсылка);
			
			Если ЗначениеЗаполнено(Титул) Тогда
				Возврат Титул;
			Иначе
				Возврат Документы.КонтурЛогистика_ПЛ_Титул6.ПустаяСсылка();
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ФайлСсылка) Тогда
			
			Возврат НайтиТитул3Или4ПоВходящемуФайлу(
				ТипЛогистическогоДокументаКоторыйИщем,
				ГлавныйДокумент,
				Титулы,
				ФайлСсылка);
			
		Иначе
			
			Возврат Титулы[0];
			
		КонецЕсли;
		
	Иначе
		
		ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистическогоДокументаКоторыйИщем);
		Возврат Документы["КонтурЛогистика_" + ИмяТитула].ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

// Возвращает признак, что найденный по указателю на предыдущий файл титул
// нужно переиспользовать, а не создавать новый документ после переадресации.
//
// Параметры:
//  ЭтоИсправление         - Булево - Истина, если во входящем XML указан номер исправления
//  РеквизитыТитула7       - Структура, Неопределено - АдрВыгруз и НовГрузПол; Неопределено, если Т7 нет
//  РеквизитыТитула        - Структура - Грузополучатель; для Т3 также МестоВыгрузки
//  ПроверятьМестоВыгрузки - Булево - Истина для Т3, Ложь для Т4
//
// Возвращаемое значение:
//  Булево
//
Функция ИспользоватьСуществующийТитулПослеПереадресации(
	ЭтоИсправление,
	РеквизитыТитула7,
	РеквизитыТитула,
	ПроверятьМестоВыгрузки) Экспорт
	
	Если ЭтоИсправление Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если РеквизитыТитула7 = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если РеквизитыТитула.Грузополучатель <> РеквизитыТитула7.НовГрузПол Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПроверятьМестоВыгрузки
		И РеквизитыТитула.МестоВыгрузки <> РеквизитыТитула7.АдрВыгруз Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Ищет Т3 или Т4 по входящему файлу обмена. Сверяет указатель на предыдущий файл
// и при наличии Т7 - место выгрузки и грузополучателя переадресации.
//
Функция НайтиТитул3Или4ПоВходящемуФайлу(ТипЛогистическогоДокументаКоторыйИщем, ГлавныйДокумент, Титулы, ФайлСсылка)
	
	ЭтоТитул3 = (ТипЛогистическогоДокументаКоторыйИщем
		= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул3);
	ЭтоТитул4 = (ТипЛогистическогоДокументаКоторыйИщем
		= Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул4);
	
	Если Не ЭтоТитул3 И Не ЭтоТитул4 Тогда
		Возврат Титулы[0];
	КонецЕсли;
	
	Если ЭтоТитул3 Тогда
		ИмяИдФайлИнф = "ИдФайлИнфПрвПрием";
		ПутьНомИспр  = "Документ.СодИнфГП.ИспрТрН.НомИспр";
	Иначе
		ИмяИдФайлИнф = "ИдФайлИнфГП";
		ПутьНомИспр  = "Документ.СодПрвВыд.ИспрТрН.НомИспр";
	КонецЕсли;
	
	РеквизитыФайла = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(ФайлСсылка, "ТекстXML");
	ТекстФайла = РеквизитыФайла.ТекстXML.Получить();
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
	
	ПутьДоИД = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("Документ.%1.%2", СтрЗаменить(ИмяИдФайлИнф, "Файл", ""), ИмяИдФайлИнф);
	ИдФайлИнф = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, ПутьДоИД);
	ЭтоИсправление = КонтурЛогистика_КонструкторыXDTO.XDTO_ВычислитьЧисло(XDTO, ПутьНомИспр) > 0;
	
	ИменаРеквизитовТитула = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1, Грузополучатель", ИмяИдФайлИнф);
	Если ЭтоТитул3 Тогда
		ИменаРеквизитовТитула = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("%1, МестоВыгрузки", ИменаРеквизитовТитула);
	КонецЕсли;
	РеквизитыТитулов = КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектовЛок(Титулы, ИменаРеквизитовТитула);
	
	РеквизитыТитула7 = РеквизитыТитула7ДляСверки(ГлавныйДокумент);
	
	Для Каждого Титул Из Титулы Цикл
		
		РеквизитыТитула = РеквизитыТитулов.Получить(Титул);
		Если РеквизитыТитула = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если РеквизитыТитула[ИмяИдФайлИнф] <> ИдФайлИнф Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ИспользоватьСуществующийТитулПослеПереадресации(
			ЭтоИсправление,
			РеквизитыТитула7,
			РеквизитыТитула,
			ЭтоТитул3) Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Титул;
		
	КонецЦикла;
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(
		ТипЛогистическогоДокументаКоторыйИщем);
	Возврат Документы[КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("КонтурЛогистика_%1", ИмяТитула)].ПустаяСсылка();
	
КонецФункции

// Возвращает реквизиты последнего Т7 по ЭТрН или Неопределено, если переадресации не было.
//
Функция РеквизитыТитула7ДляСверки(ГлавныйДокумент)
	
	Титулы7 = НайтиТитулыГлавногоПоТипу(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул7,
		ГлавныйДокумент);
	
	Если Титулы7.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат КонтурЛогистика_СтдОбщегоНазначения.ЗначенияРеквизитовОбъектаЛок(
		Титулы7[0],
		"АдрВыгруз, НовГрузПол");
	
КонецФункции

Функция НайтиТитулыПоДокументамОснованиям(Знач ТипЛогистическогоДокументаКоторыйИщем, Знач ДокументыОснования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурЛогистика_ТрН_Титул1.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.КонтурЛогистика_ТрН_Титул1 КАК КонтурЛогистика_ТрН_Титул1
	               |ГДЕ
	               |	КонтурЛогистика_ТрН_Титул1.ДокументОснование В(&ДокументыОснования)
	               |	И НЕ КонтурЛогистика_ТрН_Титул1.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтурЛогистика_ТрН_Титул1.Дата УБЫВ";
	
	ИмяТитула = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПолучитьИмяСсылки(ТипЛогистическогоДокументаКоторыйИщем);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТрН_Титул1", ИмяТитула);
	
	Запрос.УстановитьПараметр("ДокументыОснования", ДокументыОснования);
	
	Результат = Запрос.Выполнить();
	
	Возврат  Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции


Функция НайтиПЛТитул2ПоВодителю(Титулы, ФайлСсылка)
	
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ФайлСсылка.ТекстXML.Получить());
	СодИнфМО = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "Документ.СодИнфМО");
	СвВодит_XDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СодИнфМО, "СвМОПред.СвВодит");
	
	Фамилия = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СвВодит_XDTO, "ФИО.Фамилия");
	Имя = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СвВодит_XDTO, "ФИО.Имя");
	Отчество = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СвВодит_XDTO, "ФИО.Отчество");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титулы", Титулы);
	Запрос.УстановитьПараметр("Фамилия", Фамилия);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Отчество", Отчество);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул2.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул2 КАК КонтурЛогистика_ПЛ_Титул2
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул2.Ссылка В(&Титулы)
	|	И КонтурЛогистика_ПЛ_Титул2.Водитель.Фамилия = &Фамилия
	|	И КонтурЛогистика_ПЛ_Титул2.Водитель.Имя = &Имя";
	
	Если ЗначениеЗаполнено(Отчество) Тогда
		Запрос.Текст = Запрос.Текст + " И КонтурЛогистика_ПЛ_Титул2.Водитель.Отчество = &Отчество";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат Документы.КонтурЛогистика_ПЛ_Титул2.ПустаяСсылка();
	
КонецФункции

Функция НайтиПЛТитул6ПоВодителю(Титулы, ФайлСсылка)
	
	XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ФайлСсылка.ТекстXML.Получить());
	СодИнфМО = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(XDTO, "Документ.СодИнфМО");
	СвВодит_XDTO = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СодИнфМО, "СвМОПосл.СвВодит");
	
	Фамилия = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СвВодит_XDTO, "ФИО.Фамилия");
	Имя = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СвВодит_XDTO, "ФИО.Имя");
	Отчество = КонтурЛогистика_КонструкторыXDTO.XDTO_Вычислить(СвВодит_XDTO, "ФИО.Отчество");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Титулы", Титулы);
	Запрос.УстановитьПараметр("Фамилия", Фамилия);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Отчество", Отчество);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЛ_Титул6.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ПЛ_Титул6 КАК КонтурЛогистика_ПЛ_Титул6
	|ГДЕ
	|	КонтурЛогистика_ПЛ_Титул6.Ссылка В(&Титулы)
	|	И КонтурЛогистика_ПЛ_Титул6.Водитель.Фамилия = &Фамилия
	|	И КонтурЛогистика_ПЛ_Титул6.Водитель.Имя = &Имя";
	
	Если ЗначениеЗаполнено(Отчество) Тогда
