#Область СлужебныйПрограммныйИнтерфейс

Функция СостояниеЭПДДерево(МассивДокументовУчетнойСистемы) Экспорт
	
	РезультатДерево = Новый ДеревоЗначений;
	РезультатДерево.Колонки.Добавить("ДокументОснование");
	РезультатДерево.Колонки.Добавить("ДокументОснованиеЭПД");
	РезультатДерево.Колонки.Добавить("ДокументЭПД");
	РезультатДерево.Колонки.Добавить("ТипЭПД");
	РезультатДерево.Колонки.Добавить("ТипУчетногоДляВводаЭПД");
	РезультатДерево.Колонки.Добавить("Статус");
	РезультатДерево.Колонки.Добавить("ТребуемоеДействие");
	РезультатДерево.Колонки.Добавить("ГрузоотправительНаш");
	РезультатДерево.Колонки.Добавить("ПеревозчикНаш");
	РезультатДерево.Колонки.Добавить("ГрузополучательНаш");
	РезультатДерево.Колонки.Добавить("МедикНаш");
	
	// 1. Понимаем учетные документы соответствующие переданному
	текМассивДокументовУчетнойСистемы = КонтурЛогистика_СтдКоллекцииКлиентСервер.СвернутьМассивЛок(МассивДокументовУчетнойСистемы);
	ТаблицаДокументовУчетнойСистемыДляЭПД = НайтиСоотвУчетныеДокументы(текМассивДокументовУчетнойСистемы);
	
	// 2. Спрашиваем подсистему какие оформлены документы и какие у них статусы
	МассивДокументовУчетнойСистемыДляЭПД = КонтурЛогистика_СтдКоллекцииКлиентСервер.СвернутьМассивЛок(
		ТаблицаДокументовУчетнойСистемыДляЭПД.ВыгрузитьКолонку("ДокументОснованиеЭПД"));
	
	Если ТаблицаДокументовУчетнойСистемыДляЭПД.Количество() > 0 Тогда
		
		Запрос = СформироватьТекстЗапросаСвязанныхЭПДпоУчДок(МассивДокументовУчетнойСистемыДляЭПД);
		РезультатЗапроса = Запрос.Выполнить();
		ОбщаяТаблица = РезультатЗапроса.Выгрузить();
		
		Для Каждого текДокОснование Из текМассивДокументовУчетнойСистемы Цикл
			
			НайденныеСтрокиДокОснЭПД = ТаблицаДокументовУчетнойСистемыДляЭПД.НайтиСтроки(Новый Структура("ДокументОснование", текДокОснование));
			
			Если НайденныеСтрокиДокОснЭПД.Количество() > 0 Тогда
				
				СтрокаДокОсн = РезультатДерево.Строки.Добавить();
				СтрокаДокОсн.ДокументОснование = текДокОснование;
				
				Для Каждого НайденнаяСтрокаДокОснЭПД Из НайденныеСтрокиДокОснЭПД Цикл
					
					ДокументОснованиеЭПД = НайденнаяСтрокаДокОснЭПД.ДокументОснованиеЭПД;
					
					ИспользуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН");
					КонтекстЭТрН = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
						Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументОснованиеЭПД);
					
					ИспользуетсяЗаказЗаявка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка");
					КонтекстЭЗЗ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
						Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, ДокументОснованиеЭПД);
					
					ИспользуетсяПутевойЛист = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист");
					КонтекстЭПЛ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
						Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1, ДокументОснованиеЭПД);
					
					ИспользуетсяПутевойЛист_5_02 = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПутевойЛист_5_02");
					КонтекстЭПЛ_5_02 = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
						Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЛ_Титул1_5_02, ДокументОснованиеЭПД);
					
					ИспользуетсяПоручениеЭкспедитору = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПоручениеЭкспедитору");
					КонтекстЭПЭ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
						Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1, ДокументОснованиеЭПД);
					
					ТребуетсяТРН = ИспользуетсяТРН И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭТрН);
					ТребуетсяЗЗ = ИспользуетсяЗаказЗаявка И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭЗЗ);
					ТребуетсяПЛ = ИспользуетсяПутевойЛист И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭПЛ);
					ТребуетсяПЛ_5_02 = ИспользуетсяПутевойЛист_5_02 И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭПЛ_5_02);
					ТребуетсяПЭ = ИспользуетсяПоручениеЭкспедитору И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭПЭ);
					
					Если СтрокаДокОсн.ДокументОснование = НайденнаяСтрокаДокОснЭПД.ДокументОснованиеЭПД Тогда
						СтрокаДокОснЭПД = СтрокаДокОсн;
					Иначе
						СтрокаДокОснЭПД = СтрокаДокОсн.Строки.Добавить();
					КонецЕсли;
					СтрокаДокОснЭПД.ДокументОснованиеЭПД = НайденнаяСтрокаДокОснЭПД.ДокументОснованиеЭПД;
					
					ПараметрыОтбора = Новый Структура("ДокументОснованиеЭПД", СтрокаДокОснЭПД.ДокументОснованиеЭПД);
					НайденныеСтрокиЭПД = ОбщаяТаблица.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтрокиЭПД.Количество() > 0 Тогда
						
						Для Каждого НайденнаяСтрокаЭПД Из НайденныеСтрокиЭПД Цикл
							
							СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
							СтрокаЭПД.ДокументЭПД = НайденнаяСтрокаЭПД.Ссылка;
							СтрокаЭПД.ТипЭПД = НайденнаяСтрокаЭПД.Тип;
							СтрокаЭПД.Статус = НайденнаяСтрокаЭПД.Состояние;
							СтрокаЭПД.ТребуемоеДействие = ОпределитьТребуемоеДействие(
								СтрокаЭПД.ДокументЭПД, НайденнаяСтрокаЭПД.Состояние, НайденнаяСтрокаЭПД);
							
							Если СтрокаЭПД.ТипЭПД = ПредставлениеЗЗ() Тогда
								ТребуетсяЗЗ = Ложь;
								ТребуетсяПЭ = Ложь;
							ИначеЕсли СтрокаЭПД.ТипЭПД = ПредставлениеТРН() Тогда
								ТребуетсяТРН = Ложь;
								ТребуетсяПЭ = Ложь;
							ИначеЕсли СтрокаЭПД.ТипЭПД = ПредставлениеПЭ() Тогда
								ТребуетсяПЭ = Ложь;
								ТребуетсяТРН = Ложь;
								ТребуетсяЗЗ = Ложь;
							ИначеЕсли СтрокаЭПД.ТипЭПД = ПредставлениеПЛ() Тогда
								ТребуетсяПЛ = Ложь;
							ИначеЕсли СтрокаЭПД.ТипЭПД = ПредставлениеПЛ_5_02() Тогда
								ТребуетсяПЛ_5_02 = Ложь;
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
					Если ТребуетсяЗЗ Тогда
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = ПредставлениеЗЗ();
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					Если ТребуетсяТРН Тогда
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = ПредставлениеТРН();
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					Если ТребуетсяПЭ Тогда
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = ПредставлениеПЭ();
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					Если ТребуетсяПЛ Тогда
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = ПредставлениеПЛ();
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					Если ТребуетсяПЛ_5_02 Тогда
						СтрокаЭПД = СтрокаДокОснЭПД.Строки.Добавить();
						СтрокаЭПД.ТипЭПД = ПредставлениеПЛ_5_02();
						СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				ТипУчетногоДляВводаЭПД = КакойПромежуточныйДокументТребуетсяДляЭПД(текДокОснование);
				Если ТипУчетногоДляВводаЭПД <> "" Тогда
					
					СтрокаДокОсн = РезультатДерево.Строки.Добавить();
					СтрокаДокОсн.ДокументОснование = текДокОснование;
					СтрокаДокОсн.ТипУчетногоДляВводаЭПД = ТипУчетногоДляВводаЭПД; 
					СтрокаДокОсн.ТребуемоеДействие = "Ввести док. основание для ЭПД";
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		//требуется ввод док уч сист - основания для ЭПД
		Для Каждого текДокОснование Из текМассивДокументовУчетнойСистемы Цикл 
			
			ТипУчетногоДляВводаЭПД = КакойПромежуточныйДокументТребуетсяДляЭПД(текДокОснование);
			Если ТипУчетногоДляВводаЭПД <> "" Тогда
				
				СтрокаДокОсн = РезультатДерево.Строки.Добавить();
				СтрокаДокОсн.ДокументОснование = текДокОснование;
				СтрокаДокОсн.ТипУчетногоДляВводаЭПД = ТипУчетногоДляВводаЭПД;
				СтрокаДокОсн.ТребуемоеДействие = "Ввести док. основание для ЭПД";
				
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Возврат РезультатДерево;
	
КонецФункции

Функция НайтиСоотвУчетныеДокументы(Знач МассивДокументовУчетнойСистемы) Экспорт
	
	ТаблицаДокументовУчетнойСистемыДляЭПД = Новый ТаблицаЗначений;
	ТаблицаДокументовУчетнойСистемыДляЭПД.Колонки.Добавить("ДокументОснование");
	ТаблицаДокументовУчетнойСистемыДляЭПД.Колонки.Добавить("ДокументОснованиеЭПД");

	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Если ИмяКонфигурации = "УФ_БП"
		Или ИмяКонфигурации = "БП" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УФ_УТ"
		Или ИмяКонфигурации = "ERP"
		Или ИмяКонфигурации = "КА_2"
		Или ИмяКонфигурации = "КЛ" Тогда
		
		ЗаполнитьСоответствиеДокументовУчетнойСистемыДляЭПДСРазделениемОснований(
			МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УФ_УНФ" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УАТ_ПРОФ"
		Или ИмяКонфигурации = "УАТ"
		Или ИмяКонфигурации = "ТЛЭ"
		Или ИмяКонфигурации = "ERP_УАТ" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	ИначеЕсли ИмяКонфигурации = "УТ"
		Или ИмяКонфигурации = "УПП" 
		Или ИмяКонфигурации = "КА" Тогда
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	Иначе
		
		ПринятьПереданныеОснованияКакОснованияЭПД(МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	КонецЕсли;
	
	Возврат ТаблицаДокументовУчетнойСистемыДляЭПД;
	
КонецФункции

Функция УТекПользователяЕстьПраваКПодсистеме() Экспорт
	
	Попытка
		
		Если РольДоступна("КонтурЛогистика_БазовыеПраваЛогистика")
			Или РольДоступна("КонтурЛогистика_ПолныеПраваЛогистика")
			Или КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистраторУчетнойСистемы() Тогда 
			Возврат Истина
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;

КонецФункции

Функция УТекПользователяЕстьПраваНастройкиПодсистемы() Экспорт
	
	Попытка
		
		Если РольДоступна("КонтурЛогистика_ПолныеПраваЛогистика")
			Или КонтурЛогистика_ОбщегоНазначенияСервер.ТекПользовательАдминистраторУчетнойСистемы() Тогда 
			Возврат Истина
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;

КонецФункции

Функция СведенияКонтурEDI(МассивДокументовОснованийЭПД) Экспорт

	ДанныеEDI = Новый Структура();
	ДанныеEDI.Вставить("НомераЗаказов", Новый Массив);
	ДанныеEDI.Вставить("НомераDESADV", Новый Массив);
	ДанныеEDI.Вставить("НомераУПД", Новый Массив);
	ДанныеEDI.Вставить("ДатыЗаказов", Новый Массив);
	ДанныеEDI.Вставить("ДатыDESADV", Новый Массив);
	ДанныеEDI.Вставить("ДатыУПД", Новый Массив);
	ДанныеEDI.Вставить("Партнер", Неопределено);
	ДанныеEDI.Вставить("ТочкаДоставки", Неопределено);
	ДанныеEDI.Вставить("GLNЮрлицаОтправителя", "");
	ДанныеEDI.Вставить("GLNЮрлицаПолучателя", "");
	ДанныеEDI.Вставить("ДатаПоставки", Дата(1,1,1));
	ДанныеEDI.Вставить("ВратаВремени", Дата(1,1,1));
	ДанныеEDI.Вставить("ПодробностиМассив", Новый Массив);
	
	// ПодробностиМассив - массив структур с полями:
	// НомерЗаказа
	// ДатаЗаказа
	// НомерDESADV
	// ДатаDESADV
	// НомерУПД
	// ДатаУПД
	// Партнер
	// GLNЮрлицаОтправителя
	// GLNЮрлицаПолучателя
	// ДатаПоставки
	// ВратаВремени
	
	// 1) Розыск сообщений EDI
	
	// поищем в лоб по документу
	// второй параметр - ложь - без инициализации EDI
	
	СвязанныеСообщенияEDI = ПолучитьСвязанныеСообщенияEDI(МассивДокументовОснованийЭПД, Ложь);
	
	Если СвязанныеСообщенияEDI.Количество() > 0 Тогда
		
		ТабЗаказов = СвязанныеСообщенияEDI.Скопировать(,"НомерЗаказа,ДатаЗаказа,Партнер");
		ТабЗаказов.Свернуть("НомерЗаказа,ДатаЗаказа,Партнер");
		
		НайденныеСообщенияПоНомеруЗаказа = ПолучитьСвязанныеСообщенияEDIПоНомеруЗаказа(ТабЗаказов);
		
		ОбъединитьНайденныеСообщенияEDI(НайденныеСообщенияПоНомеруЗаказа, СвязанныеСообщенияEDI);
		
	Иначе
		
		// придется инициализировать EDI и спросить у него какие связанные доки уч.сист. использовать при розыске сообщений
		// второй параметр - истина
		СвязанныеСообщенияEDI = ПолучитьСвязанныеСообщенияEDI(МассивДокументовОснованийЭПД, Истина);
		
	КонецЕсли;
	
	// 2) Заполнение данных
	НомераЗаказов = СвязанныеСообщенияEDI.Выгрузитьколонку("НомерЗаказа");
	НомераЗаказов = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(НомераЗаказов);
	ДанныеEDI.Вставить("НомераЗаказов", НомераЗаказов);
	
	ДатыЗаказов = Новый Массив;
	Для Каждого НомерЗаказа Из НомераЗаказов Цикл
		ДатыЗаказов.Добавить(ФорматироватьДатуEDIДляРеквизита(ДатаЗаказаИзСообщенийEDI(СвязанныеСообщенияEDI, НомерЗаказа)));
	КонецЦикла;
	ДанныеEDI.Вставить("ДатыЗаказов", ДатыЗаказов);
	
	// rem можно глянуть что в хранилище: СвязанныеСообщенияEDI[0].Ссылка.Хранилище.Получить()
	
	ТаблицаDESADV = НоваяТаблицаНомеровИДатДокументовEDI();
	ТаблицаINVOIC = НоваяТаблицаНомеровИДатДокументовEDI();
	
	Для Каждого НомерЗаказа Из НомераЗаказов Цикл 
		
		ПодробностиЭлемент = Новый Структура;
		ПодробностиЭлемент.Вставить("НомерЗаказа", НомерЗаказа);
		ПодробностиЭлемент.Вставить("ДатаЗаказа", ФорматироватьДатуEDIДляРеквизита(ДатаЗаказаИзСообщенийEDI(СвязанныеСообщенияEDI, НомерЗаказа)));
		ПодробностиЭлемент.Вставить("НомерDESADV", "");
		ПодробностиЭлемент.Вставить("ДатаDESADV", "");
		ПодробностиЭлемент.Вставить("НомерУПД", "");
		ПодробностиЭлемент.Вставить("ДатаУПД", "");
		ПодробностиЭлемент.Вставить("Партнер", Неопределено);
		ПодробностиЭлемент.Вставить("ТочкаДоставки", Неопределено);
		ПодробностиЭлемент.Вставить("GLNЮрлицаОтправителя", "");
		ПодробностиЭлемент.Вставить("GLNЮрлицаПолучателя", "");
		ПодробностиЭлемент.Вставить("ДатаПоставки", Дата(1,1,1));
		ПодробностиЭлемент.Вставить("ВратаВремени", Дата(1,1,1));
		
		// Найти сообщение orders, вязть из них точку доставки 
		НайденныеORDERS = СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("ТипСообщения,НомерЗаказа", "ORDERS", НомерЗаказа));
		
		Если НайденныеORDERS.Количество() > 0 Тогда
			
			ДанныеEDI.Вставить("ТочкаДоставки", НайденныеORDERS[0].ТочкаДоставки);
			ДанныеEDI.Вставить("ДатаПоставки", НайденныеORDERS[0].ДатаПоставки);
			ДанныеEDI.Вставить("Партнер", НайденныеORDERS[0].Партнер);
			
			ПодробностиЭлемент.Вставить("ТочкаДоставки", НайденныеORDERS[0].ТочкаДоставки);
			ПодробностиЭлемент.Вставить("ДатаПоставки", НайденныеORDERS[0].ДатаПоставки);
			ПодробностиЭлемент.Вставить("Партнер", НайденныеORDERS[0].Партнер);
			
			ХранилищеЗаказа = НайденныеORDERS[0].Ссылка.Хранилище.Получить();
			
			Если ХранилищеЗаказа <> Неопределено Тогда
				
				ЗаполнитьGLNЮрЛиц(ДанныеEDI, ХранилищеЗаказа);
				ЗаполнитьGLNЮрЛиц(ПодробностиЭлемент, ХранилищеЗаказа);
				
				// Ворота времени из orders
				// часовой пояс здесь в UTC
				ИзвлечьВоротаВремени(ДанныеEDI, ХранилищеЗаказа);
				ИзвлечьВоротаВремени(ПодробностиЭлемент, ХранилищеЗаказа);
				
			КонецЕсли;
			
		КонецЕсли;
		
		НайденныеORDRSP = СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("ТипСообщения,НомерЗаказа", "ORDRSP", НомерЗаказа));
		Если НайденныеORDRSP.Количество() > 0 Тогда 
			
			ХранилищеОтветаНаЗаказ = НайденныеORDRSP[0].Ссылка.Хранилище.Получить();
			
			ДанныеEDI.Вставить("ДатаПоставки", НайденныеORDRSP[0].ДатаПоставки);
			ПодробностиЭлемент.Вставить("ДатаПоставки", НайденныеORDRSP[0].ДатаПоставки);
			
			// Ворота времени из ordrsp приоритетней чем из orders
			// часовой пояс здесь в UTC
			ИзвлечьВоротаВремени(ДанныеEDI, ХранилищеОтветаНаЗаказ);
			ИзвлечьВоротаВремени(ПодробностиЭлемент, ХранилищеОтветаНаЗаказ);
			
		КонецЕсли;
		
		// Найти сообщения desadv, вязть из них номер и если еще не взяли точку доставки, то её
		НайденныеDESADV = СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("ТипСообщения,НомерЗаказа", "DESADV", НомерЗаказа));
		Если НайденныеDESADV.Количество() > 0 Тогда
			
			Если Не ЗначениеЗаполнено(ДанныеEDI.ТочкаДоставки) Тогда 
				ДанныеEDI.Вставить("ТочкаДоставки", НайденныеDESADV[0].ТочкаДоставки);
				ПодробностиЭлемент.Вставить("ТочкаДоставки", НайденныеDESADV[0].ТочкаДоставки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденныеDESADV[0].ДатаПоставки)
				И ДанныеEDI.ДатаПоставки <> НайденныеDESADV[0].ДатаПоставки Тогда 
				
				ДанныеEDI.Вставить("ДатаПоставки", НайденныеDESADV[0].ДатаПоставки);
				ПодробностиЭлемент.Вставить("ДатаПоставки", НайденныеDESADV[0].ДатаПоставки);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого СообщениеDESADV Из НайденныеDESADV Цикл
			
			ДатаDESADV = ФорматироватьДатуEDIДляРеквизита(СообщениеDESADV.ДатаДокумента);
			ДобавитьСтрокуНомераИДатыДокументаEDI(ТаблицаDESADV, СообщениеDESADV.НомерДокумента, ДатаDESADV);
			ПодробностиЭлемент.Вставить("НомерDESADV", СообщениеDESADV.НомерДокумента);
			ПодробностиЭлемент.Вставить("ДатаDESADV", ДатаDESADV);
			
		КонецЦикла;
		
		// Найти сообщение INVOIC, вязть из него НомераУПД
		НайденныеINVOIC = СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("ТипСообщения,НомерЗаказа", "INVOIC", НомерЗаказа));
		
		Если НайденныеINVOIC.Количество() > 0 Тогда
			
			Для Каждого СообщениеINVOIC Из НайденныеINVOIC Цикл
				
				ДатаУПД = ФорматироватьДатуEDIДляРеквизита(СообщениеINVOIC.ДатаДокумента);
				ДобавитьСтрокуНомераИДатыДокументаEDI(ТаблицаINVOIC, СообщениеINVOIC.НомерДокумента, ДатаУПД);
				ПодробностиЭлемент.Вставить("НомерУПД", СообщениеINVOIC.НомерДокумента);
				ПодробностиЭлемент.Вставить("ДатаУПД", ДатаУПД);
				
			КонецЦикла;
			
		Иначе
			
			// Взять из DESADV
			Если НайденныеDESADV.Количество() > 0 Тогда 
				Для Каждого СообщениеDESADV Из НайденныеDESADV Цикл
					
					СообщениеEDIСтруктура = СообщениеDESADV.Ссылка.Хранилище.Получить();
					Если ТипЗнч(СообщениеEDIСтруктура) = Тип("Структура")
						И СообщениеEDIСтруктура.Свойство("СчетФактураEDI")
						И ТипЗнч(СообщениеEDIСтруктура.СчетФактураEDI) = Тип("Структура")
						И СообщениеEDIСтруктура.СчетФактураEDI.Свойство("Номер")
						И ЗначениеЗаполнено(СообщениеEDIСтруктура.СчетФактураEDI.Номер) Тогда 
						
						ДобавитьСтрокуНомераИДатыДокументаEDI(ТаблицаINVOIC, СообщениеEDIСтруктура.СчетФактураEDI.Номер, "");
						ПодробностиЭлемент.Вставить("НомерУПД", СообщениеEDIСтруктура.СчетФактураEDI.Номер);
						
					КонецЕсли;
					
				КонецЦикла;
			Иначе
				
				// Взять из ORDRSP
				Если НайденныеORDRSP.Количество() > 0 Тогда 
					Для Каждого СообщениеORDRSP Из НайденныеORDRSP Цикл
						
						СообщениеEDIСтруктура = СообщениеORDRSP.Ссылка.Хранилище.Получить();
						Если ТипЗнч(СообщениеEDIСтруктура) = Тип("Структура")
							И СообщениеEDIСтруктура.Свойство("СчетФактураEDI")
							И ТипЗнч(СообщениеEDIСтруктура.СчетФактураEDI) = Тип("Структура")
							И СообщениеEDIСтруктура.СчетФактураEDI.Свойство("Номер")
							И ЗначениеЗаполнено(СообщениеEDIСтруктура.СчетФактураEDI.Номер) Тогда 
							
							ДобавитьСтрокуНомераИДатыДокументаEDI(ТаблицаINVOIC, СообщениеEDIСтруктура.СчетФактураEDI.Номер, "");
							ПодробностиЭлемент.Вставить("НомерУПД", СообщениеEDIСтруктура.СчетФактураEDI.Номер);
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеEDI.ПодробностиМассив.Добавить(ПодробностиЭлемент);
		
	КонецЦикла;
	
	ПоложитьНомераИДатыДокументовEDIВДанные(ДанныеEDI, "НомераDESADV", "ДатыDESADV", ТаблицаDESADV);
	ПоложитьНомераИДатыДокументовEDIВДанные(ДанныеEDI, "НомераУПД", "ДатыУПД", ТаблицаINVOIC);
	
	Возврат ДанныеEDI;
	
КонецФункции

Функция EDI_ИнформацияЗапускаМодуля() Экспорт
	
	ИнформацияЗапускаМодуля = Новый Структура("РасположениеМодуля, ПутьКМодулю"); 
	
	Попытка
	
		ИнформацияЗапускаМодуля.РасположениеМодуля = EDI_ПолучитьЗначениеДополнительногоРеквизита(Неопределено, "РасположениеМодуляEDI");	
		ИнформацияЗапускаМодуля.ПутьКМодулю 	   = EDI_ПолучитьЗначениеДополнительногоРеквизита(Неопределено, "ПутьКМодулюEDI");	
	
	Исключение
		
	    НичегоНеДелать = Истина;
		
	КонецПопытки;
	
	Возврат ИнформацияЗапускаМодуля;
	
КонецФункции

Функция EDI_ПолучитьЗначениеДополнительногоРеквизита(ПараметрОбъект, ПараметрСвойство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ПараметрОбъект);
	Запрос.УстановитьПараметр("Свойство", ПараметрСвойство);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтурEDI_ДополнительныеРеквизиты.Значение КАК Значение
	               |ИЗ
	               |	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	               |ГДЕ
	               |	КонтурEDI_ДополнительныеРеквизиты.Объект = &Объект
	               |	И КонтурEDI_ДополнительныеРеквизиты.Свойство = &Свойство";
	
	Результат = Запрос.Выполнить();	
	
	Если Результат.Пустой() Тогда
		
		ЗначениеДопРеквизита = Неопределено;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЗначениеДопРеквизита = Выборка.Значение;
		
	КонецЕсли;
	
	Возврат ЗначениеДопРеквизита;
	
КонецФункции

Функция EDI_ДатаXML_в_ДатаВремя1С(Строка) Экспорт
	
	Если ТипЗнч(Строка) = Тип("Дата") Тогда	
		Возврат Строка;
	КонецЕсли;
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат Дата(1,1,1);
	Иначе
		
		Если СтрДлина(Строка) = 10 Тогда
			Возврат Дата(Лев(Строка,4),Сред(Строка,6,2),Сред(Строка,9,2));
		Иначе
			Возврат Дата(Лев(Строка,4),Сред(Строка,6,2),Сред(Строка,9,2),Сред(Строка,12,2),Сред(Строка,15,2),Сред(Строка,18,2));
		КонецЕсли;	
		
	КонецЕсли;	
		
КонецФункции

Функция ПроверитьПодключитьОбработкуEDI(ПутьКМодулю) Экспорт
	
	ИмяОбработки = "";
	
	Если ЭтоАдресВременногоХранилища(ПутьКМодулю) Тогда
		                           
		ОписаниеЗащитыОтОпасныхДействий = Новый("ОписаниеЗащитыОтОпасныхДействий");
		ОписаниеЗащитыОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		
		ИмяОбработки = ВнешниеОбработки.Подключить(ПутьКМодулю, , Ложь, ОписаниеЗащитыОтОпасныхДействий);  
		
	Иначе      
		
		Попытка
			
			ДополнительныеОтчетыИОбработки = Неопределено;
			
			ПутьКсохраненномуФайлу = КонтурЛогистика_ПодключаемыйМодульПовтИсп.ПолучитьПутьКФайлуПодключаемогоМодуля(
										Перечисления.КонтурЛогистика_ТипыПМ.ВСправочнике,
										"EDI_ПутьКМодулю");
										
			ИмяОбработки = ПутьКсохраненномуФайлу;
			
		Исключение    
			
			ИмяОбработки = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(ПутьКМодулю);
			
		КонецПопытки;	
		
	КонецЕсли;
	
	Возврат ИмяОбработки;
	
КонецФункции

Функция СформироватьПунктМаршрутаИзEDI(ТочкаДоставки) Экспорт
	
	НайденнаяТочкаДоставки = Справочники.КонтурЛогистика_ПунктыМаршрута.НайтиПоРеквизиту("GLN", ТочкаДоставки.GLN);
	
	Если Не ЗначениеЗаполнено(НайденнаяТочкаДоставки) Тогда 
		
		НоваяТочкаДоставки = Справочники.КонтурЛогистика_ПунктыМаршрута.СоздатьЭлемент();
		НоваяТочкаДоставки.GLN = ТочкаДоставки.GLN;
		НоваяТочкаДоставки.АдресИнфАдрес = ТочкаДоставки.АдресДоставки;
		НоваяТочкаДоставки.Наименование = ТочкаДоставки.АдресДоставки;
		НоваяТочкаДоставки.АдресИнфКодСтраны = Справочники.КонтурЛогистика_СтраныМира.НайтиПоКоду("643");
		НоваяТочкаДоставки.Прибытие = Истина;
		НоваяТочкаДоставки.Записать();
		
		НайденнаяТочкаДоставки = НоваяТочкаДоставки.Ссылка;
		
	КонецЕсли;
	
	Возврат НайденнаяТочкаДоставки;

КонецФункции

Функция РазрешеноПропуститьСобытие(ИнформацияОбОшибке) Экспорт

	Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(
		ИнформацияОбОшибке.Описание, "Не удалось дождаться освобождения файла обмена") <> 0 Тогда
		
		// ошибка блокировки файла - событие может быть обработано в новом выполнении обмена когда исходник разблочится
		Возврат Ложь; 
		
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьТестовыйСерверДиадок") = Истина Тогда 
		
		// если мы сейчас на стэйджинге - любая ошибка ленты прерывает обмен
		Возврат Ложь;
		
	КонецЕсли;
	
	// проблему обработки ленты можно пропускать, метрика отправлена, запись ЖР сделана
	Возврат Истина;	

КонецФункции

// Определяет основания и сведения EDI для заполнения реквизитов ТрН/ЗЗ.
// Если указан разделитель-документ, основания и EDI ищутся только по нему без отката к ДокументыОснования.
//
// Параметры:
//  Разделитель - ОпределяемыйТип.КонтурЛогистика_РазделительДокументаУчетнойСистемы - разделитель ввода документа
//  ДокументыОснования - ТабличнаяЧасть - документы-основания логистического документа
//
// Возвращаемое значение:
//  Структура:
//   * МассивИстинныхОснований - Массив
//   * ДанныеEDI - Структура - сведения EDI (номера и даты ORDERS, DESADV, INVOIC и пр.)
//
Функция ПодготовитьДанныеЗаполненияКонтурEDI(Разделитель, ДокументыОснования) Экспорт
	
	МассивОснованийТРН = ДокументыОснования.ВыгрузитьКолонку("ДокументОснование");
	
	Если ЗначениеЗаполнено(Разделитель)
		И ЭтоДокументУчетнойСистемы(Разделитель) Тогда
		
		МассивОснованийПоРазделителю = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Разделитель);
		МассивИстинныхОснованийПоРазделителю = МассивОснованийДляEDIПоМассивуОснованийЭПД(МассивОснованийПоРазделителю);
		ДанныеEDIПоРазделителю = СведенияКонтурEDI(МассивИстинныхОснованийПоРазделителю);
		
		Результат = Новый Структура;
		Результат.Вставить("МассивИстинныхОснований", МассивИстинныхОснованийПоРазделителю);
		Результат.Вставить("ДанныеEDI", ДанныеEDIПоРазделителю);
		
		Возврат Результат;
		
	КонецЕсли;
	
	МассивИстинныхОснований = МассивОснованийДляEDIПоМассивуОснованийЭПД(МассивОснованийТРН);
	ДанныеEDI = СведенияКонтурEDI(МассивИстинныхОснований);
	
	Результат = Новый Структура;
	Результат.Вставить("МассивИстинныхОснований", МассивИстинныхОснований);
	Результат.Вставить("ДанныеEDI", ДанныеEDI);
	
	Возврат Результат;
	
КонецФункции

Функция МассивОснованийДляEDIПоМассивуОснованийЭПД(Знач МассивОснованийТРН) Экспорт
	
	Перем ИмяКонфигурации, МассивИстинныхОснований, СтрокаОснованиеТН, текОснование;
	
	
	// возможность переопределить через ПМ
	СтандартнаяОбработка = Истина;
	МассивИстинныхОснований = КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
									"EDI_МассивОснованийДляEDIПоМассивуОснованийЭПД",
									СтандартнаяОбработка,
									МассивОснованийТРН);
	
	Если ЗначениеЗаполнено(МассивИстинныхОснований)
		И СтандартнаяОбработка = Ложь Тогда
		
		Возврат МассивИстинныхОснований;
		
	КонецЕсли;
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Если ИмяКонфигурации = "УФ_УТ" 
		ИЛИ ИмяКонфигурации = "ERP" 
		ИЛИ ИмяКонфигурации = "КА_2" 
		ИЛИ ИмяКонфигурации = "КЛ" Тогда
		
		МассивИстинныхОснований = Новый Массив;
		
		Для Каждого текОснование Из МассивОснованийТРН Цикл 
			
			ЭтоДокументТРН = Ложь;
			Если ИмяКонфигурации = "КЛ" Тогда // каркасная
				ЭтоДокументТРН = ТипЗнч(текОснование) = Тип("ДокументСсылка.УчетнаяСистема_ТранспортнаяНакладная");
			Иначе // ERP-подобные
				ЭтоДокументТРН = ТипЗнч(текОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная");
			КонецЕсли;
			
			Если ЭтоДокументТРН Тогда 
				
				Для Каждого СтрокаОснованиеТН Из текОснование.ДокументыОснования Цикл 
					Если ЗначениеЗаполнено(СтрокаОснованиеТН.ДокументОснование) Тогда
						МассивИстинныхОснований.Добавить(СтрокаОснованиеТН.ДокументОснование);
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				МассивИстинныхОснований.Добавить(текОснование);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		// основания для ЭПД и для EDI совпадают
		МассивИстинныхОснований = МассивОснованийТРН;
		
	КонецЕсли;
	
	Возврат МассивИстинныхОснований;

КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнтеграцияСКонтурEDI

Функция ЭтоДокументУчетнойСистемы(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	
	Возврат ОбъектМетаданных <> Неопределено
		И Метаданные.Документы.Содержит(ОбъектМетаданных);
	
КонецФункции

Функция ПолучитьМодульEDIОбъект()
	
	МодульEDIОбработка = Неопределено;
	Попытка
	
		МодульEDIОбработка = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьМодульEDIОбъект();
		
	Исключение
	
	КонецПопытки;
	
	Возврат МодульEDIОбработка;
	
КонецФункции

Процедура ЗаполнитьGLNЮрЛиц(Знач ДанныеEDI, Знач ХранилищеЗаказа)
	
	// Поставщик
	Если ЗначениеЗаполнено(ХранилищеЗаказа.ГрузоотправительEDI.GLN) Тогда
		ДанныеEDI.Вставить("GLNЮрлицаОтправителя", ХранилищеЗаказа.ГрузоотправительEDI.GLN);
	ИначеЕсли ЗначениеЗаполнено(ХранилищеЗаказа.ПродавецEDI.GLN) Тогда 
		ДанныеEDI.Вставить("GLNЮрлицаОтправителя", ХранилищеЗаказа.ПродавецEDI.GLN);
	ИначеЕсли ЗначениеЗаполнено(ХранилищеЗаказа.ОтправительEDI.GLN) Тогда 
		ДанныеEDI.Вставить("GLNЮрлицаОтправителя", ХранилищеЗаказа.ОтправительEDI.GLN);
	КонецЕсли;
	
	// Торговая сеть
	Если ЗначениеЗаполнено(ХранилищеЗаказа.ПокупательEDI.GLN) Тогда 
		ДанныеEDI.Вставить("GLNЮрлицаПолучателя", ХранилищеЗаказа.ПокупательEDI.GLN);
	ИначеЕсли ЗначениеЗаполнено(ХранилищеЗаказа.ПлательщикEDI.GLN) Тогда 
		ДанныеEDI.Вставить("GLNЮрлицаПолучателя", ХранилищеЗаказа.ПлательщикEDI.GLN);
	ИначеЕсли ЗначениеЗаполнено(ХранилищеЗаказа.ПолучательEDI.GLN) Тогда 
		ДанныеEDI.Вставить("GLNЮрлицаПолучателя", ХранилищеЗаказа.ПолучательEDI.GLN);
	КонецЕсли;

КонецПроцедуры

Процедура ИзвлечьВоротаВремени(Знач ДанныеEDI, Знач ХранилищеСообщения)
	
	Перем ВоротаВремени;
	
	Если  ХранилищеСообщения.Свойство("Транспортировка")
		И ТипЗнч(ХранилищеСообщения.Транспортировка) = Тип("Структура")
		И ХранилищеСообщения.Транспортировка.Свойство("ДатаВремяПрибытия") 
		И ТипЗнч(ХранилищеСообщения.Транспортировка.ДатаВремяПрибытия) = Тип("СписокЗначений")
		И ХранилищеСообщения.Транспортировка.ДатаВремяПрибытия.Количество() > 0 Тогда 
		
		Для Каждого ВоротаВремени Из ХранилищеСообщения.Транспортировка.ДатаВремяПрибытия Цикл 
			
			Если ВоротаВремени.Пометка = Истина Тогда 
				
				// Врата времени в формате UTC
				ДанныеEDI.Вставить("ВратаВремени", EDI_ДатаXML_в_ДатаВремя1С(ВоротаВремени.Значение));   
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

// Дополняет таблицу связанных сообщений EDI сообщениями, найденными по номеру заказа.
// В таблицу добавляются все найденные сообщения; уже имеющиеся по ссылке не дублируются.
//
Процедура ОбъединитьНайденныеСообщенияEDI(Знач НайденныеСообщенияПоНомеруЗаказа, Знач СвязанныеСообщенияEDI)
	
	Для Каждого Сообщ Из НайденныеСообщенияПоНомеруЗаказа Цикл
		
		Если СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("Ссылка", Сообщ.Ссылка)).Количество() = 0 Тогда
			
			НоваяСтрокаСвязанных = СвязанныеСообщенияEDI.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСвязанных, Сообщ);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ФорматироватьДатуEDIДляРеквизита(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
	
КонецФункции

Функция ДатаЗаказаИзСообщенийEDI(СвязанныеСообщенияEDI, НомерЗаказа)
	
	НайденныеORDERS = СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("ТипСообщения,НомерЗаказа", "ORDERS", НомерЗаказа));
	
	Если НайденныеORDERS.Количество() > 0 Тогда
		
		СообщениеORDERS = НайденныеORDERS[0];
		
		Если ЗначениеЗаполнено(СообщениеORDERS.ДатаДокумента) Тогда
			Возврат СообщениеORDERS.ДатаДокумента;
		ИначеЕсли ЗначениеЗаполнено(СообщениеORDERS.ДатаЗаказа) Тогда
			Возврат СообщениеORDERS.ДатаЗаказа;
		Иначе
			// дата заказа не заполнена в сообщении ORDERS
		КонецЕсли;
		
	КонецЕсли;
	
	НайденныеПоЗаказу = СвязанныеСообщенияEDI.НайтиСтроки(Новый Структура("НомерЗаказа", НомерЗаказа));
	
	Для Каждого Сообщение Из НайденныеПоЗаказу Цикл
		
		Если ЗначениеЗаполнено(Сообщение.ДатаЗаказа) Тогда
			Возврат Сообщение.ДатаЗаказа;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Дата(1, 1, 1);
	
КонецФункции

