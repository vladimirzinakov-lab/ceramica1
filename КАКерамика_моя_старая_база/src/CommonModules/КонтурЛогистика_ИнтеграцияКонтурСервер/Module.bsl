Функция НоваяТаблицаНомеровИДатДокументовEDI()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("Дата");
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьСтрокуНомераИДатыДокументаEDI(Таблица, Номер, Дата)
	
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = Таблица.Добавить();
	СтрокаТаблицы.Номер = Номер;
	СтрокаТаблицы.Дата = Дата;
	
КонецПроцедуры

Процедура ПоложитьНомераИДатыДокументовEDIВДанные(ДанныеEDI, ИмяРеквизитаНомеров, ИмяРеквизитаДат, Таблица)
	
	Таблица.Свернуть("Номер, Дата");
	
	Номера = Новый Массив;
	Даты = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Номера.Добавить(СтрокаТаблицы.Номер);
		Даты.Добавить(СтрокаТаблицы.Дата);
	КонецЦикла;
	
	ДанныеEDI.Вставить(ИмяРеквизитаНомеров, Номера);
	ДанныеEDI.Вставить(ИмяРеквизитаДат, Даты);
	
КонецПроцедуры

Функция ПолучитьСвязанныеСообщенияEDI(МассивДокументовОснованийЭПД, ИнициализироватьEDI = Ложь)
	
	КонтурЛогистика_СтдКоллекцииКлиентСервер.УдалитьПустыеЗначенияМассива(МассивДокументовОснованийЭПД);
	
	// подготовить дополнительные связанные документы
	Если  ИнициализироватьEDI = Ложь Тогда
		
		ДополненныйМассивДокументовОснованийЭПД = МассивДокументовОснованийЭПД;
		
	Иначе
		
		Попытка
		
			ДополненныйМассивДокументовОснованийЭПД = ДополнитьОснованияСвязаннымиДокументами(МассивДокументовОснованийЭПД);
		
		Исключение
			
			// не смогли инициализировать EDI
			ДополненныйМассивДокументовОснованийЭПД = МассивДокументовОснованийЭПД;
			
		КонецПопытки;
		
	КонецЕсли;
	
	КонтурЛогистика_СтдКоллекцииКлиентСервер.УдалитьПустыеЗначенияМассива(ДополненныйМассивДокументовОснованийЭПД);
	
	// выполнить 1 запрос к КонтурEDI_Сообщения получив реквизиты:
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
	|	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения,
	|	КонтурEDI_Сообщения.НомерДокумента КАК НомерДокумента,
	|	КонтурEDI_Сообщения.НомерЗаказа КАК НомерЗаказа,
	|	КонтурEDI_Сообщения.ДатаЗаказа КАК ДатаЗаказа,
	|	КонтурEDI_Сообщения.ДатаДокумента КАК ДатаДокумента,
	|	КонтурEDI_Сообщения.ТочкаДоставки КАК ТочкаДоставки,
	|	КонтурEDI_Сообщения.Партнер КАК Партнер,
	|	КонтурEDI_Сообщения.ДатаПоставки КАК ДатаПоставки
	|ИЗ
	|	Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|ГДЕ
	|	КонтурEDI_Сообщения.Документ В(&ДополненныйМассивДокументовОснованийЭПД)
	|	И Не КонтурEDI_Сообщения.ПометкаУдаления
	|	И Не КонтурEDI_Сообщения.ОтклоненоОтправителем";
	
	// TODO отфильтровать ошибочные и пометки на удаление, переотправленные, брать последнюю версию - спросить у разработчиков EDI
	Запрос.УстановитьПараметр("ДополненныйМассивДокументовОснованийЭПД", ДополненныйМассивДокументовОснованийЭПД);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();	

КонецФункции

Функция ПолучитьСвязанныеСообщенияEDIПоНомеруЗаказа(ТабЗаказов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТабЗаказов.НомерЗаказа КАК НомерЗаказа,
	|	ТабЗаказов.ДатаЗаказа КАК ДатаЗаказа,
	|	ТабЗаказов.Партнер КАК Партнер
	|ПОМЕСТИТЬ ТаблицаЗаказов
	|ИЗ
	|	&ТабЗаказов КАК ТабЗаказов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурEDI_Сообщения.Ссылка КАК Ссылка,
	|	КонтурEDI_Сообщения.ТипСообщения КАК ТипСообщения,
	|	КонтурEDI_Сообщения.НомерДокумента КАК НомерДокумента,
	|	КонтурEDI_Сообщения.НомерЗаказа КАК НомерЗаказа,
	|	КонтурEDI_Сообщения.ДатаЗаказа КАК ДатаЗаказа,
	|	КонтурEDI_Сообщения.ДатаДокумента КАК ДатаДокумента,
	|	КонтурEDI_Сообщения.ТочкаДоставки КАК ТочкаДоставки,
	|	КонтурEDI_Сообщения.Партнер КАК Партнер,
	|	КонтурEDI_Сообщения.ДатаПоставки КАК ДатаПоставки
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтурEDI_Сообщения КАК КонтурEDI_Сообщения
	|		ПО ТаблицаЗаказов.НомерЗаказа = КонтурEDI_Сообщения.НомерЗаказа
	|			И ТаблицаЗаказов.ДатаЗаказа = КонтурEDI_Сообщения.ДатаЗаказа
	|			И ТаблицаЗаказов.Партнер = КонтурEDI_Сообщения.Партнер
	|ГДЕ
	|	Не КонтурEDI_Сообщения.ПометкаУдаления
	|	И Не КонтурEDI_Сообщения.ОтклоненоОтправителем";
	
	Запрос.УстановитьПараметр("ТабЗаказов", ТабЗаказов);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();	
	
КонецФункции

Функция ДополнитьОснованияСвязаннымиДокументами(Знач МассивДокументовОснованийЭПД)
	
	МодульEDI = ПолучитьМодульEDIОбъект();
	// попросим EDI выдать нам связанные документы
	// модуль edi может инициализироваться значительное время, но ожидаемое - не более 4 секунд,
	// модуль edi будет закэширован на ПовтИсп
	
	Если МодульEDI = Неопределено Тогда 
		Возврат МассивДокументовОснованийЭПД;
	КонецЕсли;
	
	ИтоговыйМассив = КонтурЛогистика_СтдКоллекцииКлиентСервер.СкопироватьРекурсивноЛок(МассивДокументовОснованийЭПД, Ложь);
	
	Для Каждого ДокументОснование Из МассивДокументовОснованийЭПД Цикл
		
		СвязанныеСообщения = МодульEDI.ПолучитьСвязанныеСообщения(, ДокументОснование);
		
		// обойдем, ограничившись тройной вложенностью
		Для Каждого СтрокаДерева Из СвязанныеСообщения.Строки Цикл
			
			Если СтрокаДерева.Вид = "Документ" Тогда 
				ИтоговыйМассив.Добавить(СтрокаДерева.Ссылка);
			КонецЕсли;
			
			Для Каждого СтрокаДерева Из СтрокаДерева.Строки Цикл
				
				Если СтрокаДерева.Вид = "Документ" Тогда 
					ИтоговыйМассив.Добавить(СтрокаДерева.Ссылка);
				КонецЕсли;
				
				Для Каждого СтрокаДерева Из СтрокаДерева.Строки Цикл
					
					Если СтрокаДерева.Вид = "Документ" Тогда 
						ИтоговыйМассив.Добавить(СтрокаДерева.Ссылка);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИтоговыйМассив = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(ИтоговыйМассив);
	
	Возврат ИтоговыйМассив;

КонецФункции 

#КонецОбласти

#Область МетодыДляСостоянияЭПДДляСпискаДокументов

Процедура ЗаполнитьОбщуюТаблицуСтатусовПоИсходнымДокументам(Знач ОбщаяТаблицаСтатусовПоИсходнымДокументам, Знач ТаблицаВведенныхЭПДСоСтатусами, Знач ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	Перем НайденнаяСтрокаЭПД, НайденныеСтрокиЭПД, СтрокаИтога, СтрокаОснования, ТребуетсяЗЗ, ТребуетсяТРН, ТребуетсяПЭ;
	
	Для Каждого СтрокаОснования Из ТаблицаДокументовУчетнойСистемыДляЭПД Цикл 
		
		Если ЗначениеЗаполнено(СтрокаОснования.ДокументОснованиеЭПД) Тогда
			
			КонтекстЭТрН = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, СтрокаОснования.ДокументОснованиеЭПД);
			КонтекстЭЗЗ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, СтрокаОснования.ДокументОснованиеЭПД);
			КонтекстЭПЭ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1, СтрокаОснования.ДокументОснованиеЭПД);
			
			ТребуетсяТРН = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН")
				И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭТрН);
			ТребуетсяЗЗ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка")
				И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭЗЗ);
			ТребуетсяПЭ = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПоручениеЭкспедитору")
				И ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭПЭ);
			
			НайденныеСтрокиЭПД = ТаблицаВведенныхЭПДСоСтатусами.НайтиСтроки(Новый Структура("ДокументОснованиеЭПД", СтрокаОснования.ДокументОснованиеЭПД));
			
			Для Каждого НайденнаяСтрокаЭПД Из НайденныеСтрокиЭПД Цикл 
				
				СтрокаИтога = ОбщаяТаблицаСтатусовПоИсходнымДокументам.Добавить();
				СтрокаИтога.ДокументОснование = СтрокаОснования.ДокументОснование;
				СтрокаИтога.ДокументОснованиеЭПД = СтрокаОснования.ДокументОснованиеЭПД;
				СтрокаИтога.ДокументЭПД = НайденнаяСтрокаЭПД.Ссылка;
				СтрокаИтога.ТипЭПД = НайденнаяСтрокаЭПД.Тип;
				СтрокаИтога.СтатусЭПД = НайденнаяСтрокаЭПД.Состояние;
				СтрокаИтога.ТребуемоеДействие = ОпределитьТребуемоеДействие(СтрокаИтога.ДокументЭПД, НайденнаяСтрокаЭПД.Состояние, НайденнаяСтрокаЭПД);
				Если СтрокаИтога.ТипЭПД = ПредставлениеЗЗ() Тогда
					ТребуетсяЗЗ = Ложь;
				ИначеЕсли СтрокаИтога.ТипЭПД = ПредставлениеТРН() Тогда
					ТребуетсяТРН = Ложь;
				ИначеЕсли СтрокаИтога.ТипЭПД = ПредставлениеПЭ() Тогда
					ТребуетсяПЭ = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			// докинуть задачи на оформление если не встретились ТРН/ЗЗ
			Если ТребуетсяЗЗ Тогда 
				СтрокаИтога = ОбщаяТаблицаСтатусовПоИсходнымДокументам.Добавить();
				СтрокаИтога.ТипЭПД = ПредставлениеЗЗ();
				СтрокаИтога.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
				СтрокаИтога.ДокументОснование = СтрокаОснования.ДокументОснование;
				СтрокаИтога.ДокументОснованиеЭПД = СтрокаОснования.ДокументОснованиеЭПД;
			КонецЕсли;
			Если ТребуетсяТРН Тогда 
				СтрокаИтога = ОбщаяТаблицаСтатусовПоИсходнымДокументам.Добавить();
				СтрокаИтога.ТипЭПД = ПредставлениеТРН();
				СтрокаИтога.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
				СтрокаИтога.ДокументОснование = СтрокаОснования.ДокументОснование;
				СтрокаИтога.ДокументОснованиеЭПД = СтрокаОснования.ДокументОснованиеЭПД;
			КонецЕсли;
			Если ТребуетсяПЭ Тогда 
				СтрокаИтога = ОбщаяТаблицаСтатусовПоИсходнымДокументам.Добавить();
				СтрокаИтога.ТипЭПД = ПредставлениеПЭ();
				СтрокаИтога.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
				СтрокаИтога.ДокументОснование = СтрокаОснования.ДокументОснование;
				СтрокаИтога.ДокументОснованиеЭПД = СтрокаОснования.ДокументОснованиеЭПД;
			КонецЕсли;
			
		Иначе
			
			ТипУчетногоДляВводаЭПД = КакойПромежуточныйДокументТребуетсяДляЭПД(СтрокаОснования.ДокументОснование);
			Если ТипУчетногоДляВводаЭПД <> "" Тогда
				
				СтрокаИтога = ОбщаяТаблицаСтатусовПоИсходнымДокументам.Добавить();
				СтрокаИтога.ДокументОснование = СтрокаОснования.ДокументОснование;
				СтрокаИтога.ТипУчетногоДляВводаЭПД = ТипУчетногоДляВводаЭПД;
				СтрокаИтога.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить;
				СтрокаИтога.СтатусЭПД = "Ввести док. основание для ЭПД";
				
			ИначеЕсли Не ВыводитьЗадачиПоДокументуДляЭПД(СтрокаОснования.ДокументОснование) Тогда
				СтрокаИтога = ОбщаяТаблицаСтатусовПоИсходнымДокументам.Добавить();
				СтрокаИтога.ДокументОснование = СтрокаОснования.ДокументОснование;
				СтрокаИтога.ТребуемоеДействие = "ЭПД не требуется";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТаблицуВведенныхЭПД(Знач ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	Перем Запрос, РезультатЗапроса, СтрокаТаблицаДокументовУчетнойСистемыДляЭПД, ТаблицаВведенныхЭПДСоСтатусами, текМассивДокументовУчетнойСистемыДляЭПД;
	
	текМассивДокументовУчетнойСистемыДляЭПД = Новый Массив;
	Для Каждого СтрокаТаблицаДокументовУчетнойСистемыДляЭПД Из ТаблицаДокументовУчетнойСистемыДляЭПД Цикл 
		
		Если ЗначениеЗаполнено(СтрокаТаблицаДокументовУчетнойСистемыДляЭПД.ДокументОснованиеЭПД) Тогда 
			текМассивДокументовУчетнойСистемыДляЭПД.Добавить(СтрокаТаблицаДокументовУчетнойСистемыДляЭПД.ДокументОснованиеЭПД);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = СформироватьТекстЗапросаСвязанныхЭПДпоУчДок(текМассивДокументовУчетнойСистемыДляЭПД);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаВведенныхЭПДСоСтатусами = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаВведенныхЭПДСоСтатусами;

КонецФункции

Функция РассчитатьИтоговыйСтатусПачки(Знач ВозвратныеСтатусы, Знач ОбщаяТаблицаСтатусовПоИсходнымДокументам, Знач Пачка)
	
	Перем ДокументОснование, ДокументЭПД, ЕстьВозвратОжиданиеДругого, ЕстьВозвратПродолжитьОформление, ЕстьВПути, ЕстьВыполнитьОбмен, ЕстьДругойСотрудник, ЕстьОжиданиеДругого, ЕстьОформление, ЕстьПродолжитьОформление, ЕстьРаботаЗавершена, МассивДокументовОснований, СвязанныеСтрокиПачки, СтатусПачки, СтатусЭПД, СтрокаРезультата, СтрокиИтоговойТаблицы, ТребуемоеДействие;
	
	ЕстьОформление = Ложь;
	ЕстьОжиданиеДругого = Ложь;
	ЕстьДругойСотрудник = Ложь;
	ЕстьПродолжитьОформление = Ложь;
	ЕстьВПути = Ложь;
	ЕстьРаботаЗавершена = Ложь;
	ЕстьВозвратПродолжитьОформление = Ложь;
	ЕстьВозвратОжиданиеДругого = Ложь;
	ЕстьВыполнитьОбмен = Ложь;
	
	
	// определим какие строки общей таблицы относятся к пачке
	СвязанныеСтрокиПачки = Новый Массив;
	
	МассивДокументовОснований = Пачка.Значение;
	Для Каждого ДокументОснование Из МассивДокументовОснований Цикл 
		
		СтрокиИтоговойТаблицы = ОбщаяТаблицаСтатусовПоИсходнымДокументам.НайтиСтроки(Новый Структура("ДокументОснование", ДокументОснование));
		КонтурЛогистика_СтдКоллекцииКлиентСервер.ДополнитьМассивЛок(СвязанныеСтрокиПачки,СтрокиИтоговойТаблицы, Истина);
		
	КонецЦикла;
	
	// рассчитаем итоговый Статус 
	СтатусПачки = ""; // дефолт ЭПД не требуется, надпись не выводится в ДД/EDI
	
	//Обойдем итоговую таблицу по пачке
	
	Для Каждого СтрокаРезультата Из СвязанныеСтрокиПачки Цикл 
		
		СтатусЭПД 			= СтрокаРезультата.СтатусЭПД; 
		ТребуемоеДействие 	= СтрокаРезультата.ТребуемоеДействие;
		
		Если ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен Тогда
			
			ЕстьВыполнитьОбмен = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоСотрудника Тогда
			
			ЕстьДругойСотрудник = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника
			И ВозвратныеСтатусы.Найти(СтатусЭПД) <> Неопределено Тогда  
			
			ЕстьВозвратОжиданиеДругого = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление
			И ВозвратныеСтатусы.Найти(СтатусЭПД) <> Неопределено Тогда  
			
			ЕстьВозвратПродолжитьОформление = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена
			Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВвестиНаОсновании Тогда
			
			ЕстьРаботаЗавершена = Истина;
			
		ИначеЕсли (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника
			Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ДождатьсяПрибытия)
			И СтатусЭПД = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НайтиСостояниеДОПоКоду("on-the-way") Тогда 
			
			ЕстьВПути = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОжиданиеДругогоУчастника Тогда 
			
			ЕстьОжиданиеДругого = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить Тогда 
			
			ЕстьОформление = Истина;
			
		ИначеЕсли ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление
			Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю 
			Или ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПроверитьОтветДругогоУчастника Тогда 
			
			ЕстьПродолжитьОформление = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// состояние обмена - наивысший приоритет
	Если ЕстьВыполнитьОбмен Тогда
		СтатусПачки = "Выполнить обмен";
		
		// задачи мои
	ИначеЕсли ЕстьВозвратПродолжитьОформление Тогда
		СтатусПачки = "Возврат. Продолжить оформление";
	ИначеЕсли ЕстьПродолжитьОформление Тогда 
		СтатусПачки = "Продолжить оформление";
	ИначеЕсли ЕстьОформление И Не ЕстьПродолжитьОформление Тогда 
		СтатусПачки = "Оформить ЭПД";
		
		// задачи другого сотрудника (и нет моих)	
	ИначеЕсли ЕстьДругойСотрудник Тогда 
		СтатусПачки = "Другой сотрудник ";
		
		// задачи другого участника (и нет на нашей стороне)
	ИначеЕсли ЕстьВозвратОжиданиеДругого Тогда 
		СтатусПачки = "Возврат. Ожидаем другого участника";
	ИначеЕсли ЕстьВПути Тогда
		СтатусПачки = "В пути";
	ИначеЕсли ЕстьОжиданиеДругого Тогда
		СтатусПачки = "Ожидаем другого участника";
		
		// перевозки завершены
	ИначеЕсли ЕстьРаботаЗавершена Тогда
		СтатусПачки = "Работа завершена";
		
	КонецЕсли;
	Возврат СтатусПачки;

КонецФункции

Функция ОпределитьИстинныйМассивИсходныхДокументов(Знач СписокДокументов)
	
	ИтоговаяТаблица = Новый ТаблицаЗначений;
	ИтоговаяТаблица.Колонки.Добавить("ДокументОснование");
	ИтоговаяТаблица.Колонки.Добавить("ДокументОснованиеЭПД");
	
	ОбщийМассивДокументовУчетнойСистемы = Новый Массив;
	
	Для Каждого КлючЗначение Из СписокДокументов Цикл
		
		Ключ = КлючЗначение.Ключ;
		МассивДокументовУчетнойСистемы = КлючЗначение.Значение;
		
		Для Каждого текДок Из МассивДокументовУчетнойСистемы Цикл 
			
			ОбщийМассивДокументовУчетнойСистемы.Добавить(текДок);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	текМассивДокументовУчетнойСистемы = КонтурЛогистика_СтдКоллекцииКлиентСервер.СвернутьМассивЛок(ОбщийМассивДокументовУчетнойСистемы);
	ТаблицаСвязейДокументовУСиДокументовОснованийДляЭПД = НайтиСоотвУчетныеДокументы(текМассивДокументовУчетнойСистемы);
	
	Для Каждого ИсходныйДок Из текМассивДокументовУчетнойСистемы Цикл 
		
		НайденныеСтрокиОснованийЭПД = ТаблицаСвязейДокументовУСиДокументовОснованийДляЭПД.НайтиСтроки(Новый Структура("ДокументОснование", ИсходныйДок));
		
		Если НайденныеСтрокиОснованийЭПД.Количество() > 0 Тогда 
			
			Для Каждого НайденнаяСтрокаСвязанного Из НайденныеСтрокиОснованийЭПД Цикл 
				СтрокаИтоговой = ИтоговаяТаблица.Добавить();
				СтрокаИтоговой.ДокументОснование = ИсходныйДок; 
				СтрокаИтоговой.ДокументОснованиеЭПД = НайденнаяСтрокаСвязанного.ДокументОснованиеЭПД; 
			КонецЦикла;
			
		Иначе
			СтрокаИтоговой = ИтоговаяТаблица.Добавить();
			СтрокаИтоговой.ДокументОснование = ИсходныйДок; 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИтоговаяТаблица;

КонецФункции

#КонецОбласти

Функция ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстНастройкиКонвертации)
	
	Возврат КонтекстНастройкиКонвертации.ЕстьКонвертация И КонтекстНастройкиКонвертации.ВыводитьЗадачи;
	
КонецФункции

Функция ПоддерживаетсяРазделениеОснованийЭПД()
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	Возврат ИмяКонфигурации = "УФ_УТ"
		Или ИмяКонфигурации = "ERP"
		Или ИмяКонфигурации = "КА_2"
		Или ИмяКонфигурации = "КЛ";
	
КонецФункции

Функция ИменаТиповДокументовРазделенияОснованийЭПД()
	
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	ТипыПрямогоОснования = Новый Массив;
	
	Если ИмяКонфигурации = "КЛ" Тогда
		
		ТипТранспортнаяНакладная = "УчетнаяСистема_ТранспортнаяНакладная";
		ИмяМетаданныхТранспортнаяНакладная = "УчетнаяСистема_ТранспортнаяНакладная";
		ТипПоручениеЭкспедитору = "";
		ИмяМетаданныхПоручениеЭкспедитору = "";
		ТипыПрямогоОснования.Добавить("УчетнаяСистема_РеализацияТоваровУслуг");
		ТипыПрямогоОснования.Добавить("УчетнаяСистема_ПеремещениеТоваровУслуг");
		
	Иначе
		
		ТипТранспортнаяНакладная = "ТранспортнаяНакладная";
		ИмяМетаданныхТранспортнаяНакладная = "ТранспортнаяНакладная";
		ТипПоручениеЭкспедитору = "ПоручениеЭкспедитору";
		ИмяМетаданныхПоручениеЭкспедитору = "ПоручениеЭкспедитору";
		ТипыПрямогоОснования.Добавить("РеализацияТоваровУслуг");
		ТипыПрямогоОснования.Добавить("ПеремещениеТоваров");
		
	КонецЕсли;
	
	Возврат Новый Структура(
		"ТипТранспортнаяНакладная, ТипыПрямогоОснования, ИмяМетаданныхТранспортнаяНакладная, ТипПоручениеЭкспедитору, ИмяМетаданныхПоручениеЭкспедитору",
		ТипТранспортнаяНакладная, ТипыПрямогоОснования, ИмяМетаданныхТранспортнаяНакладная, ТипПоручениеЭкспедитору, ИмяМетаданныхПоручениеЭкспедитору);
	
КонецФункции

Функция ВыводитьЗадачиПромежуточныйДокумент(ТипПромежуточногоДокумента)
	
	Если Не ПоддерживаетсяРазделениеОснованийЭПД() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаТипов = ИменаТиповДокументовРазделенияОснованийЭПД();
	
	Возврат ВыводитьЗадачиПоДокументуДляЭПД(ТипПромежуточногоДокумента);
	
КонецФункции

Функция ВыводитьЗадачиПрямоеОснование()
	
	Если Не ПоддерживаетсяРазделениеОснованийЭПД() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаТипов = ИменаТиповДокументовРазделенияОснованийЭПД();
	Результат = Ложь;
	
	Для Каждого ТипПрямогоОснования Из ИменаТипов.ТипыПрямогоОснования Цикл
		
		Результат = ВыводитьЗадачиПоДокументуДляЭПД(ТипПрямогоОснования);
		
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВыводитьЗадачиПоДокументуДляЭПД(ДокументОснование)
	
	Результат = Ложь;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяТРН") Тогда
		КонтекстЭТрН = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументОснование);
		Результат = Результат Или ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭТрН);
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЗаказЗаявка") Тогда
		КонтекстЭЗЗ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, ДокументОснование);
		Результат = Результат Или ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭЗЗ);
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяПоручениеЭкспедитору") Тогда
		КонтекстЭПЭ = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1, ДокументОснование);
		Результат = Результат Или ВыводитьЗадачиПоКонтекстуКонвертации(КонтекстЭПЭ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоДокументТребующийПромежуточныйДокумент(ДокументОснование)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТипа = Метаданные.НайтиПоТипу(ТипЗнч(ДокументОснование)).Имя;
	Возврат ИмяТипа = "РеализацияТоваровУслуг"
		Или ИмяТипа = "ПеремещениеТоваров"
		Или ИмяТипа = "УчетнаяСистема_РеализацияТоваровУслуг"
		Или ИмяТипа = "УчетнаяСистема_ПеремещениеТоваровУслуг";
	
КонецФункции
	
Функция ЭтоТранспортнаяНакладнаяУчетнойСистемы(ДокументОснование)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТипа = Метаданные.НайтиПоТипу(ТипЗнч(ДокументОснование)).Имя;
	Возврат ИмяТипа = "ТранспортнаяНакладная"
		Или ИмяТипа = "УчетнаяСистема_ТранспортнаяНакладная";
	
КонецФункции

Функция ЭтоПоручениеЭкспедиторуУчетнойСистемы(ДокументОснование)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТипа = Метаданные.НайтиПоТипу(ТипЗнч(ДокументОснование)).Имя;
	Возврат ИмяТипа = "ПоручениеЭкспедитору";
	
КонецФункции

Функция КакойПромежуточныйДокументТребуетсяДляЭПД(ДокументОснование)
	
	Если Не ЭтоДокументТребующийПромежуточныйДокумент(ДокументОснование) Тогда
		Возврат "";
	КонецЕсли;
	
	ИменаТипов = ИменаТиповДокументовРазделенияОснованийЭПД();
	ВыводитьЗадачиПрямоеОснование = ВыводитьЗадачиПрямоеОснование();	
		
	Если ВыводитьЗадачиПромежуточныйДокумент(ИменаТипов.ТипТранспортнаяНакладная) И Не ВыводитьЗадачиПрямоеОснование Тогда
		Возврат ПредставлениеТРН();
	КонецЕсли;	
		
	Если ВыводитьЗадачиПромежуточныйДокумент(ИменаТипов.ТипПоручениеЭкспедитору) И Не ВыводитьЗадачиПрямоеОснование Тогда
		Возврат ПредставлениеПЭ();
	КонецЕсли;
	
	Возврат "";
		
КонецФункции

Процедура ДобавитьПрямуюСтрокуОснованияЭПД(ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	ДобавитьПрямуюСтрокуОснованияЭПДНеДублируя(ДокументОснование, ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД);
	
КонецПроцедуры

Процедура ДобавитьПрямуюСтрокуОснованияЭПДНеДублируя(ДокументОснование, ДокументОснованиеЭПД, ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	Отбор = Новый Структура("ДокументОснование, ДокументОснованиеЭПД", ДокументОснование, ДокументОснованиеЭПД);
	Если ТаблицаДокументовУчетнойСистемыДляЭПД.НайтиСтроки(Отбор).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Строка = ТаблицаДокументовУчетнойСистемыДляЭПД.Добавить();
	Строка.ДокументОснование = ДокументОснование;
	Строка.ДокументОснованиеЭПД = ДокументОснованиеЭПД;
	
КонецПроцедуры

Функция ЕстьСвязьПромежуточногоДокументаСОснованием(ДокументОснование, СвязиПромежуточныхДокументов)
	
	Возврат СвязиПромежуточныхДокументов.Найти(ДокументОснование, "ДокументОснование") <> Неопределено;
	
КонецФункции

Функция ЕстьСвязьТранспортнойНакладнойСРеализацией(ДокументОснование, СвязиТранспортныхНакладных)
	
	Возврат ЕстьСвязьПромежуточногоДокументаСОснованием(ДокументОснование, СвязиТранспортныхНакладных);
	
КонецФункции

Функция ИспользуетсяКакОснованиеЭПДПоСвязиСРеализацией(ДокументОснованиеЭПД, ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	НайденныеСтроки = ТаблицаДокументовУчетнойСистемыДляЭПД.НайтиСтроки(
		Новый Структура("ДокументОснованиеЭПД", ДокументОснованиеЭПД));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.ДокументОснование <> НайденнаяСтрока.ДокументОснованиеЭПД Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура УдалитьПрямыеСтрокиРеализацииСвязанныеСПромежуточнымДокументом(ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	СтрокиКУдалению = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументовУчетнойСистемыДляЭПД Цикл
		
		Если СтрокаТаблицы.ДокументОснование <> СтрокаТаблицы.ДокументОснованиеЭПД
			Или Не ЭтоДокументТребующийПромежуточныйДокумент(СтрокаТаблицы.ДокументОснование) Тогда
			Продолжить;
		КонецЕсли;
		
		СвязанныеСтроки = ТаблицаДокументовУчетнойСистемыДляЭПД.НайтиСтроки(
			Новый Структура("ДокументОснование", СтрокаТаблицы.ДокументОснование));
		
		Для Каждого СвязаннаяСтрока Из СвязанныеСтроки Цикл
			Если СвязаннаяСтрока.ДокументОснование <> СвязаннаяСтрока.ДокументОснованиеЭПД Тогда
				СтрокиКУдалению.Добавить(СтрокаТаблицы);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из СтрокиКУдалению Цикл
		ТаблицаДокументовУчетнойСистемыДляЭПД.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСвязанныеТранспортныеНакладные(ДокументыОснования, ИмяМетаданныхТранспортнаяНакладная)
	
	ТаблицаСвязей = Новый ТаблицаЗначений;
	ТаблицаСвязей.Колонки.Добавить("ДокументОснование");
	ТаблицаСвязей.Колонки.Добавить("ДокументОснованиеЭПД");
	
	Если ДокументыОснования.Количество() = 0 Тогда
		Возврат ТаблицаСвязей;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТранспортнаяНакладнаяДокументыОснования.Ссылка КАК ДокументОснованиеЭПД,
	|	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ." + ИмяМетаданныхТранспортнаяНакладная + ".ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
	|ГДЕ
	|	НЕ ТранспортнаяНакладнаяДокументыОснования.Ссылка.ПометкаУдаления
	|	И ТранспортнаяНакладнаяДокументыОснования.ДокументОснование В(&ДокументыОснование)";
	
	Запрос.УстановитьПараметр("ДокументыОснование", ДокументыОснования);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция НайтиСвязанныеПорученияЭкспедитору(ДокументыОснования, ИмяМетаданныхПоручениеЭкспедитору)
	
	ТаблицаСвязей = Новый ТаблицаЗначений;
	ТаблицаСвязей.Колонки.Добавить("ДокументОснование");
	ТаблицаСвязей.Колонки.Добавить("ДокументОснованиеЭПД");
	
	Если ДокументыОснования.Количество() = 0
		Или Не ЗначениеЗаполнено(ИмяМетаданныхПоручениеЭкспедитору) Тогда
		Возврат ТаблицаСвязей;
	КонецЕсли;
	
	Попытка
		
		ТекстЗапроса = ТекстЗапросаСвязейПорученияЭкспедиторуСОснованиями(ИмяМетаданныхПоручениеЭкспедитору);
		Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
			Возврат ТаблицаСвязей;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДокументыОснование", ДокументыОснования);
		
		Возврат Запрос.Выполнить().Выгрузить();
		
	Исключение
		
		ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
		ТекстОшибки = "Не удалось найти связанные поручения экспедитору.
			|Текст ошибки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
		Возврат ТаблицаСвязей;
		
	КонецПопытки;
	
КонецФункции

// Возвращает текст запроса связей поручения экспедитору с основаниями
// по реально существующим в конфигурации ТЧ/реквизитам.
// Если подходящей структуры нет - пустая строка (поиск связей пропускается).
//
Функция ТекстЗапросаСвязейПорученияЭкспедиторуСОснованиями(ИмяМетаданныхПоручениеЭкспедитору)
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяМетаданныхПоручениеЭкспедитору);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТабличнаяЧастьОснования = МетаданныеДокумента.ТабличныеЧасти.Найти("Основания");
	Если ТабличнаяЧастьОснования <> Неопределено
		И ТабличнаяЧастьОснования.Реквизиты.Найти("Основание") <> Неопределено Тогда
		
		Возврат
		"ВЫБРАТЬ
		|	ПоручениеЭкспедиторуОснования.Ссылка КАК ДокументОснованиеЭПД,
		|	ПоручениеЭкспедиторуОснования.Основание КАК ДокументОснование
		|ИЗ
		|	Документ." + ИмяМетаданныхПоручениеЭкспедитору + ".Основания КАК ПоручениеЭкспедиторуОснования
		|ГДЕ
		|	НЕ ПоручениеЭкспедиторуОснования.Ссылка.ПометкаУдаления
		|	И ПоручениеЭкспедиторуОснования.Основание В(&ДокументыОснование)";
		
	КонецЕсли;
	
	ТабличнаяЧастьДокументыОснования = МетаданныеДокумента.ТабличныеЧасти.Найти("ДокументыОснования");
	Если ТабличнаяЧастьДокументыОснования <> Неопределено
		И ТабличнаяЧастьДокументыОснования.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
		
		Возврат
		"ВЫБРАТЬ
		|	ПоручениеЭкспедиторуДокументыОснования.Ссылка КАК ДокументОснованиеЭПД,
		|	ПоручениеЭкспедиторуДокументыОснования.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ." + ИмяМетаданныхПоручениеЭкспедитору + ".ДокументыОснования КАК ПоручениеЭкспедиторуДокументыОснования
		|ГДЕ
		|	НЕ ПоручениеЭкспедиторуДокументыОснования.Ссылка.ПометкаУдаления
		|	И ПоручениеЭкспедиторуДокументыОснования.ДокументОснование В(&ДокументыОснование)";
		
	КонецЕсли;
	
	Если МетаданныеДокумента.Реквизиты.Найти("Основание") <> Неопределено Тогда
		
		Возврат
		"ВЫБРАТЬ
		|	ПоручениеЭкспедитору.Ссылка КАК ДокументОснованиеЭПД,
		|	ПоручениеЭкспедитору.Основание КАК ДокументОснование
		|ИЗ
		|	Документ." + ИмяМетаданныхПоручениеЭкспедитору + " КАК ПоручениеЭкспедитору
		|ГДЕ
		|	НЕ ПоручениеЭкспедитору.ПометкаУдаления
		|	И ПоручениеЭкспедитору.Основание В(&ДокументыОснование)";
		
	КонецЕсли;
	
	Если МетаданныеДокумента.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
		
		Возврат
		"ВЫБРАТЬ
		|	ПоручениеЭкспедитору.Ссылка КАК ДокументОснованиеЭПД,
		|	ПоручениеЭкспедитору.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ." + ИмяМетаданныхПоручениеЭкспедитору + " КАК ПоручениеЭкспедитору
		|ГДЕ
		|	НЕ ПоручениеЭкспедитору.ПометкаУдаления
		|	И ПоручениеЭкспедитору.ДокументОснование В(&ДокументыОснование)";
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ЗаполнитьСоответствиеДокументовУчетнойСистемыДляЭПДСРазделениемОснований(
	Знач МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	ИменаТипов = ИменаТиповДокументовРазделенияОснованийЭПД();
	ВыводитьЗадачиПрямоеОснование = ВыводитьЗадачиПрямоеОснование();
	
	ПромежуточнаяТранспортнаяНакладная = ВыводитьЗадачиПромежуточныйДокумент(ИменаТипов.ТипТранспортнаяНакладная);
	ОбаВариантаОснованияТН = ПромежуточнаяТранспортнаяНакладная И ВыводитьЗадачиПрямоеОснование;
	
	ПромежуточноеПоручениеЭкспедитору = ВыводитьЗадачиПромежуточныйДокумент(ИменаТипов.ТипПоручениеЭкспедитору);
	ОбаВариантаОснованияПЭ = ПромежуточноеПоручениеЭкспедитору И ВыводитьЗадачиПрямоеОснование;
	
	ДокументыДляПоискаТранспортнойНакладной = Новый Массив;
	ДокументыДляПоискаПорученияЭкспедитору = Новый Массив;
	ДокументыДляОтложенногоПрямогоДобавления = Новый Массив;
	
	Для Каждого ДокументОснование Из МассивДокументовУчетнойСистемы Цикл
		
		Если ЭтоДокументТребующийПромежуточныйДокумент(ДокументОснование) Тогда
			
			Если ПромежуточнаяТранспортнаяНакладная Тогда
				ДокументыДляПоискаТранспортнойНакладной.Добавить(ДокументОснование);
			КонецЕсли;
			
			Если ПромежуточноеПоручениеЭкспедитору Тогда
				ДокументыДляПоискаПорученияЭкспедитору.Добавить(ДокументОснование);
			КонецЕсли;
			
			Если ((ВыводитьЗадачиПрямоеОснование И Не ПромежуточнаяТранспортнаяНакладная)
					Или (ВыводитьЗадачиПрямоеОснование И Не ПромежуточноеПоручениеЭкспедитору))
				И ВыводитьЗадачиПоДокументуДляЭПД(ДокументОснование) Тогда
				ДобавитьПрямуюСтрокуОснованияЭПД(ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД);
			КонецЕсли;
			
		ИначеЕсли ВыводитьЗадачиПоДокументуДляЭПД(ДокументОснование) Тогда
			ДокументыДляОтложенногоПрямогоДобавления.Добавить(ДокументОснование);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДокументыДляПоискаТранспортнойНакладной.Количество() > 0 Тогда
		
		ДобавитьСтрокиДляПромежуточных(ТаблицаДокументовУчетнойСистемыДляЭПД, ДокументыДляПоискаТранспортнойНакладной,
			ИменаТипов.ИмяМетаданныхТранспортнаяНакладная, ОбаВариантаОснованияТН);
				
	КонецЕсли;
	
	Если ДокументыДляПоискаПорученияЭкспедитору.Количество() > 0 Тогда
		
		ДобавитьСтрокиДляПромежуточных(ТаблицаДокументовУчетнойСистемыДляЭПД, ДокументыДляПоискаПорученияЭкспедитору,
			ИменаТипов.ИмяМетаданныхПоручениеЭкспедитору, ОбаВариантаОснованияПЭ);
				
	КонецЕсли;
	
	Для Каждого ДокументОснование Из ДокументыДляОтложенногоПрямогоДобавления Цикл
		
		Если (ПромежуточнаяТранспортнаяНакладная
				И ЭтоТранспортнаяНакладнаяУчетнойСистемы(ДокументОснование)
				И ИспользуетсяКакОснованиеЭПДПоСвязиСРеализацией(ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД))
			Или (ПромежуточноеПоручениеЭкспедитору
				И ЭтоПоручениеЭкспедиторуУчетнойСистемы(ДокументОснование)
				И ИспользуетсяКакОснованиеЭПДПоСвязиСРеализацией(ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД)) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьПрямуюСтрокуОснованияЭПД(ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД);
		
	КонецЦикла;
	
	Если ПромежуточнаяТранспортнаяНакладная Или ПромежуточноеПоручениеЭкспедитору Тогда
		УдалитьПрямыеСтрокиРеализацииСвязанныеСПромежуточнымДокументом(ТаблицаДокументовУчетнойСистемыДляЭПД);
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьСтрокиДляПромежуточных(ТаблицаДокументовУчетнойСистемыДляЭПД, ДокументыДляПоискаПромежуточного,
	ИмяМетаданных, ОбаВариантаОснования)
	
	Если ИмяМетаданных = "УчетнаяСистема_ТранспортнаяНакладная" Или ИмяМетаданных = "ТранспортнаяНакладная" Тогда
		СвязиПромежуточныхДокументов = НайтиСвязанныеТранспортныеНакладные(
			ДокументыДляПоискаПромежуточного, ИмяМетаданных);		
	ИначеЕсли ИмяМетаданных = "ПоручениеЭкспедитору" Тогда
		СвязиПромежуточныхДокументов = НайтиСвязанныеПорученияЭкспедитору(
			ДокументыДляПоискаПромежуточного, ИмяМетаданных);
	Иначе
		Возврат;
	КонецЕсли;
	
	Для Каждого СвязьПромежуточногоДокумента Из СвязиПромежуточныхДокументов Цикл
		ДобавитьПрямуюСтрокуОснованияЭПДНеДублируя(
			СвязьПромежуточногоДокумента.ДокументОснование,
			СвязьПромежуточногоДокумента.ДокументОснованиеЭПД,
			ТаблицаДокументовУчетнойСистемыДляЭПД);
	КонецЦикла;
	
	Если ОбаВариантаОснования Тогда
		
		Для Каждого ДокументОснование Из ДокументыДляПоискаПромежуточного Цикл
			
			Если Не ЕстьСвязьПромежуточногоДокументаСОснованием(ДокументОснование, СвязиПромежуточныхДокументов)
				И ВыводитьЗадачиПоДокументуДляЭПД(ДокументОснование) Тогда
				ДобавитьПрямуюСтрокуОснованияЭПД(ДокументОснование, ТаблицаДокументовУчетнойСистемыДляЭПД);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

Функция УчетныйДокументПодразумеваетЭПД(текДокОснование)
	
	ТребуетсяЭПД = Ложь;
	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();
	
	Если Не ЗначениеЗаполнено(текДокОснование) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗнчОснования = ТипЗнч(текДокОснование);
	
	Если ИмяКонфигурации = "УФ_БП"
		ИЛИ ИмяКонфигурации = "БП" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПеремещениеТоваров")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПутевойЛист")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "УФ_УТ"
		Или ИмяКонфигурации = "ERP"
		Или ИмяКонфигурации = "КА_2" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПеремещениеТоваров")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПоступлениеТоваровНаСклад")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ЗаданиеНаПеревозку")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ТранспортнаяНакладная")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПоручениеЭкспедитору") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "КЛ" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.УчетнаяСистема_РеализацияТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.УчетнаяСистема_ЗаданиеНаПеревозку")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.УчетнаяСистема_ПеремещениеТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.УчетнаяСистема_ВозвратТоваровПоставщику") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "УФ_УНФ" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.РасходнаяНакладная")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПеремещениеЗапасов")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
			
			ТребуетсяЭПД = Истина;
		КонецЕсли
		
	ИначеЕсли ИмяКонфигурации = "УАТ_ПРОФ"
		Или ИмяКонфигурации = "УАТ"
		Или ИмяКонфигурации = "ТЛЭ"
		Или ИмяКонфигурации = "ERP_УАТ" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.уатЗаказГрузоотправителя")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.уатМаршрутныйЛист")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.уатПутевойЛист") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
		Если ИмяКонфигурации <> "ERP_УАТ"
			И ТипЗнч(текДокОснование) = Тип("ДокументСсылка.уатПеремещениеТоваров") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
		Если ИмяКонфигурации = "УАТ_ПРОФ"
			И ТипЗнч(текДокОснование) = Тип("ДокументСсылка.уатЗаказПеревозчику_уэ") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "УТ"
		Или ИмяКонфигурации = "УПП"
		Или ИмяКонфигурации = "КА" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПеремещениеТоваров")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			
			ТребуетсяЭПД = Истина;
			
		КонецЕсли;
		
	Иначе
		
		ТребуетсяЭПД = Ложь;
		
	КонецЕсли;
	
	Если ТребуетсяЭПД = Истина Тогда 
		ТребуетсяЭПД = ВДокументеЕстьТовар(текДокОснование); 
	КонецЕсли;
	
	Возврат ТребуетсяЭПД;
	
КонецФункции

Функция ВДокументеЕстьТовар(текДокОснование)
	
	ЕстьТовар = Истина;
	
 	ИмяКонфигурации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ОпределитьКонфигурацию();

	Попытка
	
	Если ИмяКонфигурации = "УФ_БП" 
		Или ИмяКонфигурации = "БП"
		Или ИмяКонфигурации = "УТ"
		Или ИмяКонфигурации = "УПП"
		Или ИмяКонфигурации = "КА" Тогда 
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") 
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			
			ЕстьТовар = Ложь;
			Для Каждого строкаТЧТовары Из текДокОснование.Товары Цикл 
				Номенклатура = строкаТЧТовары.Номенклатура;
				ЭтоТовар = Не Номенклатура.Услуга;
				Если ЭтоТовар Тогда 
					ЕстьТовар = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "УФ_УТ" 
		ИЛИ ИмяКонфигурации = "ERP" 
		ИЛИ ИмяКонфигурации = "КА_2" Тогда
		
		Если ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику")
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ОтгрузкаТоваровСХранения") 
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") 
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.КорректировкаРеализации") 
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
			Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ПередачаТоваровХранителю") Тогда
			//Или ТипЗнч(текДокОснование) = Тип("ДокументСсылка.ОтгрузкаТоваровКлиенту") 
			
			ЕстьТовар = Ложь;
			Для Каждого строкаТЧТовары Из текДокОснование.Товары Цикл 
				Номенклатура = строкаТЧТовары.Номенклатура;
				ТипНоменклатуры = Номенклатура.ТипНоменклатуры;
				
				Если ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Товар")
					Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Набор")  
					Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МногооборотнаяТара") Тогда 
					ЕстьТовар = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ИмяКонфигурации = "КЛ" Тогда
		
			ЕстьТовар = Истина; // всегда требуется
			
	ИначеЕсли ИмяКонфигурации = "УФ_УНФ" Тогда
		
			ЕстьТовар = Истина; // всегда требуется
		
	ИначеЕсли ИмяКонфигурации = "УАТ" Тогда
		
			ЕстьТовар = Истина; // всегда требуется
		
	КонецЕсли;
	
	Исключение
		ЕстьТовар = истина;
	КонецПопытки;
	
	Возврат ЕстьТовар;
	
КонецФункции

Процедура ПринятьПереданныеОснованияКакОснованияЭПД(Знач МассивДокументовУчетнойСистемы, ТаблицаДокументовУчетнойСистемыДляЭПД)
	
	Для Каждого ДокументОснование Из МассивДокументовУчетнойСистемы Цикл
		
		Если УчетныйДокументПодразумеваетЭПД(ДокументОснование) Тогда
			Строка = ТаблицаДокументовУчетнойСистемыДляЭПД.Добавить();
			Строка.ДокументОснование = ДокументОснование;
			Строка.ДокументОснованиеЭПД = ДокументОснование;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьРасчетыСчетчиков(ВведеноЭПД, Вводов, ЕстьQR, Завершенных, Задач, Незавершенных, ВыполнитьОбменов, Знач СтрокаЭПД)
	
	Если ЗначениеЗаполнено(СтрокаЭПД.ДокументЭПД) Тогда
		ВведеноЭПД = ВведеноЭПД + 1;
	КонецЕсли;
	
	Если СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.Оформить Тогда 
		Задач = Задач + 1;
		Вводов = Вводов + 1;
	ИначеЕсли СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПродолжитьОформление Тогда 
		Задач = Задач + 1;
		Незавершенных = Незавершенных + 1; 
	ИначеЕсли СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.РаботаЗавершена Тогда 
		Завершенных = Завершенных + 1;
	Иначе
		Незавершенных = Незавершенных + 1; 
	КонецЕсли;
	
	Если СтрокаЭПД.Статус = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НайтиСостояниеДОПоКоду("on-the-way") Тогда
		ЕстьQR = Истина;
	КонецЕсли;

	Если СтрокаЭПД.ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ВыполнитьОбмен Тогда
		ВыполнитьОбменов = ВыполнитьОбменов + 1;
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьТребуемоеДействие(ДокументЭПД, СостояниеДО, НайденнаяСтрокаЭПД)
	
	ГОнаш = НайденнаяСтрокаЭПД.ГрузоотправительНаш;
	ПВнаш = НайденнаяСтрокаЭПД.ПеревозчикНаш;
	ГПнаш = НайденнаяСтрокаЭПД.ГрузополучательНаш;
	МедикНакш = НайденнаяСтрокаЭПД.МедикНаш;
	
	Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.ТребуемоеДействиеУчастникаПоСостоянию(
		СостояниеДО, ГОнаш, ПВнаш, ГПнаш, МедикНакш);
	
КонецФункции

