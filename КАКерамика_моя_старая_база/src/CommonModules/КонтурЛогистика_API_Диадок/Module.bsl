// Параметры:
//  ИНН - Строка
//  КПП - Строка - обязателен для ЮЛ (ИНН 10 символов)
//  FnsParticipantId - Строка - приоритет над ИНН/КПП, если заполнен
//
// Возвращаемое значение:
//  Структура - Status, Participants
//
Функция Диадок_АПИ_SearchFnsParticipants(ИНН = "", КПП = "", FnsParticipantId = "") Экспорт
	
	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииЛюбойОрганизации();
	Если ДанныеАутентификации = Неопределено Тогда
		ВызватьИсключение "Не найден ящик авторизованной организации Диадок для запроса в ФНС. Авторизуйтесь в модуле и повторите поиск.";
	КонецЕсли;
	
	myBoxId = ДанныеАутентификации.DiadocBoxId;
	
	Если Не ЗначениеЗаполнено(myBoxId) Тогда
		ВызватьИсключение "Не найден ящик авторизованной организации Диадок для запроса в ФНС. Авторизуйтесь в модуле и повторите поиск.";
	КонецЕсли;
	
	ПараметрыСервиса = ЛогистикаПараметрыСервиса_Диадок(myBoxId);
	
	SearchFnsParticipantsRequest = Новый Структура;
	Если ЗначениеЗаполнено(FnsParticipantId) Тогда
		SearchFnsParticipantsRequest.Вставить("FnsParticipantId", СокрЛП(FnsParticipantId));
	КонецЕсли;
	Если ЗначениеЗаполнено(ИНН) Тогда
		SearchFnsParticipantsRequest.Вставить("Inn", СокрЛП(ИНН));
	КонецЕсли;
	Если ЗначениеЗаполнено(КПП) Тогда
		SearchFnsParticipantsRequest.Вставить("Kpp", СокрЛП(КПП));
	КонецЕсли;
	
	Возврат Ядро().АПИ_SearchFnsParticipants(ПараметрыСервиса, myBoxId, SearchFnsParticipantsRequest);
	
КонецФункции

// Параметры:
//  FnsParticipantId - Строка - роуминговый идентификатор участника ЭДО
