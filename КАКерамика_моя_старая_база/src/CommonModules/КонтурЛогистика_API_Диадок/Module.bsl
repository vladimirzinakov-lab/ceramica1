Функция ФайлОбменаПоCustomData(ДанныеСобытия)
	
	ОтправленныйТитул = Неопределено;
	
	ДанныеПользователя = КонтурЛогистика_ОбработкаДокументовСервер.ДанныеПользователяИзСобытия(ДанныеСобытия);
	ИсходныйДокумент = ДанныеПользователя.Получить("kl-original-document");
	
	Если Не ЗначениеЗаполнено(ИсходныйДокумент) Тогда
		
		// отправка Т1 могла быть в апи логистики, тогда надо искать по kl-id среди Т1
		KlId = ДанныеПользователя.Получить("kl-id");
		
		Если ЗначениеЗаполнено(KlId) Тогда 
			ОтправленныйТитул = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбменаПоKl_id(KlId, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, Перечисления.КонтурЛогистика_СосотоянияФайловОбмена.Отправлен);
		КонецЕсли;
		
	Иначе
		
		// Имеем ветвление из-за разных форматов значения в сервисе
		Если Найти(ИсходныйДокумент, ",") = 0 Тогда
			
			ЧастиИсходного 
			= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ИсходныйДокумент, ":");
			MessageID  = ЧастиИсходного[0];
			DocumentId = ЧастиИсходного[1];
			
		Иначе
			
			ЧастиИсходного  
			= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ИсходныйДокумент, ",");
			ЧастиMessageID  
			= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ЧастиИсходного[0], ":");
			MessageID  = СокрЛП(ЧастиMessageID[1]);
			ЧастиDocumentId 
			= КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ЧастиИсходного[1], ":");
			DocumentId = СокрЛП(ЧастиDocumentId[1]);
			
		КонецЕсли;
		
		ОтправленныйТитул 
		= Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлОбмена(MessageID, DocumentId);
		
	КонецЕсли;
	Возврат ОтправленныйТитул;
	
КонецФункции

Функция ПолучитьИННОрганизацииИзXDTO(XDTO_УчастникТрНТип)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Если XDTO_УчастникТрНТип <> Неопределено Тогда 
		
		ИдСв = КС.XDTO_ПолучитьЗначениеСвойства(XDTO_УчастникТрНТип, "ИдСв");
		
		Если ИдСв <> Неопределено Тогда 
			
			СвЮЛУч 		= КС.XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвЮЛУч");
			СвИП 		= КС.XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвИП");
			СвФЛУчаст 	= КС.XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвФЛУчаст");
			СвИнНеУч 	= КС.XDTO_ПолучитьЗначениеСвойства(ИдСв, "СвИнНеУч");
			
			Если СвЮЛУч <> Неопределено Тогда 
				
				Возврат КС.XDTO_ПолучитьЗначениеСвойства(СвЮЛУч, "ИННЮЛ");
				
			ИначеЕсли СвИП <> Неопределено Тогда 
				
				Возврат КС.XDTO_ПолучитьЗначениеСвойства(СвИП, "ИННФЛ");
				
			ИначеЕсли СвФЛУчаст <> Неопределено Тогда 
				
				Возврат КС.XDTO_ПолучитьЗначениеСвойства(СвФЛУчаст, "ИННФЛ");
				
			ИначеЕсли СвИнНеУч <> Неопределено Тогда 
				
				Наим 	= КС.XDTO_ПолучитьЗначениеСвойства(СвИнНеУч, "Наим"); // для фл
				Идентиф	= КС.XDTO_ПолучитьЗначениеСвойства(СвИнНеУч, "Идентиф"); // для юл
				
				Если ЗначениеЗаполнено(Идентиф) Тогда 
					Возврат Идентиф;
				КонецЕсли;
				Если ЗначениеЗаполнено(Наим) Тогда 
					Возврат Наим;
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 

Функция ПолучитьВерсиюДокумента(Event)
	
	Если ТипЗнч(Event) = Тип("Структура")		
		И Event.Свойство("Document")
		И Event.Document.Свойство("DocumentInfo")
		И Event.Document.DocumentInfo.Свойство("FullVersion")
		И Event.Document.DocumentInfo.FullVersion.Свойство("Version") Тогда
		Возврат Event.Document.DocumentInfo.FullVersion.Version
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

// Во избежание конфликтов при выполнении разными регламентными заданиями, производит блокировку 
// справочника ВидыПроверки по переданным параметрам выполнения проверки.
//
// Параметры:
//   ФайлОбменаСсылка - ссылка на файл обмена.
//
// Возвращаемое значение:
//   БлокировкаДанных  - объект блокировки справочника КонтурЛогистика_ФайлыОбмена.
//
Функция БлокировкаФайлаОбмена(ФайлОбменаСсылка)
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.КонтурЛогистика_ФайлыОбмена");
	ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ФайлОбменаСсылка);
	
	Возврат БлокировкаДанных;
	
КонецФункции

#КонецОбласти