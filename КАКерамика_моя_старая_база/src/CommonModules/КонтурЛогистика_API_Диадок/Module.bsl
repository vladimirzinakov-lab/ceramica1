Функция Пакеты_ОтправитьPostMessage(ФайлСсылка, MessageToPost, OperationId)
		
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	
	Отказ = Ложь;
	
	ПараметрыСервиса = ЛогистикаПараметрыСервиса_Диадок(ФайлСсылка.Отправитель.ID);
	
	Попытка
		
		РезультатОтправки = Ядро().АПИ_PostMessage(ПараметрыСервиса, MessageToPost, OperationId);
		
		Если РезультатОтправки.Свойство("КодОтветаДопустимый") И РезультатОтправки.КодОтветаДопустимый Тогда
			Результат.Успешно = Истина;
		Иначе
			Результат.Успешно = Ложь;
			
			ПодробнаяОшибка = РезультатОтправки.ПодробноеОписаниеОшибки;
			
			ВидОперации		= "Отправка пакета документов";
			Представление	= "" + ФайлСсылка.ТипДокумента + " номер " + ФайлСсылка.Код;
			ТекстОшибки		= "Пакет: %1 Не удалось отправить пакет документов: %2";
			ТекстОшибки		= Ядро().Общее_ПодставитьПараметрыВСтроку(ТекстОшибки, Представление, ПодробнаяОшибка);
			
			Результат.ОписаниеОшибки = ТекстОшибки;
			
		КонецЕсли;
				
	Исключение
		
		РезультатОтправки = Неопределено;
		
		Ошибка			= ИнформацияОбОшибке();
		ПодробнаяОшибка	= ПодробноеПредставлениеОшибки(Ошибка);
		
		ВидОперации		= "Отправка пакета документов";
		Представление	= "" + ФайлСсылка.ТипДокумента + " номер " + ФайлСсылка.Код;
		ТекстОшибки		= "Пакет: %1 Не удалось отправить пакет документов: %2";
		ТекстОшибки		= Ядро().Общее_ПодставитьПараметрыВСтроку(ТекстОшибки, Представление, ПодробнаяОшибка);
		
		Результат.ОписаниеОшибки = ТекстОшибки;
		Результат.Успешно = Ложь;
		
		// TODO реализовать метрики
		//Ошибка_Обработать(ВидОперации, ТекстОшибки);
		
		//КатегорияМетрики	= Метрика_НазваниеКатегории().ОтправкаДокумента;
		//ДействиеМетрики		= "Исходящие";

		//Метрика_ДобавитьОшибку_ДляОрганизации(Пакет.Идентификаторы.BoxId, КатегорияМетрики, ДействиеМетрики, ТекстОшибки);				
		
	КонецПопытки;
	
	Результат.Вставить("РезультатОтправки", РезультатОтправки);
	
	Возврат Результат;
	
КонецФункции

