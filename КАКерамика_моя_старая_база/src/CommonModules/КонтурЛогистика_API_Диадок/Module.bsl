	ДанныеАутентификации = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ДанныеАутентификацииЛюбойОрганизации();
	Если ДанныеАутентификации = Неопределено Тогда
		ВызватьИсключение "Не найден ящик авторизованной организации Диадок для создания роумингового ящика. Авторизуйтесь в модуле и повторите действие.";
	КонецЕсли;
	
	myBoxId = ДанныеАутентификации.DiadocBoxId;
	
	Если Не ЗначениеЗаполнено(myBoxId) Тогда
		ВызватьИсключение "Не найден ящик авторизованной организации Диадок для создания роумингового ящика. Авторизуйтесь в модуле и повторите действие.";
	КонецЕсли;
	
	ПараметрыСервиса = ЛогистикаПараметрыСервиса_Диадок(myBoxId);
	
	GetOrCreateRequest = Новый Структура;
	GetOrCreateRequest.Вставить("FnsParticipantId", СокрЛП(FnsParticipantId));
	
	Возврат Ядро().АПИ_GetOrCreateRoamingOrganizationByFnsParticipantId(
		ПараметрыСервиса, myBoxId, GetOrCreateRequest);
	
