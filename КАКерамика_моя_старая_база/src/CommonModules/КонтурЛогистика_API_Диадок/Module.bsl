Функция СформироватьДвоичныеДанныеКонтента(ТекстXML) Экспорт
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
	
	Если Найти(НРег(ТекстXML), "utf-8") = 0 Тогда
		ТипКодировки = "windows-1251";
		ДобавлятьBOM = Ложь;
	Иначе
		ТипКодировки = "utf-8";
		ДобавлятьBOM = Истина;
	КонецЕсли;
	
	ЗаписьXml = Новый ЗаписьXML;
	ЗаписьXml.ОткрытьФайл(ИмяВремФайла, ТипКодировки, ДобавлятьBOM);
	ЗаписьXml.ЗаписатьБезОбработки(ТекстXML);
	ЗаписьXml.Закрыть();
	
	ДвоичныеДанныеКонтента = Новый ДвоичныеДанные(ИмяВремФайла);
	
	УдалитьФайлы(ИмяВремФайла);
	
	Возврат ДвоичныеДанныеКонтента;
	
КонецФункции

// Преобразует идентификатор в адрес ящика в Диадоке
// 
// Параметры:
//  ИД - Строка - идентификатор ящика.
// 
// Возвращаемое значение:
//   Строка - адрес ящика.
//
Функция ИдентификаторВАдресЯщика(ИД) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ИД) Тогда
		
		ДлинаИД = СтрДлина(ИД);
		
		Если ДлинаИД = 32 Тогда 
			
			Результат = ИД + "@diadoc.ru";
			
		ИначеЕсли ДлинаИД = 36 Тогда
			
			Результат = СтрЗаменить(ИД, "-", "") + "@diadoc.ru";
			
		ИначеЕсли ДлинаИД = 42 Тогда
			
			Результат = ИД;
			
		Иначе
			
			ТекстОшибки = Ядро().Общее_ПодставитьПараметрыВСтроку(НСтр(
			"ru = 'Некорректный идентификатор ящика %1'"), ИД);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует идентификатор в адрес ящика в Диадоке
// 
// Параметры:
//  ИД - Строка - идентификатор ящика.
// 
// Возвращаемое значение:
//   Строка - адрес ящика.
//
Функция АдресЯщикаВИдентификатор(АдресЯщика) Экспорт
	
	ИД			 = СтрЗаменить(АдресЯщика, "@diadoc.ru", "");
	ДлинаИД		 = СтрДлина(ИД);
	Результат	 = "";
	
	Если ДлинаИД = 32 Тогда// 00000000000000000000000000000000
		
		Результат = Сред(ИД, 1, 8)
		+ "-" + Сред(ИД, 9, 4)
		+ "-" + Сред(ИД, 13, 4)
		+ "-" + Сред(ИД, 17, 4)
		+ "-" + Сред(ИД, 21, 12);
		
	ИначеЕсли ДлинаИД = 36 Тогда // 00000000-0000-0000-0000-000000000000
		
		Результат = ИД;
		
	Иначе
		
		ТекстОшибки = Ядро().Общее_ПодставитьПараметрыВСтроку(НСтр(
		"ru = 'Некорректный адрес ящика %1'"), АдресЯщика);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

