#Область ПрограммныйИнтерфейс

// Возвращает инициализированный клиент API ФИАС/ГАР.
//
// Параметры:
//  ОрганизацияДиадок - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - источник ключа API.
//
// Возвращаемое значение:
//  ОбработкаОбъект.КонтурЛогистика_ФиасКлиент - клиент API.
//
Функция СоздатьКлиентФИАС(ОрганизацияДиадок = Неопределено) Экспорт
	
	Клиент = Обработки.КонтурЛогистика_ФиасКлиент.Создать();
	Параметры = Клиент.ФиасПараметры();
	
	КлючАПИ = КлючАПИФИАС(ОрганизацияДиадок);
	Если ЗначениеЗаполнено(КлючАПИ) Тогда
		Параметры.КлючАПИ = КлючАПИ;
	КонецЕсли;
	
	Возврат Клиент.Фиас(Параметры);
	
КонецФункции

// Возвращает человекочитаемое представление адреса по коду ГАР/ФИАС.
//
// Параметры:
//  КодГАР - Строка - идентификатор ФИАС/ГАР.
//  ОрганизацияДиадок - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - источник ключа API.
//
// Возвращаемое значение:
//  Строка - нормализованное представление адреса или пустая строка.
//
Функция ПредставлениеПоКодуГАР(КодГАР, ОрганизацияДиадок = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(КодГАР) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		
		Клиент = СоздатьКлиентФИАС(ОрганизацияДиадок);
		Запрос = Клиент.ЗапросПолучитьАдрес();
		Запрос.ИдентификаторФИАС = КодГАР;
		Запрос.ПолныйАдрес = Истина;
		АдресФИАС = Клиент.ПолучитьАдрес(Запрос);
		
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат ПредставлениеИзАдресаФИАС(АдресФИАС);
	
КонецФункции

// Нормализует адресные данные через API ФИАС/ГАР.
//
// Параметры:
//  Вход - Структура - адресные поля (КодГАР, АдресПредставление, АдресИнфАдрес, КЛАДР-поля и т.п.).
//  ОрганизацияДиадок - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - источник ключа API.
//
// Возвращаемое значение:
//  Структура - КодГАР, АдресПредставление и при необходимости КЛАДР-поля.
//
Функция НормализоватьАдрес(Вход, ОрганизацияДиадок = Неопределено) Экспорт
	
	Результат = НовыйРезультатНормализации();
	Если Вход = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗаполнитьРезультатИзВхода(Результат, Вход);
	СнимокВхода = КопияРезультатаНормализации(Результат);
	
	Если ЗначениеЗаполнено(Результат.КодГАР) Тогда
		ДополнитьРезультатПоКодуГАР(Результат, ОрганизацияДиадок);
		Возврат Результат;
	КонецЕсли;
	
	Если ЕстьКЛАДРПоля(Вход) Тогда
		ДополнитьРезультатВерификациейКЛАДР(Результат, Вход, ОрганизацияДиадок);
		Если Не АдресНайденТочноПоФИАС(СнимокВхода, Результат) Тогда
			ОставитьАдресКакСвободнуюФорму(Результат, СнимокВхода);
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.КодГАР) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ТекстАдреса = ТекстАдресаИзВхода(Вход);
	Если ЗначениеЗаполнено(ТекстАдреса) Тогда
		ДополнитьРезультатРаспознаваниемТекста(Результат, ТекстАдреса, ОрганизацияДиадок);
		Если Не АдресНайденТочноПоФИАС(СнимокВхода, Результат) Тогда
			ОставитьАдресКакСвободнуюФорму(Результат, СнимокВхода);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разворачивает адрес ГАР через API ФИАС, если сохраненная структура пустая или неполная.
//
// Параметры:
//  КодГАР - Строка - идентификатор ФИАС/ГАР.
//  АдресГАРЗначение - Строка - сохраненное JSON-значение адреса.
//  ОрганизацияДиадок - СправочникСсылка.КонтурЛогистика_ОрганизацииДиадок - источник ключа API.
//
// Возвращаемое значение:
//  Структура - результат НормализоватьАдрес (КодГАР, АдресГАРЗначение, представление, поля КЛАДР).
//
Функция РазвернутьАдресГАР(КодГАР, АдресГАРЗначение = "", ОрганизацияДиадок = Неопределено) Экспорт
	
	Результат = НовыйРезультатНормализации();
	Результат.КодГАР = КодГАР;
	Результат.АдресГАРЗначение = АдресГАРЗначение;
	
	Если Не ЗначениеЗаполнено(КодГАР) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если КонтурЛогистика_ВводАдреса.СтруктураАдресаГАРПолная(АдресГАРЗначение) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Вход = Новый Структура;
	Вход.Вставить("КодГАР", КодГАР);
	Вход.Вставить("АдресГАРЗначение", АдресГАРЗначение);
	
	Возврат НормализоватьАдрес(Вход, ОрганизацияДиадок);
	
КонецФункции

// Заполняет реквизиты пункта маршрута из результата нормализации.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута - заполняемый объект.
//  Результат - Структура - результат НормализоватьАдрес.
//
Процедура ЗаполнитьПунктМаршрута(Объект, Результат) Экспорт
	
	Если Объект = Неопределено Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.КодГАР) Тогда
		Объект.КодГАР = Результат.КодГАР;
		Если ЗначениеЗаполнено(Результат.АдресГАРЗначение) Тогда
			Объект.АдресГАРЗначение = Результат.АдресГАРЗначение;
		КонецЕсли;
	Иначе
		Объект.КодГАР = "";
		Объект.АдресГАРЗначение = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.АдресПредставление) Тогда
		Объект.АдресПредставление = Результат.АдресПредставление;
		Если Не ЗначениеЗаполнено(Объект.АдресИнфАдрес)
			Или ЭтоСлабоеПредставлениеАдресаГАР(Объект.АдресИнфАдрес, Результат.КодГАР) Тогда
			Объект.АдресИнфАдрес = Результат.АдресПредставление;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьКЛАДРПоляОбъекта(Объект, Результат,
		ЗначениеЗаполнено(Результат.КодГАР) И ЗначениеЗаполнено(Результат.АдресКодРегион));
	
КонецПроцедуры

// Заполняет адресные реквизиты организации из результата нормализации.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ОрганизацииДиадок - заполняемый объект.
//  Результат - Структура - результат НормализоватьАдрес.
//
Процедура ЗаполнитьОрганизацию(Объект, Результат) Экспорт
	
	Если Объект = Неопределено Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.КодГАР) Тогда
		Объект.АдресКодГАР = Результат.КодГАР;
		Если ЗначениеЗаполнено(Результат.АдресГАРЗначение) Тогда
			Объект.АдресГАРЗначение = Результат.АдресГАРЗначение;
		КонецЕсли;
	Иначе
		Объект.АдресКодГАР = "";
		Объект.АдресГАРЗначение = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.АдресПредставление) Тогда
		Объект.АдресПредставление = Результат.АдресПредставление;
	КонецЕсли;
	
	ЗаполнитьКЛАДРПоляОрганизации(Объект, Результат,
		ЗначениеЗаполнено(Результат.КодГАР) И ЗначениеЗаполнено(Результат.АдресКодРегион));
	
КонецПроцедуры

// Заполняет адресные реквизиты подразделения из результата нормализации.
//
// Параметры:
//  Объект - СправочникОбъект.КонтурЛогистика_ПодразделенияДиадок - заполняемый объект.
//  Результат - Структура - результат НормализоватьАдрес.
//
Процедура ЗаполнитьПодразделение(Объект, Результат) Экспорт
	
	Если Объект = Неопределено Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.КодГАР) Тогда
		Объект.АдресКодГАР = Результат.КодГАР;
		Если ЗначениеЗаполнено(Результат.АдресГАРЗначение) Тогда
			Объект.АдресГАРЗначение = Результат.АдресГАРЗначение;
		КонецЕсли;
	Иначе
		Объект.АдресКодГАР = "";
		Объект.АдресГАРЗначение = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.АдресПредставление) Тогда
		Объект.АдресПредставление = Результат.АдресПредставление;
	КонецЕсли;
	
	ЗаполнитьКЛАДРПоляПодразделения(Объект, Результат,
		ЗначениеЗаполнено(Результат.КодГАР) И ЗначениеЗаполнено(Результат.АдресКодРегион));
	
КонецПроцедуры

// Формирует структуру входа для нормализации из пункта маршрута.
//
// Параметры:
//  Данные - СправочникОбъект.КонтурЛогистика_ПунктыМаршрута, Структура - источник адресных полей.
//
// Возвращаемое значение:
//  Структура - вход для НормализоватьАдрес.
//
Функция ВходИзПунктаМаршрута(Данные) Экспорт
	
	Вход = Новый Структура;
	Вход.Вставить("КодГАР", ЗначениеРеквизита(Данные, "КодГАР"));
	Вход.Вставить("АдресПредставление", ЗначениеРеквизита(Данные, "АдресПредставление"));
	Вход.Вставить("АдресИнфАдрес", ЗначениеРеквизита(Данные, "АдресИнфАдрес"));
	Вход.Вставить("АдресИндекс", ЗначениеРеквизита(Данные, "АдресИндекс"));
	Вход.Вставить("АдресКодРегион", ЗначениеРеквизита(Данные, "АдресКодРегион"));
	Вход.Вставить("АдресРайон", ЗначениеРеквизита(Данные, "АдресРайон"));
	Вход.Вставить("АдресГород", ЗначениеРеквизита(Данные, "АдресГород"));
	Вход.Вставить("АдресНаселПункт", ЗначениеРеквизита(Данные, "АдресНаселПункт"));
	Вход.Вставить("АдресУлица", ЗначениеРеквизита(Данные, "АдресУлица"));
	Вход.Вставить("АдресДом", ЗначениеРеквизита(Данные, "АдресДом"));
	Вход.Вставить("АдресКорпус", ЗначениеРеквизита(Данные, "АдресКорпус"));
	Вход.Вставить("АдресКварт", ЗначениеРеквизита(Данные, "АдресКварт"));
	Вход.Вставить("АдресГАРЗначение", ЗначениеРеквизита(Данные, "АдресГАРЗначение"));
	
	Возврат Вход;
	
КонецФункции

