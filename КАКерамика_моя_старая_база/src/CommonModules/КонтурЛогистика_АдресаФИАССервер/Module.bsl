// Определяет, нужно ли обращаться к API ФИАС при записи объекта.
//
// Параметры:
//  Вход - Структура - текущие адресные поля.
//  ПредыдущийВход - Структура, Неопределено - адресные поля до изменения.
//
// Возвращаемое значение:
//  Булево - Истина, если требуется нормализация.
//
Функция ТребуетсяНормализацияАдреса(Вход, ПредыдущийВход = Неопределено) Экспорт
	
	Если Вход = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЕстьАдресныеДанныеДляНормализации(Вход) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вход.КодГАР) Тогда
		
		Если ПредыдущийВход <> Неопределено
			И СокрЛП(Вход.КодГАР) <> СокрЛП(ЗначениеРеквизита(ПредыдущийВход, "КодГАР")) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ПредыдущийВход = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Вход.АдресКодРегион) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если Не КонтурЛогистика_ВводАдреса.СтруктураАдресаГАРПолная(ЗначениеРеквизита(Вход, "АдресГАРЗначение")) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Возврат ЭтоСлабоеПредставлениеАдресаГАР(Вход.АдресПредставление, Вход.КодГАР);
	КонецЕсли;
	
	Если Не ЕстьКЛАДРПоля(Вход) И Не ЗначениеЗаполнено(ТекстАдресаИзВхода(Вход)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПредыдущийВход = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПредыдущийВход.КодГАР) И АдресныеПоляНормализацииНеИзменились(Вход, ПредыдущийВход) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если АдресныеПоляНормализацииИзменились(Вход, ПредыдущийВход) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ЭтоСлабоеПредставлениеАдресаГАР(Вход.АдресПредставление, "");
	
КонецФункции

// Определяет, что текстовое представление адреса не пригодно для отображения.
//
// Параметры:
//  ТекстАдреса - Строка - представление адреса.
//  КодГАР - Строка - код ГАР для сравнения со слабым представлением.
//
// Возвращаемое значение:
//  Булево - Истина, если представление слабое.
//
Функция ЭтоСлабоеПредставлениеАдресаГАР(ТекстАдреса, КодГАР) Экспорт
	
	Если Не ЗначениеЗаполнено(ТекстАдреса) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодГАР) И СокрЛП(ТекстАдреса) = СокрЛП(КодГАР) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрНачинаетсяСЛок(СокрЛП(ТекстАдреса), "Код ГАР:");
	
КонецФункции

// Возвращает текст свободной формы адреса для тега АдрТекст.
//
// Параметры:
//  АдресИнфАдрес - Строка - исходный свободный адрес.
//  АдресПредставление - Строка - текстовое представление адреса.
//  КодГАР - Строка - код ГАР для отсечения слабого представления.
//
// Возвращаемое значение:
//  Строка - текст для выгрузки в XML.
//
Функция ТекстАдресаДляВыгрузкиВXML(АдресИнфАдрес, АдресПредставление, КодГАР = "") Экспорт
	
	ТекстИнф = СокрЛП(Строка(АдресИнфАдрес));
	Если Не ЭтоСлабоеПредставлениеАдресаГАР(ТекстИнф, КодГАР) Тогда
		Возврат ТекстИнф;
	КонецЕсли;
	
	ТекстПредставление = СокрЛП(Строка(АдресПредставление));
	Если Не ЭтоСлабоеПредставлениеАдресаГАР(ТекстПредставление, КодГАР) Тогда
		Возврат ТекстПредставление;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстИнф) Тогда
		Возврат ТекстИнф;
	КонецЕсли;
	
	Возврат ТекстПредставление;
	
КонецФункции

// Определяет, что сохраненный адрес является точным совпадением ФИАС/ГАР.
//
// Параметры:
//  ДанныеАдреса - Структура - КодГАР, АдресГАРЗначение, АдресДом, АдресКорпус,
//                             АдресИнфАдрес, АдресПредставление, АдресИндекс.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес найден точно и может быть выгружен структурой ГАР/ФИАС.
//
Функция АдресЯвляетсяТочнымФИАС(ДанныеАдреса) Экспорт
	
	Если ДанныеАдреса = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита(ДанныеАдреса, "КодГАР")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат АдресНайденТочноПоФИАС(ДанныеАдреса, ДанныеАдреса);
	
КонецФункции

// Собирает текстовое представление из структуры адреса API ФИАС.
//
// Параметры:
//  АдресФИАС - Структура - адрес, полученный от API ФИАС.
//
// Возвращаемое значение:
//  Строка - представление адреса.
//
Функция ПредставлениеИзАдресаФИАС(АдресФИАС) Экспорт
	
	Если АдресФИАС = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЧастиАдреса = Новый Массив;
	ИменаКомпонентов = ИменаКомпонентовАдресаФИАС();
	
	Для Каждого ИмяКомпонента Из ИменаКомпонентов Цикл
		ДобавитьКомпонентАдресаФИАС(ЧастиАдреса, АдресФИАС[ИмяКомпонента]);
	КонецЦикла;
	
	Возврат КонтурЛогистика_СтдСтрКлиентСервер.СтрСоединитьЛок(ЧастиАдреса, ", ");
	
КонецФункции

// Извлекает код ГАР/ФИАС из структуры адреса API.
//
// Параметры:
//  АдресФИАС - Структура - адрес, полученный от API ФИАС.
//
// Возвращаемое значение:
//  Строка - идентификатор ФИАС/ГАР.
//
Функция ИдентификаторФИАСИзАдреса(АдресФИАС) Экспорт
	
	Если АдресФИАС = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИменаКомпонентов = ИменаКомпонентовАдресаФИАС();
	ИменаКомпонентов.Добавить("Помещение");
	ИменаКомпонентов.Добавить("ДомГАР");
	ИменаКомпонентов.Добавить("Дом");
	
	Для Индекс = ИменаКомпонентов.Количество() - 1 По 0 Цикл
		
		Компонент = АдресФИАС[ИменаКомпонентов[Индекс]];
		Идентификатор = ИдентификаторФИАСИзКомпонента(Компонент);
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Возврат Идентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючАПИФИАС(ОрганизацияДиадок)
	
	Возврат КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ApiKeyЛогистика(ОрганизацияДиадок);
	
КонецФункции

Функция НовыйРезультатНормализации()
	
	Результат = Новый Структура;
	Результат.Вставить("КодГАР", "");
	Результат.Вставить("АдресГАРЗначение", "");
	Результат.Вставить("АдресПредставление", "");
	Результат.Вставить("АдресИндекс", "");
	Результат.Вставить("АдресКодРегион", "");
	Результат.Вставить("АдресРайон", "");
	Результат.Вставить("АдресГород", "");
	Результат.Вставить("АдресНаселПункт", "");
	Результат.Вставить("АдресУлица", "");
	Результат.Вставить("АдресДом", "");
	Результат.Вставить("АдресКорпус", "");
	Результат.Вставить("АдресКварт", "");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРезультатИзВхода(Результат, Вход)
	
	ИменаПолей = "КодГАР, АдресГАРЗначение, АдресПредставление, АдресИндекс, АдресКодРегион, АдресРайон, АдресГород,
		|АдресНаселПункт, АдресУлица, АдресДом, АдресКорпус, АдресКварт";
	
	Для Каждого ИмяПоля Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ИменаПолей, ",", Истина) Цикл
		
		ИмяПоля = СокрЛП(ИмяПоля);
		Если Вход.Свойство(ИмяПоля) И ЗначениеЗаполнено(Вход[ИмяПоля]) Тогда
			Результат[ИмяПоля] = Вход[ИмяПоля];
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Результат.АдресПредставление) И Вход.Свойство("АдресИнфАдрес") Тогда
		Результат.АдресПредставление = Вход.АдресИнфАдрес;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьРезультатПоКодуГАР(Результат, ОрганизацияДиадок)
	
	СохраненноеПредставление = Результат.АдресПредставление;
	СохраненныйКодГАР = Результат.КодГАР;
	ОчиститьКЛАДРПоляРезультата(Результат);
	Результат.КодГАР = СохраненныйКодГАР;
	Результат.АдресПредставление = СохраненноеПредставление;
	
	Попытка
		
		Клиент = СоздатьКлиентФИАС(ОрганизацияДиадок);
		Запрос = Клиент.ЗапросПолучитьАдрес();
		Запрос.ИдентификаторФИАС = Результат.КодГАР;
		Запрос.ПолныйАдрес = Истина;
		АдресФИАС = Клиент.ПолучитьАдрес(Запрос);
		
	Исключение
		Возврат;
	КонецПопытки;
	
	Если АдресФИАС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРезультатИзАдресаФИАС(Результат, АдресФИАС);
	
	Если Не ЭтоСлабоеПредставлениеАдресаГАР(СохраненноеПредставление, Результат.КодГАР) Тогда
		Результат.АдресПредставление = СохраненноеПредставление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьКЛАДРПоляРезультата(Результат)
	
	Результат.АдресИндекс = "";
	Результат.АдресКодРегион = "";
	Результат.АдресРайон = "";
	Результат.АдресГород = "";
	Результат.АдресНаселПункт = "";
	Результат.АдресУлица = "";
	Результат.АдресДом = "";
	Результат.АдресКорпус = "";
	Результат.АдресКварт = "";
	
КонецПроцедуры

Функция КопияРезультатаНормализации(Результат)
	
	Копия = НовыйРезультатНормализации();
	ЗаполнитьЗначенияСвойств(Копия, Результат);
	Возврат Копия;
	
КонецФункции

Процедура ОставитьАдресКакСвободнуюФорму(Результат, СнимокВхода)
	
	ЗаполнитьЗначенияСвойств(Результат, СнимокВхода);
	Результат.КодГАР = "";
	Результат.АдресГАРЗначение = "";
	
КонецПроцедуры

Функция АдресНайденТочноПоФИАС(ИсходныеДанные, ДанныеФИАС)
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита(ДанныеФИАС, "КодГАР")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если УровеньДетализацииАдресаКЛАДР(ДанныеФИАС) < УровеньДетализацииАдресаКЛАДР(ИсходныеДанные) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстАдреса = ТекстИсходногоАдреса(ИсходныеДанные);
	Если ТекстСодержитУточнениеЗдания(ТекстАдреса) И Не АдресСодержитЗдание(ДанныеФИАС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекстСодержитПочтовыйИндекс(ТекстАдреса) И Не ЗначениеЗаполнено(ЗначениеРеквизита(ДанныеФИАС, "АдресИндекс")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита(ИсходныеДанные, "КодГАР"))
		И УровеньДетализацииАдресаКЛАДР(ИсходныеДанные) = 0
		И Не АдресСодержитЗдание(ДанныеФИАС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстИнф = СокрЛП(Строка(ЗначениеРеквизита(ИсходныеДанные, "АдресИнфАдрес")));
	ТекстПредставление = СокрЛП(Строка(ЗначениеРеквизита(ИсходныеДанные, "АдресПредставление")));
	КодГАР = ЗначениеРеквизита(ДанныеФИАС, "КодГАР");
	Если ЗначениеЗаполнено(ТекстИнф)
		И Не ЭтоСлабоеПредставлениеАдресаГАР(ТекстИнф, КодГАР)
		И ЗначениеЗаполнено(ТекстПредставление)
		И ТекстИнф <> ТекстПредставление
		И Не АдресСодержитЗдание(ДанныеФИАС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ТекстИсходногоАдреса(Данные)
	
	ТекстИнф = СокрЛП(Строка(ЗначениеРеквизита(Данные, "АдресИнфАдрес")));
	Если ЗначениеЗаполнено(ТекстИнф) Тогда
		Возврат ТекстИнф;
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеРеквизита(Данные, "АдресПредставление")));
	
КонецФункции

Функция АдресСодержитЗдание(Данные)
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресДом"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресКорпус")) Тогда
		Возврат Истина;
	КонецЕсли;
	
	АдресГАР = КонтурЛогистика_ВводАдреса.СтруктураАдресаГАРИзЗначения(ЗначениеРеквизита(Данные, "АдресГАРЗначение"));
	Если АдресГАР = Неопределено Или ТипЗнч(АдресГАР) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаУровней = "Здания, ЗемелУчасток, ПомещЗдания";
	Для Каждого ИмяУровня Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ИменаУровней, ",", Истина) Цикл
		ИмяУровня = СокрЛП(ИмяУровня);
		Если АдресГАР.Свойство(ИмяУровня) И ЗначениеЗаполнено(АдресГАР[ИмяУровня]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТекстСодержитУточнениеЗдания(ТекстАдреса)
	
	Если Не ЗначениеЗаполнено(ТекстАдреса) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НормализованныйТекст = " " + НРег(СокрЛП(ТекстАдреса)) + " ";
	Маркеры = " корпус , корп., корп , строение , зд., лит., тер., тер, тер ";
	Для Каждого Маркер Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(Маркеры, ",", Истина) Цикл
		Если КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(НормализованныйТекст, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТекстСодержитПочтовыйИндекс(ТекстАдреса)
	
	Если Не ЗначениеЗаполнено(ТекстАдреса) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЧастиАдреса = КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ТекстАдреса, ",", Истина);
	Для Каждого ЧастьАдреса Из ЧастиАдреса Цикл
		ЧастьАдреса = СокрЛП(ЧастьАдреса);
		Если СтрДлина(ЧастьАдреса) = 6
			И КонтурЛогистика_СтдСтрКлиентСервер.ТолькоЦифрыВСтрокеЛок(ЧастьАдреса) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция УровеньДетализацииАдресаКЛАДР(Данные)
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресДом"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресКорпус"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресКварт")) Тогда
		Возврат 4;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресУлица")) Тогда
		Возврат 3;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресГород"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресНаселПункт")) Тогда
		Возврат 2;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита(Данные, "АдресРайон")) Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ЕстьКЛАДРПоля(Вход)
	
	Возврат ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресКодРегион"))
		И (ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресГород"))
			Или ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресНаселПункт")))
		И ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресУлица"))
		И ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресДом"));
	
КонецФункции

Функция ЕстьАдресныеДанныеДляНормализации(Вход)
	
	Возврат ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "КодГАР"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресПредставление"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресИнфАдрес"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресКодРегион"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресГород"))
		Или ЗначениеЗаполнено(ЗначениеРеквизита(Вход, "АдресНаселПункт"));
	
КонецФункции

Функция АдресныеПоляНормализацииИзменились(Вход, ПредыдущийВход)
	
	ИменаПолей = "КодГАР, АдресГАРЗначение, АдресПредставление, АдресИнфАдрес, АдресИндекс, АдресКодРегион, АдресРайон, АдресГород,
		|АдресНаселПункт, АдресУлица, АдресДом, АдресКорпус, АдресКварт";
	
	Для Каждого ИмяПоля Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ИменаПолей, ",", Истина) Цикл
		
		ИмяПоля = СокрЛП(ИмяПоля);
		ТекущееЗначение = ЗначениеРеквизита(Вход, ИмяПоля);
		ПредыдущееЗначение = ЗначениеРеквизита(ПредыдущийВход, ИмяПоля);
		
		Если СокрЛП(Строка(ТекущееЗначение)) <> СокрЛП(Строка(ПредыдущееЗначение)) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция АдресныеПоляНормализацииНеИзменились(Вход, ПредыдущийВход)
	
	Возврат Не АдресныеПоляНормализацииИзменились(Вход, ПредыдущийВход);
	
КонецФункции

Функция ТекстАдресаИзВхода(Вход)
	
	Если Вход.Свойство("АдресПредставление") И ЗначениеЗаполнено(Вход.АдресПредставление) Тогда
		Возврат Вход.АдресПредставление;
	КонецЕсли;
	
	Если Вход.Свойство("АдресИнфАдрес") И ЗначениеЗаполнено(Вход.АдресИнфАдрес) Тогда
		Возврат Вход.АдресИнфАдрес;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ДополнитьРезультатВерификациейКЛАДР(Результат, Вход, ОрганизацияДиадок)
	
	Попытка
		
		Клиент = СоздатьКлиентФИАС(ОрганизацияДиадок);
		АдресВерификации = АдресВерификацииИзВхода(Вход);
		
		Запрос = Клиент.ЗапросВерифицироватьАдреса();
		Запрос.Адреса.Добавить(АдресВерификации);
		Ответ = Клиент.ВерифицироватьАдреса(Запрос);
		
		Если Ответ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаОтвета = Ответ[0];
		Если СтрокаОтвета.Адрес = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если Не СтрокаОтвета.Валиден Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьРезультатИзАдресаФИАС(Результат, СтрокаОтвета.Адрес);
		
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДополнитьРезультатРаспознаваниемТекста(Результат, ТекстАдреса, ОрганизацияДиадок)
	
	Попытка
		
		Клиент = СоздатьКлиентФИАС(ОрганизацияДиадок);
		Запрос = Клиент.ЗапросРаспознатьАдресаВТексте();
		Запрос.Адреса.Добавить(ТекстАдреса);
		Ответ = Клиент.РаспознатьАдресаВТексте(Запрос);
		
		Если Ответ.Количество() = 0 Или Ответ[0].Кандидаты.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Кандидат = Ответ[0].Кандидаты[0];
		Если Кандидат.Адрес <> Неопределено Тогда
			ЗаполнитьРезультатИзАдресаФИАС(Результат, Кандидат.Адрес);
		КонецЕсли;
		
		Если Кандидат.Описание <> Неопределено
			И ЗначениеЗаполнено(Кандидат.Описание.Подсказка)
			И Не ЗначениеЗаполнено(Результат.АдресПредставление) Тогда
			Результат.АдресПредставление = Кандидат.Описание.Подсказка;
		КонецЕсли;
		
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция АдресВерификацииИзВхода(Вход)
	
	Адрес = Новый Структура;
	
	Если ЗначениеЗаполнено(Вход.АдресКодРегион) Тогда
		НаименованиеРегиона = КонтурЛогистика_ВводАдреса.НаименованиеРегионаПоКоду(Вход.АдресКодРегион);
		Если Не ЗначениеЗаполнено(НаименованиеРегиона) Тогда
			НаименованиеРегиона = Вход.АдресКодРегион;
		КонецЕсли;
		Адрес.Вставить("Регион", Новый Структура("Наименование", НаименованиеРегиона));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вход.АдресРайон) Тогда
		Адрес.Вставить("Район", Новый Структура("Наименование", Вход.АдресРайон));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вход.АдресГород) Тогда
		Адрес.Вставить("Город", Новый Структура("Наименование", Вход.АдресГород));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вход.АдресНаселПункт) Тогда
		Адрес.Вставить("НаселенныйПункт", Новый Структура("Наименование", Вход.АдресНаселПункт));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вход.АдресУлица) Тогда
		Адрес.Вставить("Улица", Новый Структура("Наименование", Вход.АдресУлица));
	КонецЕсли;
	
	Дом = Новый Структура;
	Если ЗначениеЗаполнено(Вход.АдресДом) Тогда
		Дом.Вставить("Номер", Вход.АдресДом);
	КонецЕсли;
	Если ЗначениеЗаполнено(Вход.АдресКорпус) Тогда
		Дом.Вставить("НомерСтроения", Вход.АдресКорпус);
	КонецЕсли;
	Если Дом.Количество() > 0 Тогда
		Адрес.Вставить("Дом", Дом);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вход.АдресКварт) Тогда
		Адрес.Вставить("Помещение", Новый Структура("НомерКвартиры", Вход.АдресКварт));
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

Процедура ЗаполнитьРезультатИзАдресаФИАС(Результат, АдресФИАС)
	
	ОчиститьКЛАДРПоляРезультата(Результат);
	
	Идентификатор = ИдентификаторФИАСИзАдреса(АдресФИАС);
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Результат.КодГАР = Идентификатор;
	КонецЕсли;
	
	Представление = ПредставлениеИзАдресаФИАС(АдресФИАС);
	Если ЗначениеЗаполнено(Представление) Тогда
		Результат.АдресПредставление = Представление;
	КонецЕсли;
	
	ЗаполнитьКЛАДРИзКомпонента(Результат, "АдресКодРегион", АдресФИАС.Регион);
	ЗаполнитьКЛАДРИзКомпонента(Результат, "АдресРайон", АдресФИАС.Район);
	ЗаполнитьКЛАДРИзКомпонента(Результат, "АдресГород", АдресФИАС.Город);
	ЗаполнитьКЛАДРИзКомпонента(Результат, "АдресНаселПункт", АдресФИАС.НаселенныйПункт);
	ЗаполнитьКЛАДРИзКомпонента(Результат, "АдресУлица", АдресФИАС.Улица);
	
	Дом = АдресФИАС.ДомГАР;
	Если Дом = Неопределено Тогда
		Дом = АдресФИАС.Дом;
	КонецЕсли;
	Если Дом <> Неопределено Тогда
		Если ЗначениеЗаполнено(Дом.Номер) Тогда
			Результат.АдресДом = Дом.Номер;
		ИначеЕсли ЗначениеЗаполнено(Дом.НомерДома) Тогда
			Результат.АдресДом = Дом.НомерДома;
		КонецЕсли;
		Если ЗначениеЗаполнено(Дом.НомерСтроения) Тогда
			Результат.АдресКорпус = Дом.НомерСтроения;
		ИначеЕсли ЗначениеЗаполнено(Дом.НомерКорпуса) Тогда
			Результат.АдресКорпус = Дом.НомерКорпуса;
		КонецЕсли;
		Если ЗначениеЗаполнено(Дом.ПочтовыйИндекс) Тогда
			Результат.АдресИндекс = Дом.ПочтовыйИндекс;
		КонецЕсли;
	КонецЕсли;
	
	Если АдресФИАС.Помещение <> Неопределено И ЗначениеЗаполнено(АдресФИАС.Помещение.НомерКвартиры) Тогда
		Результат.АдресКварт = АдресФИАС.Помещение.НомерКвартиры;
	КонецЕсли;
	
	Результат.АдресГАРЗначение = КонтурЛогистика_ВводАдреса.АдресГАРЗначениеИзАдресаФИАС(
		АдресФИАС, Результат.КодГАР);

КонецПроцедуры

Процедура ЗаполнитьКЛАДРИзКомпонента(Результат, ИмяПоля, Компонент)
	
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Наименование = "";
	Если Компонент.Свойство("НаименованиеССокращением") И ЗначениеЗаполнено(Компонент.НаименованиеССокращением) Тогда
		Наименование = Компонент.НаименованиеССокращением;
	ИначеЕсли Компонент.Свойство("Наименование") И ЗначениеЗаполнено(Компонент.Наименование) Тогда
		Наименование = Компонент.Наименование;
	ИначеЕсли Компонент.Свойство("Код") И ЗначениеЗаполнено(Компонент.Код) Тогда
		Наименование = Компонент.Код;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат[ИмяПоля] = Наименование;
	КонецЕсли;
	
	Если ИмяПоля = "АдресКодРегион" И Компонент.Свойство("Код") И ЗначениеЗаполнено(Компонент.Код) Тогда
		Результат.АдресКодРегион = Лев(СокрЛП(Компонент.Код), 2);
	КонецЕсли;
	
	Если Компонент.Свойство("ПочтовыйИндекс") И ЗначениеЗаполнено(Компонент.ПочтовыйИндекс) Тогда
		Результат.АдресИндекс = Компонент.ПочтовыйИндекс;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКЛАДРПоляОбъекта(Объект, Результат, Перезаписывать = Ложь)
	
	ИменаПолей = "АдресИндекс, АдресКодРегион, АдресРайон, АдресГород, АдресНаселПункт, АдресУлица, АдресДом, АдресКорпус, АдресКварт";
	Для Каждого ИмяПоля Из КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(ИменаПолей, ",", Истина) Цикл
		ИмяПоля = СокрЛП(ИмяПоля);
		Если Перезаписывать Тогда
			Объект[ИмяПоля] = Результат[ИмяПоля];
		ИначеЕсли ЗначениеЗаполнено(Результат[ИмяПоля]) И Не ЗначениеЗаполнено(Объект[ИмяПоля]) Тогда
			Объект[ИмяПоля] = Результат[ИмяПоля];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКЛАДРПоляОрганизации(Объект, Результат, Перезаписывать = Ложь)
	
	СоответствиеПолей = Новый Соответствие;
	СоответствиеПолей.Вставить("АдресИндекс", "АдресZipCode");
	СоответствиеПолей.Вставить("АдресКодРегион", "АдресRegion");
	СоответствиеПолей.Вставить("АдресРайон", "АдресTerritory");
	СоответствиеПолей.Вставить("АдресГород", "АдресCity");
	СоответствиеПолей.Вставить("АдресНаселПункт", "АдресLocality");
	СоответствиеПолей.Вставить("АдресУлица", "АдресStreet");
	СоответствиеПолей.Вставить("АдресДом", "АдресBuilding");
	СоответствиеПолей.Вставить("АдресКорпус", "АдресBlock");
	СоответствиеПолей.Вставить("АдресКварт", "АдресApartment");
	
	Для Каждого Элемент Из СоответствиеПолей Цикл
		Если Перезаписывать Тогда
			Объект[Элемент.Значение] = Результат[Элемент.Ключ];
		ИначеЕсли ЗначениеЗаполнено(Результат[Элемент.Ключ]) И Не ЗначениеЗаполнено(Объект[Элемент.Значение]) Тогда
			Объект[Элемент.Значение] = Результат[Элемент.Ключ];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКЛАДРПоляПодразделения(Объект, Результат, Перезаписывать = Ложь)
	
	ЗаполнитьКЛАДРПоляОрганизации(Объект, Результат, Перезаписывать);
	
КонецПроцедуры

Функция ИменаКомпонентовАдресаФИАС()
	
	ИменаКомпонентов = Новый Массив;
	ИменаКомпонентов.Добавить("Регион");
	ИменаКомпонентов.Добавить("АвтономныйОкруг");
	ИменаКомпонентов.Добавить("МуниципальныйРайон");
	ИменаКомпонентов.Добавить("Район");
	ИменаКомпонентов.Добавить("ГородскоеИСельскоеПоселение");
	ИменаКомпонентов.Добавить("Город");
	ИменаКомпонентов.Добавить("ВнутригородскаяТерритория");
	ИменаКомпонентов.Добавить("НаселенныйПункт");
	ИменаКомпонентов.Добавить("ПланировочнаяСтруктура");
	ИменаКомпонентов.Добавить("Улица");
	ИменаКомпонентов.Добавить("ЗемельныйУчасток");
	ИменаКомпонентов.Добавить("ДополнительнаяТерритория");
	ИменаКомпонентов.Добавить("ОбъектНаДополнительнойТерритории");
	ИменаКомпонентов.Добавить("Дом");
	ИменаКомпонентов.Добавить("ДомГАР");
	ИменаКомпонентов.Добавить("Помещение");
	
	Возврат ИменаКомпонентов;
	
КонецФункции

Процедура ДобавитьКомпонентАдресаФИАС(ЧастиАдреса, КомпонентАдреса)
	
	Если КомпонентАдреса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеКомпонента = Неопределено;
	Если КомпонентАдреса.Свойство("НаименованиеССокращением", НаименованиеКомпонента)
		И ЗначениеЗаполнено(НаименованиеКомпонента) Тогда
		ЧастиАдреса.Добавить(НаименованиеКомпонента);
	КонецЕсли;
	
КонецПроцедуры

Функция ИдентификаторФИАСИзКомпонента(Компонент)
	
	Если Компонент = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Компонент.Свойство("ИдентификаторФИАС") И ЗначениеЗаполнено(Компонент.ИдентификаторФИАС) Тогда
		Возврат Компонент.ИдентификаторФИАС;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ЗначениеРеквизита(Данные, ИмяРеквизита)
	
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Или ТипЗнч(Данные) = Тип("ФиксированнаяСтруктура") Тогда
		Если Данные.Свойство(ИмяРеквизита) Тогда
			Возврат Данные[ИмяРеквизита];
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЭтоСсылка = (ТипЗнч(Данные) = ТипЗнч(Данные.Ссылка));
	Исключение
		ЭтоСсылка = Ложь;
	КонецПопытки;
	
	Если ЭтоСсылка Тогда
		Возврат КонтурЛогистика_СтдОбщегоНазначения.ЗначениеРеквизитаОбъектаЛок(Данные, ИмяРеквизита);
	КонецЕсли;
	
	Попытка
		Возврат Данные[ИмяРеквизита];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#КонецЕсли
