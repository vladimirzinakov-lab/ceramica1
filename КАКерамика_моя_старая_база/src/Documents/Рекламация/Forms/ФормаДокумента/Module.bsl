&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Объект.Состояние		= Перечисления.Рекл_СостоянияРекламации.Создана;	
		Объект.Ответственный	= ПараметрыСеанса.ТекущийПользователь;
		
		ПриЧтенииСозданииНаСервере();		
		
	Иначе
		ЗаполнитьУстановитьРеквизитыДоставкиСервер("СпособДоставки");
		ВнутреннееПотреблениеТоваров = ПолучитьВнутреннееПотреблениеТоваров();
		Если ЗначениеЗаполнено(ВнутреннееПотреблениеТоваров) Тогда
			Рез = ЕстьРасхождениеПоКоличеству(ВнутреннееПотреблениеТоваров);
			Если НЕ Рез Тогда
				Элементы.ПодменюСоздатьНаОсновании.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	МенеджерТелефон	= ПолучитьТелефонПользователя(Объект.Менеджер);
	
	УстановитьВидимостьСостояний();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ПриЧтенииСозданииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда

		Если НЕ ЗначениеЗаполнено(Объект.ВидРемонта) Тогда
			Отказ = Истина;
			Сообщить("Не указан Вид ремонта (вкладка Основное)");
			Возврат;
		КонецЕсли;		
		
		Для каждого Т Из Объект.Комплектующие Цикл
			Если Т.Количество = 0 Тогда
				Отказ = Истина;
				Сообщить("На вкладке Списание на заполнено количество. Номер строки: " + Т.НомерСтроки);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого Т Из Объект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(Т.ФотоЭтикетки) Тогда
				Отказ = Истина;
				Сообщить("На вкладке Изделие на заполнено Фото этикетки. Номер строки: " + Т.НомерСтроки);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

