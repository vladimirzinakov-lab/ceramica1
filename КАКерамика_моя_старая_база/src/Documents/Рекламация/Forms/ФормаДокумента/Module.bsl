#Область Доставка

Функция ПолучитьЗначениеСвойства(п)
	
	Св = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(п, Истина);
	Рез = УправлениеСвойствами.ЗначениеСвойства(Объект.Партнер, Св);

	Возврат Рез;

КонецФункции // ()

