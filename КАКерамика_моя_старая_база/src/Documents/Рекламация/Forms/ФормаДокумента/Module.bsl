#Область СлужебныеПроцедурыИФункции

Функция ЕстьРасхождениеПоКоличеству(п_ВнутреннееПотреблениеТоваров)

	КолВПТ	= п_ВнутреннееПотреблениеТоваров.Товары.Итог("Количество");
	Кол		= Объект.Комплектующие.Итог("Количество");
	
	Возврат КолВПТ <> Кол;

КонецФункции // ()


Функция ПолучитьВнутреннееПотреблениеТоваров()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнутреннееПотреблениеТоваров.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВнутреннееПотреблениеТоваров КАК ВнутреннееПотреблениеТоваров
		|ГДЕ
		|	ВнутреннееПотреблениеТоваров.ДокументОснование = &ДокументОснование
		|	И НЕ ВнутреннееПотреблениеТоваров.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ВнутреннееПотреблениеТоваров.ПустаяСсылка();

КонецФункции // ()

Функция ПолучитьБренд(п_Номенклатура)

	Возврат п_Номенклатура.Производитель;

КонецФункции // ()

Функция ПолучитьОсновногоМенеджера(п_Партнер)
	
	Если ЗначениеЗаполнено(п_Партнер) Тогда
		Возврат п_Партнер.ОсновнойМенеджер;
	КонецЕсли;

КонецФункции // ()

Функция ПолучитьТелефонПользователя(п_Пользователь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПользователиКонтактнаяИнформация.НомерТелефона КАК НомерТелефона
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|ГДЕ
		|	ПользователиКонтактнаяИнформация.Ссылка = &Ссылка
		|	И ПользователиКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	
	Запрос.УстановитьПараметр("Ссылка", п_Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.НомерТелефона;
	КонецЦикла;
	
КонецФункции // ()

Процедура ПриЧтенииСозданииНаСервере()

	ДоставкаТоваров.ПриЧтенииСозданииРаспоряженийНаСервере(Элементы, Объект);

	ДоставкаТоваров.ЗаполнитьСпискиВыбораАдресовПолучателяОтправителя(Элементы, Объект);

КонецПроцедуры

Функция ПолучитьДОиО(НаименованиеОбработки) Экспорт
	рез = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(НаименованиеОбработки, Истина); 
	Возврат рез;
КонецФункции

Процедура УстановитьВидимостьСостояний()
	
	Элементы.Состояние.СписокВыбора.Очистить();

	Элементы.Состояние.СписокВыбора.Добавить(Перечисления.Рекл_СостоянияРекламации.Создана);
	Элементы.Состояние.СписокВыбора.Добавить(Перечисления.Рекл_СостоянияРекламации.ПереданоВСборку);
	Элементы.Состояние.СписокВыбора.Добавить(Перечисления.Рекл_СостоянияРекламации.КПеревозке);
	Элементы.Состояние.СписокВыбора.Добавить(Перечисления.Рекл_СостоянияРекламации.Отгружена);
	Элементы.Состояние.СписокВыбора.Добавить(Перечисления.Рекл_СостоянияРекламации.ОжидаетсяВозврат);
	Элементы.Состояние.СписокВыбора.Добавить(Перечисления.Рекл_СостоянияРекламации.Закрыта);

КонецПроцедуры


#Область ВопросОЗаписиДокумента

&НаКлиенте
Процедура ПроверитьСЗапросомДальнейшегоДействия(п_Команда, ОповещениеЗавершения = Неопределено)
	
	ОчиститьСообщения();
	
	ДополнительныеПараметры = Новый Структура("ОповещениеЗавершения", ОповещениеЗавершения);
	ДополнительныеПараметры.Вставить("ИмяКоманды", п_Команда);
	
	Если Модифицированность Тогда 
		ТекстВопроса = НСтр("ru = 'Для выполнения команды необходимо предварительно записать документ. Выполнить запись документа и продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьСЗапросомДальнейшегоДействияПродолжение", ЭтотОбъект, ДополнительныеПараметры);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
	Иначе 
		ПроверитьСЗапросомДальнейшегоДействияПродолжение(КодВозвратаДиалога.Да, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьСЗапросомДальнейшегоДействияПродолжение(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;			
	
	Если Не Объект.Проведен Или Модифицированность Тогда
		Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись)) Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПроверитьСЗапросомДальнейшегоДействияЗавершение(КодВозвратаДиалога.Да, ДополнительныеПараметры);				
	
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьСЗапросомДальнейшегоДействияЗавершение(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;			
	
	Если ДополнительныеПараметры.ОповещениеЗавершения <> Неопределено Тогда 
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеЗавершения);
	КонецЕсли;
	
КонецПроцедуры	

