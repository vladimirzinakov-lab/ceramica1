	ЗаполнитьУстановитьРеквизитыДоставкиСервер(Элемент.Имя);
	
	Объект.ВремяДоставкиС = ПолучитьЗначениеСвойства("Время доставки с");
	Объект.ВремяДоставкиПо = ПолучитьЗначениеСвойства("Время доставки по");

КонецПроцедуры

&НаКлиенте
Процедура СостояниеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	Если QWERTY_Сервер.Получить_РольДоступна("РабочееМестоРуководительСервисногоОтдела") Тогда
		Элементы.Состояние.СписокВыбора.Очистить();
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.Создана"));
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.ПереданоВСборку"));
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.КПеревозке"));
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.ОжидаетсяВозврат"));
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.Закрыта"));
	ИначеЕсли QWERTY_Сервер.Получить_РольДоступна("РабочееМестоПомощникРуководителяСервисногоОтдела") Тогда
		Элементы.Состояние.СписокВыбора.Очистить();
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.КПеревозке"));
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.ОжидаетсяВозврат"));
	ИначеЕсли QWERTY_Сервер.Получить_РольДоступна("РабочееМестоРуководительСклада") Тогда
		Элементы.Состояние.СписокВыбора.Очистить();
		Элементы.Состояние.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Рекл_СостоянияРекламации.Отгружена"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.Номенклатура) Тогда
