  <attributes>
    <name>СписокЭкспедиторскихРасписок</name>
    <title>
      <key>ru</key>
      <value>Список экспедиторских расписок</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	КонтурЛогистика_ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.ЗаявкаНаМаршрут КАК ЗаявкаНаМаршрут,
	КонтурЛогистика_ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.Ссылка КАК ЭкспедиторскаяРасписка
ИЗ
	Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.ЗаявкиНаМаршрут КАК
		КонтурЛогистика_ЭкспедиторскаяРаспискаЗаявкиНаМаршрут
ГДЕ
	КонтурЛогистика_ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.Ссылка.ПЭ_Титул1 = &amp;ПЭ_Титул1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_СкладскаяРасписка.ЗаявкаНаМаршрут КАК ЗаявкаНаМаршрут,
	КонтурЛогистика_СкладскаяРасписка.Ссылка КАК ЭкспедиторскаяРасписка
ИЗ
	Документ.КонтурЛогистика_СкладскаяРасписка КАК 	КонтурЛогистика_СкладскаяРасписка
ГДЕ
	КонтурЛогистика_СкладскаяРасписка.ПЭ_Титул1 = &amp;ПЭ_Титул1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтурЛогистика_СвязиДокументов.ДокументОсновной,
	КонтурЛогистика_СвязиДокументов.ДокументПодчиненный
ИЗ
	РегистрСведений.КонтурЛогистика_СвязиДокументов КАК КонтурЛогистика_СвязиДокументов
ГДЕ
	КонтурЛогистика_СвязиДокументов.ДокументОсновной В
		(ВЫБРАТЬ
			ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка
		ИЗ
			Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК ПЭ_ЗаявкаНаМаршрут
		ГДЕ
			ПЭ_ЗаявкаНаМаршрут.Титул1 = &amp;ПЭ_Титул1)

УПОРЯДОЧИТЬ ПО
	ЗаявкаНаМаршрут</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <parameters>
    <name>Титул1</name>
    <valueType>
      <types>DocumentRef.КонтурЛогистика_ПЭ_Титул1</types>
    </valueType>
  </parameters>
