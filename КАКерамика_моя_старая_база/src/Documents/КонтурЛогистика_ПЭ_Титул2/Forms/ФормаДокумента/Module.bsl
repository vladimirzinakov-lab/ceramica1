		Если Грузы.ПолучитьЭлементы().Количество() = 1 Тогда
			
			// Открываем сразу ЗЗ
			ДанныеЗаполнения = Новый Структура("ДокументОснование", Грузы.ПолучитьЭлементы()[0].Ссылка);
