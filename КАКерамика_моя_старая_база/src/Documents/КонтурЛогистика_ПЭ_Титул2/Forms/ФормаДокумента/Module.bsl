&НаКлиенте
Процедура ОткрытьФормуУслуги(РежимРаботы, Маршрут, ИдентификаторСтроки = "", ИдентификаторМаршрут = "")
	
	ДанныеЗаполнения = Новый Структура("РежимРаботы, Маршрут, Услуга, Титул1", РежимРаботы, Маршрут);
	ДанныеЗаполнения.Титул1 = Объект.Титул1;
	
	Если ВходящийПЭ2() Тогда 
		ДанныеЗаполнения.Вставить("ТолькоПросмотрДокумента", Истина);
	КонецЕсли;	 
	
	Если РежимРаботы = "ИзменитьУслугу" Тогда
		ДанныеЗаполнения.Услуга = ПолучитьДанныеПоУслуге(ИдентификаторСтроки);
	ИначеЕсли РежимРаботы = "ИзменитьТранспорт"	Тогда
		ДанныеЗаполнения.Услуга = ПолучитьДанныеПоУслуге(ИдентификаторСтроки);
		ДанныеЗаполнения.Вставить("Транспорт", ПолучитьДанныеПоТранспорту(ИдентификаторМаршрут)); 
	КонецЕсли;	
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ПЭ_Титул2.Форма.ФормаУказанияУслуги",
			ДанныеЗаполнения, , ЭтаФорма, "ОбработчикДобавленияУслуги",);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеПоТранспорту(ИдентификаторМаршрут)
	
	ДанныеТранспорт = Новый Массив();

	СтрокиТранспорт = Объект.СвТсДост.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРодитель", ИдентификаторМаршрут));
	Для Каждого ТС Из СтрокиТранспорт Цикл

		ТранспортСтруктура = Новый Структура("МассивВодителей, Транспорт, ТипТранспорта, ИдентификаторСтроки, ИдентификаторРодитель");
		ТранспортСтруктура.Транспорт = ТС.ТранспортноеСредство;
		ТранспортСтруктура.ТипТранспорта = ТС.ВидТС;
		ТранспортСтруктура.ИдентификаторСтроки = ТС.ИдентификаторСтроки;
		ТранспортСтруктура.ИдентификаторРодитель = ТС.ИдентификаторСтрокиРодитель;

		СтрокиВодители = Объект.Водители.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРодитель", ТС.ИдентификаторСтроки));

		МассивВодителей = Новый Массив();
		Для Каждого СтрокаВодитель Из СтрокиВодители Цикл
			МассивВодителей.Добавить(СтрокаВодитель.Водитель);
		КонецЦикла;

		ТранспортСтруктура.МассивВодителей = МассивВодителей;
		ДанныеТранспорт.Добавить(ТранспортСтруктура);

	КонецЦикла;
	
	Возврат ДанныеТранспорт;
	
КонецФункции		

&НаКлиенте
Функция ПолучитьДанныеПоУслуге(Идентификатор)
	
	Отбор = Новый Структура("ИдентификаторСтроки", Идентификатор);
	Поля  = "ПризИсп, Услуга, Количество, РекИдПредст, ОснОкУслИным, ОбщСтУсл, НалСт, НаимДок_СвОплата,
				| НомерДок_СвОплата, ДатаДок_СвОплата, ИдентификаторСтроки, Валюта, 
				|ТипТранспорта, НазваниеОрганизации, ИНН, КПП, ОГРН, Телефон, Фамилия, Имя, Отчество, ТипЮрЛица";
	
	СтрокиУслуг = Объект.ДопИнфЭксп.НайтиСтроки(Отбор);
	Результат = Новый Структура(Поля);
	
	Для Каждого Услуга Из СтрокиУслуг Цикл
		ЗаполнитьЗначенияСвойств(Результат, Услуга);
	КонецЦикла;
		  
	Результат.Вставить("Исполнитель", Услуга.ПризИсп = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипИсполненияЭкспСвоихОбязательст._1"));  	  
	
	Возврат Результат;
	
КонецФункции	

&НаСервере
Процедура ОбновитьДанныеФормы()
	
	ЗаполнитьГрузыПоМаршрутам();
	
	ТекущийСтатус = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(Объект.Ссылка, Истина);
	ТекущийСтатусДокументооборота = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(
		Объект.Титул1, Истина);
	КодТекущегоСтатусаДокументооборота = ТекущийСтатусДокументооборота.Код;
	
	СтатусСтрокой = Строка(ТекущийСтатус) + "; " + Строка(ТекущийСтатусДокументооборота.ТребуемоеДействиеТ2);
	
	ЗадачаПроверить = (КодТекущегоСтатусаДокументооборота = "pe-сheckAnswer");
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПроверкаОтветаПройдена.Видимость = ЗадачаПроверить;
	Элементы.ФормаОбщаяКомандаКонтурЛогистика_ПроверкаОтветаПройдена.КнопкаПоУмолчанию = ЗадачаПроверить;
	
	Заголовок = Строка(ТекущийСтатус);
	
	Если Не ЗадачаПроверить Тогда
		КонтурЛогистика_ОбработкаДокументовСервер.УстановитьЗаголовокКнопкеПоУмолчанию(Объект.Ссылка, Неопределено,
			Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию, ТекущийСтатус);
	Иначе
		Элементы.ФормаОбщаяКомандаКонтурЛогистика_ВыполнитьДействияПоУмолчанию.Видимость = Ложь;
	КонецЕсли;
			
	Элементы.Титул1ДокументШаблон.Видимость = ЗначениеЗаполнено(Объект.Титул1.ДокументШаблон);		
	
КонецПроцедуры

