#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ФормаВвестиЭР.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяЭкспедиторскаяРасписка");
	Элементы.ФормаВвестиСР.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяСкладскаяРасписка");
	
	ОбновитьДанныеФормы();
	ЗаполнитьТаблицуУслуг();
	ЗаполнитьТаблицуТСиВодители();
	ЗаполнитьДанныеПоУпаковкамГруза();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПроверитьДокумент();
	
	ПересчитатьЗаголовкиКоличества();
	
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиОтметки", "");
	
	РазвернутьСвернутьТаблицуТСиВодители();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И Параметр = Объект.Ссылка Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);

	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
			  И Параметр <> Неопределено
			  И ТипЗнч(Параметр) = Тип("Массив")
			  И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда

		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДокументаОснования(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОбработатьВыборДокументаОснование(ВыбранноеЗначение, Объект, ЭтаФорма);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()

	ЭтаФорма.Прочитать();
	ОбновитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()

	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПерепроверить(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикДобавленияУслуги(Данные = Неопределено, КонтекстФормы = Неопределено) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если Данные.ВидОперации = "Удаление" Тогда
		
		УдалитьУслугуНаСервере(Данные.ИдентификаторСтрокиУслуги);
	
	ИначеЕсли Данные.ВидОперации = "Добавление" Тогда
		
		Если ЗначениеЗаполнено(Данные.Услуга.Услуга) Тогда

			ДобавитьУслугуНаСервере(Данные);
		
		КонецЕсли;
		
	ИначеЕсли Данные.ВидОперации = "Изменение" Тогда
			
		УдалитьУслугуНаСервере(Данные.ИдентификаторСтрокиУслуги);	
		ДобавитьУслугуНаСервере(Данные);
		
	КонецЕсли;	 	

	Модифицированность = Истина;
	ПересчитатьЗаголовкиКоличества();
	
	ПроверитьДокумент();
	
КонецПроцедуры	

#КонецОбласти

#Область ОбработчикиСобытийГруппаДополнительнаяИнформация
&НаКлиенте
Процедура ДекорацияПосмотретьДанныеПоКонтейнерамНажатие(Элемент)
	
	ДанныеФормы = Новый Структура;
	ДанныеФормы.Вставить("Ключ", Элементы.Грузы.ТекущиеДанные.Ссылка);
	ДанныеФормы.Вставить("ОткрытьСтраницуКонтейнер", Истина);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы("Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Форма.ФормаДокумента",
		ДанныеФормы, , ЭтаФорма);
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийТабличнойЧастиТСиВодители

&НаКлиенте
Процедура ТСиВодителиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Элементы.ТСиВодители.ТекущиеДанные.Водитель) Тогда

		СтандартнаяОбработка = Ложь;
		ИдентификаторСтроки = Элементы.ТСиВодители.ТекущиеДанные.ИдентификаторСтроки;
		ИдентификаторМаршрут  = Элементы.ТСиВодители.ТекущиеДанные.ИдентификаторМаршрут;
		РежимРаботы = "ИзменитьТранспорт";
		ОткрытьФормуУслуги(РежимРаботы, Элементы.ТСиВодители.ТекущиеДанные.СсылкаМаршрут, ИдентификаторСтроки, ИдентификаторМаршрут);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабличнойЧастиУслуги

&НаКлиенте
Процедура УслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Элементы.Услуги.ТекущиеДанные.СсылкаМаршрут) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ИдентификаторСтроки = Элементы.Услуги.ТекущиеДанные.ИдентификаторСтроки;
		ИдентификаторСтрокиМаршрут =Элементы.Услуги.ТекущиеДанные.ИдентификаторСтрокиМаршрут; 
		
		СтрокиТранспорт = Объект.СвТсДост.НайтиСтроки(Новый Структура("ИдентификаторСтрокиРодитель", ИдентификаторСтрокиМаршрут));
		Если СтрокиТранспорт.Количество() = 0 тогда 
			РежимРаботы = "ИзменитьУслугу";	
		Иначе		
			РежимРаботы = "ИзменитьТранспорт";
		КонецЕсли;
		
		ОткрытьФормуУслуги(РежимРаботы, Элементы.Услуги.ТекущиеДанные.СсылкаМаршрут, ИдентификаторСтроки, ИдентификаторСтрокиМаршрут);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабличнойЧастиГрузы

&НаКлиенте
Процедура ГрузыПриАктивизацииСтроки(Элемент)
	
	Если ВходящийПЭ2() Тогда
		Возврат ;
	КонецЕсли;	
		
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Элементы.ГруппаДополнительнаяИнформация.Видимость = Ложь;
		Элементы.ГруппаДопИнформацияТовары.Видимость = Ложь;
		Возврат ;
	КонецЕсли;	
	
	КорневойЭлемент = (Элемент.ТекущиеДанные.ПолучитьРодителя() = Неопределено);
	Элементы.ГруппаДополнительнаяИнформация.Видимость = КорневойЭлемент;
	Элементы.ГруппаДопИнформацияТовары.Видимость = Не КорневойЭлемент;
	
	Если Элементы.ГруппаДопИнформацияТовары.Видимость Тогда
		
		ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", Элемент.ТекущиеДанные.ИдентификаторСтроки);
		Элементы.УпаковкаТовара.ОтборСтрок = ОтборСтрок;
		
		Элементы.ГруппаГосучет.Видимость = Элемент.ТекущиеДанные.Госучет;
		Элементы.ГруппаОпасный.Видимость = Элемент.ТекущиеДанные.Опасный;
		Элементы.ГруппаОграниченВОбороте.Видимость = Элемент.ТекущиеДанные.ОграниченВОбороте;
	
	ИначеЕсли Элементы.ГруппаДополнительнаяИнформация.Видимость Тогда
		
		Элементы.ГруппаСведенияОКонтейнерах.Видимость = Элемент.ТекущиеДанные.ЕстьДанныеОконтейнерах;
		
		Элементы.ГруппаТемпературныйРежим.Видимость = Элемент.ТекущиеДанные.ЕстьОсобыеУсловияПеревозки;
		Элементы.ГруппаВлажность.Видимость = Элемент.ТекущиеДанные.ЕстьОсобыеУсловияПеревозки;
		Элементы.ГруппаПрочее.Видимость = Элемент.ТекущиеДанные.ЕстьОсобыеУсловияПеревозки;
		
		Элементы.ГруппаОсобыеУсловияПеревозки.Видимость = НЕ Элемент.ТекущиеДанные.ЕстьОсобыеУсловияПеревозки;
		
		Маршрут = Элементы.Грузы.ТекущиеДанные.Ссылка;
	
		СтрокиМаршруты = ТСиВодители.ПолучитьЭлементы();
		ЕстьУслуга = Ложь;
		Для Каждого СтрокаМаршрут Из СтрокиМаршруты Цикл
			Если СтрокаМаршрут.Маршрут = Маршрут Тогда
				ЕстьУслуга = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
		Если ЕстьУслуга Тогда
			Элементы.ДобавитьТСВодителя.Заголовок = "Изменить ТС и водителя";
		Иначе 
			Элементы.ДобавитьТСВодителя.Заголовок = "Добавить ТС и водителя";	 
		КонецЕсли;	 	
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПанельОшибокМинимизировать(Команда)
	КонтурЛогистика_ПанельОшибокКлиент.МинимизироватьПанельОшибок(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПанельОшибокМаксимизировать(Команда)
	КонтурЛогистика_ПанельОшибокКлиент.ПоказатьПанельОшибок(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПанельОшибокСвернутьРазвернуть(Команда)
	ПанельОшибокСвернутьРазвернутьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуКонвертации(Команда)

	КонтурЛогистика_ОбработкаДокументовКлиент.ОткрытьНастройкуКонвертации(
		ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2"), Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПоДокОснованию(Команда)

	ПерезаполнитьПоДокОснованиюСервер();
	ОбновитьДанныеФормы();

	ПолностьюОбновитьПредставлениеДанных();

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьОбъект(Команда)

	ОбработчикПеречитатьОбъект();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПараметрыПодписи(Команда)
	
	МассивКонструктораКлюча = ПолучитьПараметрыПодписиНаСервере(Объект.СвЭксп, Объект.ПользовательПодписант, 
			Объект.ПараметрНастроекПодписания);

	КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.КонтурЛогистика_НастройкиПодписания", МассивКонструктораКлюча);
	ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
			"РегистрСведений.КонтурЛогистика_НастройкиПодписания.Форма.ФормаЗаписи", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиЭР(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И КодТекущегоСтатусаДокументооборота = "pe-completed" Тогда
		
		Если Грузы.ПолучитьЭлементы().Количество() = 1 Тогда
			
			// Открываем сразу экспедиторскую расписку
			ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
			ИмяОткрываемойФормы = "Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.ФормаОбъекта";
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяОткрываемойФормы, ПараметрыФормы,, ЭтаФорма);
			
		Иначе
			
			// Открываем мастер
			ПараметрыФормы = Новый Структура("ДокументОснования", Объект.Титул1);
			ИмяОткрываемойФормы = "Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.Форма.МастерСозданияЭспедиторскихРасписок";
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяОткрываемойФормы, ПараметрыФормы,, ЭтаФорма);
			
		КонецЕсли;
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Оформление ЭР", "Оформить ЭР", "Документ.КонтурЛогистика_ПЭ_Титул2.Форма.ФормаДокумента", "ЭР");
		
	Иначе
		
		Сообщить("Оформить экспедиторскую расписку можно только после подписания титула 2 поручения экспедитора");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиСР(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
		И КодТекущегоСтатусаДокументооборота = "pe-completed" Тогда
		
		Если Грузы.ПолучитьЭлементы().Количество() = 1 Тогда
			
			// Открываем сразу складскую расписку
			ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
			ИмяОткрываемойФормы = "Документ.КонтурЛогистика_СкладскаяРасписка.ФормаОбъекта";
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяОткрываемойФормы, ПараметрыФормы,, ЭтаФорма);
			
		Иначе
			
			// Открываем мастер
			ПараметрыФормы = Новый Структура("ДокументОснования", Объект.Титул1);
			ИмяОткрываемойФормы = "Документ.КонтурЛогистика_СкладскаяРасписка.Форма.МастерСозданияСкладскихРасписок";
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяОткрываемойФормы, ПараметрыФормы,, ЭтаФорма);
			
		КонецЕсли;
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Оформление СР", "Оформить СР", "Документ.КонтурЛогистика_ПЭ_Титул2.Форма.ФормаДокумента", "СР");
		
	Иначе
		
		Сообщить("Оформить складскую расписку можно только после подписания титула 2 поручения экспедитора");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУслугу(Команда)
	
	Маршрут = Элементы.Грузы.ТекущиеДанные.Ссылка;
	РежимРаботы = "ДобавитьУслугу";
	ОткрытьФормуУслуги(РежимРаботы, Маршрут);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТСВодителя(Команда)
	
	Маршрут = Элементы.Грузы.ТекущиеДанные.Ссылка;
	
	СтрокиМаршруты = ТСиВодители.ПолучитьЭлементы();
	
	РежимРаботы = "ДобавитьТСиВодитель";
	ИдентификаторСтроки = "";
	ИдентификаторМаршрут = "";
	
	Для Каждого СтрокаМаршрут Из СтрокиМаршруты Цикл
		Если СтрокаМаршрут.Маршрут = Маршрут Тогда
			ИдентификаторСтроки = СтрокаМаршрут.ИдентификаторСтроки;
			ИдентификаторМаршрут  = СтрокаМаршрут.ИдентификаторМаршрут;
			РежимРаботы = "ИзменитьТранспорт";
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	ОткрытьФормуУслуги(РежимРаботы, Маршрут, ИдентификаторСтроки, ИдентификаторМаршрут);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУслугу(Команда)
	
	УдалитьУслугуНаСервере(Элементы.Услуги.ТекущиеДанные.ИдентификаторСтроки);
	ВыполнитьДействияПослеУдаления();
	
КонецПроцедуры

