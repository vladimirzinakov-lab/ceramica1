&НаСервере
Процедура ЗаполнитьДанныеПоУпаковкамГруза()
	
	Запрос = Новый Запрос;
 	Запрос.Текст = "ВЫБРАТЬ
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.Ссылка КАК Ссылка,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.ИдентификаторСтрокиТоваров КАК ИдентификаторСтроки,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.ВидУпак КАК ВидУпак,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.ВесУпак КАК ВесУпак,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.КолУпак КАК КолУпак,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.ВысЗнач КАК ВысЗнач,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.ДлЗнач КАК ДлЗнач,
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.ШирЗнач КАК ШирЗнач
 	|ИЗ
 	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ИнфУпГруз КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз
 	|ГДЕ
 	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутИнфУпГруз.Ссылка.Титул1 = &Титул1
 	|ИТОГИ
 	|ПО
 	|	Ссылка";
 	
 	ТЗ_Упаковки = РеквизитФормыВЗначение("УпаковкаТовара");
	ТЗ_Упаковки.Очистить();
 	
 	Запрос.УстановитьПараметр("Титул1", Объект.Титул1);
 	Выборка = Запрос.Выполнить().Выбрать();
 	
 	Пока Выборка.Следующий() Цикл
 		
 		НоваяСтрока = ТЗ_Упаковки.Добавить();
 		НоваяСтрока.ВидТары = Выборка.ВидУпак;
 		НоваяСтрока.ИдентификаторСтроки = Выборка.ИдентификаторСтроки;
 		НоваяСтрока.Количество = Выборка.КолУпак;
 		НоваяСтрока.Вес = Выборка.ВесУпак;
 		НоваяСтрока.Размер  =  ПолучитьПредставлениеРазмера(Выборка.ДлЗнач, Выборка.ШирЗнач, Выборка.ВысЗнач); 
 		
 	КонецЦикла; 	
 	
 	ЗначениеВРеквизитФормы(ТЗ_Упаковки, "УпаковкаТовара");

КонецПроцедуры	

&НаСервере
Функция ПолучитьПредставлениеРазмера(Длина, Ширина, Высота)
	
	ФорматнаяСтрока = "ЧН=0; ЧГ=";
	
	Возврат Формат(Длина, ФорматнаяСтрока) + " х " + Формат(Ширина, ФорматнаяСтрока) + " х " + Формат(Высота, ФорматнаяСтрока);  
	
КонецФункции	

&НаСервере
Функция СформироватьПредставлениеВремени(Данные, НаправлениеОперации);
	
	Если НаправлениеОперации = "Отгрузка" Тогда 
		Префикс = "Отгр";
	Иначе
		Префикс = "ДостГр"; 
	КонецЕсли;
	
	ДатаС = Данные.Ссылка["Дат" + Префикс + "С"];
	ДатаПо = Данные.Ссылка["Дат" + Префикс + "По"];
	ФорматнаяСтрока = "ДФ=dd.MM.yy";
	
	ПредставлениеДата = СформироватьПредставление(ДатаС, ДатаПо, ФорматнаяСтрока);
			 
	ВремяС = Данные.Ссылка["Вр" + Префикс + "С"];
	ВремяПо = Данные.Ссылка["Вр" + Префикс + "По"];
	ФорматнаяСтрока = "ДФ=HH:mm";
	
	ПредставлениеВремени = СформироватьПредставление(ВремяС, ВремяПо, ФорматнаяСтрока);
	
	Если ЗначениеЗаполнено(ПредставлениеВремени) 
		И ЗначениеЗаполнено(ПредставлениеДата) Тогда	
		 
		Результат = ПредставлениеДата + ", " + ПредставлениеВремени;
	Иначе 
		Результат = ПредставлениеДата + ПредставлениеВремени;	
	КонецЕсли;	 
		
	Возврат Результат; 
	
КонецФункции

&НаСервере
Функция СформироватьПредставление(ЗначениеС, ЗначениеПо, ФорматнаяСтрока)
	
	Если ЗначениеЗаполнено(ЗначениеС)
		И ЗначениеЗаполнено(ЗначениеПо) Тогда
			
		Если ЗначениеС = ЗначениеПо Тогда 
			ПредставлениеЗначение = Формат(ЗначениеС, ФорматнаяСтрока);	
		Иначе 	
			ПредставлениеЗначение = Формат(ЗначениеС, ФорматнаяСтрока) + " - " + Формат(ЗначениеПо, ФорматнаяСтрока);
		КонецЕсли;
		 	
	ИначеЕсли ЗначениеЗаполнено(ЗначениеС) Тогда 
		
		ПредставлениеЗначение = "с " + Формат(ЗначениеС, ФорматнаяСтрока);
	
	ИначеЕсли ЗначениеЗаполнено(ЗначениеПо) Тогда 
		
		ПредставлениеЗначение = "до " + Формат(ЗначениеПо, ФорматнаяСтрока);
	
	Иначе
			
		ПредставлениеЗначение = "";	
			
	КонецЕсли;
	
	Возврат ПредставлениеЗначение;
	
КонецФункции	

&НаСервере
Функция СформироватьПредставлениеВидаТранспорта(Данные)
	
	Результат = Новый Структура("ВидТранспорта, ТипКузова", "", ""); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутВидТС.ВидТС КАК ВидТС,
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутВидТС.ТипКузов КАК ТипКузов
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ВидТС КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутВидТС
	|ГДЕ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутВидТС.Ссылка = &Маршрут";
	
	Запрос.УстановитьПараметр("Маршрут", Данные.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Результат.ВидТранспорта) Тогда 
			 Результат.ВидТранспорта = Результат.ВидТранспорта + ";";
			 Результат.ТипКузова = Результат.ТипКузова + ";";
		КонецЕсли;
		 
		Результат.ВидТранспорта = Результат.ВидТранспорта + Строка(Выборка.ВидТС);
		Результат.ТипКузова = Результат.ТипКузова + Выборка.ТипКузов;
		
	КонецЦикла;
	
	Если Результат.ВидТранспорта = "" Тогда 
		Результат.ВидТранспорта = " - ";
	КонецЕсли;	
	 	
	Если Результат.ТипКузова = "" Тогда 
		Результат.ТипКузова = " - ";
	КонецЕсли;	
		
	Возврат Результат;	
	
КонецФункции

&НаСервере
Процедура ДобавитьУслугуНаСервере(Данные)

	НоваяУслуга = Объект.ДопИнфЭксп.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяУслуга, Данные.Услуга);
	НоваяУслуга.РекИдПредст = Данные.Услуга.ОрганизацияДиадок;
	НоваяУслуга.ПризИсп = ?(Данные.Услуга.Исполнитель, Перечисления.КонтурЛогистика_ТипИсполненияЭкспСвоихОбязательст._1, 
			Перечисления.КонтурЛогистика_ТипИсполненияЭкспСвоихОбязательст._2);
	НоваяУслуга.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	
	СтрокаМаршрут = Объект.СвТрсГруз.Добавить();
	СтрокаМаршрут.ИдентификаторСтрокиРодитель = НоваяУслуга.ИдентификаторСтроки;
	СтрокаМаршрут.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	Если ЗначениеЗаполнено(Данные.Маршрут) Тогда
		СтрокаМаршрут.Маршрут = Данные.Маршрут;
		СтрокаМаршрут.ИдентПартГруз = Данные.Маршрут.ИдПарт;
		СтрокаМаршрут.НомПартГруз = Данные.Маршрут.НомПарт;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.Услуга.ТипТранспорта) Тогда
		ЗаполнитьТранспортВодителей(Данные, СтрокаМаршрут.ИдентификаторСтроки);
	КонецЕсли;
	
	ЗаполнитьТаблицуУслуг();
	ЗаполнитьТаблицуТСиВодители();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТранспортВодителей(Данные, ИдентификаторСтроки)
	
	ОчиститьТранспортВодителейПоИдентификатору(ИдентификаторСтроки);
	
	Если Данные.Услуга.ТипТранспорта = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВидыТранспорта._1") Тогда
		
		Для Каждого Транспорт Из Данные.ТранспортВодители Цикл 
		
			НовоеТС = Объект.СвТсДост.Добавить();
			НовоеТС.ВидТС = Данные.Услуга.ТипТранспорта;
			НовоеТС.ИдентификаторСтрокиРодитель = ИдентификаторСтроки;	
			НовоеТС.ИдентификаторСтроки = Транспорт.ИдентификаторСтроки;
			НовоеТС.ТранспортноеСредство = Транспорт.ТС;
			
			Для Каждого Водитель Из Транспорт.МассивВодителей Цикл
				НовыйВодитель = Объект.Водители.Добавить();
				НовыйВодитель.ИдентификаторСтрокиРодитель = НовоеТС.ИдентификаторСтроки;	
				НовыйВодитель.Водитель = Водитель;
			КонецЦикла; 	
		
		КонецЦикла;
		
	Иначе 
		НовоеТС = Объект.СвТсДост.Добавить();
		НовоеТС.ВидТС = Данные.Услуга.ТипТранспорта;
		НовоеТС.ИдентификаторСтрокиРодитель = ИдентификаторСтроки;	
	КонецЕсли; 	 
	
КонецПроцедуры	

&НаСервере
Процедура ОчиститьТранспортВодителейПоИдентификатору(ИдентификаторСтроки)
	
	Отбор = Новый Структура("ИдентификаторСтрокиРодитель", ИдентификаторСтроки);
	МассивСтрок = Объект.СвТсДост.НайтиСтроки(Отбор);
	
	Для Каждого ТС Из МассивСтрок Цикл
		
		Отбор = Новый Структура("ИдентификаторСтрокиРодитель", ТС.ИдентификаторСтроки);
		МассивСтрокВ = Объект.Водители.НайтиСтроки(Отбор);
		
		Для Каждого Водитель Из МассивСтрокВ Цикл
			Объект.Водители.Удалить(Водитель);
		КонецЦикла;
		
		Объект.СвТсДост.Удалить(ТС);	
 				
	КонецЦикла;	 	
	
КонецПроцедуры	

&НаСервере
Процедура УдалитьУслугуНаСервере(ИдентификаторСтроки)
	
	Отбор = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	МассивСтрок = Объект.ДопИнфЭксп.НайтиСтроки(Отбор);
	
	Для Каждого Услуга Из МассивСтрок Цикл
		
		Отбор = Новый Структура("ИдентификаторСтрокиРодитель", Услуга.ИдентификаторСтроки);
		МассивСтрокМ = Объект.СвТрсГруз.НайтиСтроки(Отбор);
		
		Для Каждого Маршрут Из МассивСтрокМ Цикл
			ОчиститьТранспортВодителейПоИдентификатору(Маршрут.ИдентификаторСтроки);
			Объект.СвТрсГруз.Удалить(Маршрут);
		КонецЦикла;
		
		Объект.ДопИнфЭксп.Удалить(Услуга);	
 				
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуУслуг()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ТЗУслуги = ДокументОбъект.ДопИнфЭксп.Выгрузить();
	ТЗМаршрут = ДокументОбъект.СвТрсГруз.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВременнаяТаблица.Услуга КАК Услуга,
	|	ВременнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВременнаяТаблица.ОбщСтУсл КАК Стоимость,
	|	ВременнаяТаблица.Количество КАК Количество,
	|	ВременнаяТаблица.Валюта КАК Валюта
	|ПОМЕСТИТЬ Вт_Услуги
	|ИЗ
	|	&УслугаВТ КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.Маршрут КАК Маршрут,
	|	ВременнаяТаблица.ИдентификаторСтрокиРодитель КАК ИдентификаторСтрокиРодитель,
	|	ВременнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтрокиМаршрут
	|ПОМЕСТИТЬ ВТ_Маршрут
	|ИЗ
	|	&МаршрутВТ КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Маршрут.Маршрут КАК Услуга,
	|	ВТ_Маршрут.Маршрут КАК СсылкаМаршрут,
	|	Вт_Услуги.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Вт_Маршрут.ИдентификаторСтрокиМаршрут КАК ИдентификаторСтрокиМаршрут,
	|	Вт_Услуги.Услуга КАК ПолеИтогов,
	|	Вт_Услуги.Стоимость КАК Стоимость,
	|	Вт_Услуги.Количество КАК Количество,
	|	Вт_Услуги.Валюта КАК Валюта
	|
	|ИЗ
	|	Вт_Услуги КАК Вт_Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Маршрут КАК ВТ_Маршрут
	|		ПО ВТ_Маршрут.ИдентификаторСтрокиРодитель = Вт_Услуги.ИдентификаторСтроки
	|ИТОГИ
	|   Максимум(ПолеИтогов) КАК Услуга,
	|	Максимум(ИдентификаторСтроки),
	|	СУММА(Стоимость),
	|	Сумма(Количество),
	|	Максимум(Валюта)
	|ПО
	|	Вт_Услуги.Услуга";
	
	Запрос.УстановитьПараметр("УслугаВТ", ТЗУслуги);
	Запрос.УстановитьПараметр("МаршрутВТ", ТЗМаршрут);
	
	ДЗ_Услуги = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ЗначениеВРеквизитФормы(ДЗ_Услуги, "Услуги");
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицуТСиВодители()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ТЗУслуги = ДокументОбъект.ДопИнфЭксп.Выгрузить();
	ТЗМаршрут = ДокументОбъект.СвТрсГруз.Выгрузить();
	ТЗТранспорт = ДокументОбъект.СвТсДост.Выгрузить();
	ТЗВодители = ДокументОбъект.Водители.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВременнаяТаблица.Услуга КАК Услуга,
	|	ВременнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ Вт_Услуги
	|ИЗ
	|	&УслугаВТ КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.Маршрут КАК Маршрут,
	|	ВременнаяТаблица.ИдентификаторСтрокиРодитель КАК ИдентификаторСтрокиРодитель,
	|	ВременнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТ_Маршрут
	|ИЗ
	|	&МаршрутВТ КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВременнаяТаблица.ТранспортноеСредство КАК Справочник.КонтурЛогистика_ТранспортныеСредства) КАК Транспорт,
	|	ВременнаяТаблица.ИдентификаторСтрокиРодитель КАК ИдентификаторСтрокиРодитель,
	|	ВременнаяТаблица.ВидТС КАК ВидТС,
	|	ВременнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВременнаяТаблица.РегНомер КАК РегНомер,
	|	ВременнаяТаблица.Марка КАК МаркаТС
	|ПОМЕСТИТЬ ВТ_Транспорт
	|ИЗ
	|	&ТранспортВТ КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВременнаяТаблица.Водитель КАК Справочник.КонтурЛогистика_Сотрудники) КАК Водитель,
	|	ВременнаяТаблица.ИдентификаторСтрокиРодитель КАК ИдентификаторСтрокиРодитель
	|ПОМЕСТИТЬ ВТ_Водитель
	|ИЗ
	|	&ВодительВТ КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Водитель.Водитель КАК Водитель,
	|	ВТ_Водитель.Водитель.ТелефонОсновной КАК Телефон1,
	|	ВТ_Водитель.Водитель.ТелефонЗапасной КАК Телефон2,
	|	ВТ_Транспорт.Транспорт КАК Транспорт,
	|	ВТ_Маршрут.Маршрут КАК Маршрут,
	|	ВТ_Маршрут.Маршрут КАК СсылкаМаршрут,
	|	ВТ_Транспорт.ВидТС КАК ВидТранспорта,
	|	ВЫБОР
	|		КОГДА ВТ_Транспорт.Транспорт <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка)
	|				И НЕ ВТ_Транспорт.Транспорт.РегНомер = """"
	|			ТОГДА ВТ_Транспорт.Транспорт.РегНомер
	|		ИНАЧЕ ВТ_Транспорт.РегНомер
	|	КОНЕЦ КАК ГосНомер,
	|	ВЫБОР
	|		КОГДА ВТ_Транспорт.Транспорт <> ЗНАЧЕНИЕ(Справочник.КонтурЛогистика_ТранспортныеСредства.ПустаяСсылка)
	|				И НЕ ВТ_Транспорт.Транспорт.МаркаТС = """"
	|			ТОГДА ВТ_Транспорт.Транспорт.МаркаТС
	|		ИНАЧЕ ВТ_Транспорт.МаркаТС
	|	КОНЕЦ КАК МаркаТС,
	|	ВТ_Транспорт.ИдентификаторСтрокиРодитель КАК ИдентификаторМаршрут,
	|	ВТ_Транспорт.ИдентификаторСтроки КАК ИдентификаторТранспорт,
	|	ВТ_Маршрут.ИдентификаторСтрокиРодитель КАК ИдентификаторСтроки
	|ИЗ
	|	ВТ_Маршрут КАК ВТ_Маршрут
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Транспорт КАК ВТ_Транспорт
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Водитель КАК ВТ_Водитель
	|			ПО ВТ_Транспорт.ИдентификаторСтроки = ВТ_Водитель.ИдентификаторСтрокиРодитель
	|		ПО ВТ_Маршрут.ИдентификаторСтроки = ВТ_Транспорт.ИдентификаторСтрокиРодитель
	|ГДЕ
	|	НЕ ВТ_Транспорт.ВидТС = ЗНАЧЕНИЕ(Перечисление.КонтурЛогистика_ВидыТранспорта.ПустаяСсылка)
	|ИТОГИ
	|ПО
	|	Маршрут,
	|	Транспорт";
	
	Запрос.УстановитьПараметр("УслугаВТ", ТЗУслуги);
	Запрос.УстановитьПараметр("МаршрутВТ", ТЗМаршрут);
	Запрос.УстановитьПараметр("ТранспортВТ", ТЗТранспорт);
	Запрос.УстановитьПараметр("ВодительВТ", ТЗВодители);
	
	ДЗ_ТранспортФорма = РеквизитФормыВЗначение("ТСиВодители");
	ДЗ_ТранспортФорма.Строки.Очистить();
	ДЗ_Транспорт = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаДЗ Из ДЗ_Транспорт.Строки Цикл
		Маршрут = ДЗ_ТранспортФорма.Строки.Добавить();  
		Маршрут.Маршрут = СтрокаДЗ.Маршрут;
		Для Каждого СтрокаМаршрута Из СтрокаДЗ.Строки Цикл
			Транспорт = Маршрут.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(Транспорт, СтрокаМаршрута);
			Транспорт.Маршрут = СтрокаМаршрута.Транспорт;
			Для Каждого СтрокаТранспорта Из СтрокаМаршрута.Строки Цикл
				Водитель = Транспорт.Строки.Добавить();
				Водитель.Водитель = СтрокаТранспорта.Водитель;
				Водитель.ИдентификаторСтроки = СтрокаТранспорта.ИдентификаторСтроки;
				Водитель.Телефоны = СформироватьПредставлениеТелефона(СтрокаТранспорта.Телефон1, СтрокаТранспорта.Телефон2); 
			КонецЦикла; 
			Транспорт.ИдентификаторСтроки = СтрокаТранспорта.ИдентификаторСтроки;
			Маршрут.ИдентификаторСтроки = СтрокаТранспорта.ИдентификаторСтроки;
			Маршрут.ИдентификаторМаршрут = СтрокаТранспорта.ИдентификаторМаршрут;
			Транспорт.ИдентификаторМаршрут = СтрокаТранспорта.ИдентификаторМаршрут;
			Транспорт.ИдентификаторТранспорт = СтрокаТранспорта.ИдентификаторТранспорт;
			Маршрут.ИдентификаторТранспорт = СтрокаТранспорта.ИдентификаторТранспорт;
			Маршрут.СсылкаМаршрут = СтрокаТранспорта.СсылкаМаршрут;
			Транспорт.СсылкаМаршрут = СтрокаТранспорта.СсылкаМаршрут;
			Транспорт.ГосНомер = СтрокаТранспорта.ГосНомер;
			Транспорт.Марка = СтрокаТранспорта.МаркаТС;
		КонецЦикла; 	
	КонецЦикла;	
	
	ЗначениеВРеквизитФормы(ДЗ_ТранспортФорма, "ТСиВодители");	
	
КонецПроцедуры	

&НаСервере
Функция СформироватьПредставлениеТелефона(Телефон1, Телефон2)
	
	Если ЗначениеЗаполнено(Телефон1) Тогда
		Результат = Телефон1;
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Телефон2) Тогда
		Если ЗначениеЗаполнено(Результат) Тогда 
			Результат = Результат + "; " + Телефон2;
		Иначе
			Результат = Телефон2;
		КонецЕсли;	
	КонецЕсли;	 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РазвернутьСвернутьТаблицуТСиВодители()
	
	Для Каждого ЭлементУр1 Из ТСиВодители.ПолучитьЭлементы() Цикл
		Элементы.ТСиВодители.Развернуть(ЭлементУр1.ПолучитьИдентификатор());
		Для Каждого ЭлементУр2 Из ЭлементУр1.ПолучитьЭлементы() Цикл
			Элементы.ТСиВодители.Развернуть(ЭлементУр2.ПолучитьИдентификатор());
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Функция ВходящийПЭ2()
	
	Возврат ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен")
			ИЛИ ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением")
			ИЛИ ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки");
		
КонецФункции

