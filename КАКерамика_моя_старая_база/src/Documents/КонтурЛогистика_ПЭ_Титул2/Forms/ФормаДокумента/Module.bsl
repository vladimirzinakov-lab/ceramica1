		Иначе
			
			// Открываем мастер
			ПараметрыФормы = Новый Структура("ДокументОснования", Объект.Титул1);
			ПараметрыФормы.Вставить("РежимИспользования", "ЗаказЗаявка");
			ИмяОткрываемойФормы = "Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.Форма.МастерСозданияЭспедиторскихРасписок";
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(ИмяОткрываемойФормы, ПараметрыФормы,, ЭтаФорма);
			
		КонецЕсли;
		
		КонтурЛогистика_Метрика.ЗарегистрироватьДействиеПользователя(
			"Оформление ЗЗ", "Оформить ЗЗ", "Документ.КонтурЛогистика_ПЭ_Титул2.Форма.ФормаДокумента");
		
