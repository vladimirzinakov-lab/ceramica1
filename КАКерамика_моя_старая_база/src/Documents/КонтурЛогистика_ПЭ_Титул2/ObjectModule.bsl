#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ЭтоНовыйДокумент", Не ЗначениеЗаполнено(Ссылка));
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеСвойства.ЭтоНовыйДокумент Тогда
		
		Статус = Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик;
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Ссылка, Статус, Истина, Истина);

	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Дата = ТекущаяДатаСеанса();
	УИД_ПорЭксп = "";
	kl_id = "";

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Перем ФайлОбмена;
		
	Если ДанныеЗаполнения <> Неопределено
		 И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		 И ДанныеЗаполнения.Свойство("ПредыдущийТитул")  Тогда

		ПЭ1_Ссылка = ДанныеЗаполнения.ПредыдущийТитул;
		
		ДанныеЗаполнения.Свойство("ФайлОбмена", ФайлОбмена);
		
		Если Не ЗначениеЗаполнено(ФайлОбмена) Тогда 
			ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлТитулаПоГлавномуДокументу(ПЭ1_Ссылка, 
									Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1);
		КонецЕсли;
									
		ОбщиеРеквизиты = "НомДок, ДатаДок, СвКлиент, СвЭксп, ДогТрЭксп, УИД_ПорЭксп, kl_id";
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПЭ1_Ссылка, ОбщиеРеквизиты);
		
		Титул1 = ПЭ1_Ссылка;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			СообщитьПользователю("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) Тогда 
			
			ОбщиеРеквизиты = "НомДок, ДатаДок, СвКлиент, СвЭксп, ДогТрЭксп, УИД_ПорЭксп, kl_id";
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ФайлСсылка.ГлавныйДокумент, ОбщиеРеквизиты);
			
			Титул1 = ФайлСсылка.ГлавныйДокумент;
			
		КонецЕсли;
		
		// Идентификатор в Логистике
		kl_id = ФайлСсылка.kl_id;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);
			
	КонецЕсли;		

	Пользователь1с = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
	ЗаполнитьРеквизитыПоПользователю(Пользователь1с);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю(ВходящийПользователь1С = Неопределено) Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания)  Тогда
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				СвЭксп, , , ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			Если ВходящийПользователь1С = Неопределено Тогда
				ПользовательПодписант = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПолучитьТекущегоПользователя1С();
			Иначе
				ПользовательПодписант = ВходящийПользователь1С;	
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку( "ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

Функция СформироватьФайлОбмена(ПараметрыФайлаРеквизиты = Неопределено) Экспорт

	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	Попытка
	
		Заблокировать();
	
	Исключение
		
		Результат.Успешно = Ложь;
	    Результат.ОписаниеОшибки = "Не удалось заблокировать документ: " + ОписаниеОшибки();
		Возврат Результат;
		
	КонецПопытки;
	
	// Проверка статуса после наложения блокировки на Документ
	РезультатПроверкиСтатуса = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьТекущийСтатусДокументаДляСозданияФайловОбмена(Ссылка);
	
	Если НЕ РезультатПроверкиСтатуса.Успешно Тогда
		Разблокировать();
		Возврат РезультатПроверкиСтатуса;
	КонецЕсли;
	
	// Выполнить валидацию документа
	РезультатВалидации = Документы.КонтурЛогистика_ПЭ_Титул2.ПроверитьДокумент(Ссылка);
	
	Если РезультатВалидации.КоличествоОшибок > 0 Тогда
		
		Разблокировать();
		Результат.ОписаниеОшибки = "Ошибки в " + Ссылка + "! Исправьте их для отправки.";
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	ДатИнфКлт = ТекущаяДатаСеанса();
	ВрИнфКлт = ТекущаяДатаСеанса();
	
	Попытка
		
		// формируем текст xml
		РезультатФормированияТекста = СформироватьТекстФайла(ДатИнфКлт, ВрИнфКлт);
		Если РезультатФормированияТекста.Успешно = Ложь Тогда
					
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(РезультатФормированияТекста));
			Возврат Результат;
					
		КонецЕсли;
		
		// запишем в справочник
		ПараметрыФайлаРеквизиты = Новый Структура ("ТребуетсяПодпись", Истина);
		РезультатСозданияФайла = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьФайлОбмена(
										РезультатФормированияТекста,
										Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул2,
										ПараметрыФайлаРеквизиты,
										Ссылка);
				
		ЗаполнитьЗначенияСвойств(Результат, РезультатСозданияФайла);
		
		Если Результат.Успешно Тогда
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(Ссылка, 
				Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена, , Истина);
			
			Результат.МассивФайловОбмена.Добавить(РезультатСозданияФайла.Файл);
			
		Иначе
			
			ВызватьИсключение КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(Результат);
			
		КонецЕсли;
		
		// Записать(); // запишем  ДатИнфФт и ВрИнфФт
		
		Разблокировать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		Разблокировать();
		
		ТекстОшибки = "Ошибка при формировании файла обмена по документу " + Ссылка + ": " + ОписаниеОшибки();
		СообщитьПользователю(ТекстОшибки);
		Результат.Успешно = Ложь;
		Результат.Массивошибок.Добавить(ТекстОшибки);
		
		КонтекстМетода = Новый Структура;
		КонтекстМетода.Вставить("ПараметрыФайлаРеквизиты", ПараметрыФайлаРеквизиты);
		КонтекстМетода.Вставить("РезультатСозданияФайла", РезультатСозданияФайла);
		
		КонтурЛогистика_Метрика.ОбработатьОшибкуФормированияТекстаФайла(Ссылка, ИнформацияОбОшибке(), КонтекстМетода);
		
	КонецПопытки;
	
	Возврат Результат;
		
КонецФункции 

Процедура ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO = КС.ПолучитьXDTOпоXML(ТекстФайла);
	СодИнфЭксп = XDTO.Документ.СодИнфЭксп; 
	
	МассивЭлементов = Новый Массив;
	
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "УИД_ПорЭксп", "УИД_ПорЭксп", "");
	КС.ЗаполнитьДокументыПоМассивуСоответствий(МассивЭлементов, СодИнфЭксп, ЭтотОбъект);
	
	ЗаполнитьИныеДанныеЭксп(СодИнфЭксп);
	ЗаполнитьДопИнфЭксп(СодИнфЭксп);
		
	КС.ЗаполнитьИнфПолИзXDTO(СодИнфЭксп, ЭтотОбъект, "ИнфПол");
	
КонецПроцедуры

Процедура ЗаполнитьДопИнфЭксп(СодИнфЭксп)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_ДопИнфЭксп = КС.XDTO_Вычислить(СодИнфЭксп, "ДопИнфЭксп");
	XDTO_ДопИнфЭксп = КС.XDTO_ВычислитьМассивXDTO(XDTO_ДопИнфЭксп);
	
	МассивЭлементов = Новый Массив;

	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "ПризИсп",  "ПризнИсп",  "ТипИсполненияЭкспСвоихОбязательст");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "Количество",  "КолУсл",  "Число");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "РекИдПредст",  "СвПредстЭксп.РекИдПредст",  "УчастникТип");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "ОснОкУслИным",  "СвПредстЭксп.ОснОкУслИным",  "РеквДокТип");
	
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "ОбщСтУсл",  "СвОплата.ОбщСтУсл",  "Число");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "НалСт",  "СвОплата.НалСт",  "СтавкиНДС");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "НаимДок_СвОплата",  "СвОплата.РеквНаимДок",  "");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "НомерДок_СвОплата",  "СвОплата.ОснДовОргСост",  "");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "ДатаДок_СвОплата",  "СвОплата.РеквДатаДок",  "ДатаТип");
	
	Для Каждого Элемент Из XDTO_ДопИнфЭксп Цикл
		
		НоваяСтрока = ДопИнфЭксп.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		 
		НоваяСтрока.Услуга = Справочники.КонтурЛогистика_ТранспортноЭкспедиционныеУслуги.НайтиСоздатьПоОбъектуXDTO(Элемент);
		КС.ЗаполнитьДокументыПоМассивуСоответствий(МассивЭлементов, Элемент, НоваяСтрока);
		
		КодВалюты = КС.XDTO_Вычислить(Элемент, "СвОплата.КодОКВ");
		НаименованиеВалюты = КС.XDTO_Вычислить(Элемент, "СвОплата.НаимОКВ");
		Если ЗначениеЗаполнено(КодВалюты) Или ЗначениеЗаполнено(НаименованиеВалюты) Тогда
			НоваяСтрока.Валюта = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С(КодВалюты, НаименованиеВалюты);
		КонецЕсли;
		
		КС.ЗаполнитьИнфПолИзXDTOсИдФайл(Элемент, ЭтотОбъект, "ИнфПол", НоваяСтрока.ИдентификаторСтроки, "ИдентификаторСтроки");
		
		ЗаполнитьМаршрут(Элемент, НоваяСтрока.ИдентификаторСтроки);
		ЗаполнитьИдентификаторыПартий(Элемент, НоваяСтрока);
	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьМаршрут(Услуга, Идентификатор)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_СвТрсГруз = КС.XDTO_Вычислить(Услуга, "СвТрсГруз");
	XDTO_СвТрсГруз = КС.XDTO_ВычислитьМассивXDTO(XDTO_СвТрсГруз);
	
	МассивЭлементов = Новый Массив;

	Для Каждого Элемент Из XDTO_СвТрсГруз Цикл
		
		НоваяСтрока = СвТрсГруз.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.ИдентификаторСтрокиРодитель = Идентификатор;
		НоваяСтрока.МаршСлГруз = КС.XDTO_Вычислить(Элемент, "МаршСлГруз");
		 
		КС.ЗаполнитьДокументыПоМассивуСоответствий(МассивЭлементов, Элемент, НоваяСтрока);
		
		ЗаполнитьТранспортВодителей(Элемент, НоваяСтрока.ИдентификаторСтроки);
	
	КонецЦикла;	
		
КонецПроцедуры

Процедура ЗаполнитьИдентификаторыПартий(Услуга, НоваяСтрока)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_ИдентПартГруз = КС.XDTO_Вычислить(Услуга, "ИдентПартГруз");
	XDTO_ИдентПартГруз = КС.XDTO_ВычислитьМассивXDTO(XDTO_ИдентПартГруз);
	
	Для Каждого Элемент Из XDTO_ИдентПартГруз Цикл
		НоваяСтрока.ИдентификаторыПартий = Элемент + ";"; 
	КонецЦикла;
	
	XDTO_НомПартГруз = КС.XDTO_Вычислить(Услуга, "НомПартГруз");
	XDTO_НомПартГруз = КС.XDTO_ВычислитьМассивXDTO(XDTO_НомПартГруз);
		
	Для Каждого Элемент Из XDTO_НомПартГруз Цикл
		НоваяСтрока.НомераПартий = Элемент + ";"; 
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьТранспортВодителей(Маршрут, Идентификатор)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_СвТсДост = КС.XDTO_Вычислить(Маршрут, "СвТсДост");
	XDTO_СвТсДост = КС.XDTO_ВычислитьМассивXDTO(XDTO_СвТсДост);
	
	МассивЭлементов = Новый Массив;

	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "ВидТС",  "ВидТС",  "ВидыТранспорта");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "ТипКузова",  "ТипКузова",  "");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "РегНомер",  "РегНомер",  "РегНомер");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "Марка",  "Марка",  "");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "Модель",  "Модель",  "");
	
	Для Каждого Элемент Из XDTO_СвТсДост Цикл
		
		НоваяСтрока = СвТсДост.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.ИдентификаторСтрокиРодитель = Идентификатор;
		 
		КС.ЗаполнитьДокументыПоМассивуСоответствий(МассивЭлементов, Элемент, НоваяСтрока);
		
		Если ЗначениеЗаполнено("НоваяСтрока.РегНомер") Тогда
			НоваяСтрока.ТранспортноеСредство = Справочники.КонтурЛогистика_ТранспортныеСредства.НайтиТранспортноеСредствоПоРегНомер(НоваяСтрока.РегНомер); 
		КонецЕсли;	
		
		ЗаполнитьВодителей(Элемент, НоваяСтрока.ИдентификаторСтроки);
	
	КонецЦикла;		
	
КонецПроцедуры	

Процедура ЗаполнитьВодителей(Транспорт, Идентификатор)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_Водитель = КС.XDTO_Вычислить(Транспорт, "СвВодит");
	XDTO_Водитель = КС.XDTO_ВычислитьМассивXDTO(XDTO_Водитель);
	
	МассивЭлементов = Новый Массив;

	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "РеквНаимДок",  "ПутевойЛист.РеквНаимДок",  "");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "РеквНомерДок",  "ПутевойЛист.ОснДовОргСост",  "");
	КС.ДобавитьСтрокуСоответствия(МассивЭлементов, "РеквДатаДок",  "ПутевойЛист.РеквДатаДок",  "ДатаТип");
		
	Для Каждого Элемент Из XDTO_Водитель Цикл
		
		НоваяСтрока = Водители.Добавить();
		НоваяСтрока.ИдентификаторСтрокиРодитель = Идентификатор;
		 
		КС.ЗаполнитьДокументыПоМассивуСоответствий(МассивЭлементов, Элемент, НоваяСтрока);
		
		НоваяСтрока.Водитель = КС.Конвертировать_СвВодит_вВодителяЛогистика(Элемент);
	
	КонецЦикла;		
	
КонецПроцедуры	

Процедура ЗаполнитьИныеДанныеЭксп(СодИнфЭксп)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ИныеДанЭкспМас = КС.XDTO_Вычислить(СодИнфЭксп, "ИныеДанЭксп");
	ИныеДанЭкспМас = КС.XDTO_ВычислитьМассивXDTO(ИныеДанЭкспМас);
	
	Для Каждого ИныеДанные Из ИныеДанЭкспМас Цикл 
		НоваяСтрока = ИныеДанныеЭксп.Добавить();
		НоваяСтрока.ДанныеИОговорки = ИныеДанные; 
	КонецЦикла;
	
КонецПроцедуры	

Функция СформироватьТекстФайла(ДатаФормирования, ВремяФормирования)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	ТипДокументооборота = "__PE";
	НомерТитула = 2;
	Формат = "5.01";
	ТипКодировки = "utf-8";
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ТекстФайла", "");
	
	XDTO_Файл = КС.XDTO_ФайлОбмена(НомерТитула, Формат, ТипДокументооборота);
	
	GUID = Строка(Новый УникальныйИдентификатор);
	// W = Число(ДополнительныеПолучателиФайла.Количество() > 0);
	
	XDTO_Файл.ИдФайл = КС.ИдентификаторФайлаТитулаПЭ(СвКлиент, СвЭксп, 0, GUID, 2); 

	Результат.Вставить("ИдФайл", XDTO_Файл.ИдФайл);
	
	Документ = КС.XDTO_Документ(НомерТитула, ТипДокументооборота);
	Документ.КНД = Документы.КонтурЛогистика_ПЭ_Титул2.КНД();
	Документ.НаимДок = Документы.КонтурЛогистика_ПЭ_Титул2.НаимДок();
	Документ.ДатИнфЭксп = КС.XDTO_ДатаТип(ДатаФормирования);
	Документ.ВрИнфЭксп = КС.XDTO_ВремяТип(ВремяФормирования);
	
	КС.XDTO_Установить(Документ, "ИдИнфКлнт", XDTO_ИдИнфКлнт());
	КС.XDTO_Установить(Документ, "СодИнфЭксп", XDTO_СодИнфЭксп(Формат));
	
	ПодписантСтруктура = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
		СвЭксп, ПользовательПодписант, ДатаФормирования, ЭтотОбъект);
	XDTO_Подписант = КС.XDTO_Подписант_ПЭ(ПодписантСтруктура, НомерТитула); 
	КС.XDTO_Установить(Документ, "ПодпИнфЭксп", XDTO_Подписант);
	
	КС.XDTO_Установить(XDTO_Файл, "Документ", Документ);
	
	ТекстФайла = КС.ПодготовитьТекстФайлаЛогистика(XDTO_Файл, Формат, ТипКодировки);
	
	Результат.Вставить("ТекстФайла", ТекстФайла);
	Результат.Вставить("GUID", GUID);
	
	Результат.Успешно = Истина;
	
	Возврат Результат;
	
КонецФункции

Функция XDTO_ИдИнфКлнт()
	
	КС = КонтурЛогистика_КонструкторыXDTO;

	ФайлОбмена = Справочники.КонтурЛогистика_ФайлыОбмена.НайтиФайлТитулаПоГлавномуДокументу(Ссылка.Титул1,
										Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1);

	Если ЗначениеЗаполнено(ФайлОбмена) Тогда
		
		ТекстФайла = ФайлОбмена.ТекстXML.Получить();
		
		XDTO = КС.ПолучитьXDTOпоXML(ТекстФайла);
		ИдФайлИнфКлнт = XDTO.ИдФайл;
		ДатФайлИнфКлнт = XDTO.Документ.ДатИнфКлнт;
		ВрФайлИнфКлнт = XDTO.Документ.ВрИнфКлнт;

		ДвоичныеДанныеПодписи = ФайлОбмена.Подпись.Получить();
		ЭП = Base64Строка(ДвоичныеДанныеПодписи);

		XDTO_ИдИнфКлнт = КС.XDTO_ИдИнфКлнт(ИдФайлИнфКлнт, ДатФайлИнфКлнт, ВрФайлИнфКлнт, ЭП);

	КонецЕсли;

	Возврат XDTO_ИдИнфКлнт;

КонецФункции

Функция XDTO_СодИнфЭксп(Формат)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_Объект = КС.XDTO_СодИнфПЭ2();
	КС.XDTO_Установить(XDTO_Объект, "УИД_ПорЭксп", УИД_ПорЭксп);
	
	XDTO_Объект.НомРеестр = СвЭксп.НомРеестр;
	XDTO_Объект.ДатаРеестр = КС.XDTO_ДатаТип(СвЭксп.ДатаРеестр);
	КС.XDTO_Установить(XDTO_Объект, "СодОпер", Документы.КонтурЛогистика_ПЭ_Титул2.СодОпер());
	
	// 
	// КС.XDTO_Установить(XDTO_Объект, "ИдИсхФайл", ); при наличие ИспрФО
	// Пока не реализовано, механизм внесений исправлений в файл обмена по требованию ФГИС
	 
	Для Каждого ДанныеИОговорки Из ИныеДанныеЭксп Цикл 
		XDTO_Объект.ИныеДанЭксп.Добавить(ДанныеИОговорки.ДанныеИОговорки);    
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ДопИнфЭксп Цикл 
		XDTO_Объект.ДопИнфЭксп.Добавить(XDTO_ДопИнфЭксп(Формат, СтрокаДанных));    
	КонецЦикла;
	 
	КС.УстановитьИнфПол(XDTO_Объект, ИнфПол, 2, "__PE", Формат);
	
	Возврат XDTO_Объект;
	
КонецФункции

Функция XDTO_ДопИнфЭксп(Формат, Данные)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_Объект = КС.XDTO_ДопИнфЭксп();
	XDTO_Объект.ПризнИсп = КС.СериализоватьПеречисление(Данные.ПризИсп);
	
	УслугаСсылка = Данные.Услуга;
	КС.XDTO_Установить(XDTO_Объект, "ИдентУсл", УслугаСсылка.ИдентУсл);
	Если ЗначениеЗаполнено(УслугаСсылка.НаименованиеУслуги) Тогда
		КС.XDTO_Установить(XDTO_Объект, "НаимУсл", УслугаСсылка.НаименованиеУслуги);
	Иначе 
		КС.XDTO_Установить(XDTO_Объект, "НаимУсл", "Перевозка");
	КонецЕсли;
	
	КС.XDTO_Установить(XDTO_Объект, "КодУсл", УслугаСсылка.КодУслуги);
	КС.XDTO_Установить(XDTO_Объект, "ХарактУсл", УслугаСсылка.ХарактУсл);
	КС.XDTO_Установить(XDTO_Объект, "ОКЕИ_Усл", УслугаСсылка.ОКЕИ_Усл);
	КС.XDTO_Установить(XDTO_Объект, "НаимЕдИзм", УслугаСсылка.НаимЕдИзм);
	
	КС.XDTO_Установить(XDTO_Объект, "КолУсл", Данные.Количество);
	
	КС.XDTO_Установить(XDTO_Объект, "СвОплата", КС.XDTO_СвОплата(Данные, Формат));
	
	Если Данные.ПризИсп = Перечисления.КонтурЛогистика_ТипИсполненияЭкспСвоихОбязательст._2 
		ИЛИ Данные.ПризИсп = Перечисления.КонтурЛогистика_ТипИсполненияЭкспСвоихОбязательст._3 Тогда 	
	
		СвПредстЭксп = КС.XDTO_СвПредстЭксп();
		Если ЗначениеЗаполнено(Данные.РекИдПредст) Тогда 
			КС.XDTO_Установить(СвПредстЭксп, "РекИдПредст", КС.XDTO_УчастникТрН(2, Формат, Данные.РекИдПредст, "__PE"));
		Иначе 
			КС.XDTO_Установить(СвПредстЭксп, "РекИдПредст", КС.XDTO_УчастникТипВводВручную(Данные, Формат));
		КонецЕсли;
		Если ЗначениеЗаполнено(Данные.ОснОкУслИным) Тогда
			КС.XDTO_Установить(СвПредстЭксп, "ОснОкУслИным", КС.XDTO_РеквДокТипПоСсылкеДоговору(2, Данные.ОснОкУслИным, "__PE", Формат));
		КонецЕсли;
		КС.XDTO_Установить(XDTO_Объект, "СвПредстЭксп", СвПредстЭксп); 
		
	КонецЕсли;
		
	УстановитьТСВодителей(Формат, Данные.ИдентификаторСтроки, XDTO_Объект);	
	
	Возврат XDTO_Объект;
	
КонецФункции 

Процедура УстановитьТСВодителей(Формат, ИдентификаторСтроки, XDTO_Объект)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Отбор = Новый Структура("ИдентификаторСтрокиРодитель", ИдентификаторСтроки);
	МассивСтрок = СвТрсГруз.НайтиСтроки(Отбор);
	
	Для Каждого Партия Из МассивСтрок Цикл
		
		Если ЗначениеЗаполнено(Партия.ИдентПартГруз) Тогда
			XDTO_Объект.ИдентПартГруз.Добавить(Партия.ИдентПартГруз);
		КонецЕсли;		
		Если ЗначениеЗаполнено(Партия.НомПартГруз) Тогда 
			XDTO_Объект.НомПартГруз.Добавить(Партия.НомПартГруз);
		КонецЕсли;	
		
		XDTO_Партия = КС.XDTO_СвТрсГруз(Формат);
		КС.XDTO_Установить(XDTO_Партия, "МаршСлГруз", СформироватьМаршрутСледования(Партия.маршрут));
		
		Отбор = Новый Структура("ИдентификаторСтрокиРодитель", Партия.ИдентификаторСтроки);
		МассивСтрок = СвТсДост.НайтиСтроки(Отбор);
			
			Для Каждого ТС Из МассивСтрок Цикл
				
				ТранспортноеСредство = КС.XDTO_СвТСДост(ТС.ТранспортноеСредство, ТС.ВидТС, Формат);
					
					Отбор = Новый Структура("ИдентификаторСтрокиРодитель", ТС.ИдентификаторСтроки);
					МассивСтрок = Водители.НайтиСтроки(Отбор);					
					
					Для Каждого СтрокаВодитель Из МассивСтрок Цикл
						
						СвВодит = КС.XDTO_СвВодит(2, СтрокаВодитель.Водитель, "__PE", "СодИнфЭксп.ДопИнфЭксп.СвТрсГруз.СвТСДост.СвВодит", Формат);
						Если ЗначениеЗаполнено(СтрокаВодитель.РеквДатаДок) И ЗначениеЗаполнено(СтрокаВодитель.РеквНомерДок) Тогда 
							ПутевойЛист = КС.XDTO_РеквДокТип_Экспедитор(СтрокаВодитель, 2, "__PE");
							КС.XDTO_Установить(СвВодит, "ПутевойЛист", ПутевойЛист);
						КонецЕсли;
						
						ТранспортноеСредство.СвВодит.Добавить(СвВодит);
						
					КонецЦикла;
									
				XDTO_Партия.СвТсДост.Добавить(ТранспортноеСредство);
				
			КонецЦикла;	
		
		XDTO_Объект.СвТрсГруз.Добавить(XDTO_Партия);	
		 
	КонецЦикла;	
	
КонецПроцедуры	

Функция СформироватьМаршрутСледования(Маршрут)
	
	Если ЗначениеЗаполнено(Маршрут.МаршСлГруз) Тогда
		Результат = Маршрут.МаршСлГруз;
	Иначе 
		Результат = "Точка погрузки: ";
		Результат = Результат + Маршрут.АдрГруз + "; Точка доставки: " + Маршрут.АдрПунктНазн; 
	КонецЕсли;		
	
	Возврат Результат
	
КонецФункции

Процедура СообщитьПользователю(ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры	

#КонецЕсли
