Функция ПолучитьЗапросСпискаДокументовМаршрута(Ссылка) Экспорт 
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
	|ГДЕ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1 = &Титул1
	|   И НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Титул1", Ссылка);
	
	Возврат Запрос;
	
КонецФункции

Функция ОтразитьПартиюТовараВ_ПЭ(ДокументСсылка) Экспорт
	
	Результат = Новый Структура("Документ_ПЭ1, Описание");
	
	РезультатПоиска = НайтиДокумент(ДокументСсылка);
	
	Если РезультатПоиска.СостояниеПоиска = "МожноДобавитьВСуществующийДокумент" Тогда 
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументОбъект.Титул1 = РезультатПоиска.ПЭ1;
		
		ДокументОбъект.Записать();
		
		Результат.Документ_ПЭ1 = РезультатПоиска.ПЭ1;
		Результат.Описание = "Партия была добавлена в существующий документ";
		
	ИначеЕсли РезультатПоиска.СостояниеПоиска = "УжеДобавлен" Тогда
		
		Результат.Документ_ПЭ1 = РезультатПоиска.ПЭ1;
		Результат.Описание = "Партия уже добавлена в существующий документ";
		
	ИначеЕсли РезультатПоиска.СостояниеПоиска = "СоздатьНовый" 
			Или РезультатПоиска.СостояниеПоиска = "СоздатьНовыйИзСпискаЗадач" Тогда
		
		Документ_ПЭ1 = СоздатьДокумент();
		
		МассивПартий = Новый Массив;
		МассивПартий.Добавить(ДокументСсылка);
		ПараметрыЗаполнения = Новый Структура("МассивПартий", МассивПартий);
		
		Документ_ПЭ1.Дата = ТекущаяДатаСеанса();
		Документ_ПЭ1.УстановитьНовыйНомер();  
						
		Документ_ПЭ1.Заполнить(ПараметрыЗаполнения);
		Документ_ПЭ1.Записать();
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументОбъект.Титул1 = Документ_ПЭ1.Ссылка;
		
		ДокументОбъект.Записать();
		
		Результат.Документ_ПЭ1 = Документ_ПЭ1.Ссылка;
		Результат.Описание = "Партия была добавлена в новый документ";
	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьДокументГлавныйДокумент(ФайлОбмена) Экспорт
	
	Документ = СоздатьДокумент();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	Попытка
		
		Документ.УстановитьНовыйНомер();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.Заполнить(ФайлОбмена);
		Документ.Записать();
		
		ЗаполнитьСвГруз(ФайлОбмена, Документ.Ссылка);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		Информация = ИнформацияОбОшибке();

		ТекстОшибки = "Ошибка при создании документа ПЭ_Титул1 по файлу " + ФайлОбмена
			+ ": " + ПодробноеПредставлениеОшибки(Информация);
		КонтурЛогистика_Метрика.ОбработатьОшибку("СоздатьДокументГлавныйДокумент", ТекстОшибки, ФайлОбмена);
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Документ.Ссылка;
	
КонецФункции
	
Процедура ЗаполнитьСвГруз(ФайлОбмена, Документ)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ТекстФайла = ФайлОбмена.ТекстXML.Получить();
	XDTO = КС.ПолучитьXDTOпоXML(ТекстФайла);
	Если XDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СодИнфКлт = КС.XDTO_Вычислить(XDTO, "Документ.СодИнфКлнт");
	Если СодИнфКлт = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	МассивСвГруз = КС.XDTO_Вычислить(СодИнфКлт, "СвГруз");
	МассивСвГруз = КС.XDTO_ВычислитьМассивXDTO(МассивСвГруз);
	
	ОбщиеДанные = ЗаполнитьОбщиеРеквизиты(Документ);
	
	Для Каждого Партия Из МассивСвГруз Цикл
		
		ДокументОбъект =  Документы.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.СоздатьДокумент();
		ДокументОбъект.УстановитьНовыйНомер();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДанныеЗаполнения = Новый Структура("СодИнфКлт, Партия, ОбщиеДанные", СодИнфКлт, Партия, ОбщиеДанные);
		ДокументОбъект.Заполнить(ДанныеЗаполнения);
		
		Если Документ.ЭтоВходящийШаблон Тогда
			РезультатПроверки = Документы.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПроверитьДокумент(ДокументОбъект);
			ДокументОбъект.Валидация = (РезультатПроверки.КоличествоОшибок = 0);
		КонецЕсли;	
		 
		ДокументОбъект.Титул1 = Документ; 
		
		ДокументОбъект.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры	

Функция ЗаполнитьОбщиеРеквизиты(Документ)
	
	ОбщиеРеквизиты = "НомДок, ДатаДок, СвЭксп, ДогТрЭксп";
	
	МассивОбщиеРеквизиты = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазложитьСтрокуВМассивСлов(ОбщиеРеквизиты, ",");
	ОбщиеДанные = Новый Структура(ОбщиеРеквизиты);
	
	Для Каждого Реквизит Из МассивОбщиеРеквизиты Цикл
		ОбщиеДанные[Реквизит] = Документ[Реквизит]; 
	КонецЦикла;
	
	ОбщиеДанные.Вставить("СвКлт", Документ.СвКлиент);	
	Возврат ОбщиеДанные;
	
КонецФункции

Процедура ОтразитьПартииТоваровВ_ПЭ1(Знач МассивДокументСсылка) Экспорт
	
	ТЗ_СтатусыДокументов = НайтиДокументы(МассивДокументСсылка);
	
	ПараметрыОтбора = Новый Структура("СостояниеПоиска", "МожноДобавитьВСуществующийДокумент");
	
	Строки_МожноДобавлятьВСуществующийДокумент = ТЗ_СтатусыДокументов.НайтиСтроки(ПараметрыОтбора);
	СтруктураДокументов = Новый Соответствие; 
	
	Для Каждого СтрокаТЗ Из Строки_МожноДобавлятьВСуществующийДокумент Цикл
		
		Если СтруктураДокументов.Получить(СтрокаТЗ.ПЭ_Титул1) = Неопределено Тогда 
			МассивДокументов = Новый Массив;
			МассивДокументов.Добавить(СтрокаТЗ.ПЭ_Партия);
			СтруктураДокументов.Вставить(СтрокаТЗ.ПЭ_Титул1, МассивДокументов);
		Иначе
			СтруктураДокументов.Получить(СтрокаТЗ.ПЭ_Титул1).Добавить(СтрокаТЗ.ПЭ_Партия);
		КонецЕсли;		
		
	КонецЦикла; 	
	
	Для Каждого Соответсвия Из СтруктураДокументов Цикл
		
		ДокументОбъект = Соответсвия.Ключ.ПолучитьОбъект();
		
		МассивДокументов = Соответсвия.Значение;
		Для Каждого ДокументПЭ_Партия Из МассивДокументов Цикл
			НоваяСтрока = ДокументОбъект.СвГруз.Добавить();
			НоваяСтрока.ПЭ_СвГруз = ДокументПЭ_Партия;
		КонецЦикла;
		
		ДокументОбъект.Записать();
			
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура("СостояниеПоиска", "СоздатьНовый");
	
	Строки_СоздатьНовый = ТЗ_СтатусыДокументов.НайтиСтроки(ПараметрыОтбора);
	СтруктураДокументов = Новый Соответствие; 
	
	Для Каждого СтрокаТЗ Из Строки_СоздатьНовый Цикл
		
		КлючСтрокиДокумента = СформироватьКлючСтрокиДокумента(СтрокаТЗ);
		
		Если СтруктураДокументов.Получить(КлючСтрокиДокумента) = Неопределено Тогда 
			МассивДокументов = Новый Массив;
			МассивДокументов.Добавить(СтрокаТЗ.ПЭ_Партия);
			СтруктураДокументов.Вставить(КлючСтрокиДокумента, МассивДокументов);
		Иначе
			СтруктураДокументов.Получить(КлючСтрокиДокумента).Добавить(СтрокаТЗ.ПЭ_Партия);
		КонецЕсли;		
		
	КонецЦикла; 	
	
	Для Каждого Соответсвия Из СтруктураДокументов Цикл
		
		МассивПартий = Соответсвия.Значение;
		
		ДокументОбъект = СоздатьДокумент();
		
		ПараметрыЗаполнения = Новый Структура("МассивПартий", МассивПартий);
		
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.УстановитьНовыйНомер();  
						
		ДокументОбъект.Заполнить(ПараметрыЗаполнения);
		ДокументОбъект.Записать();
		
		ДокументОбъект.Записать();
			
	КонецЦикла; 	
	
КонецПроцедуры

Функция СформироватьКлючСтрокиДокумента(СтрокаТЗ)
	
	Возврат СтрокаТЗ.НомДок + Формат(СтрокаТЗ.ДатаДок, "ДФ=yyyyMMdd");
	
КонецФункции	 	

Функция НайтиДокумент(ДокументСсылка, ТолькоИскатьВхождение = Ложь, ИсключаяДокументСсылка = Неопределено) Экспорт
	
	РезультатФункции = Новый Структура("ПЭ1, СостояниеПоиска");
	
	Если ЗначениеЗаполнено(ДокументСсылка.Титул1) тогда 	
		РезультатФункции.ПЭ1 = ДокументСсылка.Титул1;
		РезультатФункции.СостояниеПоиска = "УжеДобавлен";
	КонецЕсли; 
			
	Если ТолькоИскатьВхождение = Ложь Тогда
		Если ЗначениеЗаполнено(ДокументСсылка.НомДок) И ЗначениеЗаполнено(ДокументСсылка.ДатаДок) Тогда		
		
			Запрос = Новый Запрос();
			Запрос.Текст = "ВЫБРАТЬ
			|	КонтурЛогистика_ПЭ_Титул1.Ссылка КАК ПЭ_Титул1
			|ИЗ
			|	Документ.КонтурЛогистика_ПЭ_Титул1 КАК КонтурЛогистика_ПЭ_Титул1
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК
			|			КонтурЛогистика_СтатусыТитуловСрезПоследних
			|		ПО КонтурЛогистика_ПЭ_Титул1.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
			|ГДЕ
			|	НЕ КонтурЛогистика_ПЭ_Титул1.ПометкаУдаления
			|	И КонтурЛогистика_ПЭ_Титул1.НомДок = &НомДок
			|	И КонтурЛогистика_ПЭ_Титул1.ДатаДок = &ДатаДок
			|	И КонтурЛогистика_ПЭ_Титул1.СвКлиент = &СвКлиент
			|	И КонтурЛогистика_ПЭ_Титул1.СвЭксп = &СвЭксп
			|	И КонтурЛогистика_ПЭ_Титул1.ДогТрЭксп = &ДогТрЭксп
			|	И (КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус = Значение(Перечисление.КонтурЛогистика_СтатусыТитулов.Черновик)
			|     ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус Есть NULL)";
			
			Запрос.УстановитьПараметр("НомДок", ДокументСсылка.НомДок);
			Запрос.УстановитьПараметр("ДатаДок", ДокументСсылка.ДатаДок);
			Запрос.УстановитьПараметр("СвКлиент", ДокументСсылка.СвКлт);
			Запрос.УстановитьПараметр("СвЭксп", ДокументСсылка.СвЭксп);
			Запрос.УстановитьПараметр("ДогТрЭксп", ДокументСсылка.ДогТрЭксп);

			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				РезультатФункции.ПЭ1 = Выборка.ПЭ_Титул1;
				РезультатФункции.СостояниеПоиска = "МожноДобавитьВСуществующийДокумент";
			Иначе
				РезультатФункции.ПЭ1 = Неопределено;
				РезультатФункции.СостояниеПоиска = "СоздатьНовый";
			КонецЕсли;
		Иначе 
			РезультатФункции.ПЭ1 = Неопределено;
			РезультатФункции.СостояниеПоиска = "СоздатьНовыйИзСпискаЗадач";	
		КонецЕсли;
	КонецЕсли; 
	
	Возврат РезультатФункции;   			 
	
КонецФункции

// Функция выполняет поиск и анализ документов "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут"
// относительно их наличия в документах "КонтурЛогистика_ПЭ_Титул1"
//
// Параметры:
//  МассивДокументСсылка - Массив из ДокументСсылка - на документы "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут" для поиска
//  ИсключаяДокумент - ДокументСсылка - (Необязательный) Документ "КонтурЛогистика_ПЭ_Титул1", который исключается из поиска
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат анализа со следующими колонками:
//   * ПЭ_Титул1 - ДокументСсылка - Ссылка на найденный документ "КонтурЛогистика_ПЭ_Титул1" 
//   * НомДок - Строка - Номер документа "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут"
//   * ДатаДок - Дата - Дата документа "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут"
//   * ПЭ_Партия - ДокументСсылка - Ссылка на исходный документ "КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут"
//   * СостояниеПоиска - Строка - Статус документа:
//       "СоздатьНовый" - документ не найден в существующих титулах, можно создать новый
//       "МожноДобавитьВСуществующийДокумент" - найден титул с совпадающими номером и датой
//       "УжеДобавлен" - документ уже добавлен в существующий титул
Функция НайтиДокументы(Знач МассивДокументСсылка, ИсключаяДокумент = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.НомДок КАК НомДок,
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ДатаДок КАК ДатаДок
	|ПОМЕСТИТЬ ВТ_ДокументыПартииТоваров
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
	|ГДЕ
	|	НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления
	|	И КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка В (&МассивСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_Титул1СвГруз.Ссылка Как ПЭ_Титул1,
	|	ВТ_ДокументыПартииТоваров.Ссылка Как ПЭ_Партия,
	|	Выбор
	|		Когда КонтурЛогистика_ПЭ_Титул1СвГруз.Ссылка Есть Null
	|			Тогда ""НеДобавлен""
	|		Иначе ""УжеДобавлен""
	|	Конец Как СостояниеПоиска,
	|	ВТ_ДокументыПартииТоваров.НомДок,
	|	ВТ_ДокументыПартииТоваров.ДатаДок
	|ПОМЕСТИТЬ ВТ_ДокументыСПризнакомРазнесения
	|ИЗ
	|	ВТ_ДокументыПартииТоваров КАК ВТ_ДокументыПартииТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЭ_Титул1.СвГруз КАК КонтурЛогистика_ПЭ_Титул1СвГруз
	|		ПО КонтурЛогистика_ПЭ_Титул1СвГруз.ПЭ_СвГруз = ВТ_ДокументыПартииТоваров.Ссылка
	|ГДЕ
	|   КонтурЛогистика_ПЭ_Титул1СвГруз.Ссылка Есть Null 
	|	Или (НЕ КонтурЛогистика_ПЭ_Титул1СвГруз.Ссылка.ПометкаУдаления
	|	И НЕ КонтурЛогистика_ПЭ_Титул1СвГруз.Ссылка = &ИсключаяДокумент)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕстьNUll(КонтурЛогистика_ПЭ_Титул1.Ссылка, Значение(Документ.КонтурЛогистика_ПЭ_Титул1.ПустаяСсылка)) Как ПЭ_Титул1,
	|	ВТ_ДокументыСПризнакомРазнесения.НомДок КАК НомДок,
	|	ВТ_ДокументыСПризнакомРазнесения.ДатаДок КАК ДатаДок,
	|	ВТ_ДокументыСПризнакомРазнесения.ПЭ_Партия КАК ПЭ_Партия,
	|	ВЫБОР
	|		КОГДА КонтурЛогистика_ПЭ_Титул1.Ссылка Есть NULL
	|			Тогда ""СоздатьНовый""
	|		ИНАЧЕ ""МожноДобавитьВСуществующийДокумент""
	|	КОНЕЦ КАК СостояниеПоиска
	|ИЗ
	|	ВТ_ДокументыСПризнакомРазнесения КАК ВТ_ДокументыСПризнакомРазнесения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЭ_Титул1 КАК КонтурЛогистика_ПЭ_Титул1
	|		ПО КонтурЛогистика_ПЭ_Титул1.НомДок = ВТ_ДокументыСПризнакомРазнесения.НомДок
	|		И КонтурЛогистика_ПЭ_Титул1.ДатаДок = ВТ_ДокументыСПризнакомРазнесения.ДатаДок
	|		И НЕ КонтурЛогистика_ПЭ_Титул1.ПометкаУдаления
	|ГДЕ
	|	ВТ_ДокументыСПризнакомРазнесения.СостояниеПоиска = ""НеДобавлен""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДокументыСПризнакомРазнесения.ПЭ_Титул1 КАК ПЭ_Титул1,
	|	ВТ_ДокументыСПризнакомРазнесения.НомДок КАК НомДок,
	|	ВТ_ДокументыСПризнакомРазнесения.ДатаДок КАК ДатаДок,
	|	ВТ_ДокументыСПризнакомРазнесения.ПЭ_Партия КАК ПЭ_Партия,
	|	ВТ_ДокументыСПризнакомРазнесения.СостояниеПоиска КАК СостояниеПоиска
	|ИЗ
	|	ВТ_ДокументыСПризнакомРазнесения КАК ВТ_ДокументыСПризнакомРазнесения
	|ГДЕ
	|	ВТ_ДокументыСПризнакомРазнесения.СостояниеПоиска = ""УжеДобавлен""";
	
	Запрос.УстановитьПараметр("МассивСсылка", МассивДокументСсылка);
	Запрос.УстановитьПараметр("ИсключаяДокумент", ИсключаяДокумент);
	
	ТЗ_Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ_Результат;   			 
	
КонецФункции	

