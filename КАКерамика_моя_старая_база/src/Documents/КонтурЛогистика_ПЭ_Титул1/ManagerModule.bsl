Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)
	
	КатегорияОшибкиОбъекта = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" ИЛИ Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			ОбязательныйРевизитСиноним = СинонимРеквизита(ОбязательныйРевизит);
			ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				ОбязательныйРевизит, КатегорияОшибкиОбъекта, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.ЭтоШаблон Тогда
	
		Если Не ЗначениеЗаполнено(Объект.СвКлиент) Тогда 
		
			ТекстОшибки = "Заполните организацию получателя шаблона";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"СвКлиент", КатегорияОшибка, ТекстОшибки, "Заполнить");
		
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ОтправительШаблона) Тогда 
		
			ТекстОшибки = "Укажите организацию оформителя шаблона";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					?(Объект.СвЭксп = Объект.ОтправительШаблона, "СвЭксп", "ОтправительШаблона"), КатегорияОшибка, ТекстОшибки, "Заполнить");
		
		КонецЕсли;
	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДогТрЭксп.НомерДокумента) Тогда 
		
		ТекстОшибки = "Заполните номер для договора экспедиции.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ДогТрЭксп.НомерДокумента", КатегорияОшибкиОбъекта, ТекстОшибки, "Заполнить");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДогТрЭксп.ДатаДокумента) Тогда 
		
		ТекстОшибки = "Заполните дату для договора экспедиции.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"ДогТрЭксп.ДатаДокумента", КатегорияОшибкиОбъекта, ТекстОшибки, "Заполнить");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДогТрЭксп) Тогда
		
		Справочники.КонтурЛогистика_Договоры.ПроверитьСтороныДоговора(
			Объект.ДогТрЭксп, ТаблицаОшибок, КатегорияОшибкиОбъекта, "ДогТрЭксп");
		
		Если ЗначениеЗаполнено(Объект.СвКлиент)
			И Не Справочники.КонтурЛогистика_Договоры.СторонаДоговораСовпадаетСОрганизациейДиадок(
				Объект.ДогТрЭксп.Организация, Объект.ДогТрЭксп.ОрганизацияИНН, Объект.СвКлиент) Тогда
			
			ТекстОшибки = "Организация в договоре экспедиции не совпадает с заказчиком (клиентом) документа";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"ДогТрЭксп.Организация", КатегорияОшибкиОбъекта, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.СвЭксп)
			И Не Справочники.КонтурЛогистика_Договоры.СторонаДоговораСовпадаетСОрганизациейДиадок(
				Объект.ДогТрЭксп.Контрагент, Объект.ДогТрЭксп.КонтрагентИНН, Объект.СвЭксп) Тогда
			
			ТекстОшибки = "Контрагент в договоре экспедиции не совпадает с экспедитором документа";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"ДогТрЭксп.Контрагент", КатегорияОшибкиОбъекта, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СвКлиент) Тогда
		Справочники.КонтурЛогистика_ОрганизацииДиадок.ПроверитьРеквизитыУчастникаДляФайлаОбмена(
			Объект.СвКлиент, "СвКлиент", "заказчика", ТаблицаОшибок, КатегорияОшибкиОбъекта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СвЭксп) Тогда
		Справочники.КонтурЛогистика_ОрганизацииДиадок.ПроверитьРеквизитыУчастникаДляФайлаОбмена(
			Объект.СвЭксп, "СвЭксп", "экспедитора", ТаблицаОшибок, КатегорияОшибкиОбъекта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СвКлиент)
		И ЗначениеЗаполнено(Объект.СвЭксп)
		И Объект.СвКлиент = Объект.СвЭксп Тогда
		
		ТекстОшибки = "Заказчик и экспедитор не могут быть одной организацией.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"СвЭксп", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьТабЧастьПартииДокументов(ДокументОбъектИлиСсылка, ТаблицаОшибок, ДополнительныеДанныеПроверки,
		ЗаполненностьКакПредупреждение = Ложь)
	
	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Валидация КАК Валидация,
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка,
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
	|ГДЕ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1 В (&Ссылка)
	|	И НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления";
		
	Если Не ДополнительныеДанныеПроверки = Неопределено И ДополнительныеДанныеПроверки.Свойство("МаршрутыГруза") Тогда
		МаршрутыГруза = ДополнительныеДанныеПроверки.МаршрутыГруза;
		Запрос.УстановитьПараметр("Ссылка", МаршрутыГруза);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Титул1", "Ссылка");
	Иначе 
		Запрос.УстановитьПараметр("Ссылка", ДокументОбъектИлиСсылка.Ссылка);	
	КонецЕсли;  
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ИмяТЧ = "МаршрутыГруза";
	
	Если РезультатЗапроса.Пустой() Тогда
		
		ТекстОшибки = "В титуле не выбран ни один маршрут"; 
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, , 
					, КатегорияОшибка, ТекстОшибки, "Исправить");
		
	КонецЕсли;	  
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Валидация = Ложь 
			Или Выборка.ПометкаУдаления Тогда 
				 
			Если Выборка.Валидация = Ложь Тогда 
				ТекстОшибки = "В документе " + Выборка.Ссылка + " есть ошибки валидации.";
			Иначе
				ТекстОшибки = "Документ " + Выборка.Ссылка + " помечен на удаление. Необходимо удалить его из титула.";
			КонецЕсли;
		
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, , 
					"МаршрутыГруза", КатегорияОшибка, ТекстОшибки, "Исправить");
	
		КонецЕсли;			
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСопроводительныеДокументы(Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)

	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);

	Для Каждого Документ Из Объект.СопрДок Цикл
		
		Если Не ЗначениеЗаполнено(Документ.РеквНаимДок)
			Или Не ЗначениеЗаполнено(Документ.РеквНомерДок)
			Или Не ЗначениеЗаполнено(Документ.РеквДатаДок) Тогда
		
			ТекстОшибки = "Для сопроводительного документа не указаны обязательные реквизиты.";	
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "СопрДок", Документ.НомерСтроки, 
				"НомерСтроки", КатегорияОшибка, ТекстОшибки, "Указать");
		
		КонецЕсли; 				

	КонецЦикла;
КонецПроцедуры	

Функция СинонимРеквизита(ИмяРеквизита) Экспорт

	Попытка
		Возврат Метаданные.Документы.КонтурЛогистика_ПЭ_Титул1.Реквизиты[ИмяРеквизита].Синоним;
	Исключение
		Возврат ИмяРеквизита;
	КонецПопытки;

КонецФункции

Функция ПолучитьДанныеДляМетрик(Документ) Экспорт
	
	Результат = Новый Структура("Переменные, Path_Category, Path_View");
	Результат.Path_Category = "Подписание и отправка ПЭ1";
	Результат.Path_View = "Документ.КонтурЛогистика_ПЭ_Титул1.Форма.ФормаДокумента";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(МИНИМУМ(КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ОтмПрием), ЛОЖЬ) КАК ПриемВоВладение,
	|	МИНИМУМ(КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1.СвКлиент.ID) КАК BoxIdОтправитель,
	|	ЕСТЬNULL(МИНИМУМ(КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.УказКлнт), ЛОЖЬ) КАК УсловияПеревозки,
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Маршрут,
	|	МИНИМУМ(ЕСТЬNULL(КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1.ЭтоВходящийШаблон, ЛОЖЬ)) КАК ЭтоВходящийШаблон,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутСвУсл.Ссылка), 0) КАК КоличествоТЭУ
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.СвУсл КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутСвУсл
	|		ПО КонтурЛогистика_ПЭ_ЗаявкаНаМаршрутСвУсл.Ссылка = КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка
	|ГДЕ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1 = &Титул1
	|	И НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка";
	
	Запрос.УстановитьПараметр("Титул1", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Переменные = Новый Структура("BoxIdОтправитель, КоличествоМаршрутов, Маршруты");
	Маршруты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Переменные.BoxIdОтправитель = Выборка.BoxIdОтправитель;	
		Маршрут = Новый Структура("УсловияПеревозки, ПриемВоВладение, ТЭУ, ЭтоВходящийШаблон");
		Маршрут.УсловияПеревозки = ЗначениеЗаполнено(Выборка.УсловияПеревозки);
		Маршрут.ЭтоВходящийШаблон = Выборка.ЭтоВходящийШаблон;
		Маршрут.ТЭУ = Выборка.КоличествоТЭУ > 0;
		Маршрут.ПриемВоВладение = Выборка.ПриемВоВладение;
		Маршруты.Добавить(Маршрут);
	КонецЦикла;
	
	Переменные.Маршруты = Маршруты;
	Переменные.КоличествоМаршрутов = Маршруты.Количество();
	
	Результат.Переменные = Переменные;
	
	Возврат Результат;
	 	
КонецФункции	

#КонецЕсли
