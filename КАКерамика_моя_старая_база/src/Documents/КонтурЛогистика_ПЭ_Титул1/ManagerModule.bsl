#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, ДополнительныеДанныеПроверки = Неопределено, ТребуемоеДействие = Неопределено) Экспорт 
	
	ОДС = КонтурЛогистика_ОбработкаДокументовСервер;
	
	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТаблицаОшибок.Очистить();
	
	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка, Истина);
	
	ЭтоОтправкаШаблона = ДокументОбъектИлиСсылка.ЭтоШаблон;
	ОтправкаНезаблокированногоШаблона = ЭтоОтправкаНезаблокированногоШаблона(ДокументОбъектИлиСсылка);
	
	ТаблицаОшибок.Очистить();
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		КонтурЛогистика_ПанельОшибокСервер.ВывестиОшибкуТекущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок)
	КонецЕсли;

	Если Перечисления.КонтурЛогистика_СтатусыТитулов.СтатусДокументаТребуетПроверки(ТекСтатусТитула) Тогда

		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		ОрганизацияАвторизации = ДокументОбъектИлиСсылка.СвКлиент;
		Если ДокументОбъектИлиСсылка.ЭтоШаблон Тогда
			ОрганизацияАвторизации = ДокументОбъектИлиСсылка.ОтправительШаблона;
		КонецЕсли;
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка, Неопределено,
		   ТаблицаОшибок, ОрганизацияАвторизации);
		   
		Если Не ЭтоОтправкаШаблона Тогда
			ТребуетсяПодпись = Истина;
			Если ДополнительныеДанныеПроверки <> Неопределено
				И ДополнительныеДанныеПроверки.Свойство("ТребуетсяПодпись") Тогда
				ТребуетсяПодпись = ДополнительныеДанныеПроверки.ТребуетсяПодпись;
			КонецЕсли;
			Если ТребуетсяПодпись Тогда
				ОДС.Валидатор_ПроверитьПодписанта(ДокументОбъектИлиСсылка, ТаблицаОшибок, ТребуемоеДействие,
					ДополнительныеДанныеПроверки);
			КонецЕсли;
		КонецЕсли;   
		
		// Незаблокированный шаблон (ДоступныВсеПоля) может быть неполным — проверки заполненности выводятся как предупреждения.
		ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок, ОтправкаНезаблокированногоШаблона);
		ПроверитьТабЧастьПартииДокументов(ДокументОбъектИлиСсылка, ТаблицаОшибок, ДополнительныеДанныеПроверки,
			ОтправкаНезаблокированногоШаблона);
		ПроверитьСопроводительныеДокументы(ДокументОбъектИлиСсылка, ТаблицаОшибок, ОтправкаНезаблокированногоШаблона);
		
		// ПроверитьТабЧастьТовары(ДокументОбъектИлиСсылка, ТаблицаОшибок, ТекСтатусТитула);
		
		// КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьДружбуКонтрагентов(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		
		ОДС.Валидатор_ПроверитьОтправителя(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		ОДС.Валидатор_ПЭ_ПроверитьРегистрациюЛицВДиадоке(ДокументОбъектИлиСсылка.СвКлиент, ДокументОбъектИлиСсылка.СвЭксп, ТаблицаОшибок);
		
	ИначеЕсли ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена Тогда 
		
		// КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		// КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиДругихСторон(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
	КонецЕсли;
	
	// КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьРоуминг(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("НомДок");
	Поля.Добавить("ДатаДок");
	Поля.Добавить("ЭтоШаблон");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = "Поручение экспедитору №" + Данные.НомДок + " от " + Формат(Данные.ДатаДок, "ДФ=dd.MM.yy");
	Если Данные.ЭтоШаблон Тогда
		Представление = Представление + " (Шаблон)";
	КонецЕсли;
	
КонецПроцедуры

Функция ТекущаяВерсияСТД() Экспорт
	
