Процедура ЗаполнитьМарк(XDTO, ЗаполняемыйОбъект, Идентификатор)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
 
	РеквизитСхемы = "Марк";
	Реквизит1С = "МаркировкаГруза";
	
	ЭлементXDTO = КС.XDTO_Вычислить(XDTO, РеквизитСхемы);
