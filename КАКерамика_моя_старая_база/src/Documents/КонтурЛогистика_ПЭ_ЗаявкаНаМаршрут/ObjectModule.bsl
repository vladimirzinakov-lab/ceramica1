	// КодТовОКПД2
	// КодГрузГНГ
	// КодГрузЕТСНГ
	
	ДобавитьСтрокуСоответствия(МассивЭлементов, "МассаБруттоКг", "ВесГруз.ВесБрутто", "Число");
