	ДобавитьСтрокуСоответствия(МассивЭлементов, "ВесУпак", "ВесУпак", "Число"); 
	ДобавитьСтрокуСоответствия(МассивЭлементов, "КолУпак", "КолУп", "Число"); 
	ДобавитьСтрокуСоответствия(МассивЭлементов, "ВысЗнач", "ГабарУпак.ВысЗнач", "Число");
	ДобавитьСтрокуСоответствия(МассивЭлементов, "ДлЗнач", "ГабарУпак.ДлЗнач", "Число");
	ДобавитьСтрокуСоответствия(МассивЭлементов, "ШирЗнач", "ГабарУпак.ШирЗнач", "Число"); 
	
	МассивЗначений = КС.XDTO_Вычислить(ОпГруз, "ИнфУпГруз", Новый Массив);
	МассивЗначений = КС.XDTO_ВычислитьМассивXDTO(МассивЗначений);
	
	Для Каждого Значение Из МассивЗначений Цикл
		СтрокаТЧ = ИнфУпГруз.Добавить();
		СтрокаТЧ.ИдентификаторСтрокиТоваров = ИдентификаторСтрокиТоваров;
		КС.ЗаполнитьДокументыПоМассивуСоответствий(МассивЭлементов, Значение, СтрокаТЧ);
	КонецЦикла;

КонецПроцедуры	

