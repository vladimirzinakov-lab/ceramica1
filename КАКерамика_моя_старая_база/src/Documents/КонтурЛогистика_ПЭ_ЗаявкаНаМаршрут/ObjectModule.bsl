Процедура СконвертироватьСтрокуТоваров1СвЛогистика(НомерСтроки) Экспорт
	
	СтрокаТоваров = Товары.Найти(НомерСтроки, "НомерСтроки");
	
	// сформировать расширенную (с упаковками) строку товаров
	ТЗ_ТоварыВременная = Товары.ВыгрузитьКолонки(); 
	
	СтрокаТоваровВременная = ТЗ_ТоварыВременная.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТоваровВременная, СтрокаТоваров);
	
	КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	
	// положить расширенную строку товаров обратно в ТоварыДокумента1С
	ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаТоваровВременная);
	
КонецПроцедуры

Процедура ЗаполнитьПоДокОснованию(Знач ДокументОснование, ТипЛогистика)
	
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		    ТипЛогистика, ДокументОснование);
	
	// Заполнить ЭтотТитул
	Если КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
		КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
			ЭтотОбъект, КонтекстНастройкиКонвертации);
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОчиститьСтрокиТабличныхЧастейБезИдентификатораСтроки()

	СписокОчищаемыхТабличныхЧастей = "СведенияГосСистем,ИнфУпГруз,Марк,СтраныПроисхожденияПродукции";
	МассивИдентификаторов = Товары.ВыгрузитьКолонку("ИдентификаторСтроки");

	ОчищаемыеТЧ = КонтурЛогистика_СтдСтрКлиентСервер.РазложитьСтрокуВМассивПодстрокЛок(СписокОчищаемыхТабличныхЧастей);

	Для Каждого НазваниеТЧ Из ОчищаемыеТЧ Цикл

		ТЧ = ЭтотОбъект[НазваниеТЧ];

		Для Каждого СтрокаТЧ Из ТЧ Цикл

			Если МассивИдентификаторов.Найти(СтрокаТЧ.ИдентификаторСтрокиТоваров) = Неопределено Тогда
				ТЧ.Удалить(СтрокаТЧ);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

