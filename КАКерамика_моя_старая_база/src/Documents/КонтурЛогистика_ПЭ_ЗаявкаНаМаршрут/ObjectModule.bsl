Процедура ЗаполнитьСтоимость(ОпГруз, ЗаполняемыйОбъект, Префикс = "")
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СтоимостьОбъявл = КС.XDTO_Вычислить(ОпГруз, "Объявл" + Префикс, Неопределено);
	СтоимостьДейст = КС.XDTO_Вычислить(ОпГруз, "Дейст" + Префикс, Неопределено);
	
	Если СтоимостьОбъявл <> Неопределено Тогда
		Стоимость = СтоимостьОбъявл;
		ЗаполняемыйОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ОбъявленнаяСтоимость;
	ИначеЕсли СтоимостьДейст <> Неопределено Тогда
		Стоимость = СтоимостьДейст;
		ЗаполняемыйОбъект.ТипСтоимости = Перечисления.КонтурЛогистика_ТипСтоимостиГруза.ДействительнаяСтоимость; 
	Иначе 
		Возврат ;			 
	КонецЕсли;
		
	КодВалюты = КС.XDTO_Вычислить(Стоимость, "КодОКВ");
	НаименованиеВалюты = КС.XDTO_Вычислить(Стоимость, "НаимОКВ");
	ЗаполняемыйОбъект.ВалютаУчетаГруза = КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С(КодВалюты, НаименованиеВалюты);
	ЗаполняемыйОбъект.СтоимостьГруза = КС.XDTO_ВычислитьЧисло(Стоимость, "СтГр");

