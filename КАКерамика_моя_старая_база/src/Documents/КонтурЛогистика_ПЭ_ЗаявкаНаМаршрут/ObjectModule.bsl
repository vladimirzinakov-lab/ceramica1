	Для Каждого Значение Из МассивXDTO Цикл
		
		Если Не Значение = "Отсутствует" Тогда
		
			НоваяСтрока = ЗаполняемыйОбъект.Добавить();
			НоваяСтрока[Реквизит1С] = Значение;
			НоваяСтрока.ИдентификаторСтрокиТоваров = Значение;
		
		КонецЕсли;
		
	КонецЦикла;
	
