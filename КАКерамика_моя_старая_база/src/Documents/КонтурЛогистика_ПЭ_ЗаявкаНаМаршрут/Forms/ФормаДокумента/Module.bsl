&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;	 
	
	Если Элемент.ТекущиеДанные.ИдентификаторСтроки = "" Тогда 		
		Элемент.ТекущиеДанные.Учитывать = Истина;
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиТоваров",
												  Элемент.ТекущиеДанные.ИдентификаторСтроки);
	Элементы.СведенияГосСистем.ОтборСтрок = ОтборСтрок;
	Элементы.ИнфУпГруз.ОтборСтрок = ОтборСтрок;
	КоличествоОписанныхУпаковок = ИтогИнфУпГруз(Элемент.ТекущиеДанные.ИдентификаторСтроки);
	Элементы.Марк.ОтборСтрок = ОтборСтрок;
	
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиТоваров", Элемент.ТекущиеДанные.ИдентификаторСтроки);
	Элементы.ИнфПолСтрокаТоваров.ОтборСтрок = ОтборСтрок;

	КонтурЛогистика_ПанельОшибокКлиент.УстановитьОтборТаблицыОшибокПоНомеруСтроки(ТаблицаОшибок,
																				  Элементы.Товары.ТекущиеДанные);
																				  
	Элементы.ГруппаПодробныеСведенияГосСист.Видимость = Элементы.Товары.ТекущиеДанные.УчГосСист;
	
	СтранаГруза = КонтурЛогистика_ОбщегоНазначенияКлиент.РассчитатьПредставлениеСтран(
		Объект.СтраныПроисхожденияПродукции, Элемент.ТекущиеДанные.ИдентификаторСтроки);
	
КонецПроцедуры

