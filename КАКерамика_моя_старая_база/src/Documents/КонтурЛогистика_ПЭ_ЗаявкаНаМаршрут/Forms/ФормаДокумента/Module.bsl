&НаКлиенте
Процедура ДогТрЭкспПриИзменении(Элемент)
	
	// TODO выводить предупреждение при изменении реквизитов, если они не заполнены
	
	ДанныеДоговораПоОрганизациям = ПолучитьОрганизацииДоговора(Объект.ДогТрЭксп);
	Если ЗначениеЗаполнено(ДанныеДоговораПоОрганизациям.Заказчик) Тогда
		Объект.СвКлт = ДанныеДоговораПоОрганизациям.Заказчик; 
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДанныеДоговораПоОрганизациям.Экспедитор) Тогда
		Объект.СвЭксп = ДанныеДоговораПоОрганизациям.Экспедитор; 
	КонецЕсли;	
	
	ПроверитьДокумент();
	
