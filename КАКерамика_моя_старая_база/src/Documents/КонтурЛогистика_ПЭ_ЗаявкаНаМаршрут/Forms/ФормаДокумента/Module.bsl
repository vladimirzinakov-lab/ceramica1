#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ТоварыХарактеристика.Видимость = 
		(КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.КонфигурацияПоддерживаетХарактеристики()
			И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяХарактеристики") = Истина);
	
	УстановитьЗначениеПоУмолчаниюДляНовогоДокумента();
	
	Параметры.Свойство("ОткрытоИзТитула", ОткрытоИзТитула);
	Параметры.Свойство("ЭтоШаблонТитула", ЭтоШаблонТитула);
	Параметры.Свойство("ЗаполненностьКакПредупреждение", ЗаполненностьКакПредупреждение);
	
	Если ЗначениеЗаполнено(Объект.Титул1) Тогда
		
		СценарийРедактированияШаблона = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
			Объект.Титул1, "СценарийРедактированияШаблона");
		
		Если СценарийРедактированияШаблона = Перечисления.КонтурЛогистика_СценарииРедактированияШаблона.НеРедактируется Тогда
			СценарийНеРедактируется = Истина;
		КонецЕсли;
		
		ЭтоВходящийШаблон = Объект.Титул1.ЭтоВходящийШаблон;
	КонецЕсли;
	
	Если Параметры.Свойство("ПараметрыСозданияМаршрута") Тогда
		ЗаполнитьЗначенияСвойств(Объект, Параметры.ПараметрыСозданияМаршрута); 
	КонецЕсли;	
			
	ОбновитьДанныеФормы();
		
	УстановитьПоведениеКлючевыхЭлементовФормы();
	
	Если Параметры.Свойство("ОткрытьСтраницуКонтейнер") Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСведенияОконтейнерах;
	КонецЕсли;	
	
	// КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПроверитьДокумент();
	
	ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтрокиТоваров", "");
	Элементы.ИнфПолСтрокаТоваров.ОтборСтрок = ОтборСтрок;
	
	Если ЗначениеЗаполнено(Объект.Титул1) Тогда
		Элементы.ФормаЗаписатьИЗакрыть.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
		 
	Элементы.ФормаДобавитьПартиюВТитул.Видимость = НЕ (ЗначениеЗаполнено(Объект.Титул1) Или ОткрытоИзТитула);	 
	
	УстановитьВозможностьРедактированияСтоимости();
	
	Если Не Объект.УказыватьСтоимостьГрузаВручную Тогда
		Объект.СтоимостьГруза = Итог("СтоимостьГруза");
	КонецЕсли;
	
	СкрытьПоказатьЗначенияДокУчСист();
	УстановитьДоступностьТЧКонтейнеры();
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("КонтурЛогистика_ИзменениеДокумента_ПЭ_Партии");
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" И Параметр = Объект.Ссылка Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов" 
		И Параметр <> Неопределено 
		И ТипЗнч(Параметр) = Тип("Массив") 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда 
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьДокументЛогистики" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);

	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ПерепроверитьДокумент" Тогда
		
		ПодключитьОбработчикОжидания("ПроверитьДокумент", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
			  И Параметр <> Неопределено
			  И ТипЗнч(Параметр) = Тип("Массив")
			  И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда

		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораНоменклатуры(ВыбранноеЗначение, ПараметрИдСтрокиТоваров) Экспорт

	Если ВыбранноеЗначение <> Неопределено Тогда

		ТекДанные = Объект.Товары.НайтиПоИдентификатору(ПараметрИдСтрокиТоваров);
		ТекДанные.Номенклатура = ВыбранноеЗначение;

		ОбработчикПереконвертироватьСтроку(ПараметрИдСтрокиТоваров, ТекДанные);
		
		УстановитьВидимостьНоменклатуры();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВыбораЕдиницыИзмерения(ВыбранноеЗначение, ПараметрИдСтрокиТоваров) Экспорт

	Если ВыбранноеЗначение <> Неопределено Тогда

		ТекДанные = Объект.Товары.НайтиПоИдентификатору(ПараметрИдСтрокиТоваров);
		ТекДанные.УпаковкаЕдиницаИзмерения = ВыбранноеЗначение;

		ОбработчикПереконвертироватьСтроку(ПараметрИдСтрокиТоваров, ТекДанные);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикИзмененияСоответствий(Параметр, ДопПараметр) Экспорт

	Если ЗначениеЗаполнено(ДопПараметр) Тогда

		локМассивСтрокСЭтойНоменклатурой = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ДопПараметр));
		локМассивИдентификаторов = Новый Массив();

		Для Каждого СтрокаПереконвертации Из локМассивСтрокСЭтойНоменклатурой Цикл

			СконвертироватьСтрокуТоваровКлиент(СтрокаПереконвертации.ПолучитьИдентификатор());
			локМассивИдентификаторов.Добавить(СтрокаПереконвертации.ИдентификаторСтроки);

		КонецЦикла;
		
		ЗаполнитьТребуемыеДействияТоваров();
		ПроверитьДокумент(); 

		ПересчитатьЗаголовкиКоличества(ЭтаФорма);
		ПересчитатьВсеИтоги();
		
		Модифицированность = Истина;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДокументаОснования(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	КонтурЛогистика_РаботаСЭлементамиФормыКлиент.ОбработатьВыборДокументаОснование(ВыбранноеЗначение, Объект, ЭтаФорма);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПереконвертироватьСтроку(ИдСтрокиТоваров, ТекДанные)

	СконвертироватьСтрокуТоваровКлиент(ИдСтрокиТоваров);
	СформироватьТребуемоеДействиеСтрокиТовара(ТекДанные);
	ПересчитатьВсеИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикПеречитатьОбъект()

	ЭтаФорма.Прочитать();
	ОбновитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()

	ЭтаФорма.Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикВопросаУстановитьЗначениеВТоварах(ВозвратДиалога, ДанныеЗамены) Экспорт
	
	Если ВозвратДиалога = КодВозвратаДиалога.Да Тогда
		УстановитьЗначениеВТоварах(ДанныеЗамены.Реквизит, ДанныеЗамены.Значение);		
	КонецЕсли;
	
	ПроверитьДокумент();
		
КонецПроцедуры	

&НаКлиенте
Процедура ОбработчикПерепроверить(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	
	ПроверитьДокумент();
	
КонецПроцедуры

#КонецОбласти

