&НаКлиенте
Процедура ВидТСПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ПроверитьДокумент();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьДатыОтгрузкиПоУмолчаниюНаСервере()
	
	СтруктураДефолтов = Новый Структура;
	СтруктураДефолтов.Вставить("ПЭ_ДатОтгрСДнейПлюсОтТек", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ДатОтгрСДнейПлюсОтТек"));
	СтруктураДефолтов.Вставить("ПЭ_ДнейНаПогрузку", КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ДнейНаПогрузку"));
	
	Возврат СтруктураДефолтов;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДатыОтгрузкиПоУмолчанию(Команда)
	
	СтруктураДефолтов = ЗаполнитьДатыОтгрузкиПоУмолчаниюНаСервере();
	
	СекундСутки = 86400;
	
	Если СтруктураДефолтов.ПЭ_ДатОтгрСДнейПлюсОтТек >= 0 Тогда 
		Объект.ДатОтгрС = ТекущаяДата() + СтруктураДефолтов.ПЭ_ДатОтгрСДнейПлюсОтТек * СекундСутки; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатОтгрС) И СтруктураДефолтов.ПЭ_ДнейНаПогрузку >= 0 Тогда 
		Объект.ДатОтгрПо = Объект.ДатОтгрС + СтруктураДефолтов.ПЭ_ДнейНаПогрузку * СекундСутки; 
	КонецЕсли;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПоведениеКлючевыхЭлементовФормы()
	
	Если РазрешеноРедактироватьКлючевыеРеквизиты() Тогда
		Элементы.СвКлт.Вид = ВидПоляФормы.ПолеВвода;
		Элементы.СвЭксп.Вид = ВидПоляФормы.ПолеВвода;
		Элементы.ДогТрЭксп.Вид = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьДоступностьТЧКонтейнеры()
	Элементы.СведенияОКонтейнерах.Доступность = Не Объект.ПрзПрвз = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ВариантыПодачиКонтейнера.НетКонтейнера") 
КонецПроцедуры	

&НаСервере
Функция РазрешеноРедактироватьКлючевыеРеквизиты()
	
	Возврат Не(ОткрытоИзТитула Или ЗначениеЗаполнено(Объект.Титул1));
	
КонецФункции	

#КонецОбласти
