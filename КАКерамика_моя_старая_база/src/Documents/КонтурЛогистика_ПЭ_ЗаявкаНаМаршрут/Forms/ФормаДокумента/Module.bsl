Процедура СделатьНесопоставленныеНеУчитываемыми(Команда)
	
	Отбор = Новый Структура("КоличествоМест,МассаБруттоКг,ОтгрузочноеНаименование,Учитывать", 0, 0, "", Истина);
	НесопоставленныеСтроки = Объект.Товары.НайтиСтроки(Отбор);
	
	Если НесопоставленныеСтроки.Количество() > 0 Тогда

		Для Каждого текСтр Из НесопоставленныеСтроки Цикл
			СделатьСтрокуТовараНеучитываемой(текСтр);
		КонецЦикла;

		ПроверитьДокумент();

	КонецЕсли;

КонецПроцедуры

