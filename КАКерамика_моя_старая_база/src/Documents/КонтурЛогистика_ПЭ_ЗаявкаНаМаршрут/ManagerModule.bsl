#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Ищем заявку на маршрут по идентификатору
//
// Параметры:
//  Идентификатор	 - Строка	 - Идентификатор партии груза
// 
// Возвращаемое значение:
//  ДокументСсылка.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут - Найденная заявка
//
Функция НайтиЗаявкуНаМаршрут(Идентификатор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
	|ГДЕ
	|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ИдПарт = &Идентификатор
	|	И НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

// Перепроверяет и обновляет флаг Валидация у связанных заявок на маршрут.
//
// Параметры:
//  МассивМаршрутов - Массив из ДокументСсылка.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
//  ЗаполненностьКакПредупреждение - Булево - режим проверки заполненности
//
Процедура ОбновитьВалидациюДокументов(МассивМаршрутов, ЗаполненностьКакПредупреждение = Ложь) Экспорт
	
	Если МассивМаршрутов = Неопределено Или МассивМаршрутов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ЗаполненностьКакПредупреждение", ЗаполненностьКакПредупреждение);
	
	Для Каждого МаршрутСсылка Из МассивМаршрутов Цикл
		
		Если Не ЗначениеЗаполнено(МаршрутСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументМаршрут = МаршрутСсылка.ПолучитьОбъект();
		РезультатПроверки = ПроверитьДокумент(ДокументМаршрут, , ДополнительныеПараметры);
		НоваяВалидация = (РезультатПроверки.КоличествоОшибок = 0);
		
		Если ДокументМаршрут.Валидация <> НоваяВалидация Тогда
			ДокументМаршрут.Валидация = НоваяВалидация;
			ДокументМаршрут.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка.Титул1, Истина);

	ТаблицаОшибок.Очистить();

	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);

	ТаблицаОшибок.Очистить();

	Если Перечисления.КонтурЛогистика_СтатусыТитулов.СтатусДокументаТребуетПроверки(ТекСтатусТитула) Тогда
		
		ЗаполненностьКакПредупреждение = ЭтоВалидацияШаблонаДоступныВсеПоля(ДокументОбъектИлиСсылка, ДополнительныеПараметры);
		
		ПроверитьОбязательныеРеквизиты(ДокументОбъектИлиСсылка, ТаблицаОшибок, ДополнительныеПараметры,
			ЗаполненностьКакПредупреждение);
		ПроверитьОбязательностьЗаполенияТЧ(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЗаполненностьКакПредупреждение);
		ПроверитьСтраницуОсновные(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЗаполненностьКакПредупреждение);
		ПроверитьСтраницуКонтейнеры(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЗаполненностьКакПредупреждение);
		ПроверитьСтраницуДополнительные(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЗаполненностьКакПредупреждение);
		ПроверитьТабЧастьТовары(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЗаполненностьКакПредупреждение);
		ПроверитьТабЧастьИнфУпГруз(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЗаполненностьКакПредупреждение);
		
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ВыполнитьПроизвольнуюПроверку(ДокументОбъектИлиСсылка, ТаблицаОшибок);

	КонецЕсли;

	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);

	Возврат Результат;

КонецФункции

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("НомПарт");
	Поля.Добавить("Номер");
	Поля.Добавить("НомДок");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Данные.НомПарт) Тогда
		Представление = "Маршрут №" + Данные.НомПарт;
	Иначе
		Номер = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.УдалитьЛидирующиеНули(Данные.Номер);
		Представление = "Маршрут №" + Данные.НомДок + "-" + Номер;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДефолты(Объект) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.ИдПарт) Тогда
		Объект.ИдПарт = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаДок) Тогда
		Объект.ДатаДок = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПрзПрвз) Тогда
		Объект.ПрзПрвз = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.НетКонтейнера;
	КонецЕсли;	
	
	ЗаполнитьРеквизитДокументаДефолтнымЗначением(Объект, "СвЭксп", "ПЭ_ЭкспедиторПоУмолчанию");
	
	Если Не ЗначениеЗаполнено(Объект.СвЭксп) Тогда
		НастроенныеЭкспедиторы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.НастроенныеЭкспедиторы();
		Если НастроенныеЭкспедиторы.Количество() = 1 Тогда 
			Объект.СвЭксп = НастроенныеЭкспедиторы[0];
		КонецЕсли;
	КонецЕсли;	
	
	ЗаполнитьРеквизитДокументаДефолтнымЗначением(Объект, "ДогТрЭксп", "ПЭ_ДоговорЭкспедицииПоУмолчанию");
	ЗаполнитьРеквизитДокументаДефолтнымЗначением(Объект, "ВрОтгрС", "ПЭ_ВремяГотовностиС");
	ЗаполнитьРеквизитДокументаДефолтнымЗначением(Объект, "ВрОтгрПо", "ПЭ_ВремяГотовностиПо");
	
	Если Объект.ВидТС.Количество() = 0 Тогда
		
		СтрокаВидТС = Объект.ВидТС.Добавить();
		СтрокаВидТС.ВидТС = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ВидТСПоУмолчанию"); 
		СтрокаВидТС.ТипКузов = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ТипКузовПоУмолчанию"); 
		
	Иначе
		
		УмолчаниеВидТС = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ВидТСПоУмолчанию"); 
	
		Для Каждого СтрокаВидаТС Из Объект.ВидТС Цикл 
			Если Не ЗначениеЗаполнено(СтрокаВидаТС.ВидТС) Тогда 
				СтрокаВидаТС.ВидТС = УмолчаниеВидТС; 
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(Объект.ДатОтгрС)
		Или Не ЗначениеЗаполнено(Объект.ДатОтгрПо)) Тогда
		
		УстанавливатьДатуОтгрузки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_АвтоматическиДатОтгр");
		
		Если УстанавливатьДатуОтгрузки = Истина Тогда
			
			ПЭ_ДатОтгрСДнейПлюсОтТек = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ДатОтгрСДнейПлюсОтТек");
			ПЭ_ДнейНаПогрузку = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ПЭ_ДнейНаПогрузку");
			
			Если ПЭ_ДатОтгрСДнейПлюсОтТек >= 0 Тогда 
				Объект.ДатОтгрС = ТекущаяДатаСеанса() + ПЭ_ДатОтгрСДнейПлюсОтТек * 86400; 
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ДатОтгрС) И ПЭ_ДнейНаПогрузку >= 0 Тогда 
				Объект.ДатОтгрПо = Объект.ДатОтгрС + ПЭ_ДнейНаПогрузку * 86400; 
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СвГруз(ДокументСсылка) Экспорт
	
	ТипДокументооборота = "__PE";
	Формат = "5.01";
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_СвГруз = КС.XDTO_СвГруз(1, Формат, Неопределено, ТипДокументооборота);
	
	XDTO_СвГруз.ПрУведСторон = ?(ДокументСсылка.УведСторон.Количество() > 0, "1", "0");
	
	КС.XDTO_Установить(XDTO_СвГруз, "ДатОтгрС", КС.XDTO_ДатаТип(ДокументСсылка.ДатОтгрС));
	КС.XDTO_Установить(XDTO_СвГруз, "ДатОтгрПо", КС.XDTO_ДатаТип(ДокументСсылка.ДатОтгрПо));
	ВрОтгр = КС.РассчитатьВремяДпзТип(ДокументСсылка, "ВрОтгр");
	КС.XDTO_Установить(XDTO_СвГруз, "ВрОтгр", ВрОтгр);
	
	КС.XDTO_Установить(XDTO_СвГруз, "ДатДостГрС", КС.XDTO_ДатаТип(ДокументСсылка.ДатДостГрС));
	КС.XDTO_Установить(XDTO_СвГруз, "ДатДостГрПо", КС.XDTO_ДатаТип(ДокументСсылка.ДатДостГрПо));
	ВрДостГр = КС.РассчитатьВремяДпзТип(ДокументСсылка, "ВрДостГр");
	КС.XDTO_Установить(XDTO_СвГруз, "ВрДостГр", ВрДостГр);
	
	КС.XDTO_Установить(XDTO_СвГруз, "ОтмПрием", ?(ДокументСсылка.ОтмПрием, "1", "0"));
	
	КС.XDTO_Установить(XDTO_СвГруз, "ИдентПартГруз", ДокументСсылка.ИдПарт);
	КС.XDTO_Установить(XDTO_СвГруз, "НомПартГруз", ДокументСсылка.НомПарт);
	
	КС.XDTO_Установить(XDTO_СвГруз, "КолМестПарт", ДокументСсылка.КолМестПарт);
	КС.XDTO_Установить(XDTO_СвГруз, "МаршСлГруз", ДокументСсылка.МаршСлГруз);
	
	// УИГО
	// УИГП
	
	КС.XDTO_УстановитьУведомлениеСторон(XDTO_СвГруз, ДокументСсылка.УведСторон);

	// значение может быть не заполнено про отправке шаблона
	Если ЗначениеЗаполнено(ДокументСсылка.СвГП) Тогда
		КС.XDTO_Установить(XDTO_СвГруз, "СвГП", КС.XDTO_УчастникТрН(1, Формат, ДокументСсылка.СвГП, ТипДокументооборота));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументСсылка.СвГО) Тогда
		КС.XDTO_Установить(XDTO_СвГруз, "СвГО", КС.XDTO_УчастникТрН(1, Формат, ДокументСсылка.СвГО, ТипДокументооборота));
	КонецЕсли;
	
	КС.XDTO_УстановитьВидТранспортногоСредства(XDTO_СвГруз, ДокументСсылка.ВидТС);
	КС.XDTO_УстановитьУказанияКлиента(XDTO_СвГруз, ДокументСсылка.УказКлнт);
	
	ВесГрузПарт = КС.XDTO_ВесТип(1, ТипДокументооборота, ДокументСсылка.МассаБруттоКг, ДокументСсылка.МассаНеттоКг);
	КС.XDTO_Установить(XDTO_СвГруз, "ВесГрузПарт", ВесГрузПарт);
	
	КС.УстановитьЦенностьГруза(XDTO_СвГруз, ДокументСсылка.СтоимостьГруза, ДокументСсылка.ТипСтоимости, "СвГруз", 
					ДокументСсылка.ВалютаУчетаГруза);
					
	КС.XDTO_Установить(XDTO_СвГруз, "ПрзПрвз", Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.Сериализовать(ДокументСсылка.ПрзПрвз));
	
	ЗаполнитьОпГруз(XDTO_СвГруз, ДокументСсылка, Формат, ТипДокументооборота);
	
	Для Каждого ОписаниеКонтейнера Из ДокументСсылка.СведенияОКонтейнерах Цикл
		XDTO_СвКонтейн = КС.XDTO_СвКонтейн(1, Формат, ТипДокументооборота, ОписаниеКонтейнера);
		XDTO_СвГруз.СвКонтейн.Добавить(XDTO_СвКонтейн);
	КонецЦикла;
	
	XDTO_СвГруз.АдрГруз = КС.XDTO_АдресГруза(ДокументСсылка, "АдрГруз", 1, ТипДокументооборота, Формат);
	КС.XDTO_УстановитьСвСтрах(XDTO_СвГруз, ДокументСсылка.СвСтрах, 1, ТипДокументооборота, Формат);
	
	УстановитьУсловияПеревозки(XDTO_СвГруз, ДокументСсылка.СвУсл, Формат, ТипДокументооборота);
	
	Для Каждого Документ Из ДокументСсылка.СопрДокПарт Цикл 
	 	XDTO_Док = КС.XDTO_РеквДокТип_Экспедитор(Документ, 1, ТипДокументооборота);
	 	XDTO_СвГруз.СопрДокПарт.Добавить(XDTO_Док); 
	КонецЦикла; 
	
	Для Каждого Документ Из ДокументСсылка.РеквЗакПост Цикл 
	 	XDTO_Док = КС.XDTO_РеквДокТип_Экспедитор(Документ, 1, ТипДокументооборота);
	 	XDTO_СвГруз.РеквЗакПост.Добавить(XDTO_Док); 
	КонецЦикла;
		
	XDTO_АдрПунктНазн = КС.XDTO_АдресГруза(ДокументСсылка, "АдрПунктНазн", 1, ТипДокументооборота, Формат);
	КС.XDTO_Установить(XDTO_СвГруз, "АдрПунктНазн", XDTO_АдрПунктНазн);
	
	СтрокиИнфПолСвГруз = ДокументСсылка.ИнфПол.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", ""));
	КС.УстановитьИнфПол(XDTO_СвГруз, СтрокиИнфПолСвГруз, 1, "__PE", Формат);
	
	Возврат XDTO_СвГруз;
	
КонецФункции

Процедура УстановитьУсловияПеревозки(XDTO_СвГруз, СвУсл, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Для Каждого Услуга Из СвУсл Цикл 
	 	XDTO_Усл = КС.XDTO_СвУсл(Услуга.Услуга, 1, ТипДокументооборота);
	 	КС.XDTO_Установить(XDTO_Усл, "КолУсл", Услуга.Количество);
	 	XDTO_СвГруз.СвУсл.Добавить(XDTO_Усл); 
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьОпГруз(XDTO_СвГруз, Знач ДокументСсылка, Формат, ТипДокументооборота)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Для Каждого СтрокаДокумента Из ДокументСсылка.Товары Цикл
		
		Если СтрокаДокумента.Учитывать = Истина Тогда 
			
			XDTO_ОпГруз = КС.XDTO_ОпГруз_ПЭ(ДокументСсылка, СтрокаДокумента, 1);
			XDTO_СвГруз.ОпГруз.Добавить(XDTO_ОпГруз);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Функция МассивУсловноОбязательныхРеквизитов() Экспорт
	
	МассивОбязательных = Новый Массив();
	
	Возврат МассивОбязательных;
	
КонецФункции

Функция МассивУсловноОбязательныхРеквизитовТЧ() Экспорт
	
	МассивОбязательных = Новый Массив();
	МассивОбязательных.Добавить("СтраныПроисхожденияПродукцииМассивСтруктур");
	
