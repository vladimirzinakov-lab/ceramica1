Процедура ПроверитьСтраницуОсновные(Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)
	
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
		
	Если Объект.ДатОтгрС > Объект.ДатОтгрПо Тогда
		
		ТекстОшибки = "Дата отгрузки ""по"" меньше начальной даты отгрузки. ";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ДатОтгрПо", КатегорияПредупреждение, ТекстОшибки, "Проверить");
		
	КонецЕсли;
		 
	Если Объект.ДатОтгрПо < НачалоДня(ТекущаяДата()) Тогда
		
		ТекстОшибки = "Даты готовности груза для приемки экспедитором меньше текущей даты.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ДатОтгрС", КатегорияПредупреждение, ТекстОшибки, "Проверить");
		
	КонецЕсли;	
	 
	Если ЗначениеЗаполнено(Объект.СвГО) Тогда
		КатегорияОшибкиУчастника = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
		Справочники.КонтурЛогистика_ОрганизацииДиадок.ПроверитьРеквизитыУчастникаДляФайлаОбмена(
			Объект.СвГО, "СвГО", "грузоотправителя", ТаблицаОшибок, КатегорияОшибкиУчастника);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СвГП) Тогда
		КатегорияОшибкиУчастника = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
		Справочники.КонтурЛогистика_ОрганизацииДиадок.ПроверитьРеквизитыУчастникаДляФайлаОбмена(
			Объект.СвГП, "СвГП", "грузополучателя", ТаблицаОшибок, КатегорияОшибкиУчастника);
	КонецЕсли; 
	
КонецПроцедуры 

Процедура ПроверитьСтраницуКонтейнеры(Знач Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)

	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);	

		Если Объект.ПрзПрвз = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ПодачаПорожнегоКонтейнераГрузоотправителю
			 Или Объект.ПрзПрвз = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.ПриемКПеревозкеГруженогоКонтейнера Тогда

			ПроверитьКонтейнерыТовара(Объект, ТаблицаОшибок, КатегорияОшибка);

		КонецЕсли;

	КонецПроцедуры		

Процедура ПроверитьСтраницуДополнительные(Знач Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)
	
	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
	
	Если ЗначениеЗаполнено(Объект.СвСтрах)
		И Не (ЗначениеЗаполнено(Объект.СвСтрах.ДатаПолиса)
			  И ЗначениеЗаполнено(Объект.СвСтрах.АдрСтрахОрг)
			  И ЗначениеЗаполнено(Объект.СвСтрах.НаимСтрахОрг)
			  И ЗначениеЗаполнено(Объект.СвСтрах.НомерПолиса)
			  И ЗначениеЗаполнено(Объект.СвСтрах.НаименованиеПолиса)) Тогда
		
		ТекстОшибки = "Укажите обязательные реквизиты для страхового полиса.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"СвСтрах.НаимСтрахОрг", КатегорияОшибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	Для Каждого ТранспортнаяУслуга Из Объект.СвУсл Цикл
		Если ЗначениеЗаполнено(ТранспортнаяУслуга.Услуга)
			И Не ЗначениеЗаполнено(ТранспортнаяУслуга.Услуга.НаименованиеУслуги) Тогда
			
		ТекстОшибки = "Заполните обязательный реквизит ""Наименование услуги"" ";
		Индекс = ТранспортнаяУслуга.НомерСтроки - 1;
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"СвУсл[" + Индекс + "].Услуга.НаименованиеУслуги", КатегорияОшибка, ТекстОшибки, "Указать");
				 
		КонецЕсли;			
	КонецЦикла 	 
	
КонецПроцедуры 	

Процедура ПроверитьТабЧастьИнфУпГруз(Знач Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь) 
	
	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
	ИмяТЧ = "ИнфУпГруз";
	
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл 
			
		НайденныеСтроки = Объект[ИмяТЧ].НайтиСтроки(Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТоваров.ИдентификаторСтроки));
	
		ДопПараметры = Новый Массив;
		ДопПараметры.Добавить(СтрокаТоваров.НомерСтроки);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл	                                                                      
			
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ВидУпак) Тогда
				ТекстОшибки = "Не заполнен вид упаковки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НайденнаяСтрока.НомерСтроки, 
					"ВидУпак", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Заполнить вид упаковки");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ВесУпак) Тогда
				ТекстОшибки = "Не заполнен вес упаковки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НайденнаяСтрока.НомерСтроки, 
					"ВесУпак", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Заполнить вес упаковки");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ДлЗнач) Тогда
				ТекстОшибки = "Не заполнена длина упаковки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НайденнаяСтрока.НомерСтроки, 
					"ДлЗнач", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Заполнить длину упаковки");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ВысЗнач) Тогда
				ТекстОшибки = "Не заполнена высота упаковки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НайденнаяСтрока.НомерСтроки, 
					"ВысЗнач", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Заполнить высоту упаковки");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ШирЗнач) Тогда
				ТекстОшибки = "Не заполнена ширина упаковки";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, НайденнаяСтрока.НомерСтроки, 
					"ШирЗнач", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Заполнить ширину упаковки");
			КонецЕсли;
			
		КонецЦикла;

	КонецЦикла;	
	
КонецПроцедуры	

Процедура ПроверитьТабЧастьТовары(Знач Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)
	
	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ИмяТЧ = "Товары";
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаУчетаГруза) и ЗначениеЗаполнено(Объект.СтоимостьГруза) Тогда
		ТекстОшибки = "Укажите валюту стоимости груза";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"ВалютаУчетаГруза", КатегорияОшибка, ТекстОшибки, "Заполнить", , , "Указать валюту");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Товары) Тогда 
		
		ТекстОшибки = "Добавьте груз в табличную часть ""Грузы (Товары)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"", КатегорияОшибка, ТекстОшибки, "Добавить груз");
		
	ИначеЕсли Объект.Товары.НайтиСтроки(Новый Структура("Учитывать", Истина)).Количество() = 0 Тогда
		
		ТекстОшибки = "Нет ни одного учитываемого груза в табличной части ""Грузы (Товары)""";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"", КатегорияОшибка, ТекстОшибки, "Добавить груз");
		
	Иначе	
	
		Для Каждого СтрокаТовара Из Объект.Товары Цикл
			                                                                      
			Если Не СтрокаТовара.Учитывать Тогда 
				Продолжить;
			КонецЕсли;
			
			ТекущийНомерСтроки = СтрокаТовара.НомерСтроки;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.ОтгрузочноеНаименование) Тогда
				ТекстОшибки = "Укажите Отгрузочное наименование";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать отгрузочное наименование");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.КоличествоМест) Тогда
				ТекстОшибки = "Укажите количество мест по грузу";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"КоличествоМест", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать кол-во мест");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.МассаБруттоКг) Тогда
				ТекстОшибки = "Укажите Массу (брутто) груза";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"МассаБруттоКг", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать массу брутто");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.МассаНеттоКг) Тогда
				ТекстОшибки = "Укажите Массу (нетто) груза";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"МассаНеттоКг", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать массу брутто");
			КонецЕсли;
			
			ПроверитьСтрануПроисхождения(Объект, ТаблицаОшибок, КатегорияОшибка, СтрокаТовара);
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.КодТНВЭД) Тогда
				ТекстОшибки = "Укажите код товарной номенклатуры (ТНВЭД)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
				"КодТНВЭД", КатегорияПредупреждение, ТекстОшибки, "Заполнить");
			Иначе 
					
				Если СтрДлина(СтрокаТовара.КодТНВЭД) < 4 Или СтрДлина(СтрокаТовара.КодТНВЭД) > 10 Тогда
					
					ТекстОшибки = "Указанный код ТНВЭД не сответствует формату (допустимое кол-во символов 4-10)";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки, 
					"КодТНВЭД", КатегорияОшибка, ТекстОшибки, "Исправить");
					
				КонецЕсли;	 
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТовара.СтоимостьГруза) Тогда
	
				Если Не ЗначениеЗаполнено(СтрокаТовара.ТипСтоимости) Тогда
					ТекстОшибки = "Укажите тип стоимости груза (объявленная / действительная)";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
						"ТипСтоимости", КатегорияОшибка, ТекстОшибки, "Заполнить", , , "Указать тип стоимости");
				КонецЕсли;
	
				Если Не ЗначениеЗаполнено(СтрокаТовара.ВалютаУчетаГруза) Тогда
					ТекстОшибки = "Укажите валюту стоимости груза";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, ИмяТЧ, ТекущийНомерСтроки,
						"ВалютаУчетаГруза", КатегорияОшибка, ТекстОшибки, "Заполнить", , , "Указать валюту");
				КонецЕсли;
	
			КонецЕсли;
			
			Если СтрокаТовара.УчГосСист Тогда
				ПроверитьУчГосСист(Объект, ТаблицаОшибок, КатегорияОшибка, КатегорияПредупреждение, ИмяТЧ, СтрокаТовара); 
			КонецЕсли;	
					
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКонтейнерыТовара(Знач Объект, ТаблицаОшибок, КатегорияОшибка)
	
	ЕстьОшибки = Ложь;
	ТекстОшибки = "Укажите сведения о контейнерах";
	
	Если Объект.СведенияОКонтейнерах.Количество() = 0 Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.СведенияОКонтейнерах Цикл
		
		// Порядковый номер контейнера (НомКонтейн)
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номер) Тогда
			ЕстьОшибки = Истина;
			Прервать;
		КонецЕсли;
		
		// ISO контейнера
		Если ЗначениеЗаполнено(ТекущаяСтрока.ИСО)
			И СтрДлина(ТекущаяСтрока.ИСО) <> 4 Тогда
			
			ЕстьОшибки = Истина;
			ТекстОшибки = "ISO контейнера должен быть длиной 4";
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ПредоставленКлиентом)
			И ТекущаяСтрока.ПредоставленКлиентом = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ПредоставлениеКонтейнера.ПредоставленКлиентом")
			И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВесТары) Тогда
				
			ЕстьОшибки = Истина;
			ТекстОшибки = "Укажите вес тары контейнера";
				
		КонецЕсли;		
		
		В = ЗначениеЗаполнено(ТекущаяСтрока.Высота);
		Д = ЗначениеЗаполнено(ТекущаяСтрока.Длина);
		Ш = ЗначениеЗаполнено(ТекущаяСтрока.Ширина); 
		
		Если Не (В И Д И Ш) И (В Или Д Или Ш) Тогда
			ЕстьОшибки = Истина;
			ТекстОшибки = "Габаритные характеристики контейнера (высота, длина, ширина) должны быть заполнены все одновременно.";
			Прервать;
		КонецЕсли;	 
		 		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, "СведенияОКонтейнерах", ,	, КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтрануПроисхождения(Знач Объект, ТаблицаОшибок, КатегорияОшибка, СтрокаТовара)
	
	ОтборСтранСтроки = Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки);
	СтранаЗаполнена = Ложь;
	Для Каждого СтрокаСтраны Из Объект.СтраныПроисхожденияПродукции.НайтиСтроки(ОтборСтранСтроки) Цикл
		
		Если ЗначениеЗаполнено(СтрокаСтраны.Страна) Тогда
			СтранаЗаполнена = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не СтранаЗаполнена Тогда
		ТекстОшибки = "Укажите страну происхождения груза";
		ТекущийНомерСтроки = СтрокаТовара.НомерСтроки;
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "Товары", ТекущийНомерСтроки,
			"СтранаГруза", КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьУчГосСист(Знач Объект, ТаблицаОшибок, КатегорияОшибка, КатегорияПредупреждение, ИмяТЧ, СтрокаТовара)
	
	ИмяСвязаннойТЧ = "ПЭ_СвязаннаяТЧТовары_СведенияГосСистем";
	ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки);
	СведенияГосСистем = Объект.СведенияГосСистем.НайтиСтроки(ПараметрыОтбора);
	
	Если СведенияГосСистем.Количество() = 0 Тогда
		ТекстОшибки = "Укажите сведения о государственной системе";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, ИмяТЧ, СтрокаТовара.НомерСтроки,
			ИмяСвязаннойТЧ + "НаимГосСист", КатегорияПредупреждение, ТекстОшибки, "Заполнить",,, "Указать");
	Иначе
		Для Каждого Сведение Из СведенияГосСистем Цикл
			
			Если Не ЗначениеЗаполнено(Сведение.ИдНомУчетЕд) Тогда 
			ТекстОшибки = "Заполните идентификационный номер учетной единицы в ГИС";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, СтрокаТовара.НомерСтроки,
				ИмяСвязаннойТЧ + "ИдНомУчетЕд", КатегорияОшибка, ТекстОшибки, "Заполнить",,, "Указать");
			КонецЕсли;	
			
		КонецЦикла;	
	КонецЕсли;
	 
КонецПроцедуры

Функция ЭтоВалидацияШаблонаДоступныВсеПоля(ДокументОбъектИлиСсылка, ДополнительныеПараметры = Неопределено)
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ЗаполненностьКакПредупреждение") Тогда
		Возврат ДополнительныеПараметры.ЗаполненностьКакПредупреждение;
	КонецЕсли;
	
	Титул1 = ДокументОбъектИлиСсылка.Титул1;
	Если Не ЗначениеЗаполнено(Титул1) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Документы.КонтурЛогистика_ПЭ_Титул1.ЭтоОтправкаНезаблокированногоШаблона(Титул1);
	
КонецФункции

Функция КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение)
	
	Если ЗаполненностьКакПредупреждение Тогда
		Возврат Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	КонецЕсли;
	
	Возврат Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
КонецФункции

Функция ЗаполнитьРеквизитДокументаДефолтнымЗначением(Приемник, Реквизит, НазваниеНастройки) 	
	
	Если Не ЗначениеЗаполнено(Приемник[Реквизит]) Тогда 
		
		ДефолтноеЗначение = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(НазваниеНастройки); 
		Если ЗначениеЗаполнено(ДефолтноеЗначение) Тогда
			Приемник[Реквизит] = ДефолтноеЗначение;
		КонецЕсли;
		
	КонецЕсли;
КонецФункции	

#КонецЕсли
