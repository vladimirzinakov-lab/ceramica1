// Находит или создаёт ПЭ_ЗаявкаНаМаршрут по документу-основанию.
//
// Параметры:
//  ДокументОснование  - ОпределяемыйТип.КонтурЛогистика_ДокументыУчетнойСистемы - основание маршрута
//  Перезаполнить      - Булево - если Истина, найденный документ перезаполняется по основанию
//  КлючевыеРеквизиты  - Структура, Неопределено - ключевые реквизиты с ПЭ_Титул1 (только для нового документа)
//	ДокументПЭ - ДокументОбъект.КонтурЛогистика_ПЭ_Титул1
//	
// Возвращаемое значение:
//  Массив из ДокументСсылка.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут, Неопределено - при ошибке блокировки
//
Функция СформироватьДокументПоДокументуОснования(ДокументПЭ, ДокументОснование, Перезаполнить = Ложь,
	КлючевыеРеквизиты = Неопределено) Экспорт
	
	РазделителиМассив = Справочники.КонтурЛогистика_НастройкиКонвертацииДокументов.РассчитатьРазделительДокументаУчетнойСистемы(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_ЗаявкаНаМаршрут, ДокументОснование);
	
	Если РазделителиМассив = Неопределено Тогда
		РазделителиМассив = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Неопределено);
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для Каждого Разделитель Из РазделителиМассив Цикл  
	
		РезультатПоиска = НайтиДокументПоДокументуОснования(ДокументПЭ.Ссылка, ДокументОснование, Разделитель);
		ЭтоНовыйДокумент = Не ЗначениеЗаполнено(РезультатПоиска);

		Если ЭтоНовыйДокумент Или Перезаполнить Тогда
			
			ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель", ДокументОснование, Разделитель);
			
			Если ЭтоНовыйДокумент Тогда
				
				ДокументОбъект = ДокументОснование.ПолучитьОбъект();
				
				Попытка
					ДокументОбъект.Заблокировать();
				Исключение
					Возврат Неопределено;
				КонецПопытки;
				
				ПЭ_Груз = СоздатьДокумент();
				ПЭ_Груз.Дата = ТекущаяДатаСеанса();
				ПЭ_Груз.УстановитьНовыйНомер();
				
			Иначе
				ПЭ_Груз = РезультатПоиска.ПолучитьОбъект();
				ДанныеЗаполнения.Вставить("Перезаполнить", Истина);
			КонецЕсли;
			
			Если КлючевыеРеквизиты <> Неопределено Тогда
				ДанныеЗаполнения.Вставить("КлючевыеРеквизиты", КлючевыеРеквизиты);
			КонецЕсли;

			ПЭ_Груз.Заполнить(ДанныеЗаполнения);
			
			ЗаполнитьСуммыПоТабличнойЧасти(ПЭ_Груз);
			
			РезультатПроверки = ПроверитьДокумент(ПЭ_Груз);
			ПЭ_Груз.Валидация = (РезультатПроверки.КоличествоОшибок = 0);
			
			ПЭ_Груз.Записать();
			
			Результат.Добавить(ПЭ_Груз.Ссылка);
			
		Иначе
			
			Результат.Добавить(РезультатПоиска);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если Перезаполнить Тогда
		ПометитьНаУдалениеЗаявкиМаршрутаВнеАктуальныхРазделителей(ДокументПЭ.Ссылка, ДокументОснование, РазделителиМассив);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Процедура ПометитьНаУдалениеЗаявкиМаршрутаВнеАктуальныхРазделителей(ДокументПЭ, ДокументОснование, РазделителиМассив)
	
	Если РазделителиМассив.Количество() = 1 И РазделителиМассив[0] = Неопределено Тогда
		Возврат; 
	КонецЕсли;		 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ 
		|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
		|ГДЕ
		|	НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления
		|	И КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1 = &ДокументПЭ
		|	И КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ДокументОснование = &ДокументОснование
		|	И Не КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Разделитель В (&Разделитель)";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("Разделитель", РазделителиМассив);
	Запрос.УстановитьПараметр("ДокументПЭ", ДокументПЭ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокументМаршрут = Выборка.Ссылка.ПолучитьОбъект();
		ДокументМаршрут.УстановитьПометкуУдаления(Истина);
		
	КонецЦикла; 
	
КонецПроцедуры	

Функция НайтиДокументПоДокументуОснования(ДокументПЭ, ДокументОснование, Разделитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ 
		|	КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут КАК КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут
		|ГДЕ
		|	НЕ КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ПометкаУдаления
		|	И КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Титул1 = &ДокументПЭ
		|	И КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.ДокументОснование = &ДокументОснование
		|	И КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут.Разделитель = &Разделитель";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("Разделитель", Разделитель);
	Запрос.УстановитьПараметр("ДокументПЭ", ДокументПЭ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;	 
	
КонецФункции 	

Процедура ЗаполнитьСуммыПоТабличнойЧасти(ПЭ_Груз) Экспорт
	
	ПЭ_Груз.КолМестПарт = ПЭ_Груз.Товары.Итог("КоличествоМест");
	ПЭ_Груз.ОбъемГруза = ПЭ_Груз.Товары.Итог("ОбъемКубМ");
	ПЭ_Груз.МассаБруттоКг = ПЭ_Груз.Товары.Итог("МассаБруттоКг");
	ПЭ_Груз.МассаНеттоКг = ПЭ_Груз.Товары.Итог("МассаНеттоКг");
	
	Если Не ПЭ_Груз.УказыватьСтоимостьГрузаВручную Тогда
		ПЭ_Груз.СтоимостьГруза = Итог(ПЭ_Груз);
	КонецЕсли;	
	
КонецПроцедуры	

Функция Итог(ПЭ_Груз)

	Итого = 0;

	Для Каждого СтрокаТовары Из ПЭ_Груз.Товары Цикл
		Если СтрокаТовары.ТипСтоимости = ПЭ_Груз.ТипСтоимости Тогда
			Итого = Итого + СтрокаТовары.СтоимостьГруза;
		КонецЕсли;
	КонецЦикла;

	Возврат Итого;

КонецФункции

Процедура ПроверитьОбязательныеРеквизиты(Знач Объект, ТаблицаОшибок, ДополнительныеПараметры,
		ЗаполненностьКакПредупреждение = Ложь)
	
	РазрешеноРедактироватьКлючевыеРеквизиты = (ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		И ДополнительныеПараметры.Свойство("РазрешеноРедактироватьКлючевыеРеквизиты")
		И ДополнительныеПараметры.РазрешеноРедактироватьКлючевыеРеквизиты = Истина); 
	
	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);

	НеПроверять = Новый Массив;
	НеПроверять.Добавить("СвЭксп");
	НеПроверять.Добавить("СвКлт");
	НеПроверять.Добавить("ДогТрЭксп");
	НеПроверять.Добавить("НомДок");
	НеПроверять.Добавить("ДатаДок");
	
	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" ИЛИ Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не РазрешеноРедактироватьКлючевыеРеквизиты Тогда 
			Если НеПроверять.Найти(ОбязательныйРевизит) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			ОбязательныйРевизитСиноним = СинонимРеквизита(ОбязательныйРевизит);
			ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				ОбязательныйРевизит, КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЦикла;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьАдресПунктаМаршрута(
		Объект.АдрГруз,
		ТаблицаОшибок,
		"АдрГруз",
		"Укажите адрес пункта отгрузки в его карточке",
		КатегорияОшибка);
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьАдресПунктаМаршрута(
		Объект.АдрПунктНазн,
		ТаблицаОшибок,
		"АдрПунктНазн",
		"Укажите адрес пункта назначения в его карточке",
		КатегорияОшибка);
	
КонецПроцедуры	

Процедура ПроверитьОбязательностьЗаполенияТЧ(Знач Объект, ТаблицаОшибок, ЗаполненностьКакПредупреждение = Ложь)
	
	КатегорияОшибка = КатегорияПроверкиЗаполненности(ЗаполненностьКакПредупреждение);
	
