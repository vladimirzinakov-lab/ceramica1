КонецПроцедуры

&НаКлиенте
Процедура ДокументыОснованияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ИзменениеДокументовОснований();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОснованияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		ОбработатьВыборДокументовОснования(ВыбранноеЗначение);
		
	Иначе
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(ВыбранноеЗначение);
		
		ОбработатьВыборДокументовОснования(ДокументыОснования);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДокументовОснования(массДокументыОснования)
	
	Если массДокументыОснования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущееЗначение Из массДокументыОснования Цикл
		
		ЕстьДубли = ЕстьДублиДокументовОснования(ТекущееЗначение);
		
		Если ЕстьДубли Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ТекущееЗначение;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) И Объект.ДокументыОснования.Количество() <> 0 Тогда
		Объект.ДокументОснование = Объект.ДокументыОснования[0].ДокументОснование;
		ПоказатьПредупреждениеПерезаполнения();
	КонецЕсли;
	
	ИзменениеДокументовОснований();
			
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОснованияДокументОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Тип") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДокументыОснования.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
	
	ДокументыОснования = Новый Массив;
	ДокументыОснования.Добавить(ВыбранноеЗначение);
		
	ЕстьДубли = ЕстьДублиДокументовОснования(ВыбранноеЗначение);
	Если ЕстьДубли Тогда
		Сообщить("В таблице уже есть выбранный документ");
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ДокументОснование = ВыбранноеЗначение;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДублиДокументовОснования(ВыбранноеЗначение)

	ЕстьДубли = Ложь;
		
	Для Каждого ТекущийДокументОснования Из Объект.ДокументыОснования Цикл
		Если ТекущийДокументОснования.ДокументОснование = ВыбранноеЗначение Тогда
			ЕстьДубли = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьДубли;
	
КонецФункции	

&НаКлиенте
Процедура ДокументыОснованияПослеУдаления(Элемент)
	
	ИзменениеДокументовОснований();
	УстановитьЗаголовкиГруппамДопПолей();
	
	// Проверим, что удаленный документ основания не используется для заполнения
	ЕстьДокументЗаполнения = Ложь;
	Для Каждого ТекущаяСтрока Из Объект.ДокументыОснования Цикл
		Если ТекущаяСтрока.ДокументОснование = Объект.ДокументОснование Тогда
			ЕстьДокументЗаполнения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьДокументЗаполнения Тогда
		Если Объект.ДокументыОснования.Количество() > 0 Тогда
			// Возьмем первый из списка
			Объект.ДокументОснование = Объект.ДокументыОснования[0].ДокументОснование;
			ПоказатьПредупреждениеПерезаполнения();
		Иначе
			Объект.ДокументОснование = Неопределено;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ДатаВремяПогрузки

&НаКлиенте
Процедура ОбновитьЧасовыеПоясаМестаПогрузки()
	
	Перем НовыйЧасовойПояс;
	
	НовыйЧасовойПояс = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		Объект.ПунктПод, "ЧасовойПояс");

		Если ЧасовойПоясПогрузки <> НовыйЧасовойПояс Тогда
			
		// Пересчитаем время
		ДатВрПод = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			ДатВрПод, ЧасовойПоясПогрузки, НовыйЧасовойПояс);
			
		ПредВрПод = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			ПредВрПод, ЧасовойПоясПогрузки, НовыйЧасовойПояс);
		
		ЧасовойПоясПогрузки = НовыйЧасовойПояс;
		Элементы.ГруппаДатаИВремя.Заголовок = ЗаголовокДатИВременПогрузки(ЧасовойПоясПогрузки);
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущаяДатаВЧасовомПоясе(ЧасовойПояс)
	
	Если ЗначениеЗаполнено(ЧасовойПояс) Тогда
		Возврат КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(ТекущаяДата(), Неопределено, ЧасовойПояс);
	Иначе
		Возврат ТекущаяДата();
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокДатИВременПогрузки(ЧасовойПояс)
	
	Заголовок = "Даты и время";
	
	Если ЗначениеЗаполнено(ЧасовойПояс) Тогда
		Заголовок = Заголовок + " " + КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(ЧасовойПояс);
	КонецЕсли;
	
	Возврат Заголовок;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДатыПогрузкиЛокальные()
	
	ЧасовойПоясПогрузки = Объект.ПунктПод.ЧасовойПояс;
	
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		ДатВрПод = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ДатВрПод, Неопределено, ЧасовойПоясПогрузки);
		ПредВрПод = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			Объект.ПредВрПод, Неопределено, ЧасовойПоясПогрузки);
	Иначе
		ДатВрПод = Объект.ДатВрПод;
		ПредВрПод = Объект.ПредВрПод;
	КонецЕсли;
	
	Элементы.ГруппаДатаИВремя.Заголовок = ЗаголовокДатИВременПогрузки(ЧасовойПоясПогрузки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатыПогрузкиОбъекта()
	
	ТекущийОбъект = Объект;
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		ТекущийОбъект.ДатВрПод = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			ДатВрПод, ЧасовойПоясПогрузки);
		ТекущийОбъект.ПредВрПод = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(
			ПредВрПод, ЧасовойПоясПогрузки);
	Иначе
		ТекущийОбъект.ДатВрПод = ДатВрПод;
		ТекущийОбъект.ПредВрПод = ПредВрПод;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДатуПогрузкиОбъекта(Форма, ЧасовойПоясПогрузки, ИмяРеквизита)
	
	РеквизитФормы = Форма[ИмяРеквизита];
	
	Если ЗначениеЗаполнено(ЧасовойПоясПогрузки) Тогда
		Форма.Объект[ИмяРеквизита] = КонтурЛогистика_ОбщегоНазначенияСервер.ПривестиКЧасовомуПоясу(РеквизитФормы, ЧасовойПоясПогрузки);
	Иначе
		Форма.Объект[ИмяРеквизита] = РеквизитФормы;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура КонтурЛогистикаПодключаемый_ВыполнитьКоманду(Команда)
	
    КонтурЛогистика_ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтаФорма, Команда, РеквизитыФормы());
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция РеквизитыФормы()
	
	Возврат КонтурЛогистика_ОбщегоНазначенияСервер.РеквизитыФормы(ЭтаФорма);
	
КонецФункции