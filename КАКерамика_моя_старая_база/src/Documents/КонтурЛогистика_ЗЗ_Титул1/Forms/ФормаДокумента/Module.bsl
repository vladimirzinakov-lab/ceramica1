&НаКлиенте
Процедура ПеревозчикПриИзменении(Элемент)
	
	ПеревозчикПриИзмененииСервер();
	ПроверитьДокумент();
	
	Если Объект.ЭтоШаблон И Не СоставительИноеЛицоПеревозчик 
	   Или Не ЗначениеЗаполнено(Объект.ОтправительШаблона) Тогда
	 	Объект.ОтправительШаблона = Объект.Перевозчик;
	 	Модифицированность = Истина; 
	КонецЕсли;
	
	СоставительИноеЛицоПеревозчик = Объект.ЭтоШаблон 
			И (Не Объект.ОтправительШаблона = Объект.Перевозчик) Или СоставительИноеЛицоПеревозчик;
	
	Элементы.ГруппаОтправительШаблона.Видимость = СоставительИноеЛицоПеревозчик;
	
	ПроверитьДокумент();
	
КонецПроцедуры

