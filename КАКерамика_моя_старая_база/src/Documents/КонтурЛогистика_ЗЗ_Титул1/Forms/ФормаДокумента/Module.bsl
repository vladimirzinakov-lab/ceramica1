&НаКлиенте
Процедура УстановитьЗаголовкиГруппамДопПолей()
	
	// Ограничения
	УстановитьЗаголовокОграничений();
	
	// ГруппаПолномочия
	Элементы.ГруппаПолномочияЛиц.Заголовок = "Полномочия лиц грузоотправителя (" + Объект.СвЛицГО.Количество() + ")";
	
	// ДополнительныеПолучателиФайла
	Элементы.ГруппаДополнительныеПолучатели.Заголовок = "Дополнительные получатели (" + Объект.ДополнительныеПолучателиФайла.Количество() + ")";
	
	// ГруппаИнфПоля
	Элементы.ГруппаИнфПоля.Заголовок = "Информационные поля (" + Объект.ИнфПол.Количество() + ")";
	
	// ГруппаДокументыОснования
	Элементы.ГруппаДокументыОснования.Заголовок = "Документы основания (" + Объект.ДокументыОснования.Количество() + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокОграничений()
	
	Счетчик = 0;
	Если ЗначениеЗаполнено(Объект.УказанияВОтношенииНормПеревозки) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ПрвзПищПрод) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ИныеУслв) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ТемператураНеНиже) Или ЗначениеЗаполнено(Объект.ТемператураНеВыше) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВлажностьНеНиже) Или ЗначениеЗаполнено(Объект.ВлажностьНеВыше) Тогда 
		Счетчик = Счетчик + 1;
	КонецЕсли;
	Элементы.ГруппаОграничения.Заголовок = "Ограничения и указания (" + Счетчик + ")";

КонецПроцедуры

