&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТоварыТребуемоеДействие" Тогда

		СтандартнаяОбработка = Ложь;

		ТекДанные = Элемент.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда

			ТекСтрТребуемоеДействие = ТекДанные.ТребуемоеДействие;
			ПараметрыТекСтрока = ВыбраннаяСтрока;
			Если ТекСтрТребуемоеДействие = "Указать Номенклатуру" Тогда

				ТипСправочникаНоменклатура = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяСправочникаНоменклатура");

				КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы("Справочник."
																				   + ТипСправочникаНоменклатура
																				   + ".ФормаВыбора",
																				   ,
																				   ЭтаФорма,
																				   ЭтаФорма,
																				   "ОбработчикВыбораНоменклатуры",
																				   ПараметрыТекСтрока);

			ИначеЕсли ТекСтрТребуемоеДействие = "Указать Единицу измерения" Тогда

				Элементы.Товары.ТекущийЭлемент = Элементы.ТоварыУпаковкаЕдиницаИзмерения;
				Элементы.Товары.ИзменитьСтроку();

			ИначеЕсли ТекСтрТребуемоеДействие = "Указать Количество" Тогда

				Элементы.Товары.ТекущийЭлемент = Элементы.ТоварыКоличество;
				Элементы.Товары.ИзменитьСтроку();

			ИначеЕсли ТекСтрТребуемоеДействие = "Установить соответствие" Или ТекСтрТребуемоеДействие = "Не учитывается" Тогда

				ОткрытьСоответствияТекущейСтроки();

			Иначе // требуемое действие от таблицы ошибок

				ОбработатьТребуемоеДействие(ТекСтрТребуемоеДействие, Неопределено);

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьТребуемоеДействие(ТребуемоеДействие, ПолеТаблицыОшибок = Неопределено)
	
	// реализуем отдельную обработку некоторых требуемых действий
	Если Ложь Тогда // Какие-то особенные UI для требуемых действий, например: ТребуемоеДействие = "Исправить GTIN" Тогда

	Иначе // типовая обработка таблицы ошибок

		Если ПолеТаблицыОшибок <> Неопределено Тогда
			КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, ПолеТаблицыОшибок.Имя);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// УПРАВЛЕНИЕ ВИДИМОСТЬЮ И ДОСТУПНОСТЬЮ
&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()

	УстановитьПоложениеСохраняемыхЭлементов();
	УстановитьФорматыКолонокСКоличеством();

	УстановитьВидимостьЭлементов();
	УстановитьЗаголовкиГруппамДопПолей();
	УстановитьЗаголовки();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовки()
	
	Если Объект.ЭтоШаблон Тогда
		Заголовок = "Шаблон документа";
	ИначеЕсли Объект.ЭтоВходящийШаблон Тогда
		Заголовок = "Из шаблона";
	Иначе
		Заголовок = "";		
	КонецЕсли;
	
	Элементы.Грузоотправитель.Заголовок = ?(Объект.ЭтоШаблон, "Грузоотправитель (получатель шаблона)", "Грузоотправитель");
	Элементы.Перевозчик.Заголовок = ?(Объект.ЭтоШаблон И Не СоставительИноеЛицоПеревозчик, "Перевозчик (отправитель шаблона)", "Перевозчик");
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтоШаблонПриИзменении(Элемент)
	
	Если Объект.ЭтоШаблон Тогда
		Объект.ОтправительШаблона = Объект.Перевозчик;
		Если Не ЗначениеЗаполнено(Объект.СценарийРедактированияШаблона) Тогда
			Объект.СценарийРедактированияШаблона = ПолучитьСценарийРедактированияШаблонаНаСервере(); 
		КонецЕсли;	
	Иначе
		Объект.ОтправительШаблона = ПредопределенноеЗначение("Справочник.КонтурЛогистика_ОрганизацииДиадок.ПустаяСсылка");
		Объект.СценарийРедактированияШаблона = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииРедактированияШаблона.ПустаяСсылка");
	КонецЕсли;
	
	Элементы.СоставительИноеЛицоПеревозчик.Видимость = Объект.ЭтоШаблон;
	Элементы.СоставляетИноеЛицоГО.Видимость = Не Объект.ЭтоШаблон;
	
	ПроверитьДокумент();
	УстановитьЗаголовки();
	ОбновитьДанныеФормы();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСценарийРедактированияШаблонаНаСервере()
	Возврат КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ЗЗ_ТипШаблонаДляОтправкиКонтрагенту");
КонецФункции	

&НаКлиенте
Процедура УстановитьДоступностьРедактированияДляСценария()
	
	Если Объект.СценарийРедактированияШаблона 
			= ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СценарииРедактированияШаблона.НеРедактируется") Тогда
	
		Элементы.ГруппаСоздатьНовый.ТолькоПросмотр = Истина;
		Элементы.ГруппаШаблон.ТолькоПросмотр = Истина;
		Элементы.ГруппаДокументЛогистики.ТолькоПросмотр = Истина;
		Элементы.ГруппаДокументОснование.ТолькоПросмотр = Истина;
		Элементы.ГруппаШапкаМестоположениеВерх.ТолькоПросмотр = Истина;
	
		Элементы.СтраницаШапка.ТолькоПросмотр = Истина;
		Элементы.ГруппаТовары.ТолькоПросмотр = Истина;
		Элементы.ГруппаПунктыМаршрута.ТолькоПросмотр = Истина;
	
		Элементы.ГруппаДопТексты.ТолькоПросмотр = Истина;
		Элементы.ГруппаОграничения.ТолькоПросмотр = Истина;
		Элементы.ГруппаПолномочияЛиц.ТолькоПросмотр = Истина;
		Элементы.ГруппаДополнительныеПолучатели.ТолькоПросмотр = Истина;
		Элементы.ГруппаИнфПоля.ТолькоПросмотр = Истина;
		Элементы.ГруппаДокументыОснования.ТолькоПросмотр = Истина;
		Элементы.ГруппаТехнические.ТолькоПросмотр = Ложь;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеСохраняемыхЭлементов()

	УстановитьВидимостьНеучитываемыхИФильтраОшибок();
	УстановитьСвернутостьПодробностейОТоварах();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНеучитываемыхИФильтраОшибок()

	КонтурЛогистика_ОбработкаДокументовКлиент.УстановитьВидимостьНеучитываемыхИФильтраОшибок(Объект.Товары,
																							 СкрытьНеучитываемые,
																							 Элементы.Товары,
																							 Элементы.ТоварыИтоги);
	
	// лишним не будет
	Элементы.ОтключитьФильтрТаблицыОшибокТовары.Видимость = ЗначениеЗаполнено(ОтборТаблицыОшибокЗначениеТовары);

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьФильтрТаблицыОшибокТовары(Команда)

	ОтборТаблицыОшибокЗначениеТовары = "";

	Если Элементы.Товары.ОтборСтрок <> Неопределено Тогда

		ВременнаяСтруктура = Новый Структура(Элементы.Товары.ОтборСтрок);

		Если ВременнаяСтруктура.Свойство("ПризнакОтбораТаблицыОшибок") Тогда
			ВременнаяСтруктура.Удалить("ПризнакОтбораТаблицыОшибок");
			Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура(ВременнаяСтруктура);
		КонецЕсли;

	КонецЕсли;

	Элементы.ОтключитьФильтрТаблицыОшибокТовары.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ДатаЗакПриИзменении(Элемент)
	ПроверитьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьНеучитываемые(Команда)

	СкрытьНеучитываемые = Не СкрытьНеучитываемые;
	УстановитьВидимостьНеучитываемыхИФильтраОшибок();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьФорматыКолонокСКоличеством()

	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "МассаПлановаяНеттоКг",
																			 Элементы.ТоварыМассаПлановаяНеттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "МассаПлановаяБруттоКг",
																			 Элементы.ТоварыМассаПлановаяБруттоКг);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "Количество",
																			 Элементы.ТоварыКоличество);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "ОбъемКубМ",
																			 Элементы.ТоварыОбъемКубМ);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(Объект.Товары,
																			 "МасТар",
																			 Элементы.ТоварыМасТар);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	УстановитьВидимостьНоменклатуры();
			
	Элементы.ОткрытьНастройкуКонвертации.Видимость = ЗначениеЗаполнено(Объект.ДокументОснование);
	
	Элементы.ГруппаСоставитель.Видимость = СоставляетИноеЛицоГО;
	
	ФлажокЕстьДоговор = Объект.Функция = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ФункцииЗаказаЗаявки.Заявка");
	Элементы.ДогОргПрвз.Видимость = ФлажокЕстьДоговор;
	
	Элементы.РазделительИндикатор.Видимость = ЗначениеЗаполнено(Объект.Разделитель);
	
	СкрытьПоказатьЗначенияДокУчСист();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНоменклатуры()
	
	// видимость номенклатуры в зависимости от того есть ли там номенклатура (она есть если отправляли Т1 из этой базы) 
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаНоменклатура);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыХарактеристика);
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьВидимостьКолонкиПоЗаполненностиЗначения(Объект.Товары, "Номенклатура", Элементы.ТоварыГруппаЕдиницы);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	СформироватьТребуемоеДействиеСтрокиТовара(Элемент.ТекущиеДанные);
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);
	
	// Автоитоги массы и объема
	РассчитатьАвтоитогиМассыИОбъема();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда

		Элемент.ТекущиеДанные.Учитывать = Истина;
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	// Автоитоги массы и объема
	РассчитатьАвтоитогиМассыИОбъема();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьАвтоитогиМассыИОбъема()
	
	// увеличиваем требования к ТС только если они стали недостаточными, в случае уменьшения требований не меняем
	
	Если Объект.ТСГрузопод < Объект.Товары.Итог("МассаПлановаяБруттоКг")/1000 
		И КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеНастройки("ЗЗ_АвтоитогМасса") Тогда
		
		Объект.ТСГрузопод = Окр(Объект.Товары.Итог("МассаПлановаяБруттоКг")/1000 + 0.004999999, 2);
		
	КонецЕсли;
	
	Если Объект.ТСВместим < Объект.Товары.Итог("ОбъемКубМ") 
		И КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ЗначениеНастройки("ЗЗ_АвтоитогОбъем") Тогда
		
		Объект.ТСВместим = Окр(Объект.Товары.Итог("ОбъемКубМ") + 0.004999999, 2);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	ПроверитьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПунктыПогрузкиВыгрузкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	УстановитьТекИдентификаторСтрокиТовара(НоваяСтрока, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОпасныеГрузыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	УстановитьТекИдентификаторСтрокиТовара(НоваяСтрока, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекИдентификаторСтрокиТовара(Знач НоваяСтрока, Знач Элемент)

	Перем ТекТовар;

	Если НоваяСтрока Тогда

		ТекТовар = Элементы.Товары.ТекущиеДанные;

		Элемент.ТекущиеДанные.ИдентификаторСтрокиТоваров = ТекТовар.ИдентификаторСтроки;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОпасныеГрузыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ПроверитьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ОпасныеГрузыПослеУдаления(Элемент)
	ПроверитьДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ОпасныеГрузыОписаниеОпасногоГрузаПриИзменении(Элемент)
	
	КонтурЛогистика_ОбработкаДокументовКлиент.ЗаполнитьСтрокуОпасногоГрузаПоШаблону(Элементы.ОпасныеГрузы.ТекущиеДанные);
	
