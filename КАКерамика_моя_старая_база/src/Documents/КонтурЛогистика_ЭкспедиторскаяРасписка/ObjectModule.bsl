#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоЗаявкеНаМршрут(ДокументЗаявкаНаМаршрут) Экспорт
	
	// Строка маршрута
	НоваяСтрокаЗаявки = ЗаявкиНаМаршрут.Добавить();
	НоваяСтрокаЗаявки.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	НоваяСтрокаЗаявки.ЗаявкаНаМаршрут = ДокументЗаявкаНаМаршрут;
	НоваяСтрокаЗаявки.Номер = ДокументЗаявкаНаМаршрут.НомПарт;
	НоваяСтрокаЗаявки.Идентификатор = ДокументЗаявкаНаМаршрут.ИдПарт;
	НоваяСтрокаЗаявки.КоличествоМест = ДокументЗаявкаНаМаршрут.КолМестПарт;
	
	НоваяСтрокаЗаявки.МассаБруттоКг = ДокументЗаявкаНаМаршрут.МассаБруттоКг;
	НоваяСтрокаЗаявки.МассаНеттоКг = ДокументЗаявкаНаМаршрут.МассаНеттоКг;
	
	НоваяСтрокаЗаявки.ТипСтоимости = ДокументЗаявкаНаМаршрут.ТипСтоимости;
	НоваяСтрокаЗаявки.Стоимость = ДокументЗаявкаНаМаршрут.СтоимостьГруза;
	НоваяСтрокаЗаявки.Валюта = ДокументЗаявкаНаМаршрут.ВалютаУчетаГруза;
	
	НоваяСтрокаЗаявки.СостояниеГруза = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.СостояниеГруза();
	
	НоваяСтрокаЗаявки.ПризнакПеревозки = ДокументЗаявкаНаМаршрут.ПрзПрвз;
	Если Не ЗначениеЗаполнено(НоваяСтрокаЗаявки.ПризнакПеревозки) Тогда
		НоваяСтрокаЗаявки.ПризнакПеревозки = Перечисления.КонтурЛогистика_ВариантыПодачиКонтейнера.НетКонтейнера;
	КонецЕсли;
	
	// Сведения о контейнерах
	Для Каждого ТекущаяСтрока Из ДокументЗаявкаНаМаршрут.СведенияОКонтейнерах Цикл
		НоваяСтрокаКонтейнера = СведенияОКонтейнерах.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаКонтейнера, ТекущаяСтрока);
		НоваяСтрокаКонтейнера.ИдентификаторСтрокиЗаявкиНаМаршрут = НоваяСтрокаЗаявки.ИдентификаторСтроки;
	КонецЦикла;
	
	// Товары
	ЗаполнитьТабличнуюЧастьЭРПоСвГруз(ДокументЗаявкаНаМаршрут, НоваяСтрокаЗаявки);
	
	// Итоги
	МассаБруттоКг = Товары.Итог("МассаБруттоКг");
	МассаНеттоКг = Товары.Итог("МассаНеттоКг");
	КоличествоМест = Товары.Итог("КоличествоМест");
	ТипСтоимости = НоваяСтрокаЗаявки.ТипСтоимости;
	Стоимость = Товары.Итог("Стоимость");
	Валюта = НоваяСтрокаЗаявки.Валюта;
	
	// Обязательства экспедитора
	НовоеОбязательство = ОбязательстваЭкспедитора.Добавить();
	НовоеОбязательство.ИдентификаторСтрокиЗаявкиНаМаршрут = НоваяСтрокаЗаявки.ИдентификаторСтроки;
	НовоеОбязательство.ОбязЭксп = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.ОбязЭксп();
	
	// Реквизиты заказа на поставку
	Для Каждого ТекущаяСтрока Из ДокументЗаявкаНаМаршрут.РеквЗакПост Цикл
		НоваяСтрокаРеквизитов = РеквЗакПост.Добавить();
		НоваяСтрокаРеквизитов.ИдентификаторСтрокиЗаявкиНаМаршрут = НоваяСтрокаЗаявки.ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРеквизитов, ТекущаяСтрока);
	КонецЦикла;
	
	// Сопр док парт
	Для Каждого ТекущаяСтрока Из ДокументЗаявкаНаМаршрут.РеквЗакПост Цикл
		НоваяСтрокаСопрДок = СопрДокПарт.Добавить();
		НоваяСтрокаСопрДок.ИдентификаторСтрокиЗаявкиНаМаршрут = НоваяСтрокаЗаявки.ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСопрДок, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет табличную часть Товары данными из документа КонтурЛогистика_ПЭ_ЗаявкаНаМаршрут, 
// включая табличные части упаковки, контейнеров и государственных систем
//
Процедура ЗаполнитьТабличнуюЧастьЭРПоСвГруз(ДокументСсылка, СтрокаЗаявки) Экспорт
	
	КопируемыеРеквизитыСтрокиТовара = "Номенклатура, Характеристика, Количество, УпаковкаЕдиницаИзмерения, Учитывать,
		|ОтгрузочноеНаименование, КоличествоМест, ОбъемКубМ, ПрзИзъятВещ, ТипСтоимости, КодТНВЭД, МассаБруттоКг, МассаНеттоКг";
	
	Для Каждого ТекущийТовар Из ДокументСсылка.Товары Цикл
		
		НоваяСтрокаТовара = Товары.Добавить();
		НоваяСтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		НоваяСтрокаТовара.ИдентификаторСтрокиЗаявкиНаМаршрут = СтрокаЗаявки.ИдентификаторСтроки;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТовара, ТекущийТовар, КопируемыеРеквизитыСтрокиТовара);
		
		НоваяСтрокаТовара.ОписаниеОпасногоГруза = ТекущийТовар.СвОпаснГруз;
		НоваяСтрокаТовара.ПодлежитУчетуВГосСист = ТекущийТовар.УчГосСист;
		
		НоваяСтрокаТовара.Стоимость = ТекущийТовар.СтоимостьГруза;
		НоваяСтрокаТовара.Валюта = ТекущийТовар.ВалютаУчетаГруза;
		
		НоваяСтрокаТовара.ОсобыеОтметки = "Отсутствует";
		
		// Сведения гос систем
		СкопироватьТаблицу("СведенияГосСистем", НоваяСтрокаТовара.ИдентификаторСтроки,
			ТекущийТовар.ИдентификаторСтроки, ДокументСсылка);
		
		// Маркировка
		СкопироватьТаблицу("Марк", НоваяСтрокаТовара.ИдентификаторСтроки,
			ТекущийТовар.ИдентификаторСтроки, ДокументСсылка);
		
		// Информация об упаковке груза
		СкопироватьТаблицу("ИнфУпГруз", НоваяСтрокаТовара.ИдентификаторСтроки,
			ТекущийТовар.ИдентификаторСтроки, ДокументСсылка);
		
		// Страны происхождения продукции
		СкопироватьТаблицу("СтраныПроисхожденияПродукции", НоваяСтрокаТовара.ИдентификаторСтроки,
			ТекущийТовар.ИдентификаторСтроки, ДокументСсылка);
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокаЗаявки.ТипСтоимости) Тогда
		
		// Установим тип стоимости и валюту для маршрута, если одно значение в ТЧ
		ТипыСтоимости = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(Товары.Выгрузить().ВыгрузитьКолонку("ТипСтоимости"));
		Если ТипыСтоимости.Количество() = 1 Тогда
			СтрокаЗаявки.ТипСтоимости = ТипыСтоимости[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаЗаявки.Валюта) Тогда
		
		// Установим тип стоимости и валюту для маршрута, если одно значение в ТЧ
		Валюты = КонтурЛогистика_СтдОбщегоНазначенияКлиентСервер.СвернутьМассивЛок(Товары.Выгрузить().ВыгрузитьКолонку("Валюта"));
		Если Валюты.Количество() = 1 Тогда
			СтрокаЗаявки.Валюта = Валюты[0];
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// Из документа учетной системы
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		
	// Загружен из сервиса, создаем из файла обмена
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);
		
	// Из документа ЭТрН Т1
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЛогистика_ТрН_Титул1") Тогда
		
		ЗаполнитьПоДокументуТрНТитул1(ДанныеЗаполнения);
		
	// Из поручения экспедитору
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1")
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул2") Тогда
		
		ЗаполнитьПоДокументуПоручениеЭкспедитору(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ПредыдущийТитул")
		И (ТипЗнч(ДанныеЗаполнения.ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1")
			Или ТипЗнч(ДанныеЗаполнения.ПредыдущийТитул) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул2")) Тогда
		
		ЗаполнитьПоДокументуПоручениеЭкспедитору(ДанныеЗаполнения.ПредыдущийТитул);
		
	// Из мастера по массиву маршрутов
	ИначеЕсли ДанныеЗаполнения <> Неопределено
		И ТипЗнч(ДанныеЗаполнения) = Тип("Массив")
		И ДанныеЗаполнения.Количество() <> 0 Тогда
		
		ПЭ_Титул1 = ДанныеЗаполнения[0].Титул1;
		ЗаполнитьПоМассивуМаршрутов(ДанныеЗаполнения);
		
	// Копирование
	ИначеЕсли ДанныеЗаполнения <> Неопределено
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Титул")
		И ДанныеЗаполнения.Свойство("Скопировать")
		И ДанныеЗаполнения.Скопировать Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Титул);
		Для Каждого ТЧ Из Метаданные().ТабличныеЧасти Цикл
			Для Каждого Стр Из ДанныеЗаполнения.Титул[ТЧ.Имя] Цикл
				НоваяСтрока = ЭтотОбъект[ТЧ.Имя].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		КонецЦикла;
		
		Номер = "";
		Дата = ТекущаяДатаСеанса();
		ДатаДок = ТекущаяДатаСеанса();
		КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьНомерКопииКНомеруДокумента(НомерДок, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЭкспедиторскаяРасписка);
	
	КонецЕсли;
	
	ЗаполнитьРеквизитыПоПользователю();
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ЭкспедиторскаяРасписка_ОбработкаЗаполнения_После", Истина, ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДатаСеанса();
	УИД_ЭкспР = "";
	kl_id = "";
	ДатИнфЭксп = Неопределено;
	ВрИнфЭксп = Неопределено;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ЭкспедиторскаяРасписка_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				Экспедитор,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьПоДокументуПоручениеЭкспедитору(ДокументСсылка)
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КонтурЛогистика_ПЭ_Титул1") Тогда
		ПЭ_Титул1 = ДокументСсылка;
	Иначе
		ПЭ_Титул1 = ДокументСсылка.Титул1;
	КонецЕсли;
	
	Запрос = Документы.КонтурЛогистика_ПЭ_Титул1.ПолучитьЗапросСпискаДокументовМаршрута(ПЭ_Титул1);
	Маршруты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если Маршруты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоМассивуМаршрутов(Маршруты);
	
КонецПроцедуры

Процедура ЗаполнитьПоМассивуМаршрутов(Маршруты)
	
	ПерваяЗаявкаНаМаршрут = Маршруты[0];
	
	// Основные реквизиты
	НомерДок = ПЭ_Титул1.НомДок;
	ДатаДок = ПЭ_Титул1.ДатаДок;
	Клиент = ПЭ_Титул1.СвКлиент;
	Экспедитор = ПЭ_Титул1.СвЭксп;
	ЭкспедицияДоговор = ПЭ_Титул1.ДогТрЭксп;
	
	Грузоотправитель = ПерваяЗаявкаНаМаршрут.СвГО;
	МестоПогрузки = ПерваяЗаявкаНаМаршрут.АдрГруз;
	ФДатПол = ПерваяЗаявкаНаМаршрут.ДатОтгрС;
	ФВрПол = ПерваяЗаявкаНаМаршрут.ВрОтгрС;
	
	СпособДоставкиГруза = Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.СпособДоставкиГруза();
	
	ПользовательПодписант = ПЭ_Титул1.ПользовательПодписант;
	ПараметрНастроекПодписания = ПЭ_Титул1.ПараметрНастроекПодписания;
	
	Для Каждого ЗаявкаНаМаршрут Из Маршруты Цикл
		ЗаполнитьПоЗаявкеНаМршрут(ЗаявкаНаМаршрут);
	КонецЦикла;
	
	// Сопр док
	Для Каждого ТекущаяСтрока Из ПЭ_Титул1.СопрДок Цикл
		НоваяСтрокаСопрДок = СопрДок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСопрДок, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьТаблицу(ТаблицаКопирования, ИдентификаторСтрокиТоваров, ИдентификаторСтрокиГруза, ДокументСсылка)
	
	ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиТоваров", ИдентификаторСтрокиГруза);
	
	Строки = ДокументСсылка[ТаблицаКопирования].НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаКопирования Из Строки Цикл
		
		СтрокаПриемник = ЭтотОбъект[ТаблицаКопирования].Добавить();
		СтрокаПриемник.ИдентификаторСтрокиТоваров = ИдентификаторСтрокиТоваров;
		
		ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаКопирования,, "ИдентификаторСтрокиТоваров");
		
	КонецЦикла;
	
КонецПроцедуры

