	ДанныеЗаполнения.Свойство("Разделитель", Разделитель);
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		ДанныеЗаполнения.ТипЛогистика, ДанныеЗаполнения.ДокументОснование);
	
	Если КонтекстНастройкиКонвертации.ЕстьНастройкаКонвертации Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
			ЭтотОбъект, ДокументОснование, КонтекстНастройкиКонвертации.НастройкаКонвертации, "");
