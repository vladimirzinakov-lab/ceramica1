&НаКлиенте
Процедура СведенияПоТовару_СтранаПроисхожденияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрокиТоваров = ТекущиеДанные.ИдентификаторСтрокиТовара;
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтран = Новый Массив;
	ОтборПоСтрокеТоваров = Новый Структура("ИдентификаторСтрокиТоваров", ИдентификаторСтрокиТоваров);
	
	Для Каждого СтрокаСтраны Из Объект.СтраныПроисхожденияПродукции.НайтиСтроки(ОтборПоСтрокеТоваров) Цикл
		
		Если ЗначениеЗаполнено(СтрокаСтраны.Страна) Тогда
			МассивСтран.Добавить(СтрокаСтраны.Страна);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторСтрокиТоваров", ИдентификаторСтрокиТоваров);
	ПараметрыФормы.Вставить("МассивСтран", МассивСтран);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_СтраныМира.Форма.ФормаВыбораСтранПроисхождениеПродукции",
		ПараметрыФормы,
		ЭтаФорма,
		ЭтаФорма,
		"ПослеВыбораСтран");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаМаршрутыИГрузы Тогда
		МаршрутыИГрузыПриАктивизацииСтроки(Элементы.МаршрутыИГрузы);
	Иначе
		Элементы.ГруппаСведенияПоМаршруту.Видимость = Ложь;
		Элементы.ГруппаСведенияПоТовару.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МаршрутыИГрузыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийИдентификаторСтрокиЗаявкиНаМаршрут = ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут;
	ТекущийИдентификаторСтрокиТовара = ТекущиеДанные.ИдентификаторСтрокиТовара;
	ИмяРеквизита = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "МаршрутыИГрузы", "");
	
	ЭтоСтрокаМаршрута = (ТекущийИдентификаторСтрокиТовара = "");
	
	Если ЭтоСтрокаМаршрута Тогда
		
		// Перенесем изменения из дерева в объект
		Для Каждого ТекущаяСтрока Из Объект.ЗаявкиНаМаршрут Цикл
			Если ТекущаяСтрока.ИдентификаторСтроки <> ТекущийИдентификаторСтрокиЗаявкиНаМаршрут Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяСтрока[ИмяРеквизита] = ТекущиеДанные[ИмяРеквизита];
		КонецЦикла;
		
	Иначе
		
		// Перенесем изменения из дерева в объект
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			Если ТекущаяСтрока.ИдентификаторСтроки <> ТекущийИдентификаторСтрокиТовара Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяСтрока[ИмяРеквизита] = ТекущиеДанные[ИмяРеквизита];
		КонецЦикла;
		
		// Пересчитем итоги по маршруту
		Если ИмяРеквизита <> "ОтгрузочноеНаименование"
			И ИмяРеквизита <> "ЗаявкаНаМаршрут"
			И ИмяРеквизита <> "Валюта"
			И ИмяРеквизита <> "ОбъемКубМ" Тогда
			
			Для Каждого ТекущаяСтрока Из Объект.ЗаявкиНаМаршрут Цикл
				Если ТекущаяСтрока.ИдентификаторСтроки <> ТекущийИдентификаторСтрокиЗаявкиНаМаршрут Тогда
					Продолжить;
				КонецЕсли;
				
				ТекущаяСтрока[ИмяРеквизита] = 0;
				Для Каждого ТекущаяСтрокаТовара Из Объект.Товары Цикл
					Если ТекущаяСтрокаТовара.ИдентификаторСтрокиЗаявкиНаМаршрут <> ТекущийИдентификаторСтрокиЗаявкиНаМаршрут Тогда
						Продолжить;
					КонецЕсли;
					
					ТекущаяСтрока[ИмяРеквизита] = ТекущаяСтрока[ИмяРеквизита] + ТекущаяСтрокаТовара[ИмяРеквизита];
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	РассчитатьИтоги();
	
	ПроверитьДокумент();
	
	// Обновим итоги в дереве
	Если ИмяРеквизита <> "ОтгрузочноеНаименование"
		И ИмяРеквизита <> "ЗаявкаНаМаршрут"
		И ИмяРеквизита <> "Валюта" Тогда
		
		Если Не ЭтоСтрокаМаршрута Тогда
			ОбновитьИтогиДереваПоРеквизиту(ИмяРеквизита);
		КонецЕсли;
		
		РазвернутьМаршрутыИГрузы();
		
		// Перейдем обратно на редактируемую строку
		Для Каждого ЭлементМаршрута Из МаршрутыИГрузы.ПолучитьЭлементы() Цикл
			Для Каждого ЭлементТовара Из ЭлементМаршрута.ПолучитьЭлементы() Цикл
				Если ЭлементТовара.ИдентификаторСтрокиТовара = ТекущийИдентификаторСтрокиТовара Тогда
					ТекущийИдентификатор = ЭлементТовара.ПолучитьИдентификатор();
					Элементы.МаршрутыИГрузы.ТекущаяСтрока = ТекущийИдентификатор;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МаршрутыИГрузыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя <> "МаршрутыИГрузыКонтейнеры" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторСтрокиЗаявкиНаМаршрут", ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут);
	ПараметрыФормы.Вставить("ПризнакПеревозки", ТекущиеДанные.ПризнакПеревозки);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	ПараметрыФормы.Вставить("АдресСведенийОКонтейнерах", АдресСведенийОКонтейнерах(ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут));
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.Форма.СведенияОКонтейнерах", ПараметрыФормы, ЭтаФорма, ЭтаФорма,
		"МаршрутыИГрузыВыборЗавершение");
	
КонецПроцедуры

&НаСервере
Функция АдресСведенийОКонтейнерах(ИдентификаторСтрокиЗаявкиНаМаршрут)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИдентификаторСтрокиЗаявкиНаМаршрут", ИдентификаторСтрокиЗаявкиНаМаршрут);
	
	НайденныеСтроки = Объект.СведенияОКонтейнерах.Выгрузить(ПараметрыОтбора);
	
	Возврат ПоместитьВоВременноеХранилище(НайденныеСтроки, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура МаршрутыИГрузыВыборЗавершение(Результат, ДополнительынеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ИдентификаторСтрокиЗаявкиНаМаршрут = Элементы.МаршрутыИГрузы.ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут;
	ОбновитьДанныеПоКонтейнерам(Результат, ИдентификаторСтрокиЗаявкиНаМаршрут);
	
	// Обновим отображение дерева
	ЗаполнитьМаршрутыИГрузы();
	
	// Развернем дерево
	РазвернутьМаршрутыИГрузы();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПоКонтейнерам(Результат, ИдентификаторСтрокиЗаявкиНаМаршрут)
	
	// Признак перевозки
	Для Каждого ТенкущаяСтрока Из Объект.ЗаявкиНаМаршрут Цикл
		Если ТенкущаяСтрока.ИдентификаторСтроки <> ИдентификаторСтрокиЗаявкиНаМаршрут Тогда
			Продолжить;
		КонецЕсли;
		
		ТенкущаяСтрока.ПризнакПеревозки = Результат.ПризнакПеревозки;
	КонецЦикла;
	
	
	АдресСведенийОКонтейнерах = Результат.АдресСведенийОКонтейнерах;
	
	// Удалим старые строки
	НаУдаление = Новый Массив;
	Для Каждого ТенкущаяСтрока Из Объект.СведенияОКонтейнерах Цикл
		Если ТенкущаяСтрока.ИдентификаторСтрокиЗаявкиНаМаршрут <> ИдентификаторСтрокиЗаявкиНаМаршрут Тогда
			Продолжить;
		КонецЕсли;
		
		НаУдаление.Добавить(ТенкущаяСтрока);
	КонецЦикла;
	Для Каждого ТенкущаяСтрока Из НаУдаление Цикл
		Объект.СведенияОКонтейнерах.Удалить(ТенкущаяСтрока);
	КонецЦикла;
	
	// Добавим новые
	СведенияОКонтейнерах = ПолучитьИзВременногоХранилища(АдресСведенийОКонтейнерах);
	Для Каждого ТенкущаяСтрока Из СведенияОКонтейнерах Цикл
		НоваяСтрока = Объект.СведенияОКонтейнерах.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТенкущаяСтрока);
		НоваяСтрока.ИдентификаторСтрокиЗаявкиНаМаршрут = ИдентификаторСтрокиЗаявкиНаМаршрут;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура МаршрутыИГрузыПриАктивизацииСтроки(Элемент)
	
	Если ИдетОбновленияЭлементовФормы
		Или Элементы.Страницы.ТекущаяСтраница <> Элементы.ГруппаМаршрутыИГрузы Тогда
		
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоТовар = (ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтрокиТовара));
	Элементы.ГруппаСведенияПоТовару.Видимость = ЭтоТовар;
	Элементы.ГруппаСведенияПоМаршруту.Видимость = Не ЭтоТовар;
	
	Если ЭтоТовар Тогда
		
		ОтборСтрок = Новый ФиксированнаяСтруктура(
			"ИдентификаторСтрокиТоваров", ТекущиеДанные.ИдентификаторСтрокиТовара);
		
		Элементы.СведенияГосСистем.ОтборСтрок = ОтборСтрок;
		Элементы.Марк.ОтборСтрок = ОтборСтрок;
		Элементы.ИнфУпГруз.ОтборСтрок = ОтборСтрок;
		
		ОтборСтрок = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтрокиТовара);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			ТекущаяСтрока = НайденныеСтроки[0];
			
			СведенияПоТовару_ОписаниеОпасногоГруза = ТекущаяСтрока.ОписаниеОпасногоГруза;
			СведенияПоТовару_ОсобыеОтметки = ТекущаяСтрока.ОсобыеОтметки;
			СведенияПоТовару_СтранаПроисхождения = КонтурЛогистика_ОбщегоНазначенияКлиент.РассчитатьПредставлениеСтран(
				Объект.СтраныПроисхожденияПродукции, ТекущаяСтрока.ИдентификаторСтроки);
			СведенияПоТовару_ПрзИзъятВещ = ТекущаяСтрока.ПрзИзъятВещ;
			СведенияПоТовару_ПодлежитУчетуВГосСист = ТекущаяСтрока.ПодлежитУчетуВГосСист;
			СведенияПоТовару_КодТНВЭД = ТекущаяСтрока.КодТНВЭД;
		КонецЕсли;
		
		Элементы.ГруппаПодробныеСведенияГосСист.Видимость = СведенияПоТовару_ПодлежитУчетуВГосСист;
		
	Иначе
		
		ОтборСтрок = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут);
		НайденныеСтроки = Объект.ЗаявкиНаМаршрут.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			ТекущаяСтрока = НайденныеСтроки[0];
			
			СведенияОМаршруте_СсылкаНаМаршрут = ТекущаяСтрока.ЗаявкаНаМаршрут;
			СведенияОМаршруте_СостояниеГруза = ТекущаяСтрока.СостояниеГруза;
			СведенияОМаршруте_СостояниеТары = ТекущаяСтрока.СостояниеТары;
			СведенияОМаршруте_СостояниеУпаковки = ТекущаяСтрока.СостояниеУпаковки;
			СведенияОМаршруте_СостояниеМаркировки = ТекущаяСтрока.СостояниеМаркировки;
			СведенияОМаршруте_СостояниеОпломбирования = ТекущаяСтрока.СостояниеОпломбирования;
			
			Элементы.СведенияОМаршруте_СсылкаНаМаршрут.Видимость = ЗначениеЗаполнено(СведенияОМаршруте_СсылкаНаМаршрут);
			
			ЕстьЗамечания = (СведенияОМаршруте_СостояниеГруза <> ТекстЗамечанияПоГрузунет());
			Элементы.СведенияОМаршруте_СостояниеГруза.Видимость = ЕстьЗамечания;
			
			// Обязательства экспедитора
			СкрытьВсеОбязательства();
			СведенияОМаршруте_Обязательства.Очистить();
			
			ОтборСтрокОбязательств = Новый Структура("ИдентификаторСтрокиЗаявкиНаМаршрут", ТекущаяСтрока.ИдентификаторСтроки);
			НайденныеСтрокиОбязятельств = Объект.ОбязательстваЭкспедитора.НайтиСтроки(ОтборСтрокОбязательств);
			Для Каждого ТекущееОбязательство Из НайденныеСтрокиОбязятельств Цикл
				СведенияОМаршруте_Обязательства.Добавить(ТекущееОбязательство.ОбязЭксп);
			КонецЦикла;
			Если СведенияОМаршруте_Обязательства.Количество() = 0 Тогда
				СведенияОМаршруте_Обязательства.Добавить("");
			КонецЕсли;
			ОбновитьЭлементыОтображенияОбязательств();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МаршрутыИГрузыПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрокиЗаявкиНаМаршрут = ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут;
	
	Если ТекущиеДанные.ИдентификаторСтрокиТовара = "" Тогда
		
		// Удаляется маршрут
		УдалитьВсеСвязиМаршрута(ИдентификаторСтрокиЗаявкиНаМаршрут);
		
		УдалитьСвязиИзТаблицы("ЗаявкиНаМаршрут", "ИдентификаторСтроки", ИдентификаторСтрокиЗаявкиНаМаршрут);
		
	Иначе
		
		// Удаляется товар
		УдалитьВсеСвязиТовара(ТекущиеДанные.ИдентификаторСтрокиТовара);
		
		УдалитьСвязиИзТаблицы("Товары", "ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтрокиТовара);
		
		// Проверим что в маршруте есть хотя бы один товар
		ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиЗаявкиНаМаршрут", ИдентификаторСтрокиЗаявкиНаМаршрут);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			// Удалим маршрут
			УдалитьВсеСвязиМаршрута(ИдентификаторСтрокиЗаявкиНаМаршрут);
			УдалитьСвязиИзТаблицы("ЗаявкиНаМаршрут", "ИдентификаторСтроки", ИдентификаторСтрокиЗаявкиНаМаршрут);
		КонецЕсли;
		
	КонецЕсли;
	
	// Обновим отображение дерева
	ЗаполнитьМаршрутыИГрузы();
	
	// Развернем дерево
	РазвернутьМаршрутыИГрузы();
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсеСвязиМаршрута(ИдентификаторСтрокиЗаявкиНаМаршрут)
	
	ИмяКлюча = "ИдентификаторСтрокиЗаявкиНаМаршрут";
	
	УдалитьСвязиИзТаблицы("РеквЗакПост", ИмяКлюча, ИдентификаторСтрокиЗаявкиНаМаршрут);
	УдалитьСвязиИзТаблицы("СопрДокПарт", ИмяКлюча, ИдентификаторСтрокиЗаявкиНаМаршрут);
	УдалитьСвязиИзТаблицы("ОбязательстваЭкспедитора", ИмяКлюча, ИдентификаторСтрокиЗаявкиНаМаршрут);
	УдалитьСвязиИзТаблицы("ИнфПол", ИмяКлюча, ИдентификаторСтрокиЗаявкиНаМаршрут);
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		Если ТекущаяСтрока.ИдентификаторСтрокиЗаявкиНаМаршрут <> ИдентификаторСтрокиЗаявкиНаМаршрут Тогда
			Продолжить;
		КонецЕсли;
		
		// Удалим данные по товарам маршрута
		УдалитьВсеСвязиТовара(ТекущаяСтрока.ИдентификаторСтроки);
		
	КонецЦикла;
	
	УдалитьСвязиИзТаблицы("Товары", ИмяКлюча, ИдентификаторСтрокиЗаявкиНаМаршрут);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсеСвязиТовара(ИдентификаторСтрокиТоваров)
	
	ИмяКлюча = "ИдентификаторСтрокиТоваров";
	
	УдалитьСвязиИзТаблицы("СведенияГосСистем", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("ИнфУпГруз", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("СведенияОКонтейнерах", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("Марк", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("ИнфПол", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("СтраныПроисхожденияПродукции", ИмяКлюча, ИдентификаторСтрокиТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСвязиИзТаблицы(ИмяТаблицы, ИмяКлюча, ЗначениеКлюча)
	
	СтрокиНаУдаление = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Объект[ИмяТаблицы] Цикл
		
		Если ТекущаяСтрока[ИмяКлюча] <> ЗначениеКлюча Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиНаУдаление.Добавить(ТекущаяСтрока);
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из СтрокиНаУдаление Цикл
		Объект[ИмяТаблицы].Удалить(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьВсеОбязательства()
	
	Счет = 0;
	
	Для Каждого ТекущаяСтрока Из СведенияОМаршруте_Обязательства Цикл
		
		ИмяЭлемента = "СведенияОМаршруте_ОбязательстваЭкспедитора_" + Формат(Счет, "ЧДЦ=0; ЧН=0; ЧГ=");
		НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
		Если НайденныйЭлемент <> Неопределено И Счет <> 0 Тогда
			НайденныйЭлемент.Видимость = Ложь;
		КонецЕсли;
		
		Счет = Счет + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыОтображенияОбязательств()
	
	СведенияОМаршруте_ОбязательстваЭкспедитора_0 = "";
	Счет = 0;
	
	Для Каждого ТекущаяСтрока Из СведенияОМаршруте_Обязательства Цикл
		
		ИмяЭлемента = "СведенияОМаршруте_ОбязательстваЭкспедитора_" + Формат(Счет, "ЧДЦ=0; ЧН=0; ЧГ=");
		
		НайденныйЭлемент = Элементы.Найти(ИмяЭлемента);
		Если НайденныйЭлемент = Неопределено Тогда
			// Создадим новый элемент и реквизит
			ИдетОбновленияЭлементовФормы = Истина;
			СоздатьЭлементОбязательстваЭкспедитора(ИмяЭлемента);
			ИдетОбновленияЭлементовФормы = Ложь;
			ТекущийЭлементОбработки = Элементы[ИмяЭлемента];
		Иначе
			ТекущийЭлементОбработки = НайденныйЭлемент;
		КонецЕсли;
		
		ТекущийЭлементОбработки.Видимость = Истина;
		ЭтаФорма[ИмяЭлемента] = ТекущаяСтрока.Значение;
		
		Счет = Счет + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементОбязательстваЭкспедитора(ИмяПоля)
	
	// Добавим реквизит формы
	ОписаниеТипаСтрока = КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.ОписаниеТипаСтрока(255);
	
	ОписаниеРеквизитов = Новый Структура;
	ОписаниеРеквизитов.Вставить(ИмяПоля, ОписаниеТипаСтрока);
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СоздатьРеквизиты(ЭтаФорма, ОписаниеРеквизитов, Истина);
	
	// Создадим элемент
	ГруппаРодитель = Элементы.ГруппаОбязательстваЭкспедитораПрограммный;
	ВидПолеВвода = 1;
	
	СвойстваПоля = Новый Структура;
	СвойстваПоля.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
	СвойстваПоля.Вставить("МногострочныйРежим", Истина);
	СвойстваПоля.Вставить("КнопкаОчистки", Истина);
	СвойстваПоля.Вставить("АвтоМаксимальнаяВысота", Ложь);
	СвойстваПоля.Вставить("МаксимальнаяВысота", 2);
	
	События = Новый Структура;
	События.Вставить("ПриИзменении", "СведенияОМаршруте_ОбязательстваЭкспедитора_ПриИзменении");
	
	КонтурЛогистика_ДинамическоеФормированиеИнтерфейса.СздПоле(
		ЭтаФорма, ИмяПоля, ГруппаРодитель,, ВидПолеВвода, ИмяПоля, СвойстваПоля, События);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОбязательстваВОбъект()
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Удалим старые
	СтрокиНаУдаление = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.ОбязательстваЭкспедитора Цикл
		Если ТекущаяСтрока.ИдентификаторСтрокиЗаявкиНаМаршрут <> ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиНаУдаление.Добавить(ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из СтрокиНаУдаление Цикл
		Объект.ОбязательстваЭкспедитора.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	// Добавим новые
	Для Каждого ТекущаяСтрока Из СведенияОМаршруте_Обязательства Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ОбязательстваЭкспедитора.Добавить();
		НоваяСтрока.ИдентификаторСтрокиЗаявкиНаМаршрут = ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут;
		НоваяСтрока.ОбязЭксп = ТекущаяСтрока.Значение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОМаршруте_ОбязательстваЭкспедитора_ПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = Элемент.Имя;
	НомерСтроки = Число(СтрЗаменить(ИмяЭлемента, "СведенияОМаршруте_ОбязательстваЭкспедитора_", ""));
	
	СведенияОМаршруте_Обязательства[НомерСтроки].Значение = ЭтаФорма[Элемент.Имя];
	
	ПеренестиОбязательстваВОбъект();
	
	ПроверитьДокумент();
	
КонецПроцедуры

