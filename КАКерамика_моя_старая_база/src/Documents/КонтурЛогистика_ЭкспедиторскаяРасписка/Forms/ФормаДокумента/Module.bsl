	РежимДиалога = РежимДиалогаВопрос.ДаНетОтмена;
	КонтурЛогистика_ОбщегоНазначенияКлиент.Вопрос_КонтурЛогистика(ТекстВопроса, РежимДиалога,,, ЭтаФорма,
		"ВалютаУчетаГрузаПриИзмененииЗавершение", Параметры);
	
