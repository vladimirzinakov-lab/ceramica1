
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПроверкаОтвета", РежимПроверкиОтвета);
	
	Элементы.ГруппаСведенияПоМаршруту.Видимость = Ложь;
	Элементы.ГруппаСведенияПоТовару.Видимость = Ложь;
	
	Элементы.ПанельОшибокКоманднаяПанельСвернуть.Видимость = Ложь;
	ИзменитьРасположениеПанелиОшибок();
	
	ОбновитьДанныеФормы();
	
	Элементы.ДокументОснование.Доступность = ТипыДокументаОснованияНастроеныДляТитула();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	УправлениеЭлементамиФормыВЗависимостиОтСтатуса();
	
	ЗаполнитьДополнительныеТаблицы();
	
	УстановитьУсловноеОформление();
	
	Элементы.ФормаВвестиСР.Видимость = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуетсяСкладскаяРасписка");
	
	// Привет, обратная совместимость с 8.2
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЭтоИнтерфейс82() Тогда
		Элементы.ГруппаКоличественныеХарактеристикиПартииТоваров.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.ВалютаУчетаГруза.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;	// Иначе улетает в космос
		Элементы.ЛицоПогрузки.Ширина = 30;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьЗначенияПоУмолчаниюДляНовогоДокумента();
	
	РассчитатьИтоги();
	
	ПроверитьДокумент();
	
	УправлениеВидимостьюИДоступностью();
	
	СформироватьЗаголовокГруппыРеквизитыДокументаПЭ();
	
	РазвернутьМаршрутыИГрузы();
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ПриОткрытииНаКлиенте(ЭтаФорма, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурЛогистика_ИзменениеДокумента" 
		И (Параметр = Объект.Ссылка
			Или (Параметр <> Неопределено
				И ТипЗнч(Параметр) = Тип("Массив")
				И Параметр.Найти(Объект.Ссылка) <> Неопределено)) Тогда
		
		// ДА КАК ЖЕ ТЕБЯ ОБНОВИТЬ так чтобы требуемые действия отобразились?
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		// пока что это единственный найденный способ, приводящий к обновлению требуемых действий.
		// вот список НЕ работающих (возможно они не считают форму активной, поэтому не работают)
		// Элементы.Товары.Обновить();
		// ОбновитьОтображениеДанных();
		// ОбновитьИнтерфейс();

	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьОткрытыеТитулы" Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьЗадачи"
		И Параметр <> Неопределено
		И ТипЗнч(Параметр) = Тип("Массив")
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикПеречитатьОбъект", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ЗакрытьФормыТитулов"
		И Параметр <> Неопределено
		И ТипЗнч(Параметр) = Тип("Массив")
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда
		
		ПодключитьОбработчикОжидания("ОбработчикЗакрытьФорму", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "КонтурЛогистика_ОбновитьФормуТитула" Тогда
		
		ОбновитьФорму();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("КонтурЛогистика_ВвестиДокумент");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокУчСист_Реквизит_СопоставитьНажатие(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	ОбъектДокУчСистПуть = "ЭтаФорма." + СтрЗаменить(ИмяЭлемента, "_Сопоставить", "");
	ЗначениеОбъектДокУчСист = Вычислить(ОбъектДокУчСистПуть);
	
	Если ЗначениеЗаполнено(ЗначениеОбъектДокУчСист) Тогда
		
		ОткрытьФормуПодбораСущностиЛогистика(ЗначениеОбъектДокУчСист, Элемент);
		
	Иначе
		
		// Открыть документ
		Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
			КонтурЛогистика_ОбщегоНазначенияКлиент.ПоказатьЗначение_КонтурЛогистика(Объект.ДокументОснование);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОшибокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаОшибок.ТекущиеДанные;
	
	Если Не ТекущиеДанные.ИдентификаторыСтрокДерева = Неопределено
		И ТекущиеДанные.ИдентификаторыСтрокДерева.Количество() > 0 Тогда
		
		ТекущийИдентификаторСтроки = ТекущиеДанные.ИдентификаторыСтрокДерева[0].Значение;
		
		ТекущиеДанные.ИдентификаторыСтрокДерева[0].Значение = ПолучитьУказательНаСтрокуДерева(ТекущийИдентификаторСтроки);
		
	КонецЕсли;
	
	КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, Поле.Имя, "ПослеВыбораВТаблицеОшибок");
	
КонецПроцедуры

