&НаКлиенте
Процедура ЕстьЗамечанияПриИзменении(Элемент)
	
	Если ЕстьЗамечания Тогда
		СведенияОМаршруте_СостояниеГруза = "";
	Иначе
		СведенияОМаршруте_СостояниеГруза = ТекстЗамечанияПоГрузунет();
	КонецЕсли;
	
	Элементы.СведенияОМаршруте_СостояниеГруза.Видимость = ЕстьЗамечания;
	СведенияОМаршруте_СостояниеПриИзменении(Элементы.СведенияОМаршруте_СостояниеГруза);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстЗамечанияПоГрузунет()
	
	Возврат Документы.КонтурЛогистика_ЭкспедиторскаяРасписка.СостояниеГруза();
	
КонецФункции

&НаКлиенте
Процедура СведенияОМаршруте_СостояниеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ЗаявкиНаМаршрут Цикл
		Если ТекущаяСтрока.ИдентификаторСтроки <> ТекущиеДанные.ИдентификаторСтрокиЗаявкиНаМаршрут Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизита = СтрЗаменить(Элемент.Имя, "СведенияОМаршруте_", "");
		ТекущаяСтрока[ИмяРеквизита] = ЭтаФорма[Элемент.Имя];
	КонецЦикла;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияПоТовару_ПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.МаршрутыИГрузы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ТекущаяСтрока.ИдентификаторСтроки <> ТекущиеДанные.ИдентификаторСтрокиТовара Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизита = СтрЗаменить(Элемент.Имя, "СведенияПоТовару_", "");
		ТекущаяСтрока[ИмяРеквизита] = ЭтаФорма[Элемент.Имя];
	КонецЦикла;
	
	Элементы.ГруппаПодробныеСведенияГосСист.Видимость = СведенияПоТовару_ПодлежитУчетуВГосСист;
	
	ПроверитьДокумент();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИтогиДереваПоРеквизиту(ИмяРеквизита)
	
	МаршрутыИГрузыВрем = РеквизитФормыВЗначение("МаршрутыИГрузы");
	
	Для Каждого ТекущийМаршрут Из МаршрутыИГрузыВрем.Строки Цикл
		
		ИтогоПоМаршруту = 0;
		
		Для Каждого ТекущийТовар Из ТекущийМаршрут.Строки Цикл
			
			ИтогоПоМаршруту = ИтогоПоМаршруту + ТекущийТовар[ИмяРеквизита];
			
		КонецЦикла;
		
		ТекущийМаршрут[ИмяРеквизита] = ИтогоПоМаршруту;
		
	КонецЦикла;
	
	ЗначениеВДанныеФормы(МаршрутыИГрузыВрем, МаршрутыИГрузы);
	
КонецПроцедуры

