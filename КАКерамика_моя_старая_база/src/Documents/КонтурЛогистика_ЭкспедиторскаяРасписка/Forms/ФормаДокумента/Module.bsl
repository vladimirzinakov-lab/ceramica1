&НаКлиенте
Процедура ПЭ_Титул1ПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ПЭ_Титул1) Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоПоручениюЗавершение", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Вы уверены, что хотите перезаполнить документ?", РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПоручениюЗавершение(Ответ, ДополнительынеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполниьТитулПоПЭТитул1();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПЭ_Титул1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Состояние", СостояниеПЭЗавершено());
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Документ.КонтурЛогистика_ПЭ_Титул1.Форма.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ПЭ_Титул1НачалоВыбораЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПЭ_Титул1НачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.ПЭ_Титул1 = Результат;
		ЗаполниьТитулПоПЭТитул1();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СостояниеПЭЗавершено()
	
	Возврат Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("pe-completed");
	
КонецФункции

&НаКлиенте
Процедура ЗаполниьТитулПоПЭТитул1()
	
	ЗаполнитьПоПоручению();
	РазвернутьМаршрутыИГрузы();
	РассчитатьИтоги();
	ПроверитьДокумент();
	УправлениеВидимостьюИДоступностью();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоПоручению()
	
	Объект.ЗаявкиНаМаршрут.Очистить();
	Объект.РеквЗакПост.Очистить();
	Объект.СопрДокПарт.Очистить();
	Объект.ОбязательстваЭкспедитора.Очистить();
	Объект.Товары.Очистить();
	Объект.СведенияГосСистем.Очистить();
	Объект.ИнфУпГруз.Очистить();
	Объект.СведенияОКонтейнерах.Очистить();
	Объект.Марк.Очистить();
	Объект.СопрДок.Очистить();
	Объект.ИнфПол.Очистить();
	
	ПараметрыФормы = Новый Структура("Основание", Объект.ПЭ_Титул1);
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ПЭ_Титул1);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	// Обновим отображение дерева
	ЗаполнитьМаршрутыИГрузы();
	
	Модифицированность = Истина;
	
КонецПроцедуры

