#КонецОбласти

// Вводит складские расписки по поручению экспедитору (титул 2)
//
// Параметры:
//  ПЭ_Титул2 - ДокументСсылка.КонтурЛогистика_ПЭ_Титул2
//
// Возвращаемое значение:
//  Структура - см. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция ВвестиСРизПЭПоТитулу2(ПЭ_Титул2) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Успешно = Ложь;
	Результат.Вставить("СозданныеДокументы", Новый Массив);
	Результат.Вставить("СуществующиеДокументы", Новый Массив);
	Результат.Вставить("ВсеМаршрутыУжеОформлены", Ложь);
	
	ПЭ_Титул1 = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(ПЭ_Титул2, "Титул1");
	Если Не ЗначениеЗаполнено(ПЭ_Титул1) Тогда
		Результат.ОписаниеОшибки = "Не заполнен титул 1 поручения экспедитору";
		Возврат Результат;
	КонецЕсли;
	
	СтатусДО = КонтурЛогистика_ОбщегоНазначенияСервер.ПолучитьСтатусДО(ПЭ_Титул2);
	КодСтатуса = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(СтатусДО, "Код");
	Если КодСтатуса <> "pe-completed" Тогда
		Результат.ОписаниеОшибки = "Оформить складскую расписку можно только после подписания титула 2 поручения экспедитора";
		Возврат Результат;
	КонецЕсли;
	
	ВсеМаршруты = ПолучитьМаршрутыПоручения(ПЭ_Титул1);
	Если ВсеМаршруты.Количество() = 0 Тогда
		Результат.ОписаниеОшибки = "В поручении экспедитору нет заявок на маршрут";
		Возврат Результат;
	КонецЕсли;
	
	ПокрытыеМаршруты = ПолучитьМаршрутыПокрытыеСкладскимиРасписками(ПЭ_Титул1);
	ОстатокМаршрутов = ИсключитьПокрытыеМаршруты(ВсеМаршруты, ПокрытыеМаршруты);
	
	Если ОстатокМаршрутов.Количество() = 0 Тогда
		Результат.ВсеМаршрутыУжеОформлены = Истина;
		Результат.СуществующиеДокументы = ПолучитьСкладскиеРаспискиПоПоручению(ПЭ_Титул1);
		Результат.Успешно = Истина;
		Возврат Результат;
	КонецЕсли;
	
	МаршрутыЭкспедиторскихРасписок = ПолучитьМаршрутыЭкспедиторскихРасписок(ПЭ_Титул1);
	
	Для Каждого ЗаявкаНаМаршрут Из ОстатокМаршрутов Цикл
		
		ЭкспедиторскаяРасписка = НайтиЭкспедиторскуюРаспискуДляМаршрута(ЗаявкаНаМаршрут, МаршрутыЭкспедиторскихРасписок);
		
		Если ЗначениеЗаполнено(ЭкспедиторскаяРасписка) Тогда
			СозданныйДокумент = СоздатьСкладскуюРаспискуИзЭР(ЭкспедиторскаяРасписка, ЗаявкаНаМаршрут);
		Иначе
			СозданныйДокумент = СоздатьСкладскуюРаспискуПоЗаявке(ПЭ_Титул1, ЗаявкаНаМаршрут);
		КонецЕсли;
		
		Результат.СозданныеДокументы.Добавить(СозданныйДокумент);
		
	КонецЦикла;
	
	Результат.Успешно = Результат.СозданныеДокументы.Количество() > 0;
	
	Возврат Результат;
	
КонецФункции

// Пакетный ввод складских расписок из титулов 2 поручения экспедитору
//
// Параметры:
//  МассивПЭ_Титул2 - Массив из ДокументСсылка.КонтурЛогистика_ПЭ_Титул2
//
Процедура ВвестиСРизПЭПакетно(МассивПЭ_Титул2) Экспорт
	
	Для Каждого ПЭ_Титул2 Из МассивПЭ_Титул2 Цикл
		РезультатВвода = ВвестиСРизПЭПоТитулу2(ПЭ_Титул2);
		Если Не ПустаяСтрока(РезультатВвода.ОписаниеОшибки) Тогда
			Сообщить(Строка(ПЭ_Титул2) + ": " + РезультатВвода.ОписаниеОшибки);
		ИначеЕсли РезультатВвода.ВсеМаршрутыУжеОформлены Тогда
			Сообщить(Строка(ПЭ_Титул2) + ": все маршруты уже оформлены складскими расписками");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Создает и записывает новые складские расписки на основании переданных документов СР.
//
// Параметры:
//  МассивОснований - Массив из ДокументСсылка.КонтурЛогистика_СкладскаяРасписка
//  Склад - СправочникСсылка.КонтурЛогистика_ПунктыМаршрута - склад выдачи (может быть пустым)
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.КонтурЛогистика_СкладскаяРасписка
//
Функция СоздатьИЗаписатьНовыеНаОсновании(МассивОснований, Склад = Неопределено) Экспорт
	
	СозданныеДокументы = Новый Массив;
	
	Для Каждого ДокументОснование Из МассивОснований Цикл
		
		СуществующийДокумент = НайтиНеотправленнуюСкладскуюРаспискуНаОсновании(ДокументОснование);
		
		Если ЗначениеЗаполнено(СуществующийДокумент) Тогда
			
			Если ПерезаполнитьИЗаписатьСкладскуюРасписку(СуществующийДокумент, ДокументОснование, Склад) Тогда
				СозданныеДокументы.Добавить(СуществующийДокумент);
			КонецЕсли;
			
		Иначе
			
			НовыйДокумент = СоздатьДокумент();
			ЗаполнитьНовуюСкладскуюРаспискуНаОсновании(НовыйДокумент, ДокументОснование, Склад);
			ЗаписатьНовуюСкладскуюРасписку(НовыйДокумент);
			СозданныеДокументы.Добавить(НовыйДокумент.Ссылка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СозданныеДокументы;
	
КонецФункции

// Заполняет объект новой складской расписки на основании существующей СР.
//
// Параметры:
//  НовыйДокумент - ДокументОбъект.КонтурЛогистика_СкладскаяРасписка
//  ДокументОснование - ДокументСсылка.КонтурЛогистика_СкладскаяРасписка
//  Склад - СправочникСсылка.КонтурЛогистика_ПунктыМаршрута, Неопределено - не заполнять реквизиты склада
//  Перезаполнение - Булево - Истина при обновлении существующего документа
//
Процедура ЗаполнитьНовуюСкладскуюРаспискуНаОсновании(НовыйДокумент, ДокументОснование, Склад = Неопределено,
	Перезаполнение = Ложь) Экспорт
	
	ДокументОснованиеОбъект = ДокументОснование.ПолучитьОбъект();
	
	СохраненныйНомер = "";
	СохраненныйНомерДок = "";
	СохраненнаяДата = '00010101';
	
	Если Перезаполнение Тогда
		
		СохраненныйНомер = НовыйДокумент.Номер;
		СохраненныйНомерДок = НовыйДокумент.НомерДок;
		СохраненнаяДата = НовыйДокумент.Дата;
		
		Для Каждого ТабличнаяЧасть Из Метаданные.Документы.КонтурЛогистика_СкладскаяРасписка.ТабличныеЧасти Цикл
			НовыйДокумент[ТабличнаяЧасть.Имя].Очистить();
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ДокументОснованиеОбъект, , ИсключаемыеРеквизитыПриКопированииСР());
	
	Для Каждого ТабличнаяЧасть Из Метаданные.Документы.КонтурЛогистика_СкладскаяРасписка.ТабличныеЧасти Цикл
		
		Для Каждого СтрокаТабличнойЧасти Из ДокументОснованиеОбъект[ТабличнаяЧасть.Имя] Цикл
			
			НоваяСтрока = НовыйДокумент[ТабличнаяЧасть.Имя].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОчиститьИсключаемыеРеквизитыНовойСР(НовыйДокумент);
	
	НовыйДокумент.ДатаДок = ТекущаяДатаСеанса();
	
	Если Перезаполнение Тогда
		
		НовыйДокумент.Номер = СохраненныйНомер;
		НовыйДокумент.НомерДок = СохраненныйНомерДок;
		НовыйДокумент.Дата = СохраненнаяДата;
		
	Иначе
		
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
		НовыйДокумент.Номер = "";
		НовыйДокумент.НомерДок = СледующийНомерДокСР(ДокументОснованиеОбъект.НомерДок);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВводИзПорученияЭкспедитору

Функция ПолучитьМаршрутыПоручения(ПЭ_Титул1)
	
	Запрос = Документы.КонтурЛогистика_ПЭ_Титул1.ПолучитьЗапросСпискаДокументовМаршрута(ПЭ_Титул1);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьМаршрутыПокрытыеСкладскимиРасписками(ПЭ_Титул1)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_СкладскаяРасписка.ЗаявкаНаМаршрут КАК ЗаявкаНаМаршрут,
	|	КонтурЛогистика_СкладскаяРасписка.ИдентПартГруз КАК ИдентификаторПартии
	|ИЗ
	|	Документ.КонтурЛогистика_СкладскаяРасписка КАК КонтурЛогистика_СкладскаяРасписка
	|ГДЕ
	|	КонтурЛогистика_СкладскаяРасписка.ПЭ_Титул1 = &ПЭ_Титул1
	|	И НЕ КонтурЛогистика_СкладскаяРасписка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПЭ_Титул1", ПЭ_Титул1);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьСкладскиеРаспискиПоПоручению(ПЭ_Титул1)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтурЛогистика_СкладскаяРасписка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_СкладскаяРасписка КАК КонтурЛогистика_СкладскаяРасписка
	|ГДЕ
	|	КонтурЛогистика_СкладскаяРасписка.ПЭ_Титул1 = &ПЭ_Титул1
	|	И НЕ КонтурЛогистика_СкладскаяРасписка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПЭ_Титул1", ПЭ_Титул1);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьМаршрутыЭкспедиторскихРасписок(ПЭ_Титул1)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.Ссылка КАК ЭкспедиторскаяРасписка,
	|	ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.ЗаявкаНаМаршрут КАК ЗаявкаНаМаршрут,
	|	ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.Идентификатор КАК ИдентификаторПартии
	|ИЗ
	|	Документ.КонтурЛогистика_ЭкспедиторскаяРасписка.ЗаявкиНаМаршрут КАК ЭкспедиторскаяРаспискаЗаявкиНаМаршрут
	|ГДЕ
	|	ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.Ссылка.ПЭ_Титул1 = &ПЭ_Титул1
	|	И НЕ ЭкспедиторскаяРаспискаЗаявкиНаМаршрут.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПЭ_Титул1", ПЭ_Титул1);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ИсключитьПокрытыеМаршруты(ВсеМаршруты, ПокрытыеМаршруты)
	
	ОстатокМаршрутов = Новый Массив;
	
	Для Каждого ЗаявкаНаМаршрут Из ВсеМаршруты Цикл
		
		Если МаршрутУжеПокрыт(ЗаявкаНаМаршрут, ПокрытыеМаршруты) Тогда
			Продолжить;
		КонецЕсли;
		
		ОстатокМаршрутов.Добавить(ЗаявкаНаМаршрут);
		
	КонецЦикла;
	
	Возврат ОстатокМаршрутов;
	
КонецФункции

Функция МаршрутУжеПокрыт(ЗаявкаНаМаршрут, ПокрытыеМаршруты)
	
	ИдентификаторПартии = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ЗаявкаНаМаршрут, "ИдПарт");
	
	Для Каждого ПокрытыйМаршрут Из ПокрытыеМаршруты Цикл
		
		Если ЗначениеЗаполнено(ЗаявкаНаМаршрут)
			И ЗаявкаНаМаршрут = ПокрытыйМаршрут.ЗаявкаНаМаршрут Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторПартии)
			И ИдентификаторПартии = ПокрытыйМаршрут.ИдентификаторПартии Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СоздатьСкладскуюРаспискуИзЭР(ЭкспедиторскаяРасписка, ЗаявкаНаМаршрут)
	
	НовыйДокумент = Документы.КонтурЛогистика_СкладскаяРасписка.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЭкспедиторскаяРасписка", ЭкспедиторскаяРасписка);
	ДанныеЗаполнения.Вставить("ЗаявкаНаМаршрут", ЗаявкаНаМаршрут);
	НовыйДокумент.Заполнить(ДанныеЗаполнения);
	ЗаписатьНовуюСкладскуюРасписку(НовыйДокумент);
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

Функция СоздатьСкладскуюРаспискуПоЗаявке(ПЭ_Титул1, ЗаявкаНаМаршрут)
	
	НовыйДокумент = Документы.КонтурЛогистика_СкладскаяРасписка.СоздатьДокумент();
	НовыйДокумент.Заполнить(ЗаявкаНаМаршрут);
	НовыйДокумент.ПЭ_Титул1 = ПЭ_Титул1;
	ЗаписатьНовуюСкладскуюРасписку(НовыйДокумент);
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

Функция НайтиЭкспедиторскуюРаспискуДляМаршрута(ЗаявкаНаМаршрут, МаршрутыЭкспедиторскихРасписок)
	
	ИдентификаторПартии = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ЗаявкаНаМаршрут, "ИдПарт");
	
	Для Каждого СтрокаЭР Из МаршрутыЭкспедиторскихРасписок Цикл
		
		Если ЗначениеЗаполнено(ЗаявкаНаМаршрут)
			И ЗаявкаНаМаршрут = СтрокаЭР.ЗаявкаНаМаршрут Тогда
			Возврат СтрокаЭР.ЭкспедиторскаяРасписка;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторПартии)
			И ИдентификаторПартии = СтрокаЭР.ИдентификаторПартии Тогда
			Возврат СтрокаЭР.ЭкспедиторскаяРасписка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьНовуюСкладскуюРасписку(НовыйДокумент)
	
	Если Не ЗначениеЗаполнено(НовыйДокумент.Дата) Тогда
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НовыйДокумент.Номер) Тогда
		НовыйДокумент.УстановитьНовыйНомер();
	КонецЕсли;
	
	НовыйДокумент.Записать();
	
КонецПроцедуры

Функция ПерезаполнитьИЗаписатьСкладскуюРасписку(ДокументСсылка, ДокументОснование, Склад = Неопределено)
	
	ДокументОбъект = Неопределено;
	
	Попытка
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументОбъект.Заблокировать();
		
	Исключение
		
		Сообщить("Не удалось обновить документ " + ДокументСсылка
			+ " т.к. он заблокирован другим пользователем или процессом");
		Возврат Ложь;
		
	КонецПопытки;
	
	Попытка
		
		ЗаполнитьНовуюСкладскуюРаспискуНаОсновании(ДокументОбъект, ДокументОснование, Склад, Истина);
		ДокументОбъект.Записать();
		
	Исключение
		
		Попытка
			ДокументОбъект.Разблокировать();
		Исключение
		КонецПопытки;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	ДокументОбъект.Разблокировать();
	
	Возврат Истина;
	
КонецФункции

Функция НайтиНеотправленнуюСкладскуюРаспискуНаОсновании(ДокументОснование)
	
	НомерДокОснования = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
		ДокументОснование, "НомерДок");
	БазовыйНомерДок = БазовыйНомерДокСР(НомерДокОснования);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтурЛогистика_СкладскаяРасписка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КонтурЛогистика_СкладскаяРасписка КАК КонтурЛогистика_СкладскаяРасписка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтурЛогистика_СтатусыТитулов.СрезПоследних КАК КонтурЛогистика_СтатусыТитуловСрезПоследних
	|		ПО КонтурЛогистика_СкладскаяРасписка.Ссылка = КонтурЛогистика_СтатусыТитуловСрезПоследних.Документ
	|ГДЕ
	|	КонтурЛогистика_СкладскаяРасписка.НомерДок ПОДОБНО &ШаблонНомера
	|	И КонтурЛогистика_СкладскаяРасписка.Ссылка <> &ДокументОснование
	|	И НЕ КонтурЛогистика_СкладскаяРасписка.ПометкаУдаления
	|	И (КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус В (&СтатусыНеотправленных)
	|		ИЛИ КонтурЛогистика_СтатусыТитуловСрезПоследних.Статус ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтурЛогистика_СкладскаяРасписка.НомерДок УБЫВ";
	
	Запрос.УстановитьПараметр("ШаблонНомера", БазовыйНомерДок + "-%");
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("СтатусыНеотправленных", СтатусыНеотправленныхСкладскойРасписки());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Документы.КонтурЛогистика_СкладскаяРасписка.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция СтатусыНеотправленныхСкладскойРасписки()
	
	СтатусыНеотправленных = Новый Массив;
	СтатусыНеотправленных.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Черновик);
	СтатусыНеотправленных.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка);
	СтатусыНеотправленных.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.ПодготовленКОтправке);
	СтатусыНеотправленных.Добавить(Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена);
	
	Возврат СтатусыНеотправленных;
	
КонецФункции

Функция БазовыйНомерДокСР(НомерДок)
	
	ПозицияРазделителя = КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(НомерДок, "-", "СКонца");
	
	Если ПозицияРазделителя > 0 Тогда
		
		Суффикс = Сред(НомерДок, ПозицияРазделителя + 1);
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаСодержитТолькоЦифры(Суффикс) Тогда
			Возврат Лев(НомерДок, ПозицияРазделителя - 1);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НомерДок;
	
КонецФункции

Функция ИсключаемыеРеквизитыПриКопированииСР()
	
	Возврат "УИД_СкладР,kl_id,ДатИнфЭксп,ВрИнфЭксп,Склад,ПользовательПодписант,ПараметрНастроекПодписания";
	
КонецФункции

Процедура ОчиститьИсключаемыеРеквизитыНовойСР(НовыйДокумент)
	
	НовыйДокумент.УИД_СкладР = "";
	НовыйДокумент.kl_id = "";
	НовыйДокумент.ДатИнфЭксп = Неопределено;
	НовыйДокумент.ВрИнфЭксп = Неопределено;
	НовыйДокумент.Склад = Справочники.КонтурЛогистика_ПунктыМаршрута.ПустаяСсылка();
	НовыйДокумент.ПользовательПодписант = Справочники.УчетнаяСистема_Пользователи.ПустаяСсылка();
	НовыйДокумент.ПараметрНастроекПодписания = "";
	
КонецПроцедуры

Функция СледующийНомерДокСР(НомерДокОснования)
	
	ПозицияРазделителя = КонтурЛогистика_СтдСтрКлиентСервер.СтрНайтиЛок(НомерДокОснования, "-", "СКонца");
	
	Если ПозицияРазделителя > 0 Тогда
		
		Суффикс = Сред(НомерДокОснования, ПозицияРазделителя + 1);
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СтрокаСодержитТолькоЦифры(Суффикс) Тогда
			
			БазовыйНомер = БазовыйНомерДокСР(НомерДокОснования);
			Возврат БазовыйНомер + "-" + Формат(Число(Суффикс) + 1, "ЧГ=0");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НомерДокОснования + "-2";
	
КонецФункции

#КонецОбласти

#Область ПроверкаЗаполнения

Процедура ВыполнитьВалидации(ДокументОбъектИлиСсылка, ТаблицаОшибок, ПараметрыФормированияФайлов)
	
	КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
	КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
	
	ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	ПроверитьЗаявкуНаМаршрут(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	ПроверитьСведенияОКонтейнерах(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
	Если Не ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ОтправительШаблона) Тогда
		ПроверитьПодписанта(ДокументОбъектИлиСсылка, ТаблицаОшибок, ПараметрыФормированияФайлов);
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьОтправителя(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
КонецПроцедуры

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Если Не Объект.Экспедитор.Экспедитор Тогда
		ТекстОшибки = "Для организации указанной экспедитором нужно включить роль Экспедитора";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Экспедитор.Экспедитор", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Экспедитор.НомРеестр) Тогда
		ТекстОшибки = "Необходимо указать номер экспедитора в реестре";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Экспедитор.НомРеестр", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Экспедитор.ДатаРеестр) Тогда
		ТекстОшибки = "Необходимо указать дату регистрации экспедитора в реестре";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Экспедитор.ДатаРеестр", КатегорияОшибка, ТекстОшибки, "Указать");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Стоимость) И Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		ТекстОшибки = "Необходимо указать Валюту";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"Валюта", КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		ПроверитьАдресПунктаМаршрута(Объект.Склад, "Склад.АдресИнфАдрес", "склада", ТаблицаОшибок);
		
		// Владелец склада
		Если Объект.Склад.Собственник <> Объект.Экспедитор И Не ЗначениеЗаполнено(Объект.Склад.Собственник) Тогда
			ТекстОшибки = "Необходимо указать владельца склада";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Склад.Собственник", КатегорияОшибка, ТекстОшибки, "Указать");
		КонецЕсли;
	КонецЕсли;
	
	// Способ доставки груза (СпДостГруз)
	Если Не ЗначениеЗаполнено(Объект.СпособДоставкиГруза) Тогда
		ТекстОшибки = "Необходимо указать способ доставки груза";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
			"СпособДоставкиГруза", КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
	Для Каждого ОбязательныйРеквизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Не ЗначениеЗаполнено(Объект[ОбязательныйРеквизит]) Тогда
			
			ТекстОшибки = "Укажите " + СинонимРеквизита(ОбязательныйРеквизит);
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, "", "", ОбязательныйРеквизит, КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаявкуНаМаршрут(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Если Не ЗначениеЗаполнено(Объект.ЗаявкаНаМаршрут) Тогда
		ТекстОшибки = "Необходимо указать заявку на маршрут";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок,,, "ЗаявкаНаМаршрут", КатегорияОшибка, ТекстОшибки, "Заполнить");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Стоимость) И Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		ТекстОшибки = "Необходимо указать валюту";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок,,, "Валюта", КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НомПартГруз) И Не ЗначениеЗаполнено(Объект.ИдентПартГруз) Тогда
		ТекстОшибки = "Необходимо указать номер или идентификатор партии груза";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок,,, "НомПартГруз", КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СостояниеГруза) Тогда
		ТекстОшибки = "Необходимо указать фактическое состояние груза при приеме на хранение";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок,,, "СостояниеГруза", КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
	ПроверитьУсловияПриемаГрХран(Объект, ТаблицаОшибок, Объект.ЗаявкаНаМаршрут);
	ПроверитьТовары(Объект, ТаблицаОшибок, Объект.ЗаявкаНаМаршрут);
	
КонецПроцедуры

Процедура ПроверитьУсловияПриемаГрХран(Знач Объект, ТаблицаОшибок, ЗаявкаНаМаршрут)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	ИмяТЧ = "УсловияПриемаГрХран";
	
	Если Объект.УсловияПриемаГрХран.Количество() = 0 Тогда
		ТекстОшибки = "Необходимо указать хотя бы одно условие приема груза на хранение";
		Если ЗначениеЗаполнено(ЗаявкаНаМаршрут) Тогда
			ТекстОшибки = ТекстОшибки + " для маршрута: " + ЗаявкаНаМаршрут;
		КонецЕсли;
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок,,, ИмяТЧ, КатегорияОшибка, ТекстОшибки, "Заполнить");
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПриемаГрХран Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.СостояниеГруза) Тогда
			ТекстОшибки = "Необходимо указать фактическое состояние груза при приеме на хранение";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "СостояниеГруза", КатегорияОшибка, ТекстОшибки, "Заполнить",
				ТекущаяСтрока.НомерСтроки);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ФДатХран) Тогда
			ТекстОшибки = "Необходимо указать фактическую дату приема груза на хранение";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "ФДатХран", КатегорияОшибка, ТекстОшибки, "Заполнить",
				ТекущаяСтрока.НомерСтроки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ЛицоПриемки)
			И Не ЗначениеЗаполнено(ТекущаяСтрока.ДоговорЛицаПриемки) Тогда
			
			ТекстОшибки = "Необходимо указать документ, дающий право на приемку груза на хранение";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "ДоговорЛицаПриемки", КатегорияОшибка, ТекстОшибки, "Заполнить",
				ТекущаяСтрока.НомерСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьТовары(Знач Объект, ТаблицаОшибок, ЗаявкаНаМаршрут)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	ИмяТЧ = "Товары";
	
	Если Объект.Товары.Количество() = 0 Тогда
		ТекстОшибки = "Нет ни одного груза для маршрута: " + ЗаявкаНаМаршрут;
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, "", "", "", КатегорияОшибка, ТекстОшибки, "Добавить груз");
		Возврат;
	КонецЕсли;
	
	ЕстьУчитываемыеТовары = Ложь;
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		
		Если Не СтрокаТовара.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьУчитываемыеТовары = Истина;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.ОтгрузочноеНаименование) Тогда
			ТекстОшибки = "Укажите Отгрузочное наименование по грузу";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "ОтгрузочноеНаименование", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать отгрузочное наименование");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.КоличествоМест) Тогда
			ТекстОшибки = "Укажите Количество мест по грузу";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "КоличествоМест", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать кол-во мест");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.МассаБруттоКг) Тогда
			ТекстОшибки = "Укажите Массу (брутто) груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "МассаБруттоКг", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать массу брутто");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.МассаНеттоКг) Тогда
			ТекстОшибки = "Укажите Массу (нетто) груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "МассаНеттоКг", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать массу нетто");
		КонецЕсли;
		
		ПроверитьСтрануПроисхождения(Объект, ТаблицаОшибок, КатегорияОшибка, ИмяТЧ, СтрокаТовара);
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.КодТНВЭД) Тогда
			ТекстОшибки = "Укажите ТН ВЭД груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "КодТНВЭД", КатегорияПредупреждение, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать ТН ВЭД");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТовара.Стоимость) И Не ЗначениеЗаполнено(СтрокаТовара.Валюта) Тогда
			ТекстОшибки = "Укажите Валюту груза";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ,, "Валюта", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать валюту");
		КонецЕсли;
		
		Если СтрокаТовара.ПодлежитУчетуВГосСист Тогда
			ПроверитьГосСисТовара(Объект, ТаблицаОшибок, КатегорияОшибка, ИмяТЧ, СтрокаТовара);
		КонецЕсли;
		
		ПроверитьУпаковкиТовара(Объект, ТаблицаОшибок, КатегорияОшибка, ИмяТЧ, СтрокаТовара);
		
	КонецЦикла;
	
	Если Не ЕстьУчитываемыеТовары Тогда
		ТекстОшибки = "Необходимо указать хотя бы один груз для хранения";
		Если ЗначениеЗаполнено(ЗаявкаНаМаршрут) Тогда
			ТекстОшибки = ТекстОшибки + " для маршрута: " + ЗаявкаНаМаршрут;
		КонецЕсли;
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок,,, ИмяТЧ, КатегорияОшибка, ТекстОшибки, "Заполнить");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСведенияОКонтейнерах(Знач Объект, ТаблицаОшибок)
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	
	Для Каждого ТекущаяСтрока Из Объект.СведенияОКонтейнерах Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номер) Тогда
			ТекстОшибки = "Укажите Порядковый номер контейнера";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, "СведенияОКонтейнерах", ТекущаяСтрока.НомерСтроки,
				"Номер", КатегорияОшибка, ТекстОшибки, "Заполнить");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьГосСисТовара(Знач Объект, ТаблицаОшибок, КатегорияОшибка, ИмяТЧ, СтрокаТовара)
	
	ИмяТЧГосСист = "СведенияГосСистем_";
	ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки);
	СведенияГосСистем = Объект.СведенияГосСистем.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого ТекущаяСтрока Из СведенияГосСистем Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.НаимГосСист) Тогда
			ТекстОшибки = "Укажите Наименование государственной системы";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущаяСтрока.НомерСтроки,
				ИмяТЧГосСист + "НаимГосСист", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать");
		КонецЕсли;
		
		Если ТекущаяСтрока.НаимГосСист = Перечисления.КонтурЛогистика_НаименованиеГИСа.Иное
			И Не ЗначениеЗаполнено(ТекущаяСтрока.НаимГосСистИное) Тогда
			
			ТекстОшибки = "Укажите Наименование государственной системы";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущаяСтрока.НомерСтроки,
				ИмяТЧГосСист + "НаимГосСистИное", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИдНомУчетЕд) Тогда
			ТекстОшибки = "Укажите Идентификационный номер";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущаяСтрока.НомерСтроки,
				ИмяТЧГосСист + "ИдНомУчетЕд", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьУпаковкиТовара(Знач Объект, ТаблицаОшибок, КатегорияОшибка, ИмяТЧ, СтрокаТовара)
	
	ИмяТЧУпак = "ИнфУпГруз_";
	ПараметрыОтбора = Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки);
	УпаковкиТовара = Объект.ИнфУпГруз.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого ТекущаяСтрока Из УпаковкиТовара Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ВидУпак) Тогда
			ТекстОшибки = "Укажите Вид упаковки";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
				ТаблицаОшибок, ИмяТЧ, ТекущаяСтрока.НомерСтроки,
				ИмяТЧУпак + "ВидУпак", КатегорияОшибка, ТекстОшибки, "Заполнить",
				СтрокаТовара.ИдентификаторСтроки,, "Указать");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьПодписанта(ДокументОбъектИлиСсылка, ТаблицаОшибок, ПараметрыФормированияФайлов)
	
	Если ЗначениеЗаполнено(ДокументОбъектИлиСсылка.ПользовательПодписант) Тогда
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
	Иначе
		ТекстОшибки = "Укажите пользователя подписанта документа";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, "", "", "ПользовательПодписант", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка,
			ТекстОшибки, "Указать");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтрануПроисхождения(Знач Объект, ТаблицаОшибок, КатегорияОшибка, ИмяТЧ, СтрокаТовара)
	
	ОтборСтранСтроки = Новый Структура("ИдентификаторСтрокиТоваров", СтрокаТовара.ИдентификаторСтроки);
	СтранаЗаполнена = Ложь;
	Для Каждого СтрокаСтраны Из Объект.СтраныПроисхожденияПродукции.НайтиСтроки(ОтборСтранСтроки) Цикл
		
		Если ЗначениеЗаполнено(СтрокаСтраны.Страна) Тогда
			СтранаЗаполнена = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не СтранаЗаполнена Тогда
		ТекстОшибки = "Укажите Сведения о стране происхождения груза";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(
			ТаблицаОшибок, ИмяТЧ,,
			"СведенияПоТовару_СтранаПроисхождения", КатегорияОшибка, ТекстОшибки, "Заполнить",
			СтрокаТовара.ИдентификаторСтроки,, "Указать сведения о стране происхождения груза");
	КонецЕсли;
	
КонецПроцедуры

Функция СинонимРеквизита(ИмяРеквизита)
	
	Попытка
		Возврат Метаданные.Документы.КонтурЛогистика_СкладскаяРасписка.Реквизиты[ИмяРеквизита].Синоним;
	Исключение
		Возврат ИмяРеквизита;
	КонецПопытки;
	
КонецФункции

Процедура ПроверитьАдресПунктаМаршрута(ПунктМаршрута, ИмяПоля, ПредставленияОбъекта, ТаблицаОшибок)
	
	ТекстОшибки = "Укажите адрес " + ПредставленияОбъекта + " в его карточке";
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьАдресПунктаМаршрута(
		ПунктМаршрута, ТаблицаОшибок, ИмяПоля, ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

