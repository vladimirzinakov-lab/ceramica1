Функция КлючевыеРеквизитыСАвтоматическимЗаполнением() Экспорт
	
	МассивКлючевых = Новый Массив();
	МассивКлючевых.Добавить("ДатИнфЭксп");
	МассивКлючевых.Добавить("ВрИнфЭксп");
	
	Возврат МассивКлючевых;
	
КонецФункции

Функция МассивДополнительныхРеквизитов() Экспорт
	
