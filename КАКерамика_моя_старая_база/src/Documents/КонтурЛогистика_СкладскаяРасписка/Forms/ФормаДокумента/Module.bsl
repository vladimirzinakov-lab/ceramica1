&НаКлиенте
Функция ПроверитьДокумент()
	
	РезультатПроверки = ПроверитьДокументСервер();
	
	Если ТекущийКодСостоянияДокументооборота = "wr-wait-forwarder"
		Или ТекущийКодСостоянияДокументооборота = "wr-wait-cargo-owner"
		Или ТекущийКодСостоянияДокументооборота = "wr-completed" Тогда
		
		ВсегдаВыводитьРезультатВалидации = Ложь;
	Иначе
		ВсегдаВыводитьРезультатВалидации = Истина;
	КонецЕсли;
	
	КонтурЛогистика_ПанельОшибокКлиент.ОбновитьСостояниеПанели(
		ТекущийСтатус, ЭтаФорма, РезультатПроверки, ВсегдаВыводитьРезультатВалидации);
	
	УправлениеВидимостьюИДоступностью(); // Доступность команд
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Процедура УправлениеВидимостьюИДоступностью()
	
	ЕстьЭкспедиторскаяРасписка = ЗначениеЗаполнено(Объект.ЭкспедиторскаяРасписка);
	Элементы.ПЭ_Титул1.Видимость = Не ЕстьЭкспедиторскаяРасписка;
	Элементы.ЭкспедиторскаяРасписка.Видимость = ЕстьЭкспедиторскаяРасписка;
	
	УстановитьФорматыКолонокСКоличеством();
	
	Элементы.ГруппаУсловияПриемаГрузаЕдиничная.Видимость = (ПереключательУсловияПриема = 0);
	Элементы.ГруппаУсловияПриемаГрузаМножественная.Видимость = (ПереключательУсловияПриема = 1);
	
	ЕстьЗамечания = (СостояниеГруза <> ТекстЗамечанияПоГрузунет());
	Элементы.СостояниеГруза.Видимость = ЕстьЗамечания;
	
	Элементы.ГруппаСведенияПоТовару.Видимость = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары);
	
	ПересчитатьЗаголовкиКоличества(ЭтаФорма);
	
	ЕстьПоручениеЭкспедитора = ЗначениеЗаполнено(Объект.ПЭ_Титул1);
	Элементы.Клиент.ТолькоПросмотр = ЕстьПоручениеЭкспедитора;
	Элементы.Экспедитор.ТолькоПросмотр = ЕстьПоручениеЭкспедитора;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФорматыКолонокСКоличеством()
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(
		Объект.Товары, "МассаНеттоКг", Элементы.ТоварыМассаБруттоКг);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.УстановитьФорматКолонкиКоличества(
		Объект.Товары, "МассаНеттоКг", Элементы.ТоварыМассаНеттоКг);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДокументСервер()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатыПроверкиДокумента = Документы.КонтурЛогистика_СкладскаяРасписка.ПроверитьДокумент(ДокОбъект, ТаблицаОшибок);
	
	РезультатПроверки = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикЗакрытьФорму()
	
	ТекущийСтатус = СтатусТитула(Объект.Ссылка);
	Если ТекущийСтатус = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Ошибка") Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтатусТитула(ДокументСсылка)
	
	Возврат РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументСсылка, Истина);
	
КонецФункции

