&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьЗаголовкиКоличества(Форма)
	
	КоличествоСтрок = 0;
	
	Для Каждого ТекущаяСтрока Из Форма.Объект.Товары Цикл
		
		Если Не ТекущаяСтрока.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоСтрок = КоличествоСтрок + 1;
		
	КонецЦикла;
	
	Форма.Элементы.СтраницаТовары.Заголовок = "Партия груза (" + КоличествоСтрок + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя <> "ТоварыТребуемоеДействие" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		ТекСтрТребуемоеДействие = ТекДанные.ТребуемоеДействие;
		ПараметрыТекСтрока = ВыбраннаяСтрока;
		Если ТекСтрТребуемоеДействие = "Указать Номенклатуру" Тогда
			
			ТипСправочникаНоменклатура = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИмяСправочникаНоменклатура");
			
			КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_УчетнойСистемы(
				"Справочник." + ТипСправочникаНоменклатура + ".ФормаВыбора",,
				ЭтаФорма, ЭтаФорма, "ОбработчикВыбораНоменклатуры", ПараметрыТекСтрока);
			
		ИначеЕсли ТекСтрТребуемоеДействие = "Указать Единицу измерения" Тогда
			Элементы.Товары.ТекущийЭлемент = Элементы.ТоварыУпаковкаЕдиницаИзмерения;
			Элементы.Товары.ИзменитьСтроку();
		ИначеЕсли ТекСтрТребуемоеДействие = "Указать Количество" Тогда
			Элементы.Товары.ТекущийЭлемент = Элементы.ТоварыКоличество;
			Элементы.Товары.ИзменитьСтроку();
		ИначеЕсли ТекСтрТребуемоеДействие = "Установить соответствие" Или ТекСтрТребуемоеДействие = "Не учитывается" Тогда
			ОткрытьСоответствияТекущейСтроки();
		Иначе // требуемое действие от таблицы ошибок
			ОбработатьТребуемоеДействие(ТекСтрТребуемоеДействие, Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьТребуемоеДействие(ТребуемоеДействие, ПолеТаблицыОшибок = Неопределено)
	
	Если ПолеТаблицыОшибок <> Неопределено Тогда
		КонтурЛогистика_ПанельОшибокКлиент.ТаблицаОшибокВыбор(ЭтаФорма, Объект, ПолеТаблицыОшибок.Имя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСоответствияТекущейСтроки()
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда
		
		ТекстПредупреждения = "Табличная часть пуста! Сначала добавьте товар.";
		КонтурЛогистика_ОбщегоНазначенияКлиент.Предупреждение_КонтурЛогистика(ТекстПредупреждения);	
		
	Иначе
		
		КонтурЛогистика_КонвертацияКлиент.ОткрытьСоответствияНоменклатуры(ТекущиеДанные.Номенклатура,
			ТекущиеДанные.УпаковкаЕдиницаИзмерения, ТекущиеДанные.Характеристика, ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый ФиксированнаяСтруктура(
		"ИдентификаторСтрокиТоваров", ТекущиеДанные.ИдентификаторСтроки);
	
	Элементы.СведенияГосСистем.ОтборСтрок = ОтборСтрок;
	Элементы.ИнфУпГруз.ОтборСтрок = ОтборСтрок;
	Элементы.Марк.ОтборСтрок = ОтборСтрок;
	Элементы.ИнфПолТовара.ОтборСтрок = ОтборСтрок;
	
	СведенияПоТовару_СтранаПроисхождения = КонтурЛогистика_ОбщегоНазначенияКлиент.РассчитатьПредставлениеСтран(
		Объект.СтраныПроисхожденияПродукции, ТекущиеДанные.ИдентификаторСтроки);
	
	Элементы.ГруппаСведенияПоТовару.Видимость = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары);
	Элементы.ГруппаПодробныеСведенияГосСист.Видимость = ТекущиеДанные.ПодлежитУчетуВГосСист;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.Учитывать = Истина;
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ПроверитьДокумент();
	СформироватьТребуемоеДействиеСтрокиТовара(Элемент.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторСтрокиТоваров = ТекущиеДанные.ИдентификаторСтроки;
		УдалитьВсеСвязиТовара(ИдентификаторСтрокиТоваров);
	КонецЕсли;
	
	ПроверитьДокумент();
	СформироватьТребуемоеДействиеСтрокиТовара(Элемент.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсеСвязиТовара(ИдентификаторСтрокиТоваров)
	
	ИмяКлюча = "ИдентификаторСтрокиТоваров";
	
	УдалитьСвязиИзТаблицы("СведенияГосСистем", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("ИнфУпГруз", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("Марк", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("ИнфПол", ИмяКлюча, ИдентификаторСтрокиТоваров);
	УдалитьСвязиИзТаблицы("СтраныПроисхожденияПродукции", ИмяКлюча, ИдентификаторСтрокиТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСвязиИзТаблицы(ИмяТаблицы, ИмяКлюча, ЗначениеКлюча)
	
	СтрокиНаУдаление = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Объект[ИмяТаблицы] Цикл
		
		Если ТекущаяСтрока[ИмяКлюча] <> ЗначениеКлюча Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиНаУдаление.Добавить(ТекущаяСтрока);
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из СтрокиНаУдаление Цикл
		Объект[ИмяТаблицы].Удалить(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТребуемоеДействиеСтрокиТовара(СтрокаТовара)
	
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТовара.ТребуемоеДействие = "";
	
	// Блок 1 - Требуемые действия ведения пользователя за ручку по номенклатуре
	
	Если Не СтрокаТовара.Учитывать Тогда
		СтрокаТовара.ТребуемоеДействие = "Не учитывается";
		Возврат;
	КонецЕсли;
	
	// Для исходящих одни требуемые действия, а для исходящих другие
	Если ТекущийСтатус <> ПредопределенноеЗначение("Перечисление.КонтурЛогистика_СтатусыТитулов.Получен") Тогда
		
		Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда 
			// эти требуемые действия блока 1 не являются блокирующими по документу - они только ведут пользователя
			Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
				СтрокаТовара.ТребуемоеДействие = "Указать Номенклатуру";
				
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовара.УпаковкаЕдиницаИзмерения) Тогда
				СтрокаТовара.ТребуемоеДействие = "Указать Единицу измерения";
				
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовара.Количество) Тогда
				СтрокаТовара.ТребуемоеДействие = "Указать Количество";
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТовара.КоличествоМест) Тогда
				
				Если КонтурЛогистика_ОбщегоНазначенияКлиентПовтИсп.ЗначениеНастройки("ТребоватьНаличиеБазовыхСоответствий") Тогда
					СтрокаТовара.ТребуемоеДействие = "Установить соответствие";
				Иначе
					СтрокаТовара.ТребуемоеДействие = "Заполнить обязательные поля";
				КонецЕсли;
				
			Иначе
				СтрокаТовара.ТребуемоеДействие = "Готов";
			КонецЕсли;
			
		Иначе
			
			Если СтрокаТовара.КартинкаОшибок = 2 Тогда
				СтрокаТовара.ТребуемоеДействие = "Заполнить обязательные поля";
			Иначе
				СтрокаТовара.ТребуемоеДействие = "Готов";
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			СтрокаТовара.ТребуемоеДействие = "Сопоставить";
		Иначе
			СтрокаТовара.ТребуемоеДействие = "ОК";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

