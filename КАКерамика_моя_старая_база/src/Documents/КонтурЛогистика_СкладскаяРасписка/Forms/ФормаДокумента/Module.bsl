&НаКлиенте
Процедура СведенияПоТовару_СтранаПроисхожденияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрокиТоваров = ТекущиеДанные.ИдентификаторСтроки;
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтран = Новый Массив;
	ОтборПоСтрокеТоваров = Новый Структура("ИдентификаторСтрокиТоваров", ИдентификаторСтрокиТоваров);
	
	Для Каждого СтрокаСтраны Из Объект.СтраныПроисхожденияПродукции.НайтиСтроки(ОтборПоСтрокеТоваров) Цикл
		
		Если ЗначениеЗаполнено(СтрокаСтраны.Страна) Тогда
			МассивСтран.Добавить(СтрокаСтраны.Страна);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторСтрокиТоваров", ИдентификаторСтрокиТоваров);
	ПараметрыФормы.Вставить("МассивСтран", МассивСтран);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Справочник.КонтурЛогистика_СтраныМира.Форма.ФормаВыбораСтранПроисхождениеПродукции",
		ПараметрыФормы,
		ЭтаФорма,
		ЭтаФорма,
		"ПослеВыбораСтран");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСтран(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрокиТоваров = Результат.Идентификатор;
	ОтборПоСтрокеТоваров = Новый Структура("ИдентификаторСтрокиТоваров", ИдентификаторСтрокиТоваров);
	СтрокиКУдалению = Объект.СтраныПроисхожденияПродукции.НайтиСтроки(ОтборПоСтрокеТоваров);
	
	Для Каждого СтрокаСтраны Из СтрокиКУдалению Цикл
		Объект.СтраныПроисхожденияПродукции.Удалить(СтрокаСтраны);
	КонецЦикла;
	
	Для Каждого Страна Из Результат.МассивСтран Цикл
		
		НоваяСтрока = Объект.СтраныПроисхожденияПродукции.Добавить();
		НоваяСтрока.ИдентификаторСтрокиТоваров = ИдентификаторСтрокиТоваров;
		НоваяСтрока.Страна = Страна;
		
	КонецЦикла;
	
	СведенияПоТовару_СтранаПроисхождения = КонтурЛогистика_ОбщегоНазначенияКлиент.РассчитатьПредставлениеСтран(
		Объект.СтраныПроисхожденияПродукции, ИдентификаторСтрокиТоваров);
	
	ПроверитьДокумент();
	
КонецПроцедуры

