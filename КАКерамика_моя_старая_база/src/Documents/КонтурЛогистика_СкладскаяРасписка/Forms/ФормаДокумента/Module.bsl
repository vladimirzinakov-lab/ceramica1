&НаКлиенте
Процедура ПереключательРасшифровкиПриИзменении(Элемент)
	
	Если Не ПереключательУсловияПриема Тогда
		Если Объект.УсловияПриемаГрХран.Количество() = 0 Тогда
			НоваяСтрока = Объект.УсловияПриемаГрХран.Добавить();
			Элементы.УсловияПриемаГрХран.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		ИначеЕсли Объект.УсловияПриемаГрХран.Количество() = 1 Тогда
			Если Элементы.УсловияПриемаГрХран.ТекущаяСтрока = Неопределено Тогда
				Элементы.УсловияПриемаГрХран.ТекущаяСтрока = Объект.УсловияПриемаГрХран[0].ПолучитьИдентификатор();
			КонецЕсли;
		ИначеЕсли Объект.УсловияПриемаГрХран.Количество() > 1 Тогда
			ОчиститьСообщения();
			ТекстСообщения = "Переключение в режим без разбиения невозможно, если в условиях хранения введено более одной строки!";
			Сообщить(ТекстСообщения);
			ПереключательУсловияПриема = 1;
		КонецЕсли;
	КонецЕсли;
	
	УправлениеВидимостьюИДоступностью();
	
КонецПроцедуры

&НаКлиенте
Процедура ПЭ_Титул1ПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ПЭ_Титул1) Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоПоручениюЗавершение", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Вы уверены, что хотите перезаполнить документ?", РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПоручениюЗавершение(Ответ, ДополнительынеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполниьТитулПоПЭТитул1();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПЭ_Титул1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Состояние", СостояниеПЭЗавершено());
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
	
	КонтурЛогистика_ОбщегоНазначенияКлиент.ОткрытьФорму_Подсистемы(
		"Документ.КонтурЛогистика_ПЭ_Титул1.Форма.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма, ЭтаФорма,
		"ПЭ_Титул1НачалоВыбораЗавершение",, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПЭ_Титул1НачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.ПЭ_Титул1 = Результат;
		ЗаполниьТитулПоПЭТитул1();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЕстьЗамечанияПриИзменении(Элемент)
	
	Если ЕстьЗамечания Тогда
		СостояниеГруза = "";
	Иначе
		СостояниеГруза = ТекстЗамечанияПоГрузунет();
	КонецЕсли;
	
	Элементы.СостояниеГруза.Видимость = ЕстьЗамечания;
	
	Если Объект.УсловияПриемаГрХран.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	Объект.УсловияПриемаГрХран[0].СостояниеГруза = СостояниеГруза;
	
	ПроверитьДокумент();
	
КонецПроцедуры

