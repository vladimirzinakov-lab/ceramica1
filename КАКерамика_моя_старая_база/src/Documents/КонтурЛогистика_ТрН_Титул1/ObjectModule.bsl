#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ДокументЭТРН.kl_id)) Тогда // еще не зарегистрированный в сервисе
		РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьЧерновикДляНовогоДокумента(Ссылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЭТРН.ЗаказЗаявкаОснование) Тогда
		СтатусЗЗ = РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.ПолучитьСтатус(ДокументЭТРН.ЗаказЗаявкаОснование);
		
		Если СтатусЗЗ = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("zz-wait-enterBasedOnConsignor") 
			ИЛИ СтатусЗЗ = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("zz-completed")  Тогда
			
			РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.УстановитьСостояние(
				ДокументЭТРН.ЗаказЗаявкаОснование, "zz-enterBasedOnConsignorAfter",,, Перечисления.КонтурЛогистика_СтороныСоставители.ГО);
				
		КонецЕсли;
			
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ = Ложь
		И Не ЗначениеЗаполнено(СокрЛП(ДокументЭТРН.kl_id)) // еще не зарегистрированный в сервисе
		И Не ЗначениеЗаполнено(ДокументЭТРН.УИД)
		И Не КонтурЛогистика_ОбработкаДокументовСервер.ЭтоВходящийДокумент(ДополнительныеСвойства) 
		И ЗначениеЗаполнено(ДокументЭТРН.Грузоотправитель) 
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
		И ЗначениеЗаполнено(ДокументЭТРН.Грузополучатель) Тогда
		
		Организация = КонтурЛогистика_ОбщегоНазначенияСервер.ОрганизацияДляЗапросаУИДов(ЭтотОбъект);
		
		БратьУИДИзПула = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляТРН");
		
		Если БратьУИДИзПула Тогда
			
			ПолученныйУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ПолучитьОчередной(Организация);
			Если ПолученныйУИД <> Неопределено Тогда
				ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация);
			Иначе
				Сообщить("Не получен УИД из пула. Закончились?");
			КонецЕсли;
						
		Иначе
			
			// Ничего не делаем.
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ = Ложь И Не ДополнительныеСвойства.Свойство("ЭтоПропускДокумента") Тогда
		Попытка
			КонтурЛогистика_ОбработкаДокументовСервер.ПропускЗадачЭкспедиторскойЦепочки_ТРНЗЗ(ЭтотОбъект);
		Исключение
			ИмяСобытия = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИмяСобытияЖурналаРегистрации();
			ТекстОшибки = "Ошибка при пропуске задач экспедиторской цепочки. Ошибка: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, Ссылка, ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	// Подключаемый модуль (ПМ)
	ПараметрыПМ = Новый Структура("ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения", ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля("ТрН_Титул1_ПередЗаписью_После", Истина, ПараметрыПМ);
	Отказ = ?(Отказ <> ПараметрыПМ.Отказ, ПараметрыПМ.Отказ, Отказ);	// Если признак отказа был изменен в ПМ, то пробрасываем его значение
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// При вызове обработчика заполнения в обычных формах
	// в данных заполнения содержится ссылка на документ основание
	// если ДанныеЗаполнения - ссылка одного из типов ДокументаОснование
	// преобразуем ДанныеЗаполнения к структуре
	ТипЛогистика = ПредопределенноеЗначение("Перечисление.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1");
	КонтурЛогистика_ОбработкаДокументовСервер.ПреобразоватьДанныеЗаполненияДляУчетныхДокументов(ДанныеЗаполнения,
		ТипЛогистика);
	
	// а) Из документа учетной системы
	Если ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		
		ЗаполнитьПоДокОснованию(ДанныеЗаполнения);
		ЗаполнитьРеквизитыПоПользователю();
		
	// б) загружен и з сервиса, создаем из файла обмена
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.КонтурЛогистика_ФайлыОбмена") Тогда
		
		ФайлСсылка = ДанныеЗаполнения;
		ТекстФайла = ФайлСсылка.ТекстXML.Получить();
		Если СокрЛП(ТекстФайла) = "" Тогда 
			Сообщить("По файлу " + ФайлСсылка + " нет текста титула");
			Возврат;
		КонецЕсли;

		ЗаполнитьИзФайлаОбмена(ТекстФайла, ФайлСсылка);	
		
	// в) ввод на основании Заказа (заявки)
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда
		
		// TODO реализовать
		ЗаполнитьПоДокЗаказЗаявка(ДанныеЗаполнения);		
		ЗаполнитьРеквизитыПоПользователю();	
		
	// г) копирование Т1 с ЭТРН
	ИначеЕсли ДанныеЗаполнения <> Неопределено 
		И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Титул")
		И ДанныеЗаполнения.Свойство("Скопировать")
		И ДанныеЗаполнения.Скопировать Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения.Титул);
		Для каждого ТЧ Из ЭтотОбъект.Метаданные().ТабличныеЧасти Цикл
			Для каждого Стр Из ДанныеЗаполнения.Титул[ТЧ.Имя] Цикл
				НоваяСтрока = ЭтотОбъект[ТЧ.Имя].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			КонецЦикла;
		КонецЦикла;
		
		ЭтотОбъект.Номер = "";
		ЭтотОбъект.Дата = ТекущаяДатаСеанса();
		
		НовыйДокументЭТРН = ДанныеЗаполнения.Титул.ДокументЭТРН.Скопировать();
		
		НовыйДокументЭТРН.Дата = ТекущаяДатаСеанса();
		НовыйДокументЭТРН.ДатаТрН = ТекущаяДатаСеанса();
		НовыйДокументЭТРН.УИД = "";
		НовыйДокументЭТРН.kl_id = "";
		НовыйДокументЭТРН.ХешСуммаQRКода = 0;
		НовыйДокументЭТРН.СогласованоВодителемПриПогрузке = Ложь;
		НовыйДокументЭТРН.СогласованоВодителемПриВыгрузке = Ложь;
		НовыйДокументЭТРН.КомментарииВодителяПриПогрузке = "";
		НовыйДокументЭТРН.КомментарииВодителяПриВыгрузке = "";
		КонтурЛогистика_ОбработкаДокументовСервер.ДобавитьНомерКопииКНомеруДокумента(НовыйДокументЭТРН.НомерТрН, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1);
		
		НовыйДокументЭТРН.Записать();
		
		ЭтотОбъект.ДокументЭТРН = НовыйДокументЭТРН.Ссылка;		
		
	// д) ручной ввод Т1 с нуля
	Иначе
		
		Если ДанныеЗаполнения <> Неопределено 
			И ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
			И ДанныеЗаполнения.Свойство("ДокументЭТРН") 
			И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументЭТРН) Тогда
			
			ДокументЭТРН = ДанныеЗаполнения.ДокументЭТРН;
			
		КонецЕсли;
		
		КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, "");
		Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.НастройкаКонвертации) Тогда
			ЗаполнитьДефолтыРучногоЗаполненияПоНастройкеКонвертации(КонтекстНастройкиКонвертации);
		КонецЕсли;
		
		МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
		ЗаполнитьРеквизитыПоПользователю();
		
	КонецЕсли;
	
	ЗаполнитьРеквизитыКонтурEDI();
	
	ЗаполнитьПустыеЗначенияПоУмолчанию(); // после ЗаполнитьРеквизитыКонтурEDI т.к. может опираться на Партнера EDI
	
	ВыполнитьОбработчикиПартнеров();
	
	// ПМ на изменение документа
	КонтурЛогистика_ПодключаемыйМодульВызов.ОбработкаСобытияПодключаемогоМодуля(
		"ТрН_Титул1_ОбработкаЗаполнения_После",
		Истина,
		ЭтотОбъект);
	
	// Расчет особенности
	РасчетОсобенностейДокументооборота();
	
	// После EDI и обработчиков партнеров: НомераЗаказов заполняется в ЗаполнитьРеквизитыКонтурEDI
	ПеренестиOrdersInvoiceВИнформационныеПоля();
	
КонецПроцедуры

Процедура ЗаполнитьПустыеЗначенияПоУмолчанию()
	
	ЗаполнитьТелефонПереадресацииПоУмолчанию();
	
	Если ЗначениеЗаполнено(ДокументЭТРН) Тогда
		
		БылоИзменение = Ложь;
		ДокЭТРНОбъект = Неопределено;
		
		ЗаполнитьПартнеров(ДокЭТРНОбъект, БылоИзменение);
		
		ЗначенияИзГлавногоДокумента = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
											ДокументЭТРН, "МестоПогрузки.КПП, ГрузоотправительКПП, МестоДоставки.КПП, ГрузополучательКПП, ПартнерГрузополучатель");
		
		Если ЗначениеЗаполнено(ЗначенияИзГлавногоДокумента.МестоПогрузкиКПП) И Не ЗначениеЗаполнено(ЗначенияИзГлавногоДокумента.ГрузоотправительКПП) Тогда 
			// проставить КПП в главный док
			Если ДокЭТРНОбъект = Неопределено Тогда 
				ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
			КонецЕсли;
			ДокЭТРНОбъект.ГрузоотправительКПП = ЗначенияИзГлавногоДокумента.МестоПогрузкиКПП;
			БылоИзменение = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначенияИзГлавногоДокумента.МестоДоставкиКПП) И Не ЗначениеЗаполнено(ЗначенияИзГлавногоДокумента.ГрузополучательКПП) Тогда 
			// проставить КПП в главный док если это не запрещено настройкой партнера ГП: КППТочкиДоставкиВРеквизитыГП
			Если Не ЗначениеЗаполнено(ЗначенияИзГлавногоДокумента.ПартнерГрузополучатель) 
				Или КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(ЗначенияИзГлавногоДокумента.ПартнерГрузополучатель, "КППТочкиДоставкиВРеквизитыГП") = Истина Тогда  
				Если ДокЭТРНОбъект = Неопределено Тогда 
					ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
				КонецЕсли;
				ДокЭТРНОбъект.ГрузополучательКПП = ЗначенияИзГлавногоДокумента.МестоДоставкиКПП;
				БылоИзменение = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если БылоИзменение Тогда
		
			ДокЭТРНОбъект.Записать();
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПартнеров(ДокЭТРНОбъект, БылоИзменение)
	
	// ГО
	Если Не ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузоотправитель) И ЗначениеЗаполнено(ДокументЭТРН.Грузоотправитель) Тогда 
		
		Если ДокЭТРНОбъект = Неопределено Тогда 
			ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияСервер.ОпределитьПартнера(
			ДокЭТРНОбъект,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1,
			"Грузоотправитель",
			ДокументЭТРН.Грузоотправитель);
			
		Если ЗначениеЗаполнено(ДокЭТРНОбъект.ПартнерГрузоотправитель) Тогда 
			БылоИзменение = Истина;
		КонецЕсли;
			
	КонецЕсли;
	
	// ПВ
	Если Не ЗначениеЗаполнено(ДокументЭТРН.ПартнерПеревозчик) И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик) Тогда 
		
		Если ДокЭТРНОбъект = Неопределено Тогда 
			ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияСервер.ОпределитьПартнера(
			ДокЭТРНОбъект,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1,
			"Перевозчик",
			ДокументЭТРН.Перевозчик);
			
		Если ЗначениеЗаполнено(ДокЭТРНОбъект.ПартнерПеревозчик) Тогда 
			БылоИзменение = Истина;
		КонецЕсли;
			
	КонецЕсли;

	// ГП
	Если Не ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) И ЗначениеЗаполнено(ДокументЭТРН.Грузополучатель) Тогда
		
		Если ДокЭТРНОбъект = Неопределено Тогда 
			ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
		КонецЕсли;
		
		КонтурЛогистика_КонвертацияСервер.ОпределитьПартнера(
			ДокЭТРНОбъект,
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1,
			"Грузополучатель",
			ДокументЭТРН.Грузополучатель);
			
		Если ЗначениеЗаполнено(ДокЭТРНОбъект.ПартнерГрузополучатель) Тогда 
			БылоИзменение = Истина;
		Иначе
			// Приоритетнее существующие соответствия (ОпределитьПартнера);
			// по кэшу партнеров EDI - только если партнер все еще пуст
			ПартнерEDI = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.EDI_ПартнерПоДокументу(
				ДокЭТРНОбъект.ПартнерГрузополучатель,
				ДокументЭТРН.Грузополучатель);
			Если ЗначениеЗаполнено(ПартнерEDI) Тогда
				ДокЭТРНОбъект.ПартнерГрузополучатель = ПартнерEDI;
				БылоИзменение = Истина;
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;

КонецПроцедуры

// Выполняет обработчики партнеров ЭТРН по событию "После заполнения ТРНт1".
Процедура ВыполнитьОбработчикиПартнеров()
	
	Если Не ЗначениеЗаполнено(ДокументЭТРН) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияЭТРН = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта_КонтурЛогистика(
		ДокументЭТРН,
		"ПартнерГрузополучатель, ПартнерПеревозчик, ПартнерГрузоотправитель");
	
	Партнеры = Новый Массив;
	Если ЗначениеЗаполнено(ЗначенияЭТРН.ПартнерГрузополучатель) Тогда
		Партнеры.Добавить(ЗначенияЭТРН.ПартнерГрузополучатель);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначенияЭТРН.ПартнерПеревозчик) Тогда
		Партнеры.Добавить(ЗначенияЭТРН.ПартнерПеревозчик);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначенияЭТРН.ПартнерГрузоотправитель) Тогда
		Партнеры.Добавить(ЗначенияЭТРН.ПартнерГрузоотправитель);
	КонецЕсли;
	
	Если Партнеры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОбработчиков = ТаблицаОбработчиковПартнеровПослеЗаполненияТРНт1(Партнеры);
	Если ТаблицаОбработчиков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Обход в порядке партнеров: ГП -> ПВ -> ГО
	Для Каждого Партнер Из Партнеры Цикл
		
		СтрокиОбработчиков = ТаблицаОбработчиков.НайтиСтроки(Новый Структура("Партнер", Партнер));
		
		Для Каждого СтрокаОбработчика Из СтрокиОбработчиков Цикл
			
			Если Не УсловиеОбработчикаПартнераВыполнено(СтрокаОбработчика.Условие, Партнер) Тогда
				Продолжить;
			КонецЕсли;
			
			ВыполнитьТекстОбработчикаПартнера(СтрокаОбработчика.ТекстОбработкиПослеЗаполнения, Партнер);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаОбработчиковПартнеровПослеЗаполненияТРНт1(Партнеры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обработчики.Ссылка КАК Партнер,
	|	Обработчики.НомерСтроки КАК НомерСтроки,
	|	Обработчики.Условие КАК Условие,
	|	Обработчики.ТекстОбработкиПослеЗаполнения КАК ТекстОбработкиПослеЗаполнения
	|ИЗ
	|	Справочник.КонтурЛогистика_Партнеры.Обработчики КАК Обработчики
	|ГДЕ
	|	Обработчики.Ссылка В (&Партнеры)
	|	И Обработчики.Событие = &Событие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партнер,
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Партнеры", Партнеры);
	Запрос.УстановитьПараметр("Событие",
		Перечисления.КонтурЛогистика_СобытияОбработчиковПартнеров.ПослеЗаполненияТРНт1);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция УсловиеОбработчикаПартнераВыполнено(Условие, Партнер)
	
	Если Не ЗначениеЗаполнено(Условие) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		
		ПараметрыВычисления = Новый Структура;
		ПараметрыВычисления.Вставить("Объект", ЭтотОбъект);
		
		УсловиеВыполнено = КонтурЛогистика_ОбщегоНазначенияСервер.ВычислитьЗначениеВБезопасномРежиме(
			Условие,
			ПараметрыВычисления);
		
		Возврат УсловиеВыполнено = Истина;
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Ошибка вычисления условия обработчика партнера " + Строка(Партнер) + ": " + ТекстОшибки);
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

Процедура ВыполнитьТекстОбработчикаПартнера(ТекстОбработки, Партнер)
	
	Если Не ЗначениеЗаполнено(ТекстОбработки) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПараметрыВыполнения = Новый Структура;
		ПараметрыВыполнения.Вставить("Объект", ЭтотОбъект);
		ПараметрыВыполнения.Вставить("РезультатВычисления");
		
		КонтурЛогистика_ОбщегоНазначенияСервер.ВыполнитьВБезопасномРежиме(ТекстОбработки, ПараметрыВыполнения);
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Ошибка выполнения обработчика партнера " + Строка(Партнер) + ": " + ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = ТекущаяДата();
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Из док Основания

Процедура ЗаполнитьПоДокОснованию(Знач ДанныеЗаполнения)
	
	Перем ДокументЭТрНОбъект, НайденныйЭТрН, НастройкаКонвертации;
	
	Разделитель = Неопределено;
	ЭлектроннаяЗаказЗаявкаОснование = Неопределено;
	
	ДанныеЗаполнения.Свойство("Разделитель", Разделитель);
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	
	// Могли быть переданы конкретные N документов оснований а не 1
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") Тогда 
		Если ДанныеЗаполнения.Свойство("ДокументыОснования") 
			И ТипЗнч(ДанныеЗаполнения.ДокументыОснования) = Тип("Массив") Тогда
			Для Каждого ДопДокОснование Из ДанныеЗаполнения.ДокументыОснования Цикл 
				НовСтр = ДокументыОснования.Добавить();
				НовСтр.ДокументОснование = ДопДокОснование;
			КонецЦикла;
		Иначе
			НовСтр = ДокументыОснования.Добавить();
			НовСтр.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
		КонецЕсли;
	Иначе
		НовСтр = ДокументыОснования.Добавить();
		НовСтр.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	КонецЕсли;
	ДокументыОснования.Свернуть("ДокументОснование");
	
	ОчиститьТабЧасти();
	
	// Определим настройку конвертации
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		ДанныеЗаполнения.ТипЛогистика, ДанныеЗаполнения.ДокументОснование);
	
	// Особенности при вводе из заказа-заявки
	// настройка конвертации на том же документе основании что и для ЗЗт1?
	Если Не КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
		
		Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
			И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование.ДокументОснование) Тогда
			
			ЭлектроннаяЗаказЗаявкаОснование = ДанныеЗаполнения.ДокументОснование;
			КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				ДанныеЗаполнения.ТипЛогистика, ДанныеЗаполнения.ДокументОснование.ДокументОснование);
			
		ИначеЕсли ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2")
			И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование.ДокументОснование) Тогда
			
			ЭлектроннаяЗаказЗаявкаОснование = ДанныеЗаполнения.ДокументОснование.Титул1;
			КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
				ДанныеЗаполнения.ТипЛогистика, ДанныеЗаполнения.ДокументОснование.Титул1.ДокументОснование);
			
		КонецЕсли;
		
		Если КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
			
			ДокументОснование = ДанныеЗаполнения.ДокументОснование.ДокументОснование;
			Для Каждого СтрДокОсн Из ДокументыОснования Цикл
				СтрДокОсн.ДокументОснование = СтрДокОсн.ДокументОснование.ДокументОснование;
			КонецЦикла;
			
		Иначе
			
			Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1")
				Или ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
				
				ЗаполнитьПоДокЗаказЗаявка(ДанныеЗаполнения.ДокументОснование);
			Иначе
				Сообщить("Не найдена настройка конвертации по " + ДанныеЗаполнения.ДокументОснование
					+ ". Проверьте настройки конвертации документов");
			КонецЕсли;
			
			ЗаполнитьРеквизитыПоПользователю();
			
		КонецЕсли;
		
	Иначе
		
		// Поискать Эл Заказ Заявку с тем же основанием
		НайденныеЗаказЗаявки = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитулыПоДокументамОснованиям(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, ДанныеЗаполнения.ДокументОснование);
		Если НайденныеЗаказЗаявки.Количество() = 0 Тогда
			СвязанныеОснования = КонтурЛогистика_КонвертацияТиповые.СвязанныеОснованияДляПоискаЭЗЗ(
				ДанныеЗаполнения.ДокументОснование);
			НайденныеЗаказЗаявки = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитулыПоДокументамОснованиям(
				Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1, СвязанныеОснования);
			Если НайденныеЗаказЗаявки.Количество() <> 0 Тогда
				ЭлектроннаяЗаказЗаявкаОснование = ВыбратьВалидныйДокументЗаказЗаявки(НайденныеЗаказЗаявки);
			КонецЕсли;
		Иначе
			ЭлектроннаяЗаказЗаявкаОснование = ВыбратьВалидныйДокументЗаказЗаявки(НайденныеЗаказЗаявки);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не КонтекстНастройкиКонвертации.ЕстьКонвертация Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтекстНастройкиКонвертации.ПоискОснованийКодНа1С)
		И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользуютсяМногиеКОдному") Тогда 
		
		// Вычислить массив оснований
		Попытка
			МассивДокументыОснования = Новый Массив;
			Выполнить(КонтекстНастройкиКонвертации.ПоискОснованийКодНа1С);
			Для Каждого ДопДокОснование Из МассивДокументыОснования Цикл 
				НовСтр = ДокументыОснования.Добавить();
				НовСтр.ДокументОснование = ДопДокОснование;
			КонецЦикла;
			
			ДокументыОснования.Свернуть("ДокументОснование");
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Если КонтекстНастройкиКонвертации.ЕстьНастройкаКонвертации Тогда
		Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
			ЭтотОбъект, ДокументОснование, КонтекстНастройкиКонвертации.НастройкаКонвертации, "");
	Иначе
		Переменные = Неопределено;
	КонецЕсли;
	
	// ДокументЭТрН потребуется создать(найти) и записать в базу.
	ПерезаполнитьГлавныйДокумент = (ДанныеЗаполнения.Свойство("ПерезаполнитьГлавныйДокументЕслиСуществует")
		И ДанныеЗаполнения.ПерезаполнитьГлавныйДокументЕслиСуществует);
	
	// Найдем главный документ
	// ДокументЭТрН потребуется создать(найти) и записать в базу если он еще не указан в титуле.
	Если ЗначениеЗаполнено(ДокументЭТРН) Тогда
		НайденныГлавныйДокумент = ДокументЭТРН;
	Иначе
		НайденныГлавныйДокумент = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоДокументуУчетнойСистемы(
			ДокументОснование, КонтекстНастройкиКонвертации, Разделитель, ЭтотОбъект, Переменные);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныГлавныйДокумент) Тогда
		
		ДокументЭТРН = НайденныГлавныйДокумент;
		
		Если ПерезаполнитьГлавныйДокумент Тогда
			ДокументЭТрНОбъект = ДокументЭТРН.ПолучитьОбъект();
		КонецЕсли;
		
	Иначе
		
		ПерезаполнитьГлавныйДокумент = Истина;
		
		ДокументЭТрНОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
		Если Разделитель <> Неопределено Тогда
			ДокументЭТрНОбъект.Разделитель = Разделитель;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗЗТитул2 = Неопределено;
	
	Если ПерезаполнитьГлавныйДокумент Тогда
		
		// Заполним главный по настройке
		КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьГлавныйДокументПоДокументуУчетнойСистемы(
			ДокументЭТрНОбъект, ДокументОснование, КонтекстНастройкиКонвертации, Переменные);
				
		// Проставить ЭЗЗ если он не заполнен и его удалось вычислить, взять часть реквизитов для главного документа
		УнаследоватьЧастьДанныхИзЗЗДляГлавногоДокумента(ДокументЭТрНОбъект, ЭлектроннаяЗаказЗаявкаОснование, ЗЗТитул2);
		
		// Заполним реквизитами по умолчанию
		ЗаполнитьРеквизитыЭТРНПоУмолчанию(ДокументЭТрНОбъект);
		
		ДокументЭТрНОбъект.Записать();
		ДокументЭТРН = ДокументЭТрНОбъект.Ссылка;
		
	КонецЕсли;
	
	// Заполнить ЭтотТитул
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
		ЭтотОбъект, КонтекстНастройкиКонвертации, Переменные);
		
	// Взять часть реквизитов из ЭЗЗ для титула
	УнаследоватьЧастьДанныхИзЗЗДляТитула(ДокументЭТРН.ЗаказЗаявкаОснование, ЗЗТитул2);
	
	// Заполним водителей по умолчанию
	Если ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.ВодительПоУмолчанию)
		И Не ЗначениеЗаполнено(Водитель) Тогда
		
		Водитель = ДокументЭТРН.Перевозчик.ВодительПоУмолчанию;
		
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.Водитель2ПоУмолчанию)
		И Не ЗначениеЗаполнено(Водитель2) Тогда
		
		Водитель2 = ДокументЭТРН.Перевозчик.Водитель2ПоУмолчанию;
		
	КонецЕсли;
	
	// Заполнить метод определения массы из настроек
	Если Не ЗначениеЗаполнено(МетодОпределенияМассы) Тогда
		МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
	КонецЕсли;
	
	РассчитатьАвтоитогиМестИМассы();
	
	Если ЗначениеЗаполнено(ОтправительШаблона) Тогда
		НовыйПолучатель = ДополнительныеПолучателиФайла.Добавить();
		НовыйПолучатель.ОрганизацияДиадок = ОтправительШаблона;
	КонецЕсли;
	
	ДобавитьСоставителяИЗаказчикаЭкспедицииВДопПолучатели();
	
	ПоложитьИдентификаторыЕГАИСВСведенияГосСистем();
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ОбновитьСтатусГотовностиЭПДУчастниковПеревозки(ЭтотОбъект);
	
КонецПроцедуры

Функция ВыбратьВалидныйДокументЗаказЗаявки(НайденныеЗаказЗаявки)
	
	Для Каждого ТекущаяЗаказЗаявка Из НайденныеЗаказЗаявки Цикл
		
		ТекущийСтатусЗаказЗаявки = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ТекущаяЗаказЗаявка);
		Если ТекущийСтатусЗаказЗаявки = Перечисления.КонтурЛогистика_СтатусыТитулов.Пропущен
			Или ТекущийСтатусЗаказЗаявки = Перечисления.КонтурЛогистика_СтатусыТитулов.Удален Тогда
			
			Продолжить;
		КонецЕсли;
		
		Возврат ТекущаяЗаказЗаявка;
		
	КонецЦикла;
	
КонецФункции

Процедура ДобавитьСоставителяИЗаказчикаЭкспедицииВДопПолучатели()
	
	Перем НовСтрДопПолучателей, НовыйПолучатель, ЭкспедицияЗаказчик, ЭкспедицияЗаказчикНайденный;
	
	Если ЗначениеЗаполнено(Составитель)
		И Не Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ЯвляетсяУчастникомПеревозки(Составитель, ДокументЭТРН) Тогда
		
		// добавим составителя в доп. получатели (он не является стороной перевозки)
		НовыйПолучатель = ДополнительныеПолучателиФайла.Добавить();
		НовыйПолучатель.ОрганизацияДиадок = Составитель;
		ЭтоПрототип = Истина;
		
	КонецЕсли;
	
	ЭкспедицияЗаказчик = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПолучитьЗаказчикаЭкспедиции(ДокументЭТРН);
	Если ЭкспедицияЗаказчик <> Неопределено Тогда
		
		ЭкспедицияЗаказчикНайденный = ДополнительныеПолучателиФайла.Найти(ЭкспедицияЗаказчик, "ОрганизацияДиадок");
		Если ЭкспедицияЗаказчикНайденный = Неопределено
			И Не Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ЯвляетсяУчастникомПеревозки(ЭкспедицияЗаказчик, ДокументЭТРН) Тогда
			
			// добавим заказчика в доп. получатели (он не является стороной перевозки)
			НовСтрДопПолучателей = ДополнительныеПолучателиФайла.Добавить();
			НовСтрДопПолучателей.ОрганизацияДиадок = ЭкспедицияЗаказчик;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УнаследоватьЧастьДанныхИзЗЗДляГлавногоДокумента(ДокументЭТрНОбъект, Знач ЭлектроннаяЗаказЗаявкаОснование, ЗЗТитул2)
	
	Перем ПунктМаршрута;
	
	Если ЗначениеЗаполнено(ЭлектроннаяЗаказЗаявкаОснование)
		И Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ЗаказЗаявкаОснование) Тогда
		
		ДокументЭТрНОбъект.ЗаказЗаявкаОснование = ЭлектроннаяЗаказЗаявкаОснование;
		ДокументЭТрНОбъект.НомЗак     = ЭлектроннаяЗаказЗаявкаОснование.НомЗак;
		ДокументЭТрНОбъект.ДатаЗак    = ЭлектроннаяЗаказЗаявкаОснование.ДатаЗак;
				
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.МестоПогрузки) Тогда 
			ДокументЭТрНОбъект.МестоПогрузки = ЭлектроннаяЗаказЗаявкаОснование.ПунктПод;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.МестоДоставки) Тогда 
			Для Каждого ПунктМаршрута Из ЭлектроннаяЗаказЗаявкаОснование.АдрПункт Цикл  //последний пункт выгрузки - место доставки
				Если ПунктМаршрута.Выгрузка Тогда 
					ДокументЭТрНОбъект.МестоДоставки = ПунктМаршрута.ПунктМаршрута;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// найти Титул2 ЗЗ, оттуда берем ТС и прицеп, если они не указаны
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ТранспортноеСредство)
			ИЛИ Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Прицеп) Тогда
			
			ЗЗТитул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЗЗтитул2(ЭлектроннаяЗаказЗаявкаОснование);
			Если ЗначениеЗаполнено(ЗЗТитул2) Тогда
				Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ТранспортноеСредство) Тогда
					ДокументЭТрНОбъект.ТранспортноеСредство = ЗЗТитул2.ТранспортноеСредство;
				КонецЕсли;
				Если ДокументЭТрНОбъект.ТранспортноеСредство = ЗЗТитул2.ТранспортноеСредство
					И Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Прицеп) Тогда
					
					Если ЗЗТитул2.Прицепы.Количество() > 0 Тогда
						ДокументЭТрНОбъект.Прицеп = ЗЗТитул2.Прицепы[0].Прицеп;
					КонецЕсли; 
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УнаследоватьЧастьДанныхИзЗЗДляТитула(Знач ЭлектроннаяЗаказЗаявкаОснование, ЗЗТитул2)
	
	Перем ПунктМаршрута;
	
	Если ЗначениеЗаполнено(ЭлектроннаяЗаказЗаявкаОснование) Тогда
		
		Если Не ЗначениеЗаполнено(ДатаВремяПодачиПлановая) Тогда 
			ДатаВремяПодачиПлановая = ЭлектроннаяЗаказЗаявкаОснование.ДатВрПод;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДатаВремяПрибытия) Тогда 
			ДатаВремяПрибытия = ЭлектроннаяЗаказЗаявкаОснование.ДатВрПод;
		КонецЕсли;
		
		// найти Титул2 ЗЗ, оттуда берем водителей, если они не указаны
		Если Не ЗначениеЗаполнено(Водитель)
			Или Не ЗначениеЗаполнено(Водитель2) Тогда
			
			Если Не ЗначениеЗаполнено(ЗЗТитул2) Тогда
				ЗЗТитул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЗЗтитул2(ЭлектроннаяЗаказЗаявкаОснование);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗЗТитул2) Тогда
				Если Не ЗначениеЗаполнено(Водитель) И ЗЗТитул2.Водители.Количество() > 0 Тогда 
					Водитель = ЗЗТитул2.Водители[0].СвВодит;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Водитель2) И ЗЗТитул2.Водители.Количество() > 1 Тогда 
					Водитель2 = ЗЗТитул2.Водители[1].СвВодит;	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура РассчитатьАвтоитогиМестИМассы()
	
	Перем НайденныеСтроки, ТекущаяСтрока;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест") Тогда
		КоличествоМест = 0;
		НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			КоличествоМест = КоличествоМест + ТекущаяСтрока.КоличествоМест;
		КонецЦикла;
	КонецЕсли;
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто") Тогда
		МассаБруттоКг = 0;
		НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Учитывать", Истина));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			МассаБруттоКг = МассаБруттоКг + ТекущаяСтрока.МассаПлановаяБруттоКг;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьТабЧасти()
	
	Товары.Очистить();
	Маркировки.Очистить();
	ОпасныеГрузы.Очистить();
	Контейнеры.Очистить();
	ТелефоныПереадресующего.Очистить();
	ДополнительныеВодители.Очистить();
	СведенияГосСистем.Очистить();
	ИнфПол.Очистить();
	ОтметкиГрузоотправителя.Очистить();
	Акты.Очистить();
	Штрафы.Очистить();
	СпецУслДвиж.Очистить();
	ДополнительныеПолучателиФайла.Очистить();
	СопроводительныеДокументы.Очистить();
	ОтметкиИнфПол.Очистить();

КонецПроцедуры

Процедура ЗаполнитьРеквизитыЭТРНПоУмолчанию(ДокументЭТрНОбъект)
	
	Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Перевозчик) Тогда
		Возврат;
	КонецЕсли;
	
	ТранспортноеСредствоПоУмолчанию = ДокументЭТрНОбъект.Перевозчик.ТранспортноеСредствоПоУмолчанию;
	
	Если Не ЗначениеЗаполнено(ТранспортноеСредствоПоУмолчанию) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.ТранспортноеСредство) Тогда
		ДокументЭТрНОбъект.ТранспортноеСредство = ТранспортноеСредствоПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТранспортноеСредствоПоУмолчанию.ПрицепПоУмолчанию) Тогда
		
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Прицеп) Тогда
			ДокументЭТрНОбъект.Прицеп = ТранспортноеСредствоПоУмолчанию.ПрицепПоУмолчанию;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТранспортноеСредствоПоУмолчанию.Прицеп2ПоУмолчанию) Тогда
		
		Если Не ЗначениеЗаполнено(ДокументЭТрНОбъект.Прицеп2) Тогда
			ДокументЭТрНОбъект.Прицеп2 = ТранспортноеСредствоПоУмолчанию.Прицеп2ПоУмолчанию;
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументЭТрНОбъект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьТелефонПереадресацииПоУмолчанию()
	
	Если ТелефоныПереадресующего.Количество() = 0 Тогда
		
		ТелефоныПА = Новый Массив;
		Если ЗначениеЗаполнено(ДокументЭТрН.Грузоотправитель) 
			И (ЭтотОбъект.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель
			Или ЭтотОбъект.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.ПустаяСсылка()) Тогда
			// дефолтное заполнение этого реквизита из свойства ЗначениеЗаполнения реквизита ИнициаторПереадресации
			// произойдет после обработки заполнения и туда будет подставлено значение Грузоотправитель
			// поэтому тут проверим и пустую ссылку
			
			// телефоны переадресующего из ГО
			ТелефоныПА = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТелефоныПереадресующего(ДокументЭТрН.Грузоотправитель);
			
		ИначеЕсли ЗначениеЗаполнено(ДокументЭТрН.Грузополучатель) 
			И ЭтотОбъект.ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузополучатель Тогда
			
			// телефоны переадресующего из ГП
			
			ТелефоныПА = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ТелефоныПереадресующего(ДокументЭТрН.Грузополучатель);
			
		КонецЕсли;
		
		Если ТелефоныПА.Количество() > 0  Тогда
			
			Для Каждого ТелПА из ТелефоныПА Цикл 
				СтрокаТелефонПереадр = ТелефоныПереадресующего.Добавить();
				СтрокаТелефонПереадр.Телефон = ТелПА;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиOrdersInvoiceВИнформационныеПоля()
	
	УстановитьСтрокуИнфПол("ORDERS", НомераЗаказов);
	УстановитьСтрокуИнфПол("INVOIC", НомераУПД);
	УстановитьСтрокуИнфПол("DESADV", НомераDESADV);
	
КонецПроцедуры

Процедура УстановитьСтрокуИнфПол(Идентиф, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ИнфПол.Добавить();
	НоваяСтрока.Идентиф = Идентиф;
	НоваяСтрока.Значение = Значение;
	
КонецПроцедуры

Процедура ПоложитьИдентификаторыЕГАИСВСведенияГосСистем()
	
	Для Каждого ТекущаяСтрока Из Товары Цикл
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторыЕГАИС) Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторСтрокиТоваров", ТекущаяСтрока.ИдентификаторСтроки);
			Отбор.Вставить("НаимГосСист", "ЕГАИС");
					
			Найд = СведенияГосСистем.НайтиСтроки(Отбор);		
			Для каждого Стр Из Найд Цикл
				СведенияГосСистем.Удалить(Стр);	
			КонецЦикла;
			
			МассивИдентификаторыЕГАИС = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.РазделитьСтроку(ТекущаяСтрока.ИдентификаторыЕГАИС, ";", Ложь);
			
			Для каждого Идентификатор Из МассивИдентификаторыЕГАИС Цикл
				
				НоваяСтрока = СведенияГосСистем.Добавить();
				НоваяСтрока.ИдентификаторСтрокиТоваров = СокрЛП(ТекущаяСтрока.ИдентификаторСтроки);
				НоваяСтрока.НаимГосСист = "ЕГАИС";
				НоваяСтрока.ИдНомУчетЕд = СокрЛП(Идентификатор);
							
			КонецЦикла;
			
			ТекущаяСтрока.УчетГрузаВГИС = Истина; 
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДефолтыРучногоЗаполненияПоНастройкеКонвертации(КонтекстНастройкиКонвертации)
	
	Перем ДокументЭТрНОбъект, НайденныйЭТрН;
	
	Разделитель = Неопределено;
	ДокументОснование = Неопределено;
	
	Контейнеры.Очистить();
	ТелефоныПереадресующего.Очистить();
	ОтметкиГрузоотправителя.Очистить();
	СпецУслДвиж.Очистить();
	ДополнительныеПолучателиФайла.Очистить();
	СопроводительныеДокументы.Очистить();
	
	НастройкаКонвертации = КонтекстНастройкиКонвертации.НастройкаКонвертации;
	
	Переменные = КонтурЛогистика_КонвертацияСервер.ДвижокКонвертации_ВычислитьПеременные(
		ЭтотОбъект, ДокументОснование, НастройкаКонвертации, "");
	
	КонтурЛогистика_КонвертацияСервер.ЗаполнитьЭТРНПриРучномВводе(ЭтотОбъект, ДокументОснование, НастройкаКонвертации, Переменные);
	
	// Заполнить ЭтотТитул
	КонтурЛогистика_ОбработкаДокументовСервер.ЗаполнитьДокументТитулПоДокументуУчетнойСистемы(
		ЭтотОбъект, КонтекстНастройкиКонвертации, Переменные);
	
	// Заполнить метод определения массы из настроек
	Если Не ЗначениеЗаполнено(МетодОпределенияМассы) Тогда
		МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
	КонецЕсли;
	
	РассчитатьАвтоитогиМестИМассы();
	
	Если ЗначениеЗаполнено(ОтправительШаблона) Тогда
		НовыйПолучатель = ДополнительныеПолучателиФайла.Добавить();
		НовыйПолучатель.ОрганизацияДиадок = ОтправительШаблона;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Составитель) Тогда
		НовыйПолучатель = ДополнительныеПолучателиФайла.Добавить();
		НовыйПолучатель.ОрганизацияДиадок = Составитель;
		ЭтоПрототип = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура СконвертироватьСтрокуТоваров1СвЛогистика(НомерСтроки, НастройкаКонвертацииДляРучногоВввода = Неопределено) Экспорт
	
	СтрокаТоваров = Товары.Найти(НомерСтроки, "НомерСтроки");
	
	// сформировать расширенную (с упаковками) строку товаров
	ТЗ_ТоварыВременная = Товары.ВыгрузитьКолонки(); 
	
	СтрокаТоваровВременная = ТЗ_ТоварыВременная.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТоваровВременная, СтрокаТоваров);
	
	Если ЗначениеЗаполнено(НастройкаКонвертацииДляРучногоВввода) Тогда
		КонтурЛогистика_КонвертацияСервер.ЗаполнитьСтрокуТЧТовары(СтрокаТоваровВременная, СтрокаТоваров, НастройкаКонвертацииДляРучногоВввода, , ЭтотОбъект);		
	КонецЕсли;
	
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда
		КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	КонецЕсли;
			
	// положить расширенную строку товаров обратно в ТоварыДокумента1С
	ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаТоваровВременная);
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоУмолчаниюВСтрокеТоваров(СтрокаТоваров)
	
	// если есть дефолтные значения, например в настройках
	ДефолтСпособУпаковки = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособУпаковкиПоУмолчанию", ДокументЭТРН.ПартнерГрузополучатель);
	
	Если Не ЗначениеЗаполнено(ДефолтСпособУпаковки) Тогда 
		СтрокаТоваров.СпособУпаковки = ДефолтСпособУпаковки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПоПользователю() Экспорт
	
	Попытка
		
		// Поиск подписанта в настройках подписания по дополнительному параметру.
		Если Не ЗначениеЗаполнено(ПользовательПодписант) И ЗначениеЗаполнено(ПараметрНастроекПодписания) Тогда
			ОрганизацияПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ОрганизацияДляПолученияНастроекПодписания(ДокументЭТРН);
			
			ДанныеПодписанта = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
				ОрганизацияПодписанта,,, ЭтотОбъект, ПараметрНастроекПодписания);
			
			ПользовательПодписант = ДанныеПодписанта.Пользователь1С;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПользовательПодписант) Тогда 
			ПользовательПодписант = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;	
			
		// TODO дефолты, зависящие от Пользователя
		
	Исключение
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ЗаполнитьРеквизитыПоПользователю", ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

Функция ИспользуетсяРазделениеДокументаОснования()
	
	Если ЗначениеЗаполнено(ДокументЭТРН.Разделитель) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДокументОснованиеДляПроверки = ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументОснованиеДляПроверки)
		И ДокументыОснования.Количество() > 0 Тогда
		ДокументОснованиеДляПроверки = ДокументыОснования[0].ДокументОснование;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснованиеДляПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ДокументОснованиеДляПроверки);
	
	Возврат ЗначениеЗаполнено(КонтекстНастройкиКонвертации.Разделитель)
		И КонтекстНастройкиКонвертации.Разделитель <> Перечисления.КонтурЛогистика_ВариантыРазделителя.НеРазделять;
	
КонецФункции

Процедура ЗаполнитьРеквизитыКонтурEDI()
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
		"АвтоматическиЗаполнятьРеквизитыИзМодуляEDI") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЕстьОбъектМетаданных("Справочник.КонтурEDI_Сообщения") Тогда 
		Возврат;
	КонецЕсли;
	
	Попытка
		
		// Заполним реквизиты
		
		// НомераЗаказов
		// НомераDESADV
		// НомераУПД
		// ДатыЗаказов
		// ДатыDESADV
		// ДатыУПД
		// ДокументЭТРН.МестоДоставки
		// ДокументЭТРН.GLNТочкиДоставки
		// ДокументЭТРН.Грузоотправитель.GLN
		// ДокументЭТРН.Грузополучатель.GLN
		// ДокументЭТРН.ПартнерГрузополучатель
		// ДокументЭТРНОбъект.СрокДоставки
		// ДокументЭТРНОбъект.ДатаВремяДоставки
		
		// розыском по справочнику КонтурEDI_Сообщения
		
		Если ЗначениеЗаполнено(ДокументОснование) 
			Или ДокументыОснования.Количество() > 0 Тогда 
			
			РазделительДокумента = Неопределено;
			Если ЗначениеЗаполнено(ДокументЭТРН) Тогда
				РазделительДокумента = ДокументЭТРН.Разделитель;
			КонецЕсли;
			
			// 0) Определить истинные док основания (на которых будут EDI сообщения)
			// 1) Получить все сведения
			ДанныеЗаполненияEDI = КонтурЛогистика_ИнтеграцияКонтурСервер.ПодготовитьДанныеЗаполненияКонтурEDI(
				РазделительДокумента, ДокументыОснования);
			ДанныеEDI = ДанныеЗаполненияEDI.ДанныеEDI;
			

			// 2) Разложить все сведения
			
			// НомераЗаказов	
			Если Не ЗначениеЗаполнено(НомераЗаказов) 
				И ДанныеEDI.НомераЗаказов.Количество() > 0 Тогда
				
				НомераЗаказов = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(ДанныеEDI.НомераЗаказов);
				
				Комментарий = СокрЛП(Комментарий + " Номер заказа EDI: " + НомераЗаказов);
				
			КонецЕсли;
			
			// НомераDESADV	
			Если Не ЗначениеЗаполнено(НомераDESADV) 
				И ДанныеEDI.НомераDESADV.Количество() > 0 Тогда
				
				НомераDESADV = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(ДанныеEDI.НомераDESADV);
				
			КонецЕсли;
			
			// НомераУПД	
			Если Не ЗначениеЗаполнено(НомераУПД) 
				И ДанныеEDI.НомераУПД.Количество() > 0 Тогда
				
				НомераУПД = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(ДанныеEDI.НомераУПД);
				
			КонецЕсли;
			
			// ДатыЗаказов
			ДатыЗаказовEDI = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(ДанныеEDI.ДатыЗаказов);
			Если Не ЗначениеЗаполнено(ДатыЗаказов)
				И ЗначениеЗаполнено(ДатыЗаказовEDI) Тогда
				
				ДатыЗаказов = ДатыЗаказовEDI;
				
			КонецЕсли;
			
			// ДатыDESADV
			ДатыDESADVEDI = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(ДанныеEDI.ДатыDESADV);
			Если Не ЗначениеЗаполнено(ДатыDESADV)
				И ЗначениеЗаполнено(ДатыDESADVEDI) Тогда
				
				ДатыDESADV = ДатыDESADVEDI;
				
			КонецЕсли;
			
			// ДатыУПД
			ДатыУПДEDI = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(ДанныеEDI.ДатыУПД);
			Если Не ЗначениеЗаполнено(ДатыУПД)
				И ЗначениеЗаполнено(ДатыУПДEDI) Тогда
				
				ДатыУПД = ДатыУПДEDI;
				
			КонецЕсли;
			
			// ДокументЭТРН.МестоДоставки / GLNТочкиДоставки
			
			Если Не ЗначениеЗаполнено(ДокументЭТРН.МестоДоставки)
				И ЗначениеЗаполнено(ДанныеEDI.ТочкаДоставки) Тогда
				
				СозданныйПунктМаршрута = КонтурЛогистика_ИнтеграцияКонтурСервер.СформироватьПунктМаршрутаИзEDI(ДанныеEDI.ТочкаДоставки);
				
				ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
				ДокументЭТРНОбъект.МестоДоставки = СозданныйПунктМаршрута;
				ДокументЭТРНОбъект.Записать();
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеEDI.ТочкаДоставки)
				И ЗначениеЗаполнено(ДанныеEDI.ТочкаДоставки.GLN)
				И Не ЗначениеЗаполнено(ДокументЭТРН.GLNТочкиДоставки) Тогда
				
				ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
				ДокументЭТРНОбъект.GLNТочкиДоставки = ДанныеEDI.ТочкаДоставки.GLN;
				ДокументЭТРНОбъект.Записать();
				
			КонецЕсли;
			
			// Проверка запрета множественности разных точек доставки
			// При разделении по НКД (например, по адресу доставки) несколько заказов EDI с разными GLN — ожидаемо
			Если ДанныеEDI.НомераЗаказов.Количество() > 1 
				И ДанныеEDI.ПодробностиМассив.Количество() > 1
				И Не ИспользуетсяРазделениеДокументаОснования() Тогда 
				
				МассивGLNТочекДоставки = Новый Массив;
				
				Для Каждого Доставка Из ДанныеEDI.ПодробностиМассив Цикл 
					Если ЗначениеЗаполнено(Доставка.ТочкаДоставки)
						И ЗначениеЗаполнено(Доставка.ТочкаДоставки.GLN)
						И МассивGLNТочекДоставки.Найти(Доставка.ТочкаДоставки.GLN) = Неопределено Тогда 
						
						МассивGLNТочекДоставки.Добавить(Доставка.ТочкаДоставки.GLN);
					КонецЕсли;
					
				КонецЦикла;
				
				Если МассивGLNТочекДоставки.Количество() > 1 Тогда 
					
					Сообщить("По сведениям EDI найдено несколько заказов с различными точками доставки. 
					|Запрещено оформлять одну ЭТРН на несколько точек доставки.");
					
				КонецЕсли;
				
			КонецЕсли;
			
			// ДокументЭТРН.Грузоотправитель.GLN
			Если ЗначениеЗаполнено(ДанныеEDI.GLNЮрлицаОтправителя)
				И Не ЗначениеЗаполнено(ДокументЭТРН.Грузоотправитель.GLN) Тогда
				
				// Проставить GLN
				ГО = ДокументЭТРН.Грузоотправитель.ПолучитьОбъект(); 
				ГО.GLN = ДанныеEDI.GLNЮрлицаОтправителя;
				
				ГО.Записать();
				
			КонецЕсли;
			
			// ДокументЭТРН.Грузополучатель.GLN
			Если ЗначениеЗаполнено(ДанныеEDI.GLNЮрлицаПолучателя)
				И Не ЗначениеЗаполнено(ДокументЭТРН.Грузополучатель.GLN) Тогда
				
				// Проставить GLN
				ГП = ДокументЭТРН.Грузополучатель.ПолучитьОбъект(); 
				ГП.GLN = ДанныеEDI.GLNЮрлицаПолучателя;
				
				ГП.Записать();
				
			КонецЕсли;
			
			// Дата и время прибытия (только пустые реквизиты ЭТРН)
			Если ЗначениеЗаполнено(ДанныеEDI.ВратаВремени) Тогда
				
				ЗаполнитьДатуВремяДоставки = Не ЗначениеЗаполнено(ДокументЭТРН.ДатаВремяДоставки);
				ЗаполнитьСрокДоставки = Не ЗначениеЗаполнено(ДокументЭТРН.СрокДоставки);
				
				Если ЗаполнитьДатуВремяДоставки Или ЗаполнитьСрокДоставки Тогда
					
					ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
					ДатаВремяВФорматеБазыДанных = МестноеВремя(ДанныеEDI.ВратаВремени, Неопределено);
					
					Если ЗаполнитьСрокДоставки Тогда
						
						// в реквизите СрокДоставки надо написать сразу целевой пояс (врата придут в UTC)
						ЧасовойПоясДоставки = КонтурЛогистика_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта_КонтурЛогистика(
							ДокументЭТРН, "МестоДоставки.ЧасовойПояс");
						Если ЗначениеЗаполнено(ЧасовойПоясДоставки) Тогда
							ПредставлениеПояса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(
								ЧасовойПоясДоставки);
							ДокументЭТРНОбъект.СрокДоставки = "Врата времени доставки: "
								+ МестноеВремя(ДанныеEDI.ВратаВремени, ЧасовойПоясДоставки) + " " + ПредставлениеПояса;
						Иначе
							ПредставлениеПояса = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ПредставлениеЧасовогоПоясаЛок(
								ЧасовойПоясСеанса());
							ДокументЭТРНОбъект.СрокДоставки = "Врата времени доставки: "
								+ ДатаВремяВФорматеБазыДанных + " " + ПредставлениеПояса;
						КонецЕсли;
						
					КонецЕсли;
					
					Если ЗаполнитьДатуВремяДоставки Тогда
						ДокументЭТРНОбъект.ДатаВремяДоставки = ДатаВремяВФорматеБазыДанных; // модуль ждет здесь время сеанса
					КонецЕсли;
					
					ДокументЭТРНОбъект.Записать();
					
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(ДанныеEDI.ДатаПоставки) Тогда
				
				Если ДанныеEDI.ДатаПоставки = НачалоДня(ДанныеEDI.ДатаПоставки) Тогда
					
					Если Не ЗначениеЗаполнено(ДокументЭТРН.СрокДоставки) Тогда
						
						ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
						ДокументЭТРНОбъект.СрокДоставки = Формат(ДанныеEDI.ДатаПоставки, "ДФ=dd.MM.yyyy");
						ДокументЭТРНОбъект.Записать();
						
					КонецЕсли;
					
				ИначеЕсли Не ЗначениеЗаполнено(ДокументЭТРН.ДатаВремяДоставки) Тогда
					
					ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
					ДокументЭТРНОбъект.ДатаВремяДоставки = МестноеВремя(ДанныеEDI.ДатаПоставки, Неопределено);
					ДокументЭТРНОбъект.Записать();
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Партнер
			Если ЗначениеЗаполнено(ДанныеEDI.Партнер)
				И Не ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) Тогда
				
				КодСети = КонтурЛогистика_ИнтеграцияКонтурСервер.EDI_ПолучитьЗначениеДополнительногоРеквизита(ДанныеEDI.Партнер, "КодСети");
				
				Если ЗначениеЗаполнено(КодСети) Тогда
					
					НайденныйПартнер = Справочники.КонтурЛогистика_Партнеры.НайтиПоРеквизиту("КодПартнераКонтур", КодСети);
					
					Если ЗначениеЗаполнено(НайденныйПартнер) Тогда
						
						ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
						ДокументЭТРНОбъект.ПартнерГрузополучатель = НайденныйПартнер;
						ДокументЭТРНОбъект.Записать();
						
					Иначе
						
						Попытка
							
							// пробуем синхронизировать партнера
							НовыйПартнер = Справочники.КонтурЛогистика_Партнеры.СоздатьЭлемент();
							ДанныеЗаполнения = Новый Структура();
							ДанныеЗаполнения.Вставить("КодПартнераКонтур", КодСети);
							ДанныеЗаполнения.Вставить("Наименование", ДанныеEDI.Партнер.Наименование);
							ДанныеЗаполнения.Вставить("ДатаОбновления", ТекущаяДатаСеанса());
							НовыйПартнер.Заполнить(ДанныеЗаполнения);
							НовыйПартнер.Записать();
							
							ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
							ДокументЭТРНОбъект.ПартнерГрузополучатель = НовыйПартнер.Ссылка;
							ДокументЭТРНОбъект.Записать();
							
						Исключение
							
						КонецПопытки;
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СообщитьХодВыполнения(
			"Проблемы при заполнении из EDI: " + ТекстОшибки);
		
		КонтурЛогистика_Метрика.ОбработатьОшибку("ИнтеграцияEDI", ТекстОшибки, ДокументОснование, ДанныеEDI, "ТРНт1_ЗаполнитьРеквизитыКонтурEDI", Истина);
		
	КонецПопытки;
	
КонецПроцедуры


//////////////////////////////////////////////////////////////////
// Из пришедшего файла XML

Процедура ЗаполнитьИзФайлаОбмена(Знач ТекстФайла, Знач ФайлСсылка)
	
	Перем XDTO, ВидТар_raw, ВодительN, ДатаВремяПодачиПлановая_raw, ДатаВремяПрибытия_raw, ДатаВремяУбытия_raw, ЗакУсл_raw, ИнициаторПереадресации_стр, й, КС, МассивОпГруз, МассивСвВодит_XDTO, МетодОпределенияМассы_raw, НайденныйДокументЭТРН, НоваяСтрокаТовара, ОбъявленнаяЦенность, ОбъявленнаяЦенность_raw, ОпГруз, ОпГруз_raw, СвВодит_XDTO, СодИнфГО, стрОбъявленнаяЦенность_raw, СтрокаДопВодителя, СтрокаТелефонаПА, ТелефонПереадресующего, ТелефоныПереадресующего_raw, ТелефоныПереадресующего_массив;
	
	Если ЗначениеЗаполнено(ФайлСсылка.ГлавныйДокумент) Тогда 
		НайденныйДокументЭТРН = ФайлСсылка.ГлавныйДокумент;
	Иначе
		НайденныйДокументЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиГлавныйДокументПоФайлу(ФайлСсылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныйДокументЭТРН) Тогда 
		
		Сообщить("При создании титула по файлу " + ФайлСсылка + "не смог найти Документ ЭТРН, создание не выполнено");
		
	Иначе
		
		ДокументЭТРН = НайденныйДокументЭТРН;
		XDTO = КонтурЛогистика_КонструкторыXDTO.ПолучитьXDTOпоXML(ТекстФайла);
		Если XDTO = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьРеквизитыТитулаИзXDTO(XDTO, СодИнфГО);
		
		ЗаполнитьТоварыИзXDTO(СодИнфГО);

		ЗаполнитьТелефоныПереадресующегоИзXDTO(СодИнфГО);
		
		КонтурЛогистика_КонструкторыXDTO.ЗаполнитьСопроводительныеДокументыИзXDTO(СодИнфГО, ЭтотОбъект);
		
		КонтурЛогистика_КонструкторыXDTO.ЗаполнитьИнфПолИзXDTO(СодИнфГО, ЭтотОбъект, "ИнфПол");
		
		ОбработатьИнфПол();
		
		// Комментарий - нет в формате минтранса // TODO есть в Диадоке - научиться доставать из ДД 
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьИнфПол()
	
	// Собираем ORDERS/DESADV/INVOIC (и даты) из ИнфПол по всем известным identifier торговых сетей.
	Для Каждого Стр Из ИнфПол Цикл
		
		ИмяРеквизита = Документы.КонтурЛогистика_ТрН_Титул1.ИмяРеквизитаEDIПоИдентификаторуИнфПол(Стр.Идентиф);
		Если ИмяРеквизита = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяРеквизита = "НомераЗаказов" Тогда
			ДобавитьЗначениеВСтрокуЧерезЗапятую(НомераЗаказов, Стр.Значение);
		ИначеЕсли ИмяРеквизита = "ДатыЗаказов" Тогда
			ДобавитьЗначениеВСтрокуЧерезЗапятую(ДатыЗаказов, Стр.Значение);
		ИначеЕсли ИмяРеквизита = "НомераDESADV" Тогда
			ДобавитьЗначениеВСтрокуЧерезЗапятую(НомераDESADV, Стр.Значение);
		ИначеЕсли ИмяРеквизита = "ДатыDESADV" Тогда
			ДобавитьЗначениеВСтрокуЧерезЗапятую(ДатыDESADV, Стр.Значение);
		ИначеЕсли ИмяРеквизита = "НомераУПД" Тогда
			ДобавитьЗначениеВСтрокуЧерезЗапятую(НомераУПД, Стр.Значение);
		ИначеЕсли ИмяРеквизита = "ДатыУПД" Тогда
			ДобавитьЗначениеВСтрокуЧерезЗапятую(ДатыУПД, Стр.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЗначениеВСтрокуЧерезЗапятую(СтрокаПриемник, ДобавляемоеЗначение)
	
	Если Не ЗначениеЗаполнено(ДобавляемоеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаПриемник) Тогда
		СтрокаПриемник = СтрокаПриемник + ", " + ДобавляемоеЗначение;
	Иначе
		СтрокаПриемник = ДобавляемоеЗначение;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыТитулаИзXDTO(Знач XDTO, СодИнфГО)
	
	Перем ВодительN, ДатаВремяПодачиПлановая_raw, ДатаВремяПрибытия_raw, ДатаВремяУбытия_raw, ИнициаторПереадресации_стр, й, МассивСвВодит_XDTO, МетодОпределенияМассы_raw, СвВодит_XDTO, СтрокаДопВодителя;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СодИнфГО = КС.XDTO_Вычислить(XDTO, "Документ.СодИнфГО");
	Если СодИнфГО = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ДатИнфГО 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ДатИнфГО"));
	ВрИнфГО 	= КС.Конвертировать_ВремяТип_вДата(КС.XDTO_Вычислить(XDTO, "Документ.ВрИнфГО"));
	
	НомИспр						= КС.XDTO_Вычислить(СодИнфГО, "ИспрТрН.НомИспр");
	ДатаИспр					= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СодИнфГО, "ИспрТрН.ДатаИспр"));
	
	СвВодит_XDTO				= КС.XDTO_Вычислить(СодИнфГО, "СвВодит");
	МассивСвВодит_XDTO         	= КС.XDTO_ВычислитьМассивXDTO(СвВодит_XDTO);
	
	Если МассивСвВодит_XDTO.Количество() > 0 Тогда // в черновике может не быть водителей
		// первый водитель
		Водитель 					= КС.Конвертировать_СвВодит_вВодителяЛогистика(МассивСвВодит_XDTO[0]);
		
		// второй водитель
		Если МассивСвВодит_XDTO.Количество() > 1 Тогда 
			Водитель2 				= КС.Конвертировать_СвВодит_вВодителяЛогистика(МассивСвВодит_XDTO[1]);
		КонецЕсли;
		
		// 3,4... водители
		Если МассивСвВодит_XDTO.Количество() > 2 Тогда
			
			Для й = 2 По МассивСвВодит_XDTO.Количество() Цикл 
				ВодительN	= КС.Конвертировать_СвВодит_вВодителяЛогистика(МассивСвВодит_XDTO[й-1]);
				СтрокаДопВодителя = ДополнительныеВодители.Добавить();
				СтрокаДопВодителя.Водитель = ВодительN;
			КонецЦикла;
			
		КонецЕсли;
	
		ПутевойЛистНомер			= КС.XDTO_Вычислить(МассивСвВодит_XDTO[0], "ПутевойЛист.НомерДок");
		ПутевойЛистДата				= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(МассивСвВодит_XDTO[0], "ПутевойЛист.ДатаДок"));
	
	КонецЕсли;
	
	ИнициаторПереадресации_стр	= КС.XDTO_Вычислить(СодИнфГО, "УказГО.СвПА.ЛицоПА");
	Если ИнициаторПереадресации_стр = "Грузополучатель" Тогда 
		ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузополучатель;
	Иначе
		ИнициаторПереадресации = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель;
	КонецЕсли;
	
	ДатаВремяПодачиПлановая_raw	= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.ЗаявПогр");
	ДатаВремяПодачиПлановая		= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(ДатаВремяПодачиПлановая_raw);
	
	ДатаВремяПрибытия_raw		= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.ФДатВрПриб");
	ДатаВремяПрибытия			= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(ДатаВремяПрибытия_raw);
	
	ДатаВремяУбытия_raw			= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.ФДатВрУбыт");
	ДатаВремяУбытия				= КС.Конвертировать_ДатаВремяВЗТип_вДатаВремяСеанса(ДатаВремяУбытия_raw);
	Попытка
		МассаБруттоКг             	= КС.XDTO_ВычислитьЧисло(СодИнфГО, "СвПогруз.МасБрутОтгр");
	Исключение
	    // формат допускает что там будет строка, что с этим делать ¯\_(ツ)_/¯ 
	КонецПопытки;
	МетодОпределенияМассы_raw  	= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.МетОпрМасс");
	МетодОпределенияМассы		= Перечисления.КонтурЛогистика_МетодыОпределенияМассы.ЗначениеИзXDTO(МетодОпределенияМассы_raw);
	
	КоличествоМест             	= КС.XDTO_ВычислитьЧисло(СодИнфГО, "СвПогруз.КолМестПрием");				
	
	// Подписант - для полученных титул1 не заполняем
	
	ПерегрузкаЗапрещена			= КС.XDTO_Вычислить(СодИнфГО, "УказГО.ЗапрПерегруз") = "1";
	
	УказанияВОтношенииНормПеревозки  = КС.XDTO_Вычислить(СодИнфГО, "УказГО.УкНормПрвз");
	
	СведенияОПломбах			= КС.XDTO_Вычислить(СодИнфГО, "УказГО.СвПломба");
	ОграничениеСкорости			= КС.XDTO_Вычислить(СодИнфГО, "УказГО.ОгрСкор");
	ТемператураНеНиже			= КС.XDTO_Вычислить(СодИнфГО, "УказГО.КлимРеж.ТемпНеНиже");
	ТемператураНеВыше			= КС.XDTO_Вычислить(СодИнфГО, "УказГО.КлимРеж.ТемпНеВыше");
	ВлажностьНеНиже				= КС.XDTO_Вычислить(СодИнфГО, "УказГО.КлимРеж.ВлажнНеНиже");
	ВлажностьНеВыше				= КС.XDTO_Вычислить(СодИнфГО, "УказГО.КлимРеж.ВлажнНеВыше");
	
	СостояниеТары				= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.ФСостТар");
	СостояниеУпаковки			= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.ФСостУп");
	СостояниеКузова				= КС.XDTO_Вычислить(СодИнфГО, "СвПогруз.ФСостКуз");
	
	// ОтметГП
	ЗаполнитьОтметкиГО(СодИнфГО); // втч Штрафы, Акты
	
	// ИдПолИной
	КС.ЗаполнитьДополнительныхПолучателей(XDTO, ЭтотОбъект);

КонецПроцедуры

Процедура ЗаполнитьТелефоныПереадресующегоИзXDTO(Знач СодИнфГО)
	
	Перем СтрокаТелефонаПА, ТелефонПереадресующего, ТелефоныПереадресующего_raw, ТелефоныПереадресующего_массив;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	ТелефоныПереадресующего_raw     = КС.XDTO_Вычислить(СодИнфГО, "УказГО.СвПА.КонтПА.Тлф");
	Если ТипЗнч(ТелефоныПереадресующего_raw) = Тип("Строка") Тогда 
		
		СтрокаТелефонаПА = ТелефоныПереадресующего.Добавить();
		СтрокаТелефонаПА.Телефон = ТелефоныПереадресующего_raw;
		
	Иначе
		ТелефоныПереадресующего_массив = КС.XDTO_ВычислитьМассивXDTO(ТелефоныПереадресующего_raw);
		Для Каждого ТелефонПереадресующего Из ТелефоныПереадресующего_массив Цикл 
			
			СтрокаТелефонаПА = ТелефоныПереадресующего.Добавить();
			СтрокаТелефонаПА.Телефон = ТелефонПереадресующего;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОтметкиГО(Знач СодИнфГО)
	
	ОтметкиГрузоотправителя.Очистить();
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	XDTO_ОтметГО = КС.XDTO_ВычислитьМассивXDTO(КС.XDTO_Вычислить(СодИнфГО, "ОтметГО"));
	
	Для Каждого XDTO_ОтметкаГО Из XDTO_ОтметГО Цикл 
		
		НоваяСтрокаОтметки = ОтметкиГрузоотправителя.Добавить();
		
		КС.ЗаполнитьСтрокуОтметкиИзXDTO(XDTO_ОтметкаГО, НоваяСтрокаОтметки, ЭтотОбъект);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТоварыИзXDTO(Знач СодИнфГО)
	
	Перем ВидТар_raw, ЗакУсл_raw, МассивОпГруз, НоваяСтрокаТовара, ОпГруз, ОпГруз_raw, стрОбъявленнаяЦенность_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	Товары.Очистить();
	
	ОпГруз_raw 					= КС.XDTO_Вычислить(СодИнфГО, "СвГруз.ОпГруз");
	МассивОпГруз 				= КС.XDTO_ВычислитьМассивXDTO(ОпГруз_raw);
	Для Каждого ОпГруз из МассивОпГруз Цикл 
		
		НоваяСтрокаТовара = Товары.Добавить();
		НоваяСтрокаТовара.Учитывать = Истина;
		НоваяСтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		НоваяСтрокаТовара.ОтгрузочноеНаименование 	= КС.XDTO_Вычислить(ОпГруз, "НаимГруз");
		НоваяСтрокаТовара.СостояниеГруза 			= КС.XDTO_Вычислить(ОпГруз, "СостГруз");
		НоваяСтрокаТовара.СпособУпаковки 			= КС.XDTO_Вычислить(ОпГруз, "СпУпак");
		ВидТар_raw = КС.XDTO_Вычислить(ОпГруз, "ВидТар");
		Если ЗначениеЗаполнено(ВидТар_raw) Тогда                                          
			НоваяСтрокаТовара.ВидТары 				= Справочники.КонтурЛогистика_КлассификаторУпаковок.НайтиПоКоду(ВидТар_raw);
		КонецЕсли;
		НоваяСтрокаТовара.КоличествоМест  			= КС.XDTO_Вычислить(ОпГруз, "КолМестГр");
		НоваяСтрокаТовара.МассаПлановаяБруттоКг  	= КС.XDTO_Вычислить(ОпГруз, "ПлМасГруз.МасБрутЗнач");
		НоваяСтрокаТовара.КодТНВЭД  				= КС.XDTO_Вычислить(ОпГруз, "КодТовНом");
		НоваяСтрокаТовара.ОбъемКубМ  				= КС.XDTO_Вычислить(ОпГруз, "Объем");
		НоваяСтрокаТовара.МассаПлановаяНеттоКг  	= КС.XDTO_Вычислить(ОпГруз, "ПлМасГруз.МасНетЗнач");
		НоваяСтрокаТовара.КоличествоПаллет  		= КС.XDTO_Вычислить(ОпГруз, "ПлМасГруз.КолПалл");
		НоваяСтрокаТовара.ДопИнформация  			= КС.XDTO_Вычислить(ОпГруз, "ДрОГруз");
		стрОбъявленнаяЦенность_raw				  	= КС.XDTO_Вычислить(ОпГруз, "ЦеннГруз.СтЦеннГр");
		
		Если стрОбъявленнаяЦенность_raw <> Неопределено Тогда 
			
			НоваяСтрокаТовара.ОбъявленнаяЦенность = Число(стрОбъявленнаяЦенность_raw);
			
			ЗаполнитьВалюту(НоваяСтрокаТовара, ОпГруз, "ЦеннГруз");
			
			Если Не ЗначениеЗаполнено(НоваяСтрокаТовара.ОбъявленнаяЦенностьВалюта) Тогда				
				ЗаполнитьВалюту(НоваяСтрокаТовара, СодИнфГО, "СвГруз.ОбЦеннГр");				
			КонецЕсли;
						
		КонецЕсли;
		
		НоваяСтрокаТовара.Плотность = КС.XDTO_Вычислить(ОпГруз, "Плотн");

		ЗакУсл_raw = КС.XDTO_Вычислить(ОпГруз, "ЗакУсл");
		Если ЗакУсл_raw <> Неопределено Тогда
			НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок = КС.Конвертировать_ИдСвТип_вОрганизациюДиадок(ЗакУсл_raw);
			
			Если ЗначениеЗаполнено(НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок) 
				И НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок.СвязанныеОбъекты.Количество() > 0 Тогда 
				НоваяСтрокаТовара.ЗаказчикПеревозки = НоваяСтрокаТовара.ЗаказчикОрганизацияДиадок.СвязанныеОбъекты[0].СвязанныйОбъект;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьМаркировкиИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
		ЗаполнитьОпасныеГрузыИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
		ЗаполнитьКонтейнерыИзXDTO(НоваяСтрокаТовара, ОпГруз);
		
		ЗаполнитьСведенияГосСистем(НоваяСтрокаТовара, ОпГруз);
		
		ЗаполнитьИдентификаторыЕГАИС(НоваяСтрокаТовара);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьВалюту(НоваяСтрокаТовара, ОбъектXDTO, Путь)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	КодВалюты = КС.XDTO_Вычислить(ОбъектXDTO, Путь + ".КодОКВ");
	НаименованиеВалюты = КС.XDTO_Вычислить(ОбъектXDTO, Путь + ".НаимОКВ");
	
	Если КодВалюты <> Неопределено Или НаименованиеВалюты <> Неопределено Тогда
		НоваяСтрокаТовара.ОбъявленнаяЦенностьВалюта = 
			КонтурЛогистика_КонвертацияСервер.КонвертироватьВалютуИзЛогистикиВ1С(КодВалюты, НаименованиеВалюты);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияГосСистем(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем НоваяСтрокаГосСист, СвГосСистXDTO;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	НоваяСтрокаТовара.УчетГрузаВГИС  			= КС.XDTO_Вычислить(ОпГруз, "УчГосСист") = "1";
	Если НоваяСтрокаТовара.УчетГрузаВГИС Тогда 
		
		СвГосСистXDTO =  КС.XDTO_Вычислить(ОпГруз, "СвГосСист");
		
		Если СвГосСистXDTO <> Неопределено Тогда 
			
			МассивИдНомУчетЕд 	= КС.XDTO_ВычислитьМассивXDTO(КС.XDTO_Вычислить(СвГосСистXDTO, "ИдНомУчетЕд"));
			
			Для Каждого ИдНомУчетЕд Из МассивИдНомУчетЕд Цикл
				
				НоваяСтрокаГосСист = СведенияГосСистем.Добавить();
				НоваяСтрокаГосСист.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
				НоваяСтрокаГосСист.НаимГосСист 	= КС.XDTO_Вычислить(СвГосСистXDTO, "НаимГосСист");
				НоваяСтрокаГосСист.УчетЕд 		= КС.XDTO_Вычислить(СвГосСистXDTO, "УчетЕд");
				НоваяСтрокаГосСист.ИнаяИнф 		= КС.XDTO_Вычислить(СвГосСистXDTO, "ИнаяИнф");
				НоваяСтрокаГосСист.ИдНомУчетЕд 	= ИдНомУчетЕд;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьКонтейнерыИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем МассивСвКонтейн_XDTO, НоваяСтрокаКонтейнера, СвКонтейн_XDTO, СвКонтейн_XDTO_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвКонтейн_XDTO_raw = КС.XDTO_Вычислить(ОпГруз, "СвКонтейн");
	
	Если СвКонтейн_XDTO_raw <> Неопределено Тогда
		
		МассивСвКонтейн_XDTO = КС.XDTO_ВычислитьМассивXDTO(СвКонтейн_XDTO_raw);
		Для Каждого СвКонтейн_XDTO Из МассивСвКонтейн_XDTO Цикл
			
			НоваяСтрокаКонтейнера = Контейнеры.Добавить();
			НоваяСтрокаКонтейнера.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
			НоваяСтрокаКонтейнера.ИдНомерКонтейнера 		= КС.XDTO_Вычислить(СвКонтейн_XDTO, "ИдКонтейн");
			НоваяСтрокаКонтейнера.Количество 				= КС.XDTO_Вычислить(СвКонтейн_XDTO, "КолКонтейн");
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОпасныеГрузыИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем НоваяСтрокаОпГр, СвОпГруз_XDTO;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	СвОпГруз_XDTO = КС.XDTO_Вычислить(ОпГруз, "СвОпГруз");
	Если СвОпГруз_XDTO <> Неопределено Тогда
		
		НоваяСтрокаОпГр = ОпасныеГрузы.Добавить();
		НоваяСтрокаОпГр.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
		
		НоваяСтрокаОпГр.НомерООН 						= КС.XDTO_Вычислить(СвОпГруз_XDTO, "НомООН");
		НоваяСтрокаОпГр.НадлежащееОтгрузочноеНаименование = КС.XDTO_Вычислить(СвОпГруз_XDTO, "НадОтгНаим");
		НоваяСтрокаОпГр.ТехническоеНаименование 		= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ТехНаим");
		НоваяСтрокаОпГр.Описание 						= КС.XDTO_Вычислить(СвОпГруз_XDTO, "Описание");
		НоваяСтрокаОпГр.Класс 							= Перечисления.КонтурЛогистика_КлассыОпасностиГрузов.ЗначениеИзXDTO(
															КС.XDTO_Вычислить(СвОпГруз_XDTO, "Клас"));
		НоваяСтрокаОпГр.КлассификационныйКод 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КласКод");
		НоваяСтрокаОпГр.ГруппаУпаковки 					= Перечисления.КонтурЛогистика_ГруппыУпаковки.ЗначениеИзXDTO(
															КС.XDTO_Вычислить(СвОпГруз_XDTO, "ГрУп"));
		НоваяСтрокаОпГр.ЗнакОпасности 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ЗнОп");
		НоваяСтрокаОпГр.КодОграниченияТуннели 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КодОгрЧерТун");
		НоваяСтрокаОпГр.Радионуклиды 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "НазРадионук");
		НоваяСтрокаОпГр.ОписаниеФизХимФормы 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОписФизХимФорм");
		НоваяСтрокаОпГр.МаксАктивностьРадиации 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "МаксАкт");
		НоваяСтрокаОпГр.КатегорияУпаковки 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КатУпак");
		НоваяСтрокаОпГр.ТранспортныйИндекс 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ТрансИндекс");
		НоваяСтрокаОпГр.ИндексБезопасности 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ИндексБез");
		НоваяСтрокаОпГр.ОпознавательныйЗнакСертификатов = КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОпозЗнак");
		НоваяСтрокаОпГр.ПолнаяАктивностьГруза 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ПолнАктГр");
		НоваяСтрокаОпГр.ОбМасНетВзрСод 					= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОбМасНетВзрСод");
		НоваяСтрокаОпГр.ОбМасНетВзрСодВсех 				= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ОбМасНетВзрСодВсех");
		НоваяСтрокаОпГр.ПроцСмеси 						= КС.XDTO_Вычислить(СвОпГруз_XDTO, "ПроцСмеси");
		НоваяСтрокаОпГр.ДатаИстеченияВремениУдержания 	= КС.Конвертировать_ДатаТип_вДата(КС.XDTO_Вычислить(СвОпГруз_XDTO, "ДатИстВрУдер"));
		НоваяСтрокаОпГр.КонтрольнаяТемпература 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "КонтТемпер");
		НоваяСтрокаОпГр.АварийнаяТемпература 			= КС.XDTO_Вычислить(СвОпГруз_XDTO, "АварТемпер");
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьМаркировкиИзXDTO(Знач НоваяСтрокаТовара, Знач ОпГруз)
	
	Перем МаркировкаЗначение, МассивМаркировок, НоваяСтрокаМаркировки, стрМаркировки_raw;
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	
	стрМаркировки_raw = КС.XDTO_Вычислить(ОпГруз, "Марк");
	МассивМаркировок = Новый Массив;
	
	Если стрМаркировки_raw <> Неопределено Тогда 
		Если ТипЗнч(стрМаркировки_raw) = Тип("Строка") Тогда 
			МассивМаркировок.Добавить(стрМаркировки_raw);
		Иначе
			МассивМаркировок = КС.XDTO_ВычислитьМассивXDTO(стрМаркировки_raw);
		КонецЕсли;
	КонецЕсли;
	Для Каждого МаркировкаЗначение Из МассивМаркировок Цикл 
		НоваяСтрокаМаркировки = Маркировки.Добавить();
		НоваяСтрокаМаркировки.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки;
		НоваяСтрокаМаркировки.ЗначениеМаркировки = МаркировкаЗначение;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьИдентификаторыЕГАИС(Знач НоваяСтрокаТовара)
	
	ИдентификаторыЕГАИС = "";
	Для каждого Стр Из СведенияГосСистем Цикл
		
		Если Стр.ИдентификаторСтрокиТоваров = НоваяСтрокаТовара.ИдентификаторСтроки И ВРег(Стр.НаимГосСист) = "ЕГАИС" Тогда
			
			ИдентификаторыЕГАИС = ИдентификаторыЕГАИС + Стр.ИдНомУчетЕд + "; ";	
			
		КонецЕсли;
		
	КонецЦикла;
			
	Если ЗначениеЗаполнено(ИдентификаторыЕГАИС) Тогда
		
		ИдентификаторыЕГАИС = Лев(ИдентификаторыЕГАИС, СтрДлина(ИдентификаторыЕГАИС) - 2);
		
		НоваяСтрокаТовара.ИдентификаторыЕГАИС = ИдентификаторыЕГАИС;
		НоваяСтрокаТовара.УчетГрузаВГИС = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

