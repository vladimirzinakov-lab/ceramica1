Функция СформироватьФайлОбмена(ПараметрыФайлаРеквизиты = Неопределено) Экспорт
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("МассивФайловОбмена", Новый Массив);
	Результат.Успешно = Истина;
	
	Если ПараметрыФайлаРеквизиты = Неопределено Тогда 
		ПараметрыФайлаРеквизиты = Новый Структура;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Составитель) Тогда 
		ПараметрыФайлаРеквизиты.Вставить("Составитель", Составитель);
	КонецЕсли;
	
	Попытка
		
		Заблокировать();
		
	Исключение
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не удалось заблокировать документ: " + ОписаниеОшибки();
		
		Возврат Результат;
		
	КонецПопытки;
	
	// Проверка статуса после наложения блокировки на Документ
	РезультатПроверкиСтатуса = КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьТекущийСтатусДокументаДляСозданияФайловОбмена(Ссылка);
	
	Если НЕ РезультатПроверкиСтатуса.Успешно Тогда
		Разблокировать();
		Возврат РезультатПроверкиСтатуса;
	КонецЕсли;
	
	// Выполнить валидацию документа
	РезультатВалидации = Документы.КонтурЛогистика_ТрН_Титул1.ПроверитьДокумент(Ссылка,,, ПараметрыФайлаРеквизиты);
	
	Если РезультатВалидации.КоличествоОшибок > 0 Тогда
		
		Разблокировать();
		Результат.ОписаниеОшибки = "Ошибки в " + Ссылка + "! Исправьте их для отправки.";
		Результат.Успешно = Ложь;
		Возврат Результат;
		
	КонецЕсли;
	
	КонтурЛогистика_ОбщегоНазначенияСервер.НачатьТранзакцию_();
	
	ДатИнфГО = ТекущаяДатаСеанса();
	ВрИнфГО = ТекущаяДатаСеанса();
	
	Попытка
		
		Если ПараметрыФайлаРеквизиты.Свойство("ПередатьНаПодписание")
			Или ПараметрыФайлаРеквизиты.Свойство("ПередатьНаСогласованиеВодителю") Тогда
			
			ЗаполнятьПодписанта = Ложь;
		ИначеЕсли ПараметрыФайлаРеквизиты.Свойство("ТребуетсяПодпись")
			И Не ПараметрыФайлаРеквизиты.ТребуетсяПодпись
			И Не ЗначениеЗаполнено(ПользовательПодписант) Тогда
			
			ЗаполнятьПодписанта = Ложь;
		Иначе
			ЗаполнятьПодписанта = Истина;
		КонецЕсли;
		
		Если ЭтоПрототип Тогда
			
			ПараметрыФайлаРеквизиты.Удалить("ПередатьНаПодписание");
			ПараметрыФайлаРеквизиты.Удалить("ПередатьНаСогласованиеВодителю");
			
			ЗаполнятьПодписанта = Ложь;
			ПараметрыФайлаРеквизиты.Вставить("ТребуетсяПодпись", Ложь);
			
		КонецЕсли;	
	
		// Формируем текст xml
		РезультатФормированияТекста = СформироватьТекстФайла(ДатИнфГО, ВрИнфГО, ЗаполнятьПодписанта);
		Если РезультатФормированияТекста.Успешно = Ложь Тогда
			
			Результат.Успешно = Ложь;
			Результат.МассивОшибок.Добавить(КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(
				РезультатФормированияТекста));
			
			Возврат Результат;
			
		КонецЕсли;
		
		// Запишем в справочник
		РезультатСозданияФайла = Справочники.КонтурЛогистика_ФайлыОбмена.СоздатьФайлОбмена(
			РезультатФормированияТекста, Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1,
			ПараметрыФайлаРеквизиты, Ссылка);
		
		ЗаполнитьЗначенияСвойств(Результат, РезультатСозданияФайла);
		
		Если Результат.Успешно Тогда
			
			РегистрыСведений.КонтурЛогистика_СтатусыТитулов.УстановитьСтатус(
				Ссылка, Перечисления.КонтурЛогистика_СтатусыТитулов.СформированыФайлыОбмена,, Истина);
			
			Результат.МассивФайловОбмена.Добавить(РезультатСозданияФайла.Файл);
			
		Иначе
			
			ВызватьИсключение КонтурЛогистика_ОбщегоНазначенияКлиентСервер.СформироватьТекстОшибокФункции(Результат);
			
		КонецЕсли;
		
		Записать(); // Запишем  ДатИнфГО и ВрИнфГО
		
		Разблокировать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = "Ошибка при формировании файла обмена по документу " + Ссылка + ": " + ОписаниеОшибки();
		Сообщить(ТекстОшибки);
		Разблокировать();
		Результат.Успешно = Ложь;
		Результат.Массивошибок.Добавить(ТекстОшибки);
		
		КонтекстМетода = Новый Структура;
		КонтекстМетода.Вставить("ПараметрыФайлаРеквизиты", ПараметрыФайлаРеквизиты);
		КонтекстМетода.Вставить("РезультатСозданияФайла", РезультатСозданияФайла);
		
		КонтурЛогистика_Метрика.ОбработатьОшибкуФормированияТекстаФайла(Ссылка, ИнформацияОбОшибке(), КонтекстМетода);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТекстФайла(ДатаФормирования, ВремяФормирования, ЗаполнятьПодписанта)
	
	КС = КонтурЛогистика_КонструкторыXDTO;
	НомерТитула = 1;
	Формат = "5.01";
	
	Результат = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции();
	Результат.Вставить("ТекстФайла", "");
	
	XDTO_Файл = КС.XDTO_ФайлОбмена(НомерТитула);
	
	GUID = Строка(Новый УникальныйИдентификатор);
	
	Если ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку И ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет) Тогда 
		ИстинныйГрузоотправитель = ДокументЭТРН.ПогрузкуОсуществляет;
	Иначе
		ИстинныйГрузоотправитель = ДокументЭТРН.Грузоотправитель;
	КонецЕсли;
	
	Если ДополнительныеПолучателиФайла.Количество() > 0 Тогда 
		W = 1;
	Иначе
		W = 0;
	КонецЕсли;
	КС.ДобавитьДополнительныхПолучателейФайла(XDTO_Файл, ДополнительныеПолучателиФайла); 	
	
	XDTO_Файл.ИдФайл = КС.ИдентификаторФайлаТитулаТРН(НомерТитула, 
												ИстинныйГрузоотправитель,
												ДокументЭТРН.Перевозчик,
												ДокументЭТРН.Грузополучатель,
												GUID,
												W);
	Результат.Вставить("ИдФайл",		XDTO_Файл.ИдФайл);
												
	Организация = РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ОрганизацияДляПолученияНастроекПодписания(ДокументЭТРН);
	ПодписантСтруктура 	= РегистрыСведений.КонтурЛогистика_НастройкиПодписания.ВыбратьПодписанта(
		Организация, ПользовательПодписант, ДокументЭТРН.ДатаТрН, ЭтотОбъект, ПараметрНастроекПодписания);
	
	Если ЗаполнятьПодписанта Тогда
		XDTO_Подписант = КС.XDTO_Подписант(НомерТитула, , Формат, ПодписантСтруктура);
	Иначе
		XDTO_Подписант = Неопределено;
	КонецЕсли;
	
	КС.XDTO_Подписант_СформироватьСведенияМЧД(НомерТитула, XDTO_Подписант, ПодписантСтруктура, Результат);
	
	XDTO_Файл.Документ	= КС.XDTO_Документ(НомерТитула, , Формат, XDTO_Подписант, ДатаФормирования, ВремяФормирования);
	
	Если ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку
		И ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет)
		И Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПогрузкуОсуществляетДругаяОрганизация(ДокументЭТРН) Тогда
		
		ОргСоставитель = ДокументЭТРН.ПогрузкуОсуществляет;
		
		КС.XDTO_Установить(XDTO_Файл.Документ, "НаимЭкСубСост", ОргСоставитель.НаименованиеОрганизацииПолное);
		
		XDTO_ОснДовОргСост = КС.XDTO_РеквДокТипПоСсылкеДоговору(1, ДокументЭТРН.ПогрузкаДоговор,, Формат);
		КС.XDTO_Установить(XDTO_Файл.Документ, "ОснДовОргСост", XDTO_ОснДовОргСост);
		
	КонецЕсли;

	XDTO_СодИнфГО = КС.XDTO_СодИнфГО(НомерТитула, Формат, Ссылка);
	КС.XDTO_Установить(XDTO_Файл.Документ, "СодИнфГО", XDTO_СодИнфГО);
	
	ТекстФайла = КонтурЛогистика_КонструкторыXDTO.ПодготовитьТекстФайлаЛогистика(XDTO_Файл);
	
	Результат.Вставить("ТекстФайла",ТекстФайла);
	Результат.Вставить("GUID",		GUID);
	
	Результат.Успешно = Истина;
	
	Возврат Результат;
	
КонецФункции

//////////////////////////////////////////////////////////////////
// Из Заказ Заявки

Процедура ЗаполнитьПоДокЗаказЗаявка(ЗЗСсылкаТ1илиТ2)
	
	Если ТипЗнч(ЗЗСсылкаТ1илиТ2) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул1") Тогда 
		
		ЗаказЗаявкаТ1 = ЗЗСсылкаТ1илиТ2;
		ЗаказЗаявкаТ2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
			Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул2,
			ЗаказЗаявкаТ1);
		
	ИначеЕсли ТипЗнч(ЗЗСсылкаТ1илиТ2) = Тип("ДокументСсылка.КонтурЛогистика_ЗЗ_Титул2") Тогда
		
		ЗаказЗаявкаТ1 = ЗЗСсылкаТ1илиТ2.Титул1;
		ЗаказЗаявкаТ2 = ЗЗСсылкаТ1илиТ2;

	Иначе
		ВызватьИсключение "Непредполагаемый тип документа: " + Строка(ТипЗнч(ЗЗСсылкаТ1илиТ2));
	КонецЕсли;
	
	МетодОпределенияМассы = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("МетодОпределенияМассы");
	
	ДатаВремяПодачиПлановая = ЗаказЗаявкаТ1.ДатВрПод;
	ДатаВремяПрибытия 		= ЗаказЗаявкаТ1.ДатВрПод;
	ТемператураНеНиже 		= ЗаказЗаявкаТ1.ТемператураНеНиже;
	ТемператураНеВыше 		= ЗаказЗаявкаТ1.ТемператураНеВыше;
	ВлажностьНеНиже 		= ЗаказЗаявкаТ1.ВлажностьНеНиже;
	ВлажностьНеВыше 		= ЗаказЗаявкаТ1.ВлажностьНеВыше;
	УказанияВОтношенииНормПеревозки = ЗаказЗаявкаТ1.УказанияВОтношенииНормПеревозки;
	ИнициаторПереадресации  = Перечисления.КонтурЛогистика_ИнициаторыПереадресовки.Грузоотправитель; 
	
	// товары
	СпособУпаковкиПоУмолчанию = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("СпособУпаковкиПоУмолчанию");
	Для Каждого СтрокаТовараЗЗ Из ЗаказЗаявкаТ1.Товары Цикл 
		НоваяСтрокаТовара = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТовара, СтрокаТовараЗЗ);
		НоваяСтрокаТовара.СпособУпаковки = СпособУпаковкиПоУмолчанию;
	КонецЦикла;
	// применить соответствия
	ТЗ_ТоварыВременная = Товары.Выгрузить();
	КонтурЛогистика_КонвертацияСервер.СгенерироватьИдентификаторыСтрок(ТЗ_ТоварыВременная);
	Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ИспользоватьИПрименятьБазовыеСоответствия") Тогда 
		КонтурЛогистика_КонвертацияСервер.КонвертироватьТовары1сВЛогистику(ТЗ_ТоварыВременная, ЭтотОбъект);
	КонецЕсли;
	Товары.Загрузить(ТЗ_ТоварыВременная);
	РассчитатьАвтоитогиМестИМассы();
	
	// реквизиты ТРН
	Если ЗначениеЗаполнено(ДокументЭТРН) Тогда 
		
		ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
		
	Иначе
		// найти по реквизиту ЗаказЗаявкаОснование
		ДокументЭТРН = КонтурЛогистика_ОбработкаДокументовСервер.НайтиЭТрНпоЗаказЗаявке(ЗаказЗаявкаТ1);
		
		Если ЗначениеЗаполнено(ДокументЭТРН) Тогда
			ДокЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
		Иначе 
			ДокЭТРНОбъект = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
			ДокЭТРНОбъект.НомерТрН = ЗаказЗаявкаТ1.НомЗак;
			ДокЭТРНОбъект.ДатаТрН = ТекущаяДатаСеанса();
			ДокЭТРНОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		
	КонецЕсли;
	
	ДокЭТРНОбъект.Грузоотправитель = ЗаказЗаявкаТ1.Грузоотправитель;
	ДокЭТРНОбъект.Перевозчик = ЗаказЗаявкаТ1.Перевозчик;
	ДокЭТРНОбъект.НомЗак     = ЗаказЗаявкаТ1.НомЗак;
	ДокЭТРНОбъект.ДатаЗак    = ЗаказЗаявкаТ1.ДатаЗак;
	ДокЭТРНОбъект.МестоПогрузки = ЗаказЗаявкаТ1.ПунктПод;
	ДокЭТРНОбъект.СрокДоставки = ЗаказЗаявкаТ1.ПредСрПрвз;
	ДокЭТРНОбъект.ЗаказЗаявкаОснование = ЗаказЗаявкаТ1;
	
	Для Каждого ПунктМаршрута Из ЗаказЗаявкаТ1.АдрПункт Цикл  //последний пункт выгрузки - место доставки
		Если ПунктМаршрута.Выгрузка Тогда 
			ДокЭТРНОбъект.МестоДоставки = ПунктМаршрута.ПунктМаршрута;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ЗаказЗаявкаТ2) Тогда
		Если ЗаказЗаявкаТ2.ЕстьОтказВПодписи Тогда 
			ВызватьИсключение "Перевозчик в заказ заявке отказал в подписании: " + ЗаказЗаявкаТ2.ПричинаОтказаВПодписи;
		КонецЕсли;
		Если ЗаказЗаявкаТ2.Водители.Количество() > 0 Тогда 
			Водитель = ЗаказЗаявкаТ2.Водители[0].СвВодит;
			Если ЗаказЗаявкаТ2.Водители.Количество() > 1 Тогда 
				Водитель2 = ЗаказЗаявкаТ2.Водители[1].СвВодит;
			КонецЕсли;
		КонецЕсли;
		
		// реквизиты ТРН
		ДокЭТРНОбъект.ТелефонВодителя = Водитель.ТелефонОсновной;
	    ДокЭТРНОбъект.ТранспортноеСредство = ЗаказЗаявкаТ2.ТранспортноеСредство;
		Если ЗаказЗаявкаТ2.Прицепы.Количество() > 0 Тогда 
			ДокЭТРНОбъект.Прицеп = ЗаказЗаявкаТ2.Прицепы[0].Прицеп;
		КонецЕсли;
		Если ЗаказЗаявкаТ2.Прицепы.Количество() > 1 Тогда 
			ДокЭТРНОбъект.Прицеп2 = ЗаказЗаявкаТ2.Прицепы[1].Прицеп;
		КонецЕсли;
	
	КонецЕсли;
	
	ДокЭТРНОбъект.Записать();
	ДокументЭТРН = ДокЭТРНОбъект.Ссылка;
	
КонецПроцедуры

Процедура ПроверитьИспользованиеУИДа(ПолученныйУИД, Отказ, Организация)
	
	УспешноОтметилиИспользованиеУИД = РегистрыСведений.КонтурЛогистика_УИДыГИС.ОтметитьИспользованным(ПолученныйУИД, Организация);
	Если УспешноОтметилиИспользованиеУИД Тогда
		
		Если ЗначениеЗаполнено(ДокументЭТРН) И ДокументЭТРН.УИД <> ПолученныйУИД Тогда
			ЗаписатьУИДвЭТрН(ПолученныйУИД);
		КонецЕсли;
		
	Иначе
		
		Отказ = Истина;
		Сообщить("УИД из пула был использован другим документом, попробуйте повторить операцию");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьУИДвЭТрН(ПолученныйУИД)
	
	ДокументЭТРНОбъект = ДокументЭТРН.ПолучитьОбъект();
	ДокументЭТРНОбъект.УИД = ПолученныйУИД;
	ДокументЭТРНОбъект.Записать();
	
КонецПроцедуры

//////////////////////////////////////////////////////////////////
// Прочее

Процедура РасчетОсобенностейДокументооборота()
	
	// Только на стороне перевозчика
	Если Не ДокументЭТРН.Перевозчик.Наш Тогда
		Возврат;
	КонецЕсли;
	
	// Если документооборот был завершен, то статус ДО изменится и особенность не нужна
	СостояниеЗавершен = Справочники.КонтурЛогистика_СостоянияДвиженияДокументооборота.НайтиСостояниеДОПоКоду("completed");
	Если РегистрыСведений.КонтурЛогистика_ДвижениеДокументооборота.БылоСостояние(ДокументЭТРН, СостояниеЗавершен) Тогда
		Возврат;
	КонецЕсли;
	
	Титул2 = КонтурЛогистика_ОбработкаДокументовСервер.НайтиТитул(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул2, ДокументЭТРН);
	
	Если НомИспр > Титул2.НомИспрГО Тогда
		
		Особенность = Перечисления.КонтурЛогистика_ТипыОсобенностейДокументооборота.ОбработатьИсправлениеТитула1;
		
		ТекущееВремяМСК = КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ТекущийМоментВремени();
		
		РегистрыСведений.КонтурЛогистика_ОсобенностиДокументооборота.УстановитьОсобенность(ДокументЭТРН, Особенность);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьИСконвертироватьТовары(Знач НастройкаКонвертации, Переменные) Экспорт 
	
	// Определим настройку конвертации
	КонтекстНастройкиКонвертации = КонтурЛогистика_КонвертацияСерверПовтИсп.КонтекстНастройкиКонвертацииУчетногоДокумента(
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, НастройкаКонвертации.ТипСправочникаИлиДокументаУС);
	
	КонтурЛогистика_ОбработкаДокументовСервер.ОбработатьТабЧастьТовары(ЭтотОбъект, КонтекстНастройкиКонвертации);
	
	РассчитатьАвтоитогиМестИМассы();
	
	ЭкспедицияЗаказчик = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПолучитьЗаказчикаЭкспедиции(ДокументЭТРН);
	Если ЭкспедицияЗаказчик <> Неопределено Тогда
		ЭкспедицияЗаказчикНайденный = ДополнительныеПолучателиФайла.Найти(ЭкспедицияЗаказчик, "ОрганизацияДиадок");
		Если ЭкспедицияЗаказчикНайденный = Неопределено Тогда 
			НовСтрДопПолучателей = ДополнительныеПолучателиФайла.Добавить();
			НовСтрДопПолучателей.ОрганизацияДиадок = ЭкспедицияЗаказчик; 
		КонецЕсли;
	КонецЕсли;
	
	ПоложитьИдентификаторыЕГАИСВСведенияГосСистем();
	
КонецПроцедуры

#КонецЕсли