
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ТипДанных", ТипДанных);
	
	НомераСтрока = "";
	ДатыСтрока = "";
	НомерТрН = "";
	ДатаТрН = Дата(1, 1, 1);
	
	Параметры.Свойство("Номера", НомераСтрока);
	Параметры.Свойство("Даты", ДатыСтрока);
	Параметры.Свойство("НомерТрН", НомерТрН);
	Параметры.Свойство("ДатаТрН", ДатаТрН);
	
	ЗаполнитьТаблицуПоНомерамИДатам(НомераСтрока, ДатыСтрока);
	УстановитьЗаголовокФормы(НомерТрН, ДатаТрН);
	ОбновитьАвтоОтметкуНезаполненногоДатНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДанные

&НаКлиенте
Процедура ДанныеДатаПриИзменении(Элемент)
	
	ОбновитьАвтоОтметкуНезаполненногоДат();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Если Не ДанныеТаблицыЗаполнены() Тогда
		ПоказатьПредупреждение(, "Требуется заполнить номера во всех строках таблицы.");
		Возврат;
	КонецЕсли;
	
	Если Не ДатыЗаполненыСогласноПравилу() Тогда
		ПоказатьПредупреждение(,
			"Если указана хотя бы одна дата, даты должны быть заполнены во всех строках таблицы. Либо даты не указываются.");
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТипДанных", ТипДанных);
	Результат.Вставить("Номера", НомераИзТаблицыВСтроку());
	Результат.Вставить("Даты", ДатыИзТаблицыВСтроку());
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗаголовокФормы(НомерТрН, ДатаТрН)
	
	ПредставлениеДаты = "";
	Если ЗначениеЗаполнено(ДатаТрН) Тогда
		ПредставлениеДаты = Формат(ДатаТрН, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерТрН) И ЗначениеЗаполнено(ПредставлениеДаты) Тогда
		ЭтаФорма.Заголовок = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("ТРН %1 от %2", НомерТрН, ПредставлениеДаты);
	ИначеЕсли ЗначениеЗаполнено(НомерТрН) Тогда
		ЭтаФорма.Заголовок = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("ТРН %1", НомерТрН);
	ИначеЕсли ЗначениеЗаполнено(ПредставлениеДаты) Тогда
		ЭтаФорма.Заголовок = КонтурЛогистика_СтдСтрКлиентСервер.СтрШаблонЛок("ТРН от %1", ПредставлениеДаты);
	Иначе
		ЭтаФорма.Заголовок = "Редактирование номеров и дат EDI";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПоНомерамИДатам(НомераСтрока, ДатыСтрока)
	
	Данные.Очистить();
	
	МассивНомеров = РазделитьСтрокуПоЗапятой(НомераСтрока);
	МассивДат = РазделитьСтрокуПоЗапятой(ДатыСтрока);
	
	КоличествоСтрок = Макс(МассивНомеров.Количество(), МассивДат.Количество());
	
	Для Индекс = 0 По КоличествоСтрок - 1 Цикл
		
		НоваяСтрока = Данные.Добавить();
		
		Если Индекс < МассивНомеров.Количество() Тогда
			НоваяСтрока.Номер = МассивНомеров[Индекс];
		КонецЕсли;
		
		Если Индекс < МассивДат.Количество() Тогда
			НоваяСтрока.Дата = КонтурЛогистика_СтдСтрКлиентСервер.СтрокаВДатуЛок(МассивДат[Индекс]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РазделитьСтрокуПоЗапятой(СтрокаЗначений)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СтрокаЗначений) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Части = КонтурЛогистика_СтдСтрКлиентСервер.СтрРазделитьЛок(СтрокаЗначений, ",", Ложь);
	
	Для Каждого Часть Из Части Цикл
		Результат.Добавить(СокрЛП(Часть));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьАвтоОтметкуНезаполненногоДатНаСервере()
	
	Элементы.ДанныеДата.АвтоОтметкаНезаполненного = ЕстьЗаполненнаяДатаВТаблицеНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ЕстьЗаполненнаяДатаВТаблицеНаСервере()
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если ЗначениеЗаполнено(СтрокаДанных.Дата) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьАвтоОтметкуНезаполненногоДат()
	
	Элементы.ДанныеДата.АвтоОтметкаНезаполненного = ЕстьЗаполненнаяДатаВТаблице();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьЗаполненнаяДатаВТаблице()
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если ЗначениеЗаполнено(СтрокаДанных.Дата) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ДанныеТаблицыЗаполнены()
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаДанных.Номер) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ДатыЗаполненыСогласноПравилу()
	
	КоличествоДат = 0;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если ЗначениеЗаполнено(СтрокаДанных.Дата) Тогда
			КоличествоДат = КоличествоДат + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоДат = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат КоличествоДат = Данные.Количество();
	
КонецФункции

&НаКлиенте
Функция НомераИзТаблицыВСтроку()
	
	МассивНомеров = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		МассивНомеров.Добавить(СтрокаДанных.Номер);
	КонецЦикла;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(МассивНомеров);
	
КонецФункции

&НаКлиенте
Функция ДатыИзТаблицыВСтроку()
	
	МассивДат = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если ЗначениеЗаполнено(СтрокаДанных.Дата) Тогда
			МассивДат.Добавить(Формат(СтрокаДанных.Дата, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтурЛогистика_ОбщегоНазначенияКлиентСервер.МассивВСтроку(МассивДат);
	
КонецФункции

#КонецОбласти
