// Функция - Проверить документ
//
// Параметры:
//  ДокументОбъектИлиСсылка - ДокументСсылка, ДокументОбъект - проверяемый документ может передаваться как ссылкой так и объектом
//  ТаблицаОшибок	 		- ТаблицаЗначений - можно передать таблицу с уже найденными ошибками
// 
// Возвращаемое значение:
//  Структура -  см. КонтурЛогистика_ОбщегоНазначенияКлиентСервер.ИнициализироватьСтруктуруРезультатаФункции()
//
Функция ПроверитьДокумент(Знач ДокументОбъектИлиСсылка, ТаблицаОшибок = Неопределено, ТребуемоеДействие = Неопределено,
	ПараметрыФормированияФайлов = Неопределено) Экспорт
	
	Если ТаблицаОшибок = Неопределено Тогда
		ТаблицаОшибок = КонтурЛогистика_ПанельОшибокСервер.ИнициализироватьТаблицуОшибок();
	КонецЕсли;
	
	ТекСтатусТитула = РегистрыСведений.КонтурЛогистика_СтатусыТитулов.ПолучитьСтатус(ДокументОбъектИлиСсылка.Ссылка, Истина);
	
	ТаблицаОшибок.Очистить();
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Ошибка Тогда
		КонтурЛогистика_ПанельОшибокСервер.ВывестиОшибкуТекущегоТитула(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок)
	КонецЕсли;
	
	ЭтоОтправкаЧерновика = (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ОтправитьЧерновик
		Или (ПараметрыФормированияФайлов <> Неопределено
			И ПараметрыФормированияФайлов.Свойство("ТребуетсяПодпись")
			И Не ПараметрыФормированияФайлов.ТребуетсяПодпись
			И Не ПараметрыФормированияФайлов.Свойство("ПередатьНаПодписание")
			И Не ПараметрыФормированияФайлов.Свойство("ПередатьНаСогласованиеВодителю")));
	ЭтоПередачаНаПодписание = (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаПодписание
		Или (ПараметрыФормированияФайлов <> Неопределено
			И ПараметрыФормированияФайлов.Свойство("ТребуетсяПодпись")
			И Не ПараметрыФормированияФайлов.ТребуетсяПодпись
			И ПараметрыФормированияФайлов.Свойство("ПередатьНаПодписание")));
	ЭтоСогласованиеСВодителем = (ТребуемоеДействие = Перечисления.КонтурЛогистика_ТребуемыеДействия.ПередатьНаСогласованиеВодителю
		Или (ПараметрыФормированияФайлов <> Неопределено
			И ПараметрыФормированияФайлов.Свойство("ТребуетсяПодпись")
			И Не ПараметрыФормированияФайлов.ТребуетсяПодпись
			И ПараметрыФормированияФайлов.Свойство("ПередатьНаСогласованиеВодителю")));
	
	Если ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.Получен
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки
		Или ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученОбработанСПредупреждением Тогда
		
		КрайнийФайл = Справочники.КонтурЛогистика_ФайлыОбмена.КрайнийФайлДокумента(ДокументОбъектИлиСсылка.Ссылка);
		Если КрайнийФайл <> Неопределено И Не КрайнийФайл.ПодписьВерна Тогда
			
			ВыполнитьВалидации(ДокументОбъектИлиСсылка, ТаблицаОшибок, ТекСтатусТитула, ЭтоОтправкаЧерновика, ПараметрыФормированияФайлов);
			
		КонецЕсли;
		
	ИначеЕсли (Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершена
		И Не ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.РаботаЗавершенаРаспечатан)
		Или ЭтоПередачаНаПодписание
		Или ЭтоСогласованиеСВодителем Тогда
		
		ВыполнитьВалидации(ДокументОбъектИлиСсылка, ТаблицаОшибок, ТекСтатусТитула, ЭтоОтправкаЧерновика, ПараметрыФормированияФайлов);
		
	Иначе
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
		КонтурЛогистика_ПанельОшибокСервер.ПроверитьОшибкиДругихСторон(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
		
	КонецЕсли;
	
	КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьРоуминг(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	
	Результат = КонтурЛогистика_ПанельОшибокСервер.ПолучитьРезультатПроверки(ТаблицаОшибок);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьВалидации(Знач ДокументОбъектИлиСсылка, Знач ТаблицаОшибок, Знач ТекСтатусТитула, Знач ЭтоОтправкаЧерновика, Знач ПараметрыФормированияФайлов)
	
	КонтурЛогистика_ПанельОшибокСервер.ПроверитьПредупреждения(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
	
	КонтурЛогистика_ПанельОшибокСервер.ПроверитьДиадокОшибки(ДокументОбъектИлиСсылка.Ссылка, ТаблицаОшибок);
	
	ЭтоОтправкаПрототипа = ДокументОбъектИлиСсылка.ЭтоПрототип;
	ЭтоОбработкаВходящего = (ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки);
	
	КонтурЛогистика_ОбщегоНазначенияСервер.ВалидацияВыполненияАвторизации(ДокументОбъектИлиСсылка,
		Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ТрН_Титул1, ТаблицаОшибок);
	
	ПроверитьШапку(ДокументОбъектИлиСсылка, ТаблицаОшибок, ТекСтатусТитула, ЭтоОтправкаПрототипа, ЭтоОтправкаЧерновика);
	
	ПроверитьТабЧастьТовары(ДокументОбъектИлиСсылка, ТаблицаОшибок, ЭтоОтправкаПрототипа, ЭтоОтправкаЧерновика);
	
	ВалидацияПрототиповИЧерновиков = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВалидацияПрототиповИЧерновиков");
	
	Если ВалидацияПрототиповИЧерновиков
		Или (Не ЭтоОтправкаПрототипа И Не ЭтоОбработкаВходящего И Не ЭтоОтправкаЧерновика) Тогда
		
		ПроверитьОтметки(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		ПроверитьСпецУсловияДвижения(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		ПроверитьИнфПол(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		ПроверитьСопрДок(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьПодписанта(
			ДокументОбъектИлиСсылка, ТаблицаОшибок,, ПараметрыФормированияФайлов);
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьДружбуКонтрагентов(ДокументОбъектИлиСсылка, ТаблицаОшибок);
		КонтурЛогистика_ОбработкаДокументовСервер.Валидатор_ПроверитьОтправителя(ДокументОбъектИлиСсылка, ТаблицаОшибок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьШапку(Знач Объект, ТаблицаОшибок, ТекСтатусТитула, ЭтоОтправкаПрототипа, ЭтоОтправкаЧерновика)
	
	ВалидацияПрототиповИЧерновиков = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("ВалидацияПрототиповИЧерновиков");
	
	ЭтоОбработкаВходящего = ТекСтатусТитула = Перечисления.КонтурЛогистика_СтатусыТитулов.ПолученТребуетОбработки;
	Если Не ВалидацияПрототиповИЧерновиков И (ЭтоОтправкаПрототипа Или ЭтоОтправкаЧерновика)
		Или ЭтоОбработкаВходящего Тогда
		
		ВместоОшибокПредупреждения = Истина;
	Иначе
		ВместоОшибокПредупреждения = Ложь;
	КонецЕсли;
	
	КатегорияОшибка = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
	КатегорияПредупреждение = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Предупреждение;
	
	ДокументЭТРН = Объект.ДокументЭТРН;
	
	Если Не ЗначениеЗаполнено(ДокументЭТРН) И Не Объект.СозданВручную Тогда
		
		ТекстОшибки = "Титул не привязан к Документу электронной транспортной накладной";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ДокументЭТРН", КатегорияОшибка, ТекстОшибки, "Указать");
		
	Иначе
		
		Если ЭтоОтправкаПрототипа Или ЭтоОтправкаЧерновика Тогда
			
			Если ЗначениеЗаполнено(Объект.Составитель) Тогда
				ОрганизацияОтправляющаяВАпиКонтент = Объект.Составитель;
			ИначеЕсли ЗначениеЗаполнено(Объект.ДокументЭТРН.ПогрузкуОсуществляет)
				И Объект.ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку Тогда
				
				ОрганизацияОтправляющаяВАпиКонтент = Объект.ДокументЭТРН.ПогрузкуОсуществляет;
			ИначеЕсли ЗначениеЗаполнено(Объект.ДокументЭТРН.Грузоотправитель) Тогда
				ОрганизацияОтправляющаяВАпиКонтент = Объект.ДокументЭТРН.Грузоотправитель;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОрганизацияОтправляющаяВАпиКонтент) Тогда
				
				ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияОтправляющаяВАпиКонтент);
				Если Не ПараметрыСервиса.АвторизацияВыполнена Тогда
					ТекстОшибки = "У отправителя прототипа (" + ОрганизацияОтправляющаяВАпиКонтент + ") нет авторизации в сервисе Логистика";
					Если ЭтоОтправкаЧерновика Тогда
						ТекстОшибки = СтрЗаменить(ТекстОшибки, "прототипа", "черновика");
					КонецЕсли;
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", , КатегорияОшибка, ТекстОшибки, "Авторизоваться");
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(Объект.Составитель) И Объект.Составитель <> Объект.ДокументЭТРН.Грузоотправитель Тогда
				ОрганизацияОтправляющаяВАпиКонтент = Объект.Составитель;
			ИначеЕсли ЗначениеЗаполнено(Объект.ДокументЭТРН.ПогрузкуОсуществляет) И Объект.ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку Тогда
				ОрганизацияОтправляющаяВАпиКонтент = Объект.ДокументЭТРН.ПогрузкуОсуществляет;
			Иначе
				ОрганизацияОтправляющаяВАпиКонтент = Объект.ДокументЭТРН.Грузоотправитель;
			КонецЕсли;
			
			ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ОрганизацияОтправляющаяВАпиКонтент);
						
			Если Не ПараметрыСервиса.АвторизацияВыполнена
				И ЗначениеЗаполнено(Объект.Составитель)
				И Объект.Составитель <> Объект.ДокументЭТРН.Грузоотправитель Тогда
				
				ТекстОшибки = "У отправителя прототипа (" + ОрганизацияОтправляющаяВАпиКонтент + ") нет авторизации в сервисе Логистика";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", , КатегорияОшибка, ТекстОшибки, "Авторизоваться");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВместоОшибокПредупреждения Тогда 
			КатегорияОшибка = КатегорияПредупреждение;
		КонецЕсли;
		
		Если Не ВалидацияПрототиповИЧерновиков И (ЭтоОтправкаПрототипа Или ЭтоОтправкаЧерновика) Тогда
			
			// Все ошибки стали предупреждениями т.к. в прототипе можно всё (почти)
			ТекстОшибки = "Вы отправляете прототип документа.
				|Проверки не блокируют отправку.";
			Если ЭтоОтправкаЧерновика Тогда
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "прототип", "черновик");
			КонецЕсли;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"Составитель", КатегорияПредупреждение, ТекстОшибки, "Оповещение");
			
		КонецЕсли;
		
		Если Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПогрузкуОсуществляетДругаяОрганизация(ДокументЭТРН) Тогда 
			
			Если НЕ ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет) Тогда 
				ТекстОшибки = "Укажите организацию, которая осуществляет погрузку";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_ПогрузкуОсуществляет", КатегорияОшибка, ТекстОшибки, "Указать");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДокументЭТРН.ПогрузкаСотрудник) Тогда 
				ТекстОшибки = "Укажите кладовщика";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_ПогрузкаСотрудник", КатегорияОшибка, ТекстОшибки, "Указать");
			КонецЕсли;
			
		КонецЕсли;
		
		
		ОбязательныеРеквизитыТРН = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.МассивОбязательныхРеквизитов();
		ОбязательныеРеквизитыПрототипаТРН = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.МассивОбязательныхРеквизитовПрототипа();
		
		Для Каждого ОбязательныйРевизит Из ОбязательныеРеквизитыТРН Цикл
			
			Если ОбязательныйРевизит = "УИД" Тогда 
				Продолжить; // ТРН Т1 можно отправлять без УИДа
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДокументЭТРН[ОбязательныйРевизит])  Тогда
				
				текКатегория = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
				
				Если ВместоОшибокПредупреждения И ОбязательныеРеквизитыПрототипаТРН.Найти(ОбязательныйРевизит) = Неопределено Тогда 
					текКатегория = КатегорияПредупреждение;
				КонецЕсли;
				
				ОбязательныйРевизитСиноним = Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.СинонимРеквизита(ОбязательныйРевизит);
				ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_" + ОбязательныйРевизит, текКатегория, ТекстОшибки, "Указать");
				
			КонецЕсли;
		КонецЦикла;
		
		Если ДокументЭТРН.Перевозчик.ИНН = ДокументЭТРН.Грузоотправитель.ИНН Тогда
		
			ТекстОшибки = "Укажите другую организацию грузоотправителя или перевозчика - они не могут совпадать.";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_Перевозчик", КатегорияПредупреждение, ТекстОшибки, "Указать");
		
		КонецЕсли;
		
		Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ПроверитьКлючевыеРеквизитыЭтРН(ДокументЭТРН, ТаблицаОшибок, ВместоОшибокПредупреждения);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Составитель) Тогда
		ИстинныйГрузоотправитель = Объект.Составитель;	
	ИначеЕсли ДокументЭТРН.ОтправительФайлаЭтоЮрЛицоОсуществляющееПогрузку И ЗначениеЗаполнено(ДокументЭТРН.ПогрузкуОсуществляет) Тогда 
		ИстинныйГрузоотправитель = ДокументЭТРН.ПогрузкуОсуществляет;
	Иначе
		ИстинныйГрузоотправитель = ДокументЭТРН.Грузоотправитель;
	КонецЕсли;
	
	ПараметрыСервиса = КонтурЛогистика_ИнтеграцияAPI_ЛогистикаПовтИсп.ПараметрыСервисаЛогистика(ИстинныйГрузоотправитель);
	
	Если Не ПараметрыСервиса.АвторизацияВыполнена И ЗначениеЗаполнено(ИстинныйГрузоотправитель) Тогда 
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("БратьУИДИзПулаДляТРН") Тогда 
			
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
				
				Если Не ЗначениеЗаполнено(Объект.ДокументЭТРН.УИД) Тогда
					ТекстОшибки = "Не указан УИД из пула ТрН";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
						"УИД", КатегорияОшибка, ТекстОшибки, "Взять из пула");
				КонецЕсли;
				
			Иначе
				
				ОстатокУИДов = РегистрыСведений.КонтурЛогистика_УИДыГИС.ОсталосьСвободныхУИДов(ИстинныйГрузоотправитель);
				Если ОстатокУИДов = 0 Тогда
					
					ТекстОшибки = "Не осталось свободных УИД в пуле. Получите новые или отключите использование пула.";
					КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
						"УИД", КатегорияОшибка, ТекстОшибки, "Получить УИДы");
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЭТРН.УИД)
		И РегистрыСведений.КонтурЛогистика_УИДыГИС.УИДИстек(ДокументЭТРН.УИД, ИстинныйГрузоотправитель) Тогда
		
		ТекстОшибки = "Срок использования УИД истек, необходимо указать новый УИД.";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"УИД", КатегорияОшибка, ТекстОшибки, "Очистить УИД");
		
	КонецЕсли;
	
	ОбязательныеРеквизитыПрототипаТитула = МассивОбязательныхРеквизитовПрототипа();
	
	Для Каждого ОбязательныйРевизит Из МассивОбязательныхРеквизитов() Цикл
		
		Если Прав(ОбязательныйРевизит, 6) = "Массив" ИЛИ Прав(ОбязательныйРевизит, 14) = "МассивСтруктур" Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект[ОбязательныйРевизит]) Тогда
			
			текКатегория = Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка;
			
			Если ВместоОшибокПредупреждения И ОбязательныеРеквизитыПрототипаТитула.Найти(ОбязательныйРевизит) = Неопределено Тогда 
				текКатегория = КатегорияПредупреждение;
			КонецЕсли;
			
			ОбязательныйРевизитСиноним = Документы.КонтурЛогистика_ТрН_Титул1.СинонимРеквизита(ОбязательныйРевизит);
			ТекстОшибки = "Укажите " + ОбязательныйРевизитСиноним;
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			ОбязательныйРевизит, текКатегория, ТекстОшибки, "Указать");
			
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.КоличествоМест > 9999 Тогда 
		
		ТекстОшибки = "Количество мест превышает максимальное значение по формату: 9999";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"КоличествоМест", КатегорияОшибка, ТекстОшибки, "Исправить");
		
	КонецЕсли;	
	
	// Итог количество мест и массы брутто кг
	ИтогоКоличествоМест = 0;
	ИтогоМассаПлановаяБруттоКг = 0;
	
	ПараметрыОтбора = Новый Структура("Учитывать", Истина);
	НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбора);
	Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
		ИтогоКоличествоМест = ИтогоКоличествоМест + ТекущаяСтрока.КоличествоМест;
		ИтогоМассаПлановаяБруттоКг = ИтогоМассаПлановаяБруттоКг + ТекущаяСтрока.МассаПлановаяБруттоКг;
	КонецЦикла;
	
	Если Объект.КоличествоМест <> ИтогоКоличествоМест Тогда
		
		Если ЗначениеЗаполнено(Объект.НомИспр)
			И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогКоличествоМест") Тогда 
			КатОшибки = КатегорияОшибка;
		Иначе
			КатОшибки = КатегорияПредупреждение;
		КонецЕсли;	

		ТекстОшибки = "Количество Мест в шапке документа отличается от итога по табличной части грузов";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"КоличествоМест", КатОшибки, ТекстОшибки, "Проверить");
		
	КонецЕсли;
	
	Если Объект.МассаБруттоКг <> ИтогоМассаПлановаяБруттоКг Тогда
		
		Если ЗначениеЗаполнено(Объект.НомИспр)
			И КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки("Т1АвтоитогМассаБрутто") Тогда 
			КатОшибки = КатегорияОшибка;
		Иначе
			КатОшибки = КатегорияПредупреждение;
		КонецЕсли;
		
		ТекстОшибки = "Масса Брутто в шапке документа отличается от итога по табличной части грузов";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"МассаБруттоКг", КатОшибки, ТекстОшибки, "Проверить");
	КонецЕсли;
	
	// Водитель
	ПроверитьВодителя(Объект.Водитель, ТаблицаОшибок, КатегорияОшибка, , ДокументЭТРН);
	
	Если ЗначениеЗаполнено(Объект.Водитель)
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.ВодительПоУмолчанию)
		И Не Объект.Водитель = ДокументЭТРН.Перевозчик.ВодительПоУмолчанию Тогда
		
		ТекстОшибки = "Водитель в шапке документа отличается от водителя по умолчанию в карточке перевозчика";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"РедактированиеЭТРН_Перевозчик.ВодительПоУмолчанию", КатегорияПредупреждение, ТекстОшибки, "Проверить");	
		
	КонецЕсли;
	
	ПроверитьВодителя(Объект.Водитель2, ТаблицаОшибок, КатегорияОшибка, "2", ДокументЭТРН);
	
	Если ЗначениеЗаполнено(Объект.Водитель2)
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
		И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.Водитель2ПоУмолчанию)
		И Не Объект.Водитель2 = ДокументЭТРН.Перевозчик.Водитель2ПоУмолчанию Тогда
		
		ТекстОшибки = "Второй водитель в шапке документа отличается от второго водителя по умолчанию в карточке перевозчика";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"РедактированиеЭТРН_Перевозчик.Водитель2ПоУмолчанию", КатегорияПредупреждение, ТекстОшибки, "Проверить");	
		
	КонецЕсли;
	
	// ДополнительныеВодители
	Для Каждого Строка Из Объект.ДополнительныеВодители Цикл 
		
		ПроверитьВодителя(Строка.Водитель, ТаблицаОшибок, КатегорияОшибка, Строка, ДокументЭТРН);
		
	КонецЦикла;	
	
	// ТС
	ТранспортноеСредство = ДокументЭТРН.ТранспортноеСредство;
	Если ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		
		Если ЗначениеЗаполнено(ДокументЭТРН.Перевозчик)
			И ЗначениеЗаполнено(ДокументЭТРН.Перевозчик.ТранспортноеСредствоПоУмолчанию)
			И Не ТранспортноеСредство = ДокументЭТРН.Перевозчик.ТранспортноеСредствоПоУмолчанию Тогда
			
			ТекстОшибки = "Автомобиль в шапке документа отличается от автомобиля по умолчанию в карточке перевозчика";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_Перевозчик.ТранспортноеСредствоПоУмолчанию", КатегорияПредупреждение, ТекстОшибки, "Проверить");	
			
		КонецЕсли;
		
		ГрузоподъемностьТСИПрицепов = 0;
		Если ЗначениеЗаполнено(ТранспортноеСредство.ГрузоподъемностьТонн) Тогда
			ГрузоподъемностьТСИПрицепов = ГрузоподъемностьТСИПрицепов + ТранспортноеСредство.ГрузоподъемностьТонн * 1000;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп.ГрузоподъемностьТонн) Тогда
			ГрузоподъемностьТСИПрицепов = ГрузоподъемностьТСИПрицепов + ДокументЭТРН.Прицеп.ГрузоподъемностьТонн * 1000;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп2.ГрузоподъемностьТонн) Тогда
			ГрузоподъемностьТСИПрицепов = ГрузоподъемностьТСИПрицепов + ДокументЭТРН.Прицеп2.ГрузоподъемностьТонн * 1000;
		КонецЕсли;
		
		ПроцентДопустимогоПревышения = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройки(
			"ДопустимоеПревышениеМассыГрузаНадГрузоподъемностьюТС");
		Если ПроцентДопустимогоПревышения > 100 Тогда
			ПроцентДопустимогоПревышения = 100;
		ИначеЕсли ПроцентДопустимогоПревышения < 0 Тогда
			ПроцентДопустимогоПревышения = 0;
		КонецЕсли;
		ПредельнаяГрузоподъемностьТСИПрицепов = ГрузоподъемностьТСИПрицепов * (1 + ПроцентДопустимогоПревышения / 100);
		
		Если ГрузоподъемностьТСИПрицепов > 0 Тогда
			
			ТекстОшибки = "Масса брутто превышает грузоподъемность транспортного средства (с учетом прицепов)";
			
			Если ПредельнаяГрузоподъемностьТСИПрицепов < Объект.МассаБруттоКг Тогда
				
				Если ПроцентДопустимогоПревышения <> 0 Тогда
					ТекстОшибки = ТекстОшибки
						+ " плюс " + Формат(ПроцентДопустимогоПревышения, "ЧФ=Ч%")
						+ " (" + Строка(ПредельнаяГрузоподъемностьТСИПрицепов) + " кг);"
						+ " порог перегруза можно изменить в настройках";
				КонецЕсли;
				
				ТекущаяКатегория = КатегорияОшибка;
			ИначеЕсли ГрузоподъемностьТСИПрицепов < Объект.МассаБруттоКг Тогда
				ТекущаяКатегория = КатегорияПредупреждение;
			Иначе
				ТекущаяКатегория = Неопределено;
			КонецЕсли;
			
			Если ТекущаяКатегория <> Неопределено Тогда
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"МассаБруттоКг", ТекущаяКатегория, ТекстОшибки, "Проверить");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ВидВладения) Тогда
			
			ТекстОшибки = "Укажите вид владения транспортным средством";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_ТранспортноеСредство.ВидВладения", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ГрузоподъемностьТонн) Тогда
			
			Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп) Тогда
				ТекстОшибки = "Не указана грузоподъемность транспортного средства (тягач?)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"РедактированиеЭТРН_ТранспортноеСредство.ГрузоподъемностьТонн", КатегорияПредупреждение, ТекстОшибки, "Проверить");
			Иначе
				ТекстОшибки = "Укажите прицеп или грузоподъемность транспортного средства";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"РедактированиеЭТРН_ТранспортноеСредство.ГрузоподъемностьТонн", КатегорияОшибка, ТекстОшибки, "Указать");
			КонецЕсли;
		
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ВместимостьКубМ) Тогда
			
			Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп) Тогда
				ТекстОшибки = "Не указана вместимость транспортного средства (тягач?)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"РедактированиеЭТРН_ТранспортноеСредство.ВместимостьКубМ", КатегорияПредупреждение, ТекстОшибки, "Проверить");
			Иначе
				ТекстОшибки = "Укажите прицеп или вместимость транспортного средства";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
					"РедактированиеЭТРН_ТранспортноеСредство.ВместимостьКубМ", КатегорияОшибка, ТекстОшибки, "Указать");
			КонецЕсли;
			
		Иначе
			
			Если КоличествоЗнаковВЧисле(ТранспортноеСредство.ВместимостьКубМ) > 4 Тогда
				ТекстОшибки = "Неверный формат вместимости транспортного средства. Количество цифр в числе должно быть не более 4";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"РедактированиеЭТРН_ТранспортноеСредство.ВместимостьКубМ", КатегорияОшибка, ТекстОшибки, "Проверить");	
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.ТипТС) Тогда
			
			ТекстОшибки = "Укажите тип транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_ТранспортноеСредство.ТипТС", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.МаркаТС) Тогда
			
			ТекстОшибки = "Укажите марку транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_ТранспортноеСредство.МаркаТС", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТранспортноеСредство.РегНомер) Тогда
			
			ТекстОшибки = "Укажите гос. рег. номер транспортного средства";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_ТранспортноеСредство.РегНомер", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Прицепы
	ПроверитьПрицеп(ДокументЭТРН.Прицеп, ТаблицаОшибок, КатегорияОшибка, "ДокументЭТРН.Прицеп");
	
	Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп)
		И ЗначениеЗаполнено(ДокументЭТРН.ТранспортноеСредство)
		И ЗначениеЗаполнено(ДокументЭТРН.ТранспортноеСредство.ПрицепПоУмолчанию)
		И Не ДокументЭТРН.Прицеп = ДокументЭТРН.ТранспортноеСредство.ПрицепПоУмолчанию Тогда
		
		ТекстОшибки = "Прицеп в шапке документа отличается от прицепа по умолчанию в карточке автомобиля";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"РедактированиеЭТРН_ТранспортноеСредство.ПрицепПоУмолчанию", КатегорияПредупреждение, ТекстОшибки, "Проверить");	
		
	КонецЕсли;
	
	ПроверитьПрицеп(ДокументЭТРН.Прицеп2, ТаблицаОшибок, КатегорияОшибка, "ДокументЭТРН.Прицеп2");
	
	Если ЗначениеЗаполнено(ДокументЭТРН.Прицеп2)
		И ЗначениеЗаполнено(ДокументЭТРН.ТранспортноеСредство)
		И ЗначениеЗаполнено(ДокументЭТРН.ТранспортноеСредство.Прицеп2ПоУмолчанию)
		И Не ДокументЭТРН.Прицеп2 = ДокументЭТРН.ТранспортноеСредство.Прицеп2ПоУмолчанию Тогда
		
		ТекстОшибки = "Второй прицеп в шапке документа отличается от второго прицепа по умолчанию в карточке автомобиля";
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"РедактированиеЭТРН_ТранспортноеСредство.Прицеп2ПоУмолчанию", КатегорияПредупреждение, ТекстОшибки, "Проверить");	
		
	КонецЕсли;
	
	// Кладовщик
	Если ЗначениеЗаполнено(ДокументЭТРН.ПогрузкаСотрудник) Тогда
		
		Если Не ЗначениеЗаполнено(ДокументЭТРН.ПогрузкаСотрудник.Должность) Тогда
			
			ТекстОшибки = "Укажите должность кладовщика";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"РедактированиеЭТРН_ПогрузкаСотрудник.Должность", КатегорияОшибка, ТекстОшибки, "Указать");
			
		КонецЕсли;
		
	КонецЕсли;
			
	// сведения о погрузке
	Если ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.Собственник) 
		И Не ДокументЭТРН.МестоПогрузки.Собственник = ДокументЭТРН.Грузоотправитель Тогда
			
		Если ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор) Тогда
			
			Если Не ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор.Организация) 
				И Не ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор.ОрганизацияИНН) Тогда
					
				ТекстОшибки = "Укажите организацию или ИНН, в основание доступа в пункте погрузке";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"РедактированиеЭТРН_МестоПогрузки.ДоступКОбъектуДоговор.ОрганизацияИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;	
			
			Если Не ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор.Контрагент) 
				И Не ЗначениеЗаполнено(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор.КонтрагентИНН) Тогда
				
				ТекстОшибки = "Укажите контрагента или ИНН, в основание доступа в пункте погрузке";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
					"РедактированиеЭТРН_МестоПогрузки.ДоступКОбъектуДоговор.КонтрагентИНН", КатегорияОшибка, ТекстОшибки, "Указать");
				
			КонецЕсли;
			
			КонтурЛогистика_ОбработкаДокументовСервер.ПроверитьДоговор(ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор, ТаблицаОшибок, КатегорияОшибка, "ДокументЭТРН.МестоПогрузки.ДоступКОбъектуДоговор.ДатаДокумента");  
			
		КонецЕсли;
		
	КонецЕсли;	
	
	// Точки доставки партнера EDI
	Если ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) 
		И ЗначениеЗаполнено(ДокументЭТРН.МестоДоставки) Тогда 
		
		// обязательность GLN точки доставки (достаточно МестоДоставки.GLN или GLNТочкиДоставки)
		ГлнТочкиДоставки = ДокументЭТРН.GLNТочкиДоставки;
		Если Не ЗначениеЗаполнено(ГлнТочкиДоставки) Тогда
			ГлнТочкиДоставки = ДокументЭТРН.МестоДоставки.GLN;
		КонецЕсли;
		
		Если КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(ДокументЭТРН.ПартнерГрузополучатель, "ОбязательныйGLNТочкиДоставки") = Истина
			И Не ЗначениеЗаполнено(ГлнТочкиДоставки) Тогда
			
			ТекстОшибки = "Для партнера " + ДокументЭТРН.ПартнерГрузополучатель + " обязательно указывать GLN точки доставки";
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "",
				"РедактированиеЭТРН_GLNТочкиДоставки", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать GLN");
			
		КонецЕсли;
		
		// принадлежность точки доставки к партнеру
		Если ДокументЭТРН.МестоДоставки.КодПартнераКонтур <> ДокументЭТРН.ПартнерГрузополучатель.КодПартнераКонтур Тогда
			
			ТекстОшибки = "Точка доставки не из списка предоставленного партнером " + ДокументЭТРН.ПартнерГрузополучатель;
			
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"РедактированиеЭТРН_МестоДоставки", КатегорияПредупреждение, ТекстОшибки, "Проверить");
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Объект.ТелефоныПереадресующего.Количество() Тогда 
		
		ТекстОшибки = "Укажите телефон переадресующего в таблице ""Телефоны переадресующих лиц""";
		
		КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
			"ТелефоныПереадресующего", КатегорияОшибка, ТекстОшибки, "Указать");
		
	Иначе
		
		Для Каждого СтрокаТел Из Объект.ТелефоныПереадресующего Цикл 
			
			Если Не ЗначениеЗаполнено(СтрокаТел.Телефон) Тогда 
				
				ТекстОшибки = "Укажите номер телефона переадресующего";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "ТелефоныПереадресующего", СтрокаТел.НомерСтроки, 
					"Телефон", КатегорияОшибка, ТекстОшибки, "Заполнить",,,"Указать номер телефона");
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;
	
	ПравилаПартнераКонтур = Неопределено;
	Если ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) Тогда
		
		ПравилаПартнераКонтур = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ПравилаПартнера(
			ДокументЭТРН.ПартнерГрузополучатель.КодПартнераКонтур);
		
	КонецЕсли;
	
	Если ПравилаПартнераКонтур <> Неопределено Тогда
		
		// Требования торговой сети из кэша — вместо настроек партнера ORDERS/УПД/DESADV
		ПроверитьТребованияПартнераКонтур(Объект, ТаблицаОшибок, ПравилаПартнераКонтур, КатегорияОшибка);
		
	Иначе
		
		Если Не ЗначениеЗаполнено(Объект.НомераЗаказов) 
			И ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) Тогда
			
			ORDERSобязателен = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(ДокументЭТРН.ПартнерГрузополучатель, "ОбязательныйНомерЗаказаТоваров");
			
			Если ORDERSобязателен = Истина Тогда 
				ТекстОшибки = "Для партнера " + ДокументЭТРН.ПартнерГрузополучатель + " обязательно указывать номер заказа товаров (настройка партнера)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, , , 
					"ORDERS", КатегорияОшибка, ТекстОшибки, "Указать",,,"Указать номер заказа товаров");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.НомераУПД) 
			И ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) Тогда
			
			INVOICEобязателен = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(ДокументЭТРН.ПартнерГрузополучатель, "ОбязательныйНомерУПД");
			
			Если INVOICEобязателен = Истина Тогда 
				ТекстОшибки = "Для партнера " + ДокументЭТРН.ПартнерГрузополучатель + " обязательно указывать номер УПД/INVOIC (настройка партнера)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, , , 
					"INVOICE", КатегорияОшибка, ТекстОшибки, "Указать",,,"Указать номер УПД");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.НомераDESADV) 
			И ЗначениеЗаполнено(ДокументЭТРН.ПартнерГрузополучатель) Тогда
			
			DESADVобязателен = КонтурЛогистика_ОбщегоНазначенияСерверПовтИсп.ЗначениеНастройкиПартнера(ДокументЭТРН.ПартнерГрузополучатель, "ОбязательныйНомерDESADV");
			
			Если DESADVобязателен = Истина Тогда 
				ТекстОшибки = "Для партнера " + ДокументЭТРН.ПартнерГрузополучатель + " обязательно указывать номера DESADV (уведомления об отгрузке)(настройка партнера)";
				КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, , , 
					"DESADV", КатегорияОшибка, ТекстОшибки, "Указать",,,"Указать номер DESADV товаров");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПроверитьСоответствиеКоличестваНомеровИДатEDI(Объект, ТаблицаОшибок, КатегорияОшибка);
	
	Если ЗначениеЗаполнено(Объект.Составитель) 
		И Документы.КонтурЛогистика_ЭлектроннаяТранспортнаяНакладная.ЯвляетсяУчастникомПеревозки(Объект.Составитель, ДокументЭТРН)
		И Объект.ДополнительныеПолучателиФайла.Найти(Объект.Составитель, "ОрганизацияДиадок") <> Неопределено Тогда
		
			ТекстОшибки = "Составитель не может быть дополнительным получателем файла, так как является участником перевозки";
			КонтурЛогистика_ПанельОшибокСервер.ДобавитьВТаблицуОшибок(ТаблицаОшибок, "", "", 
				"СтраницаДополнительныеПолучатели", Перечисления.КонтурЛогистика_КатегорииОшибокОбъектов.Ошибка, ТекстОшибки, "Указать");
		
	КонецЕсли;
	
	ПроверитьЗаказЗаявкуОснование(Объект, ДокументЭТРН, ТаблицаОшибок);
	
	// валидации титула исправления
	//Если ЗначениеЗаполнено(Объект.НомИспр) Тогда 
