#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Функция Сериализовать(Значение, ТипЛогистическогоДокумента) Экспорт
	
	Если Значение = НеРедактируется Тогда
		Результат = "";
	ИначеЕсли Значение = ДоступныВсеПоля Тогда	
		Если ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ПЭ_Титул1 Тогда	 
			Результат = "AD33FF8A-FD30-4D15-A334-065AE3E2CA62";
		ИначеЕсли ТипЛогистическогоДокумента = Перечисления.КонтурЛогистика_ТипыЛогистическихДокументов.ЗЗ_Титул1 Тогда
			Результат = "8AAFF7BA-FD5E-4346-B615-B1F96455968B";
		Иначе 
			Результат = "";
		КонецЕсли;
	Иначе 
		Результат = "";					
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразует EditingSettingId из Диадок в значение перечисления.
// Пустой идентификатор означает сценарий «Для подписания (не редактируется)».
//
// Параметры:
//  Значение - Строка - GUID EditingSettingId
//  ТипЛогистическогоДокумента - ПеречислениеСсылка.КонтурЛогистика_ТипыЛогистическихДокументов - необязательный
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КонтурЛогистика_СценарииРедактированияШаблона
//
Функция Десериализовать(Значение, ТипЛогистическогоДокумента = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат НеРедактируется;
	КонецЕсли;
	
	Идентификатор = ВРег(СокрЛП(Значение));
	ИдентификаторыДоступноВсе = ИдентификаторыДоступныВсеПоля();
	
	Если ИдентификаторыДоступноВсе.Найти(Идентификатор) <> Неопределено Тогда
		Возврат ДоступныВсеПоля;
	КонецЕсли;
	
	Возврат НеРедактируется;
	
КонецФункции

Функция ИдентификаторыДоступныВсеПоля()
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить("AD33FF8A-FD30-4D15-A334-065AE3E2CA62");
	Идентификаторы.Добавить("8AAFF7BA-FD5E-4346-B615-B1F96455968B");
	
	Возврат Идентификаторы;
	
КонецФункции

// Возвращает описание настройки «Тип шаблона для отправки контрагенту» по значению сценария.
//
// Параметры:
//  СценарийРедактированияШаблона - ПеречислениеСсылка.КонтурЛогистика_СценарииРедактированияШаблона
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеДляНастройки(СценарийРедактированияШаблона) Экспорт
	
	Если СценарийРедактированияШаблона = ДоступныВсеПоля Тогда
		
		Возврат
			"Шаблон для редактирования.
			|Документ, созданный из данного шаблона, контрагент сможет отредактировать - внести дополнения по грузу, адресам или иным данным.";
		
	ИначеЕсли СценарийРедактированияШаблона = НеРедактируется Тогда
		
		Возврат
			"Шаблон для подписания.
			|Документ, созданный из данного шаблона, контрагент сможет только подписать и отправить. Внести изменения в документ нельзя.";
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


#КонецЕсли