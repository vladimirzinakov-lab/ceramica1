#Область СлужебныйПрограммныйИнтерфейс

// Возвращает текст подсказок и шаблонов для редактора кода обработчика партнера.
//
// Параметры:
//  Событие - ПеречислениеСсылка.КонтурЛогистика_СобытияОбработчиковПартнеров
//  ИмяРеквизита - Строка - "Условие" или "ТекстОбработкиПослеЗаполнения"
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстШаблоновПодсказок(Событие, ИмяРеквизита = "") Экспорт
	
	Результат = "";
	
	Если Событие = ПослеЗаполненияТРНт1 Тогда
		
		Если ИмяРеквизита = "Условие" Тогда
			Результат = ТекстШаблоновПодсказокУсловияПослеЗаполненияТРНт1();
		Иначе
			Результат = ТекстШаблоновПодсказокОбработкиПослеЗаполненияТРНт1();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстШаблоновПодсказокУсловияПослеЗаполненияТРНт1()
	
	Возврат
	"Доступна переменная Объект - документ КонтурЛогистика_ТрН_Титул1 (после заполнения).
	|Условие должно вернуть Истина или Ложь через РезультатВычисления.
	|Если вернется Истина - будет выполнен обработчик, если Ложь - обработчик не выполнится
	|
	|// Пример: Истина для четного номера ДокументОснование, Ложь для нечетного / если не заполнен
	|РезультатВычисления = Ложь;
	|Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
	|	НомерДокумента = СокрЛП(Строка(Объект.ДокументОснование.Номер));
	|	Попытка
	|		НомерЧислом = Число(НомерДокумента);
	|		РезультатВычисления = (НомерЧислом % 2 = 0);
	|	Исключение
	|		РезультатВычисления = Ложь;
	|	КонецПопытки;
	|КонецЕсли;";
	
КонецФункции

Функция ТекстШаблоновПодсказокОбработкиПослеЗаполненияТРНт1()
	
	Возврат
	"Доступна переменная Объект - документ КонтурЛогистика_ТрН_Титул1 (после заполнения).
	|
	|// Примеры и шаблоны: (скопируй подходящий фрагмент)
	|
	|// Комментарий (или любой другой реквизит этого титула)
	|Объект.Комментарий = ""Текст комментария"";
	|
	|// СрокДоставки в главном документе ЭТРН
	|ДокументЭТРНОбъект = Объект.ДокументЭТРН.ПолучитьОбъект();
	|ДокументЭТРНОбъект.СрокДоставки = ""15.01.2026"";
	|ДокументЭТРНОбъект.Записать();
	|
	|// Сообщить пользователю
	|Сообщить(""Текст сообщения пользователю"");
	|
	|// ИнфПол (информационные поля)
	|Стр = Объект.ИнфПол.Добавить();
	|Стр.Идентиф = ""МОЙКЛЮЧ"";
	|Стр.Значение = ""Значение информационного поля"";
	|
	|// СопрДок (сопроводительные документы, акты, накладные, УПД итд)
	|
	|Стр = Объект.СопроводительныеДокументы.Добавить();
	|Стр.Тип = Перечисления.КонтурЛогистика_ТипыСопроводительныхДокументов.ДокПерЦенн;
	|Стр.ДокументНаименование = ""Акт"";
	|Стр.ДокументНомер = Значение; // например полученное запросом (пример ниже)
	|Стр.ДокументДата = Объект.ДокументОснование.Дата;
	|Стр.ДокументСоставитель = КонтурЛогистика_КонвертацияСерверПовтИсп.СвязанныйОбъектЛогистики(Объект.ДокументОснование, Перечисления.КонтурЛогистика_СпособыКонвертации.КонвертироватьВОрганизациюДиадок, """");
	|
	|// Запрос
	|Запрос = Новый Запрос;
	|Запрос.Текст = """";
	|Запрос.УстановитьПараметр(""Основание"", Объект.ДокументОснование);
	|Выборка = Запрос.Выполнить().Выбрать();
	|Если Выборка.Следующий() Тогда
	|    Значение = Выборка.Значение;
	|Иначе
	|    Значение = ""-"";
	|КонецЕсли;";
	
КонецФункции

#КонецОбласти

#КонецЕсли
