Функция ПолучитьОрганизациюКорреспондента(п_Организация)

	СпрНастройкиГруппа = Справочники.qw_Константы.НайтиПоНаименованию("Передача товаров между организациями", Истина);
	Если Не ЗначениеЗаполнено(СпрНастройкиГруппа) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Выборка = Справочники.qw_Константы.Выбрать(СпрНастройкиГруппа);
	Пока Выборка.Следующий() Цикл
		Если Выборка.Значение = п_Организация Тогда
			Возврат Выборка.Значения[0].Значение;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Не найдена настройка передачи товаров между организациями");

КонецФункции // ()

Функция СоздатьПередачуНаСервере(п_ЗаказКлиента, п_ОрганизацияПолучатель, п_ОрганизацияОтправитель, Организации)

	УстановитьПривилегированныйРежим(Истина);

	СостояниеЗаказа = ПолучитьСостояниеЗаказа(п_ЗаказКлиента);

	Если СостояниеЗаказа <> Перечисления.СостоянияЗаказовКлиентов.ВПроцессеОтгрузки И СостояниеЗаказа
		<> Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяОплатаПослеОтгрузки И СостояниеЗаказа
		<> Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяПредоплатаДоОтгрузки Тогда
		Сообщить("Не удалось перевести заказ в состояние 'К отгрузке' " + п_ЗаказКлиента);
		ЛогСообщить("Не удалось перевести заказ в состояние 'К отгрузке' " + п_ЗаказКлиента);
		Возврат Ложь;
	КонецЕсли;

	Док = Документы.ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();
	Док.Заполнить(п_ЗаказКлиента);

	Док.Дата					= ТекущаяДатаСеанса();
	Док.Подразделение			= п_ЗаказКлиента.Подразделение;
	Док.Организация				= п_ОрганизацияОтправитель;
	Док.ОрганизацияПолучатель	= п_ОрганизацияПолучатель;
	Док.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию;
	Док.Склад					= п_ЗаказКлиента.Склад;
	Док.ЦенаВключаетНДС			= Истина;
	Док.ДатаПлатежа				= ТекущаяДатаСеанса();
	Док.НалогообложениеНДС		= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;

	Док.Руководитель = "";
	Док.ГлавныйБухгалтер = "";

	Если Док.ОрганизацияПолучатель = Организации.Сергиенко1 Тогда
		Док.ВидЦены	= Справочники.ВидыЦен.НайтиПоНаименованию("Транзит с НДС", Истина);
	ИначеЕсли Док.ОрганизацияПолучатель = Организации.СергиенкоИП Тогда
		Док.ВидЦены	= Справочники.ВидыЦен.НайтиПоНаименованию("Комиссия 5", Истина);
	КонецЕсли;

	Для Каждого Т Из п_ЗаказКлиента.Товары Цикл
		Если Т.ВариантОбеспечения <> Перечисления.ВариантыОбеспечения.Отгрузить Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Т);
		НоваяСтрока.ВидЦены 	= Док.ВидЦены;
		НоваяСтрока.Цена		= ЦенаПоВиду(НоваяСтрока.Номенклатура, Док.ВидЦены, Док.Дата);
		НоваяСтрока.Сумма		= НоваяСтрока.КоличествоУпаковок * НоваяСтрока.Цена;
		НоваяСтрока.СуммаСНДС	= НоваяСтрока.КоличествоУпаковок * НоваяСтрока.Цена;
		Если Док.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС Тогда
			Если Док.ОрганизацияПолучатель = Организации.Сергиенко1 Тогда
				НоваяСтрока.СтавкаНДС	= Перечисления.СтавкиНДС.НДС5;
				НоваяСтрока.СуммаНДС	= НоваяСтрока.СуммаСНДС * 5 / 105;
			Иначе
				НоваяСтрока.СтавкаНДС	= Перечисления.СтавкиНДС.НДС22;
				НоваяСтрока.СуммаНДС	= НоваяСтрока.СуммаСНДС * 22 / 122;
			КонецЕсли;
		Иначе
			НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли;
	КонецЦикла;

	Если Док.Товары.Количество() = 0 Тогда
		ЛогСообщить(" - отмена создания, не заполнена таблица Товары");
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Запись);

		НоваяСтрока = ТЗ_ПередачаТоваров.Добавить();
		НоваяСтрока.Документ = Док.Ссылка;
		НоваяСтрока.ЗаказКлиента = п_ЗаказКлиента;

		ЛогСообщить("Записан документ: " + Док);

	Исключение
		Сообщить("! Ошибка записи: " + Док + " " + ОписаниеОшибки());
		ЛогСообщить("! Ошибка записи: " + Док + " " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Если ЗначениеЗаполнено(Док.Ссылка) Тогда
		Попытка
			Док.Записать(РежимЗаписиДокумента.Проведение);
			ЛогСообщить("Проведен документ: " + Док);
		Исключение
			Сообщить("! Ошибка проведения: " + Док + " " + ОписаниеОшибки());
			ЛогСообщить("! Ошибка проведения: " + Док + " " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;

	ЗначенияДополнительныхРеквизитов = Новый ТаблицаЗначений;
	ЗначенияДополнительныхРеквизитов.Колонки.Добавить("Свойство");
	ЗначенияДополнительныхРеквизитов.Колонки.Добавить("Значение");

	НоваяСтрока = ЗначенияДополнительныхРеквизитов.Добавить();
	НоваяСтрока.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
		"Заказ клиента", Истина);
	НоваяСтрока.Значение = п_ЗаказКлиента.Номер + " от " + Формат(п_ЗаказКлиента.Дата, "ДФ=dd.MM.yyyy");

	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Док.Ссылка, ЗначенияДополнительныхРеквизитов);

	Возврат Истина;

