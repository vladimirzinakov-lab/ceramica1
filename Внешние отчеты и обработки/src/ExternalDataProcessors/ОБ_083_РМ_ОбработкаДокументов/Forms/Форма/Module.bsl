Функция ПолучитьРаспечатано(п_Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияПечатиДокументов.Распечатано КАК Распечатано
	|ИЗ
	|	РегистрСведений.ОД_СостоянияПечатиДокументов КАК СостоянияПечатиДокументов
	|ГДЕ
	|	СостоянияПечатиДокументов.ЗаказКлиента = &Заказ";

	Запрос.УстановитьПараметр("Заказ", п_Заказ);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Распечатано;
	КонецЕсли;

	Возврат Ложь;

КонецФункции // ()

