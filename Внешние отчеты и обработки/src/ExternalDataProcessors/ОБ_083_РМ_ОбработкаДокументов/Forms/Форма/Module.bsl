&НаКлиенте
Процедура СоздатьПередачу(Команда)

	ЛогСообщить("");
	ЛогСообщить(" ~~~~~~~~~~~~~~~~ передача товаров ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");

	Для Каждого Т Из ДЗ_ЗаказыКлиентов.ПолучитьЭлементы() Цикл
		Если Не Т.Выбран Тогда
			Продолжить;
		КонецЕсли;

		Если Т.ФлагПередача > 0 Тогда
			Продолжить;
		КонецЕсли;

		ОрганизацияПолучатель = ЗначениеРеквизитаОбъекта(Т.ЗаказКлиента, "Организация");
		ОрганизацияОтправитель = ПолучитьОрганизациюКорреспондента(ОрганизацияПолучатель);

		ЛогСообщить(" - Организация получатель: " + ОрганизацияПолучатель);
		ЛогСообщить(" - Организация отправитель: " + ОрганизацияОтправитель);

		Если Не ЗначениеЗаполнено(ОрганизацияОтправитель) Тогда
			Сообщить("Не определена организация-отправитель " + Т.ЗаказКлиента + ", " + ОрганизацияПолучатель);
			ЛогСообщить("Не определена организация-отправитель " + Т.ЗаказКлиента + ", " + ОрганизацияПолучатель);
			Возврат;
		КонецЕсли;

		Организации = Организации();

		Если ОрганизацияПолучатель = Организации.Сергиенко1 Тогда

			ЛогСообщить(" - Создание документов, 2 этапа..");

			Рез = СоздатьПередачуНаСервере(Т.ЗаказКлиента, Организации.СергиенкоИП, Организации.ООО, Организации);
			Если Рез Тогда
				ЛогСообщить(" - ..создан документ для заказа: " + Т.ЗаказКлиента + " получатель: "
					+ Организации.СергиенкоИП + " отправитель: " + Организации.ООО);
			Иначе
				ЛогСообщить(" ! Ошибка, первый документ");
			КонецЕсли;

			Рез = СоздатьПередачуНаСервере(Т.ЗаказКлиента, ОрганизацияПолучатель, Организации.СергиенкоИП, Организации);
			Если Рез Тогда
				ЛогСообщить(" - ..создан документ для заказа: " + Т.ЗаказКлиента + " получатель: "
					+ ОрганизацияПолучатель + " отправитель: " + Организации.СергиенкоИП);
			Иначе
				ЛогСообщить(" ! Ошибка, второй документ");
			КонецЕсли;
		Иначе
			ЛогСообщить(" - Создание документов, 1 этап..");
			Рез = СоздатьПередачуНаСервере(Т.ЗаказКлиента, ОрганизацияПолучатель, ОрганизацияОтправитель, Организации);
			Если Рез Тогда
				ЛогСообщить(" - ..создан документ для заказа: " + Т.ЗаказКлиента + " получатель: "
					+ ОрганизацияПолучатель + " отправитель: " + ОрганизацияОтправитель);
			Иначе
				ЛогСообщить(" ! Ошибка, создания документа Передача товаров");
			КонецЕсли;

		КонецЕсли;

		Если Рез Тогда
			КоличествоПередача = ТЗ_ПередачаТоваров.Количество();
			МассивПередача = Новый Массив;
			СтрокиТЗ = ТЗ_ПередачаТоваров.НайтиСтроки(Новый Структура("ЗаказКлиента", Т.ЗаказКлиента));
			Для Каждого ТТ Из СтрокиТЗ Цикл
				МассивПередача.Добавить(ТТ.Документ);
			КонецЦикла;
			Т.ФлагПередача = ПолучитьКартинкуПередача(МассивПередача, Т.ЗаказКлиента);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Напечатать(Команда)

	НайденаСтрока = КомандыПечати.НайтиСтроки(Новый Структура("Идентификатор", Команда.Имя));
	Если НайденаСтрока.Количество() = 0 Тогда
		Сообщить("Не определена команда печати");
		Возврат;
	КонецЕсли;

	ИмяМенеджераПечати		= НайденаСтрока[0].МенеджерПечати;
	Обработчик				= НайденаСтрока[0].Обработчик;
	Идентификатор			= НайденаСтрока[0].Идентификатор;
	ИдентификаторОриг		= НайденаСтрока[0].ИдентификаторОриг;
	ДополнительныеПараметры	= ЗначениеИзСтрокиВн(НайденаСтрока[0].ДополнительныеПараметры);

	МассивОбъектов = Новый Массив;
	МассивЗаказов = Новый Массив;
	Для Каждого СтрокаДЗ Из ДЗ_ЗаказыКлиентов.ПолучитьЭлементы() Цикл

		Если Не СтрокаДЗ.Выбран Тогда
			Продолжить;
		КонецЕсли;

		СтрокиРеализации = ТЗ_Реализация.НайтиСтроки(Новый Структура("ЗаказКлиента", СтрокаДЗ.ЗаказКлиента));
		Для Каждого СтрокаРеализации Из СтрокиРеализации Цикл
			МассивОбъектов.Добавить(СтрокаРеализации.Документ);
		КонецЦикла;
		МассивЗаказов.Добавить(СтрокаДЗ.ЗаказКлиента);
	КонецЦикла;

	Если МассивОбъектов.Количество() = 0 Тогда
		Сообщить("Не определены документы для печати..");
		Возврат;
	КонецЕсли;

	ОписаниеКоманды = Новый Структура;
	ОписаниеКоманды.Вставить("ОбъектыПечати", МассивОбъектов);
	ОписаниеКоманды.Вставить("Идентификатор", ИдентификаторОриг);
	ОписаниеКоманды.Вставить("Форма", ЭтотОбъект);
	ОписаниеКоманды.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);

	Если ЗначениеЗаполнено(ИмяМенеджераПечати) Тогда
		Если ИмяМенеджераПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
			МодульДополнительныеОтчетыИОбработкиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль(
				"ДополнительныеОтчетыИОбработкиКлиент");
			МодульДополнительныеОтчетыИОбработкиКлиент.ВыполнитьНазначаемуюКомандуПечати(ОписаниеКоманды, ЭтотОбъект);
		Иначе
			УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(ИмяМенеджераПечати, ИдентификаторОриг, МассивОбъектов,
				ЭтотОбъект, ДополнительныеПараметры);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Обработчик) Тогда
		Обработчик = Обработчик + "(ОписаниеКоманды)";
		Результат = Вычислить(Обработчик);
	ИначеЕсли Команда.Имя = "КомплектДокументовНаПринтерДоп" Тогда
		П = Новый Структура;
		П.Вставить("МассивОбъектов", МассивОбъектов);
		П.Вставить("МассивЗаказов", МассивЗаказов);
		П.Вставить("КомплектыДокументов", КомплектыДокументов);
		ПечатьКомплектаДокументов(П);
	Иначе
		Сообщить("Не определен обработчик печати");
	КонецЕсли;

	ЗаписатьРаспечатано(МассивЗаказов);
	УстановитьРаспечатано(МассивЗаказов);

КонецПроцедуры

