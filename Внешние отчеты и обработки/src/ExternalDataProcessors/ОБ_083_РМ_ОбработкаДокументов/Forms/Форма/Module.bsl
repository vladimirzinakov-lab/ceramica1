Процедура ВывестиКомандыПечати(п_ТЗКомандыПечати)

	Для Каждого Т Из п_ТЗКомандыПечати Цикл
		Если Т.Порядок = 0 Тогда
			Т.Порядок = 3;
		КонецЕсли;
	КонецЦикла;

	п_ТЗКомандыПечати.Сортировать("Порядок");

	НоваяСтрока = КомандыПечати.Добавить();
	НоваяСтрока.Идентификатор			=  "КомплектДокументовНаПринтерДоп";
	НоваяСтрока.Представление			=  "Комплект документов на принтер (внутр.)";
	НоваяСтрока.ДополнительныеПараметры =  ЗначениеВСтрокуВнутр("");

	Сч = 1;
	Для Каждого Т Из п_ТЗКомандыПечати Цикл

		НоваяСтрока = КомандыПечати.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Т);
		НоваяСтрока.ДополнительныеПараметры =  ЗначениеВСтрокуВнутр(Т.ДополнительныеПараметры);
		НоваяСтрока.ИдентификаторОриг		=  Т.Идентификатор;
		НоваяСтрока.ПредставлениеОриг		=  Т.Представление;

		Если Т.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
			Если СтрНайти(НоваяСтрока.Представление, "*") = 0 Тогда
				НоваяСтрока.Представление =  "* " + Т.Представление;
			КонецЕсли;
		КонецЕсли;

		НайденыСтроки = КомандыПечати.НайтиСтроки(Новый Структура("Идентификатор", Т.Идентификатор));
		Если НайденыСтроки.Количество() > 0 Тогда
			НоваяСтрока.Идентификатор = Т.Идентификатор + "_" + Сч;
			Сч = Сч + 1;
		КонецЕсли;

	КонецЦикла;

	МассивИсключений = ПолучитьМассивИсключений();

	Для Каждого КомандаПечати Из КомандыПечати Цикл

		Если МассивИсключений.Найти(КомандаПечати.Представление) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(КомандаПечати.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		КомандаФормы = Команды.Добавить(КомандаПечати.Идентификатор);
		КомандаФормы.Действие = "Подключаемый_Напечатать";
		КомандаФормы.Заголовок = КомандаПечати.Представление;
		КомандаФормы.Подсказка = КомандаФормы.Заголовок;
		КомандаФормы.Отображение = ОтображениеКнопки.КартинкаИТекст;
		Если ТипЗнч(КомандаПечати.Картинка) = Тип("Картинка") Тогда
			КомандаФормы.Картинка = КомандаПечати.Картинка;
		КонецЕсли;

		КнопкаФормы = Элементы.Добавить(КомандаФормы.Имя, Тип("КнопкаФормы"), Элементы.ПодменюПечать);
		КнопкаФормы.ИмяКоманды = КомандаФормы.Имя;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьКомплектаДокументов(Парам)
	
	Для Каждого ОбъектПечати Из Парам.МассивОбъектов Цикл
		Для Каждого СтрокаКомплекта Из Парам.КомплектыДокументов Цикл
			Если СтрокаКомплекта.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;

			Для Экземпляр = 1 По СтрокаКомплекта.Количество Цикл

				НайденаСтрока = КомандыПечати.НайтиСтроки(Новый Структура("УникальныйИдентификатор",
					СтрокаКомплекта.Идентификатор));
				Если НайденаСтрока.Количество() = 0 Тогда
					Сообщить("Не определена команда печати");
					Возврат;
				КонецЕсли;

				ИмяМенеджераПечати		= НайденаСтрока[0].МенеджерПечати;
				Обработчик				= НайденаСтрока[0].Обработчик;
				Идентификатор			= НайденаСтрока[0].Идентификатор;
				ИдентификаторОриг		= НайденаСтрока[0].ИдентификаторОриг;
				ДополнительныеПараметры	= ЗначениеИзСтрокиВн(НайденаСтрока[0].ДополнительныеПараметры);

				ОписаниеКоманды = Новый Структура;

				ТекущийОбъектПечати = Новый Массив;
				ТекущийОбъектПечати.Добавить(ОбъектПечати);

				ОписаниеКоманды.Вставить("ОбъектыПечати", ТекущийОбъектПечати);
				ОписаниеКоманды.Вставить("Идентификатор", ИдентификаторОриг);
				ОписаниеКоманды.Вставить("Форма", ЭтотОбъект);
				ОписаниеКоманды.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);

				Если ЗначениеЗаполнено(ИмяМенеджераПечати) Тогда
					Если ИмяМенеджераПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
						ТекМенеджерПечати = "Обработка." + ИдентификаторОриг;
						ИД_ПечатнойФормы = "ВнешняяПечатнаяФорма." + ИдентификаторОриг;
						Если СразуНаПринтер Тогда
							УправлениеПечатьюКлиент.ВыполнитьКомандуПечатиНаПринтер(ТекМенеджерПечати,
								ИД_ПечатнойФормы, ТекущийОбъектПечати, ДополнительныеПараметры);
						Иначе
							УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(ТекМенеджерПечати, ИД_ПечатнойФормы,
								ТекущийОбъектПечати, ЭтотОбъект, ДополнительныеПараметры);
						КонецЕсли;
					Иначе
						Если СразуНаПринтер Тогда
							УправлениеПечатьюКлиент.ВыполнитьКомандуПечатиНаПринтер(ИмяМенеджераПечати,
								ИдентификаторОриг, ТекущийОбъектПечати, ДополнительныеПараметры);
						Иначе
							УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(ИмяМенеджераПечати, ИдентификаторОриг,
								ТекущийОбъектПечати, ЭтотОбъект, ДополнительныеПараметры);
						КонецЕсли;
					КонецЕсли;
				Иначе
					Сообщить("Не определен обработчик печати");
				КонецЕсли;

			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ЗаписатьРаспечатано(Парам.МассивЗаказов);
	УстановитьРаспечатано(Парам.МассивЗаказов);

КонецПроцедуры

