#КонецОбласти

#Область ЗаполнитьТаблицуЗаказыКлиентов

Функция ПолучитьКартинкуПередача(п_Массив, п_Заказ)

	Рез = 0;
	Если п_Массив.Количество() > 1 Тогда
		Рез = 4;
	ИначеЕсли п_Массив.Количество() > 0 Тогда
		Рез = 1;
	ИначеЕсли п_Массив.Количество() = 0 Тогда
		ЕстьСтрокаОтгрузить = Ложь;
		Для Каждого Т Из п_Заказ.Товары Цикл
			Если Т.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда
				ЕстьСтрокаОтгрузить = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьСтрокаОтгрузить Тогда
			Рез = 3;
		КонецЕсли;
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()

Функция ПолучитьКартинкуСФ(п_Массив, п_Заказ)

	Если п_Заказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию Тогда
		Возврат 2;
	КонецЕсли;

	Рез = 0;
	Если п_Массив.Количество() > 1 Тогда
		Рез = 4;
	ИначеЕсли п_Массив.Количество() > 0 Тогда
		Рез = 1;
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()

Функция ПолучитьКартинкуРеализация(п_Массив, п_Заказ)

	ПроцентОтгрузки = ПолучитьПроцентОтгрузки(п_Заказ);

	Рез = 0;
	Если п_Массив.Количество() > 1 Тогда
		Рез = 4;
		Если ПроцентОтгрузки < 100 Тогда
			Рез = 7;
		КонецЕсли;
	ИначеЕсли п_Массив.Количество() > 0 Тогда
		Рез = 1;
		Если ПроцентОтгрузки < 100 И п_Заказ.ХозяйственнаяОперация
			<> Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию Тогда
			Рез = 6;
		КонецЕсли;
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()

Функция ПолучитьКартинкуРТО(п_Массив)

	Рез = 0;
	Если п_Массив.Количество() > 1 Тогда
		Рез = 4;
	ИначеЕсли п_Массив.Количество() > 0 Тогда
		ТекСтатус = п_Массив[0].Статус;
		Если ТекСтатус = Перечисления.СтатусыРасходныхОрдеров.Отгружен Или ТекСтатус
			= Перечисления.СтатусыРасходныхОрдеров.КОтгрузке Или ТекСтатус = Перечисления.СтатусыРасходныхОрдеров.Проверен
			Или ТекСтатус = Перечисления.СтатусыРасходныхОрдеров.КОтбору Тогда
			Рез = 1;
		Иначе
			Рез = 5;
		КонецЕсли;
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()

Функция ПолучитьПередачу(п_ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПередачаТоваровМеждуОрганизациямиДополнительныеРеквизиты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПередачаТоваровМеждуОрганизациями.ДополнительныеРеквизиты КАК ПередачаТоваровМеждуОрганизациямиДополнительныеРеквизиты
	|ГДЕ
	|	ПередачаТоваровМеждуОрганизациямиДополнительныеРеквизиты.Свойство = &Свойство
	|	И ПередачаТоваровМеждуОрганизациямиДополнительныеРеквизиты.Значение = &Значение
	|	И ПередачаТоваровМеждуОрганизациямиДополнительныеРеквизиты.Ссылка.Проведен";

	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
		"Заказ клиента", Истина));

	ТекЗначение = п_ЗаказКлиента.Номер + " от " + Формат(п_ЗаказКлиента.Дата, "ДФ=dd.MM.yyyy");

	Запрос.УстановитьПараметр("Значение", ТекЗначение);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции // ()

Функция ПолучитьРеализацию(п_ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка,
	|	ВложенныйЗапрос.Дата КАК Дата
	|ИЗ
	|	(ВЫБРАТЬ
	|		РеализацияТоваровУслуг.Ссылка КАК Ссылка,
	|		РеализацияТоваровУслуг.Дата КАК Дата
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|	ГДЕ
	|		РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента
	|		И РеализацияТоваровУслуг.Проведен
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		РеализацияТоваровУслугТовары.Ссылка,
	|		РеализацияТоваровУслугТовары.Ссылка.Дата
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|	ГДЕ
	|		РеализацияТоваровУслугТовары.ЗаказКлиента = &ЗаказКлиента
	|		И РеализацияТоваровУслугТовары.Ссылка.Проведен) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВложенныйЗапрос.Дата УБЫВ";

	Запрос.УстановитьПараметр("ЗаказКлиента", п_ЗаказКлиента);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции // ()

Функция ПолучитьРТО(п_ЗаказКлиента)

