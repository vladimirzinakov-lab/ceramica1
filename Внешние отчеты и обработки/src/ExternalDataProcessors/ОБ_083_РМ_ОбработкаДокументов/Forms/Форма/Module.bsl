	Возврат 0;

КонецФункции

Функция ВЗаказеТолькоУслуги(п_ЗаказКлиента)

	Для Каждого Т Из п_ЗаказКлиента.Товары Цикл

		Если Т.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется Тогда
			Продолжить;
		КонецЕсли;

		Если Т.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции // ()

Функция ПолучитьСтрокиКЗаполнениюСерийныхНомеров(ВыделенныеСтроки)

	М = Новый Массив;

	Для Каждого п_ЗаказКлиента Из ВыделенныеСтроки Цикл
		Для Каждого Т Из п_ЗаказКлиента.Товары Цикл
			Если Т.Номенклатура.ВидНоменклатуры.ИспользоватьСерии Тогда
				Если Т.Количество > 0 Тогда
					Для А = 0 По Т.Количество - 1 Цикл
						С = Новый Структура;
						С.Вставить("НомерСтроки", Т.НомерСтроки);
						С.Вставить("Номенклатура", Т.Номенклатура);
						С.Вставить("Заказ", п_ЗаказКлиента);
						С.Вставить("ЗаказНаСайте", ПолучитьДатуНомерЗаказаНаСайте(п_ЗаказКлиента));
						М.Добавить(С);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат М;

КонецФункции

