#Область СоздатьСФ

Функция СоздатьСФНаСервере(п_Реализация)

	УстановитьПривилегированныйРежим(Истина);

	Если п_Реализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию Тогда
		Возврат Ложь;
	КонецЕсли;

	ДокТест = Документы.СчетФактураВыданный.НайтиПоНомеру(п_Реализация.Номер, п_Реализация.Дата);
	Если Не ДокТест.Пустая() Тогда
		Сообщить("Создание Счет-фактуры, номер занят: " + п_Реализация.Номер);
		Возврат Ложь;
	КонецЕсли;

	СФ = Документы.СчетФактураВыданный.СоздатьДокумент();

	ДанныеСчетаФактуры = Новый Структура;
	ДанныеСчетаФактуры.Вставить("ДокументОснование", п_Реализация);
	ДанныеСчетаФактуры.Вставить("Организация", п_Реализация.Организация);

	СФ.Заполнить(ДанныеСчетаФактуры);

	СФ.Номер				= п_Реализация.Номер;
	СФ.ПредставлениеНомера	= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(п_Реализация.Номер, Истина, Истина);

	ТаблицаПлатежноРасчетныеДокументы = Новый ТаблицаЗначений;
	ТаблицаПлатежноРасчетныеДокументы.Колонки.Добавить("НомерПлатежноРасчетногоДокумента");
	ТаблицаПлатежноРасчетныеДокументы.Колонки.Добавить("ДатаПлатежноРасчетногоДокумента");

	СписокОснований = Новый СписокЗначений;
	СписокОснований.Добавить(п_Реализация);

	Документы.СчетФактураВыданный.ЗаполнитьПлатежноРасчетныеДокументы(
		ТаблицаПлатежноРасчетныеДокументы, СписокОснований.ВыгрузитьЗначения(), СФ.Организация);

	СФ.ПлатежноРасчетныеДокументы.Загрузить(ТаблицаПлатежноРасчетныеДокументы);
	СФ.СтрокаПлатежноРасчетныеДокументы = Документы.СчетФактураВыданный.СтрокаРасчетноПлатежныхДокументов(
		СФ.ПлатежноРасчетныеДокументы);

	Попытка
		СФ.Записать(РежимЗаписиДокумента.Проведение);

		МассивЗаказы = ПолучитьЗаказы(п_Реализация);
		Для Каждого Т Из МассивЗаказы Цикл
			НоваяСтрока = ТЗ_СчетФактуры.Добавить();
			НоваяСтрока.Документ = СФ.Ссылка;
			НоваяСтрока.ЗаказКлиента = Т;
		КонецЦикла;

		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции // ()

