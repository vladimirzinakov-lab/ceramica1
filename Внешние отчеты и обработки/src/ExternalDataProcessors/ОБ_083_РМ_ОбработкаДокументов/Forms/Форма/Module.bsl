&НаКлиенте
Процедура СоздатьРеализацию(Команда)

	Для Каждого Т Из ДЗ_ЗаказыКлиентов.ПолучитьЭлементы() Цикл
		Если Не Т.Выбран Тогда
			Продолжить;
		КонецЕсли;
		Рез = СоздатьРеализациюНаСервере(Т.ЗаказКлиента);
		Если Рез Тогда
			КоличествоРеализация = ТЗ_Реализация.Количество();
			МассивРеализация = ПолучитьРеализацию(Т.ЗаказКлиента);
			Т.ФлагРеализация = ПолучитьКартинкуРеализация(МассивРеализация, Т.ЗаказКлиента);
			Т.Состояние = ПолучитьСостояниеЗаказа(Т.ЗаказКлиента);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализациюСчетФактуру(Команда)

	Для Каждого Т Из ДЗ_ЗаказыКлиентов.ПолучитьЭлементы() Цикл
		Если Не Т.Выбран Тогда
			Продолжить;
		КонецЕсли;
		Рез = СоздатьРеализациюНаСервере(Т.ЗаказКлиента);
		Если Рез Тогда
			КоличествоРеализация = ТЗ_Реализация.Количество();
			МассивРеализация	= ПолучитьРеализацию(Т.ЗаказКлиента);
			Т.ФлагРеализация = ПолучитьКартинкуРеализация(МассивРеализация, Т.ЗаказКлиента);
			Т.Состояние		 = ПолучитьСостояниеЗаказа(Т.ЗаказКлиента);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Т Из ДЗ_ЗаказыКлиентов.ПолучитьЭлементы() Цикл
		Если Не Т.Выбран Тогда
			Продолжить;
		КонецЕсли;

		НайденыСтроки = ТЗ_Реализация.НайтиСтроки(Новый Структура("ЗаказКлиента", Т.ЗаказКлиента));

		Рез = Ложь;
		Для Каждого ТТ Из НайденыСтроки Цикл
			Рез = СоздатьСФНаСервере(ТТ.Документ);
		КонецЦикла;

		Если Рез Тогда
			КоличествоСчетФактура = ТЗ_СчетФактуры.Количество();

			МассивСФ = Новый Массив;
			МассивРеализация = ПолучитьРеализацию(Т.ЗаказКлиента);
			Для Каждого ТТ Из МассивРеализация Цикл
				СчетФактура	= ПолучитьСчетФактуру(ТТ);
				Если ЗначениеЗаполнено(СчетФактура) Тогда
					МассивСФ.Добавить(СчетФактура);
				КонецЕсли;
			КонецЦикла;

			Т.ФлагСчетФактура = ПолучитьКартинкуСФ(МассивСФ, Т.ЗаказКлиента);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

