Функция СоздатьРеализациюНаСервере(ТекущийЗаказ)

	УстановитьПривилегированныйРежим(Истина);

	Если Не ВЗаказеТолькоУслуги(ТекущийЗаказ) Тогда
		ПроцентОтгрузки = ПолучитьПроцентОтгрузки(ТекущийЗаказ);
		Если ПроцентОтгрузки = 100 Тогда
			Сообщить("" + ТекущийЗаказ + " полностью реализован");
			Возврат Ложь;
		КонецЕсли;
		СостояниеЗаказа = ПолучитьСостояниеЗаказа(ТекущийЗаказ);
		Если СостояниеЗаказа <> Перечисления.СостоянияЗаказовКлиентов.ВПроцессеОтгрузки И СостояниеЗаказа
			<> Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяОбеспечение Тогда
			Сообщить("Не удалось перевести заказ в состояние 'К отгрузке' " + ТекущийЗаказ);
			Сообщить("Требуется состояние 'В процессе отгрузки' или 'Ожидается обеспечение'" + ТекущийЗаказ);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	РТО_ВСтатусе = Ложь;
	МассивРТО = ПолучитьРТО(ТекущийЗаказ);
	Для Каждого РТО Из МассивРТО Цикл
		Если РТО.Статус = Перечисления.СтатусыРасходныхОрдеров.КОтгрузке Или РТО.Статус
			= Перечисления.СтатусыРасходныхОрдеров.Проверен Или РТО.Статус = Перечисления.СтатусыРасходныхОрдеров.КОтбору
			Или РТО.Статус = Перечисления.СтатусыРасходныхОрдеров.КПроверке Тогда
			РТО_ВСтатусе = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не РТО_ВСтатусе Тогда
		Сообщить("Расходный ордер на товары должен быть в статусе К отгрузке, К отбору, К проверке или Проверен");
		Возврат Ложь;
	КонецЕсли;

	Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Док.Заполнить(ТекущийЗаказ);

	Док.Дата				= ТекущаяДатаСеанса();
	Док.Подразделение		= ТекущийЗаказ.Подразделение;
	Док.СкидкиРассчитаны	= Истина;

	Если Док.Товары.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Т Из Док.Товары Цикл
		Если Т.ПроцентАвтоматическойСкидки <> 0 И Т.СуммаАвтоматическойСкидки = 0 Тогда
			Т.СуммаАвтоматическойСкидки = Т.Цена * Т.КоличествоУпаковок - Т.СуммаСНДС;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);

		НоваяСтрока = ТЗ_Реализация.Добавить();
		НоваяСтрока.Документ = Док.Ссылка;
		НоваяСтрока.ЗаказКлиента = ТекущийЗаказ;

		Возврат Истина;
	Исключение
		Сообщить("Ошибка записи: " + Док + " " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

