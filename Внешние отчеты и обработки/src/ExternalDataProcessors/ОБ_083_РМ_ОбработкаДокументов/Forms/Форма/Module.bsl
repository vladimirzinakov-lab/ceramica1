КонецФункции // ()

Функция ПолучитьСчетФактуру(п_Реализация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.Проведен";

	Запрос.УстановитьПараметр("ДокументОснование", п_Реализация);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

КонецФункции // ()

Процедура ЗаполнитьТаблицуЗаказыКлиентовНаСервере(п_ДатаОтгрузки)

	УстановитьПривилегированныйРежим(Истина);

	ТЗ_РТО.Очистить();
	ТЗ_Реализация.Очистить();
	ТЗ_СчетФактуры.Очистить();
	ТЗ_ПередачаТоваров.Очистить();

	Запрос = Новый Запрос;
	ЗапросТекст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Количество КАК Количество,
	|	ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения,
	|	ЗаказКлиентаТовары.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ЗаказКлиентаТовары.Ссылка.Партнер КАК Партнер,
	|	ЗаказКлиентаТовары.Ссылка.Организация КАК Организация,
	|	СостоянияЗаказовКлиентов.Состояние КАК Состояние
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ЗаказКлиентаТовары.Ссылка = СостоянияЗаказовКлиентов.Заказ
	|ГДЕ
	|	ЗаказКлиентаТовары.ДатаОтгрузки = &ДатаОтгрузки
	|	И ЗаказКлиентаТовары.Ссылка.Проведен
	|	И СостоянияЗаказовКлиентов.Состояние = &Состояние
	|	И ЗаказКлиентаТовары.Ссылка.Партнер В(&Партнер)
	|	И ЗаказКлиентаТовары.Ссылка.СпособДоставки = &СпособДоставки
	|ИТОГИ
	|	МАКСИМУМ(Состояние)
	|ПО
	|	ЗаказКлиента";

	Запрос.УстановитьПараметр("ДатаОтгрузки", п_ДатаОтгрузки);

	Если ЗначениеЗаполнено(ОтборСостояние) Тогда
		Запрос.УстановитьПараметр("Состояние", ОтборСостояние);
	Иначе
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "И СостоянияЗаказовКлиентов.Состояние = &Состояние", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборСпособДоставки) Тогда
		Запрос.УстановитьПараметр("СпособДоставки", ОтборСпособДоставки);
	Иначе
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "И ЗаказКлиентаТовары.Ссылка.СпособДоставки = &СпособДоставки", "");
	КонецЕсли;

#Область Партнеры

	СКД = ПолучитьИзВременногоХранилища(АдресСхемы);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, ОтборПартнеры.Настройки, , , Тип(
		"ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ_Отбор = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);

	М_Отбор = ТЗ_Отбор.ВыгрузитьКолонку("Партнер");

	Если ЗначениеЗаполнено(М_Отбор.Количество() > 0) Тогда
		Запрос.УстановитьПараметр("Партнер", М_Отбор);
	Иначе
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "И ЗаказКлиентаТовары.Ссылка.Партнер В(&Партнер)", "");
	КонецЕсли;

#КонецОбласти

	Запрос.Текст = ЗапросТекст;

	РезультатЗапроса = Запрос.Выполнить();

	ДеревоЗначения = РеквизитФормыВЗначение("ДЗ_ЗаказыКлиентов");
	ДеревоЗначения.Строки.Очистить();
	Элементы.ДЗ_ЗаказыКлиентов.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;

	ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	КоличествоРТО = 0;
	КоличествоПередача = 0;
	КоличествоРеализация = 0;
	КоличествоСчетФактура = 0;

	Пока ВыборкаЗаказ.Следующий() Цикл

		СтрокаЗаказ = ДеревоЗначения.Строки.Добавить();

		ЗаполнитьЗначенияСвойств(СтрокаЗаказ, ВыборкаЗаказ);

		СтрокаЗаказ.Выбран = Истина;

		МассивРТО = ПолучитьРТО(ВыборкаЗаказ.ЗаказКлиента);
		СтрокаЗаказ.ФлагРасходныйОрдер = ПолучитьКартинкуРТО(МассивРТО);
		КоличествоРТО = КоличествоРТО + МассивРТО.Количество();
		Для Каждого Т Из МассивРТО Цикл
			НоваяСтрока = ТЗ_РТО.Добавить();
			НоваяСтрока.Документ = Т.Ссылка;
			НоваяСтрока.ЗаказКлиента = ВыборкаЗаказ.ЗаказКлиента;
		КонецЦикла;

		МассивРеализация = ПолучитьРеализацию(ВыборкаЗаказ.ЗаказКлиента);
		СтрокаЗаказ.ФлагРеализация = ПолучитьКартинкуРеализация(МассивРеализация, ВыборкаЗаказ.ЗаказКлиента);
		КоличествоРеализация = КоличествоРеализация + МассивРеализация.Количество();
		МассивСФ = Новый Массив;
		Для Каждого Т Из МассивРеализация Цикл
			НоваяСтрока = ТЗ_Реализация.Добавить();
			НоваяСтрока.Документ = Т.Ссылка;
			НоваяСтрока.ЗаказКлиента = ВыборкаЗаказ.ЗаказКлиента;

			СчетФактура	= ПолучитьСчетФактуру(Т.Ссылка);
			Если ЗначениеЗаполнено(СчетФактура) Тогда
				НоваяСтрока = ТЗ_СчетФактуры.Добавить();
				НоваяСтрока.Документ = СчетФактура;
				НоваяСтрока.ЗаказКлиента = ВыборкаЗаказ.ЗаказКлиента;
				КоличествоСчетФактура = КоличествоСчетФактура + 1;
				МассивСФ.Добавить(СчетФактура);
			КонецЕсли;
		КонецЦикла;

		СтрокаЗаказ.ФлагСчетФактура = ПолучитьКартинкуСФ(МассивСФ, ВыборкаЗаказ.ЗаказКлиента);

		МассивПередача = ПолучитьПередачу(ВыборкаЗаказ.ЗаказКлиента);

		СтрокаЗаказ.ФлагПередача = ПолучитьКартинкуПередача(МассивПередача, ВыборкаЗаказ.ЗаказКлиента);

		КоличествоПередача = КоличествоПередача + МассивПередача.Количество();
		Для Каждого Т Из МассивПередача Цикл
			НоваяСтрока = ТЗ_ПередачаТоваров.Добавить();
			НоваяСтрока.Документ = Т.Ссылка;
			НоваяСтрока.ЗаказКлиента = ВыборкаЗаказ.ЗаказКлиента;
		КонецЦикла;

		ВыборкаНоменклатура = ВыборкаЗаказ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаНоменклатура.Следующий() Цикл
			СтрокаНоменклатура = СтрокаЗаказ.Строки.Добавить();
			СтрокаНоменклатура.Номенклатура			= ВыборкаНоменклатура.Номенклатура;
			СтрокаНоменклатура.ВариантОбеспечения	= ВыборкаНоменклатура.ВариантОбеспечения;
			СтрокаНоменклатура.Количество			= ВыборкаНоменклатура.Количество;
		КонецЦикла;

		СтрокаЗаказ.Распечатано = ПолучитьРаспечатано(ВыборкаЗаказ.ЗаказКлиента);

	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоЗначения, "ДЗ_ЗаказыКлиентов");

КонецПроцедуры

#КонецОбласти

#Область СоздатьРеализацию

Функция ПолучитьЗаказы(п_Реализация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		РеализацияТоваровУслуг.ЗаказКлиента КАК ЗаказКлиента
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|	ГДЕ
	|		РеализацияТоваровУслуг.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		РеализацияТоваровУслугТовары.ЗаказКлиента
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|	ГДЕ
	|		РеализацияТоваровУслугТовары.Ссылка = &Ссылка) КАК ВложенныйЗапрос";

	Запрос.УстановитьПараметр("Ссылка", п_Реализация);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказКлиента");

КонецФункции // ()

Функция ПолучитьОстаткиПоОрганизации(п_Организация, п_Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыОрганизацийОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций.Остатки(
	|			,
	|			Организация = &Организация
	|				И АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура) КАК ТоварыОрганизацийОстатки";

	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	Запрос.УстановитьПараметр("Организация", п_Организация);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоОстаток;
	КонецЕсли;

	Возврат 0;

КонецФункции // ()

