Функция ЦенаПоВиду(п_Номенклатура, п_ВидЦены, п_Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦены,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних";

	Запрос.УстановитьПараметр("ВидЦены", п_ВидЦены);
	Запрос.УстановитьПараметр("ДатаЦены", п_Дата);
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;

	Возврат 0;

