Функция ТребуетсяРазбивкаПоОрганизациям(п_ТочкаМаршрута)

	Рез = Новый Структура();
	
	Запрос = Новый Запрос;
	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение.СпособДоставки КАК СпособДоставки
		|ИЗ
