Функция СуммаКПолучению_РассчитатьПоПКО(п_ЗаказКлиента)
	
	Рез = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.СуммаДокумента), 0) КАК Сумма
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
		|ГДЕ
		|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.ОснованиеПлатежа = &Заказ
		|	И ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Заказ", п_ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Рез = Выборка.Сумма;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|ГДЕ
		|	РеализацияТоваровУслугТовары.ЗаказКлиента = &ЗаказКлиента
		|	И РеализацияТоваровУслугТовары.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", п_ЗаказКлиента);
	
	М_Реализация = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.СуммаДокумента), 0) КАК Сумма
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
		|ГДЕ
		|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.ОснованиеПлатежа В(&Реализация)
		|	И ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Проведен";

	Запрос.УстановитьПараметр("Реализация", М_Реализация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Рез = Рез + Выборка.Сумма;
	КонецЦикла;
		
	Возврат Рез;
	
КонецФункции // ()

Функция ДанныеТочкиМаршрута(п_ЗаданиеНаПеревозку, п_ТочкаМаршрута, п_Организация)
	
	Рез = Новый Структура();
	
	Запрос = Новый Запрос;
	ЗапросТекст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение КАК Распоряжение
		|ИЗ
		|	Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
		|ГДЕ
		|	ЗаданиеНаПеревозкуРаспоряжения.КлючСвязи = &КлючСвязи
		|	И ЗаданиеНаПеревозкуРаспоряжения.Распоряжение.Организация = &Организация";
	
	Запрос.УстановитьПараметр("КлючСвязи", п_ТочкаМаршрута.КлючСвязи);

	Если ПустаяСтрока(п_Организация) Тогда
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "И ЗаданиеНаПеревозкуРаспоряжения.Распоряжение.Организация = &Организация", "");
	Иначе
		Запрос.УстановитьПараметр("Организация", п_Организация);
	КонецЕсли;	
	
	Запрос.Текст = ЗапросТекст;
	
	Распоряжения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Распоряжение");
	
    НомераРеализацииОбщий = Новый Массив;
    ДополнительныеУслугиОбщие = Новый Массив;

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Распоряжение",								Документы.ТипВсеСсылки());
	ТЗ.Колонки.Добавить("РеализацияНомер",							Новый ОписаниеТипов("Массив"));
	ТЗ.Колонки.Добавить("СпособДоставки",							Новый ОписаниеТипов("ПеречислениеСсылка.СпособыДоставки"));
	ТЗ.Колонки.Добавить("Перевозчик",								Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТЗ.Колонки.Добавить("Получатель",								Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТЗ.Колонки.Добавить("ИНН",										ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("Менеджер",									Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ТЗ.Колонки.Добавить("МенеджерТелефон",							ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("АдресДоставки",							ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("ДанныеПолучателя",							ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("ДанныеПолучателяКонтакты",					ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("Контакты",									ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("ВремяДоставки",							ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("ВремяДоставкиКонтакты",					ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТЗ.Колонки.Добавить("ДополнительныеУслуги",						Новый ОписаниеТипов("Массив"));
	ТЗ.Колонки.Добавить("ДополнительнаяИнформацияДоставки",			ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("ДополнительнаяИнформацияДоставкиКонтакты",	ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("Мест",										ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	ТЗ.Колонки.Добавить("Сумма",									ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТЗ.Колонки.Добавить("Страховка",								ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТЗ.Колонки.Добавить("Вес",										ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	ТЗ.Колонки.Добавить("Объем",									ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	ТЗ.Колонки.Добавить("ДоставкаДоТК",								ОбщегоНазначения.ОписаниеТипаЧисло(10));
	ТЗ.Колонки.Добавить("Плательщик",								ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТЗ.Колонки.Добавить("Отправитель",								ОбщегоНазначения.ОписаниеТипаСтрока(1000));

	Для каждого Распоряжение Из Распоряжения Цикл
		
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Распоряжение = Распоряжение;
		
		Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ЗаказКлиента")
			ИЛИ ТипЗнч(Распоряжение) = Тип("ДокументСсылка.Рекламация") Тогда

			НоваяСтрока.РеализацияНомер 	= ПолучитьНомераРеализации(Распоряжение);
			НоваяСтрока.СпособДоставки		= Распоряжение.СпособДоставки;
			НоваяСтрока.Перевозчик			= Распоряжение.ПеревозчикПартнер;
			НоваяСтрока.Получатель			= Распоряжение.Партнер;
			НоваяСтрока.ДанныеПолучателя	= Распоряжение.ДанныеПолучателя;
			
			Если ЗначениеЗаполнено(Распоряжение.Менеджер.ФизическоеЛицо) Тогда
				НоваяСтрока.Менеджер		= Распоряжение.Менеджер.ФизическоеЛицо;
				НоваяСтрока.МенеджерТелефон	= ПолучитьТелефонФизЛица(Распоряжение.Менеджер.ФизическоеЛицо);
			Иначе
				Сообщить("Установите Физическое лицо у пользователя (менеджера): " + Распоряжение);
			КонецЕсли;

			Если Распоряжение.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу
				ИЛИ Распоряжение.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика Тогда 
				НоваяСтрока.ДоставкаДоТК = 1;
				НоваяСтрока.АдресДоставки = Распоряжение.АдресДоставкиПеревозчика;
			ИначеЕсли Распоряжение.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента 
				ИЛИ Распоряжение.СпособДоставки = Перечисления.СпособыДоставки.КПолучателюОпределяетСлужбаДоставки Тогда
				НоваяСтрока.АдресДоставки = Распоряжение.АдресДоставки;
			КонецЕсли;

			Если ЗначениеЗаполнено(НоваяСтрока.АдресДоставки) Тогда
				ДопКИ_ИзАдреса = ОД_Логистика.ПолучитьКонтактыИзАдреса(НоваяСтрока.АдресДоставки);
				НоваяСтрока.Контакты = ДопКИ_ИзАдреса.Телефон + ", " + ДопКИ_ИзАдреса.КонтактноеЛицо;
			КонецЕсли;

			Если ЗначениеЗаполнено(НоваяСтрока.ДанныеПолучателя) Тогда
				ДопКИ_ИзАдреса = ОД_Логистика.ПолучитьКонтактыИзАдреса(НоваяСтрока.ДанныеПолучателя);
				НоваяСтрока.ДанныеПолучателяКонтакты = ДопКИ_ИзАдреса.Телефон + ", " + ДопКИ_ИзАдреса.КонтактноеЛицо;
				НоваяСтрока.ВремяДоставкиКонтакты = "с " + Формат(ДопКИ_ИзАдреса.ВремяДоставкиС, "ДФ=ЧЧ:мм") + " по " + Формат(ДопКИ_ИзАдреса.ВремяДоставкиПо, "ДФ=ЧЧ:мм");
				НоваяСтрока.ДополнительнаяИнформацияДоставкиКонтакты = ДопКИ_ИзАдреса.ДополнительнаяИнформацияПоДоставке;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Распоряжение.ВремяДоставкиС) 
				И ЗначениеЗаполнено(Распоряжение.ВремяДоставкиПо) Тогда
				НоваяСтрока.ВремяДоставки = "с " + Формат(Распоряжение.ВремяДоставкиС, "ДФ=ЧЧ:мм")+ " по " + Формат(Распоряжение.ВремяДоставкиПо, "ДФ=ЧЧ:мм");
			КонецЕсли;

			НоваяСтрока.ДополнительнаяИнформацияДоставки = Распоряжение.ДополнительнаяИнформацияПоДоставке;
			
			ВесОбъем = ОД_ОбщиеФункции.ПолучитьВесОбъемДляДокумента(Распоряжение);
			НоваяСтрока.Вес		= ВесОбъем.Вес;
			НоваяСтрока.Объем	= ВесОбъем.Объем;

			НоваяСтрока.ДополнительныеУслуги = ПолучитьДополнительныеУслугиДоставки(Распоряжение);
			
			НоваяСтрока.Сумма = СуммаКПолучению(Распоряжение);
			
			Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				НоваяСтрока.Мест = Распоряжение.Товары.Итог("КоличествоУпаковок");
				Если ЗначениеЗаполнено(Распоряжение.Проект) Тогда
					НоваяСтрока.Плательщик = Распоряжение.Организация.Наименование;
				Иначе
					НоваяСтрока.Плательщик = Распоряжение.Партнер.Наименование;
				КонецЕсли;
			ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.Рекламация") Тогда
				НоваяСтрока.Мест = Распоряжение.Товары.Итог("Количество");
			КонецЕсли;

			НоваяСтрока.Страховка = Страховка(Распоряжение);
			
			Если Распоряжение.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо
				ИЛИ Распоряжение.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
				НоваяСтрока.ИНН = "ИНН "+ Распоряжение.Контрагент.ИНН;
			Иначе
				ДанныеПаспорта = ДанныеПаспорта(Распоряжение.Контрагент);
				НоваяСтрока.ИНН = "ИНН "+ Распоряжение.Контрагент.ИНН + " (Паспорт" + ДанныеПаспорта + ")";
			КонецЕсли;

			НоваяСтрока.Отправитель = "" + Распоряжение.Организация.НаименованиеПолное + ", ИНН: " + Распоряжение.Организация.ИНН;
			
		ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
			
			НоваяСтрока.РеализацияНомер.Добавить(ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Распоряжение.Номер));
			
			НоваяСтрока.Мест =  Распоряжение.Товары.Итог("КоличествоУпаковок");
			
			ВесОбъем = ОД_ОбщиеФункции.ПолучитьВесОбъемДляДокумента(Распоряжение);
			НоваяСтрока.Вес		= ВесОбъем.Вес;
			НоваяСтрока.Объем	= ВесОбъем.Объем;
		КонецЕсли;

	КонецЦикла;
	
	ТЗ.Свернуть("Распоряжение,
		| РеализацияНомер,
		| СпособДоставки,
		| Перевозчик,
		| Получатель,
		| ИНН,
		| ДанныеПолучателя,
		| ДанныеПолучателяКонтакты,
		| Менеджер,
		| МенеджерТелефон,
		| АдресДоставки,
		| Контакты,
		| ВремяДоставки,
		| ВремяДоставкиКонтакты,
		| ДополнительныеУслуги,
		| ДополнительнаяИнформацияДоставки,
		| ДополнительнаяИнформацияДоставкиКонтакты,
		| Плательщик,
		| Отправитель",
			"Мест, Сумма, Страховка, Вес, Объем, ДоставкаДоТК");
	
	Возврат ТЗ;
	
КонецФункции // ()

Функция КолонкуВСтроку(ТЗ, Колонка)
	
	М = Новый Массив;
	Для каждого Т Из ТЗ Цикл
		Если ЗначениеЗаполнено(Т[Колонка])
			И М.Найти(Т[Колонка]) = Неопределено Тогда
			М.Добавить(Т[Колонка]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(М, ", ");

КонецФункции // ()

Функция КолонкуМассивВСтроку(ТЗ, Колонка)

	М = Новый Массив;
	Для каждого Т Из ТЗ Цикл
		Для каждого Номер Из Т[Колонка] Цикл
			Если ЗначениеЗаполнено(Номер)
				И М.Найти(Номер) = Неопределено Тогда
				М.Добавить(Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СтрСоединить(М, ", ");

КонецФункции // ()

Функция Страховка(п_ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка,
		|	РеализацияТоваровУслугТовары.Ссылка.Дата КАК Дата,
		|	РеализацияТоваровУслугТовары.Ссылка.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|ГДЕ
		|	РеализацияТоваровУслугТовары.ЗаказКлиента = &ЗаказКлиента
		|	И РеализацияТоваровУслугТовары.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", п_ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();

	// при частичной отгрузке контролируем дату документа
	НачалоТекДня = НачалоДня(ТекущаяДатаСеанса());
	СуммаОтгрузки = 0;
	
	Если Выборка.Количество() > 1 Тогда
		Пока Выборка.Следующий() Цикл
			Если Выборка.Дата < НачалоТекДня Тогда
				Продолжить;
			КонецЕсли;
			СуммаОтгрузки = СуммаОтгрузки + Выборка.СуммаДокумента;
		КонецЦикла;
	Иначе
		Пока Выборка.Следующий() Цикл
			СуммаОтгрузки = СуммаОтгрузки + Выборка.СуммаДокумента;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СуммаОтгрузки;

КонецФункции // ()

Функция ДанныеПаспорта(п_Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументыФизическихЛиц.Серия КАК Серия,
		|	ДокументыФизическихЛиц.Номер КАК Номер
		|ИЗ
		|	РегистрСведений.ДокументыФизическихЛиц КАК ДокументыФизическихЛиц
		|ГДЕ
		|	ДокументыФизическихЛиц.Физлицо = &ФизЛицо
		|	И ДокументыФизическихЛиц.ВидДокумента = &ВидДокумента";
	
	Запрос.УстановитьПараметр("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.НайтиПоНаименованию("Паспорт гражданина РФ", Истина));
	Запрос.УстановитьПараметр("ФизЛицо", п_Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Серия + " " + Выборка.Номер;
	КонецЕсли;

КонецФункции // ()

