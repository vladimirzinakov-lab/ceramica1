		|ГДЕ
		|	ЗаданиеНаПеревозкуРаспоряжения.КлючСвязи = &КлючСвязи";
	
	Запрос.УстановитьПараметр("КлючСвязи", п_ТочкаМаршрута.КлючСвязи);
	
	Запрос.Текст = ЗапросТекст;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу
			ИЛИ Выборка.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика Тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

