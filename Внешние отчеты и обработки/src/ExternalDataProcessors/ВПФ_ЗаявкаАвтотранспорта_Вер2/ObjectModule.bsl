Перем ПараметрыПечати Экспорт;
Перем ТемаПисьма;

#Область ПрограммныйИнтерфейс

// Возвращает сведения о внешней обработке.
Функция СведенияОВнешнейОбработке() Экспорт
    
    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.0.1.1");
    
    ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
    ПараметрыРегистрации.Версия = ЭтотОбъект.Метаданные().Комментарий;
	ПараметрыРегистрации.БезопасныйРежим = Истина;
	
    ПараметрыРегистрации.Назначение.Добавить("Документ.ЗаданиеНаПеревозку");
	ПараметрыРегистрации.Назначение.Добавить("Документ.ЗаказКлиента");
	ПараметрыРегистрации.Назначение.Добавить("Документ.РеализацияТоваровУслуг");
	
    КомандаПечати = ПараметрыРегистрации.Команды.Добавить();
	КомандаПечати.Идентификатор = "ЗаявкаАвтотранспортаВер2";
	КомандаПечати.Представление = НСтр("ru = '* Заявка автотранспорта (вер.2)'");
    КомандаПечати.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
    КомандаПечати.ПоказыватьОповещение = Ложь;
    КомандаПечати.Модификатор = "ПечатьMXL";
	
    Возврат ПараметрыРегистрации;
    
КонецФункции

#КонецОбласти

#Область Печать

Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ТемаПисьма = "";
	            
	Если НЕ УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаявкаАвтотранспортаВер2") Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйДокумент = МассивОбъектов[0];
	ПервыйДокументТип = ТипЗнч(ПервыйДокумент);
	
	Если ПервыйДокументТип = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
	
		// вызов:
		// - из документа Задание на перевозку
			// если пользователь выбрал точки маршрута, то добавим для них ключи связи
		КлючДобавлен = Ложь;
		МассивОбъектовПечати = Новый Массив;
		Для каждого ТекДок Из МассивОбъектов Цикл
			Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
				МассивОбъектовПечати.Добавить(ТекДок);
				Для каждого Пункт Из ТекДок.Маршрут Цикл
					Если Пункт.Доставлено Тогда
						МассивОбъектовПечати.Добавить(Пункт.КлючСвязи);
						КлючДобавлен = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
			
		// если пользователь не выбрал точки маршрута, то добавим все ключи связи
		Если НЕ КлючДобавлен Тогда
			Для каждого Пункт Из ТекДок.Маршрут Цикл
				МассивОбъектовПечати.Добавить(Пункт.КлючСвязи);
			КонецЦикла;
		КонецЕсли;
		
		ПараметрыПечати = Новый Структура;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ЗаявкаАвтотранспортаВер2",
			НСтр("ru='* Заявка автотранспорта (вер.2)'"),
			СформироватьПечатнуюФорму(МассивОбъектовПечати, ОбъектыПечати, ПараметрыПечати));
		
	ИначеЕсли ПервыйДокументТип = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
	
		// вызов:
		// - из обработки РМ Обработка документов, 
			// придет массив РТиУ без ключей связи, 
			// здесь РТиУ заменим на Задание на перевозку и добавим ключи связи 
		
		// - из документа РТиУ, печать комплектов и для обычной печати
			// придет один РТиУ без ключа связи
			// здесь РТиУ заменим на Задание на перевозку и добавим один ключ связи 
		МассивОбъектовПечати = Новый Массив;
		Для каждого ТекДок Из МассивОбъектов Цикл
			Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				ДанныеЗаданиеНаПеревозку = ЗаданиеНаПеревозкуДляРеализации(ТекДок);
				
				Если ПустаяСтрока(ДанныеЗаданиеНаПеревозку.КлючСвязи) Тогда
					Сообщить("! не определен документ Задание на перевозку: " + ТекДок);
					Продолжить;
				КонецЕсли;
				
				МассивОбъектовПечати.Добавить(ДанныеЗаданиеНаПеревозку.ЗаданиеНаПеревозку);
				МассивОбъектовПечати.Добавить(ДанныеЗаданиеНаПеревозку.КлючСвязи);
			КонецЕсли;
		КонецЦикла;
	
		ПараметрыПечати = Новый Структура;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ЗаявкаАвтотранспортаВер2",
			НСтр("ru='* Заявка автотранспорта (вер.2)'"),
			СформироватьПечатнуюФорму(МассивОбъектовПечати, ОбъектыПечати, ПараметрыПечати));
			
	ИначеЕсли ПервыйДокументТип = Тип("ДокументСсылка.ЗаказКлиента") Тогда
	
		// - из документа Заказ клиента
				// придет документ Задание на перевозку и один ключ связи
		МассивОбъектовПечати = Новый Массив;
		Для каждого ТекДок Из МассивОбъектов Цикл
			Если ТипЗнч(ТекДок) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				ДанныеЗаданиеНаПеревозку = ЗаданиеНаПеревозкуДляЗаказаКлиента(ТекДок);
				
				Если ПустаяСтрока(ДанныеЗаданиеНаПеревозку.КлючСвязи) Тогда
					Сообщить("! не определен документ Задание на перевозку: " + ТекДок);
					Продолжить;
				КонецЕсли;
				
				МассивОбъектовПечати.Добавить(ДанныеЗаданиеНаПеревозку.ЗаданиеНаПеревозку);
				МассивОбъектовПечати.Добавить(ДанныеЗаданиеНаПеревозку.КлючСвязи);
			КонецЕсли;
		КонецЦикла;
	
		ПараметрыПечати = Новый Структура;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ЗаявкаАвтотранспортаВер2",
			НСтр("ru='* Заявка автотранспорта (вер.2)'"),
			СформироватьПечатнуюФорму(МассивОбъектовПечати, ОбъектыПечати, ПараметрыПечати));

	КонецЕсли;
		
	//ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	//ПараметрыВывода.ПараметрыОтправки.Тема = ТемаПисьма;
	
КонецПроцедуры // Печать()

Функция СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, КомплектыПечати = Неопределено) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаАвтотранспорта";
	
	НомерДокумента = 0;
	
	УстановитьПривилегированныйРежим(Истина);

	ТЗ_ОрганизацияИКлюч = Новый ТаблицаЗначений;
	ТЗ_ОрганизацияИКлюч.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТЗ_ОрганизацияИКлюч.Колонки.Добавить("КлючСвязи", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТЗ_ОрганизацияИКлюч.Колонки.Добавить("СпособДоставки", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыДоставки"));
	
	КлючиСвязи = Новый Массив;
	Для каждого Т Из МассивОбъектов Цикл
		Если ТипЗнч(Т) = Тип("Строка") Тогда
			КлючиСвязи.Добавить(Т);
		КонецЕсли;
	КонецЦикла;

	Для каждого Т Из МассивОбъектов Цикл
		Если ТипЗнч(Т) = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
			Для каждого ТекСтрокаТЧ Из Т.Распоряжения Цикл
				ТекРаспоряжение = ТекСтрокаТЧ.Распоряжение;
				Если ТипЗнч(ТекРаспоряжение) = Тип("ДокументСсылка.ЗаказКлиента") 
					Или ТипЗнч(ТекРаспоряжение) = Тип("ДокументСсылка.Рекламация") 
					Или ТипЗнч(ТекРаспоряжение) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
					Если КлючиСвязи.Найти(ТекСтрокаТЧ.КлючСвязи) <> Неопределено Тогда
						НоваяСтрока = ТЗ_ОрганизацияИКлюч.Добавить();
						НоваяСтрока.Организация = ТекРаспоряжение.Организация;
						НоваяСтрока.КлючСвязи = ТекСтрокаТЧ.КлючСвязи;
						Если ТипЗнч(ТекРаспоряжение) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
							//НоваяСтрока.СпособДоставки = Перечисления.СпособыДоставки.ОтОтправителяОпределяетСлужбаДоставки;
						Иначе
							НоваяСтрока.СпособДоставки = ТекРаспоряжение.СпособДоставки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ТЗ_Организации = ТЗ_ОрганизацияИКлюч.Скопировать();
	ТЗ_Организации.Свернуть("Организация");
	
	Для каждого ДокЗаданиеНаПеревозку Из МассивОбъектов Цикл
		Если ТипЗнч(ДокЗаданиеНаПеревозку) <> Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
			Продолжить;
		КонецЕсли;

		НомерДокумента = НомерДокумента + 1;
		Если НомерДокумента > 1 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Сч = 1;
		Для каждого ТочкаМаршрута Из ДокЗаданиеНаПеревозку.Маршрут Цикл
			
			ТребуетсяРазбивкаПоОрганизациям = ТребуетсяРазбивкаПоОрганизациям(ТочкаМаршрута);
			
			Если ТребуетсяРазбивкаПоОрганизациям Тогда
				// по ключам организации
				Для каждого СтрокаТЗ_Организации Из ТЗ_Организации Цикл
					КлючиТекОрганизации = ТЗ_ОрганизацияИКлюч.НайтиСтроки(Новый Структура("Организация", СтрокаТЗ_Организации.Организация));
					
					МассивКлючейТекОрганизации = Новый Массив;
					Для каждого СтрокаТЗ_КлючиОрганизации Из КлючиТекОрганизации Цикл
						Если МассивКлючейТекОрганизации.Найти(СтрокаТЗ_КлючиОрганизации.КлючСвязи) = Неопределено Тогда
							МассивКлючейТекОрганизации.Добавить(СтрокаТЗ_КлючиОрганизации.КлючСвязи);
						КонецЕсли;
					КонецЦикла;
						
					Для каждого ДокЗадание Из МассивОбъектов Цикл
						Если ТипЗнч(ДокЗадание) <> Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
							Продолжить;
						КонецЕсли;
						
						НомерДокумента = НомерДокумента + 1;
						Если НомерДокумента > 1 Тогда
							ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						КонецЕсли;

						Если МассивКлючейТекОрганизации.Найти(ТочкаМаршрута.КлючСвязи) <> Неопределено Тогда
							Парам = Новый Структура();
							Парам.Вставить("ТабличныйДокумент", ТабличныйДокумент);
							Парам.Вставить("ТочкаМаршрута", ТочкаМаршрута);
							Парам.Вставить("ДокЗаданиеНаПеревозку", ДокЗадание);
							Парам.Вставить("Сч", Сч);
							Парам.Вставить("Организация", СтрокаТЗ_Организации.Организация);
							
							ЗаполнитьТабличныйДокументЗаданиеНаПеревозку(Парам);
							Сч = Сч + 1;
						КонецЕсли;
					КонецЦикла;
						
				КонецЦикла;
				
			Иначе
				// по всем ключам
				Если КлючиСвязи.Найти(ТочкаМаршрута.КлючСвязи) <> Неопределено  Тогда
					Парам = Новый Структура();
					Парам.Вставить("ТабличныйДокумент", ТабличныйДокумент);
					Парам.Вставить("ТочкаМаршрута", ТочкаМаршрута);
					Парам.Вставить("ДокЗаданиеНаПеревозку", ДокЗаданиеНаПеревозку);
					Парам.Вставить("Сч", Сч);
					Парам.Вставить("Организация", "");
					ЗаполнитьТабличныйДокументЗаданиеНаПеревозку(Парам);
					Сч = Сч + 1;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла; // по маршрутам
	КонецЦикла;	// по заданиям на перевозку
	
	//Для каждого СтрокаТЗ_Организации Из ТЗ_Организации Цикл
	//	КлючиТекОрганизации = ТЗ_ОрганизацияИКлюч.НайтиСтроки(Новый Структура("Организация", СтрокаТЗ_Организации.Организация));
	//	
	//	МассивКлючейТекОрганизации = Новый Массив;
	//	Для каждого СтрокаТЗ_КлючиОрганизации Из КлючиТекОрганизации Цикл
	//		МассивКлючейТекОрганизации.Добавить(СтрокаТЗ_КлючиОрганизации.КлючСвязи);
	//	КонецЦикла;
	//		
	//	Для каждого ДокЗаданиеНаПеревозку Из МассивОбъектов Цикл
	//		Если ТипЗнч(ДокЗаданиеНаПеревозку) <> Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
	//			Продолжить;
	//		КонецЕсли;
	//		
	//		НомерДокумента = НомерДокумента + 1;
	//		Если НомерДокумента > 1 Тогда
	//			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	//		КонецЕсли;

	//		Сч = 1;
	//		Для каждого ТочкаМаршрута Из ДокЗаданиеНаПеревозку.Маршрут Цикл
	//			Если МассивКлючейТекОрганизации.Найти(ТочкаМаршрута.КлючСвязи) <> Неопределено Тогда
	//				ЗаполнитьТабличныйДокументЗаданиеНаПеревозку(ТабличныйДокумент, ТочкаМаршрута, ДокЗаданиеНаПеревозку, Сч);
	//			КонецЕсли;
	//			Сч = Сч + 1;
	//		КонецЦикла;
	//	КонецЦикла;
	//		
	//КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ЗаполнитьТабличныйДокументЗаданиеНаПеревозку(Парам)

	ТабДок					= Парам.ТабличныйДокумент;
	п_ТочкаМаршрута			= Парам.ТочкаМаршрута;
	Сч						= Парам.Сч;
	п_ЗаданиеНаПеревозку	= Парам.ДокЗаданиеНаПеревозку;
	п_Организация			= Парам.Организация;
	
	ДанныеТочкиМаршрута = ДанныеТочкиМаршрута(п_ЗаданиеНаПеревозку, п_ТочкаМаршрута, п_Организация);
	ДоставкаДоТК = ДанныеТочкиМаршрута.Итог("ДоставкаДоТК");

	Если ДоставкаДоТК > 0 Тогда

		Макет = ПолучитьМакет("ПФ_MXL_ЗаявкаТК");
				
		ОбластьТаблица		= Макет.ПолучитьОбласть("Таблица");
		ОбластьРазделитель	= Макет.ПолучитьОбласть("Разделитель");
	    
		ОбластьТаблица.Параметры.Водитель	= п_ЗаданиеНаПеревозку.Водитель;
		ОбластьТаблица.Параметры.Транспорт	= п_ЗаданиеНаПеревозку.ТранспортноеСредство;
		
		ТЗВрем = ДанныеТочкиМаршрута.Скопировать();
		ТЗВрем.Свернуть("Получатель");
		М_Получатели = ТЗВрем.ВыгрузитьКолонку("Получатель");
		Если М_Получатели.Количество() = 1 Тогда
			
			НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(п_ЗаданиеНаПеревозку.Номер) + "/" + Сч;	
			ТекстЗаголовка = "Заявка автотранспорта № " + НомерДокумента + " от " + Формат(п_ЗаданиеНаПеревозку.Дата, "ДЛФ=DD");
			ОбластьТаблица.Параметры.ТекстЗаголовка = ТекстЗаголовка;

			ОбластьТаблица.Параметры.РеализацияНомер					= КолонкуМассивВСтроку(ДанныеТочкиМаршрута, "РеализацияНомер");
			ОбластьТаблица.Параметры.Менеджер							= КолонкуВСтроку(ДанныеТочкиМаршрута, "Менеджер");
			ОбластьТаблица.Параметры.МенеджерТелефон					= КолонкуВСтроку(ДанныеТочкиМаршрута, "МенеджерТелефон");
			ОбластьТаблица.Параметры.ТранспортнаяКомпания				= КолонкуВСтроку(ДанныеТочкиМаршрута, "Перевозчик");
			ОбластьТаблица.Параметры.АдресТК							= КолонкуВСтроку(ДанныеТочкиМаршрута, "АдресДоставки");
			ОбластьТаблица.Параметры.КонтактыТК							= КолонкуВСтроку(ДанныеТочкиМаршрута, "Контакты");
